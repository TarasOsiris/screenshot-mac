{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "de",
      "es",
      "fa",
      "fr",
      "ja",
      "ko",
      "pt-BR",
      "zh-Hans",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/RevenueCat/purchases-ios-spm.git",
      "version": {
        "up-to-next-major-version": "5.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/swhitty/SwiftDraw.git",
      "version": {
        "up-to-next-minor-version": "0.27.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/modelcontextprotocol/swift-sdk.git",
      "version": {
        "up-to-next-minor-version": "0.12.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/getsentry/sentry-cocoa.git",
      "version": {
        "up-to-next-major-version": "9.26.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/PostHog/posthog-ios.git",
      "version": {
        "up-to-next-major-version": "3.56.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/slowbrewedmacchiato/SBAppPortfolio.git",
      "version": {
        "up-to-next-major-version": "1.1.0",
      },
    },
  ],
  "files": [
    { "kind": "folder", "path": "screenshot", "target-membership": [ "screenshot" ] },
    { "kind": "folder", "path": "screenshotTests", "target-membership": [ "screenshotTests" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Screenshot Bro.app", "id": "768DF30B2F596DAB0072F7A4", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/screenshotTests.xctest", "id": "768DF3262F596DAC0072F7A4", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "screenshot",
      "id": "768DF30A2F596DAB0072F7A4",
      "product": "Products/Screenshot Bro.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "script",
          "name": "SwiftLint",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "if [ \"$CONFIGURATION\" = \"Release\" ]; then exit 0; fi",
            "SWIFTLINT=$(command -v swiftlint || echo /opt/homebrew/bin/swiftlint)",
            "if [ ! -x \"$SWIFTLINT\" ]; then",
            "  echo \"note: SwiftLint not installed - skipping lint (brew install swiftlint)\"",
            "  exit 0",
            "fi",
            "# App sources only. The suite's ~300 force-unwrap warnings are legitimate in tests but would",
            "# drown the app's handful here. `included:` in .swiftlint.yml wins over a path argument, so",
            "# filter the output rather than the input; ./tools/lint.sh and the pre-commit hook cover tests.",
            "OUT=$(\"$SWIFTLINT\" lint --quiet 2>&1 | grep -v '/screenshotTests/' || true)",
            "[ -n \"$OUT\" ] && echo \"$OUT\"",
            "if echo \"$OUT\" | grep -q ' error: '; then exit 1; fi",
            "exit 0",
            "",
          ],
        },
      ],
      "package-product-members": [
        {
          "package": "SwiftDraw",
          "product-name": "SwiftDraw",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "posthog-ios",
          "product-name": "PostHog",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "purchases-ios-spm",
          "product-name": "RevenueCat",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "purchases-ios-spm",
          "product-name": "RevenueCatUI",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "SBAppPortfolio",
          "product-name": "SBAppPortfolio",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "sentry-cocoa",
          "product-name": "Sentry",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-sdk",
          "product-name": "MCP",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "Bro",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS": "YES",
        "CODE_SIGN_ENTITLEMENTS": "screenshot/screenshot.entitlements",
        "CODE_SIGN_ENTITLEMENTS[config=Debug][sdk=macosx*]": "screenshot/screenshotDebug.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "145",
        "DEAD_CODE_STRIPPING": "YES",
        "DEVELOPMENT_TEAM": "XW3GM347XY",
        "ENABLE_APP_SANDBOX[sdk=macosx*]": "YES",
        "ENABLE_HARDENED_RUNTIME[sdk=macosx*]": "YES",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SELECTED_FILES[sdk=macosx*]": "readwrite",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_FILE": "ScreenshotBro-Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=iphone*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "4.17",
        "POSTHOG_API_KEY": "phc_uFPDbVMPTYfFqBZgnbNkSPuRjGtCvPhHxbQUXxxYgwxQ",
        "PRINCIPAL_CLASS[sdk=iphoneos*]": "UIApplication",
        "PRINCIPAL_CLASS[sdk=iphonesimulator*]": "UIApplication",
        "PRINCIPAL_CLASS[sdk=macosx*]": "NSApplication",
        "PRODUCT_BUNDLE_IDENTIFIER": "xyz.tleskiv.screenshot",
        "PRODUCT_NAME": "Screenshot Bro",
        "REGISTER_APP_GROUPS": "YES",
        "REVENUECAT_API_KEY[config=Debug]": "test_KgNxrrXqBIGgiORjBPsdiXrraJL",
        "REVENUECAT_API_KEY[config=Release]": "appl_qNsQJpgVEPpXpoJiqWqgKOIhKru",
        "REVENUECAT_ENTITLEMENT_ID": "Nineva Studios / ScreenshotBro Pro",
        "REVENUECAT_PRODUCT_ID": "proversion",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "screenshotTests",
      "id": "768DF32B2F596DAC0072F7A4",
      "product": "Products/screenshotTests.xctest",
      "product-type": "bundle.unit-test",
      "dependencies": [
        "screenshot",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "145",
        "DEAD_CODE_STRIPPING": "YES",
        "DEVELOPMENT_TEAM": "XW3GM347XY",
        "GENERATE_INFOPLIST_FILE": "YES",
        "MARKETING_VERSION": "4.17",
        "PRODUCT_BUNDLE_IDENTIFIER": "xyz.tleskiv.screenshotTests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/Screenshot Bro.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Screenshot Bro",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_LOCALIZABILITY_NONLOCALIZED": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++20",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEAD_CODE_STRIPPING": "YES",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "XW3GM347XY",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
    "GCC_C_LANGUAGE_STANDARD": "gnu17",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "DEBUG=1",
      "$(inherited)",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "IPHONEOS_DEPLOYMENT_TARGET": "18.0",
    "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
    "MACOSX_DEPLOYMENT_TARGET": "15.0",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "auto",
    "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
    "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
  },
  "last-upgrade": "26.4",
  "last-swift-update": "26.2",
}

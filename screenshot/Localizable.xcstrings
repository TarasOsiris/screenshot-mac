    "Row size %@ is outside Google Play's limits." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حجم الصف %1$@ يقع خارج حدود Google Play."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সারির আকার %1$@ Google Play-এর সীমার বাইরে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mida de la fila %1$@ està fora dels límits de Google Play."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velikost řádku %1$@ je mimo limity Google Play."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rækkestørrelsen %1$@ er uden for Google Plays grænser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeilengröße %@ liegt außerhalb der Grenzen von Google Play."

          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌘]** / **⌘[** avançam / retrocedem pelos idiomas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌘]** / **⌘[** переключают языки вперед / назад."

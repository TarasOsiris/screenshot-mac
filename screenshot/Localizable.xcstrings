    "Hide apps with no editable App Store version. Apps in review or already live can't accept new screenshots until you create a new version." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps ohne bearbeitbare App Store-Version ausblenden. Apps, die überprüft werden oder bereits live sind, können keine neuen Screenshots akzeptieren, bis Sie eine neue Version erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar aplicaciones sin versión App Store editable. Las aplicaciones en revisión o que ya están activas no pueden aceptar nuevas capturas de pantalla hasta que crees una nueva versión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه‌های بدون نسخه App Store قابل ویرایش را پنهان کنید. برنامه‌هایی که در حال بررسی هستند یا از قبل فعال هستند، نمی‌توانند اسکرین‌شات‌های جدید را بپذیرند تا زمانی که نسخه جدیدی ایجاد کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer les applications sans version App Store modifiable. Les applications en cours de révision ou déjà en ligne ne peuvent pas accepter de nouvelles captures d'écran tant que vous n'avez pas créé une nouvelle version."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集可能な App Store バージョンのないアプリを非表示にします。レビュー中のアプリやすでに公開されているアプリは、新しいバージョンを作成するまで新しいスクリーンショットを受け入れることができません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집 가능한 App Store 버전이 없는 앱을 숨깁니다. 검토 중이거나 이미 게시된 앱은 새 버전을 만들 때까지 새 스크린샷을 허용할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculte aplicativos sem versão editável App Store. Os aplicativos em revisão ou já ativos não podem aceitar novas capturas de tela até que você crie uma nova versão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏没有可编辑 App Store 版本的应用。在您创建新版本之前，正在审核或已上线的应用程序无法接受新的屏幕截图。"
          }
        }
      }
    },
    "Hide apps with no editable App Store version. Apps that are already live can't accept metadata changes until you create a new version." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps ohne bearbeitbare App Store-Version ausblenden. Apps, die bereits live sind, können keine Metadatenänderungen akzeptieren, bis Sie eine neue Version erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar las apps sin una versión editable de la App Store. Las apps ya publicadas no pueden aceptar cambios de metadatos hasta que crees una nueva versión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه‌های بدون نسخه App Store قابل ویرایش را پنهان کنید. برنامه‌هایی که از قبل فعال هستند، تا زمانی که نسخه جدیدی ایجاد نکنید، نمی‌توانند تغییرات فراداده را بپذیرند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer les applications sans version App Store modifiable. Les applications déjà en ligne ne peuvent pas accepter de modifications de métadonnées tant que vous n'avez pas créé une nouvelle version."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集可能な App Store バージョンのないアプリを非表示にします。すでに公開されているアプリは、新しいバージョンを作成するまでメタデータの変更を受け入れることができません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집 가능한 App Store 버전이 없는 앱을 숨깁니다. 이미 게시된 앱은 새 버전을 만들 때까지 메타데이터 변경을 허용할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculte aplicativos sem versão editável App Store. Os aplicativos já ativos não podem aceitar alterações de metadados até que você crie uma nova versão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏没有可编辑 App Store 版本的应用。在您创建新版本之前，已上线的应用程序无法接受元数据更改。"
          }

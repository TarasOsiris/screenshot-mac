    "Allow photo access in Settings to save to your gallery." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السماح بالوصول إلى الصور في الإعدادات لحفظها في معرض الصور الخاص بك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার গ্যালারিতে সংরক্ষণ করতে সেটিংসে ফটো অ্যাক্সেসের অনুমতি দিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet l'accés a les fotos a Configuració per desar-les a la teva galeria."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte v Nastavení přístup k fotkám a uložte je do galerie."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad billedadgang i Indstillinger for at gemme i dit galleri."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube in den Einstellungen den Zugriff auf Fotos, um in deiner Fotomediathek zu sichern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε την πρόσβαση φωτογραφιών στις Ρυθμίσεις για αποθήκευση στη συλλογή σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a Fotos en Ajustes para guardar en tu fototeca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای ذخیره در گالری، در تنظیمات اجازهٔ دسترسی به عکس‌ها را بدهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli kuvien käyttö Asetuksissa tallentaaksesi galleriaasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l'accès aux photos dans Réglages pour enregistrer dans votre photothèque."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારી ગેલેરીમાં સાચવવા માટે સેટિંગ્સમાં ફોટો ઍક્સેસની મંજૂરી આપો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר גישה לתמונות בהגדרות כדי לשמור בגלריה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी गैलरी में सहेजने के लिए सेटिंग्स में फोटो एक्सेस की अनुमति दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopustite pristup fotografijama u postavkama za spremanje u svoju galeriju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",

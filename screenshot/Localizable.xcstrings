            "state" : "translated",
            "value" : "%1$lld ক্ষেত্র%2$@ %3$lld লোকেল%4$@ এবং %5$lld সংস্করণ%6$@ জুড়ে সংরক্ষিত।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El camp %1$lld %2$@ s'ha desat a la versió %3$lld local%4$@ i la versió %5$lld [FMT_5]]."

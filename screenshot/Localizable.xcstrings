          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Скриншотов в новой строке** — сколько пустых шаблонов будет в новой строке."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Yeni satır başına ekran görüntüsü** — yeni bir satırın başladığı boş şablon sayısı."
          }

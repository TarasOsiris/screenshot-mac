        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sakrij aplikacije bez verzije App Store koja se može uređivati. Aplikacije koje su već aktivne ne mogu prihvatiti promjene metapodataka dok ne izradite novu verziju."
          }
        },
        "hu" : {
          "stringUnit" : {

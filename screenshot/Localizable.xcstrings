          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuredite z **Premakni levo** / **Premakni desno** v kontrolni vrstici predloge (tudi v njenem meniju **⋯**). Vrstni red določa oštevilčenje izvožene datoteke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändra ordning med **Flytta åt vänster** / **Flytta åt höger** i mallkontrollfältet (även i dess **⋯**-meny). Ordern bestämmer den exporterade filnumreringen."
          }
        },
        "th" : {

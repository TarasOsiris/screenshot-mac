    "Set **Settings ▸ Export ▸ Export folder** to make **⌘E** export directly without prompting." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estableix **Configuració ▸ Exporta ▸ Exporta carpeta** per fer que **⌘E** s'exporti directament sense demanar-ho."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstil **Indstillinger ▸ Eksporter ▸ Eksporter mappe** for at få **⌘E** til at eksportere direkte uden at blive spurgt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege unter **Einstellungen ▸ Export ▸ Exportordner** einen Ordner fest, damit **⌘E** direkt und ohne Nachfrage exportiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define **Ajustes ▸ Exportar ▸ Carpeta de exportación** para que **⌘E** exporte directamente sin preguntar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**تنظیمات ▸ صدور ▸ پوشهٔ خروجی** را تنظیم کنید تا **⌘E** بدون پرسش مستقیماً صادر کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta **Asetukset ▸ Vie ▸ Vie kansio**, jotta **⌘E** viedään suoraan ilman kehotusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez **Réglages ▸ Exporter ▸ Dossier d'exportation** pour que **⌘E** exporte directement, sans rien demander."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta **Impostazioni ▸ Esporta ▸ Cartella di esportazione** perché **⌘E** esporti direttamente senza chiedere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**設定 ▸ 書き出し ▸ 書き出し先フォルダ** を設定すると、**⌘E** で確認なしに直接書き出せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**설정 ▸ 내보내기 ▸ 내보내기 폴더**를 지정하면 **⌘E**가 묻지 않고 바로 내보냅니다."
          }

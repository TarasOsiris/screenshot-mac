    "Click a shape to select it. **Shift-click** to add to or remove from the selection." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر فوق الشكل لتحديده. **انقر مع الضغط على Shift** للإضافة إلى التحديد أو الإزالة منه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি নির্বাচন করতে একটি আকৃতি ক্লিক করুন. নির্বাচন যোগ করতে বা সরাতে **শিফট-ক্লিক করুন**।"

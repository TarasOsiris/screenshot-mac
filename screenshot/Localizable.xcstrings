    "Format, background, layout, and excluded screenshots will return to defaults. Row selection is preserved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format, Hintergrund, Layout und ausgeschlossene Screenshots werden auf die Standardeinstellungen zurückgesetzt. Die Zeilenauswahl bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El formato, el fondo, el diseño y las capturas de pantalla excluidas volverán a sus valores predeterminados. Se conserva la selección de filas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قالب، پس‌زمینه، طرح‌بندی و اسکرین‌شات‌های حذف‌شده به حالت پیش‌فرض برمی‌گردند. انتخاب ردیف حفظ می شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le format, l'arrière-plan, la mise en page et les captures d'écran exclues reviendront aux valeurs par défaut. La sélection de lignes est conservée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formato, sfondo, layout e screenshot esclusi torneranno ai valori predefiniti. La selezione delle righe viene mantenuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "形式、背景、レイアウト、除外されたスクリーンショットはデフォルトに戻ります。行の選択は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "형식, 배경, 레이아웃, 제외된 스크린샷은 기본값으로 돌아갑니다. 행 선택이 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formato, plano de fundo, layout e capturas de tela excluídas retornarão aos padrões. A seleção de linha é preservada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Формат, фон, макет и исключенные скриншоты вернутся к значениям по умолчанию. Выбранные строки сохранятся."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biçim, arka plan, düzen ve hariç tutulan ekran görüntüleri varsayılanlara dönecek. Satır seçimi korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Формат, тло, макет і виключені знімки екрана буде повернено до стандартних. Вибрані рядки збережуться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "格式、背景、布局和排除的屏幕截图将恢复为默认值。行选择被保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "格式、背景、版面和已排除的螢幕截圖都會恢復為預設值。列的選擇會保留。"
          }
        }
      }

    "Exporting to a folder isn't available on iPad — use the share sheet export instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Export in einen Ordner ist unter iPad nicht verfügbar – verwenden Sie stattdessen den Share-Sheet-Export."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportar a una carpeta no está disponible en iPad; en su lugar, use la exportación de hoja compartida."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صادر کردن به یک پوشه در iPad در دسترس نیست — در عوض از صادرات برگه اشتراک‌گذاری استفاده کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'exportation vers un dossier n'est pas disponible sur iPad : utilisez plutôt l'exportation de la feuille de partage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'esportazione in una cartella non è disponibile su iPad: usa invece l'esportazione tramite il foglio di condivisione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad ではフォルダーへのエクスポートは利用できません。代わりに共有シートのエクスポートを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad에서는 폴더로 내보낼 수 없습니다. 대신 공유 시트 내보내기를 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A exportação para uma pasta não está disponível em iPad — em vez disso, use a exportação de planilha de compartilhamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспорт в папку недоступен на iPad — используйте экспорт через меню «Поделиться»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad'de klasöre dışa aktarma kullanılamaz — bunun yerine paylaşma sayfasıyla dışa aktarmayı kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Експорт у папку недоступний на iPad — натомість скористайтеся експортом через меню «Поширити»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad 上无法导出到文件夹 - 请改用共享表导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad 上無法輸出至資料夾——請改用分享表單輸出。"
          }
        }
      }
    },

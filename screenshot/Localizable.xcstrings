    "Next, submit it for review. Apple reviews an experiment before it can start." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reiche es als Nächstes zur Prüfung ein. Apple prüft ein Experiment, bevor es starten kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después, envíalo a revisión. Apple revisa cada experimento antes de que pueda empezar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سپس آن را برای بررسی ارسال کنید. Apple هر آزمایش را پیش از شروع بررسی می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soumettez-la ensuite à l’examen. Apple examine chaque expérience avant son lancement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora invialo per la revisione. Apple revisiona un esperimento prima che possa iniziare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次に、審査に提出します。実験は開始前に Apple の審査を受けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음으로 심사에 제출하세요. Apple은 실험을 시작하기 전에 심사합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em seguida, envie para revisão. A Apple revisa o experimento antes que ele possa começar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затем отправьте его на проверку. Apple проверяет эксперимент, прежде чем его можно будет запустить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sırada incelemeye göndermek var. Apple bir deneyi başlamadan önce inceler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Далі надішліть його на перевірку. Apple перевіряє експеримент, перш ніж його можна буде запустити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下来，提交审核。实验开始前需经过 Apple 审核。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下來，請送交審查。Apple 會先審查實驗，才能開始執行。"
          }
        }
      }
    },

    "Upload cancelled. Changes already made in App Store Connect were not reverted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upload abgebrochen. Bereits in App Store Connect vorgenommene Änderungen wurden nicht rückgängig gemacht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subida cancelada. Los cambios ya hechos en App Store Connect no se revirtieron."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",

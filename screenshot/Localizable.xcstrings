    "First-time enable migrates your local project library into iCloud. A progress indicator shows the migration." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي التمكين لأول مرة إلى ترحيل مكتبة مشروعك المحلية إلى iCloud. يظهر مؤشر التقدم الهجرة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'activació per primera vegada migra la biblioteca local del projecte a iCloud. Un indicador de progrés mostra la migració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "První povolení migruje vaši místní knihovnu projektů do iCloud. Indikátor průběhu ukazuje migraci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Første gangs aktivering migrerer dit lokale projektbibliotek til iCloud. En fremskridtsindikator viser migreringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim ersten Aktivieren wird deine lokale Projektbibliothek nach iCloud übertragen. Eine Fortschrittsanzeige zeigt den Vorgang."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ενεργοποίηση για πρώτη φορά μετεγκαθιστά την τοπική βιβλιοθήκη του έργου σας στο iCloud. Ένας δείκτης προόδου δείχνει τη μετεγκατάσταση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera vez que la activas, tu biblioteca de proyectos local se traslada a iCloud. Un indicador muestra el progreso."
          }
        },
        "fa" : {
          "stringUnit" : {

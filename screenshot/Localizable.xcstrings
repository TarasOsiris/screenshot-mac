          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמור את שם הסקריפט (%1$@) ושמור אותו בתיקייה Application Scripts."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",

    "Click **Add Row** at the bottom of the canvas, or use the inspector when no row is selected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie unten auf der Leinwand auf **Zeile hinzufügen** oder verwenden Sie den Inspektor, wenn keine Zeile ausgewählt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haga clic en **Agregar fila** en la parte inferior del lienzo o use el inspector cuando no haya ninguna fila seleccionada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روی **افزودن ردیف** در پایین بوم کلیک کنید، یا وقتی ردیفی انتخاب نشده است از بازرس استفاده کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur **Ajouter une ligne** en bas du canevas ou utilisez l'inspecteur lorsqu'aucune ligne n'est sélectionnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su **Aggiungi riga** in fondo alla tela, oppure usa l'inspector quando non è selezionata alcuna riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンバスの下部にある [**行の追加**] をクリックするか、行が選択されていない場合はインスペクターを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캔버스 하단에서 **행 추가**를 클릭하거나 행이 선택되지 않은 경우 검사기를 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em **Adicionar linha** na parte inferior da tela ou use o inspetor quando nenhuma linha estiver selecionada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите **Добавить строку** внизу холста или воспользуйтесь инспектором, когда не выбрана ни одна строка."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuvalin altındaki **Satır Ekle**'ye tıklayın ya da hiçbir satır seçili değilken denetçiyi kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть **Додати рядок** унизу полотна або скористайтеся інспектором, коли не вибрано жодного рядка."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单击画布底部的“**添加行**”，或者在未选择任何行时使用检查器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下畫布底部的**加入列**，或在未選取列時使用檢閱器。"
          }
        }
      }
    },
    "Click **Add Template** (the **+** button at the right end of the row)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie auf **Vorlage hinzufügen** (die Schaltfläche *** am rechten Ende der Zeile)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haga clic en **Agregar plantilla** (el botón **+** en el extremo derecho de la fila)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روی **افزودن الگو** (دکمه **+** در انتهای سمت راست ردیف) کلیک کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur **Ajouter un modèle** (le bouton **+** à l'extrémité droite de la ligne)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su **Aggiungi modello** (il pulsante **+** all'estremità destra della riga)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[**テンプレートの追加**] (行の右端にある [**+**] ボタン) をクリックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**템플릿 추가**(행 오른쪽 끝에 있는 ****** 버튼)를 클릭합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em **Adicionar modelo** (o botão **+** na extremidade direita da linha)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите **Добавить шаблон** (кнопка **+** в правом конце строки)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Şablon Ekle**'ye (satırın sağ ucundaki **+** düğmesi) tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть **Додати знімок екрана** (кнопка **+** у правому кінці рядка)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单击“**添加模板**”（行右端的 **+** 按钮）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下**加入範本**（列右端的 **+** 按鈕）。"
          }
        }
      }
    },
    "Click **Export** in the toolbar to render the current project to PNG." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie in der Symbolleiste auf **Exportieren**, um das aktuelle Projekt in PNG zu rendern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haga clic en **Exportar** en la barra de herramientas para representar el proyecto actual en PNG."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روی **صادر کردن** در نوار ابزار کلیک کنید تا پروژه فعلی به PNG ارائه شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur **Exporter** dans la barre d'outils pour restituer le projet actuel vers PNG."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツールバーの **エクスポート** をクリックして、現在のプロジェクトを PNG にレンダリングします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도구 모음에서 **내보내기**를 클릭하여 현재 프로젝트를 PNG로 렌더링합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em **Exportar** na barra de ferramentas para renderizar o projeto atual em PNG."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单击工具栏中的 **导出** 将当前项目渲染到 PNG。"
          }
        }
      }
    },
    "Click **Export** in the toolbar, or press **⌘E**, to render the current project to the remembered export folder. If no folder is set, Screenshot Bro asks you to choose one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie in der Symbolleiste auf **Exportieren** oder drücken Sie **⌘E**, um das aktuelle Projekt in den gespeicherten Exportordner zu rendern. Wenn kein Ordner festgelegt ist, werden Sie von Screenshot Bro aufgefordert, einen auszuwählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haga clic en **Exportar** en la barra de herramientas o presione **⌘E** para representar el proyecto actual en la carpeta de exportación recordada. Si no hay ninguna carpeta configurada, Screenshot Bro le pide que elija una."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روی **صادر کردن** در نوار ابزار کلیک کنید، یا **⌘E** را فشار دهید تا پروژه فعلی به پوشه صادراتی به خاطر سپرده شده ارائه شود. اگر پوشه‌ای تنظیم نشده باشد، Screenshot Bro از شما می‌خواهد یکی را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur **Exporter** dans la barre d'outils ou appuyez sur **⌘E** pour restituer le projet actuel dans le dossier d'exportation mémorisé. Si aucun dossier n'est défini, Screenshot Bro vous demande d'en choisir un."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su **Esporta** nella barra strumenti, o premi **⌘E**, per generare il progetto corrente nella cartella di esportazione memorizzata. Se non è impostata alcuna cartella, Screenshot Bro ti chiede di sceglierne una."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツールバーの **エクスポート** をクリックするか、**⌘E** を押して、現在のプロジェクトを記憶されたエクスポート フォルダーにレンダリングします。フォルダーが設定されていない場合、Screenshot Bro はフォルダーを選択するよう求めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "툴바에서 **내보내기**를 클릭하거나 **⌘E**를 눌러 현재 프로젝트를 기억된 내보내기 폴더로 렌더링합니다. 폴더가 설정되어 있지 않으면 Screenshot Bro에서 폴더를 선택하라는 메시지를 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em **Exportar** na barra de ferramentas ou pressione **⌘E** para renderizar o projeto atual na pasta de exportação lembrada. Se nenhuma pasta estiver definida, Screenshot Bro solicitará que você escolha uma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите **Экспорт** на панели инструментов или **⌘E**, чтобы отрисовать текущий проект в запомненную папку экспорта. Если папка не задана, Screenshot Bro попросит ее выбрать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli projeyi hatırlanan dışa aktarma klasörüne oluşturmak için araç çubuğunda **Dışa Aktar**'a tıklayın veya **⌘E** tuşlarına basın. Klasör ayarlanmamışsa Screenshot Bro sizden bir klasör seçmenizi ister."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть **Експорт** на панелі інструментів або **⌘E**, щоб відрендерити поточний проєкт у збережену папку експорту. Якщо папку не задано, Screenshot Bro попросить її вибрати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单击工具栏中的 **导出**，或按 **⌘E**，将当前项目渲染到记住的导出文件夹中。如果未设置文件夹，Screenshot Bro 会要求您选择一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下工具列中的**輸出**或按 **⌘E**，即可將目前的專案轉譯到記住的輸出資料夾。如果尚未設定資料夾，Screenshot Bro 會要求你選擇一個。"
          }
        }
      }
    },
    "Click **SVG** to import a vector file. Or paste raw SVG via the SVG paste dialog." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie auf **SVG**, um eine Vektordatei zu importieren. Oder fügen Sie rohes SVG über den SVG-Einfügedialog ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haga clic en **SVG** para importar un archivo vectorial. O pegue SVG sin formato a través del cuadro de diálogo de pegado SVG."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای وارد کردن یک فایل برداری روی **SVG** کلیک کنید. یا SVG خام را از طریق گفتگوی چسباندن SVG جای‌گذاری کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur **SVG** pour importer un fichier vectoriel. Ou collez SVG brut via la boîte de dialogue de collage SVG."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su **SVG** per importare un file vettoriale. Oppure incolla il codice SVG tramite la finestra per incollare SVG."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**SVG** をクリックしてベクター ファイルをインポートします。または、SVG 貼り付けダイアログを使用して生の SVG を貼り付けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "벡터 파일을 가져오려면 **SVG**을 클릭하세요. 또는 SVG 붙여넣기 대화상자를 통해 원시 SVG을(를) 붙여넣습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em **SVG** para importar um arquivo vetorial. Ou cole SVG bruto por meio da caixa de diálogo de colagem SVG."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите **SVG**, чтобы импортировать векторный файл, или вставьте код SVG в диалоге вставки SVG."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir vektör dosyasını içe aktarmak için **SVG**'ye tıklayın. Ya da ham SVG kodunu SVG yapıştırma penceresiyle yapıştırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть **SVG**, щоб імпортувати векторний файл. Або вставте код SVG у діалозі вставлення SVG."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单击 **SVG** 以导入矢量文件。或者通过 SVG 粘贴对话框粘贴原始 SVG。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下 **SVG** 以輸入向量檔案。或透過 SVG 貼上對話框貼上原始 SVG 碼。"
          }
        }
      }
    },
    "Click **Upload to App Store Connect…** from the export menu. Screenshot Bro renders the selected screenshots directly from the project." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie im Exportmenü auf **Upload to App Store Connect…**. Screenshot Bro rendert die ausgewählten Screenshots direkt aus dem Projekt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haga clic en **Subir a App Store Connect…** en el menú de exportación. Screenshot Bro renderiza las capturas de pantalla seleccionadas directamente desde el proyecto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روی **آپلود در App Store Connect…** از منوی صادرات کلیک کنید. Screenshot Bro تصاویر انتخابی را مستقیماً از پروژه ارائه می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur **Télécharger vers App Store Connect…** dans le menu d'exportation. Screenshot Bro restitue les captures d'écran sélectionnées directement à partir du projet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su **Carica su App Store Connect…** dal menu di esportazione. Screenshot Bro genera gli screenshot selezionati direttamente dal progetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エクスポート メニューから [**App Store Connect にアップロード…**] をクリックします。 Screenshot Bro は、選択したスクリーンショットをプロジェクトから直接レンダリングします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내보내기 메뉴에서 **App Store Connect에 업로드...**를 클릭하세요. Screenshot Bro은 선택한 스크린샷을 프로젝트에서 직접 렌더링합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em **Fazer upload para App Store Connect…** no menu de exportação. Screenshot Bro renderiza as capturas de tela selecionadas diretamente do projeto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите **Загрузить в App Store Connect…** в меню экспорта. Screenshot Bro отрисует выбранные скриншоты прямо из проекта."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dışa aktarma menüsünden **App Store Connect'e Yükle…** seçeneğine tıklayın. Screenshot Bro seçili ekran görüntülerini doğrudan projeden oluşturur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть **Вивантажити в App Store Connect…** у меню експорту. Screenshot Bro рендерить вибрані знімки екрана безпосередньо з проєкту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

    "%lld unchanged screenshots will keep their App Store asset IDs." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les %1$lld captures de pantalla sense canvis conservaran els seus App Store identificadors de recursos."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld uændrede skærmbilleder beholder deres App Store aktiv-id'er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld unveränderte Screenshots behalten ihre App Store-Asset-IDs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld capturas sin cambios conservarán sus ID de recurso de App Store."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld اسکرین‌شات بدون تغییر، شناسهٔ دارایی App Store خود را حفظ می‌کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld muuttamattomat kuvakaappaukset säilyttävät App Store sisältötunnuksensa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld captures d'écran inchangées conserveront leur identifiant de ressource App Store."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld screenshot invariati manterranno i propri ID asset App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更のない%1$lld枚のスクリーンショットは App Store のアセット ID を保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경되지 않은 스크린샷 %lld개는 App Store 에셋 ID를 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld ongewijzigde screenshots behouden hun App Store item-ID's."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",

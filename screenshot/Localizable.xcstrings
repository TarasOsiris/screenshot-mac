        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પંક્તિઓ, ટેમ્પલેટ કૉલમ્સ અને આકારો ઉમેરો, સંપાદિત કરો, ખસેડો અને દૂર કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",

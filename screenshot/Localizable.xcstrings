    "Z-order, duplicate, and delete act on the whole selection." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ordre Z, la duplicació i la supressió actuen sobre tota la selecció."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-ordre, dupliker og slet handling på hele udvalget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebenenreihenfolge, Duplizieren und Löschen wirken auf die gesamte Auswahl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordenar en Z, duplicar y eliminar actúan sobre toda la selección."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتیب لایه‌ها، تکثیر و حذف روی همهٔ موارد انتخاب‌شده اعمال می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-järjestä, monista ja poista toimi koko valinnassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ordre Z, la duplication et la suppression agissent sur toute la sélection."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordine di sovrapposizione, duplicazione ed eliminazione agiscono sull'intera selezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重なり順の変更、複製、削除は、選択したすべての図形に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z 순서, 복제 및 삭제는 전체 선택 항목에 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-volgorde, dupliceer en verwijder actie op de hele selectie."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-ordre, duplisere og slette handle på hele utvalget."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordem Z, duplicação e exclusão atuam em toda a seleção."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordem Z, duplicação e exclusão atuam em toda a seleção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порядок наложения, дублирование и удаление применяются ко всему выделению."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-ordna, duplicera och ta bort agerar på hela urvalet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z sırası, çoğaltma ve silme işlemleri seçimin tamamına uygulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порядок шарів, дублювання й видалення застосовуються до всього вибраного."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "层级顺序、复制和删除操作会作用于整个所选内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圖層順序、複製和刪除會作用於整個選取範圍。"
          }
        }
      }
    },
    "Z-order: **⌘⇧]** brings forward, **⌘⇧[** sends back." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordre Z: **⌘⇧]** avança, **⌘⇧[** envia enrere."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-rækkefølge: **⌘⇧]** bringer frem, **⌘⇧[** sender tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebenenreihenfolge: **⌘⇧]** bringt ganz nach vorne, **⌘⇧[** ganz nach hinten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orden de apilamiento: **⌘⇧]** trae al frente, **⌘⇧[** envía al fondo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتیب لایه‌ها: **⌘⇧]** به جلو می‌آورد و **⌘⇧[** به عقب می‌فرستد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-järjestys: **⌘⇧]** tuo eteenpäin, **⌘⇧[** lähettää takaisin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordre Z : **⌘⇧]** met au premier plan, **⌘⇧[** met à l'arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordine di sovrapposizione: **⌘⇧]** porta avanti, **⌘⇧[** porta indietro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重なり順: **⌘⇧]** で最前面へ、**⌘⇧[** で最背面へ移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z 순서: **⌘⇧]** 키는 앞으로 가져오고, **⌘⇧[** 키는 뒤로 보냅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-volgorde: **⌘⇧]** brengt naar voren, **⌘⇧[** stuurt terug."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-rekkefølge: **⌘⇧]** bringer frem, **⌘⇧[** sender tilbake."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordem Z: **⌘⇧]** traz para a frente, **⌘⇧[** envia para trás."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordem Z: **⌘⇧]** antecipa, **⌘⇧[** envia de volta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порядок наложения: **⌘⇧]** перемещает вперед, **⌘⇧[** — назад."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-ordning: **⌘⇧]** flyttar framåt, **⌘⇧[** skickar tillbaka."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z sırası: **⌘⇧]** öne getirir, **⌘⇧[** arkaya gönderir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порядок шарів: **⌘⇧]** переносить вперед, **⌘⇧[** — назад."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "层级顺序：**⌘⇧]** 移到最前面，**⌘⇧[** 移到最后面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圖層順序：**⌘⇧]** 移至最前面，**⌘⇧[** 移至最後面。"
          }
        }
      }
    },

    "Browse a sample app, version, locales, and run a simulated upload — no API key required and no traffic is sent to App Store Connect." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصفح نموذج التطبيق والإصدار والإعدادات المحلية، وقم بتشغيل محاكاة تحميل - لا يلزم وجود مفتاح API ولا يتم إرسال أي حركة مرور إلى App Store Connect."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exploreu una aplicació de mostra, una versió, una configuració regional i executeu una càrrega simulada: no cal cap clau API i no s'envia trànsit a App Store Connect."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procházejte ukázkovou aplikaci, verzi, národní prostředí a spusťte simulované nahrávání – není potřeba žádný klíč API a na App Store Connect není odesílán žádný provoz."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemse en eksempelapp, version, lokaliteter, og kør en simuleret upload - ingen API nøgle påkrævet, og der sendes ingen trafik til App Store Connect."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkunde eine Beispiel-App mit Version und Sprachen und führe einen simulierten Upload durch – ohne API-Schlüssel, und es wird nichts an App Store Connect gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περιηγηθείτε σε ένα δείγμα εφαρμογής, έκδοση, τοπικές ρυθμίσεις και εκτελέστε μια προσομοίωση μεταφόρτωσης — δεν απαιτείται κλειδί API και δεν αποστέλλεται κίνηση στο App Store Connect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explora una app de ejemplo, una versión e idiomas, y ejecuta una subida simulada: no se necesita clave de API y no se envía tráfico a App Store Connect."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه، نسخه و زبان‌های نمونه را مرور کنید و یک آپلود شبیه‌سازی‌شده اجرا کنید — به کلید API نیازی نیست و هیچ ترافیکی به App Store Connect ارسال نمی‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selaa esimerkkisovellusta, versiota, kieliasetuksia ja suorita simuloitu lataus – avainta API ei tarvita, eikä liikennettä lähetetä kohteeseen App Store Connect."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcourez un exemple d'app, sa version et ses langues, et lancez un envoi simulé — aucune clé API requise, et rien n'est envoyé à App Store Connect."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עיין באפליקציה לדוגמה, גרסה, אזורים והפעל העלאה מדומה - אין צורך במפתח API ולא נשלחת תנועה אל App Store Connect."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregledajte primjer aplikacije, verziju, lokalizaciju i pokrenite simulirani prijenos — ključ API nije potreban i promet se ne šalje na App Store Connect."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Böngésszen egy példaalkalmazást, verziót, nyelvi beállításokat, és futtasson egy szimulált feltöltést – nincs szükség API kulcsra, és a rendszer nem küld forgalmat a App Store Connect címre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelajahi contoh aplikasi, versi, lokal, dan jalankan unggahan simulasi — tidak diperlukan kunci API dan tidak ada lalu lintas yang dikirim ke App Store Connect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esplora un'app, una versione e lingue di esempio ed esegui un caricamento simulato: nessuna chiave API necessaria e nessun traffico viene inviato ad App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サンプルのアプリ、バージョン、ロケールを表示して、アップロードをシミュレーションできます。API キーは不要で、App Store Connect には何も送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "샘플 앱, 버전, 로케일을 둘러보고 시뮬레이션 업로드를 실행해 보세요. API 키가 필요 없으며 App Store Connect로는 아무 요청도 전송되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semak imbas contoh apl, versi, tempat dan jalankan muat naik simulasi — tiada kunci API diperlukan dan tiada trafik dihantar ke App Store Connect."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blader door een voorbeeld-app, versie en landinstellingen en voer een gesimuleerde upload uit. Er is geen API-sleutel vereist en er wordt geen verkeer naar App Store Connect verzonden."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bla gjennom en eksempelapp, versjon, lokaliteter og kjør en simulert opplasting – ingen API-nøkkel kreves og ingen trafikk sendes til App Store Connect."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",

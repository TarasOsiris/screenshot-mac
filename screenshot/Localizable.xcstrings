        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ ടേബിൾ ടെന്നീസ് പരിശീലനം ലോഗിൻ ചെയ്ത് ട്രാക്ക് ചെയ്യുക."

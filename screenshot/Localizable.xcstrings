          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API-näppäin (Issuer ID, Key ID, `.p8` tiedosto), **Testaa yhteys** ja **Sovellusten esittelytila**. Katso aihe App Store Connect."

    "%@ Changes already made in App Store Connect were not reverted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Bereits in App Store Connect vorgenommene Änderungen wurden nicht rückgängig gemacht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Los cambios ya realizados en App Store Connect no se revirtieron."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ تغییراتی که قبلاً در App Store Connect ایجاد شده بود، برگردانده نشدند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Les modifications déjà apportées dans App Store Connect n'ont pas été annulées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ App Store Connect で既に行われた変更は元に戻されませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ App Store Connect에 이미 변경된 사항은 되돌려지지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ As alterações já feitas em App Store Connect não foram revertidas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ App Store Connect 中已进行的更改未还原。"
          }
        }
      }
    },
    "%@ Check that the Issuer ID, Key ID, private key, and API key permissions match the App Store Connect key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Überprüfen Sie, ob die Berechtigungen für Issuer ID, Key ID, den privaten Schlüssel und den Schlüssel API mit dem Schlüssel App Store Connect übereinstimmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Comprueba que el Issuer ID, el Key ID, la clave privada y los permisos de la clave de API coinciden con la clave de App Store Connect."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ بررسی کنید که مجوزهای Issuer ID، Key ID، کلید خصوصی و API کلید با کلید App Store Connect مطابقت داشته باشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Vérifiez que les autorisations Issuer ID, Key ID, la clé privée et la clé API correspondent à la clé App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Issuer ID、Key ID、秘密キー、および API キーの権限が App Store Connect キーと一致することを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Issuer ID, Key ID, 개인 키, API 키 권한이 App Store Connect 키와 일치하는지 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Verifique se as permissões de Issuer ID, Key ID, chave privada e API correspondem à chave App Store Connect."
          }
        },
        "zh-Hans" : {

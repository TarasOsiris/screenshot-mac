    "Color, gradient, or image — at row or template level." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color, degradat o imatge: a nivell de fila o plantilla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farve, gradient eller billede - på række- eller skabelonniveau."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farbe, Verlauf oder Bild – für die Zeile oder die einzelne Vorlage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color, degradado o imagen, a nivel de fila o plantilla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رنگ، گرادیان یا تصویر — در سطح ردیف یا اسکرین‌شات."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väri, liukuväri tai kuva – rivi- tai mallitasolla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couleur, dégradé ou image – au niveau de la ligne ou du modèle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colore, sfumatura o immagine, a livello di riga o di modello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色、グラデーション、画像 — 行単位またはテンプレート単位で設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "색상, 그라디언트 또는 이미지 — 행 또는 템플릿 단위로."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleur, verloop of afbeelding — op rij- of sjabloonniveau."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farge, gradient eller bilde - på rad- eller malnivå."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor, gradiente ou imagem — no nível da linha ou do modelo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor, gradiente ou imagem — no nível da linha ou do modelo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цвет, градиент или изображение — для строки или отдельного шаблона."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färg, övertoning eller bild — på rad- eller mallnivå."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renk, renk geçişi veya görüntü — satır ya da şablon düzeyinde."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колір, градієнт або зображення — для рядка чи шаблону."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "颜色、渐变或图像——可在行或模板级别设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顏色、漸層或影像——可在列或範本層級設定。"
          }
        }
      }
    },
    "Color, opacity, rotation (in degrees, editable as text), border radius, outline (color + width), and **Clip to Frame** (clips anything that overflows the template)." : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color, opacitat, rotació (en graus, editable com a text), radi de vora, contorn (color + amplada) i **Retalla a marc** (retalla qualsevol cosa que desbordi la plantilla)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farve, opacitet, rotation (i grader, kan redigeres som tekst), kantradius, kontur (farve + bredde) og **Klip til ramme** (klipper alt, der flyder over skabelonen)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farbe, Deckkraft, Drehung (in Grad, als Text bearbeitbar), Rahmenradius, Umriss (Farbe + Breite) und **Auf Rahmen zuschneiden** (schneidet alles ab, was über die Vorlage hinausragt)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color, opacidad, rotación (en grados, editable como texto), radio del borde, contorno (color + ancho) y **Recortar al marco** (recorta cualquier cosa que desborde la plantilla)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رنگ، کدورت، چرخش (در درجه، قابل ویرایش به صورت متن)، شعاع حاشیه، طرح کلی (رنگ + عرض) و **Clip to Frame** (هر چیزی را که در قالب سرریز می کند را گیره می دهد)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väri, peittävyys, kierto (asteina, muokattavissa tekstinä), reunan säde, ääriviivat (väri + leveys) ja **Clip to Frame** (leikkaa kaiken, mikä ylittää mallin)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couleur, opacité, rotation (en degrés, modifiable sous forme de texte), rayon de bordure, contour (couleur + largeur) et **Clip to Frame** (coupe tout ce qui dépasse du modèle)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色、不透明度、回転 (度単位、テキストとして編集可能)、境界線の半径、アウトライン (色 + 幅)、および **フレームにクリップ** (テンプレートからはみ出たものをクリップ)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "색상, 불투명도, 회전(도 단위, 텍스트로 편집 가능), 테두리 반경, 윤곽선(색상 + 너비), **프레임에 맞게 자르기**(템플릿을 벗어나는 모든 항목 자르기)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleur, dekking, rotatie (in graden, bewerkbaar als tekst), randradius, omtrek (kleur + breedte) en **Clip to Frame** (knipt alles af dat over de sjabloon heen loopt)."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farge, opasitet, rotasjon (i grader, redigerbar som tekst), kantradius, kontur (farge + bredde) og **Klipp til ramme** (klipper alt som flyter over malen)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor, opacidade, rotação (em graus, editável como texto), raio da borda, contorno (cor + largura) e **Cortar no quadro** (recorta qualquer coisa que ultrapasse o modelo)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor, opacidade, rotação (em graus, editável como texto), raio da borda, contorno (cor + largura) e **Cortar no quadro** (recorta qualquer coisa que ultrapasse o modelo)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färg, opacitet, rotation (i grader, redigerbar som text), kantradie, kontur (färg + bredd) och **Klipp till ram** (klipper allt som rinner över mallen)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "颜色、不透明度、旋转（以度为单位，可作为文本编辑）、边框半径、轮廓（颜色 + 宽度）和**剪辑到框架**（剪辑溢出模板的任何内容）。"
          }
        }
      }
    },

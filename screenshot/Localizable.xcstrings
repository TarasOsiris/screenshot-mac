    "Use demo mode to walk through the App Store Connect upload feature without an API key — for example during App Review." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie den Demomodus, um die App Store Connect-Upload-Funktion ohne API-Taste durchzugehen – zum Beispiel während der App-Überprüfung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice el modo de demostración para recorrer la función de carga App Store Connect sin una clave API, por ejemplo, durante la revisión de la aplicación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از حالت نمایشی برای عبور از ویژگی آپلود App Store Connect بدون کلید API استفاده کنید - برای مثال در طول بررسی برنامه."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le mode démo pour parcourir la fonctionnalité de téléchargement App Store Connect sans clé API, par exemple lors de l'examen de l'application."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la modalità demo per provare la funzione di caricamento su App Store Connect senza una chiave API, ad esempio durante l'App Review."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デモ モードを使用すると、API キーを使用せずに App Store Connect アップロード機能を実行できます (アプリ レビュー中など)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데모 모드를 사용하여 API 키 없이 App Store Connect 업로드 기능을 살펴보세요(예: 앱 검토 중)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o modo de demonstração para percorrer o recurso de upload de App Store Connect sem uma chave API, por exemplo, durante a revisão do aplicativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте демо-режим, чтобы опробовать загрузку в App Store Connect без ключа API — например, во время App Review."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect yükleme özelliğini API anahtarı olmadan denemek için demo modunu kullanın — örneğin App Review sırasında."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скористайтеся демо-режимом, щоб пройти функцію вивантаження в App Store Connect без ключа API — наприклад, під час App Review."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用演示模式在不使用 API 键的情况下演示 App Store Connect 上传功能 — 例如在应用审核期间。"

    "API key (Issuer ID, Key ID, `.p8` file), **Test Connection**, and **App Review Demo Mode**. See the App Store Connect topic." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاح API (Issuer ID، Key ID، ملف `.p8`)، **اختبار الاتصال**، و**وضع العرض التجريبي لمراجعة التطبيق**. راجع موضوع App Store Connect."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API কী (Issuer ID, Key ID, `.p8` ফাইল), **পরীক্ষা সংযোগ**, এবং **অ্যাপ পর্যালোচনা ডেমো মোড**। App Store Connect বিষয় দেখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tecla API (Issuer ID, Key ID, fitxer `.p8`), **Connexió de prova** i **Mode de demostració de revisió d'aplicacions**. Consulteu el tema App Store Connect."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tlačítko API (Issuer ID, Key ID, soubor `.p8`), **Test připojení** a **Režim kontroly aplikace**. Viz téma App Store Connect."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API-tast (Issuer ID, Key ID, `.p8`-fil), **Testforbindelse** og **Demotilstand for appgennemgang**. Se App Store Connect-emnet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API-Schlüssel (Issuer ID, Key ID, `.p8`-Datei), **Verbindung testen** und **Demomodus für App Review**. Siehe das Thema „App Store Connect“."
          }
        },
        "el" : {
          "stringUnit" : {

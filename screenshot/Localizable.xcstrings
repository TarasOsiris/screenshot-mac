    "Could not read %lld image(s) used by %@ in %@. Re-import the missing screenshots before uploading, or the upload would publish them as blank areas." : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'han pogut llegir %1$lld imatges utilitzades per %2$@ a %3$@. Torneu a importar les captures de pantalla que falten abans de penjar-les, o la càrrega les publicaria com a àrees en blanc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke læse %1$lld billeder brugt af %2$@ i %3$@. Genimporter de manglende skærmbilleder før upload, ellers ville uploaden offentliggøre dem som tomme områder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Bilder, die von %2$@ in %3$@ verwendet werden, konnten nicht gelesen werden. Importieren Sie die fehlenden Screenshots vor dem Hochladen erneut, da sie sonst beim Hochladen als leere Bereiche veröffentlicht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Could not read %1$lld image(s) used by %2$@ in %3$@. Re-import the missing screenshots before uploading, or the upload would publish them as blank areas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer %1$lld imagen(es) usadas por %2$@ en %3$@. Vuelve a importar las capturas que faltan antes de enviarlas, o el envío las publicaría como áreas en blanco."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld تصویر (های) استفاده شده توسط %2$@ در %3$@ خوانده نشد. اسکرین شات های از دست رفته را قبل از آپلود دوباره وارد کنید، در غیر این صورت آپلود آنها را به عنوان قسمت های خالی منتشر می کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei voitu lukea %1$lld kuvaa/kuvia, joita %2$@ käyttää %3$@:ssa. Tuo puuttuvat kuvakaappaukset uudelleen ennen lataamista, tai lataus julkaisee ne tyhjinä alueina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire %1$lld image(s) utilisée(s) par %2$@ dans %3$@. Réimportez les captures d'écran manquantes avant l'envoi, sinon elles seraient publiées sous forme de zones vides."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@ の %2$@ によって使用されている %1$lld イメージを読み取れませんでした。アップロードする前に欠落しているスクリーンショットを再インポートしなければ、アップロード時に空白の領域として公開されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@의 %2$@에서 사용하는 %1$lld 이미지를 읽을 수 없습니다. 업로드하기 전에 누락된 스크린샷을 다시 가져오세요. 그렇지 않으면 업로드 시 해당 스크린샷이 빈 영역으로 게시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan %1$lld afbeelding(en) gebruikt door %2$@ in %3$@ niet lezen. Importeer de ontbrekende schermafbeeldingen opnieuw voordat u ze uploadt, anders worden ze tijdens de upload als lege gebieden gepubliceerd."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke lese %1$lld bilde(r) brukt av %2$@ i %3$@. Importer de manglende skjermbildene på nytt før opplasting, ellers vil opplastingen publisere dem som tomme områder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler %1$lld imagens usadas por %2$@ em %3$@. Importe novamente as capturas de tela ausentes antes do upload, ou o upload as publicará como áreas em branco."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler %1$lld imagens usadas por %2$@ em %3$@. Importe novamente as capturas de ecrã ausentes antes do upload, ou o upload as publicará como áreas em branco."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunde inte läsa %1$lld bild(er) som används av %2$@ i %3$@. Återimportera de saknade skärmdumparna innan uppladdningen, annars skulle uppladdningen publicera dem som tomma områden."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %3$@ 中 %2$@ 使用的 %1$lld 图像。在上传之前重新导入丢失的屏幕截图，否则上传会将它们发布为空白区域。"

        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt hình nền, màu sắc và độ chuyển màu, đồng thời tinh chỉnh mọi yếu tố để phù hợp với thương hiệu của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置背景、颜色和渐变，并微调每个元素以匹配你的品牌。"

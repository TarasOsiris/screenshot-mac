    "It's approved. Start it when you're ready, or choose New Experiment to test other screenshots." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist genehmigt. Starte es, wenn du bereit bist, oder wähle „Neues Experiment“, um andere Screenshots zu testen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está aprobado. Inícialo cuando quieras o elige Nuevo experimento para probar otras capturas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأیید شده است. هر وقت آماده بودید آن را شروع کنید، یا «آزمایش جدید» را برای آزمایش اسکرین‌شات‌های دیگر انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle est approuvée. Lancez-la quand vous êtes prêt, ou choisissez Nouvelle expérience pour tester d’autres captures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È stato approvato. Avvialo quando sei pronto, oppure scegli Nuovo esperimento per testare altri screenshot."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認されました。準備ができたら開始するか、別のスクリーンショットをテストするには「新しい実験」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인되었습니다. 준비되면 시작하거나, 다른 스크린샷을 테스트하려면 새 실험을 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foi aprovado. Inicie quando quiser ou escolha Novo experimento para testar outras capturas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он одобрен. Запустите его, когда будете готовы, или выберите «Новый эксперимент», чтобы протестировать другие скриншоты."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deney onaylandı. Hazır olduğunuzda başlatın ya da başka ekran görüntülerini test etmek için Yeni Deney'i seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його схвалено. Запустіть його, коли будете готові, або виберіть «Новий експеримент», щоб перевірити інші знімки екрана."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已获批准。准备好后即可开始，或选择“新实验”测试其他截图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此實驗已獲核准。準備好時即可開始，或選擇「新實驗」來測試其他螢幕截圖。"
          }
        }
      }
    },

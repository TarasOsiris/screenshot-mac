          }
        }
      }
    },
    "Reorder with **Move Left** / **Move Right** in the template control bar (also in its **⋯** menu). The order decides the exported file numbering." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد الترتيب باستخدام **تحريك لليسار** / **تحريك لليمين** في شريط التحكم في القالب (أيضًا في قائمة **⋯**). يقرر الترتيب ترقيم الملفات المصدرة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টেমপ্লেট কন্ট্রোল বারে **বামে সরান** / **ডানে সরান** দিয়ে পুনরায় সাজান (এছাড়াও এর **⋯** মেনুতে)। অর্ডার রপ্তানি করা ফাইল নম্বর নির্ধারণ করে।"
          }
        },
        "ca" : {
          "stringUnit" : {

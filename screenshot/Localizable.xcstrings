        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ম্যানুয়ালি সারি এবং স্ক্রিনশট আকার সেট আপ করতে **ফাঁকা** বেছে নিন, অথবা একটি পূর্ব-ডিজাইন করা লেআউট দিয়ে শুরু করতে **টেমপ্লেট** বেছে নিন।"
          }
        },
        "ca" : {

    "This plan no longer matches the project: its rows or languages were removed. Go back to the plan and try again." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest pla ja no coincideix amb el projecte: se n'han eliminat les files o els idiomes. Torna al pla i torna-ho a provar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne plan matcher ikke længere projektet: dens rækker eller sprog blev fjernet. Gå tilbage til planen og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Plan passt nicht mehr zum Projekt: Zeilen oder Sprachen daraus wurden entfernt. Geh zurück zum Plan und versuch es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este plan ya no coincide con el proyecto: se eliminaron filas o idiomas. Vuelve al plan e inténtalo de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این برنامه دیگر با پروژه مطابقت ندارد: ردیف‌ها یا زبان‌های آن حذف شده‌اند. به برنامه برگردید و دوباره تلاش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä suunnitelma ei enää vastaa projektia: sen rivit tai kielet poistettiin. Palaa suunnitelmaan ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

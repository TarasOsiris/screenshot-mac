        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**iPad**: **iPad Pro 11\"** y **iPad Pro 13\"**, generación actual, en vertical y horizontal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**iPad** : **iPad Pro 11\"** et **iPad Pro 13\"**, génération actuelle avec portrait et paysage."
          }
        },
        "it" : {

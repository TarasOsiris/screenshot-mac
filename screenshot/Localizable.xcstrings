    "Fix the preflight errors before reviewing changes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بإصلاح أخطاء الاختبار المبدئي قبل مراجعة التغييرات."

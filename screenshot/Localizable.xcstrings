        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रतिमा क्रॉप करताना, बाण की त्याऐवजी चित्राला त्याच्या फ्रेममध्ये हलवतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",

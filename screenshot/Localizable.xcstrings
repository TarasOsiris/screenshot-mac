        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upload vergelijkt elke schermafbeelding met de winkel en verandert alleen wat verschilt, waarbij de App Store item-ID's van exacte overeenkomsten behouden blijven."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last opp sammenligner hvert skjermbilde med butikken og endrer bare det som er forskjellig, og beholder App Store-element-ID-ene for eksakte treff."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesyłanie porównuje każdy zrzut ekranu ze sklepem i zmienia tylko to, co się różni, zachowując dokładne identyfikatory zasobów App Store."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O envio compara cada captura com a loja e altera apenas o que for diferente, mantendo os IDs de recurso da App Store das correspondências exatas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O upload compara cada captura de ecrã com a loja e altera apenas o que difere, mantendo os App Store IDs de ativos de correspondências exatas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încărcarea compară fiecare captură de ecran cu magazinul și modifică numai ceea ce diferă, păstrând ID-urile de material App Store ale potrivirilor exacte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузка сравнивает каждый скриншот с магазином и меняет только то, что отличается, сохраняя ID ресурсов App Store у точных совпадений."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahranie porovná každú snímku obrazovky s obchodom a zmení iba to, čo sa líši, pričom sa zachovajú App Store ID diel presných zhôd."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nalaganje primerja vsak posnetek zaslona s trgovino in spremeni le tisto, kar se razlikuje, pri čemer se ID-ji sredstev App Store natančno ujemajo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upload jämför varje skärmdump med butiken och ändrar bara det som skiljer sig, och behåller App Store tillgångs-ID:n för exakta matchningar."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பதிவேற்றமானது ஒவ்வொரு ஸ்கிரீன் ஷாட்டையும் ஸ்டோருடன் ஒப்பிட்டு, App Store சரியான பொருத்தங்களின் சொத்து ஐடிகளை வைத்து, வேறுபடுவதை மட்டும் மாற்றுகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అప్‌లోడ్ ప్రతి స్క్రీన్‌షాట్‌ను స్టోర్‌తో పోలుస్తుంది మరియు ఖచ్చితమైన సరిపోలికల App Store అసెట్ IDలను ఉంచుతూ తేడా ఉన్న వాటిని మాత్రమే మారుస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อัปโหลดจะเปรียบเทียบภาพหน้าจอแต่ละภาพกับร้านค้า และเปลี่ยนแปลงเฉพาะสิ่งที่แตกต่าง โดยคง App Store รหัสเนื้อหาที่ตรงกันทุกประการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yükleme, her ekran görüntüsünü mağazadakiyle karşılaştırır ve yalnızca farklı olanları değiştirir; birebir eşleşenlerin App Store varlık kimliklerini korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вивантаження порівнює кожен знімок екрана з магазином і змінює лише те, що відрізняється, зберігаючи ідентифікатори ресурсів App Store для точних збігів."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپ لوڈ ہر اسکرین شاٹ کا اسٹور کے ساتھ موازنہ کرتا ہے اور صرف وہی تبدیل کرتا ہے جو مختلف ہوتا ہے، عین مطابق مماثلتوں کی App Store اثاثہ IDs کو برقرار رکھتے ہوئے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tải lên sẽ so sánh từng ảnh chụp màn hình với cửa hàng và chỉ thay đổi những gì khác biệt, giữ lại ID nội dung App Store của các kết quả trùng khớp chính xác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“上传”会将每张截图与商店中的截图比对，只更改有差异的内容，并保留完全一致的截图的 App Store 资源 ID。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「上傳」會將每張螢幕截圖與商店比對，只更改有差異的部分，並保留完全相符項目的 App Store 素材 ID。"
          }
        }
      }
    },

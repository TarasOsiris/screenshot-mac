        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld aktuella skärmdumpar har ingen App Store kontrollsumma, så de kommer att ersättas istället för att bevaras."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld தற்போதைய ஸ்கிரீன்ஷாட்களில் App Store செக்சம் இல்லை, எனவே அவை பாதுகாக்கப்படுவதற்குப் பதிலாக மாற்றப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld ప్రస్తుత స్క్రీన్‌షాట్‌లకు App Store చెక్‌సమ్ లేదు, కాబట్టి అవి భద్రపరచబడకుండా భర్తీ చేయబడతాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภาพหน้าจอปัจจุบันของ %1$lld ไม่มีผลรวมตรวจสอบ App Store ดังนั้นจะถูกแทนที่แทนที่จะเก็บไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli %lld ekran görüntüsünün App Store sağlama toplamı yok; bu yüzden korunmak yerine değiştirilecekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поточні знімки екрана без контрольної суми App Store (%lld) буде замінено, а не збережено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld موجودہ اسکرین شاٹس میں کوئی App Store چیکسم نہیں ہے، لہذا انہیں محفوظ کرنے کی بجائے تبدیل کر دیا جائے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh chụp màn hình hiện tại của %1$lld không có tổng kiểm tra App Store nên chúng sẽ được thay thế thay vì được giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 张当前截图没有 App Store 校验和，因此将被替换而不会保留。"

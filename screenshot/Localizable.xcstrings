    "Has no %@ row, so this upload doesn't change its %@ screenshots." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحتوي على صف %1$@، لذلك لا يؤدي هذا التحميل إلى تغيير لقطات الشاشة %2$@ الخاصة به."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No té cap fila %1$@, així que aquesta càrrega no canvia les seves captures de pantalla %2$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemá žádný řádek %1$@, takže toto nahrání nemění snímky obrazovky %2$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har ingen %1$@ række, så denne upload ændrer ikke sine %2$@ skærmbilleder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hat keine %@-Zeile, daher ändert dieser Upload die %@-Screenshots nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχει σειρά %1$@, επομένως αυτή η μεταφόρτωση δεν αλλάζει τα στιγμιότυπα οθόνης της %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tiene fila de %@, así que esta subida no cambia sus capturas de %@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ردیف %@ ندارد، پس این آپلود اسکرین‌شات‌های %@ آن را تغییر نمی‌دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei sisällä %1$@ riviä, joten tämä lataus ei muuta sen %2$@ kuvakaappauksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'a pas de ligne %@ : cet envoi ne modifie pas ses captures %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין שורה %1$@, כך שהעלאה זו לא משנה את צילומי המסך של %2$@."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema retka %1$@, tako da ovaj prijenos ne mijenja %2$@ snimke zaslona."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem tartalmaz %1$@ sort, így ez a feltöltés nem módosítja a %2$@ képernyőképeit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak memiliki baris %1$@, sehingga unggahan ini tidak mengubah tangkapan layar %2$@-nya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ha una riga %@, quindi questo caricamento non modifica i suoi screenshot %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の行がないため、このアップロードでは %@ のスクリーンショットは変更されません。"

          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Typ de rotatiegraden direct.** Het rotatieveld accepteert tekstinvoer: typ `45` voor een exacte rotatie van 45° in plaats van te slepen."

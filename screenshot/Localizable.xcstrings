          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Варианты — это альтернативные скриншоты для A/B-тестирования на странице продукта в App Store."
          }
        },
        "tr" : {
          "stringUnit" : {

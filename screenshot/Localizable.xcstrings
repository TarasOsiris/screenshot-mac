          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "螢幕截圖同步已停止"
          }
        }
      }
    },
    "Screenshot sync was cancelled before anything was changed in App Store Connect." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Screenshot-Synchronisierung wurde abgebrochen, bevor in App Store Connect etwas geändert wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización de la captura de pantalla se canceló antes de que se cambiara algo en App Store Connect."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همگام‌سازی نماگرفت قبل از تغییر هر چیزی در App Store Connect لغو شد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation des captures d'écran a été annulée avant que quoi que ce soit ne soit modifié dans App Store Connect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione degli screenshot è stata annullata prima che venisse modificato qualcosa in App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect で何かが変更される前に、スクリーンショットの同期がキャンセルされました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect에서 변경사항이 발생하기 전에 스크린샷 동기화가 취소되었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização da captura de tela foi cancelada antes de qualquer alteração em App Store Connect."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация скриншотов отменена до внесения каких-либо изменений в App Store Connect."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran görüntüsü eşzamanlaması, App Store Connect'te herhangi bir değişiklik yapılmadan önce iptal edildi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронізацію знімків екрана скасовано до того, як в App Store Connect щось змінилося."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 App Store Connect 中进行任何更改之前，屏幕截图同步已取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "螢幕截圖同步已在 App Store Connect 中做出任何更改前取消。"
          }
        }
      }
    },
    "Screenshot sync was cancelled. Changes already made in App Store Connect were not reverted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Screenshot-Synchronisierung wurde abgebrochen. Bereits in App Store Connect vorgenommene Änderungen wurden nicht rückgängig gemacht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se canceló la sincronización de la captura de pantalla. Los cambios ya realizados en App Store Connect no se revirtieron."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همگام سازی اسکرین شات لغو شد. تغییراتی که قبلاً در App Store Connect ایجاد شده بود، برگردانده نشدند."
          }

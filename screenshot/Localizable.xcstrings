    "Fonts appear in the text shape font picker once registered." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els tipus de lletra apareixen al selector de fonts de forma de text un cop registrats."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrifttyper vises i skrifttypevælgeren til tekstform, når de er registreret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der Registrierung erscheinen Schriften in der Schriftauswahl von Textformen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez registradas, las fuentes aparecen en el selector de fuentes de las formas de texto."

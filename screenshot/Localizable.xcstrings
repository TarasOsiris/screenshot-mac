    "Hide All" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle ausblenden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar todo"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پنهان کردن همه"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout masquer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascondi tutto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべて非表示"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모두 숨기기"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar tudo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрыть все"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tümünü Gizle"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сховати всі"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部隐藏"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部隱藏"
          }
        }
      }
    },
    "Hide apps with no editable App Store version. Apps in review or already live can't accept new screenshots until you create a new version." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps ohne bearbeitbare App Store-Version ausblenden. Apps in Prüfung oder bereits live können erst neue Screenshots annehmen, wenn du eine neue Version erstellst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar las apps sin una versión editable del App Store. Las apps en revisión o ya publicadas no pueden aceptar nuevas capturas hasta que crees una nueva versión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه‌هایی که نسخهٔ قابل ویرایش App Store ندارند پنهان می‌شوند. برنامه‌های در حال بازبینی یا منتشرشده تا وقتی نسخهٔ جدیدی ایجاد نکنید اسکرین‌شات جدید نمی‌پذیرند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer les apps sans version App Store modifiable. Les apps en cours d'examen ou déjà en ligne ne peuvent pas recevoir de nouvelles captures d'écran tant que vous n'avez pas créé de nouvelle version."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascondi le app senza una versione App Store modificabile. Le app in revisione o già pubblicate non possono ricevere nuovi screenshot finché non crei una nuova versione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集可能な App Store バージョンがないアプリを非表示にします。審査中または公開済みのアプリは、新しいバージョンを作成するまで新しいスクリーンショットを受け付けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집 가능한 App Store 버전이 없는 앱을 숨깁니다. 심사 중이거나 이미 출시된 앱은 새 버전을 만들기 전까지 새 스크린샷을 받을 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta apps sem versão editável na App Store. Apps em revisão ou já publicados não aceitam novas capturas de tela até você criar uma nova versão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрыть приложения без редактируемой версии в App Store. Приложения на проверке или уже опубликованные не принимают новые скриншоты, пока вы не создадите новую версию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenlenebilir App Store sürümü olmayan uygulamaları gizle. İncelemedeki veya zaten yayında olan uygulamalar, siz yeni bir sürüm oluşturana kadar yeni ekran görüntüsü kabul edemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сховати програми без версії App Store, яку можна редагувати. Програми на перевірці або вже опубліковані не можуть приймати нові знімки екрана, доки ви не створите нову версію."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏没有可编辑 App Store 版本的 App。在你创建新版本之前，正在审核或已上线的 App 无法接受新截图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱藏沒有可編輯 App Store 版本的 App。審查中或已上架的 App 在你建立新版本之前無法接受新的螢幕截圖。"
          }
        }
      }
    },
    "Hide apps with no editable App Store version. Apps that are already live can't accept metadata changes until you create a new version." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps ohne bearbeitbare App Store-Version ausblenden. Bereits live geschaltete Apps können erst Metadatenänderungen annehmen, wenn du eine neue Version erstellst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar las apps sin una versión editable del App Store. Las apps ya publicadas no pueden aceptar cambios de metadatos hasta que crees una nueva versión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه‌هایی که نسخهٔ قابل ویرایش App Store ندارند پنهان می‌شوند. برنامه‌های منتشرشده تا وقتی نسخهٔ جدیدی ایجاد نکنید تغییرات فراداده را نمی‌پذیرند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer les apps sans version App Store modifiable. Les apps déjà en ligne ne peuvent pas recevoir de modifications de métadonnées tant que vous n'avez pas créé de nouvelle version."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascondi le app senza una versione App Store modificabile. Le app già pubblicate non possono ricevere modifiche ai metadati finché non crei una nuova versione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集可能な App Store バージョンがないアプリを非表示にします。公開済みのアプリは、新しいバージョンを作成するまでメタデータの変更を受け付けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집 가능한 App Store 버전이 없는 앱을 숨깁니다. 이미 출시된 앱은 새 버전을 만들기 전까지 메타데이터를 변경할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta apps sem versão editável na App Store. Apps já publicados não aceitam alterações de metadados até você criar uma nova versão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрыть приложения без редактируемой версии в App Store. Уже опубликованные приложения не принимают изменения метаданных, пока вы не создадите новую версию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenlenebilir App Store sürümü olmayan uygulamaları gizle. Zaten yayında olan uygulamalar, siz yeni bir sürüm oluşturana kadar meta veri değişikliği kabul edemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сховати програми без версії App Store, яку можна редагувати. Уже опубліковані програми не можуть приймати зміни метаданих, доки ви не створите нову версію."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏没有可编辑 App Store 版本的 App。在你创建新版本之前，已上线的 App 无法接受元数据更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱藏沒有可編輯 App Store 版本的 App。已上架的 App 在你建立新版本之前無法接受後設資料更改。"
          }
        }
      }
    },

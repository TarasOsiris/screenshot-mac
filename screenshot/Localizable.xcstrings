    "Both raster and SVG images are supported as backgrounds." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant les imatges ràster com les SVG s'admeten com a fons."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både raster- og SVG-billeder understøttes som baggrunde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Hintergründe werden sowohl Raster- als auch SVG-Bilder unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se admiten como fondos tanto imágenes rasterizadas como SVG."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هم تصاویر پیکسلی و هم SVG به‌عنوان پس‌زمینه پشتیبانی می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekä rasteri- että SVG-kuvia tuetaan taustana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images raster et SVG sont prises en charge comme arrière-plans."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come sfondi sono supportate sia immagini raster sia SVG."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景にはラスター画像と SVG 画像のどちらも使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "래스터 이미지와 SVG 이미지가 모두 배경으로 지원됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zowel raster- als SVG-afbeeldingen worden ondersteund als achtergrond."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både raster- og SVG-bilder støttes som bakgrunn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagens raster e SVG são suportadas como plano de fundo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagens raster e SVG são suportadas como plano de fundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В качестве фона поддерживаются как растровые изображения, так и SVG."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både raster- och SVG-bilder stöds som bakgrunder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka plan olarak hem raster hem de SVG görüntüler desteklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як тло підтримуються і растрові, і SVG-зображення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光栅图像和 SVG 图像均可用作背景。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點陣影像和 SVG 影像都可以作為背景。"
          }
        }
      }
    },
    "Both render identically in the editor preview and in the exported PNG." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tots dos es mostren de manera idèntica a la vista prèvia de l'editor i al PNG exportat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begge gengives identisk i editorens forhåndsvisning og i den eksporterede PNG."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide werden in der Editor-Vorschau und im exportierten PNG identisch gerendert."

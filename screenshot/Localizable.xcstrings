          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect 未确认 %1$@ 的最终屏幕截图顺序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect 未確認 %@ 的最終螢幕截圖順序。"

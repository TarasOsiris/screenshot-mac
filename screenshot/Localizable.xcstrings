          "stringUnit" : {
            "state" : "translated",
            "value" : "Skala ner texten så att varje rad passar rutan, på alla språk"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปรับขนาดข้อความลงเพื่อให้ทุกบรรทัดพอดีกับช่องในทุกภาษา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metni, her dilde her satır kutuya sığacak şekilde küçültür"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зменшує текст, щоб кожен рядок уміщався в рамку, будь-якою мовою"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متن کو نیچے کی پیمائش کریں تاکہ ہر لائن ہر زبان میں باکس میں فٹ ہوجائے"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thu nhỏ văn bản xuống để mỗi dòng vừa với hộp, bằng mọi ngôn ngữ"
          }
        },
        "zh-Hans" : {

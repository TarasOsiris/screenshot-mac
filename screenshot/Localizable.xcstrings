        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪಠ್ಯ ಪೆಟ್ಟಿಗೆಯನ್ನು ಹಿಗ್ಗಿಸಿ, ಅನುವಾದವನ್ನು ಕಡಿಮೆ ಮಾಡಿ ಅಥವಾ ಫಿಟ್‌ಗೆ ಕುಗ್ಗಿಸು ಆನ್ ಮಾಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 상자를 키우거나 번역을 줄이거나 '맞게 축소'를 켜세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ടെക്‌സ്‌റ്റ് ബോക്‌സ് വലുതാക്കുക, വിവർത്തനം ചെറുതാക്കുക അല്ലെങ്കിൽ ഫിറ്റിലേക്ക് ചുരുക്കുക ഓണാക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मजकूर बॉक्स मोठा करा, भाषांतर लहान करा किंवा फिट करण्यासाठी संकुचित करा चालू करा."
          }
        },
        "ms" : {
          "stringUnit" : {

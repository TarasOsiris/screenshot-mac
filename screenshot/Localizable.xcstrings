    "The **⋯ menu** offers per-template actions like duplicate, delete, and export preview." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توفر القائمة **⋯** إجراءات لكل قالب مثل التكرار والحذف ومعاينة التصدير."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⋯ মেনু** প্রতি-টেমপ্লেট অ্যাকশন যেমন ডুপ্লিকেট, ডিলিট এবং এক্সপোর্ট প্রিভিউ অফার করে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El menú **⋯** ofereix accions per plantilla, com ara duplicar, suprimir i exportar la vista prèvia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabídka **⋯** nabízí akce pro jednotlivé šablony, jako je duplikování, odstranění a export náhledu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menuen **⋯** tilbyder handlinger pr. skabelon som dupliker, slet og eksportér forhåndsvisning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das **⋯-Menü** bietet vorlagenspezifische Aktionen wie Duplizieren, Löschen und Exportvorschau."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το μενού **⋯** προσφέρει ενέργειες ανά πρότυπο, όπως αντιγραφή, διαγραφή και προεπισκόπηση εξαγωγής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El **⋯ menú** ofrece acciones por plantilla como duplicar, eliminar y exportar vista previa."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منوی **⋯ ** عملکردهای هر الگو مانند پیش نمایش تکراری، حذف، و صادرات را ارائه می دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⋯-valikko** tarjoaa mallikohtaisia toimintoja, kuten kopioinnin, poistamisen ja viennin esikatselun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le menu **⋯** propose des actions par modèle telles que la duplication, la suppression et l'aperçu de l'exportation."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "** મેનુ** ડુપ્લિકેટ, ડિલીટ અને નિકાસ પૂર્વાવલોકન જેવી પ્રતિ-ટેમ્પલેટ ક્રિયાઓ ઓફર કરે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תפריט **⋯** מציע פעולות לכל תבנית כמו שכפול, מחיקה ויצוא תצוגה מקדימה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⋯ मेनू** डुप्लिकेट, डिलीट और निर्यात पूर्वावलोकन जैसी प्रति-टेम्पलेट कार्रवाइयां प्रदान करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⋯ Izbornik** nudi radnje po predlošku kao što su dupliciranje, brisanje i pregled izvoza."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A **⋯ menü** sablononkénti műveleteket kínál, például másolást, törlést és előnézeti exportálást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⋯ Menu** menawarkan tindakan per template seperti duplikat, hapus, dan ekspor pratinjau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⋯ メニュー** では、複製、削除、プレビューのエクスポートなどのテンプレートごとのアクションが提供されます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⋯ ಮೆನು** ನಕಲು, ಅಳಿಸುವಿಕೆ ಮತ್ತು ರಫ್ತು ಪೂರ್ವವೀಕ್ಷಣೆಯಂತಹ ಪ್ರತಿ-ಟೆಂಪ್ಲೇಟ್ ಕ್ರಿಯೆಗಳನ್ನು ನೀಡುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⋯ 메뉴**는 복제, 삭제, 내보내기 미리보기 등의 템플릿별 작업을 제공합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⋯ മെനു** ഡ്യൂപ്ലിക്കേറ്റ്, ഡിലീറ്റ്, എക്‌സ്‌പോർട്ട് പ്രിവ്യൂ എന്നിങ്ങനെയുള്ള ടെംപ്ലേറ്റ് പ്രവർത്തനങ്ങൾ വാഗ്ദാനം ചെയ്യുന്നു."
          }
        },
        "mr" : {

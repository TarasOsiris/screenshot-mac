            "state" : "translated",
            "value" : "PNG یا JPEG، ۳۲۰–۳۸۴۰ پیکسل در هر لبه، نسبت تصویر تا ۲:۱، ۲ تا ۸ عکس."
          }
        },
        "fr" : {
          "stringUnit" : {

          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Échelle** — 1×, 2×, 3×."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**スケール** — 1×、2×、3×。"
          }
        },
        "ko" : {

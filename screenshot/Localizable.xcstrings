        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaten yayında olan sürümleri göster. Meta veriler yalnızca düzenlenebilir sürümlerde değiştirilebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показати вже опубліковані версії. Метадані можна змінювати лише у версіях, доступних для редагування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示已上线的版本。元数据只能在可编辑的版本中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示已上架的版本。只有可編輯的版本才能更改後設資料。"
          }
        }
      }
    },
    "Show versions that are locked for review or live. Screenshots can only be uploaded to editable versions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigen Sie Versionen an, die zur Überprüfung oder zur Live-Übertragung gesperrt sind. Screenshots können nur in bearbeitbaren Versionen hochgeladen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show versions that are locked for review or live. Screenshots can only be uploaded to editable versions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar versiones que están bloqueadas para revisión o en vivo. Las capturas de pantalla solo se pueden cargar en versiones editables."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نمایش نسخه هایی که برای بازبینی یا زنده قفل شده اند. اسکرین شات ها را فقط می توان در نسخه های قابل ویرایش آپلود کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher les versions verrouillées pour révision ou en direct. Les captures d'écran ne peuvent être téléchargées que vers des versions modifiables."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra le versioni bloccate per la revisione o pubblicate. Gli screenshot possono essere caricati solo nelle versioni modificabili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レビューまたはライブ用にロックされているバージョンを表示します。スクリーンショットは編集可能なバージョンにのみアップロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검토 또는 라이브를 위해 잠긴 버전을 표시합니다. 스크린샷은 편집 가능한 버전에만 업로드할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar versões que estão bloqueadas para revisão ou ativas. As capturas de tela só podem ser carregadas em versões editáveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать версии, заблокированные на время проверки или опубликованные. Скриншоты можно загружать только в редактируемые версии."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnceleme için kilitli veya yayında olan sürümleri göster. Ekran görüntüleri yalnızca düzenlenebilir sürümlere yüklenebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показати версії, заблоковані на перевірку або вже опубліковані. Знімки екрана можна вивантажувати лише у версії, доступні для редагування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

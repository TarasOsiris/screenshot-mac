        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je to možné, na výber vhodnej kategórie zariadenia alebo rámu sa používajú rozpoznané rozmery snímky obrazovky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepoznane mere posnetka zaslona se uporabljajo za izbiro ustrezne kategorije naprave ali okvirja, kadar je to mogoče."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkända skärmdumpsdimensioner används för att välja en lämplig enhetskategori eller ram när det är möjligt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขนาดภาพหน้าจอที่รู้จักจะใช้เพื่อเลือกหมวดหมู่อุปกรณ์หรือเฟรมที่เหมาะสมเมื่อเป็นไปได้"

        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のスクリーンショットの同期がすでに実行されています。完了するまで待つか、最初にキャンセルしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 스크린샷 동기화가 이미 실행 중입니다. 완료될 때까지 기다리거나 먼저 취소하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outra sincronização de captura de tela já está em execução. Espere que termine ou cancele primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже выполняется другая синхронизация скриншотов. Дождитесь ее завершения или сначала отмените ее."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir ekran görüntüsü eşzamanlaması zaten çalışıyor. Bitmesini bekleyin ya da önce iptal edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже триває інша синхронізація знімків екрана. Дочекайтеся її завершення або спершу скасуйте її."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个屏幕截图同步已在运行。等待它完成，或者先取消它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一個螢幕截圖同步正在執行。請等待它完成，或先將其取消。"
          }
        }
      }
    },

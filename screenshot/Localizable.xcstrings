    "Click empty canvas inside a row to select the row itself and reveal row-level inspector controls." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر فوق لوحة قماشية فارغة داخل الصف لتحديد الصف نفسه وكشف عناصر تحكم المفتش على مستوى الصف."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সারিটি নির্বাচন করতে এবং সারি-স্তরের পরিদর্শক নিয়ন্ত্রণগুলি প্রকাশ করতে একটি সারির ভিতরে খালি ক্যানভাসে ক্লিক করুন৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feu clic al llenç buit dins d'una fila per seleccionar la fila i mostrar els controls de l'inspector a nivell de fila."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknutím na prázdné plátno uvnitř řádku vyberete samotný řádek a zobrazíte ovládací prvky inspektora na úrovni řádku."

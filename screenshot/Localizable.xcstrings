    "RevenueCat is configured with a Test Store API key. Replace it with your Apple public SDK key before shipping." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat ist mit einem Testspeicherschlüssel API konfiguriert. Ersetzen Sie ihn vor dem Versand durch Ihren öffentlichen Apple SDK-Schlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat está configurado con una clave de API de Test Store. Sustitúyela por tu clave pública SDK de Apple antes de publicar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat با یک کلید فروشگاه آزمایشی API پیکربندی شده است. قبل از ارسال، آن را با کلید SDK عمومی Apple خود جایگزین کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat est configuré avec une clé Test Store API. Remplacez-le par votre clé SDK publique Apple avant l'expédition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat è configurato con una chiave API del Test Store. Sostituiscila con la tua chiave SDK pubblica Apple prima della distribuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat はテスト ストア API キーで構成されています。出荷前に、Apple 公開 SDK キーに置き換えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat은 테스트 저장소 API 키로 구성됩니다. 배송하기 전에 Apple 공개 SDK 키로 교체하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat é configurado com uma chave de armazenamento de teste API. Substitua-a pela sua chave SDK pública da Apple antes do envio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat настроен с ключом API Test Store. Перед выпуском замените его публичным ключом Apple SDK."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat bir Test Store API anahtarıyla yapılandırılmış. Yayımlamadan önce bunu Apple genel SDK anahtarınızla değiştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat налаштовано з ключем API тестового магазину. Перед випуском замініть його своїм публічним ключем SDK для Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat 配置有测试存储 API 键。在发货前将其替换为您的 Apple 公共 SDK 密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat 目前使用 Test Store API 密鑰設定。發佈前請將其替換為你的 Apple 公開 SDK 密鑰。"
          }
        }
      }
    },

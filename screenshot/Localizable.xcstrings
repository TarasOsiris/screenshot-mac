    "Values are saved automatically on this Mac. The private key is stored in Keychain." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els valors es desen automàticament en aquest Mac. La clau privada s'emmagatzema al Keychain."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Værdier gemmes automatisk på denne Mac. Den private nøgle er gemt i nøglering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werte werden automatisch auf diesem Mac gespeichert. Der private Schlüssel wird im Schlüsselbund gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores se guardan automáticamente en este Mac. La clave privada se almacena en el Llavero."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقادیر به طور خودکار در این Mac ذخیره می‌شوند. کلید خصوصی در Keychain ذخیره می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arvot tallennetaan automaattisesti tälle Mac. Yksityinen avain on tallennettu Avainnippuun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs sont enregistrées automatiquement sur ce Mac. La clé privée est stockée dans le trousseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I valori vengono salvati automaticamente su questo Mac. La chiave privata viene salvata nel Portachiavi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値はこの Mac に自動的に保存されます。秘密キーはキーチェーンに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "값은 이 Mac에 자동으로 저장됩니다. 개인 키는 키체인에 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarden worden automatisch opgeslagen op deze Mac. De privésleutel wordt opgeslagen in Keychain."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdier lagres automatisk på denne Mac. Den private nøkkelen er lagret i nøkkelring."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os valores são salvos automaticamente neste Mac. A chave privada fica guardada nas Chaves."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os valores são guardados automaticamente neste Mac. A chave privada é armazenada no Keychain."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значения сохраняются на этом Mac автоматически. Закрытый ключ хранится в Связке ключей."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värden sparas automatiskt på denna Mac. Den privata nyckeln lagras i nyckelring."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değerler bu Mac'te otomatik olarak kaydedilir. Özel anahtar Anahtar Zinciri'nde saklanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значення автоматично зберігаються на цьому Mac. Приватний ключ зберігається у В’язці ключів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些值会自动保存在此 Mac 上。私钥存储在钥匙串中。"

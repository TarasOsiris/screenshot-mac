          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Скопировать путь к файлу проекта** копирует путь к его `project.json` — пригодится в отчете об ошибке."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Proje Dosyası Yolunu Kopyala**, projenin `project.json` dosyasının yolunu kopyalar — hata raporlarında işe yarar."
          }

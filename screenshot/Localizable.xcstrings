    "Edit the base language and each translated language side by side. Leave a cell empty to use the base language text." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتحرير اللغة الأساسية وكل لغة مترجمة جنبًا إلى جنب. اترك خلية فارغة لاستخدام نص اللغة الأساسية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মূল ভাষা এবং প্রতিটি অনুবাদিত ভাষা পাশাপাশি সম্পাদনা করুন। বেস ল্যাঙ্গুয়েজ টেক্সট ব্যবহার করতে একটি ঘর খালি রাখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editeu l'idioma base i cada idioma traduït al costat de l'altre. Deixeu una cel·la buida per utilitzar el text de l'idioma base."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upravte základní jazyk a každý přeložený jazyk vedle sebe. Chcete-li použít text v základním jazyce, ponechte buňku prázdnou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rediger basissproget og hvert oversat sprog side om side. Lad en celle være tom for at bruge grundsprogets tekst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeite die Basissprache und jede übersetzte Sprache nebeneinander. Lass eine Zelle leer, um den Text der Basissprache zu verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επεξεργαστείτε τη βασική γλώσσα και κάθε μεταφρασμένη γλώσσα δίπλα δίπλα. Αφήστε ένα κελί κενό για να χρησιμοποιήσετε το κείμενο της βασικής γλώσσας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edita el idioma base y cada idioma traducido en paralelo. Deja una celda vacía para usar el texto del idioma base."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زبان پایه و هر زبان ترجمه شده را کنار هم ویرایش کنید. برای استفاده از متن زبان پایه، یک سلول خالی بگذارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muokkaa peruskieltä ja jokaista käännettyä kieltä vierekkäin. Jätä solu tyhjäksi käyttääksesi peruskielen tekstiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiez côte à côte la langue de base et chaque langue traduite. Laissez une cellule vide pour utiliser le texte de la langue de base."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "બેઝ લેંગ્વેજ અને દરેક અનુવાદિત ભાષાને સાથે-સાથે સંપાદિત કરો. બેઝ લેંગ્વેજ ટેક્સ્ટનો ઉપયોગ કરવા માટે કોષને ખાલી છોડો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ערוך את שפת הבסיס וכל שפה מתורגמת זה לצד זה. השאר תא ריק כדי להשתמש בטקסט של שפת הבסיס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मूल भाषा और प्रत्येक अनुवादित भाषा को एक साथ संपादित करें। मूल भाषा पाठ का उपयोग करने के लिए एक सेल खाली छोड़ दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uredite osnovni jezik i svaki prevedeni jezik jedan pored drugog. Ostavite ćeliju praznu za korištenje teksta na osnovnom jeziku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szerkessze egymás mellett az alapnyelvet és az egyes lefordított nyelveket. Az alapnyelvi szöveg használatához hagyjon üresen egy cellát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit bahasa dasar dan setiap bahasa terjemahan secara berdampingan. Biarkan sel kosong untuk menggunakan teks bahasa dasar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica la lingua di base e ciascuna lingua tradotta fianco a fianco. Lascia vuota una cella per usare il testo della lingua di base."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本言語と各翻訳言語を並べて編集します。セルを空のままにすると、基本言語のテキストが使われます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮೂಲ ಭಾಷೆ ಮತ್ತು ಪ್ರತಿ ಅನುವಾದಿತ ಭಾಷೆಯನ್ನು ಅಕ್ಕಪಕ್ಕದಲ್ಲಿ ಸಂಪಾದಿಸಿ. ಮೂಲ ಭಾಷೆಯ ಪಠ್ಯವನ್ನು ಬಳಸಲು ಕೋಶವನ್ನು ಖಾಲಿ ಬಿಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 언어와 번역된 각 언어를 나란히 편집합니다. 기본 언어 텍스트를 사용하려면 셀을 비워 두세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അടിസ്ഥാന ഭാഷയും വിവർത്തനം ചെയ്ത ഓരോ ഭാഷയും വശങ്ങളിലായി എഡിറ്റ് ചെയ്യുക. അടിസ്ഥാന ഭാഷാ വാചകം ഉപയോഗിക്കുന്നതിന് ഒരു സെൽ ശൂന്യമായി വിടുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मूळ भाषा आणि प्रत्येक अनुवादित भाषा शेजारी शेजारी संपादित करा. मूळ भाषा मजकूर वापरण्यासाठी सेल रिकामा सोडा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit bahasa asas dan setiap bahasa terjemahan sebelah menyebelah. Biarkan sel kosong untuk menggunakan teks bahasa asas."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewerk de basistaal en elke vertaalde taal naast elkaar. Laat een cel leeg om de tekst in de basistaal te gebruiken."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rediger basisspråket og hvert oversatt språk side ved side. La en celle være tom for å bruke grunnspråkteksten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edytuj język podstawowy i każdy przetłumaczony język obok siebie. Aby użyć tekstu w języku podstawowym, pozostaw komórkę pustą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edite o idioma base e cada idioma traduzido lado a lado. Deixe uma célula vazia para usar o texto do idioma base."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edite o idioma base e cada idioma traduzido lado a lado. Deixe uma célula vazia para usar o texto do idioma base."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editați limba de bază și fiecare limbă tradusă una lângă alta. Lăsați o celulă goală pentru a utiliza textul în limba de bază."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Редактируйте базовый язык и каждый переведенный язык рядом. Оставьте ячейку пустой, чтобы использовать текст базового языка."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upravte základný jazyk a každý preložený jazyk vedľa seba. Ak chcete použiť text v základnom jazyku, ponechajte bunku prázdnu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uredite osnovni jezik in vsak prevedeni jezik drug poleg drugega. Če želite uporabiti besedilo v osnovnem jeziku, pustite celico prazno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigera basspråket och varje översatt språk sida vid sida. Lämna en cell tom för att använda grundspråkstexten."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அடிப்படை மொழி மற்றும் மொழிபெயர்க்கப்பட்ட ஒவ்வொரு மொழியும் அருகருகே திருத்தவும். அடிப்படை மொழி உரையைப் பயன்படுத்த ஒரு கலத்தை காலியாக விடவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మూల భాషను మరియు అనువదించబడిన ప్రతి భాషను పక్కపక్కనే సవరించండి. మూల భాష వచనాన్ని ఉపయోగించడానికి సెల్‌ను ఖాళీగా ఉంచండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แก้ไขภาษาพื้นฐานและภาษาที่แปลแต่ละภาษาเคียงข้างกัน เว้นเซลล์ว่างไว้เพื่อใช้ข้อความภาษาพื้นฐาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temel dili ve çevrilen her dili yan yana düzenleyin. Temel dil metnini kullanmak için bir hücreyi boş bırakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Редагуйте базову мову й кожну мову перекладу поруч. Залиште комірку порожньою, щоб використати текст базової мови."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بنیادی زبان اور ہر ترجمہ شدہ زبان میں ساتھ ساتھ ترمیم کریں۔ بنیادی زبان کا متن استعمال کرنے کے لیے سیل کو خالی چھوڑ دیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉnh sửa ngôn ngữ cơ sở và từng ngôn ngữ dịch cạnh nhau. Để trống một ô để sử dụng văn bản ngôn ngữ cơ sở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "并排编辑基准语言和每种已翻译的语言。将单元格留空即可使用基准语言文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "並排編輯基準語言和每種已翻譯的語言。將儲存格留空即可使用基準語言的文字。"
          }
        }
      }
    },

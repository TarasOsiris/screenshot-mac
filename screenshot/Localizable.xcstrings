        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**アップデート** — **アップデートを自動的に確認** と、今すぐ確認する **アップデートを確認…**。同じコマンドは **Screenshot Bro** メニューにもあります。"
          }
        },
        "ko" : {

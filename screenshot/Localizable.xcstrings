    },
    "In the **Google Cloud console**, create a service account and enable the **Google Play Android Developer API**." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle in der **Google Cloud Console** ein Dienstkonto und aktiviere die **Google Play Android Developer API**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la **consola de Google Cloud**, crea una cuenta de servicio y activa la **Google Play Android Developer API**."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در **Google Cloud console** یک حساب سرویس بسازید و **Google Play Android Developer API** را فعال کنید."
          }
        },
        "fr" : {
          "stringUnit" : {

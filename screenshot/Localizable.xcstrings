        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ App Store Connect で既に行われた変更は元に戻されませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ App Store Connect에 이미 변경된 사항은 되돌려지지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ As alterações já feitas em App Store Connect não foram revertidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Изменения, уже внесенные в App Store Connect, не были отменены."

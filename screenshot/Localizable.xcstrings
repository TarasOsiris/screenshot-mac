    "Manual rotation via the rotation control on the properties bar rotates the entire shape including frame and screen content." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي التدوير اليدوي عبر التحكم في التدوير على شريط الخصائص إلى تدوير الشكل بالكامل بما في ذلك محتوى الإطار والشاشة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rotació manual mitjançant el control de rotació de la barra de propietats gira tota la forma, inclòs el marc i el contingut de la pantalla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruční otočení pomocí ovladače otáčení na panelu vlastností otočí celý tvar včetně rámečku a obsahu obrazovky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuel rotation via rotationskontrollen på egenskabslinjen roterer hele figuren inklusive ramme- og skærmindhold."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch die manuelle Drehung über die Drehsteuerung in der Eigenschaftenleiste wird die gesamte Form einschließlich Rahmen und Bildschirminhalt gedreht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η χειροκίνητη περιστροφή μέσω του ελέγχου περιστροφής στη γραμμή ιδιοτήτων περιστρέφει ολόκληρο το σχήμα, συμπεριλαμβανομένου του περιεχομένου του πλαισίου και της οθόνης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rotación manual a través del control de rotación en la barra de propiedades gira toda la forma, incluido el marco y el contenido de la pantalla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چرخش دستی از طریق کنترل چرخش در نوار خصوصیات، کل شکل از جمله محتوای فریم و صفحه را می‌چرخاند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuaalinen kierto ominaisuuspalkin kiertosäätimellä kääntää koko muodon, mukaan lukien kehyksen ja näytön sisällön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rotation manuelle via le contrôle de rotation sur la barre de propriétés fait pivoter la forme entière, y compris le contenu du cadre et de l'écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סיבוב ידני באמצעות בקרת הסיבוב בסרגל המאפיינים מסובב את כל הצורה כולל תוכן המסגרת והמסך."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ručna rotacija putem kontrole rotacije na traci svojstava rotira cijeli oblik uključujući okvir i sadržaj zaslona."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tulajdonságsávon található elforgatásvezérlővel végzett kézi elforgatás elforgatja a teljes alakzatot, beleértve a keretet és a képernyő tartalmát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotasi manual melalui kontrol rotasi pada bilah properti memutar seluruh bentuk termasuk bingkai dan konten layar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロパティ バーの回転コントロールを使用して手動で回転すると、フレームや画面のコンテンツを含む形状全体が回転します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "속성 표시줄의 회전 컨트롤을 통한 수동 회전은 프레임과 화면 내용을 포함한 전체 모양을 회전합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putaran manual melalui kawalan putaran pada bar sifat memutarkan keseluruhan bentuk termasuk bingkai dan kandungan skrin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handmatige rotatie via de rotatiebediening op de eigenschappenbalk roteert de gehele vorm, inclusief frame en scherminhoud."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuell rotasjon via rotasjonskontrollen på egenskapslinjen roterer hele formen inkludert ramme- og skjerminnhold."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ręczny obrót za pomocą elementu sterującego obrotem na pasku właściwości powoduje obrót całego kształtu, łącznie z ramką i zawartością ekranu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rotação manual através do controle de rotação na barra de propriedades gira toda a forma, incluindo o quadro e o conteúdo da tela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rotação manual através do controle de rotação na barra de propriedades gira toda a forma, incluindo o quadro e o conteúdo da ecrã."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotirea manuală prin intermediul controlului de rotație de pe bara de proprietăți rotește întreaga formă, inclusiv cadrul și conținutul ecranului."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuálne otáčanie pomocou ovládača otáčania na paneli vlastností otočí celý tvar vrátane rámčeka a obsahu obrazovky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ročno vrtenje prek kontrolnika vrtenja v vrstici z lastnostmi zavrti celotno obliko, vključno z okvirjem in vsebino zaslona."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuell rotation via rotationskontrollen på egenskapsfältet roterar hela formen inklusive ram och skärminnehåll."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การหมุนด้วยตนเองผ่านตัวควบคุมการหมุนบนแถบคุณสมบัติจะหมุนรูปร่างทั้งหมด รวมถึงเนื้อหาเฟรมและหน้าจอ"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پراپرٹیز بار پر روٹیشن کنٹرول کے ذریعے دستی گردش فریم اور اسکرین کے مواد سمیت پوری شکل کو گھماتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xoay thủ công thông qua điều khiển xoay trên thanh thuộc tính sẽ xoay toàn bộ hình dạng bao gồm nội dung khung và màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过属性栏上的旋转控件进行手动旋转可旋转整个形状，包括框架和屏幕内容。"
          }
        }
      }
    },

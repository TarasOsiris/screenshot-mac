        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaixo da versão de onde veio sua cópia: **App Store** ou **Download direto**."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sub versiunea, de unde provine copia dvs.: **App Store** sau **Descărcare directă**."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Под версией — откуда установлена ваша копия: **App Store** или **Прямая загрузка**."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pod verziou, z ktorej pochádza vaša kópia: **App Store** alebo **Priame stiahnutie**."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pod različico, iz katere izvira vaša kopija: **App Store** ali **Neposredni prenos**."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedanför versionen, varifrån din kopia kom: **App Store** eller **Direktnedladdning**."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เวอร์ชันต่ำกว่าซึ่งเป็นแหล่งที่มาของสำเนาของคุณ: **App Store** หรือ **ดาวน์โหลดโดยตรง**"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

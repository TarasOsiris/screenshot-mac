          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold nede **midtmuseknappen** og dra for å panorere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj **środkowy przycisk myszy** i przeciągnij, aby przesuwać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure o **botão do meio do mouse** e arraste para deslocar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure o **botão do meio do rato** e arraste para deslocar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Țineți apăsat **butonul din mijloc al mouse-ului** și trageți pentru a deplasa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте **среднюю кнопку мыши** и перетаскивайте, чтобы прокручивать."
          }
        },
        "sk" : {
          "stringUnit" : {

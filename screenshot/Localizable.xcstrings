    "Nothing was uploaded — the edit was discarded, so your listing is untouched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde nichts hochgeladen – die Bearbeitung wurde verworfen, Ihr Eintrag bleibt also unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se cargó nada; la edición se descartó, por lo que su anuncio no se modifica."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هیچ چیزی آپلود نشد - ویرایش حذف شد، بنابراین فهرست شما دست نخورده است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n'a été téléchargé : la modification a été ignorée, votre fiche n'est donc pas modifiée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何もアップロードされませんでした。編集は破棄されたため、リストは変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무것도 업로드되지 않았습니다. 수정 사항이 삭제되었으므로 목록은 그대로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada foi carregado – a edição foi descartada, portanto sua listagem permanece intacta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有上传任何内容 - 编辑已被丢弃，因此您的列表未受影响。"
          }
        }
      }
    },

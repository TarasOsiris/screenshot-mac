    "Log and track your table tennis practice." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجيل وتتبع ممارسة تنس الطاولة الخاص بك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registreu i feu un seguiment de la vostra pràctica de tennis taula."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznamenejte a sledujte svou praxi stolního tenisu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log og spor din bordtennistræning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasse und verfolge dein Tischtennistraining."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καταγράψτε και παρακολουθήστε την πρακτική σας στο πινγκ πονγκ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra y sigue tus entrenamientos de tenis de mesa."

        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Zmiany wprowadzone już w App Store Connect nie zostały cofnięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ As alterações já feitas no App Store Connect não foram revertidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ As alterações já feitas em App Store Connect não foram revertidas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Modificările deja făcute în App Store Connect nu au fost anulate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Изменения, уже внесенные в App Store Connect, не были отменены."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Zmeny vykonané v App Store Connect už neboli vrátené."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Spremembe, ki so bile že narejene v App Store Connect, niso bile razveljavljene."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Ändringar som redan gjorts i App Store Connect återställdes inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ การเปลี่ยนแปลงที่ทำไปแล้วใน App Store Connect จะไม่ถูกเปลี่ยนกลับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ App Store Connect'te zaten yapılmış değişiklikler geri alınmadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Зміни, уже внесені в App Store Connect, не скасовано."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ App Store Connect میں پہلے سے کی گئی تبدیلیاں واپس نہیں کی گئیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Những thay đổi đã được thực hiện trong App Store Connect không được hoàn nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ App Store Connect 中已进行的更改未还原。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@已在 App Store Connect 中做出的更改未被還原。"
          }
        }
      }
    },
    "%@ Check that the Issuer ID, Key ID, private key, and API key permissions match the App Store Connect key." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ تحقق من تطابق أذونات المفتاح Issuer ID وKey ID والمفتاح الخاص وAPI مع المفتاح App Store Connect."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Comproveu que els permisos de la clau Issuer ID, Key ID, la clau privada i la clau API coincideixen amb la clau App Store Connect."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Zkontrolujte, zda oprávnění Issuer ID, Key ID, soukromého klíče a klíče API odpovídají klíči App Store Connect."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Kontroller, at nøgletilladelserne Issuer ID, Key ID, den private nøgle og API stemmer overens med nøglen App Store Connect."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Prüfe, ob Issuer ID, Key ID, privater Schlüssel und die Berechtigungen des API-Schlüssels zum App Store Connect-Schlüssel passen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Ελέγξτε ότι τα δικαιώματα Issuer ID, Key ID, ιδιωτικού κλειδιού και API κλειδιού ταιριάζουν με το κλειδί App Store Connect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Comprueba que el Issuer ID, el Key ID, la clave privada y los permisos de la clave de API coinciden con la clave de App Store Connect."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ بررسی کنید که Issuer ID، Key ID، کلید خصوصی و مجوزهای کلید API با کلید App Store Connect مطابقت داشته باشند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Tarkista, että Issuer ID, Key ID, yksityinen avain ja API avaimen käyttöoikeudet vastaavat avainta App Store Connect."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Vérifiez que l'Issuer ID, le Key ID, la clé privée et les autorisations de la clé API correspondent à la clé App Store Connect."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ודא שהרשאות המפתח Issuer ID, Key ID, המפתח הפרטי וה-API תואמות למפתח App Store Connect."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Provjerite odgovaraju li dopuštenja ključa Issuer ID, Key ID, privatnog ključa i ključa API ključu App Store Connect."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Ellenőrizze, hogy a Issuer ID, Key ID, privát kulcs és API kulcs engedélyei megegyeznek-e a App Store Connect kulccsal."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Periksa apakah izin kunci Issuer ID, Key ID, kunci pribadi, dan API cocok dengan kunci App Store Connect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Verifica che Issuer ID, Key ID, chiave privata e autorizzazioni della chiave API corrispondano alla chiave di App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Issuer ID、Key ID、秘密キー、API キーの権限が App Store Connect のキーと一致していることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Issuer ID, Key ID, 개인 키, API 키 권한이 App Store Connect 키와 일치하는지 확인하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Semak sama ada kebenaran kunci Issuer ID, Key ID, kunci peribadi dan API sepadan dengan kunci App Store Connect."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Controleer of de sleutelrechten Issuer ID, Key ID, de privésleutel en API overeenkomen met de App Store Connect-sleutel."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Sjekk at Issuer ID, Key ID, privat nøkkel og API nøkkeltillatelser samsvarer med App Store Connect-nøkkelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Sprawdź, czy uprawnienia klucza Issuer ID, Key ID, klucza prywatnego i klucza API odpowiadają kluczowi App Store Connect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Verifique se o Issuer ID, o Key ID, a chave privada e as permissões da chave de API correspondem à chave do App Store Connect."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Verifique se as permissões de Issuer ID, Key ID, chave privada e API correspondem à chave App Store Connect."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Verificați dacă permisiunile Issuer ID, Key ID, cheia privată și API se potrivesc cu cheia App Store Connect."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Убедитесь, что Issuer ID, Key ID, закрытый ключ и права ключа API соответствуют ключу App Store Connect."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Skontrolujte, či sa povolenia kľúča Issuer ID, Key ID, súkromného kľúča a kľúča API zhodujú s kľúčom App Store Connect."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Preverite, ali se dovoljenja za ključ Issuer ID, Key ID, zasebni ključ in API ujemajo s ključem App Store Connect."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Kontrollera att nyckelbehörigheterna Issuer ID, Key ID, privat nyckel och API stämmer överens med nyckeln App Store Connect."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ตรวจสอบว่าสิทธิ์ของคีย์ Issuer ID, Key ID และคีย์ส่วนตัว API ตรงกับคีย์ App Store Connect"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Issuer ID, Key ID, özel anahtar ve API anahtarı izinlerinin App Store Connect anahtarıyla eşleştiğini denetleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Перевірте, чи Issuer ID, Key ID, приватний ключ і дозволи ключа API відповідають ключу App Store Connect."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ چیک کریں کہ Issuer ID، Key ID، نجی کلید، اور API کلیدی اجازتیں App Store Connect کلید سے ملتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Kiểm tra xem các quyền của khóa Issuer ID, Key ID, khóa riêng tư và API có khớp với khóa App Store Connect hay không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 请检查 Issuer ID、Key ID、私钥和 API 密钥权限是否与 App Store Connect 中的密钥一致。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 請確認 Issuer ID、Key ID、私密密鑰和 API 密鑰權限與 App Store Connect 密鑰相符。"
          }
        }
      }
    },

        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique numa área vazia da tela dentro de uma linha para selecionar a própria linha e mostrar os controles de linha no inspetor."
          }
        },
        "ru" : {
          "stringUnit" : {

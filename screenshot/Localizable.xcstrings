            "value" : "اسکرین شاٹ کی مطابقت پذیری کو App Store Connect میں کچھ تبدیل کرنے سے پہلے ہی منسوخ کر دیا گیا تھا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng bộ hóa ảnh chụp màn hình đã bị hủy trước khi có bất kỳ thay đổi nào trong App Store Connect."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截图同步在 App Store Connect 发生任何更改之前已取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "螢幕截圖同步已在 App Store Connect 中做出任何更改前取消。"
          }
        }
      }
    },
    "Screenshot sync was cancelled. Changes already made in App Store Connect were not reverted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إلغاء مزامنة لقطة الشاشة. لم يتم التراجع عن التغييرات التي تم إجراؤها بالفعل في App Store Connect."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronització de captures de pantalla s'ha cancel·lat. Els canvis ja fets a App Store Connect no s'han revertit."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizace snímku obrazovky byla zrušena. Změny již provedené v App Store Connect nebyly vráceny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisering af skærmbillede blev annulleret. Ændringer, der allerede er foretaget i App Store Connect blev ikke tilbageført."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Screenshot-Synchronisierung wurde abgebrochen. Bereits in App Store Connect vorgenommene Änderungen wurden nicht rückgängig gemacht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο συγχρονισμός στιγμιότυπου οθόνης ακυρώθηκε. Οι αλλαγές που έγιναν ήδη στο App Store Connect δεν επανήλθαν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se canceló la sincronización de capturas. Los cambios ya realizados en App Store Connect no se revirtieron."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همگام‌سازی اسکرین‌شات لغو شد. تغییراتی که قبلاً در App Store Connect ایجاد شده بود، برگردانده نشدند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvakaappauksen synkronointi peruutettiin. Jo tehtyjä muutoksia App Store Connect ei peruutettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation des captures d'écran a été annulée. Les modifications déjà apportées dans App Store Connect n'ont pas été annulées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סנכרון צילום מסך בוטל. שינויים שכבר בוצעו ב-App Store Connect לא בוטלו."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkronizacija snimke zaslona je otkazana. Promjene koje su već napravljene u App Store Connect nisu poništene."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A képernyőkép szinkronizálása megszakadt. A(z) App Store Connect-ban már végrehajtott módosítások nem kerültek visszaállításra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkronisasi tangkapan layar dibatalkan. Perubahan yang sudah dilakukan di App Store Connect tidak dikembalikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione degli screenshot è stata annullata. Le modifiche già apportate in App Store Connect non sono state annullate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットの同期がキャンセルされました。App Store Connect ですでに行われた変更は元に戻されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크린샷 동기화가 취소되었습니다. App Store Connect에서 이미 변경한 사항은 되돌려지지 않았습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyegerakan tangkapan skrin telah dibatalkan. Perubahan yang telah dibuat dalam App Store Connect tidak dikembalikan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisatie van screenshot is geannuleerd. Wijzigingen die al in App Store Connect zijn aangebracht, zijn niet teruggedraaid."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisering av skjermbilde ble avbrutt. Endringer som allerede er gjort i App Store Connect ble ikke tilbakestilt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizacja zrzutów ekranu została anulowana. Zmiany wprowadzone już w App Store Connect nie zostały cofnięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização das capturas de tela foi cancelada. As alterações já feitas no App Store Connect não foram revertidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização da captura de ecrã foi cancelada. As alterações já feitas em App Store Connect não foram revertidas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizarea capturii de ecran a fost anulată. Modificările deja făcute în App Store Connect nu au fost anulate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация скриншотов отменена. Изменения, уже внесенные в App Store Connect, не были отменены."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizácia snímky obrazovky bola zrušená. Zmeny, ktoré už boli vykonané v App Store Connect, neboli vrátené."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinhronizacija posnetka zaslona je bila preklicana. Spremembe, ki so bile že narejene v App Store Connect, niso bile razveljavljene."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisering av skärmdump avbröts. Ändringar som redan gjorts i App Store Connect återställdes inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การซิงค์ภาพหน้าจอถูกยกเลิก การเปลี่ยนแปลงที่ทำไปแล้วใน App Store Connect จะไม่ถูกเปลี่ยนกลับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran görüntüsü eşzamanlaması iptal edildi. App Store Connect'te zaten yapılmış değişiklikler geri alınmadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронізацію знімків екрана скасовано. Зміни, уже внесені в App Store Connect, не скасовано."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسکرین شاٹ کی مطابقت پذیری منسوخ کر دی گئی۔ App Store Connect میں پہلے سے کی گئی تبدیلیاں واپس نہیں کی گئیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng bộ hóa ảnh chụp màn hình đã bị hủy. Những thay đổi đã được thực hiện trong App Store Connect không được hoàn nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截图同步已取消。App Store Connect 中已进行的更改未还原。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "螢幕截圖同步已取消。已在 App Store Connect 中做出的更改未被還原。"
          }
        }
      }

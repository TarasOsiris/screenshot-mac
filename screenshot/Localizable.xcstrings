        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren kjører på `127.0.0.1` (bare loopback) - den er ikke tilgjengelig fra andre datamaskiner eller internett."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor é executado em `127.0.0.1` (somente loopback) — não é acessível de outros computadores ou da Internet."

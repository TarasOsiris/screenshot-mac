    "%@ has another row of this screenshot size. A variant takes one row per size, so move or delete one before uploading." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي %1$@ على صف آخر بحجم لقطة الشاشة هذا. يأخذ المتغير صفًا واحدًا لكل حجم، لذا انقله أو احذفه قبل التحميل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ এই স্ক্রিনশট আকারের আরেকটি সারি আছে। একটি বৈকল্পিক আকার প্রতি একটি সারি লাগে, তাই আপলোড করার আগে একটি সরান বা মুছুন৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ té una altra fila d'aquesta mida de captura de pantalla. Una variant ocupa una fila per mida, així que mou o suprimeix-ne una abans de penjar-la."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ má další řádek této velikosti snímku obrazovky. Varianta má jeden řádek na velikost, takže před nahráním jeden přesuňte nebo smažte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ har en anden række af denne skærmbilledestørrelse. En variant tager en række pr. størrelse, så flyt eller slet en før upload."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat eine weitere Zeile mit dieser Screenshot-Größe. Eine Variante nimmt eine Zeile pro Größe, verschiebe oder lösche daher eine vor dem Hochladen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %1$@ έχει μια άλλη σειρά αυτού του μεγέθους στιγμιότυπου οθόνης. Μια παραλλαγή χρειάζεται μία σειρά ανά μέγεθος, επομένως μετακινήστε ή διαγράψτε μία πριν τη μεταφόρτωση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tiene otra fila con este tamaño de captura. Una variante admite una fila por tamaño, así que mueve o elimina una antes de subir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ردیف دیگری با این اندازه اسکرین‌شات دارد. هر نسخه برای هر اندازه یک ردیف می‌پذیرد، پس پیش از آپلود یکی را منتقل یا حذف کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sisältää toisen tämän kokoisen kuvakaappauksen rivin. Muunnelma vie yhden rivin kokoa kohden, joten siirrä tai poista yksi rivi ennen lataamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a une autre ligne de cette taille de capture. Une variante prend une ligne par taille : déplacez-en ou supprimez-en une avant l'envoi."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ પાસે આ સ્ક્રીનશૉટ કદની બીજી પંક્તિ છે. વેરિઅન્ટ કદ દીઠ એક પંક્તિ લે છે, તેથી અપલોડ કરતા પહેલા એકને ખસેડો અથવા કાઢી નાખો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ל-%1$@ יש שורה נוספת בגודל צילום מסך זה. וריאנט לוקח שורה אחת בכל גודל, אז העבר או מחק אחת לפני ההעלאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ में इस स्क्रीनशॉट आकार की एक और पंक्ति है। एक संस्करण प्रति आकार एक पंक्ति लेता है, इसलिए अपलोड करने से पहले एक को स्थानांतरित करें या हटा दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ima još jedan redak ove veličine snimke zaslona. Varijanta zauzima jedan redak po veličini, stoga premjestite ili izbrišite jedan prije učitavanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az %1$@ egy másik sorral rendelkezik ekkora képernyőképmérettel. Egy változat méretenként egy sort foglal, ezért feltöltés előtt helyezzen át vagy töröljön egyet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ memiliki baris lain dengan ukuran tangkapan layar ini. Varian membutuhkan satu baris per ukuran, jadi pindahkan atau hapus satu baris sebelum mengupload."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha un'altra riga con questa dimensione di screenshot. Una variante accetta una riga per dimensione, quindi spostane o eliminane una prima del caricamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ には同じスクリーンショットサイズの行がもう 1 つあります。バリアントはサイズごとに 1 行のみなので、アップロード前にどちらかを移動または削除してください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ಈ ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ಗಾತ್ರದ ಮತ್ತೊಂದು ಸಾಲನ್ನು ಹೊಂದಿದೆ. ಒಂದು ರೂಪಾಂತರವು ಪ್ರತಿ ಗಾತ್ರಕ್ಕೆ ಒಂದು ಸಾಲನ್ನು ತೆಗೆದುಕೊಳ್ಳುತ್ತದೆ, ಆದ್ದರಿಂದ ಅಪ್‌ಲೋಡ್ ಮಾಡುವ ಮೊದಲು ಒಂದನ್ನು ಸರಿಸಿ ಅಥವಾ ಅಳಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 같은 스크린샷 크기의 행이 하나 더 있습니다. 변형은 크기마다 한 행만 받으므로 업로드 전에 하나를 옮기거나 삭제하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ എന്നതിന് ഈ സ്‌ക്രീൻഷോട്ട് വലുപ്പത്തിൻ്റെ മറ്റൊരു നിരയുണ്ട്. ഒരു വകഭേദം ഓരോ വലുപ്പത്തിലും ഒരു വരി എടുക്കുന്നു, അതിനാൽ അപ്‌ലോഡ് ചെയ്യുന്നതിന് മുമ്പ് ഒരെണ്ണം നീക്കുക അല്ലെങ്കിൽ ഇല്ലാതാക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ मध्ये या स्क्रीनशॉट आकाराची दुसरी पंक्ती आहे. व्हेरिएंट प्रति आकार एक पंक्ती घेते, म्हणून अपलोड करण्यापूर्वी एक हलवा किंवा हटवा."

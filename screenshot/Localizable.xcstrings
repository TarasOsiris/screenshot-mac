    "Format, size, layout and background are remembered from your last showcase export, including a picked background image." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تذكر التنسيق والحجم والتخطيط والخلفية من آخر تصدير لواجهة العرض، بما في ذلك صورة الخلفية المختارة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বাছাই করা ব্যাকগ্রাউন্ড ইমেজ সহ আপনার শেষ শোকেস এক্সপোর্ট থেকে ফর্ম্যাট, আকার, লেআউট এবং ব্যাকগ্রাউন্ড মনে রাখা হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El format, la mida, la disposició i el fons es recorden de la darrera exportació d'aparador, inclosa una imatge de fons escollida."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formát, velikost, rozvržení a pozadí jsou zapamatovány z vašeho posledního exportu prezentace, včetně vybraného obrázku na pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format, størrelse, layout og baggrund huskes fra din sidste showcase-eksport, inklusive et valgt baggrundsbillede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format, Größe, Layout und Hintergrund werden von deinem letzten Showcase-Export übernommen – auch ein gewähltes Hintergrundbild."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μορφή, το μέγεθος, η διάταξη και το φόντο απομνημονεύονται από την τελευταία εξαγωγή της βιτρίνας σας, συμπεριλαμβανομένης μιας επιλεγμένης εικόνας φόντου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El formato, el tamaño, el diseño y el fondo se recuerdan de tu última exportación de escaparate, incluida una imagen de fondo elegida."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قالب، اندازه، چیدمان و پس‌زمینه از آخرین خروجی ویترین شما به خاطر سپرده می‌شوند، از جمله تصویر پس‌زمینه‌ای که انتخاب کرده‌اید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muoto, koko, asettelu ja tausta muistetaan viimeisestä näyteikkunan viennistä, mukaan lukien poimittu taustakuva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le format, la taille, la mise en page et l’arrière-plan de votre dernier export vitrine sont mémorisés, y compris une image d’arrière-plan choisie."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ફોર્મેટ, કદ, લેઆઉટ અને પૃષ્ઠભૂમિ તમારા છેલ્લા શોકેસ નિકાસમાંથી યાદ રાખવામાં આવે છે, જેમાં પસંદ કરેલ પૃષ્ઠભૂમિ છબીનો સમાવેશ થાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",

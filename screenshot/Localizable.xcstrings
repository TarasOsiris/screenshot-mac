    "Play keeps one screenshot set per language — turn all but one of them off." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play manté una captura de pantalla establerta per idioma; desactiveu-les totes menys una."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play beholder ét skærmbillede pr. sprog – slå alle undtagen ét af dem fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play speichert ein Screenshot-Set pro Sprache – schalte alle bis auf eine aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play guarda un único conjunto de capturas por idioma: desactívalos todos menos uno."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play برای هر زبان فقط یک مجموعه اسکرین‌شات نگه می‌دارد — همه را به‌جز یکی خاموش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play säilyttää yhden kuvakaappauksen kielelle asetettuna – poista kaikki paitsi yksi niistä käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play conserve un seul ensemble de captures d'écran par langue : désactivez-les toutes sauf une."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play conserva un set di screenshot per lingua: disattivale tutte tranne una."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play で保持できるスクリーンショットセットは言語ごとに1つだけです。1つを残してほかはオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play는 언어당 스크린샷 세트를 하나만 유지합니다. 하나만 남기고 나머지는 끄세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij Play wordt één screenshot per taal bewaard. Schakel ze allemaal uit, op één na."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play beholder ett skjermbildesett per språk – slå av alle unntatt ett."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Play mantém um conjunto de capturas de tela por idioma — desative todos menos um."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Play mantém uma captura de ecrã definida por idioma – desative todas elas, exceto uma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play хранит один набор скриншотов на язык — отключите все, кроме одного."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play behåller en skärmdump per språk – stäng av alla utom en."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play her dil için bir ekran görüntüsü seti tutar — biri dışında hepsini kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play зберігає один набір знімків екрана на мову — вимкніть усі, крім однієї."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play 每种语言只保留一组截图——请只保留其中一种，关闭其余语言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play 每種語言只保留一組螢幕截圖——請只保留其中一種，關閉其餘語言。"
          }
        }
      }
    },
    "Play publishes one listing per language it supports; every other language uploads normally." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play publica una fitxa per idioma que admet; tots els altres idiomes es pengen normalment."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play udgiver én liste pr. sprog, det understøtter; hvert andet sprog uploades normalt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play veröffentlicht einen Eintrag pro unterstützter Sprache; alle anderen Sprachen werden normal hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play publica una ficha por cada idioma que admite; el resto de idiomas se suben con normalidad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play برای هر زبانی که پشتیبانی می‌کند یک صفحهٔ فروشگاه منتشر می‌کند؛ سایر زبان‌ها به‌طور عادی آپلود می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play julkaisee yhden listauksen jokaista tukeaan kieltä kohden. kaikki muut kielet ladataan normaalisti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play publie une fiche par langue prise en charge ; toutes les autres langues sont envoyées normalement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play pubblica una scheda per ogni lingua supportata; tutte le altre lingue vengono caricate normalmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play では対応している言語ごとに1つの掲載情報が公開されます。それ以外の言語は通常どおりアップロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play는 지원하는 언어마다 등록정보를 하나씩 게시합니다. 나머지 언어는 정상적으로 업로드됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play publiceert één vermelding per taal die het ondersteunt; elke andere taal wordt normaal geüpload."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play publiserer én oppføring per språk den støtter; alle andre språk laster opp normalt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Play publica uma ficha da loja por idioma compatível; todos os outros idiomas são enviados normalmente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Play publica uma listagem por idioma compatível; todos os outros idiomas são carregados normalmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play публикует одну страницу для каждого поддерживаемого языка; остальные языки загружаются как обычно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play publicerar en lista per språk som det stöder; alla andra språk laddas upp normalt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play desteklediği her dil için bir mağaza sayfası yayımlar; diğer tüm diller normal şekilde yüklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play публікує одну сторінку для кожної підтримуваної мови; решта мов вивантажується як зазвичай."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play 会为其支持的每种语言发布一份商品详情；其他语言都会正常上传。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play 會為其支援的每種語言各發佈一份商店資訊；其他語言都會正常上傳。"
          }
        }
      }
    },

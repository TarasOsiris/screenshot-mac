    "Imported fonts are bundled with the project so they survive iCloud sync and project transfer." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els tipus de lletra importats s'agrupen amb el projecte de manera que sobreviuen a la sincronització iCloud i a la transferència del projecte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importerede skrifttyper er bundtet med projektet, så de overlever iCloud synkronisering og projektoverførsel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importierte Schriften werden im Projekt mitgespeichert und bleiben so bei iCloud-Synchronisierung und Projektweitergabe erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fuentes importadas se guardan con el proyecto, así que se conservan al sincronizar con iCloud y al transferir el proyecto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فونت‌های واردشده درون پروژه نگه داشته می‌شوند تا در همگام‌سازی iCloud و انتقال پروژه از دست نروند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuodut kirjasimet on niputettu projektiin, jotta ne kestävät iCloud synkronoinnin ja projektin siirron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les polices importées sont intégrées au projet, si bien qu'elles sont conservées lors de la synchronisation iCloud et du transfert du projet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I font importati vengono inclusi nel progetto, così sopravvivono alla sincronizzazione iCloud e al trasferimento del progetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込んだフォントはプロジェクトに同梱されるため、iCloud 同期やプロジェクトの移動後もそのまま使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져온 서체는 프로젝트와 함께 저장되므로 iCloud 동기화나 프로젝트 전송 후에도 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geïmporteerde lettertypen worden bij het project geleverd, zodat ze de synchronisatie en projectoverdracht van iCloud overleven."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importerte skrifter er samlet med prosjektet slik at de overlever iCloud synkronisering og prosjektoverføring."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fontes importadas são incluídas no projeto para que sobrevivam à sincronização do iCloud e à transferência do projeto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fontes importadas são incluídas no projeto para que sobrevivam à sincronização iCloud e à transferência do projeto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импортированные шрифты хранятся вместе с проектом, поэтому сохраняются при синхронизации iCloud и переносе проекта."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importerade teckensnitt buntas med projektet så att de överlever iCloud synkronisering och projektöverföring."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçe aktarılan fontlar projeyle birlikte paketlenir; böylece iCloud eşzamanlamasında ve proje aktarımında korunurlar."
          }
        },
        "uk" : {

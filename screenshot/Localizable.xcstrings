    "1 screenshot must be removed first to stay within Apple's 10-screenshot limit." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب إزالة لقطة شاشة واحدة أولاً للبقاء ضمن الحد الأقصى لعدد لقطات الشاشة الذي حددته شركة Apple وهو 10 لقطات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-এর 10-স্ক্রিনশট সীমার মধ্যে থাকার জন্য প্রথমে 1টি স্ক্রিনশট সরাতে হবে৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primer s'ha d'eliminar 1 captura de pantalla per mantenir-se dins del límit de 10 captures de pantalla d'Apple."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby Apple nepřekročil limit 10 snímků obrazovky, musí být nejprve odstraněn 1 snímek obrazovky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 skærmbillede skal fjernes først for at holde sig inden for Apples grænse på 10 skærmbilleder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 Screenshot muss zuerst entfernt werden, um Apples Limit von 10 Screenshots einzuhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρέπει πρώτα να αφαιρεθεί 1 στιγμιότυπο οθόνης για να παραμείνει εντός του ορίου των 10 στιγμιότυπων οθόνης της Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero se debe eliminar 1 captura para respetar el límite de 10 capturas de Apple."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای رعایت محدودیت ۱۰ اسکرین‌شات اپل، ابتدا باید ۱ اسکرین‌شات حذف شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 kuvakaappaus on ensin poistettava, jotta se pysyy Applen 10 kuvakaappausrajan sisällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 capture doit d’abord être supprimée pour respecter la limite de 10 captures d’Apple."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleની 10-સ્ક્રીનશોટ મર્યાદામાં રહેવા માટે પહેલા 1 સ્ક્રીનશૉટ દૂર કરવો આવશ્યક છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להסיר תחילה צילום מסך אחד כדי להישאר במגבלה של 10 צילומי מסך של אפל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple की 10-स्क्रीनशॉट सीमा के भीतर रहने के लिए पहले 1 स्क्रीनशॉट को हटाना होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najprije se mora ukloniti 1 snimka zaslona kako biste ostali unutar Appleovog ograničenja od 10 snimki zaslona."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Először 1 képernyőképet kell eltávolítani, hogy az Apple 10 képernyőképes korlátján belül maradjon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 tangkapan layar harus dihapus terlebih dahulu agar tetap berada dalam batas 10 tangkapan layar Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Occorre prima rimuovere 1 screenshot per rispettare il limite di 10 screenshot di Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple の10枚制限内に収めるには、先に1枚のスクリーンショットを削除する必要があります。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ನ 10-ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ಮಿತಿಯಲ್ಲಿ ಉಳಿಯಲು 1 ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ಅನ್ನು ಮೊದಲು ತೆಗೆದುಹಾಕಬೇಕು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple의 스크린샷 10개 제한을 지키려면 먼저 스크린샷 1개를 제거해야 합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ആപ്പിളിൻ്റെ 10-സ്ക്രീൻഷോട്ട് പരിധിക്കുള്ളിൽ തുടരാൻ ആദ്യം 1 സ്ക്രീൻഷോട്ട് നീക്കം ചെയ്യണം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple च्या 10-स्क्रीनशॉट मर्यादेत राहण्यासाठी प्रथम 1 स्क्रीनशॉट काढला जाणे आवश्यक आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 tangkapan skrin mesti dialih keluar terlebih dahulu untuk kekal dalam had 10 tangkapan skrin Apple."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er moet eerst 1 screenshot worden verwijderd om binnen de limiet van 10 screenshots van Apple te blijven."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 skjermbilde må fjernes først for å holde seg innenfor Apples grense på 10 skjermbilder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby zmieścić się w limicie 10 zrzutów ekranu Apple, należy najpierw usunąć 1 zrzut ekranu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 captura precisa ser removida primeiro para ficar dentro do limite de 10 capturas da Apple."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 captura de ecrã deve ser removida primeiro para permanecer dentro do limite de 10 capturas de ecrã da Apple."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 captură de ecran trebuie eliminată mai întâi pentru a rămâne în limita Apple de 10 capturi de ecran."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала нужно удалить 1 скриншот, чтобы уложиться в лимит Apple в 10 скриншотов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najprv musíte odstrániť 1 snímku obrazovky, aby ste neprekročili limit 10 snímok obrazovky spoločnosti Apple."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najprej je treba odstraniti 1 posnetek zaslona, da ostanete znotraj Appleove omejitve 10 posnetkov zaslona."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 skärmdump måste tas bort först för att hålla sig inom Apples gräns på 10 skärmdumpar."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple இன் 10-ஸ்கிரீன்ஷாட் வரம்பிற்குள் இருக்க, முதலில் 1 ஸ்கிரீன்ஷாட் அகற்றப்பட வேண்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple యొక్క 10-స్క్రీన్‌షాట్ పరిమితిలో ఉండడానికి ముందుగా 1 స్క్రీన్‌షాట్ తీసివేయబడాలి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องลบภาพหน้าจอ 1 ภาพออกก่อนจึงจะอยู่ภายในขีดจำกัด 10 ภาพหน้าจอของ Apple"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple'ın 10 ekran görüntüsü sınırında kalmak için önce 1 ekran görüntüsünün kaldırılması gerekiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб не перевищити ліміт Apple у 10 знімків екрана, спершу потрібно вилучити 1 знімок."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple کی 10 اسکرین شاٹ کی حد کے اندر رہنے کے لیے پہلے 1 اسکرین شاٹ کو ہٹانا ضروری ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trước tiên, phải xóa 1 ảnh chụp màn hình để duy trì giới hạn 10 ảnh chụp màn hình của Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必须先移除 1 张截图，才能符合 Apple 的 10 张截图上限。"

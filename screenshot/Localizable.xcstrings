    "This sidebar always edits the currently selected row — set its screenshot size, background, and device frame, and add text, images, and shapes from the Shapes section." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم هذا الشريط الجانبي دائمًا بتحرير الصف المحدد حاليًا - قم بتعيين حجم لقطة الشاشة والخلفية وإطار الجهاز، وإضافة نص وصور وأشكال من قسم الأشكال."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta barra lateral sempre edita la fila seleccionada actualment: defineix la mida de la captura de pantalla, el fons i el marc del dispositiu, i afegeix text, imatges i formes des de la secció Formes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento postranní panel vždy upravuje aktuálně vybraný řádek – nastavte jeho velikost snímku obrazovky, pozadí a rámeček zařízení a přidejte text, obrázky a tvary ze sekce Tvary."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne sidebjælke redigerer altid den aktuelt valgte række - indstil dens skærmbilledestørrelse, baggrund og enhedsramme, og tilføj tekst, billeder og figurer fra sektionen Former."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Seitenleiste bearbeitet immer die ausgewählte Zeile – lege ihre Screenshot-Größe, den Hintergrund und den Geräterahmen fest und füge Text, Bilder und Formen aus dem Abschnitt „Formen“ hinzu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η πλαϊνή γραμμή επεξεργάζεται πάντα την τρέχουσα επιλεγμένη σειρά — ορίστε το μέγεθος στιγμιότυπου οθόνης, το φόντο και το πλαίσιο συσκευής και προσθέστε κείμενο, εικόνες και σχήματα από την ενότητα Σχήματα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta barra lateral siempre edita la fila seleccionada: define el tamaño de captura, el fondo y el marco del dispositivo, y añade texto, imágenes y formas desde la sección Formas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این نوار کناری همیشه ردیف انتخاب‌شدهٔ فعلی را ویرایش می‌کند — اندازهٔ اسکرین‌شات، پس‌زمینه و قاب دستگاه آن را تنظیم کنید و از بخش «شکل‌ها» متن، تصویر و شکل اضافه کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä sivupalkki muokkaa aina valittua riviä – määritä sen kuvakaappauksen koko, tausta ja laitekehys ja lisää tekstiä, kuvia ja muotoja Muodot-osiosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette barre latérale modifie toujours la ligne sélectionnée : définissez sa taille de capture d'écran, son arrière-plan et son cadre d'appareil, et ajoutez du texte, des images et des formes depuis la section Formes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סרגל צד זה עורך תמיד את השורה שנבחרה כעת - הגדר את גודל צילום המסך, הרקע ומסגרת המכשיר שלה, והוסף טקסט, תמונות וצורות ממקטע הצורות."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova bočna traka uvijek uređuje trenutno odabrani redak — postavite njegovu veličinu snimke zaslona, pozadinu i okvir uređaja te dodajte tekst, slike i oblike iz odjeljka Oblici."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az oldalsáv mindig az aktuálisan kijelölt sort szerkeszti – állítsa be a képernyőkép méretét, a hátterét és az eszközkeretet, és adjon hozzá szöveget, képeket és alakzatokat az Alakzatok szakaszból."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidebar ini selalu mengedit baris yang dipilih — mengatur ukuran tangkapan layar, latar belakang, dan bingkai perangkat, serta menambahkan teks, gambar, dan bentuk dari bagian Bentuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa barra laterale modifica sempre la riga selezionata: impostane la dimensione degli screenshot, lo sfondo e la cornice del dispositivo, e aggiungi testo, immagini e forme dalla sezione Forme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサイドバーでは常に選択中の行を編集します。スクリーンショットのサイズ、背景、デバイスフレームを設定し、「図形」セクションからテキスト、画像、図形を追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사이드바는 항상 현재 선택된 행을 편집합니다. 스크린샷 크기, 배경, 기기 프레임을 설정하고 도형 섹션에서 텍스트, 이미지, 도형을 추가하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bar sisi ini sentiasa mengedit baris yang sedang dipilih — tetapkan saiz tangkapan skrin, latar belakang dan bingkai peranti serta tambah teks, imej dan bentuk daripada bahagian Bentuk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze zijbalk bewerkt altijd de momenteel geselecteerde rij: stel de schermgrootte, achtergrond en apparaatframe in en voeg tekst, afbeeldingen en vormen toe vanuit de sectie Vormen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne sidelinjen redigerer alltid den valgte raden – angi skjermbildestørrelse, bakgrunn og enhetsramme, og legg til tekst, bilder og former fra Shapes-delen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten pasek boczny zawsze edytuje aktualnie wybrany wiersz — ustaw rozmiar zrzutu ekranu, tło i ramkę urządzenia, a także dodaj tekst, obrazy i kształty z sekcji Kształty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta barra lateral sempre edita a linha selecionada — defina o tamanho da captura de tela, o plano de fundo e a moldura do dispositivo, e adicione texto, imagens e formas na seção Formas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta barra lateral sempre edita a linha atualmente selecionada – defina o tamanho da captura de ecrã, o plano de fundo e o quadro do dispositivo e adicione texto, imagens e formas da secção Formas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această bară laterală editează întotdeauna rândul selectat curent - setați dimensiunea capturii de ecran, fundalul și cadrul dispozitivului și adăugați text, imagini și forme din secțiunea Forme."

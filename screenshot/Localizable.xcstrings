            "value" : "ఇక్కడి నుండి వచనం, చిత్రాలు, పరికరాలు మరియు ఆకారాలను జోడించండి. అవి ఎంచుకున్న అడ్డు వరుసలో కనిపిస్తాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มข้อความ รูปภาพ อุปกรณ์ และรูปร่างได้จากที่นี่ จะปรากฏบนแถวที่เลือก"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہاں سے متن، تصاویر، آلات اور شکلیں شامل کریں۔ وہ منتخب قطار پر ظاہر ہوں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm văn bản, hình ảnh, thiết bị và hình dạng từ đây. Chúng sẽ xuất hiện trên hàng đã chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从此处添加文本、图像、设备和形状。它们将出现在选定的行上。"
          }
        }
      }

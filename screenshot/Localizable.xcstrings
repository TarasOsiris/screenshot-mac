        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಡೆಮೊ ಮೋಡ್ ಸಕ್ರಿಯವಾಗಿದೆ. ನೀವು ಡೆಮೊ ಮೋಡ್ ಅನ್ನು ಆಫ್ ಮಾಡುವವರೆಗೆ ಮೇಲಿನ ನೈಜ API ಪ್ರಮುಖ ಕ್ಷೇತ್ರಗಳನ್ನು ನಿರ್ಲಕ್ಷಿಸಲಾಗುತ್ತದೆ."

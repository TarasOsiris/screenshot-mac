        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Copiar ruta del archivo del proyecto** copia la ruta de su `project.json`, algo útil en un informe de errores."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**کپی مسیر فایل پروژه** مسیر `project.json` آن را کپی می‌کند — برای گزارش اشکال مفید است."
          }
        },
        "fr" : {
          "stringUnit" : {

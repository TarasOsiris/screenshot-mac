    "%@ Check that the Issuer ID, Key ID, private key, and API key permissions match the App Store Connect key." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Comproveu que els permisos de la clau Issuer ID, Key ID, la clau privada i la clau API coincideixen amb la clau App Store Connect."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Kontroller, at nøgletilladelserne Issuer ID, Key ID, den private nøgle og API stemmer overens med nøglen App Store Connect."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Prüfe, ob Issuer ID, Key ID, privater Schlüssel und die Berechtigungen des API-Schlüssels zum App Store Connect-Schlüssel passen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Comprueba que el Issuer ID, el Key ID, la clave privada y los permisos de la clave de API coinciden con la clave de App Store Connect."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ بررسی کنید که Issuer ID، Key ID، کلید خصوصی و مجوزهای کلید API با کلید App Store Connect مطابقت داشته باشند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Tarkista, että Issuer ID, Key ID, yksityinen avain ja API avaimen käyttöoikeudet vastaavat avainta App Store Connect."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Vérifiez que l'Issuer ID, le Key ID, la clé privée et les autorisations de la clé API correspondent à la clé App Store Connect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Verifica che Issuer ID, Key ID, chiave privata e autorizzazioni della chiave API corrispondano alla chiave di App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Issuer ID、Key ID、秘密キー、API キーの権限が App Store Connect のキーと一致していることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Issuer ID, Key ID, 개인 키, API 키 권한이 App Store Connect 키와 일치하는지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Controleer of de sleutelrechten Issuer ID, Key ID, de privésleutel en API overeenkomen met de App Store Connect-sleutel."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Sjekk at Issuer ID, Key ID, privat nøkkel og API nøkkeltillatelser samsvarer med App Store Connect-nøkkelen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Verifique se o Issuer ID, o Key ID, a chave privada e as permissões da chave de API correspondem à chave do App Store Connect."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Verifique se as permissões de Issuer ID, Key ID, chave privada e API correspondem à chave App Store Connect."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Убедитесь, что Issuer ID, Key ID, закрытый ключ и права ключа API соответствуют ключу App Store Connect."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Kontrollera att nyckelbehörigheterna Issuer ID, Key ID, privat nyckel och API stämmer överens med nyckeln App Store Connect."
          }
        },
        "tr" : {
          "stringUnit" : {

        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പരിധിയില്ലാതെ പോയി നിങ്ങളുടെ ആപ്പുകൾക്ക് ആവശ്യമുള്ളത്ര സ്‌ക്രീൻഷോട്ടുകൾ സൃഷ്‌ടിക്കുക."

    "Quit and reopen Screenshot Bro to switch the interface language." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende Screenshot Bro und öffne die App erneut, um die Sprache der Benutzeroberfläche zu wechseln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sal de Screenshot Bro y vuelve a abrirlo para cambiar el idioma de la interfaz."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای تغییر زبان رابط، Screenshot Bro را ببندید و دوباره باز کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quittez et rouvrez Screenshot Bro pour changer la langue de l'interface."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudi e riapri Screenshot Bro per cambiare la lingua dell'interfaccia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターフェイスの言語を切り替えるには、Screenshot Bro を終了してもう一度開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터페이스 언어를 변경하려면 Screenshot Bro를 종료했다가 다시 여세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saia e reabra Screenshot Bro para mudar o idioma da interface."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закройте и снова откройте Screenshot Bro, чтобы сменить язык интерфейса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arayüz dilini değiştirmek için Screenshot Bro'dan çıkıp yeniden açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрийте й знову відкрийте Screenshot Bro, щоб змінити мову інтерфейсу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出并重新打开 Screenshot Bro 以切换界面语言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結束並重新開啟 Screenshot Bro 以切換介面語言。"
          }
        }
      }
    },

        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thứ tự Z, sao chép và xóa tác động lên toàn bộ vùng chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "层级顺序、复制和删除操作会作用于整个所选内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

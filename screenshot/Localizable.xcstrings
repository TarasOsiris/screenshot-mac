        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora invialo per la revisione. Apple revisiona un esperimento prima che possa iniziare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次に、審査に提出します。実験は開始前に Apple の審査を受けます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮುಂದೆ, ಅದನ್ನು ಪರಿಶೀಲನೆಗಾಗಿ ಸಲ್ಲಿಸಿ. ಆಪಲ್ ಪ್ರಯೋಗವನ್ನು ಪ್ರಾರಂಭಿಸುವ ಮೊದಲು ಅದನ್ನು ಪರಿಶೀಲಿಸುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음으로 심사에 제출하세요. Apple은 실험을 시작하기 전에 심사합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അടുത്തതായി, അവലോകനത്തിനായി സമർപ്പിക്കുക. ആരംഭിക്കുന്നതിന് മുമ്പ് ആപ്പിൾ ഒരു പരീക്ഷണം അവലോകനം ചെയ്യുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुढे, पुनरावलोकनासाठी सबमिट करा. ऍपल प्रयोग सुरू होण्यापूर्वी त्याचे पुनरावलोकन करते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seterusnya, serahkan untuk semakan. Apple menyemak percubaan sebelum ia boleh dimulakan."
          }
        },
        "nl" : {
          "stringUnit" : {

          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Play δημοσιεύει μία καταχώριση ανά γλώσσα που υποστηρίζει. κάθε άλλη γλώσσα μεταφορτώνεται κανονικά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play publica una ficha por cada idioma que admite; el resto de idiomas se suben con normalidad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play برای هر زبانی که پشتیبانی می‌کند یک صفحهٔ فروشگاه منتشر می‌کند؛ سایر زبان‌ها به‌طور عادی آپلود می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play julkaisee yhden listauksen jokaista tukeaan kieltä kohden. kaikki muut kielet ladataan normaalisti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play publie une fiche par langue prise en charge ; toutes les autres langues sont envoyées normalement."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પ્લે તે જે ભાષાને સમર્થન આપે છે તે દીઠ એક સૂચિ પ્રકાશિત કરે છે; દરેક અન્ય ભાષા સામાન્ય રીતે અપલોડ કરે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play מפרסמת רישום אחד לכל שפה שבה היא תומכת; כל שפה אחרת עולה כרגיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्ले अपने द्वारा समर्थित प्रति भाषा एक सूची प्रकाशित करता है; अन्य सभी भाषाएँ सामान्य रूप से अपलोड होती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play objavljuje jedan popis po jeziku koji podržava; svaki drugi jezik prenosi normalno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Play minden általa támogatott nyelven egy listát tesz közzé; minden más nyelv normálisan tölt fel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play menerbitkan satu daftar per bahasa yang didukungnya; setiap bahasa lain diunggah secara normal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play pubblica una scheda per ogni lingua supportata; tutte le altre lingue vengono caricate normalmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play では対応している言語ごとに1つの掲載情報が公開されます。それ以外の言語は通常どおりアップロードされます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play ಇದು ಬೆಂಬಲಿಸುವ ಭಾಷೆಗೆ ಒಂದು ಪಟ್ಟಿಯನ್ನು ಪ್ರಕಟಿಸುತ್ತದೆ; ಪ್ರತಿಯೊಂದು ಭಾಷೆಯು ಸಾಮಾನ್ಯವಾಗಿ ಅಪ್‌ಲೋಡ್ ಮಾಡುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play는 지원하는 언어마다 등록정보를 하나씩 게시합니다. 나머지 언어는 정상적으로 업로드됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പ്ലേ പിന്തുണയ്ക്കുന്ന ഓരോ ഭാഷയിലും ഒരു ലിസ്‌റ്റിംഗ് പ്രസിദ്ധീകരിക്കുന്നു; മറ്റെല്ലാ ഭാഷകളും സാധാരണയായി അപ്‌ലോഡ് ചെയ്യുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्ले प्रत्येक भाषेला सपोर्ट करत असलेली एक सूची प्रकाशित करते; इतर प्रत्येक भाषा सामान्यपणे अपलोड करते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play menerbitkan satu penyenaraian bagi setiap bahasa yang disokongnya; setiap bahasa lain dimuat naik secara normal."

    "Set **Settings ▸ Export ▸ Export folder** to make **⌘E** export directly without prompting." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبط **الإعدادات ▸ تصدير ▸ مجلد التصدير** لإجراء تصدير **⌘E** مباشرة دون مطالبة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estableix **Configuració ▸ Exporta ▸ Exporta carpeta** per fer que **⌘E** s'exporti directament sense demanar-ho."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavením **Nastavení ▸ Exportovat ▸ Exportovat složku** provedete **⌘E** export přímo bez výzvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstil **Indstillinger ▸ Eksporter ▸ Eksporter mappe** for at få **⌘E** til at eksportere direkte uden at blive spurgt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege unter **Einstellungen ▸ Export ▸ Exportordner** einen Ordner fest, damit **⌘E** direkt und ohne Nachfrage exportiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρυθμίστε **Ρυθμίσεις ▸ Εξαγωγή ▸ Εξαγωγή φακέλου** για να κάνετε την **⌘E** εξαγωγή απευθείας χωρίς προτροπή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define **Ajustes ▸ Exportar ▸ Carpeta de exportación** para que **⌘E** exporte directamente sin preguntar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**تنظیمات ▸ صدور ▸ پوشهٔ خروجی** را تنظیم کنید تا **⌘E** بدون پرسش مستقیماً صادر کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta **Asetukset ▸ Vie ▸ Vie kansio**, jotta **⌘E** viedään suoraan ilman kehotusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez **Réglages ▸ Exporter ▸ Dossier d'exportation** pour que **⌘E** exporte directement, sans rien demander."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדר את **הגדרות ▸ ייצוא ▸ תיקיית ייצוא** כדי לבצע **⌘E** ייצוא ישירות ללא הנחיה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavite **Postavke ▸ Izvoz ▸ Izvoz mape** kako biste **⌘E** izvozili izravno bez upita."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Állítsa be a **Beállítások ▸ Exportálás ▸ Exportálási mappa** elemet, hogy a **⌘E** közvetlenül, rákérdezés nélkül exportáljon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur **Pengaturan ▸ Ekspor ▸ Ekspor folder** untuk membuat **⌘E** mengekspor secara langsung tanpa disuruh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta **Impostazioni ▸ Esporta ▸ Cartella di esportazione** perché **⌘E** esporti direttamente senza chiedere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**設定 ▸ 書き出し ▸ 書き出し先フォルダ** を設定すると、**⌘E** で確認なしに直接書き出せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**설정 ▸ 내보내기 ▸ 내보내기 폴더**를 지정하면 **⌘E**가 묻지 않고 바로 내보냅니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetapkan **Tetapan ▸ Eksport ▸ Eksport folder** untuk membuat **⌘E** eksport terus tanpa menggesa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel **Instellingen ▸ Exporteren ▸ Map exporteren** in om **⌘E** direct te exporteren zonder dat u hierom wordt gevraagd."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angi **Innstillinger ▸ Eksporter ▸ Eksporter mappe** for å få **⌘E** til å eksportere direkte uten å spørre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw **Ustawienia ▸ Eksportuj ▸ Eksportuj folder**, aby **⌘E** eksportować bezpośrednio, bez monitowania."

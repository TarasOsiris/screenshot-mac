    "iCloud Sync" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Synchronisierung"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronización con iCloud"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud همگام سازی"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Synchronisation"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同期"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 동기화"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Sincronizar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步"
          }
        }
      }
    },
    "iCloud sync keeps your project library in iCloud Drive (`iCloud.xyz.tleskiv.screenshot`). Changes made on one Mac propagate to others signed into the same iCloud account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die iCloud-Synchronisierung behält Ihre Projektbibliothek im iCloud-Laufwerk („iCloud.xyz.tleskiv.screenshot“). Änderungen, die an einem Mac vorgenommen werden, werden an andere weitergegeben, die im selben iCloud-Konto angemeldet sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización de iCloud mantiene la biblioteca de tu proyecto en iCloud Drive (`iCloud.xyz.tleskiv.screenshot`). Los cambios realizados en un Mac se propagan a otras personas que hayan iniciado sesión en la misma cuenta iCloud."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همگام‌سازی iCloud کتابخانه پروژه شما را در iCloud Drive نگه می‌دارد (`iCloud.xyz.tleskiv.screenshot`). تغییرات ایجاد شده در یک Mac به دیگرانی که در همان حساب iCloud وارد شده اند منتشر می شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation iCloud conserve votre bibliothèque de projet dans le lecteur iCloud (`iCloud.xyz.tleskiv.screenshot`). Les modifications apportées sur un Mac se propagent aux autres comptes connectés au même compte iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同期により、プロジェクト ライブラリが iCloud ドライブ (`iCloud.xyz.tleskiv.screenshot`) に保存されます。 1 つの Mac で行われた変更は、同じ iCloud アカウントにサインインしている他のアカウントにも反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud sync는 프로젝트 라이브러리를 iCloud 드라이브(`iCloud.xyz.tleskiv.screenshot`)에 유지합니다. 하나의 Mac에 대한 변경 사항은 동일한 iCloud 계정에 로그인한 다른 사용자에게도 전파됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização iCloud mantém sua biblioteca de projetos no iCloud Drive (`iCloud.xyz.tleskiv.screenshot`). As alterações feitas em um Mac são propagadas para outras pessoas conectadas à mesma conta iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步将您的项目库保留在 iCloud 驱动器中 (`iCloud.xyz.tleskiv.screenshot`)。对一个 Mac 所做的更改会传播到登录到同一 iCloud 帐户的其他人。"
          }
        }
      }
    },

    "%@ uses fonts whose files have not downloaded yet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم %1$@ الخطوط التي لم يتم تنزيل ملفاتها بعد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ utilitza tipus de lletra els fitxers dels quals encara no s'han baixat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ používá písma, jejichž soubory ještě nebyly staženy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bruger skrifttyper, hvis filer ikke er downloadet endnu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ verwendet Schriftarten, deren Dateien noch nicht heruntergeladen wurden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %1$@ χρησιμοποιεί γραμματοσειρές των οποίων τα αρχεία δεν έχουν γίνει ακόμη λήψη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ utiliza fuentes cuyos archivos aún no se han descargado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ از فونت‌هایی استفاده می‌کند که فایل‌های آن‌ها هنوز دانلود نشده‌اند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ käyttää kirjasimia, joiden tiedostoja ei ole vielä ladattu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ utilise des polices dont les fichiers n'ont pas encore été téléchargés."
          }

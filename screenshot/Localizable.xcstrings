    "Its %@ are deleted too. You can undo this." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els seus %1$@ també s'han suprimit. Podeu desfer això."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dens %1$@ er også slettet. Du kan fortryde dette."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die %@ dieser Variante werden ebenfalls gelöscht. Du kannst das rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se eliminan sus %@. Puedes deshacerlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ آن هم حذف می‌شوند. می‌توانید این کار را واگرد کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myös sen %1$@ on poistettu. Voit kumota tämän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses %@ sont aussi supprimées. Vous pouvez annuler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno eliminati anche: %@. Puoi annullare questa operazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その %@ も削除されます。取り消すことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@도 함께 삭제됩니다. 실행 취소할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De %1$@ ervan worden ook verwijderd. Je kunt dit ongedaan maken."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dens %1$@ er også slettet. Du kan angre dette."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As %@ dela também são excluídas. Você pode desfazer isso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus %1$@ também foram excluídos. Você pode desfazer isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Также будут удалены: %@. Это действие можно отменить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dess %1$@ raderas också. Du kan ångra detta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ da silinir. Bunu geri alabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рядки цього варіанта теж буде видалено (%@). Цю дію можна відмінити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其 %@ 也会被删除。你可以撤销此操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其%@也會被刪除。你可以還原此動作。"
          }
        }
      }
    },
    "Its rows are all this project has, so they move to the Original. You can undo this." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les seves files són tot el que té aquest projecte, de manera que es mouen a l'original. Podeu desfer això."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dens rækker er alt, hvad dette projekt har, så de flytter til Originalen. Du kan fortryde dette."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeilen dieser Variante sind alle Zeilen des Projekts, daher werden sie ins Original verschoben. Du kannst das rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus filas son todas las del proyecto, así que pasan al Original. Puedes deshacerlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ردیف‌های آن تنها ردیف‌های این پروژه هستند، پس به نسخه اصلی منتقل می‌شوند. می‌توانید این کار را واگرد کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen rivit ovat kaikki tällä projektilla, joten ne siirtyvät alkuperäiseen. Voit kumota tämän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses lignes sont les seules du projet : elles sont déplacées vers l’Original. Vous pouvez annuler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sue righe sono tutte quelle del progetto, quindi vengono spostate nell'Originale. Puoi annullare questa operazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロジェクトの行はこれだけなので、オリジナルに移動されます。取り消すことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로젝트의 행이 이것뿐이므로 원본으로 이동됩니다. 실행 취소할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De rijen zijn alles wat dit project heeft, dus ze gaan naar het origineel. Je kunt dit ongedaan maken."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radene er alt dette prosjektet har, så de flytter til originalen. Du kan angre dette."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As linhas dela são todas as do projeto, então vão para o Original. Você pode desfazer isso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas linhas são tudo o que este projeto possui, então elas passam para o Original. Você pode desfazer isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его строки — единственные в проекте, поэтому они переместятся в оригинал. Это действие можно отменить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dess rader är allt detta projekt har, så de flyttar till originalet. Du kan ångra detta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satırları bu projenin tüm satırları olduğundan Orijinal'e taşınırlar. Bunu geri alabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його рядки — це всі рядки проєкту, тож їх буде переміщено в оригінал. Цю дію можна відмінити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些是该项目仅有的行，因此会移至原始版本。你可以撤销此操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些列是此專案僅有的列，因此會移到「原始版本」。你可以還原此動作。"
          }
        }
      }
    },
    "Its screenshots can't change in this state. Choose New Experiment to test new ones." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les seves captures de pantalla no poden canviar en aquest estat. Trieu Experiment nou per provar-ne de nous."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dens skærmbilleder kan ikke ændres i denne tilstand. Vælg Nyt eksperiment for at teste nye."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Status können die Screenshots nicht geändert werden. Wähle „Neues Experiment“, um neue zu testen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En este estado sus capturas no pueden cambiar. Elige Nuevo experimento para probar otras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در این وضعیت اسکرین‌شات‌های آن قابل تغییر نیستند. برای آزمایش موارد جدید «آزمایش جدید» را انتخاب کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",

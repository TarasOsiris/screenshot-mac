        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ייצוא משתמש בממדי הפיקסלים המדויקים של השורה כך שהגדלים App Store ו-Google Play נשארים נכונים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निर्यात पंक्ति के सटीक पिक्सेल आयामों का उपयोग करते हैं ताकि App Store और Google Play आकार सही रहें।"

    "Models are grouped by category. Each shows available colors as small swatches." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Modelle sind nach Kategorien gruppiert. Jedes zeigt verfügbare Farben als kleine Farbfelder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modelos están agrupados por categoría. Cada uno muestra los colores disponibles como pequeñas muestras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدل ها بر اساس دسته بندی گروه بندی می شوند. هر کدام رنگ های موجود را به عنوان نمونه های کوچک نشان می دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles sont regroupés par catégorie. Chacun affiche les couleurs disponibles sous forme de petits échantillons."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルはカテゴリごとにグループ化されています。それぞれに利用可能な色が小さな見本として表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델은 카테고리별로 그룹화됩니다. 각각은 사용 가능한 색상을 작은 견본으로 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os modelos são agrupados por categoria. Cada um mostra as cores disponíveis como pequenas amostras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型按类别分组。每个都将可用颜色显示为小样本。"
          }
        }
      }
    },
    "Models marked **(3D)** — iPhone 17 and iPhone 17 Pro Max — are rendered from real geometry rather than a flat bezel image." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit **(3D)** gekennzeichnete Modelle – iPhone 17 und iPhone 17 Pro Max – werden aus echter Geometrie und nicht aus einem Bild mit flachem Rahmen gerendert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modelos marcados **(3D)** — iPhone 17 y iPhone 17 Pro Max — se representan a partir de geometría real en lugar de una imagen de bisel plano."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدل‌های علامت‌گذاری‌شده **(3D)** — iPhone 17 و iPhone 17 Pro Max — از هندسه واقعی به‌جای تصویر قاب تخت ارائه شده‌اند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles marqués **(3D)** — iPhone 17 et iPhone 17 Pro Max — sont rendus à partir d'une géométrie réelle plutôt que d'une image à cadre plat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**(3D)** とマークされたモデル — iPhone 17 および iPhone 17 Pro Max — は、フラット ベゼル イメージではなく実際のジオメトリからレンダリングされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**(3D)**로 표시된 모델 - iPhone 17 및 iPhone 17 Pro Max - 플랫 베젤 이미지가 아닌 실제 형상에서 렌더링됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os modelos marcados como **(3D)** — iPhone 17 e iPhone 17 Pro Max — são renderizados a partir de geometria real em vez de uma imagem de moldura plana."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标记为 **(3D)** 的模型 - iPhone 17 和 iPhone 17 Pro Max - 是根据真实几何体而不是平面边框图像渲染的。"
          }
        }
      }
    },

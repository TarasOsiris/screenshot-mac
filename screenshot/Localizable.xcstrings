            "value" : "%@، زبان اصلی، مجموعهٔ %@ ندارد، بنابراین زبان‌هایی که مجموعه ندارند جایگزینی برای استفاده ندارند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, ensisijainen kieli, ei ole asetettu %2$@, joten kielillä ilman sitä ei ole mitään, mihin palata."

        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ни у одной строки вариантов нет размера скриншота, который App Store Connect принимает для этой платформы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiçbir varyant satırında App Store Connect'in bu platform için kabul ettiği bir ekran görüntüsü boyutu yok."

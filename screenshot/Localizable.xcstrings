    "This row is showing its templates as separate App Store-style tiles. Editing is disabled until you exit preview mode." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض هذا الصف القوالب الخاصة به كمربعات منفصلة بنمط App Store. يتم تعطيل التحرير حتى تخرج من وضع المعاينة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta fila mostra les seves plantilles com a fitxes independents d'estil App Store. L'edició està desactivada fins que sortiu del mode de vista prèvia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento řádek zobrazuje své šablony jako samostatné dlaždice ve stylu App Store. Úpravy jsou zakázány, dokud neukončíte režim náhledu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne række viser sine skabeloner som separate fliser i App Store-stil. Redigering er deaktiveret, indtil du afslutter forhåndsvisningstilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Zeile zeigt ihre Vorlagen als einzelne Kacheln im App Store-Stil. Bearbeiten ist deaktiviert, bis du den Vorschaumodus beendest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η σειρά εμφανίζει τα πρότυπά της ως ξεχωριστά πλακίδια στυλ App Store. Η επεξεργασία είναι απενεργοποιημένη μέχρι να βγείτε από τη λειτουργία προεπισκόπησης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta fila muestra sus plantillas como mosaicos separados al estilo del App Store. La edición está desactivada hasta que salgas del modo de vista previa."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این ردیف اسکرین‌شات‌هایش را به‌صورت کاشی‌های جداگانه به سبک App Store نشان می‌دهد. تا از حالت پیش‌نمایش خارج نشوید، ویرایش غیرفعال است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä rivi näyttää mallinsa erillisinä App Store-tyylisinä ruutuina. Muokkaus on poissa käytöstä, kunnes poistut esikatselutilasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

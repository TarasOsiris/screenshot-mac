          "stringUnit" : {
            "state" : "translated",
            "value" : "تمرین‌های تنیس روی میز خود را ثبت و پیگیری کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaudu ja seuraa pöytätennisharjoituksiasi."
          }

    "RevenueCat is configured with a Test Store API key. Replace it with your Apple public SDK key before shipping." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat ist mit einem Testspeicherschlüssel API konfiguriert. Ersetzen Sie ihn vor dem Versand durch Ihren öffentlichen Apple SDK-Schlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat está configurado con una clave de API de Test Store. Sustitúyela por tu clave pública SDK de Apple antes de publicar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat با یک کلید فروشگاه آزمایشی API پیکربندی شده است. قبل از ارسال، آن را با کلید SDK عمومی Apple خود جایگزین کنید."
          }
        },
        "fr" : {
          "stringUnit" : {

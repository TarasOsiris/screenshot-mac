          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**ড্রপ শ্যাডো** — বৈশিষ্ট্য বারে এটি সক্ষম করুন এবং **নরম**, **মাঝারি**, বা **শক্তিশালী** বাছাই করুন, অথবা হাতে রঙ, ব্যাসার্ধ, অফসেট এবং অস্বচ্ছতা সেট করুন। এটি একটি মাল্টি-আকৃতি নির্বাচনেও কাজ করে।"
          }
        },
        "ca" : {

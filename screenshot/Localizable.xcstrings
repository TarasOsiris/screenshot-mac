    "Screenshot sync was cancelled before anything was changed in App Store Connect." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronització de les captures de pantalla es va cancel·lar abans que es canviés res a App Store Connect."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisering af skærmbilleder blev annulleret, før noget blev ændret i App Store Connect."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Screenshot-Synchronisierung wurde abgebrochen, bevor in App Store Connect etwas geändert wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización de capturas se canceló antes de cambiar nada en App Store Connect."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همگام‌سازی اسکرین‌شات قبل از تغییر هر چیزی در App Store Connect لغو شد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvakaappauksen synkronointi peruutettiin ennen kuin mitään muutettiin termissä App Store Connect."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation des captures d'écran a été annulée avant que quoi que ce soit ne soit modifié dans App Store Connect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione degli screenshot è stata annullata prima che venisse modificato qualcosa in App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect で何かが変更される前に、スクリーンショットの同期がキャンセルされました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect에서 변경사항이 발생하기 전에 스크린샷 동기화가 취소되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisatie van schermafbeeldingen is geannuleerd voordat er iets werd gewijzigd in App Store Connect."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisering av skjermbilde ble avbrutt før noe ble endret i App Store Connect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização das capturas de tela foi cancelada antes de qualquer alteração no App Store Connect."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização da captura de ecrã foi cancelada antes de qualquer alteração em App Store Connect."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация скриншотов отменена до внесения каких-либо изменений в App Store Connect."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisering av skärmdump avbröts innan något ändrades i App Store Connect."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran görüntüsü eşzamanlaması, App Store Connect'te herhangi bir değişiklik yapılmadan önce iptal edildi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронізацію знімків екрана скасовано до того, як в App Store Connect щось змінилося."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截图同步在 App Store Connect 发生任何更改之前已取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "螢幕截圖同步已在 App Store Connect 中做出任何更改前取消。"
          }
        }
      }
    },
    "Screenshot sync was cancelled. Changes already made in App Store Connect were not reverted." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronització de captures de pantalla s'ha cancel·lat. Els canvis ja fets a App Store Connect no s'han revertit."
          }

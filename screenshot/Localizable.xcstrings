            "value" : "iPad ではフォルダへの書き出しは利用できません。代わりに共有シートから書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad에서는 폴더로 내보낼 수 없습니다. 대신 공유 시트 내보내기를 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporteren naar een map is niet beschikbaar op iPad; gebruik in plaats daarvan de export van het gedeelde blad."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksportering til en mappe er ikke tilgjengelig på iPad – bruk delearkeksporten i stedet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A exportação para uma pasta não está disponível no iPad — use a exportação pelo menu Compartilhar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A exportação para uma pasta não está disponível em iPad — em vez disso, use a exportação de planilha de partilha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспорт в папку недоступен на iPad — используйте экспорт через меню «Поделиться»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

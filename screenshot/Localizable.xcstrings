        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**A kijelölt nyelvek fordítása minden nyelvre** — megjelenik a nyelvi sávban, ha az alapnyelvet szerkeszti a kiválasztott szövegalakzatokkal. Egyszerre lefordítja a kijelölést minden más nyelvre."

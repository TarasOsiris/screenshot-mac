          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play staat maximaal %1$lld screenshots per type toe; deze rij bevat %2$lld."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play tillater maksimalt %1$lld skjermbilder per type; denne raden har %2$lld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Google Play permite no máximo %lld capturas de tela por tipo; esta linha tem %lld."

            "state" : "translated",
            "value" : "API 密鑰已連線，可以上傳螢幕截圖。"
          }
        }
      }
    },
    "The App Store screenshots for %@ changed after review. Refresh before syncing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App Store-Screenshots für %1$@ haben sich seit der Änderungsübersicht geändert. Aktualisiere vor dem Synchronisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capturas del App Store de %1$@ cambiaron después de la revisión. Actualiza antes de sincronizar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عکس‌های صفحه App Store برای %1$@ پس از بازبینی تغییر کردند. قبل از همگام‌سازی، بازخوانی کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures d'écran App Store de %1$@ ont été modifiées après examen. Actualisez avant de synchroniser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli screenshot dell'App Store per %@ sono cambiati dopo la revisione. Aggiorna prima di sincronizzare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ の App Store のスクリーンショットはレビュー後に変更されました。同期する前に更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 App Store 스크린샷이 검토 후 변경되었습니다. 동기화하기 전에 새로 고치세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As capturas de tela da App Store de %1$@ mudaram após a revisão. Atualize antes de sincronizar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скриншоты App Store для %@ изменились после проверки. Обновите перед синхронизацией."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ için App Store ekran görüntüleri incelemeden sonra değişti. Eşzamanlamadan önce yenileyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знімки екрана App Store для %@ змінилися після перегляду. Оновіть перед синхронізацією."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的 App Store 截图在检查后已发生更改。请在同步前刷新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的 App Store 螢幕截圖在檢查後已更改。請在同步前重新整理。"
          }
        }
      }
    },
    "The application ID of the app on Google Play, e.g. com.example.myapp." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anwendungs-ID der App auf Google Play, z. B. com.example.myapp."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ID de la app en Google Play, p. ej., com.example.myapp."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شناسهٔ برنامه در Google Play، مثلاً com.example.myapp."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ID de l'application sur Google Play, par ex. com.example.myapp."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ID applicazione dell'app su Google Play, ad esempio com.example.myapp."
          }
        },
        "ja" : {
          "stringUnit" : {

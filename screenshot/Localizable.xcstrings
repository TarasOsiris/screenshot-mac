        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ordem dos projetos pode ser definida como **Por data de criação** ou **Em ordem alfabética** em Ajustes ▸ Geral."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ordem do projeto pode ser definida como **Por data de criação** ou **Em ordem alfabética** em Configurações ▸ Geral."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordinea proiectului poate fi setată la **După data creării** sau **Alfabetic** în Setări ▸ General."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порядок проектов можно задать — **По дате создания** или **По алфавиту** — в разделе «Настройки ▸ Основные»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poradie projektu je možné nastaviť na **Podľa dátumu vytvorenia** alebo **Abecedne** v Nastaveniach ▸ Všeobecné."
          }
        },
        "sl" : {
          "stringUnit" : {

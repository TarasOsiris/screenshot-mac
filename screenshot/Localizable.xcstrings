    "Use demo mode to walk through the App Store Connect upload feature without an API key — for example during App Review." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم الوضع التجريبي للتنقل خلال ميزة التحميل App Store Connect بدون مفتاح API — على سبيل المثال أثناء مراجعة التطبيق."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitzeu el mode de demostració per recórrer la funció de càrrega de App Store Connect sense una tecla API, per exemple durant la revisió d'aplicacions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použijte ukázkový režim k procházení funkce nahrávání App Store Connect bez tlačítka API – například během kontroly aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug demotilstand til at gå gennem App Store Connect upload-funktionen uden en API-tast – for eksempel under appgennemgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze den Demomodus, um die Upload-Funktion für App Store Connect ohne API-Schlüssel durchzuspielen – zum Beispiel während App Review."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε τη λειτουργία επίδειξης για να περπατήσετε στη λειτουργία μεταφόρτωσης App Store Connect χωρίς κλειδί API — για παράδειγμα κατά τη διάρκεια της Επισκόπησης εφαρμογής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el modo de demostración para probar la subida a App Store Connect sin una clave de API; por ejemplo, durante App Review."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با حالت نمایشی می‌توانید قابلیت آپلود App Store Connect را بدون کلید API مرور کنید — مثلاً هنگام App Review."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä esittelytilaa käydäksesi läpi App Store Connect-latausominaisuuden ilman API-näppäintä – esimerkiksi sovelluksen tarkistuksen aikana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le mode démo pour parcourir la fonction d'envoi vers App Store Connect sans clé API — par exemple pendant l'App Review."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השתמש במצב הדגמה כדי לעבור דרך תכונת ההעלאה App Store Connect ללא מקש API - למשל במהלך סקירת אפליקציה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upotrijebite demo način rada za prolazak kroz značajku prijenosa App Store Connect bez ključa API — na primjer tijekom pregleda aplikacije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Használja a demó módot a App Store Connect feltöltési funkciójának API kulcs nélküli végiglépéséhez – például az Alkalmazások áttekintése során."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",

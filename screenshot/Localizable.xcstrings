    "Hold **⇧** while resizing to lock aspect ratio." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie **⇧** gedrückt, während Sie die Größe ändern, um das Seitenverhältnis zu sperren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenga presionado **⇧** mientras cambia el tamaño para bloquear la relación de aspecto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام تغییر اندازه برای قفل کردن نسبت تصویر، **⇧** را نگه دارید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez **⇧** pendant le redimensionnement pour verrouiller les proportions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイズ変更中に**⇧**を押したままにして、アスペクト比をロックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가로 세로 비율을 고정하려면 크기를 조정하는 동안 **⇧**를 누르세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure **⇧** enquanto redimensiona para bloquear a proporção."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整大小时按住 **⇧** 可锁定纵横比。"
          }
        }
      }
    },
    "Hold **⇧** while resizing to lock aspect ratio. Device frames other than **Invisible** always keep their proportions, with or without **⇧**." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie **⇧** gedrückt, während Sie die Größe ändern, um das Seitenverhältnis zu sperren. Andere Geräterahmen als **Invisible** behalten immer ihre Proportionen, mit oder ohne **⇧**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenga presionado **⇧** mientras cambia el tamaño para bloquear la relación de aspecto. Los marcos de dispositivos que no sean **Invisible** siempre mantienen sus proporciones, con o sin **⇧**."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام تغییر اندازه برای قفل کردن نسبت تصویر، **⇧** را نگه دارید. قاب‌های دستگاه غیر از **نامرئی** همیشه نسبت خود را، با یا بدون **⇧** حفظ می‌کنند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez **⇧** pendant le redimensionnement pour verrouiller les proportions. Les cadres d'appareil autres que **Invisible** conservent toujours leurs proportions, avec ou sans **⇧**."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto **⇧** durante il ridimensionamento per bloccare le proporzioni. Le cornici del dispositivo diverse da **Invisibile** mantengono sempre le proporzioni, con o senza **⇧**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイズ変更中に**⇧**を押したままにして、アスペクト比をロックします。 **Invisible** 以外のデバイス フレームは、**⇧** の有無にかかわらず、常にその比率を維持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가로 세로 비율을 고정하려면 크기를 조정하는 동안 **⇧**를 누르세요. **보이지 않음** 이외의 장치 프레임은 **⇧** 유무에 관계없이 항상 비율을 유지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure **⇧** enquanto redimensiona para bloquear a proporção. As molduras dos dispositivos que não sejam **Invisíveis** sempre mantêm suas proporções, com ou sem **⇧**."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте **⇧** при изменении размера, чтобы сохранить пропорции. Рамки устройств, кроме **Невидимой**, всегда сохраняют пропорции — с **⇧** или без."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En boy oranını kilitlemek için yeniden boyutlandırırken **⇧** tuşunu basılı tutun. **Görünmez** dışındaki aygıt çerçeveleri, **⇧** olsun ya da olmasın her zaman oranlarını korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утримуйте **⇧** під час зміни розміру, щоб зберегти пропорції. Рамки пристроїв, окрім **Невидимий**, завжди зберігають пропорції — з **⇧** чи без."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整大小时按住 **⇧** 可锁定纵横比。除 **Invisible** 之外的设备框架始终保持其比例，无论有或没有 **⇧**。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調整大小時按住 **⇧** 可鎖定長寬比。除了**隱形**以外的裝置外框，無論是否按住 **⇧** 都會保持其比例。"
          }
        }
      }
    },
    "Hold **⌥** while dragging to duplicate the shape as you move." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie beim Ziehen **⌥** gedrückt, um die Form beim Verschieben zu duplizieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionado **⌥** mientras arrastras para duplicar la forma a medida que te mueves."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در حین کشیدن، **⌥** را نگه دارید تا در حین حرکت، شکل تکراری شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez **⌥** tout en faisant glisser pour dupliquer la forme lorsque vous vous déplacez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto **⌥** durante il trascinamento per duplicare la forma mentre la sposti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌥** を押したままドラッグすると、移動に合わせて形状が複製されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌥** 키를 누른 채 드래그하면 이동하면서 모양이 복제됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure **⌥** enquanto arrasta para duplicar a forma conforme você se move."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте **⌥** при перетаскивании, чтобы дублировать фигуру во время перемещения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taşırken şekli çoğaltmak için sürüklerken **⌥** tuşunu basılı tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утримуйте **⌥** під час перетягування, щоб дублювати фігуру під час переміщення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动时按住 **⌥** 可在移动时复制形状。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移時按住 **⌥**，即可在移動的同時複製形狀。"
          }
        }
      }
    },

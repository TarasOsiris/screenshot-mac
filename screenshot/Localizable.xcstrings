    "Apply background across the entire row instead of repeating per screenshot" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hintergrund über die ganze Zeile legen, statt ihn pro Screenshot zu wiederholen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica el fondo a toda la fila en lugar de repetirlo en cada captura"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به جای تکرار در هر اسکرین‌شات، پس‌زمینه را در کل ردیف اعمال کنید"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquer l'arrière-plan sur toute la ligne au lieu de le répéter pour chaque capture d'écran"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applica lo sfondo all'intera riga invece di ripeterlo per ogni screenshot"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットごとに繰り返すのではなく、行全体に背景を適用します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크린샷별로 반복하는 대신 전체 행에 배경을 적용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica o plano de fundo à linha inteira em vez de repeti-lo em cada captura de tela"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применить фон ко всей строке, а не повторять для каждого скриншота"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka planı her ekran görüntüsünde tekrarlamak yerine satırın tamamına uygula"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосувати тло до всього рядка замість повторення для кожного знімка екрана"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将背景应用到整行，而不是在每张截图中重复"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將背景套用到整列，而非在每張螢幕截圖中重複"
          }
        }
      }
    },

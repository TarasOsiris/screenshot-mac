        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg app og version. Screenshot Bro kortlægger hver række automatisk til den rigtige enhedsfamilie."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie die App und Version aus. Screenshot Bro ordnet jede Zeile automatisch der richtigen Gerätefamilie zu."

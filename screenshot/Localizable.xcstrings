    "This plan no longer matches the project: its rows or languages were removed. Go back to the plan and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تعد هذه الخطة تتطابق مع المشروع: تمت إزالة صفوفه أو لغاته. ارجع إلى الخطة وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই পরিকল্পনাটি আর প্রকল্পের সাথে মেলে না: এর সারি বা ভাষাগুলি সরানো হয়েছে৷ পরিকল্পনায় ফিরে যান এবং আবার চেষ্টা করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {

    "Template borders, alignment guides, and selection handles are editor-only and never exported." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدود القالب وأدلة المحاذاة ومقابض التحديد هي للمحرر فقط ولا يتم تصديرها أبدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vores de la plantilla, les guies d'alineació i els controladors de selecció són només per a l'editor i mai s'exporten."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohraničení šablony, vodítka zarovnání a úchyty výběru jsou pouze pro editor a nikdy se neexportují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skabelonkanter, justeringshjælpelinjer og markeringshåndtag er kun til redigering og eksporteres aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorlagenränder, Ausrichtungshilfen und Auswahlgriffe gibt es nur im Editor; sie werden nie exportiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα περιγράμματα προτύπων, οι οδηγοί ευθυγράμμισης και οι λαβές επιλογής προορίζονται μόνο για επεξεργασία και δεν εξάγονται ποτέ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los bordes de las plantillas, las guías de alineación y los tiradores de selección solo se ven en el editor y nunca se exportan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حاشیه‌های اسکرین‌شات، راهنماهای تراز و دستگیره‌های انتخاب فقط در ویرایشگرند و هرگز صادر نمی‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mallin reunat, kohdistusohjaimet ja valintakahvat ovat vain muokkauskäyttöön tarkoitettuja, eikä niitä koskaan viedä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les bordures de modèle, les repères d'alignement et les poignées de sélection n'apparaissent que dans l'éditeur et ne sont jamais exportés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גבולות תבנית, קווי יישור ונקודות אחיזה לבחירה הינם לעורך בלבד ולעולם לא מיוצאים."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrubi predložaka, vodilice za poravnanje i ručke za odabir samo su za uređivač i nikada se ne izvoze."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sablonszegélyek, az igazítási segédvonalak és a kijelölési fogantyúk csak szerkesztők, és soha nem exportálhatók."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batas templat, panduan perataan, dan pengendali pemilihan hanya untuk editor dan tidak pernah diekspor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I bordi dei modelli, le guide di allineamento e le maniglie di selezione sono visibili solo nell'editor e non vengono mai esportati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テンプレートの境界線、位置合わせガイド、選択ハンドルはエディタでのみ表示され、書き出されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "템플릿 테두리, 정렬 안내선 및 선택 핸들은 편집기 전용이며 내보내지지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempadan templat, panduan penjajaran dan pemegang pemilihan adalah editor sahaja dan tidak pernah dieksport."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjabloonranden, uitlijningshulplijnen en selectiehandvatten kunnen alleen in de editor worden gebruikt en worden nooit geëxporteerd."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malkanter, justeringsstøtter og utvalgshåndtak er kun for redigering og eksporteres aldri."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obramowania szablonów, linie pomocnicze wyrównania i uchwyty zaznaczenia są przeznaczone wyłącznie do edycji i nigdy nie są eksportowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As bordas dos modelos, as guias de alinhamento e as alças de seleção aparecem só no editor e nunca são exportadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As bordas do modelo, as guias de alinhamento e as alças de seleção são apenas para editor e nunca são exportadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chenarele șablonului, ghidurile de aliniere și mânerele de selecție sunt doar pentru editor și nu sunt exportate niciodată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Границы шаблонов, направляющие выравнивания и ручки выделения видны только в редакторе и никогда не экспортируются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okraje šablóny, vodiace čiary zarovnania a rukoväte výberu sú len pre editor a nikdy sa neexportujú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrobe predloge, vodila za poravnavo in izbirne ročice so samo za urejevalnik in se nikoli ne izvozijo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mallkanter, inriktningsstödlinjer och urvalshandtag är endast för redigerare och exporteras aldrig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เส้นขอบเทมเพลต เส้นบอกแนว และขอบจับการเลือกเป็นแบบตัวแก้ไขเท่านั้นและไม่เคยส่งออก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şablon kenarlıkları, hizalama kılavuzları ve seçim tutamaçları yalnızca düzenleyicide görünür ve asla dışa aktarılmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Межі шаблонів, напрямні вирівнювання та маркери вибору видимі лише в редакторі й ніколи не експортуються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ٹیمپلیٹ بارڈرز، الائنمنٹ گائیڈز، اور سلیکشن ہینڈلز صرف ایڈیٹر ہیں اور کبھی برآمد نہیں ہوتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đường viền mẫu, hướng dẫn căn chỉnh và bộ điều khiển chọn chỉ dành cho người chỉnh sửa và không bao giờ được xuất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模板边框、对齐参考线和选择控制点仅在编辑器中显示，永远不会被导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "範本邊框、對齊參考線和選取控制點僅在編輯器中顯示，絕不會被輸出。"
          }
        }
      }
    },

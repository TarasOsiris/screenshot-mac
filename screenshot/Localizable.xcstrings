        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play publikuje jeden záznam na jazyk, který podporuje; každý jiný jazyk se nahraje normálně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play udgiver én liste pr. sprog, det understøtter; hvert andet sprog uploades normalt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

    },
    "Preview drops every handle, guide, and divider and lays the templates out as separate rounded tiles with a gap — the way a store listing shows them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقوم المعاينة بإسقاط كل مقبض ودليل ومقسم وتضع القوالب كمربعات مستديرة منفصلة مع وجود فجوة - بالطريقة التي تعرضها بها قائمة المتجر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vista prèvia deixa caure totes les nanses, guies i separadors i posa les plantilles com a fitxes arrodonides separades amb un buit, com les mostra una fitxa de botiga."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Náhled upustí každou rukojeť, vodítko a přepážku a rozloží šablony jako samostatné zaoblené dlaždice s mezerou – tak, jak je zobrazuje záznam v obchodě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preview taber hvert håndtag, guide og skillevæg og lægger skabelonerne ud som separate afrundede fliser med et mellemrum - sådan som en butiksfortegnelse viser dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Vorschau werden alle Griffe, Hilfslinien und Trennelemente entfernt und die Vorlagen als separate abgerundete Kacheln mit einer Lücke angeordnet – so, wie sie in einem Store-Eintrag angezeigt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η προεπισκόπηση απορρίπτει κάθε λαβή, οδηγό και διαχωριστικό και απλώνει τα πρότυπα ως ξεχωριστά στρογγυλεμένα πλακίδια με ένα κενό — όπως τα δείχνει μια καταχώριση καταστήματος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vista previa quita todos los tiradores, guías y separadores y muestra las plantillas como mosaicos redondeados separados, tal como las muestra la ficha de una tienda."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش‌نمایش همهٔ دستگیره‌ها، راهنماها و جداکننده‌ها را حذف می‌کند و اسکرین‌شات‌ها را به‌صورت کاشی‌های گوشه‌گرد جدا با فاصله می‌چیند — همان‌طور که صفحهٔ فروشگاه نشانشان می‌دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esikatselu pudottaa kaikki kahvat, ohjaimet ja jakajat ja asettaa mallit erillisiksi pyöristetyiksi laatoiksi, joissa on rako – kuten tietosivulla näkyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'aperçu masque poignées, repères et séparateurs, et présente les modèles sous forme de vignettes arrondies séparées par un espace — comme dans une fiche de boutique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התצוגה המקדימה מורידה כל ידית, מנחה ומפריד ומפרסת את התבניות כאריחים מעוגלים נפרדים עם רווח - כפי שמודעה בחנות מציגה אותם."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregled ispušta svaku ručku, vodilicu i razdjelnik i postavlja predloške kao zasebne zaobljene pločice s razmakom - onako kako ih prikazuje unos u trgovini."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az előnézet eldob minden fogantyút, vezetőt és elválasztót, és a sablonokat különálló, lekerekített csempékké helyezi el, amelyeken egy hézag van – ahogy az áruházi adatlap mutatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratinjau menghilangkan setiap pegangan, panduan, dan pembagi dan meletakkan template sebagai ubin bulat terpisah dengan celah — seperti yang ditunjukkan oleh listingan toko."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'anteprima rimuove ogni maniglia, guida e divisore e dispone i modelli come riquadri arrotondati separati da uno spazio, così come li mostra una scheda dello store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレビューでは、ハンドル、ガイド、区切り線がすべて非表示になり、テンプレートが間隔を空けた角丸のタイルとして並びます。ストアの掲載ページと同じ見え方です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리보기에서는 핸들, 안내선, 구분선이 모두 사라지고, 스토어 등록정보에 표시되는 방식처럼 템플릿이 간격을 둔 둥근 타일로 따로 배치됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratonton melepaskan setiap pemegang, panduan dan pembahagi dan meletakkan templat sebagai jubin bulat yang berasingan dengan jurang — cara penyenaraian gedung menunjukkannya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Preview worden alle handgrepen, hulplijnen en scheidingslijnen verwijderd en worden de sjablonen weergegeven als afzonderlijke afgeronde tegels met een opening, zoals een winkelvermelding ze laat zien."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forhåndsvisning slipper hvert håndtak, guide og skillevegg og legger ut malene som separate avrundede fliser med et mellomrom – slik en butikkoppføring viser dem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podgląd usuwa każdy uchwyt, prowadnicę i przekładkę i układa szablony jako osobne zaokrąglone kafelki ze szczeliną — tak, jak pokazują je informacje o sklepie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pré-visualização remove todas as alças, guias e divisórias e dispõe os modelos como blocos arredondados separados por um espaço — como a página da loja os mostra."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A visualização elimina todas as alças, guias e divisórias e apresenta os modelos como blocos arredondados separados com uma lacuna - da mesma forma que uma listagem de loja os mostra."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previzualizarea elimină fiecare mâner, ghid și separator și așează șabloanele sub formă de plăci rotunjite separate, cu un spațiu - așa cum le arată o listă de magazin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В режиме просмотра исчезают все ручки, направляющие и разделители, а шаблоны раскладываются отдельными скругленными плитками с зазором — так, как их показывает страница в магазине."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukážka stiahne každú rukoväť, vodidlo a rozdeľovač a rozloží šablóny ako samostatné zaoblené dlaždice s medzerou – tak, ako ich zobrazuje záznam v obchode."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predogled izpusti vsak ročaj, vodilo in razdelilnik ter postavi predloge kot ločene zaobljene ploščice z vrzeljo – tako, kot jih prikazuje seznam v trgovini."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förhandsgranskningen släpper alla handtag, guider och avdelare och lägger ut mallarna som separata rundade brickor med ett mellanrum – så som en butiksinformation visar dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแสดงตัวอย่างจะปล่อยแฮนเดิล คำแนะนำ และตัวแบ่งทั้งหมด และวางเทมเพลตเป็นไทล์โค้งมนแยกกันโดยมีช่องว่าง ซึ่งเป็นวิธีที่ข้อมูลผลิตภัณฑ์ใน Store แสดง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önizleme; tüm tutamaçları, kılavuzları ve ayırıcıları kaldırır ve şablonları aralarında boşluk bulunan ayrı yuvarlatılmış kutucuklar olarak dizer — tıpkı bir mağaza sayfasının gösterdiği gibi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перегляд прибирає всі маркери, напрямні й роздільники та розкладає шаблони як окремі заокруглені плитки з проміжками — так, як їх показує сторінка в магазині."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش نظارہ ہر ہینڈل، گائیڈ، اور ڈیوائیڈر کو گرا دیتا ہے اور ٹیمپلیٹس کو ایک گیپ کے ساتھ علیحدہ گول ٹائل کے طور پر رکھتا ہے — جس طرح سے اسٹور کی فہرست انہیں دکھاتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản xem trước loại bỏ mọi tay cầm, hướng dẫn và dải phân cách, đồng thời sắp xếp các mẫu dưới dạng các ô tròn riêng biệt có khoảng trống — cách danh sách cửa hàng hiển thị chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预览会隐藏所有控制点、参考线和分隔线，并将模板排列成带间隙的独立圆角卡片——就像商店页面中的显示方式一样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預覽會移除所有控制點、參考線和分隔線，並將範本排列為各自獨立、帶有間隙的圓角方塊——就像商店頁面所顯示的樣子。"
          }
        }
      }
    },

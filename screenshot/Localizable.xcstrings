        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj przycisku **Eksportuj podgląd** na pasku sterowania szablonu, aby wyrenderować pojedynczy szablon w oknie podglądu — przydatny do sprawdzania punktowego bez konieczności przechodzenia przez cały proces eksportu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o botão **Export Preview** na barra de controle do modelo para renderizar um único modelo em uma janela de visualização — útil para verificação pontual sem passar por todo o fluxo de exportação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o botão **Export Preview** na barra de controle do modelo para renderizar um único modelo em uma janela de visualização — útil para verificação pontual sem passar por todo o fluxo de exportação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizați butonul **Export Preview** din bara de control al șablonului pentru a reda un singur șablon într-o fereastră de previzualizare - util pentru verificarea punctuală fără a trece prin fluxul complet de export."

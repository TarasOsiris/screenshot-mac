    "Delete rows from the row header or row menu. Settings ▸ General has a confirmation toggle." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف صفوف من رأس الصف أو قائمة الصفوف. الإعدادات ▸ عام لديه مفتاح تبديل للتأكيد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimeix files de la capçalera o del menú de files. Configuració ▸ General té un commutador de confirmació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstraňte řádky ze záhlaví řádku nebo nabídky řádků. Nastavení ▸ Obecné má přepínač pro potvrzení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slet rækker fra rækkeoverskriften eller rækkemenuen. Indstillinger ▸ Generelt har en bekræftelseskontakt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösche Zeilen über die Kopfzeile oder das Menü der Zeile. Unter „Einstellungen ▸ Allgemein“ gibt es einen Schalter für eine Bestätigung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγράψτε σειρές από την κεφαλίδα ή το μενού σειράς. Ρυθμίσεις ▸ Γενικά έχει εναλλαγή επιβεβαίωσης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina filas desde el encabezado o el menú de la fila. Ajustes ▸ General tiene una opción de confirmación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ردیف‌ها را از سرِ ردیف یا منوی ردیف حذف کنید. در تنظیمات ▸ عمومی گزینه‌ای برای تأیید پیش از حذف هست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista rivit riviotsikosta tai rivivalikosta. Asetukset ▸ Yleiset -kohdassa on vahvistuskytkin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimez des lignes depuis l'en-tête de ligne ou le menu de la ligne. Réglages ▸ Général propose une option de confirmation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחק שורות מכותרת השורה או מתפריט השורה. הגדרות ▸ כללי יש בורר אישור."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbrišite retke iz zaglavlja retka ili izbornika retka. Postavke ▸ Općenito ima prekidač za potvrdu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorok törlése a sorfejlécből vagy a sormenüből. Beállítások ▸ Az Általános menüben van egy megerősítő kapcsoló."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus baris dari header baris atau menu baris. Pengaturan ▸ Umum memiliki tombol konfirmasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina le righe dall'intestazione o dal menu della riga. Impostazioni ▸ Generali contiene un'opzione di conferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行は行ヘッダーまたは行メニューから削除します。設定 ▸ 一般 に確認の有無を切り替える設定があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "행 헤더 또는 행 메뉴에서 행을 삭제합니다. 설정 ▸ 일반에는 확인 토글이 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padamkan baris daripada pengepala baris atau menu baris. Tetapan ▸ Umum mempunyai togol pengesahan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijder rijen uit de rijkop of het rijmenu. Instellingen ▸ Algemeen heeft een bevestigingsschakelaar."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slett rader fra radoverskriften eller radmenyen. Innstillinger ▸ Generelt har en bekreftelsesbryter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń wiersze z nagłówka wiersza lub menu wiersza. Ustawienia ▸ Ogólne ma przełącznik potwierdzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclua linhas pelo cabeçalho ou pelo menu da linha. Em Ajustes ▸ Geral há uma opção de confirmação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclua linhas do cabeçalho da linha ou do menu de linha. Configurações ▸ Geral tem um botão de confirmação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ștergeți rânduri din antetul rândului sau din meniul rândului. Setări ▸ General are o comutare de confirmare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляйте строки из заголовка строки или меню строки. В разделе «Настройки ▸ Основные» есть переключатель подтверждения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstráňte riadky z hlavičky riadka alebo ponuky riadkov. Nastavenia ▸ Všeobecné má prepínač na potvrdenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbrišite vrstice iz glave vrstice ali menija vrstice. Nastavitve ▸ Splošno ima preklop za potrditev."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta bort rader från radhuvudet eller radmenyn. Inställningar ▸ Allmänt har en bekräftelseväxling."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบแถวออกจากส่วนหัวของแถวหรือเมนูแถว การตั้งค่า ▸ ทั่วไป มีการสลับการยืนยัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satırları satır başlığından veya satır menüsünden silin. Ayarlar ▸ Genel'de bir onay anahtarı bulunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляйте рядки із заголовка рядка або меню рядка. У розділі «Параметри ▸ Загальні» є перемикач підтвердження."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قطار کے ہیڈر یا قطار کے مینو سے قطاریں حذف کریں۔ ترتیبات ▸ جنرل میں تصدیقی ٹوگل ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa các hàng khỏi tiêu đề hàng hoặc menu hàng. Cài đặt ▸ Cài đặt chung có nút chuyển đổi xác nhận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可从行标题或行菜单中删除行。“设置 ▸ 通用”中有确认开关。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從列標題或列選單刪除列。「設定 ▸ 一般」中有確認切換開關。"
          }
        }
      }
    },

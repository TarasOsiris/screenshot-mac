    "Existing screenshots in each matching display type set will be deleted and replaced. " : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف لقطات الشاشة الموجودة في كل مجموعة من أنواع العرض المطابقة واستبدالها. "
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures de pantalla existents a cada conjunt de tipus de visualització coincident se suprimiran i se substituiran. "
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stávající snímky obrazovky v každé sadě odpovídajících typů zobrazení budou odstraněny a nahrazeny. "
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksisterende skærmbilleder i hvert matchende skærmtypesæt vil blive slettet og erstattet. "
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorhandene Screenshots in jedem passenden Anzeigetypsatz werden gelöscht und ersetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα υπάρχοντα στιγμιότυπα οθόνης σε κάθε αντίστοιχο σύνολο τύπων οθόνης θα διαγραφούν και θα αντικατασταθούν. "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capturas existentes de cada tipo de pantalla coincidente se eliminarán y reemplazarán. "
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسکرین شات های موجود در هر مجموعه از نوع نمایشگر منطبق حذف و جایگزین خواهند شد. "
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokaisen vastaavan näyttötyyppisarjan nykyiset kuvakaappaukset poistetaan ja korvataan. "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures d'écran existantes dans chaque ensemble de types d'affichage correspondant seront supprimées et remplacées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צילומי מסך קיימים בכל סט סוג תצוגה תואם יימחקו ויוחלף. "
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",

    "Choose New Variant from Row in a row's menu, then change the copy." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر متغير جديد من صف في قائمة الصف، ثم قم بتغيير النسخة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি সারির মেনুতে সারি থেকে নতুন বৈকল্পিক চয়ন করুন, তারপর অনুলিপি পরিবর্তন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trieu Variant nova del menú Fila en una fila i, a continuació, canvieu la còpia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte Nová varianta z řádku v nabídce řádku a poté změňte kopii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg Ny variant fra række i en rækkes menu, og skift derefter kopien."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle im Menü einer Zeile „Neue Variante aus Zeile“ und ändere dann die Kopie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε Νέα παραλλαγή από το μενού Σειρά σε μια σειρά και, στη συνέχεια, αλλάξτε το αντίγραφο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige Nueva variante desde fila en el menú de una fila y luego cambia la copia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از منوی یک ردیف «نسخه جدید از ردیف» را انتخاب کنید، سپس کپی را تغییر دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse rivivalikosta Uusi versio rivivalikosta ja muuta kopiota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Nouvelle variante à partir de la ligne dans le menu d’une ligne, puis modifiez la copie."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પંક્તિના મેનૂમાં પંક્તિમાંથી નવું વેરિઅન્ટ પસંદ કરો, પછી કૉપિ બદલો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר גרסה חדשה מתפריט שורה בשורה ולאחר מכן שנה את העותק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पंक्ति के मेनू में पंक्ति से नया संस्करण चुनें, फिर प्रतिलिपि बदलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite Nova varijanta iz retka u izborniku retka, a zatim promijenite kopiju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassza az Új változat lehetőséget a sor menüjében, majd módosítsa a másolatot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih Varian Baru dari Baris di menu baris, lalu ubah salinannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli Nuova variante da riga nel menu di una riga, poi modifica il testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行のメニューで「行から新しいバリアント」を選択し、コピーを変更してください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಾಲಿನ ಮೆನುವಿನಲ್ಲಿ ಸಾಲಿನಿಂದ ಹೊಸ ರೂಪಾಂತರವನ್ನು ಆರಿಸಿ, ನಂತರ ನಕಲನ್ನು ಬದಲಾಯಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "행 메뉴에서 행으로 새 변형 만들기를 선택한 다음 복사본을 변경하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരു വരിയുടെ മെനുവിലെ വരിയിൽ നിന്ന് പുതിയ വേരിയൻ്റ് തിരഞ്ഞെടുക്കുക, തുടർന്ന് പകർപ്പ് മാറ്റുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पंक्तीच्या मेनूमधील पंक्तीमधून नवीन प्रकार निवडा, नंतर प्रत बदला."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih Varian Baharu daripada Baris dalam menu baris, kemudian tukar salinan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies Nieuwe variant uit rij in het menu van een rij en wijzig vervolgens de kopie."
          }

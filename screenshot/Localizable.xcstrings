    "None of this folder's languages are in the project yet. Turn on the ones to add below, and their screenshots import with them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد أي من لغات هذا المجلد في المشروع حتى الآن. قم بتشغيل العناصر المراد إضافتها أدناه، وسيتم استيراد لقطات الشاشة الخاصة بها معهم."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara no hi ha cap dels idiomes d'aquesta carpeta al projecte. Activeu els que voleu afegir a continuació i les seves captures de pantalla s'importen amb elles."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádný z jazyků této složky zatím není v projektu. Zapněte ty, které chcete přidat níže, a jejich snímky obrazovky se importují s nimi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen af denne mappes sprog er i projektet endnu. Tænd dem, der skal tilføjes nedenfor, og deres skærmbilleder importeres med dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine der Sprachen in diesem Ordner ist bereits im Projekt. Aktiviere unten die Sprachen, die du hinzufügen möchtest – ihre Screenshots werden dann mit importiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καμία από τις γλώσσες αυτού του φακέλου δεν είναι ακόμη στο έργο. Ενεργοποιήστε αυτά που θέλετε να προσθέσετε παρακάτω και τα στιγμιότυπα οθόνης τους εισάγονται μαζί τους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguno de los idiomas de esta carpeta está todavía en el proyecto. Activa abajo los que quieras añadir y sus capturas se importarán con ellos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هیچ‌یک از زبان‌های این پوشه هنوز در پروژه نیست. زبان‌هایی را که می‌خواهید اضافه کنید در پایین روشن کنید تا اسکرین‌شات‌هایشان هم وارد شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksikään tämän kansion kielistä ei ole vielä mukana projektissa. Ota käyttöön alla lisättävät kuvat, niin niiden kuvakaappaukset tuodaan niiden mukana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune des langues de ce dossier n'est encore dans le projet. Activez ci-dessous celles à ajouter : leurs captures seront importées avec elles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אף אחת מהשפות של התיקיה הזו עדיין לא נמצאת בפרויקט. הפעל את אלה להוספה למטה, וצילומי המסך שלהם מייבאים איתם."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nijedan od jezika ove mape još nije u projektu. U nastavku uključite one koje želite dodati i njihove snimke zaslona uvezite se s njima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mappa egyik nyelve sem szerepel még a projektben. Kapcsolja be az alább hozzáadni kívántakat, és velük együtt importálja a képernyőképeiket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada bahasa folder ini yang ada dalam proyek. Aktifkan yang akan ditambahkan di bawah, dan tangkapan layarnya akan diimpor bersama mereka."
          }

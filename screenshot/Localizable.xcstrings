    "Open the **Language** menu in the toolbar, or use **Language ▸ Manage Languages…** in the menu bar." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح قائمة **اللغة** في شريط الأدوات، أو استخدم **اللغة ▸ إدارة اللغات...** في شريط القائمة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obriu el menú **Idioma** a la barra d'eines o utilitzeu **Idioma ▸ Gestiona idiomes...** a la barra de menús."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřete nabídku **Jazyk** na panelu nástrojů nebo použijte **Jazyk ▸ Spravovat jazyky…** na panelu nabídek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn menuen **Sprog** på værktøjslinjen, eller brug **Sprog ▸ Administrer sprog...** i menulinjen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie das Menü **Sprache** in der Symbolleiste oder verwenden Sie **Sprache ▸ Sprachen verwalten…** in der Menüleiste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίξτε το μενού **Γλώσσα** στη γραμμή εργαλείων ή χρησιμοποιήστε **Γλώσσα ▸ Διαχείριση γλωσσών…** στη γραμμή μενού."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra el menú **Idioma** en la barra de herramientas o use **Idioma ▸ Administrar idiomas…** en la barra de menú."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منوی **Language** را در نوار ابزار باز کنید یا از **Language ▸ Manage Languages…** در نوار منو استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa työkalupalkin **Kieli**-valikko tai käytä valikkopalkin kohtaa **Kieli ▸ Hallitse kieliä…**."
          }
        },
        "fr" : {
          "stringUnit" : {

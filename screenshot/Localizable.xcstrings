            "value" : "Tätä joukkoa ei voida sisällyttää, koska vaaditut App Store tiedot eivät ole saatavilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet ensemble ne peut pas être inclus, car les données App Store requises ne sont pas disponibles."
          }
        },
        "it" : {
          "stringUnit" : {

          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依預設，列的背景會套用到該列中的每個範本。"
          }
        }
      }
    },
    "By default, Screenshot Bro exports every language, every row, and every template at 1× scale." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig exportiert Screenshot Bro jede Sprache, jede Zeile und jede Vorlage im 1-fachen Maßstab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De forma predeterminada, Screenshot Bro exporta cada idioma, cada fila y cada plantilla a escala 1×."

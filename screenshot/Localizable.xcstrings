        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned **mellanmusknappen** och dra för att panorera."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กด **ปุ่มกลางของเมาส์** แล้วลากเพื่อเลื่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydırmak için **orta fare düğmesini** basılı tutup sürükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утримуйте **середню кнопку миші** й перетягуйте, щоб прокручувати полотно."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**درمیانی ماؤس بٹن** کو تھامیں اور پین کے لیے گھسیٹیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",

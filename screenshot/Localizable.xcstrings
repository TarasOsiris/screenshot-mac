    "Drag and drop a PNG / JPEG onto a template to attach it as a device screenshot. A device shape is auto-created if needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh ein PNG / JPEG auf eine Vorlage, um es als Geräte-Screenshot einzusetzen. Bei Bedarf wird automatisch eine Geräteform erstellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra un PNG / JPEG a una plantilla para usarlo como captura del dispositivo. Si hace falta, se crea automáticamente una forma de dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک PNG / JPEG را روی اسکرین‌شات بکشید و رها کنید تا به‌عنوان اسکرین‌شات دستگاه قرار گیرد. در صورت نیاز، شکل دستگاه خودکار ساخته می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser un PNG / JPEG sur un modèle pour l'insérer comme capture d'écran de l'appareil. Une forme d'appareil est créée automatiquement si nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina un PNG / JPEG su un modello per associarlo come screenshot del dispositivo. Se necessario, viene creata automaticamente una forma dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG / JPEG をテンプレートにドラッグ&ドロップすると、デバイスのスクリーンショットとして取り付けられます。必要に応じてデバイス図形が自動的に作成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG / JPEG를 템플릿에 드래그 앤 드롭하면 기기 스크린샷으로 첨부됩니다. 필요하면 기기 도형이 자동으로 만들어집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste e solte um PNG / JPEG em um modelo para anexá-lo como uma captura de tela do dispositivo. Uma forma de dispositivo é criada automaticamente, se necessário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите PNG / JPEG на шаблон, чтобы вставить его как скриншот устройства. При необходимости фигура устройства создается автоматически."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir PNG / JPEG dosyasını aygıt ekran görüntüsü olarak eklemek için bir şablonun üzerine sürükleyip bırakın. Gerekirse otomatik olarak bir aygıt şekli oluşturulur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягніть PNG / JPEG на шаблон, щоб вставити його як знімок екрана пристрою. За потреби фігуру-пристрій буде створено автоматично."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 PNG / JPEG 拖放到模板上，即可将其附加为设备截图。如有需要，会自动创建设备形状。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將 PNG / JPEG 拖放到範本上，即可將其附加為裝置螢幕截圖。需要時會自動建立裝置形狀。"
          }
        }
      }
    },
    "Drag screenshots from Finder onto a canvas, or drop several at once to fill the row." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen Sie Screenshots aus dem Finder auf eine Leinwand oder legen Sie mehrere gleichzeitig ab, um die Zeile zu füllen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastre capturas de pantalla desde Finder a un lienzo o suelte varias a la vez para llenar la fila."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسکرین شات ها را از Finder روی بوم بکشید یا چند تا را به طور همزمان رها کنید تا ردیف پر شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les captures d'écran du Finder sur un canevas ou déposez-en plusieurs à la fois pour remplir la ligne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder からスクリーンショットをキャンバスにドラッグするか、複数のスクリーンショットを一度にドロップして行を埋めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder의 스크린샷을 캔버스로 드래그하거나 한 번에 여러 개를 드롭하여 행을 채웁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste capturas de tela do Finder para uma tela ou solte várias de uma vez para preencher a linha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 Finder 中的屏幕截图拖到画布上，或一次放置多个屏幕截图以填充该行。"
          }
        }
      }
    },
    "Drag screenshots from Photos or Files onto a canvas, or drop several at once to fill the row." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {

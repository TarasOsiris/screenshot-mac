        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un experiment App Store conține cel mult 3 tratamente. Ștergeți o variantă sau îmbinați două."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эксперимент в App Store может содержать не более 3 тестовых вариантов. Удалите вариант или объедините два."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",

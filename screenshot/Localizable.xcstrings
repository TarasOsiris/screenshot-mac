        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای انتخاب اسکرین شات از Photos یا Files، روی دستگاه دوبار ضربه بزنید."
          }
        },
        "fr" : {
          "stringUnit" : {

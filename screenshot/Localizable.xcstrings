    "1 current screenshot has no App Store checksum, so it will be replaced instead of preserved." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 captura de pantalla actual no té App Store suma de comprovació, de manera que es substituirà en lloc de conservar-la."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 nuværende skærmbillede har ingen App Store kontrolsum, så det vil blive erstattet i stedet for at blive bevaret."
          }
        },
        "de" : {
          "stringUnit" : {

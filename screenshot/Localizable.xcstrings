    "Steps to reproduce, ideally with a screen recording." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطوات إعادة الإنتاج، من الأفضل أن تكون من خلال تسجيل الشاشة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আদর্শভাবে একটি স্ক্রীন রেকর্ডিং সহ পুনরুত্পাদন করার পদক্ষেপ।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passos per reproduir, idealment amb una gravació de pantalla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kroky k reprodukci, ideálně se záznamem obrazovky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trin til gengivelse, ideelt set med en skærmoptagelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schritte zum Nachstellen, idealerweise mit einer Bildschirmaufnahme."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βήματα για αναπαραγωγή, ιδανικά με εγγραφή οθόνης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasos para reproducir, idealmente con una grabación de pantalla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مراحل بازتولید مشکل، ترجیحاً همراه با ضبط صفحه."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toistovaiheet, mieluiten näytön tallennuksen kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les étapes pour reproduire le problème, idéalement avec un enregistrement d'écran."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પ્રજનન માટેનાં પગલાં, આદર્શ રીતે સ્ક્રીન રેકોર્ડિંગ સાથે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שלבים לשכפול, באופן אידיאלי עם הקלטת מסך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुनरुत्पादन के चरण, आदर्श रूप से स्क्रीन रिकॉर्डिंग के साथ।"
          }
        },
        "hr" : {
          "stringUnit" : {

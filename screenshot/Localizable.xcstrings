        }
      }
    },
    "**Screenshots per new row** — number of empty templates a new row starts with." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Screenshots pro neuer Zeile** – Anzahl der leeren Vorlagen, mit denen eine neue Zeile beginnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Capturas por fila nueva**: número de plantillas vacías con las que empieza una fila nueva."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**اسکرین‌شات در هر ردیف جدید** — تعداد اسکرین‌شات‌های خالی‌ای که ردیف جدید با آن شروع می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {

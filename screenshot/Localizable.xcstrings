          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para probarlas, usa Exportar ▸ Subir prueba A/B a App Store Connect."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای آزمایش آن‌ها، از «خروجی ▸ آپلود آزمایش A/B در App Store Connect» استفاده کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ב-**Play Console ▸ משתמשים והרשאות**, הזמן את האימייל של חשבון השירות והענק לו גישה לעריכת רישום החנות של האפליקציה שלך."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U **Play konzoli ▸ Korisnici i dopuštenja** pozovite e-poštu računa usluge i dodijelite mu pristup za uređivanje unosa vaše aplikacije u trgovini."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A **Play Console ▸ Felhasználók és engedélyek** részben hívd meg a szolgáltatásfiók e-mail-címét, és adj neki hozzáférést az alkalmazás áruházi adatlapjának szerkesztéséhez."
          }
        },
        "id" : {
          "stringUnit" : {

    "“%@” can't take new screenshots now." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" no pot fer captures de pantalla noves ara."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" kan ikke tage nye skærmbilleder nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann gerade keine neuen Screenshots aufnehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» no admite nuevas capturas ahora."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» اکنون اسکرین‌شات جدید نمی‌پذیرد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" ei voi ottaa uusia kuvakaappauksia nyt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ne peut pas recevoir de nouvelles captures pour le moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” non può ricevere nuovi screenshot in questo momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は現在新しいスクリーンショットを受け付けられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) 지금 새 스크린샷을 받을 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” kan nu geen nieuwe screenshots maken."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» kan ikke ta nye skjermbilder nå."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não pode receber novas capturas agora."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” não pode fazer novas capturas de ecrã agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» сейчас не может принять новые скриншоты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" kan inte ta nya skärmdumpar nu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” şu anda yeni ekran görüntüsü alamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» зараз не може приймати нові знімки екрана."

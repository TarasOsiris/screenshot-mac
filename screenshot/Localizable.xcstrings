    "Double-click a **device** or **image** shape to open the picker and swap its picture." : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feu doble clic en una forma de **dispositiu** o **imatge** per obrir el selector i intercanviar-ne la imatge."
          }
        },
        "da" : {
          "stringUnit" : {

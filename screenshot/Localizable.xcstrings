        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آزادانہ طور پر گھومنے کے لیے گردش ہینڈل (شکل کے اوپر) گھسیٹیں۔ درست کنٹرول کے لیے گردش کے میدان میں ڈگری کی قدر ٹائپ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo núm điều khiển xoay (phía trên hình) để xoay tự do. Nhập giá trị độ vào trường xoay để kiểm soát chính xác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

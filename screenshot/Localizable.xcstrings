        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birkaç SVG'yi aynı anda bırakın; tek bir noktaya yığılmak yerine hafifçe kademeli olarak yerleşirler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо перетягнути кілька SVG одночасно, вони розташуються каскадом, а не накладуться в одному місці."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک ساتھ کئی SVGسیکنڈ گرائیں اور وہ ایک جگہ پر ڈھیر لگانے کے بجائے تھوڑا سا الگ ہوجاتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thả nhiều SVG cùng một lúc và chúng sẽ xếp chồng lên nhau một chút thay vì xếp chồng lên nhau tại một điểm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka planda bir `NSMetadataQuery`, her projenin yükleme/indirme ilerlemesini izler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За лаштунками `NSMetadataQuery` відстежує перебіг вивантаження й завантаження кожного проєкту."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پردے کے پیچھے، ایک `NSMetadataQuery` اپ لوڈ/ڈاؤن لوڈ کی پیشرفت کے لیے ہر پروجیکٹ کو دیکھتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phía sau hậu trường, `NSMetadataQuery` theo dõi từng dự án để biết tiến trình tải lên/tải xuống."

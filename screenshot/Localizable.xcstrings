    "First-time enable migrates your local project library into iCloud. A progress indicator shows the migration." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي التمكين لأول مرة إلى ترحيل مكتبة مشروعك المحلية إلى iCloud. يظهر مؤشر التقدم الهجرة."

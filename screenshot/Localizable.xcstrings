    "Project order can be set to **By creation date** or **Alphabetically** in Settings ▸ General." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن ضبط أمر المشروع على **حسب تاريخ الإنشاء** أو **أبجديًا** في الإعدادات ▸ عام."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ordre del projecte es pot configurar a **Per data de creació** o **Alfabèticament** a Configuració ▸ General."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pořadí projektu lze nastavit na **Podle data vytvoření** nebo **Abecedně** v Nastavení ▸ Obecné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projektrækkefølgen kan indstilles til **Efter oprettelsesdato** eller **Alfabetisk** i Indstillinger ▸ Generelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Projektreihenfolge lässt sich unter „Einstellungen ▸ Allgemein“ auf **Nach Erstellungsdatum** oder **Alphabetisch** stellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σειρά του έργου μπορεί να οριστεί σε **Με ημερομηνία δημιουργίας** ή **Αλφαβητικά** στις Ρυθμίσεις ▸ Γενικά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El orden de los proyectos puede ser **Por fecha de creación** o **Alfabéticamente** en Ajustes ▸ General."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتیب پروژه‌ها را می‌توان در تنظیمات ▸ عمومی روی **بر اساس تاریخ ایجاد** یا **بر اساس حروف الفبا** گذاشت."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projektin järjestyksen voi asettaa **Luomispäivämäärän mukaan** tai **Aakkosjärjestyksessä** kohdassa Asetukset ▸ Yleiset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ordre des projets peut être défini sur **Par date de création** ou **Par ordre alphabétique** dans Réglages ▸ Général."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניתן להגדיר את סדר הפרויקט ל-**לפי תאריך יצירה** או **לפי אלפביתי** בהגדרות ▸ כללי."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redoslijed projekta može se postaviti na **Prema datumu izrade** ili **Abecedno** u Postavke ▸ Općenito."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A projekt sorrendje **Létrehozás dátuma szerint** vagy **Abc sorrendben** állítható be a Beállítások ▸ Általános részben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urutan proyek dapat diatur ke **Berdasarkan tanggal pembuatan** atau **Sesuai Abjad** di Pengaturan ▸ Umum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ordine dei progetti può essere impostato su **Per data di creazione** o **Alfabetico** in Impostazioni ▸ Generali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトの順序は、設定 ▸ 一般 で **作成日順** または **アルファベット順** に設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트 순서는 설정 ▸ 일반에서 **생성 날짜별** 또는 **알파벳순**으로 설정할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Susunan projek boleh ditetapkan kepada **Mengikut tarikh penciptaan** atau **Mengikut Abjad** dalam Tetapan ▸ Umum."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

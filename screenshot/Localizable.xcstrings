        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Screenshot Bro: **Indstillinger ▸ App Store Connect** skal du indsætte Issuer ID og Key ID, og importere `.p8`-filen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie in Screenshot Bro: **Einstellungen ▸ App Store Connect** die Dateien Issuer ID und Key ID ein und importieren Sie die Datei „.p8“."

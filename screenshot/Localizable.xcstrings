          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor ed esportazione devono sempre corrispondere esattamente. In caso contrario, segnalalo come bug."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エディターとエクスポートは常に正確に一致する必要があります。そうでない場合は、バグとして報告してください。"
          }
        },
        "ko" : {
          "stringUnit" : {

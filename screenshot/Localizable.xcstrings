            "value" : "Haga clic derecho en un proyecto en el selector para cambiar el nombre, duplicar y eliminar acciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روی یک پروژه در انتخابگر کلیک راست کنید تا اقدامات را تغییر نام دهید، کپی کنید و حذف کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napsauta projektia hiiren kakkospainikkeella valitsimessa nimetäksesi uudelleen, kopioidaksesi ja poistaaksesi toimintoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez avec le bouton droit sur un projet dans le sélecteur pour renommer, dupliquer et supprimer des actions."

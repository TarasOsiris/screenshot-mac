          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**不可见**类别显示没有边框的屏幕截图 - 对于剪裁或抽象设计很有用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**隱形**類別會顯示沒有邊框的螢幕截圖——適用於裁切或抽象設計。"
          }

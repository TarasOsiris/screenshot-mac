    "Could not render screenshot %lld for %@ (%@) in %@. Check that this row previews correctly in the editor, then try the upload again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر عرض لقطة الشاشة %1$lld لـ %2$@ (%3$@) في %4$@. تأكد من معاينة هذا الصف بشكل صحيح في المحرر، ثم حاول التحميل مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%4$@ এ %2$@ (%3$@) এর জন্য %1$lld স্ক্রিনশট রেন্ডার করা যায়নি। এই সারিটি সম্পাদকে সঠিকভাবে প্রিভিউ করছে কিনা তা পরীক্ষা করুন, তারপর আবার আপলোড করার চেষ্টা করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut representar la captura de pantalla %1$lld per a %2$@ (%3$@) a %4$@. Comproveu que aquesta fila es visualitzi correctament a l'editor i torneu a provar de pujar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelze vykreslit snímek obrazovky %1$lld pro %2$@ (%3$@) v %4$@. Zkontrolujte, zda se náhled tohoto řádku v editoru zobrazuje správně, a poté zkuste nahrát znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke gengive skærmbilledet %1$lld for %2$@ (%3$@) i %4$@. Tjek, at denne række viser korrekt i editoren, og prøv derefter at uploade igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshot %1$lld für %2$@ (%3$@) in %4$@ konnte nicht gerendert werden. Prüfe, ob diese Zeile im Editor korrekt angezeigt wird, und versuche den Upload erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η απόδοση του στιγμιότυπου οθόνης %1$lld για το %2$@ (%3$@) στο %4$@. Ελέγξτε ότι αυτή η σειρά κάνει προεπισκόπηση σωστά στο πρόγραμμα επεξεργασίας και, στη συνέχεια, δοκιμάστε τη μεταφόρτωση ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo renderizar la captura %1$lld para %2$@ (%3$@) en %4$@. Comprueba que esta fila se previsualice correctamente en el editor y vuelve a intentar la subida."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسکرین‌شات %1$lld برای %2$@ (%3$@) در %4$@ رندر نشد. بررسی کنید این ردیف در ویرایشگر درست پیش‌نمایش می‌شود، سپس دوباره آپلود کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei voitu hahmontaa kuvakaappausta %1$lld kohteelle %2$@ (%3$@) kohteessa %4$@. Tarkista, että tämä rivi esikatsellaan oikein editorissa, ja yritä sitten latausta uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de rendre la capture %1$lld pour %2$@ (%3$@) dans %4$@. Vérifiez que cette ligne s’affiche correctement dans l’éditeur, puis réessayez l’envoi."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%4$@ માં %2$@ (%3$@) માટે સ્ક્રીનશૉટ %1$lld રેન્ડર કરી શકાયું નથી. તપાસો કે આ પંક્તિ સંપાદકમાં યોગ્ય રીતે પૂર્વાવલોકન કરે છે, પછી ફરીથી અપલોડ કરવાનો પ્રયાસ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה להציג צילום מסך %1$lld עבור %2$@ (%3$@) ב-%4$@. בדוק שהשורה הזו מציגה תצוגה מקדימה נכונה בעורך, ולאחר מכן נסה להעלות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%4$@ में %2$@ (%3$@) के लिए स्क्रीनशॉट %1$lld प्रस्तुत नहीं किया जा सका। जांचें कि यह पंक्ति संपादक में सही ढंग से पूर्वावलोकन करती है, फिर दोबारा अपलोड करने का प्रयास करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće prikazati snimak zaslona %1$lld za %2$@ (%3$@) u %4$@. Provjerite prikazuje li se ovaj redak ispravno u uređivaču, a zatim pokušajte ponovno učitati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült megjeleníteni az %1$lld képernyőképet %2$@ (%3$@) %4$@-ban. Ellenőrizze, hogy ennek a sornak az előnézete megfelelően jelenik-e meg a szerkesztőben, majd próbálja meg újra a feltöltést."

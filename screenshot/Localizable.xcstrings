    "Next, submit it for review. Apple reviews an experiment before it can start." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reiche es als Nächstes zur Prüfung ein. Apple prüft ein Experiment, bevor es starten kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después, envíalo a revisión. Apple revisa cada experimento antes de que pueda empezar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سپس آن را برای بررسی ارسال کنید. Apple هر آزمایش را پیش از شروع بررسی می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soumettez-la ensuite à l’examen. Apple examine chaque expérience avant son lancement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora invialo per la revisione. Apple revisiona un esperimento prima che possa iniziare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次に、審査に提出します。実験は開始前に Apple の審査を受けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음으로 심사에 제출하세요. Apple은 실험을 시작하기 전에 심사합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em seguida, envie para revisão. A Apple revisa o experimento antes que ele possa começar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затем отправьте его на проверку. Apple проверяет эксперимент, прежде чем его можно будет запустить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sırada incelemeye göndermek var. Apple bir deneyi başlamadan önce inceler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Далі надішліть його на перевірку. Apple перевіряє експеримент, перш ніж його можна буде запустити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下来，提交审核。实验开始前需经过 Apple 审核。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下來，請送交審查。Apple 會先審查實驗，才能開始執行。"
          }
        }
      }
    },
    "“%@” can't take new screenshots now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann gerade keine neuen Screenshots aufnehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» no admite nuevas capturas ahora."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» اکنون اسکرین‌شات جدید نمی‌پذیرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ne peut pas recevoir de nouvelles captures pour le moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” non può ricevere nuovi screenshot in questo momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は現在新しいスクリーンショットを受け付けられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) 지금 새 스크린샷을 받을 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não pode receber novas capturas agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» сейчас не может принять новые скриншоты."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” şu anda yeni ekran görüntüsü alamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» зараз не може приймати нові знімки екрана."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”目前无法接收新截图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」目前無法接受新的螢幕截圖。"
          }
        }
      }
    },
    "Has no %@ row, so this upload doesn't change its %@ screenshots." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hat keine %@-Zeile, daher ändert dieser Upload die %@-Screenshots nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tiene fila de %@, así que esta subida no cambia sus capturas de %@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ردیف %@ ندارد، پس این آپلود اسکرین‌شات‌های %@ آن را تغییر نمی‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'a pas de ligne %@ : cet envoi ne modifie pas ses captures %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ha una riga %@, quindi questo caricamento non modifica i suoi screenshot %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の行がないため、このアップロードでは %@ のスクリーンショットは変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 행이 없으므로 이번 업로드로 %@ 스크린샷이 바뀌지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não tem linha de %@, então este envio não altera as capturas de %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет строки %@, поэтому эта загрузка не изменит его скриншоты %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ satırı yok; bu yüzden bu yükleme %@ ekran görüntülerini değiştirmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не має рядка %@, тож це вивантаження не змінить його знімки екрана %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有 %@ 行，因此本次上传不会更改其 %@ 截图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有 %@ 列，因此此次上傳不會更改其 %@ 螢幕截圖。"
          }
        }
      }

    "SVGs are sanitized — script and event handlers are stripped before rendering." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تحسين SVG — تتم إزالة معالجات البرامج النصية والأحداث قبل العرض."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGগুলি স্যানিটাইজ করা হয়েছে — রেন্ডার করার আগে স্ক্রিপ্ট এবং ইভেন্ট হ্যান্ডলারগুলি ছিনতাই করা হয়েছে৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs estan desinfectats: els gestors d'scripts i d'esdeveniments s'eliminen abans de representar-los."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs jsou dezinfikovány – skripty a obslužné rutiny událostí jsou před vykreslením odstraněny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs er renset – script- og hændelseshandlere fjernes før gengivelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs werden bereinigt – Skripte und Event-Handler werden vor dem Rendern entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα SVGαπολυμαίνονται — οι χειριστές σεναρίων και συμβάντων απογυμνώνονται πριν από την απόδοση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los SVG se limpian: los scripts y los controladores de eventos se eliminan antes de renderizarlos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGها پاکسازی می‌شوند - اسکریپت‌ها و کنترل‌کننده‌های رویداد قبل از رندر کردن حذف می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs on puhdistettu – komentosarjat ja tapahtumakäsittelijät poistetaan ennen renderöimistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les SVG sont nettoyés : les scripts et gestionnaires d'événements sont supprimés avant le rendu."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGને સેનિટાઇઝ કરવામાં આવે છે — રેન્ડરિંગ પહેલાં સ્ક્રિપ્ટ અને ઇવેન્ટ હેન્ડલર્સ કાઢી નાખવામાં આવે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGים עוברים חיטוי - מטפלים בסקריפט ואירועים מופשטים לפני העיבוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG को साफ किया जाता है - रेंडरिंग से पहले स्क्रिप्ट और इवेंट हैंडलर को हटा दिया जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs su sanirani — skripta i rukovatelji događajima uklanjaju se prije iscrtavanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A SVGek megtisztításra kerülnek – a szkript- és eseménykezelők törlődnek a megjelenítés előtt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG telah dibersihkan — skrip dan pengendali kejadian dihapus sebelum dirender."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli SVG vengono ripuliti: script e gestori di eventi vengono rimossi prima del rendering."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG は無害化されます。スクリプトやイベントハンドラはレンダリング前に取り除かれます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGಗಳನ್ನು ಸ್ಯಾನಿಟೈಸ್ ಮಾಡಲಾಗಿದೆ - ರೆಂಡರಿಂಗ್ ಮಾಡುವ ಮೊದಲು ಸ್ಕ್ರಿಪ್ಟ್ ಮತ್ತು ಈವೆಂಟ್ ಹ್ಯಾಂಡ್ಲರ್‌ಗಳನ್ನು ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG는 안전하게 정리됩니다. 렌더링 전에 스크립트와 이벤트 핸들러가 제거됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG-കൾ അണുവിമുക്തമാക്കിയിരിക്കുന്നു - റെൻഡർ ചെയ്യുന്നതിന് മുമ്പ് സ്‌ക്രിപ്റ്റും ഇവൻ്റ് ഹാൻഡ്‌ലറുകളും നീക്കം ചെയ്യപ്പെടും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGसॅनिटाइझ केले आहेत — स्क्रिप्ट आणि इव्हेंट हँडलर प्रस्तुत करण्यापूर्वी काढून टाकले आहेत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs telah dibersihkan — skrip dan pengendali acara dilucutkan sebelum dipaparkan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs worden opgeschoond: script- en gebeurtenishandlers worden verwijderd voordat ze worden weergegeven."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs er renset – skript- og hendelsesbehandlere fjernes før gjengivelse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs są czyszczone — skrypty i procedury obsługi zdarzeń są usuwane przed renderowaniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs são higienizados – scripts e manipuladores de eventos são removidos antes da renderização."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs são higienizados – scripts e manipuladores de eventos são removidos antes da renderização."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG-urile sunt dezinfectate — scripturile și gestionarea evenimentelor sunt eliminate înainte de randare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG очищаются — скрипты и обработчики событий удаляются перед отрисовкой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGsú dezinfikované – skripty a obslužné nástroje udalostí sú pred vykreslením odstránené."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG so razčiščeni — skript in obdelovalci dogodkov so odstranjeni pred upodabljanjem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs är sanerade – skript- och händelsehanterare tas bort innan de renderas."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGகள் சுத்திகரிக்கப்படுகின்றன - ரெண்டரிங் செய்வதற்கு முன் ஸ்கிரிப்ட் மற்றும் நிகழ்வு ஹேண்ட்லர்கள் அகற்றப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGలు శానిటైజ్ చేయబడ్డాయి — స్క్రిప్ట్ మరియు ఈవెంట్ హ్యాండ్లర్లు రెండరింగ్ చేయడానికి ముందు తీసివేయబడతాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG ถูกสุขอนามัย — สคริปต์และตัวจัดการเหตุการณ์จะถูกถอดออกก่อนที่จะเรนเดอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG'ler temizlenir — oluşturmadan önce betikler ve olay işleyicileri kaldırılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG очищуються — скрипти й обробники подій вилучаються перед рендерингом."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG کو صاف کیا جاتا ہے — رینڈرنگ سے پہلے اسکرپٹ اور ایونٹ ہینڈلرز کو ہٹا دیا جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG đã được dọn dẹp — các trình xử lý tập lệnh và sự kiện sẽ bị loại bỏ trước khi hiển thị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG 会经过清理——渲染前会移除脚本和事件处理程序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG 會經過清理——轉譯前會移除指令碼和事件處理常式。"
          }
        }
      }
    },
    "SVGs render with a configurable color override and scale crisply at any export resolution." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم عرض SVG مع تجاوز اللون القابل للتكوين والقياس بشكل واضح بأي دقة تصدير."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেকোন এক্সপোর্ট রেজোলিউশনে একটি কনফিগারযোগ্য রঙ ওভাররাইড এবং স্ক্রীপলি স্কেল সহ SVGগুলি রেন্ডার।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs renderitza amb una substitució de color configurable i una escala nítida amb qualsevol resolució d'exportació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG se vykresluje s konfigurovatelným přepsáním barev a ostře měřítko při jakémkoli rozlišení exportu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs gengives med en konfigurerbar farvetilsidesættelse og skalerer skarpt ved enhver eksportopløsning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs lassen sich mit einer eigenen Farbe darstellen und bleiben bei jeder Exportauflösung scharf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η απόδοση του SVG με παράκαμψη χρώματος με δυνατότητα διαμόρφωσης και ευκρινή κλίμακα σε οποιαδήποτε ανάλυση εξαγωγής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los SVG se renderizan con un color personalizado opcional y escalan con nitidez a cualquier resolución de exportación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGها با امکان تعیین رنگ دلخواه رندر می‌شوند و در هر وضوح خروجی واضح می‌مانند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG renderöi konfiguroitavan värin ohituksen ja skaalaa terävästi millä tahansa vientitarkkuudella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

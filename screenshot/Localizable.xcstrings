    "Sent to Google Play. Review and publish from the Play Console (changes won't go live until you publish)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الإرسال إلى Google Play. يمكنك المراجعة والنشر من Play Console (لن يتم نشر التغييرات إلا بعد النشر)."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviat a Google Play. Revisa i publica des de Play Console (els canvis no es publicaran fins que no els publiques)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odesláno na Google Play. Zkontrolujte a publikujte ze služby Play Console (změny se projeví až po publikování)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendt til Google Play. Gennemgå og udgiv fra Play Console (ændringer går ikke live, før du udgiver)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An Google Play gesendet. Prüfe und veröffentliche die Änderungen in der Play Console (sie gehen erst live, wenn du sie veröffentlichst)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στάλθηκε σε Google Play. Ελέγξτε και δημοσιεύστε από το Play Console (οι αλλαγές δεν θα εμφανιστούν μέχρι να τις δημοσιεύσετε)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviado a Google Play. Revisa y publica desde Play Console (los cambios no se activarán hasta que los publiques)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به Google Play ارسال شد. از Play Console بازبینی و منتشر کنید (تا منتشر نکنید، تغییرات اعمال نمی‌شوند)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähetetty osoitteeseen Google Play. Tarkista ja julkaise Play Consolessa (muutoksia ei julkaista, ennen kuin julkaiset)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyé à Google Play. Examinez et publiez à partir de la Play Console (les modifications ne seront mises en ligne que lorsque vous les publierez)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נשלח אל Google Play. בדוק ופרסם מ-Play Console (השינויים לא יופעלו עד שתפרסם)."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslano na Google Play. Pregledajte i objavite na Play konzoli (promjene se neće objaviti dok ih ne objavite)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elküldve a következőnek: Google Play. Review and publish from the Play Console (changes won't go live until you publish)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikirim ke Google Play. Tinjau dan publikasikan dari Konsol Play (perubahan tidak akan diterapkan sampai Anda memublikasikannya)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviato a Google Play. Rivedi e pubblica dalla Play Console (le modifiche non saranno visibili finché non pubblichi)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play に送信しました。Play Console で確認して公開してください（公開するまで変更は反映されません）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play로 전송했습니다. Play Console에서 검토하고 게시하세요(게시하기 전까지는 변경 사항이 반영되지 않습니다)."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dihantar kepada Google Play. Semak dan terbitkan daripada Play Console (perubahan tidak akan disiarkan secara langsung sehingga anda menerbitkannya)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzonden naar Google Play. Beoordeel en publiceer vanuit de Play Console (wijzigingen worden pas live nadat u deze publiceert)."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendt til Google Play. Gjennomgå og publiser fra Play-konsollen (endringene publiseres ikke før du publiserer)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysłano do Google Play. Przejrzyj i opublikuj zmiany w Konsoli Play (zmiany zostaną wprowadzone dopiero po ich opublikowaniu)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviado ao Google Play. Revise e publique pelo Play Console (as alterações só entram no ar quando você publicar)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviado para Google Play. Revise e publique no Play Console (as alterações não serão publicadas até que você as publique)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trimis la Google Play. Examinați și publicați din Play Console (modificările nu vor fi disponibile până când nu publicați)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправлено в Google Play. Проверьте и опубликуйте в Play Console (изменения не вступят в силу, пока вы их не опубликуете)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odoslané na Google Play. Skontrolujte a zverejnite v službe Play Console (zmeny sa prejavia až po ich zverejnení)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslano na Google Play. Preglejte in objavite v Konzoli Play (spremembe ne bodo objavljene, dokler ne objavite)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skickat till Google Play. Granska och publicera från Play Console (ändringar publiceras inte förrän du publicerar)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งไปที่ Google Play ตรวจสอบและเผยแพร่จาก Play Console (การเปลี่ยนแปลงจะไม่มีผลจนกว่าคุณจะเผยแพร่)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play'e gönderildi. Play Console'dan inceleyip yayımlayın (siz yayımlayana kadar değişiklikler yayına girmez)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надіслано в Google Play. Перевірте й опублікуйте з Play Console (зміни не з’являться, доки ви їх не опублікуєте)."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play کو بھیجا گیا۔ Play Console سے جائزہ لیں اور شائع کریں (تبدیلیاں لائیو نہیں ہوں گی جب تک آپ شائع نہیں کریں گے)۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã gửi tới Google Play. Xem lại và xuất bản từ Play Console (các thay đổi sẽ không hiển thị cho đến khi bạn xuất bản)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已发送至 Google Play。请在 Play 管理中心检查并发布（在你发布之前，更改不会生效）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已傳送至 Google Play。請從 Play Console 檢查並發佈（在你發佈之前，更改不會生效）。"
          }
        }
      }
    },

    "This screenshot's file is missing. Add the image again to restore it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei dieses Screenshots fehlt. Füge das Bild erneut hinzu, um sie wiederherzustellen."

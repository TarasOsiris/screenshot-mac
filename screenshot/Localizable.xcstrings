    "Already bought? Paste the activation link from your receipt email." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja has comprat? Enganxeu l'enllaç d'activació del correu electrònic del rebut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allerede købt? Indsæt aktiveringslinket fra din kvitterings-e-mail."

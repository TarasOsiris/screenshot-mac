          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skicka sedan in den för granskning. Apple granskar ett experiment innan det kan starta."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அடுத்து, அதை மதிப்பாய்வுக்கு சமர்ப்பிக்கவும். ஆப்பிள் தொடங்கும் முன் ஒரு பரிசோதனையை மதிப்பாய்வு செய்கிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "తర్వాత, సమీక్ష కోసం సమర్పించండి. Apple ఒక ప్రయోగాన్ని ప్రారంభించడానికి ముందు దాన్ని సమీక్షిస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต่อไปก็ส่งไปตรวจทาน Apple ตรวจสอบการทดลองก่อนที่จะเริ่มได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sırada incelemeye göndermek var. Apple bir deneyi başlamadan önce inceler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Далі надішліть його на перевірку. Apple перевіряє експеримент, перш ніж його можна буде запустити."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگلا، اسے جائزہ کے لیے جمع کروائیں۔ ایپل ایک تجربہ شروع کرنے سے پہلے اس کا جائزہ لیتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiếp theo, gửi nó để xem xét. Apple xem xét một thử nghiệm trước khi nó có thể bắt đầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

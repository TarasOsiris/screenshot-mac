    "The dots stand in for your access token — the copied text carries the real one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Punkte stehen für dein Zugriffstoken – der kopierte Text enthält das echte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los puntos sustituyen a tu token de acceso: el texto copiado lleva el real."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقطه‌ها به‌جای توکن دسترسی شما نمایش داده می‌شوند — متن کپی‌شده حاوی توکن واقعی است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проще всего: вставьте промпт для агента в ваш ИИ-ассистент и дайте ему подключиться. Или добавьте сервер вручную по URL или с помощью конфигурации JSON, затем перезапустите клиент."
          }
        },
        "tr" : {
          "stringUnit" : {

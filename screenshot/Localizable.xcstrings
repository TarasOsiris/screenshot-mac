    "Start from a ready-made layout or a blank project. Templates come pre-sized for each store." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ من تخطيط جاهز أو مشروع فارغ. تأتي القوالب بحجم مسبق لكل متجر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comenceu des d'un disseny ja fet o un projecte en blanc. Les plantilles vénen de mida prèvia per a cada botiga."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začněte od hotového rozvržení nebo prázdného projektu. Šablony jsou dodávány s přednastavenou velikostí pro každý obchod."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start fra et færdigt layout eller et tomt projekt. Skabeloner leveres i præ-størrelse til hver butik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

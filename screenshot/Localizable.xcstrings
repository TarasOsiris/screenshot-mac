          }
        }
      }
    },
    "Z-order: **⌘⇧]** brings forward, **⌘⇧[** sends back." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتيب Z: **⌘⇧]** يقدم، **⌘⇧[** يرسل مرة أخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordre Z: **⌘⇧]** avança, **⌘⇧[** envia enrere."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-pořadí: **⌘⇧]** přenáší dopředu, **⌘⇧[** posílá zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-rækkefølge: **⌘⇧]** bringer frem, **⌘⇧[** sender tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebenenreihenfolge: **⌘⇧]** bringt ganz nach vorne, **⌘⇧[** ganz nach hinten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σειρά Z: **⌘⇧]** φέρνει προς τα εμπρός, **⌘⇧[** στέλνει πίσω."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orden de apilamiento: **⌘⇧]** trae al frente, **⌘⇧[** envía al fondo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتیب لایه‌ها: **⌘⇧]** به جلو می‌آورد و **⌘⇧[** به عقب می‌فرستد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-järjestys: **⌘⇧]** tuo eteenpäin, **⌘⇧[** lähettää takaisin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordre Z : **⌘⇧]** met au premier plan, **⌘⇧[** met à l'arrière-plan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סדר Z: **⌘⇧]** מביא קדימה, **⌘⇧[** שולח אחורה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-redoslijed: **⌘⇧]** vraća naprijed, **⌘⇧[** šalje natrag."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-sorrend: **⌘⇧]** előrehoz, **⌘⇧[** visszaküld."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-order: **⌘⇧]** memajukan, **⌘⇧[** mengirim kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordine di sovrapposizione: **⌘⇧]** porta avanti, **⌘⇧[** porta indietro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重なり順: **⌘⇧]** で最前面へ、**⌘⇧[** で最背面へ移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z 순서: **⌘⇧]** 키는 앞으로 가져오고, **⌘⇧[** 키는 뒤로 보냅니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesanan Z: **⌘⇧]** membawa ke hadapan, **⌘⇧[** menghantar kembali."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-volgorde: **⌘⇧]** brengt naar voren, **⌘⇧[** stuurt terug."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-rekkefølge: **⌘⇧]** bringer frem, **⌘⇧[** sender tilbake."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolejność Z: **⌘⇧]** przenosi do przodu, **⌘⇧[** odsyła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordem Z: **⌘⇧]** traz para a frente, **⌘⇧[** envia para trás."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordem Z: **⌘⇧]** antecipa, **⌘⇧[** envia de volta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordinea Z: **⌘⇧]** aduce înainte, **⌘⇧[** trimite înapoi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порядок наложения: **⌘⇧]** перемещает вперед, **⌘⇧[** — назад."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-poradie: **⌘⇧]** posúva dopredu, **⌘⇧[** posiela späť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-vrstni red: **⌘⇧]** popelje naprej, **⌘⇧[** pošlje nazaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-ordning: **⌘⇧]** flyttar framåt, **⌘⇧[** skickar tillbaka."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลำดับ Z: **⌘⇧]** นำไปข้างหน้า **⌘⇧[** ส่งกลับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z sırası: **⌘⇧]** öne getirir, **⌘⇧[** arkaya gönderir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порядок шарів: **⌘⇧]** переносить вперед, **⌘⇧[** — назад."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-order: **⌘⇧]** آگے لاتا ہے، **⌘⇧[** واپس بھیجتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thứ tự Z: **⌘⇧]** đưa tới, **⌘⇧[** gửi lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "层级顺序：**⌘⇧]** 移到最前面，**⌘⇧[** 移到最后面。"

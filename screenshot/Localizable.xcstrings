      }
    },
    "**Linear**: set the direction with the angle wheel, or with the eight one-click angle presets next to it." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Lineal**: establiu la direcció amb la roda angular o amb els vuit preajustos d'angle d'un clic al costat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Lineær**: Indstil retningen med vinkelhjulet eller med de otte forudindstillinger for et enkelt klik ved siden af."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Linear**: Lege die Richtung mit dem Winkelrad oder mit den acht Winkelvorgaben daneben fest."

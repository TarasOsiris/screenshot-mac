          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera den lokala MCP-servern och kopiera agentprompten, anslutnings-JSON eller åtkomsttoken. Se ämnet Automation & MCP."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดใช้งานเซิร์ฟเวอร์ MCP ในเครื่องและคัดลอกพรอมต์ของตัวแทน JSON การเชื่อมต่อ หรือโทเค็นการเข้าถึง ดูหัวข้อระบบอัตโนมัติและ MCP"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel MCP sunucusunu etkinleştirin ve ajan istemini, bağlantı JSON'unu veya erişim belirtecini kopyalayın. Otomasyon ve MCP konusuna bakın."
          }
        },
        "uk" : {
          "stringUnit" : {

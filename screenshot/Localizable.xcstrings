    "The dots stand in for your access token — the copied text carries the real one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Punkte stehen für Ihr Zugriffstoken – der kopierte Text trägt den echten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los puntos sustituyen a su token de acceso: el texto copiado lleva el real."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقطه ها برای نشانه دسترسی شما قرار می گیرند - متن کپی شده حاوی متن واقعی است."
          }
        },
        "fr" : {
          "stringUnit" : {

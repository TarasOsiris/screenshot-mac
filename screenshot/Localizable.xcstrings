          }
        }
      }
    },
    "Click a shape to select it. **Shift-click** to add to or remove from the selection." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feu clic a una forma per seleccionar-la. **Premeu Maj+clic** per afegir o eliminar de la selecció."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik på en figur for at vælge den. **Shift-klik** for at tilføje til eller fjerne fra markeringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf eine Form, um sie auszuwählen. **Klicken mit gedrückter Umschalttaste** fügt sie der Auswahl hinzu oder entfernt sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en una forma para seleccionarla. **Mayúsculas + clic** la añade a la selección o la quita."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای انتخاب یک شکل روی آن کلیک کنید. با **Shift-کلیک** آن را به انتخاب اضافه یا از آن حذف کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse muoto napsauttamalla sitä. **Vaihto-napsauta** lisätäksesi valintaan tai poistaaksesi siitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur une forme pour la sélectionner. **Maj-clic** pour l'ajouter à la sélection ou l'en retirer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su una forma per selezionarla. **Maiuscole-clic** per aggiungerla o rimuoverla dalla selezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "図形をクリックして選択します。**Shift キーを押しながらクリック** すると、選択に追加したり選択から外したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도형을 클릭하여 선택하세요. **Shift 키를 누른 채 클릭**하면 선택 항목에 추가하거나 제거할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik op een vorm om deze te selecteren. **Shift-klik** om toe te voegen aan of te verwijderen uit de selectie."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikk på en form for å velge den. **Shift-klikk** for å legge til eller fjerne fra utvalget."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em uma forma para selecioná-la. **Clique com a tecla Shift pressionada** para adicionar ou remover da seleção."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em uma forma para selecioná-la. **Clique com a tecla Shift pressionada** para adicionar ou remover da seleção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите фигуру, чтобы выбрать ее. **Нажатие с Shift** добавляет ее к выделению или убирает из него."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicka på en form för att välja den. **Skift-klicka** för att lägga till eller ta bort från urvalet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir şekli seçmek için üzerine tıklayın. Seçime eklemek veya seçimden çıkarmak için **Shift ile tıklayın**."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацніть фігуру, щоб вибрати її. **Клацання з Shift** додає до вибору або вилучає з нього."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按形状即可将其选中。**按住 Shift 键点按** 可将其添加到所选内容或从中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下形狀即可選取。**按住 Shift 並按一下**可將其加入選取範圍或從中移除。"
          }
        }
      }
    },
    "Click bar to add stops" : {

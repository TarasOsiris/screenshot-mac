    "Each canvas is one App Store screenshot. Double-tap the device to pick an image from Photos or Files." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل لوحة هي عبارة عن لقطة شاشة واحدة App Store. انقر نقرًا مزدوجًا على الجهاز لاختيار صورة من الصور أو الملفات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি ক্যানভাস একটি App Store স্ক্রিনশট। ফটো বা ফাইল থেকে একটি ছবি বাছাই করতে ডিভাইসটিতে ডবল-ট্যাপ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada llenç és una App Store captura de pantalla. Fes doble toc al dispositiu per triar una imatge de Fotos o Fitxers."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé plátno je jeden App Store snímek obrazovky. Dvojitým klepnutím na zařízení vyberete obrázek z fotografií nebo souborů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert lærred er ét App Store skærmbillede. Dobbelttryk på enheden for at vælge et billede fra Fotos eller Filer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Leinwand ist ein App Store-Screenshot. Tippe doppelt auf das Gerät, um ein Bild aus „Fotos“ oder „Dateien“ auszuwählen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε καμβάς είναι ένα στιγμιότυπο οθόνης App Store. Πατήστε δύο φορές τη συσκευή για να επιλέξετε μια εικόνα από τις Φωτογραφίες ή τα Αρχεία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada lienzo es una captura para el App Store. Toca dos veces el dispositivo para elegir una imagen de Fotos o Archivos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر بوم یک اسکرین‌شات App Store است. برای انتخاب تصویر از Photos یا Files، روی دستگاه دوبار ضربه بزنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen kangas on yksi App Store kuvakaappaus. Valitse kuva Kuvista tai Tiedostoista kaksoisnapauttamalla laitetta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque canevas correspond à une capture d'écran App Store. Touchez deux fois l'appareil pour choisir une image dans Photos ou Fichiers."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "દરેક કેનવાસ એક App Store સ્ક્રીનશૉટ છે. ફોટા અથવા ફાઇલોમાંથી છબી પસંદ કરવા માટે ઉપકરણને બે વાર ટેપ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל קנבס הוא צילום מסך אחד App Store. הקש פעמיים על המכשיר כדי לבחור תמונה מתוך תמונות או קבצים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक कैनवास एक App Store स्क्रीनशॉट है। फ़ोटो या फ़ाइलों से कोई छवि चुनने के लिए डिवाइस पर डबल-टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svako platno je jedna App Store snimka zaslona. Dvaput dodirnite uređaj za odabir slike iz fotografija ili datoteka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden vászon egy App Store képernyőképe. Koppintson duplán az eszközre egy kép kiválasztásához a Fotók vagy Fájlok közül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap kanvas berisi satu App Store tangkapan layar. Ketuk dua kali perangkat untuk memilih gambar dari Foto atau File."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni tela è uno screenshot dell'App Store. Tocca due volte il dispositivo per scegliere un'immagine da Foto o File."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各キャンバスが App Store のスクリーンショット1枚になります。デバイスをダブルタップすると、写真またはファイルから画像を選択できます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರತಿ ಕ್ಯಾನ್ವಾಸ್ ಒಂದು App Store ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ಆಗಿದೆ. ಫೋಟೋಗಳು ಅಥವಾ ಫೈಲ್‌ಗಳಿಂದ ಚಿತ್ರವನ್ನು ಆಯ್ಕೆ ಮಾಡಲು ಸಾಧನವನ್ನು ಡಬಲ್-ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 캔버스는 하나의 App Store 스크린샷입니다. 사진이나 파일에서 이미지를 선택하려면 기기를 두 번 탭하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഓരോ ക്യാൻവാസും ഒരു App Store സ്‌ക്രീൻഷോട്ടാണ്. ഫോട്ടോകളിൽ നിന്നോ ഫയലുകളിൽ നിന്നോ ഒരു ചിത്രം തിരഞ്ഞെടുക്കാൻ ഉപകരണത്തിൽ രണ്ടുതവണ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक कॅनव्हास हा एक App Store स्क्रीनशॉट आहे. फोटो किंवा फाइल्समधून इमेज निवडण्यासाठी डिव्हाइसवर दोनदा टॅप करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap kanvas ialah satu App Store tangkapan skrin. Ketik dua kali pada peranti untuk memilih imej daripada Foto atau Fail."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk canvas is één App Store screenshot. Dubbeltik op het apparaat om een ​​afbeelding te kiezen uit Foto's of Bestanden."
          }
        },
        "no" : {
          "stringUnit" : {

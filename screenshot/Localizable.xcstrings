        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez la forme, puis cliquez sur la zone d'image dans la barre des propriétés pour choisir un fichier, ou glissez-déposez directement sur la forme."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આકાર પસંદ કરો, પછી ફાઇલ પસંદ કરવા માટે પ્રોપર્ટીઝ બારમાં ઇમેજને સારી રીતે ક્લિક કરો અથવા સીધા આકાર પર ખેંચો અને છોડો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר את הצורה ולאחר מכן לחץ על התמונה היטב בסרגל המאפיינים כדי לבחור קובץ, או גרור ושחרר ישירות על הצורה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आकृति का चयन करें, फिर फ़ाइल चुनने के लिए प्रॉपर्टी बार में छवि पर क्लिक करें, या सीधे आकृति पर खींचें और छोड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite oblik, zatim dobro kliknite sliku na traci svojstava da odaberete datoteku ili povucite i ispustite izravno na oblik."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelölje ki az alakzatot, majd kattintson a képre a tulajdonságsávban egy fájl kiválasztásához, vagy húzza át közvetlenül az alakzatra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih bentuk, lalu klik gambar di bilah properti untuk memilih file, atau seret dan lepas langsung ke bentuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona la forma, poi fai clic sul riquadro dell'immagine nella barra delle proprietà per scegliere un file, oppure trascina e rilascia direttamente sulla forma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "図形を選択し、プロパティバーの画像の枠をクリックしてファイルを選ぶか、図形に直接ドラッグ&ドロップします。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಆಕಾರವನ್ನು ಆಯ್ಕೆಮಾಡಿ, ನಂತರ ಫೈಲ್ ಅನ್ನು ಆಯ್ಕೆ ಮಾಡಲು ಗುಣಲಕ್ಷಣಗಳ ಬಾರ್‌ನಲ್ಲಿ ಚಿತ್ರವನ್ನು ಚೆನ್ನಾಗಿ ಕ್ಲಿಕ್ ಮಾಡಿ ಅಥವಾ ನೇರವಾಗಿ ಆಕಾರಕ್ಕೆ ಎಳೆಯಿರಿ ಮತ್ತು ಬಿಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도형을 선택한 다음 속성 막대의 이미지 영역을 클릭해 파일을 선택하거나, 도형에 직접 드래그 앤 드롭하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ആകൃതി തിരഞ്ഞെടുക്കുക, തുടർന്ന് ഒരു ഫയൽ തിരഞ്ഞെടുക്കുന്നതിന് പ്രോപ്പർട്ടി ബാറിലെ ഇമേജിൽ നന്നായി ക്ലിക്ക് ചെയ്യുക, അല്ലെങ്കിൽ ആകൃതിയിലേക്ക് നേരിട്ട് വലിച്ചിടുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आकार निवडा, नंतर फाइल निवडण्यासाठी गुणधर्म बारमधील प्रतिमेवर चांगले क्लिक करा किंवा थेट आकारावर ड्रॅग आणि ड्रॉप करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih bentuk, kemudian klik imej dengan baik dalam bar sifat untuk memilih fail, atau seret dan lepas terus ke bentuk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecteer de vorm en klik vervolgens op de afbeelding in de eigenschappenbalk om een bestand te kiezen, of sleep deze rechtstreeks naar de vorm."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg formen, og klikk deretter bildebrønnen i egenskapslinjen for å velge en fil, eller dra og slipp direkte på formen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz kształt, a następnie kliknij obraz na pasku właściwości, aby wybrać plik, lub przeciągnij i upuść bezpośrednio na kształt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione a forma e clique no espaço da imagem na barra de propriedades para escolher um arquivo, ou arraste e solte diretamente na forma."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione a forma e clique na imagem na barra de propriedades para escolher um ficheiro ou arraste e solte diretamente na forma."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selectați forma, apoi faceți clic pe imaginea din bara de proprietăți pentru a alege un fișier sau trageți și plasați direct pe formă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите фигуру, затем нажмите поле изображения на панели свойств, чтобы выбрать файл, или перетащите изображение прямо на фигуру."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte tvar a potom kliknite na obrázok na paneli vlastností, aby ste vybrali súbor, alebo presuňte myšou priamo na tvar."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izberite obliko, nato dobro kliknite sliko v vrstici z lastnostmi, da izberete datoteko, ali povlecite in spustite neposredno na obliko."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj formen och klicka sedan på bildbrunnen i egenskapsfältet för att välja en fil, eller dra och släpp direkt på formen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வடிவத்தைத் தேர்ந்தெடுத்து, கோப்பைத் தேர்ந்தெடுக்க பண்புகள் பட்டியில் உள்ள படத்தை நன்றாகக் கிளிக் செய்யவும் அல்லது வடிவத்தின் மீது நேரடியாக இழுத்து விடவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఆకారాన్ని ఎంచుకుని, ఆపై ఫైల్‌ను ఎంచుకోవడానికి ప్రాపర్టీస్ బార్‌లోని ఇమేజ్‌ని బాగా క్లిక్ చేయండి లేదా డ్రాగ్ చేసి నేరుగా ఆకారంలోకి వదలండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกรูปร่าง จากนั้นคลิกช่องรูปภาพในแถบคุณสมบัติเพื่อเลือกไฟล์ หรือลากและวางลงบนรูปร่างโดยตรง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şekli seçin, ardından bir dosya seçmek için özellikler çubuğundaki görüntü alanına tıklayın ya da dosyayı doğrudan şeklin üzerine sürükleyip bırakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть фігуру, а потім клацніть поле зображення на панелі властивостей, щоб вибрати файл, або перетягніть файл прямо на фігуру."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شکل منتخب کریں، پھر فائل لینے کے لیے پراپرٹیز بار میں امیج پر اچھی طرح کلک کریں، یا شکل پر براہ راست گھسیٹ کر چھوڑیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn hình dạng, sau đó bấm vào ô hình ảnh trong thanh thuộc tính để chọn tệp hoặc kéo và thả trực tiếp vào hình dạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择形状，然后点按属性栏中的图像框来选取文件，或直接将文件拖放到形状上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選取形狀，然後按一下屬性列中的影像框來挑選檔案，或直接拖放到形狀上。"
          }
        }
      }
    },

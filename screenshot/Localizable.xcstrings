    "Fonts appear in the text shape font picker once registered." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الخطوط في منتقي خطوط شكل النص بمجرد تسجيلها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els tipus de lletra apareixen al selector de fonts de forma de text un cop registrats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po registraci se písma objeví ve výběru písma tvaru textu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrifttyper vises i skrifttypevælgeren til tekstform, når de er registreret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der Registrierung erscheinen Schriften in der Schriftauswahl von Textformen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι γραμματοσειρές εμφανίζονται στο εργαλείο επιλογής γραμματοσειράς σχήματος κειμένου μόλις εγγραφούν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez registradas, las fuentes aparecen en el selector de fuentes de las formas de texto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فونت‌ها پس از ثبت در انتخابگر فونت شکل متن ظاهر می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjasimet näkyvät tekstimuodon kirjasinvalitsimessa, kun ne on rekisteröity."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois enregistrées, les polices apparaissent dans le sélecteur de police des formes de texte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גופנים מופיעים בבוחר הגופנים של צורות הטקסט לאחר ההרשמה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fontovi se pojavljuju u biraču fonta oblika teksta nakon registracije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A betűtípusok a regisztráció után megjelennek a szövegalak betűtípus-választójában."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Font muncul di pemilih font bentuk teks setelah didaftarkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una volta registrati, i font compaiono nel selettore dei font delle forme di testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登録したフォントは、テキスト図形のフォントピッカーに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "등록된 서체는 텍스트 도형의 서체 선택기에 나타납니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fon muncul dalam pemilih fon bentuk teks setelah didaftarkan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lettertypen verschijnen in de lettertypekiezer voor tekstvormen zodra ze zijn geregistreerd."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrifter vises i skrifttypevelgeren for tekstform når de er registrert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zarejestrowaniu czcionki pojawiają się w selektorze czcionek kształtu tekstu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de registradas, as fontes aparecem no seletor de fontes das formas de texto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fontes aparecem no seletor de fontes de formato de texto depois de registradas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonturile apar în selectorul de fonturi în formă de text odată înregistrate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После регистрации шрифты появляются в меню шрифтов текстовой фигуры."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",

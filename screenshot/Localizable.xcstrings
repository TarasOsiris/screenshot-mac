            "value" : "**اصلی پہلو تناسب کو بحال کریں** (دائیں کلک) اونچائی کو موجودہ چوڑائی پر فٹ کر کے اسٹریچنگ کو کالعدم کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Khôi phục tỷ lệ khung hình gốc** (nhấp chuột phải) hoàn tác việc kéo dài bằng cách điều chỉnh chiều cao bằng chiều rộng hiện tại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**恢复原始宽高比**（右键点按）会根据当前宽度调整高度，以撤销拉伸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**恢復原始長寬比**（按右鍵）會依目前寬度調整高度，以復原延展效果。"
          }
        }
      }
    },

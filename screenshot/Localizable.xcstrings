    "File coordination (`NSFileCoordinator`) prevents corruption from concurrent reads/writes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمنع تنسيق الملفات (`NSFileCoordinator`) الفساد الناتج عن عمليات القراءة/الكتابة المتزامنة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coordinació de fitxers (`NSFileCoordinator`) evita la corrupció de les lectures/escriptures concurrents."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koordinace souborů (`NSFileCoordinator`) zabraňuje poškození při souběžném čtení/zápisu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filkoordinering (`NSFileCoordinator`) forhindrer korruption fra samtidige læsninger/skrivninger."

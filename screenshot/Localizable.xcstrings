    },
    "This row uploads %lld screenshots. App Store Connect accepts %lld–%lld, but most apps show at least %lld." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم هذا الصف بتحميل %1$lld من لقطات الشاشة. يقبل App Store Connect %2$lld–%3$lld، ولكن تعرض معظم التطبيقات %4$lld على الأقل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই সারিটি %1$lld স্ক্রিনশট আপলোড করে। App Store Connect স্বীকার করে %2$lld–%3$lld, কিন্তু বেশিরভাগ অ্যাপ অন্তত %4$lld দেখায়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta fila penja %1$lld captures de pantalla. App Store Connect accepta %2$lld–%3$lld, però la majoria d'aplicacions mostren almenys %4$lld."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento řádek nahrává %1$lld snímky obrazovky. App Store Connect přijímá %2$lld–%3$lld, ale většina aplikací zobrazuje alespoň %4$lld."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne række uploader %1$lld skærmbilleder. App Store Connect accepterer %2$lld–%3$lld, men de fleste apps viser mindst %4$lld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Zeile lädt %lld Screenshots hoch. App Store Connect akzeptiert %lld–%lld, aber die meisten Apps zeigen mindestens %lld."
          }
        },
        "el" : {

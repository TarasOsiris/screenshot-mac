    "Play publishes one listing per language it supports; every other language uploads normally." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينشر Play قائمة واحدة لكل لغة يدعمها؛ يتم تحميل كل اللغات الأخرى بشكل طبيعي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্লে এটি সমর্থন করে এমন ভাষা প্রতি একটি তালিকা প্রকাশ করে; অন্য প্রতিটি ভাষা সাধারণত আপলোড করে।"
          }
        },
        "ca" : {
          "stringUnit" : {

    "Double-click a text shape to edit inline. Press **Esc** or click outside to commit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelklicken Sie auf eine Textform, um sie inline zu bearbeiten. Drücken Sie **Esc** oder klicken Sie außerhalb, um den Commit durchzuführen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haga doble clic en una forma de texto para editarla en línea. Presione **Esc** o haga clic afuera para confirmar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای ویرایش درون خطی روی شکل متنی دوبار کلیک کنید. **Esc** را فشار دهید یا برای commit روی خارج کلیک کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-cliquez sur une forme de texte pour la modifier en ligne. Appuyez sur **Esc** ou cliquez à l'extérieur pour valider."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai doppio clic su una forma di testo per modificarla direttamente. Premi **Esc** o fai clic all'esterno per confermare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インライン編集するには、テキスト図形をダブルクリックします。 **Esc** を押すか、外側をクリックしてコミットします。"

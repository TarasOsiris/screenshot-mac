        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satır menüsü"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меню рядка"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行菜单"
          }
        },
        "zh-Hant" : {

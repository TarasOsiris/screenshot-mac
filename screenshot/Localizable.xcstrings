        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportálás menü ▸ **Sorok exportálása ▸ Showcase** a teljes projekthez, vagy sormenü ▸ **Sor exportálása ▸ Showcase** egy sorhoz."
          }
        },
        "id" : {

    "Could not parse the private key. Make sure it's a valid .p8 file downloaded from App Store Connect." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر تحليل المفتاح الخاص. تأكد من أنه ملف .p8 صالح تم تنزيله من App Store Connect."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut analitzar la clau privada. Assegureu-vos que sigui un fitxer .p8 vàlid baixat de App Store Connect."

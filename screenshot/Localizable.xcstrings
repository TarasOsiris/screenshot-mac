        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업로드 또는 다운로드가 진행 중일 때 툴바에는 iCloud 상태 아이콘이 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

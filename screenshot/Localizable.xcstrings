    "Google Play allows at most %lld screenshots per type; this row has %lld." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play يسمح بحد أقصى %1$lld من لقطات الشاشة لكل نوع؛ يحتوي هذا الصف على %2$lld."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play permet com a màxim %1$lld captures de pantalla per tipus; aquesta fila té %2$lld."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play povoluje maximálně %1$lld snímky obrazovky na typ; tento řádek má %2$lld."
          }
        },
        "da" : {

    "Exports use the row's exact pixel dimensions so App Store and Google Play sizes stay correct." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم عمليات التصدير أبعاد البكسل الدقيقة للصف حتى يظل حجم App Store وGoogle Play صحيحًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les exportacions utilitzen les dimensions exactes de píxels de la fila, de manera que les mides App Store i Google Play es mantenen correctes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporty používají přesné rozměry řádku v pixelech, takže velikosti App Store a Google Play zůstanou správné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksporter bruger rækkens nøjagtige pixeldimensioner, så størrelserne App Store og Google Play forbliver korrekte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporte verwenden die exakten Pixelmaße der Zeile, damit die Größen für App Store und Google Play stimmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι εξαγωγές χρησιμοποιούν τις ακριβείς διαστάσεις pixel της σειράς, ώστε τα μεγέθη App Store και Google Play να παραμένουν σωστά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las exportaciones usan las dimensiones exactas en píxeles de la fila para que los tamaños del App Store y Google Play sean correctos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خروجی‌ها از ابعاد پیکسلی دقیق ردیف استفاده می‌کنند تا اندازه‌های App Store و Google Play درست بمانند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viedissä käytetään rivin tarkkoja pikselimittoja, joten App Store- ja Google Play-koot pysyvät oikeina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les exportations utilisent les dimensions exactes en pixels de la ligne afin que les tailles App Store et Google Play restent correctes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ייצוא משתמש בממדי הפיקסלים המדויקים של השורה כך שהגדלים App Store ו-Google Play נשארים נכונים."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvozi koriste točne dimenzije reda u pikselima kako bi veličine App Store i Google Play ostale točne."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az exportálás a sor pontos képpontméreteit használja, így a App Store és Google Play méretek helyesek maradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekspor menggunakan dimensi piksel baris yang tepat sehingga ukuran App Store dan Google Play tetap benar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le esportazioni usano le dimensioni esatte in pixel della riga, così le dimensioni per App Store e Google Play restano corrette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き出しでは行の正確なピクセル寸法が使われるため、App Store や Google Play のサイズ要件を満たしたままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내보내기에서는 행의 정확한 픽셀 크기를 사용하므로 App Store 및 Google Play 크기가 올바르게 유지됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksport menggunakan dimensi piksel tepat baris supaya saiz App Store dan Google Play kekal betul."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij exporten worden de exacte pixelafmetingen van de rij gebruikt, zodat de afmetingen App Store en Google Play correct blijven."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksporter bruker radens eksakte pikseldimensjoner, slik at størrelsene App Store og Google Play forblir korrekte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksporty wykorzystują dokładne wymiary wiersza w pikselach, więc rozmiary App Store i Google Play pozostają prawidłowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As exportações usam as dimensões exatas em pixels da linha, para que os tamanhos da App Store e do Google Play fiquem corretos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As exportações usam as dimensões exatas em pixels da linha para que os tamanhos App Store e Google Play permaneçam corretos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporturile folosesc dimensiunile exacte în pixeli ale rândului, astfel încât dimensiunile App Store și Google Play rămân corecte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При экспорте используются точные размеры строки в пикселях, поэтому размеры для App Store и Google Play остаются правильными."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporty používajú presné rozmery riadka v pixeloch, takže veľkosti App Store a Google Play zostanú správne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvozi uporabljajo natančne dimenzije slikovnih pik vrstice, tako da ostaneta velikosti App Store in Google Play pravilni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporter använder radens exakta pixeldimensioner så att storlekarna App Store och Google Play förblir korrekta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การส่งออกจะใช้ขนาดพิกเซลที่แน่นอนของแถว ดังนั้นขนาด App Store และ Google Play จึงยังคงถูกต้อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dışa aktarmalar satırın tam piksel boyutlarını kullanır; böylece App Store ve Google Play boyutları doğru kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час експорту використовуються точні піксельні розміри рядка, тож розміри для App Store і Google Play залишаються правильними."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برآمدات قطار کے عین مطابق پکسل کے طول و عرض کا استعمال کرتی ہیں تاکہ App Store اور Google Play سائز درست رہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá trình xuất sử dụng kích thước pixel chính xác của hàng để kích thước App Store và Google Play luôn chính xác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出时使用行的精确像素尺寸，确保 App Store 和 Google Play 的尺寸正确。"

    "Apple allows at most 10 screenshots in a display-type set; this proposal has %lld." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسمح Apple بـ 10 لقطات شاشة على الأكثر في مجموعة نوع العرض؛ يحتوي هذا الاقتراح على %1$lld."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple permet com a màxim 10 captures de pantalla en un conjunt de tipus de pantalla; aquesta proposta té %1$lld."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple umožňuje maximálně 10 snímků obrazovky v sadě typu zobrazení; tento návrh má %1$lld."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple tillader højst 10 skærmbilleder i et sæt af skærmtype; dette forslag har %1$lld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple erlaubt höchstens 10 Screenshots pro Anzeigetyp-Set; dieser Vorschlag hat %1$lld."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Apple επιτρέπει το πολύ 10 στιγμιότυπα οθόνης σε ένα σύνολο τύπου οθόνης. αυτή η πρόταση έχει %1$lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple permite como máximo 10 capturas por conjunto de tipo de pantalla; esta propuesta tiene %1$lld."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپل در هر مجموعهٔ نوع نمایش حداکثر ۱۰ اسکرین‌شات را می‌پذیرد؛ این پیشنهاد %1$lld مورد دارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple sallii enintään 10 kuvakaappausta näyttötyyppisessä sarjassa; tässä ehdotuksessa on %1$lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple autorise au maximum 10 captures d'écran par ensemble de type d'affichage ; cette proposition en contient %1$lld."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפל מאפשרת לכל היותר 10 צילומי מסך בסט מסוג תצוגה; להצעה הזו יש %1$lld."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple dopušta najviše 10 snimki zaslona u skupu tipa zaslona; ovaj prijedlog ima %1$lld."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Apple legfeljebb 10 képernyőképet engedélyez egy kijelző típusú készletben; ez az ajánlat %1$lld."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple mengizinkan maksimal 10 tangkapan layar dalam satu set jenis tampilan; proposal ini memiliki %1$lld."
          }
        },
        "it" : {
          "stringUnit" : {

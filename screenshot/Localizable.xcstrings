    },
    "None of your apps have an editable version right now. Turn off the filter to see them all." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cap de les teves aplicacions té una versió editable ara mateix. Apagueu el filtre per veure'ls tots."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen af ​​dine apps har en redigerbar version lige nu. Sluk filteret for at se dem alle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine deiner Apps hat gerade eine bearbeitbare Version. Schalte den Filter aus, um alle zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna de tus apps tiene una versión editable en este momento. Desactiva el filtro para verlas todas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",

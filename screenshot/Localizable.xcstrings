    "Resize the row to one of: %@, or pick a matching display type." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتغيير حجم الصف إلى واحد مما يلي: %1$@، أو اختر نوع عرض مطابق."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvieu la mida de la fila a una de: %1$@, o trieu un tipus de visualització que coincideixi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změňte velikost řádku na jednu z: %1$@ nebo vyberte odpovídající typ zobrazení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilpas rækkens størrelse til en af: %1$@, eller vælg en matchende visningstype."

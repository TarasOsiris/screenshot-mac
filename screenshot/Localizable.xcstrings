        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect میں ایک نیا ورژن بنائیں، یا اس کے قابل ترمیم حالت میں واپس آنے کا انتظار کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạo phiên bản mới trong App Store Connect hoặc đợi phiên bản này quay lại trạng thái có thể chỉnh sửa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 App Store Connect 中创建新版本，或等待此版本恢复到可编辑状态。"

    "Show versions that are already live. Metadata can only be changed on editable versions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إظهار الإصدارات الموجودة بالفعل. لا يمكن تغيير البيانات التعريفية إلا في الإصدارات القابلة للتحرير."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra les versions que ja estan en directe. Les metadades només es poden canviar a les versions editables."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit verze, které jsou již aktivní. Metadata lze změnit pouze na upravitelných verzích."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis versioner, der allerede er live. Metadata kan kun ændres på redigerbare versioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versionen anzeigen, die bereits live sind. Metadaten können nur in bearbeitbaren Versionen geändert werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση εκδόσεων που είναι ήδη ζωντανές. Τα μεταδεδομένα μπορούν να αλλάξουν μόνο σε επεξεργάσιμες εκδόσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar las versiones que ya están publicadas. Los metadatos solo se pueden cambiar en versiones editables."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخه‌هایی که از قبل منتشر شده‌اند هم نمایش داده می‌شوند. فراداده را فقط در نسخه‌های قابل ویرایش می‌توان تغییر داد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä versiot, jotka ovat jo käytössä. Metatietoja voidaan muuttaa vain muokattavissa olevissa versioissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher les versions déjà en ligne. Les métadonnées ne peuvent être modifiées que dans les versions modifiables."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצג גרסאות שכבר פועלות. ניתן לשנות מטא נתונים רק בגרסאות הניתנות לעריכה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži verzije koje su već aktivne. Metapodaci se mogu mijenjati samo na verzijama koje je moguće uređivati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A már élő verziók megjelenítése. A metaadatok csak a szerkeszthető verziókban módosíthatók."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan versi yang sudah tayang. Metadata hanya dapat diubah pada versi yang dapat diedit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra le versioni già pubblicate. I metadati possono essere modificati solo nelle versioni modificabili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに公開されているバージョンを表示します。メタデータは編集可能なバージョンでのみ変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 출시된 버전을 표시합니다. 메타데이터는 편집 가능한 버전에서만 변경할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan versi yang sudah disiarkan. Metadata hanya boleh ditukar pada versi boleh diedit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon versies die al live zijn. Metagegevens kunnen alleen worden gewijzigd in bewerkbare versies."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis versjoner som allerede er aktive. Metadata kan bare endres på redigerbare versjoner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaż wersje, które już są aktywne. Metadane można zmieniać tylko w wersjach edytowalnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra versões já publicadas. Os metadados só podem ser alterados em versões editáveis."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar versões que já estão ativas. Os metadados só podem ser alterados em versões editáveis."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișați versiunile care sunt deja live. Metadatele pot fi modificate numai în versiunile editabile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать уже опубликованные версии. Метаданные можно менять только в редактируемых версиях."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobraziť verzie, ktoré sú už zverejnené. Metadáta je možné zmeniť iba na upraviteľných verziách."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaži različice, ki so že objavljene. Metapodatke je mogoče spremeniti samo v različicah, ki jih je mogoče urejati."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa versioner som redan är live. Metadata kan endast ändras på redigerbara versioner."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงเวอร์ชันที่มีอยู่แล้ว ข้อมูลเมตาสามารถเปลี่ยนแปลงได้ในเวอร์ชันที่แก้ไขได้เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaten yayında olan sürümleri göster. Meta veriler yalnızca düzenlenebilir sürümlerde değiştirilebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показати вже опубліковані версії. Метадані можна змінювати лише у версіях, доступних для редагування."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ ورژن دکھائیں جو پہلے سے لائیو ہیں۔ میٹا ڈیٹا صرف قابل تدوین ورژن پر تبدیل کیا جا سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị các phiên bản đã có sẵn. Siêu dữ liệu chỉ có thể được thay đổi trên các phiên bản có thể chỉnh sửa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示已上线的版本。元数据只能在可编辑的版本中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示已上架的版本。只有可編輯的版本才能更改後設資料。"
          }
        }
      }
    },
    "Show versions that are locked for review or live. Screenshots can only be uploaded to editable versions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إظهار الإصدارات المقفلة للمراجعة أو المباشرة. لا يمكن تحميل لقطات الشاشة إلا على الإصدارات القابلة للتحرير."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra les versions que estan bloquejades per a revisió o en directe. Les captures de pantalla només es poden penjar a versions editables."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit verze, které jsou uzamčeny pro kontrolu nebo zveřejnění. Snímky obrazovky lze nahrávat pouze do upravitelných verzí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis versioner, der er låst til gennemgang eller live. Skærmbilleder kan kun uploades til redigerbare versioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versionen anzeigen, die für die Prüfung gesperrt oder live sind. Screenshots können nur in bearbeitbare Versionen hochgeladen werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση εκδόσεων που είναι κλειδωμένες για έλεγχο ή ζωντανά. Τα στιγμιότυπα οθόνης μπορούν να μεταφορτωθούν μόνο σε επεξεργάσιμες εκδόσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show versions that are locked for review or live. Screenshots can only be uploaded to editable versions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar las versiones bloqueadas en revisión o ya publicadas. Solo se pueden subir capturas a versiones editables."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخه‌هایی که برای بازبینی قفل شده‌اند یا منتشر شده‌اند هم نمایش داده می‌شوند. اسکرین‌شات‌ها را فقط می‌توان در نسخه‌های قابل ویرایش آپلود کرد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä versiot, jotka on lukittu tarkistusta tai julkaisua varten. Kuvakaappauksia voidaan ladata vain muokattavissa oleviin versioihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher les versions verrouillées pour examen ou en ligne. Les captures d'écran ne peuvent être envoyées que vers des versions modifiables."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצג גרסאות שננעלות לבדיקה או פעילה. ניתן להעלות צילומי מסך רק לגרסאות הניתנות לעריכה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži verzije koje su zaključane za pregled ili uživo. Snimke zaslona mogu se prenijeti samo u verzije koje je moguće uređivati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megjeleníti azokat a verziókat, amelyek ellenőrzésre vagy élőben le vannak zárva. Képernyőképek csak szerkeszthető verziókra tölthetők fel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan versi yang dikunci untuk ditinjau atau ditayangkan. Tangkapan layar hanya dapat diunggah ke versi yang dapat diedit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra le versioni bloccate per la revisione o pubblicate. Gli screenshot possono essere caricati solo nelle versioni modificabili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "審査のためにロックされているバージョンや公開済みのバージョンを表示します。スクリーンショットは編集可能なバージョンにのみアップロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심사 중이라 잠겨 있거나 이미 출시된 버전을 표시합니다. 스크린샷은 편집 가능한 버전에만 업로드할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan versi yang dikunci untuk semakan atau langsung. Tangkapan skrin hanya boleh dimuat naik ke versi boleh diedit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon versies die zijn vergrendeld voor beoordeling of live. Schermafbeeldingen kunnen alleen worden geüpload naar bewerkbare versies."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis versjoner som er låst for gjennomgang eller live. Skjermbilder kan bare lastes opp til redigerbare versjoner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaż wersje zablokowane do sprawdzenia lub opublikowane. Zrzuty ekranu można przesyłać wyłącznie do wersji edytowalnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra versões bloqueadas para revisão ou já publicadas. As capturas de tela só podem ser enviadas para versões editáveis."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar versões que estão bloqueadas para revisão ou ativas. As capturas de ecrã só podem ser carregadas em versões editáveis."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișați versiunile care sunt blocate pentru revizuire sau live. Capturile de ecran pot fi încărcate numai în versiuni editabile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать версии, заблокированные на время проверки или опубликованные. Скриншоты можно загружать только в редактируемые версии."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobraziť verzie, ktoré sú uzamknuté na kontrolu alebo zverejnenie. Snímky obrazovky je možné nahrať iba do upraviteľných verzií."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaži različice, ki so zaklenjene za pregled ali v živo. Posnetke zaslona je mogoče naložiti samo v različice, ki jih je mogoče urejati."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa versioner som är låsta för granskning eller live. Skärmdumpar kan endast laddas upp till redigerbara versioner."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงเวอร์ชันที่ถูกล็อคสำหรับการตรวจทานหรือใช้งานจริง ภาพหน้าจอสามารถอัปโหลดไปยังเวอร์ชันที่แก้ไขได้เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnceleme için kilitli veya yayında olan sürümleri göster. Ekran görüntüleri yalnızca düzenlenebilir sürümlere yüklenebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показати версії, заблоковані на перевірку або вже опубліковані. Знімки екрана можна вивантажувати лише у версії, доступні для редагування."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ ورژن دکھائیں جو نظرثانی یا لائیو کے لیے مقفل ہیں۔ اسکرین شاٹس کو صرف قابل تدوین ورژن پر اپ لوڈ کیا جا سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị các phiên bản bị khóa để xem xét hoặc trực tiếp. Ảnh chụp màn hình chỉ có thể được tải lên các phiên bản có thể chỉnh sửa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示已锁定（正在审核或已上线）的版本。截图只能上传到可编辑的版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示已鎖定審查中或已上架的版本。只有可編輯的版本才能上傳螢幕截圖。"
          }
        }
      }
    },

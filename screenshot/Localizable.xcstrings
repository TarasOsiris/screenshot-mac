    "This row is showing its templates as separate App Store-style tiles. Editing is disabled until you exit preview mode." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض هذا الصف القوالب الخاصة به كمربعات منفصلة بنمط App Store. يتم تعطيل التحرير حتى تخرج من وضع المعاينة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই সারিটি তার টেমপ্লেটগুলিকে আলাদা App Store-শৈলী টাইলস হিসাবে দেখাচ্ছে৷ আপনি প্রিভিউ মোড থেকে প্রস্থান না করা পর্যন্ত সম্পাদনা অক্ষম থাকে৷"

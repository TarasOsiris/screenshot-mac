    "Render every row in every language as PNG or JPEG, organized into per-language folders — or upload them straight to App Store Connect from here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendere jede Zeile in jeder Sprache als PNG oder JPEG, sortiert in Ordner pro Sprache – oder lade sie von hier direkt in App Store Connect hoch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderiza cada fila en cada idioma como PNG o JPEG, organizadas en carpetas por idioma, o súbelas directamente a App Store Connect desde aquí."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر ردیف را در هر زبان به‌صورت PNG یا JPEG رندر کنید، مرتب‌شده در پوشه‌های جداگانهٔ هر زبان — یا از همین‌جا مستقیماً در App Store Connect آپلود کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Générez chaque ligne dans chaque langue au format PNG ou JPEG, rangées dans des dossiers par langue — ou envoyez-les directement vers App Store Connect d'ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera ogni riga in ogni lingua come PNG o JPEG, organizzate in cartelle per lingua, oppure caricale direttamente su App Store Connect da qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての言語のすべての行を PNG または JPEG でレンダリングして言語ごとのフォルダに整理するか、ここから App Store Connect に直接アップロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 언어의 모든 행을 언어별 폴더로 구성된 PNG 또는 JPEG로 렌더링하거나 여기에서 App Store Connect에 바로 업로드하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderize todas as linhas em todos os idiomas como PNG ou JPEG, organizadas em pastas por idioma — ou envie tudo direto para o App Store Connect daqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отрисуйте каждую строку на каждом языке в PNG или JPEG с разбивкой по папкам языков — или загрузите их прямо отсюда в App Store Connect."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her satırı her dilde PNG veya JPEG olarak oluşturun ve dillere göre klasörlere düzenleyin — ya da buradan doğrudan App Store Connect'e yükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рендеріть кожен рядок кожною мовою у PNG або JPEG, упорядкованими в папки за мовами, — або вивантажуйте їх прямо звідси в App Store Connect."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将每种语言的每一行渲染为 PNG 或 JPEG，并按语言整理到各自的文件夹中——或直接从这里上传到 App Store Connect。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將每種語言的每一列轉譯為 PNG 或 JPEG，並依語言整理到各自的資料夾中——或直接從這裡上傳到 App Store Connect。"
          }
        }
      }
    },

    "This applies translation from the base language to every text layer in %@ and replaces the current translated text." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això aplica la traducció de l'idioma base a cada capa de text a %1$@ i substitueix el text traduït actual."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette anvender oversættelse fra basissproget til hvert tekstlag i %1$@ og erstatter den aktuelle oversatte tekst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird die Übersetzung aus der Basissprache auf jede Textebene in %@ angewendet und der aktuell übersetzte Text ersetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto traduce desde el idioma base cada forma de texto de %@ y reemplaza el texto traducido actual."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کار ترجمه از زبان پایه را به هر لایه متنی در %1$@ اعمال می‌کند و جایگزین متن ترجمه‌شده فعلی می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä käyttää käännöstä peruskielestä jokaiseen %1$@:n tekstitasoon ja korvaa nykyisen käännetyn tekstin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action traduit chaque calque de texte de la langue de base vers %@ et remplace le texte traduit actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione applica la traduzione dalla lingua di base a ogni livello di testo in %@ e sostituisce il testo tradotto attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本言語からの翻訳を %@ のすべてのテキストレイヤーに適用し、現在の翻訳済みテキストを置き換えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 언어 텍스트를 %@(으)로 번역하여 모든 텍스트 레이어에 적용하고, 현재 번역된 텍스트를 대체합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit past de vertaling uit de basistaal toe op elke tekstlaag in %1$@ en vervangt de huidige vertaalde tekst."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette gjelder oversettelse fra basisspråket til hvert tekstlag i %1$@ og erstatter gjeldende oversatte tekst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto aplica a tradução do idioma base a todas as camadas de texto em %@ e substitui o texto traduzido atual."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto aplica a tradução do idioma base a cada camada de texto em %1$@ e substitui o texto traduzido atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для каждого текстового слоя на языке «%@» будет применен перевод с базового языка, а текущий переведенный текст будет заменен."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta tillämpar översättning från basspråket till varje textlager i %1$@ och ersätter den aktuella översatta texten."
          }

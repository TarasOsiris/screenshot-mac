        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect فی ڈسپلے کی زیادہ سے زیادہ %1$lld اسکرین شاٹس کی اجازت دیتا ہے۔ اس قطار میں %2$lld ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect cho phép tối đa %1$lld ảnh chụp màn hình cho mỗi loại màn hình; hàng này có %2$lld."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect 每种显示类型最多允许 %lld 张截图；此行有 %lld 张。"

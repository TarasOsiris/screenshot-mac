    "Languages let you generate localized screenshot sets without duplicating your project. Each language shares the same layout and shapes; only text properties (content, font, size, alignment) are overridden per language." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتيح لك اللغات إنشاء مجموعات لقطات شاشة مترجمة دون تكرار مشروعك. تشترك كل لغة في نفس التخطيط والأشكال؛ يتم تجاوز خصائص النص فقط (المحتوى، الخط، الحجم، المحاذاة) لكل لغة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভাষাগুলি আপনাকে আপনার প্রকল্পের নকল না করেই স্থানীয় স্ক্রিনশট সেট তৈরি করতে দেয়৷ প্রতিটি ভাষা একই বিন্যাস এবং আকার শেয়ার করে; শুধুমাত্র টেক্সট বৈশিষ্ট্য (সামগ্রী, ফন্ট, আকার, প্রান্তিককরণ) ভাষা প্রতি ওভাররাইড করা হয়."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els idiomes us permeten generar conjunts de captures de pantalla localitzats sense duplicar el vostre projecte. Cada idioma comparteix la mateixa disposició i formes; només les propietats del text (contingut, tipus de lletra, mida, alineació) es substitueixen per idioma."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jazyky vám umožňují generovat lokalizované sady snímků obrazovky bez duplikace vašeho projektu. Každý jazyk sdílí stejné rozložení a tvary; pouze vlastnosti textu (obsah, font, velikost, zarovnání) jsou přepsány pro jazyk."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprog giver dig mulighed for at generere lokaliserede skærmbilleder uden at duplikere dit projekt. Hvert sprog deler det samme layout og samme former; kun tekstegenskaber (indhold, skrifttype, størrelse, justering) tilsidesættes pr. sprog."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mithilfe von Sprachen können Sie lokalisierte Screenshot-Sets erstellen, ohne Ihr Projekt zu duplizieren. Jede Sprache hat das gleiche Layout und die gleichen Formen; Pro Sprache werden nur Texteigenschaften (Inhalt, Schriftart, Größe, Ausrichtung) überschrieben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι γλώσσες σάς επιτρέπουν να δημιουργείτε τοπικά σετ στιγμιότυπων οθόνης χωρίς να αντιγράφετε το έργο σας. Κάθε γλώσσα μοιράζεται την ίδια διάταξη και σχήματα. Μόνο οι ιδιότητες κειμένου (περιεχόμενο, γραμματοσειρά, μέγεθος, στοίχιση) παρακάμπτονται ανά γλώσσα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los idiomas le permiten generar conjuntos de capturas de pantalla localizados sin duplicar su proyecto. Cada idioma comparte el mismo diseño y formas; sólo las propiedades del texto (contenido, fuente, tamaño, alineación) se anulan por idioma."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زبان‌ها به شما امکان می‌دهند مجموعه‌های اسکرین‌شات محلی را بدون تکرار پروژه خود ایجاد کنید. هر زبان طرح و اشکال یکسانی دارد. فقط ویژگی های متن (محتوا، فونت، اندازه، تراز) در هر زبان لغو می شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kielten avulla voit luoda lokalisoituja kuvakaappausjoukkoja kopioimatta projektia. Jokaisella kielellä on sama asettelu ja muodot; vain tekstin ominaisuudet (sisältö, fontti, koko, tasaus) ohitetaan kielten mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les langues vous permettent de générer des jeux de captures d'écran localisés sans dupliquer votre projet. Chaque langue partage la même disposition et les mêmes formes ; seules les propriétés du texte (contenu, police, taille, alignement) sont remplacées par langue."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ભાષાઓ તમને તમારા પ્રોજેક્ટને ડુપ્લિકેટ કર્યા વિના સ્થાનિક સ્ક્રીનશૉટ સેટ જનરેટ કરવા દે છે. દરેક ભાષા સમાન લેઆઉટ અને આકાર વહેંચે છે; ભાષા દીઠ માત્ર લખાણ ગુણધર્મો (સામગ્રી, ફોન્ટ, કદ, ગોઠવણી) ઓવરરાઇડ થાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שפות מאפשרות לך ליצור ערכות צילומי מסך מקומיות מבלי לשכפל את הפרויקט שלך. כל שפה חולקת את אותה פריסה וצורות; רק מאפייני טקסט (תוכן, גופן, גודל, יישור) מוחקים לכל שפה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भाषाएँ आपको अपने प्रोजेक्ट की नकल किए बिना स्थानीयकृत स्क्रीनशॉट सेट तैयार करने देती हैं। प्रत्येक भाषा समान लेआउट और आकार साझा करती है; प्रति भाषा केवल पाठ गुण (सामग्री, फ़ॉन्ट, आकार, संरेखण) ओवरराइड किए गए हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jezici vam omogućuju generiranje lokaliziranih skupova snimaka zaslona bez dupliciranja vašeg projekta. Svaki jezik dijeli isti raspored i oblike; samo svojstva teksta (sadržaj, font, veličina, poravnanje) nadjačavaju se po jeziku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nyelvek segítségével lokalizált képernyőkép-készleteket hozhat létre a projekt megkettőzése nélkül. Minden nyelvnek ugyanaz az elrendezése és alakja; nyelvenként csak a szövegtulajdonságok (tartalom, betűtípus, méret, igazítás) vannak felülírva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahasa memungkinkan Anda membuat kumpulan tangkapan layar yang dilokalkan tanpa menduplikasi proyek Anda. Setiap bahasa memiliki tata letak dan bentuk yang sama; hanya properti teks (konten, font, ukuran, perataan) yang diganti per bahasa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語を使用すると、プロジェクトを複製せずにローカライズされたスクリーンショット セットを生成できます。各言語は同じレイアウトと形状を共有します。テキスト プロパティ (コンテンツ、フォント、サイズ、配置) のみが言語ごとにオーバーライドされます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಪ್ರಾಜೆಕ್ಟ್ ಅನ್ನು ನಕಲು ಮಾಡದೆಯೇ ಸ್ಥಳೀಯ ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ಸೆಟ್‌ಗಳನ್ನು ರಚಿಸಲು ಭಾಷೆಗಳು ನಿಮಗೆ ಅವಕಾಶ ಮಾಡಿಕೊಡುತ್ತವೆ. ಪ್ರತಿಯೊಂದು ಭಾಷೆಯು ಒಂದೇ ವಿನ್ಯಾಸ ಮತ್ತು ಆಕಾರಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳುತ್ತದೆ; ಪಠ್ಯ ಗುಣಲಕ್ಷಣಗಳನ್ನು ಮಾತ್ರ (ವಿಷಯ, ಫಾಂಟ್, ಗಾತ್ರ, ಜೋಡಣೆ) ಪ್ರತಿ ಭಾಷೆಗೆ ಅತಿಕ್ರಮಿಸಲಾಗಿದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언어를 사용하면 프로젝트를 복제하지 않고도 현지화된 스크린샷 세트를 생성할 수 있습니다. 각 언어는 동일한 레이아웃과 모양을 공유합니다. 언어별로 텍스트 속성(내용, 글꼴, 크기, 정렬)만 재정의됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ പ്രോജക്റ്റ് ഡ്യൂപ്ലിക്കേറ്റ് ചെയ്യാതെ തന്നെ പ്രാദേശികവൽക്കരിച്ച സ്ക്രീൻഷോട്ട് സെറ്റുകൾ സൃഷ്ടിക്കാൻ ഭാഷകൾ നിങ്ങളെ അനുവദിക്കുന്നു. ഓരോ ഭാഷയും ഒരേ രൂപവും രൂപവും പങ്കിടുന്നു; ഓരോ ഭാഷയിലും ടെക്സ്റ്റ് പ്രോപ്പർട്ടികൾ (ഉള്ളടക്കം, ഫോണ്ട്, വലുപ്പം, വിന്യാസം) മാത്രം അസാധുവാക്കുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",

    "File coordination (`NSFileCoordinator`) prevents corruption from concurrent reads/writes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateikoordination (`NSFileCoordinator`) verhindert Beschädigungen durch gleichzeitige Lese- und Schreibzugriffe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coordinación de archivos (`NSFileCoordinator`) evita la corrupción por lecturas/escrituras simultáneas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هماهنگی فایل (`NSFileCoordinator`) از خرابی ناشی از خواندن و نوشتن هم‌زمان جلوگیری می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coordination des fichiers (`NSFileCoordinator`) empêche la corruption due aux lectures/écritures simultanées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coordinazione dei file (`NSFileCoordinator`) impedisce il danneggiamento dovuto a letture/scritture simultanee."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイル協調 (`NSFileCoordinator`) により、同時の読み書きによるファイルの破損を防ぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 조정(`NSFileCoordinator`)은 동시 읽기/쓰기로 인한 손상을 방지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A coordenação de arquivos (`NSFileCoordinator`) evita corrupção de leituras/gravações simultâneas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Координация файлов (`NSFileCoordinator`) предотвращает повреждение данных при одновременном чтении и записи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya koordinasyonu (`NSFileCoordinator`), eşzamanlı okuma/yazma işlemlerinden kaynaklanan bozulmaları önler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Координація файлів (`NSFileCoordinator`) запобігає пошкодженню через одночасне читання й запис."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件协调（`NSFileCoordinator`）可防止并发读/写造成的损坏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檔案協調（`NSFileCoordinator`）可防止同時讀寫造成的損毀。"
          }
        }
      }
    },
    "File names are zero-padded (`01_…`, `02_…`) so they sort correctly when uploaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateinamen haben führende Nullen (`01_…`, `02_…`), damit sie beim Hochladen richtig sortiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres de archivo llevan ceros a la izquierda (`01_…`, `02_…`) para que se ordenen correctamente al subirlos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام فایل‌ها با صفر آغازین شماره‌گذاری می‌شوند (`01_…`، `02_…`) تا هنگام آپلود درست مرتب شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms de fichiers sont complétés par des zéros (`01_…`, `02_…`) afin d'être triés correctement lors de l'envoi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nomi dei file hanno zeri iniziali (`01_…`, `02_…`) così vengono ordinati correttamente al caricamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイル名はゼロ埋めされる (`01_…`、`02_…`) ため、アップロード時に正しい順序で並びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 이름은 0으로 채워져(`01_…`, `02_…`) 업로드 시 올바르게 정렬됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os nomes dos arquivos têm zeros à esquerda (`01_…`, `02_…`) para ficarem na ordem certa ao serem enviados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имена файлов дополняются нулями (`01_…`, `02_…`), чтобы при загрузке они сортировались правильно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

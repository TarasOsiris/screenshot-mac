          }
        }
      }
    },
    "Click **Upload to App Store Connect…** from the export menu. Screenshot Bro renders the selected screenshots directly from the project." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke im Exportmenü auf **In App Store Connect hochladen…**. Screenshot Bro rendert die ausgewählten Screenshots direkt aus dem Projekt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en **Subir a App Store Connect…** en el menú de exportación. Screenshot Bro renderiza las capturas seleccionadas directamente desde el proyecto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از منوی صدور، روی **آپلود در App Store Connect…** کلیک کنید. Screenshot Bro اسکرین‌شات‌های انتخاب‌شده را مستقیماً از پروژه رندر می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur **Envoyer vers App Store Connect…** dans le menu d'exportation. Screenshot Bro génère les captures d'écran sélectionnées directement à partir du projet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su **Carica su App Store Connect…** dal menu di esportazione. Screenshot Bro genera gli screenshot selezionati direttamente dal progetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き出しメニューから **App Store Connect にアップロード…** をクリックします。Screenshot Bro は、選択したスクリーンショットをプロジェクトから直接レンダリングします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내보내기 메뉴에서 **App Store Connect에 업로드…** 항목을 클릭하세요. Screenshot Bro가 선택한 스크린샷을 프로젝트에서 직접 렌더링합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em **Enviar para App Store Connect…** no menu de exportação. O Screenshot Bro renderiza as capturas de tela selecionadas diretamente do projeto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите **Загрузить в App Store Connect…** в меню экспорта. Screenshot Bro отрисует выбранные скриншоты прямо из проекта."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dışa aktarma menüsünden **App Store Connect'e Yükle…** seçeneğine tıklayın. Screenshot Bro seçili ekran görüntülerini doğrudan projeden oluşturur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть **Вивантажити в App Store Connect…** у меню експорту. Screenshot Bro рендерить вибрані знімки екрана безпосередньо з проєкту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从导出菜单中点按 **上传至 App Store Connect…**。Screenshot Bro 会直接从项目渲染所选截图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從輸出選單中按一下**上傳至 App Store Connect…**。Screenshot Bro 會直接從專案轉譯所選的螢幕截圖。"
          }
        }
      }
    },
    "Click a shape to select it. **Shift-click** to add to or remove from the selection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf eine Form, um sie auszuwählen. **Klicken mit gedrückter Umschalttaste** fügt sie der Auswahl hinzu oder entfernt sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en una forma para seleccionarla. **Mayúsculas + clic** la añade a la selección o la quita."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای انتخاب یک شکل روی آن کلیک کنید. با **Shift-کلیک** آن را به انتخاب اضافه یا از آن حذف کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur une forme pour la sélectionner. **Maj-clic** pour l'ajouter à la sélection ou l'en retirer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su una forma per selezionarla. **Maiuscole-clic** per aggiungerla o rimuoverla dalla selezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "図形をクリックして選択します。**Shift キーを押しながらクリック** すると、選択に追加したり選択から外したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도형을 클릭하여 선택하세요. **Shift 키를 누른 채 클릭**하면 선택 항목에 추가하거나 제거할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em uma forma para selecioná-la. **Clique com a tecla Shift pressionada** para adicionar ou remover da seleção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите фигуру, чтобы выбрать ее. **Нажатие с Shift** добавляет ее к выделению или убирает из него."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir şekli seçmek için üzerine tıklayın. Seçime eklemek veya seçimden çıkarmak için **Shift ile tıklayın**."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацніть фігуру, щоб вибрати її. **Клацання з Shift** додає до вибору або вилучає з нього."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按形状即可将其选中。**按住 Shift 键点按** 可将其添加到所选内容或从中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下形狀即可選取。**按住 Shift 並按一下**可將其加入選取範圍或從中移除。"
          }
        }
      }
    },

    "%lld screenshots must be removed first to stay within Apple's 10-screenshot limit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Screenshots müssen zuerst entfernt werden, um Apples Limit von 10 Screenshots einzuhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero se deben eliminar %lld capturas para respetar el límite de 10 capturas de Apple."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای ماندن در سقف ۱۰ اسکرین‌شات اپل، ابتدا باید %1$lld اسکرین‌شات حذف شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld captures d'écran doivent d'abord être supprimées pour respecter la limite de 10 captures d'écran d'Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Occorre prima rimuovere %lld screenshot per rispettare il limite di 10 screenshot di Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple の10枚制限内に収めるには、先に%1$lld枚のスクリーンショットを削除する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple의 스크린샷 10개 제한을 지키려면 먼저 스크린샷 %lld개를 제거해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld capturas de tela precisam ser removidas primeiro para ficar dentro do limite de 10 capturas de tela da Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала нужно удалить скриншоты (%lld), чтобы уложиться в лимит Apple в 10 скриншотов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple'ın 10 ekran görüntüsü sınırında kalmak için önce %lld ekran görüntüsünün kaldırılması gerekiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб не перевищити ліміт Apple у 10 знімків екрана, спершу потрібно вилучити зайві знімки (%lld)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必须先移除 %lld 张截图，才能符合 Apple 的 10 张截图上限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

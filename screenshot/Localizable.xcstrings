    },
    "Connect your App Store Connect API key once and Screenshot Bro can upload exported screenshots to a specific app version without leaving the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließen Sie Ihren App Store Connect API-Schlüssel einmal an und Screenshot Bro kann exportierte Screenshots in eine bestimmte App-Version hochladen, ohne die App zu verlassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte su clave App Store Connect API una vez y Screenshot Bro podrá cargar capturas de pantalla exportadas a una versión específica de la aplicación sin salir de la aplicación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلید App Store Connect API خود را یک بار وصل کنید و Screenshot Bro می‌تواند عکس‌های صفحه‌نمایش صادر شده را بدون خروج از برنامه به نسخه خاصی از برنامه آپلود کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez votre clé App Store Connect API une fois et Screenshot Bro pourra télécharger des captures d'écran exportées vers une version d'application spécifique sans quitter l'application."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect API キーを一度接続すると、Screenshot Bro はアプリを離れることなく、エクスポートされたスクリーンショットを特定のアプリのバージョンにアップロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect API 키를 한 번 연결하면 Screenshot Bro은(는) 앱을 종료하지 않고도 내보낸 스크린샷을 특정 앱 버전에 업로드할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte sua chave App Store Connect API uma vez e Screenshot Bro poderá fazer upload de capturas de tela exportadas para uma versão específica do aplicativo sem sair do aplicativo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接一次 App Store Connect API 键，Screenshot Bro 无需离开应用程序即可将导出的屏幕截图上传到特定应用程序版本。"
          }
        }
      }

      }
    },
    "Click **Export** in the toolbar to render the current project to PNG." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر **تصدير** في شريط الأدوات لعرض المشروع الحالي إلى PNG."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feu clic a **Exporta** a la barra d'eines per representar el projecte actual a PNG."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknutím na **Exportovat** na panelu nástrojů vykreslíte aktuální projekt do PNG."
          }
        },
        "da" : {
          "stringUnit" : {

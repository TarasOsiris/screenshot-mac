        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരു ഇമേജ് ക്രോപ്പ് ചെയ്യുമ്പോൾ, പകരം അമ്പടയാള കീകൾ അതിൻ്റെ ഫ്രെയിമിനുള്ളിൽ ചിത്രം നീക്കുന്നു."

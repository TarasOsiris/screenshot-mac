        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Les modifications déjà apportées dans App Store Connect n'ont pas été annulées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Le modifiche già apportate in App Store Connect non sono state annullate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ App Store Connect ですでに行われた変更は元に戻されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ App Store Connect에 이미 적용된 변경 사항은 되돌려지지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

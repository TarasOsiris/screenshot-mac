    "Text content and styling, image replacements, and position/size adjustments can differ by language. Shared properties such as colors and device choices are edited in the base language." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن أن يختلف محتوى النص والتصميم وبدائل الصور وتعديلات الموضع/الحجم باختلاف اللغة. يتم تحرير الخصائص المشتركة مثل الألوان واختيارات الأجهزة باللغة الأساسية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পাঠ্য বিষয়বস্তু এবং স্টাইলিং, চিত্র প্রতিস্থাপন, এবং অবস্থান/আকার সমন্বয় ভাষা দ্বারা পৃথক হতে পারে। ভাগ করা বৈশিষ্ট্য যেমন রঙ এবং ডিভাইস পছন্দ বেস ভাষায় সম্পাদনা করা হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contingut i l'estil del text, les substitucions d'imatges i els ajustaments de posició/mida poden variar segons l'idioma. Les propietats compartides, com ara els colors i les opcions del dispositiu, s'editen a l'idioma base."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textový obsah a styly, nahrazování obrázků a úpravy pozice/velikosti se mohou lišit podle jazyka. Sdílené vlastnosti, jako jsou barvy a volby zařízení, se upravují v základním jazyce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstindhold og stil, billederstatninger og positions-/størrelsesjusteringer kan variere fra sprog til sprog. Delte egenskaber såsom farver og enhedsvalg redigeres i basissproget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textinhalt und -stil, Bildersetzungen und Positions-/Größenanpassungen können je nach Sprache unterschiedlich sein. Gemeinsame Eigenschaften wie Farben und Geräteauswahl werden in der Basissprache bearbeitet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το περιεχόμενο και το στυλ κειμένου, οι αντικαταστάσεις εικόνας και οι προσαρμογές θέσης/μεγέθους μπορεί να διαφέρουν ανάλογα με τη γλώσσα. Οι κοινόχρηστες ιδιότητες όπως τα χρώματα και οι επιλογές συσκευής επεξεργάζονται στη βασική γλώσσα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido y el estilo del texto, los reemplazos de imágenes y los ajustes de posición/tamaño pueden diferir según el idioma. Las propiedades compartidas, como los colores y las opciones de dispositivos, se editan en el idioma base."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محتوا و سبک متن، جایگزینی تصاویر و تنظیم موقعیت/اندازه می‌توانند در هر زبان متفاوت باشند. ویژگی‌های مشترک مانند رنگ‌ها و انتخاب دستگاه در زبان پایه ویرایش می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstin sisältö ja tyyli, kuvien vaihdot ja sijainnin/koon säädöt voivat vaihdella kielen mukaan. Jaettuja ominaisuuksia, kuten värejä ja laitevalintoja, muokataan peruskielellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu et le style du texte, les remplacements d'images et les ajustements de position/taille peuvent différer selon la langue. Les propriétés partagées, comme les couleurs et le choix des appareils, se modifient dans la langue de base."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ટેક્સ્ટ સામગ્રી અને સ્ટાઇલ, ઇમેજ રિપ્લેસમેન્ટ અને પોઝિશન/સાઇઝ એડજસ્ટમેન્ટ ભાષા દ્વારા અલગ હોઈ શકે છે. વહેંચાયેલ ગુણધર્મો જેમ કે રંગો અને ઉપકરણ પસંદગીઓ મૂળભૂત ભાષામાં સંપાદિત થાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תוכן וסגנון טקסט, החלפת תמונות והתאמת מיקום/גודל יכולים להיות שונים לפי שפה. מאפיינים משותפים כגון צבעים ובחירות מכשירים נערכים בשפת הבסיס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पाठ सामग्री और शैली, छवि प्रतिस्थापन, और स्थिति/आकार समायोजन भाषा के अनुसार भिन्न हो सकते हैं। रंग और डिवाइस विकल्प जैसे साझा गुण मूल भाषा में संपादित किए जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstualni sadržaj i stil, zamjene slika i prilagodbe položaja/veličine mogu se razlikovati ovisno o jeziku. Zajednička svojstva poput boja i izbora uređaja uređuju se na osnovnom jeziku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szövegtartalom és -stílus, a képcsere, valamint a pozíció/méret beállítása nyelvenként eltérő lehet. A megosztott tulajdonságok, például a színek és az eszközválasztások az alapnyelven szerkeszthetők."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konten dan gaya teks, penggantian gambar, dan penyesuaian posisi/ukuran dapat berbeda menurut bahasa. Properti bersama seperti warna dan pilihan perangkat diedit dalam bahasa dasar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contenuto e stile del testo, immagini sostituite e regolazioni di posizione/dimensioni possono variare per lingua. Le proprietà condivise, come i colori e la scelta dei dispositivi, si modificano nella lingua di base."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストの内容とスタイル、画像の差し替え、位置とサイズの調整は、言語ごとに変えられます。色やデバイスの選択など共通のプロパティは、基本言語で編集します。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪಠ್ಯ ವಿಷಯ ಮತ್ತು ಸ್ಟೈಲಿಂಗ್, ಚಿತ್ರದ ಬದಲಿಗಳು ಮತ್ತು ಸ್ಥಾನ/ಗಾತ್ರದ ಹೊಂದಾಣಿಕೆಗಳು ಭಾಷೆಯಿಂದ ಭಿನ್ನವಾಗಿರಬಹುದು. ಬಣ್ಣಗಳು ಮತ್ತು ಸಾಧನದ ಆಯ್ಕೆಗಳಂತಹ ಹಂಚಿಕೆಯ ಗುಣಲಕ್ಷಣಗಳನ್ನು ಮೂಲ ಭಾಷೆಯಲ್ಲಿ ಸಂಪಾದಿಸಲಾಗಿದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 내용과 스타일, 이미지 교체, 위치/크기 조정은 언어마다 다르게 할 수 있습니다. 색상이나 기기 선택 같은 공유 속성은 기본 언어에서 편집합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ടെക്‌സ്‌റ്റ് ഉള്ളടക്കവും സ്റ്റൈലിംഗും, ഇമേജ് റീപ്ലേസ്‌മെൻ്റുകളും, പൊസിഷൻ/സൈസ് അഡ്ജസ്റ്റ്‌മെൻ്റുകളും ഭാഷ അനുസരിച്ച് വ്യത്യാസപ്പെടാം. വർണ്ണങ്ങളും ഉപകരണ തിരഞ്ഞെടുപ്പുകളും പോലുള്ള പങ്കിട്ട പ്രോപ്പർട്ടികൾ അടിസ്ഥാന ഭാഷയിൽ എഡിറ്റ് ചെയ്യപ്പെടുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मजकूर सामग्री आणि शैली, प्रतिमा बदलणे आणि स्थान/आकार समायोजन भाषेनुसार भिन्न असू शकतात. सामायिक गुणधर्म जसे की रंग आणि डिव्हाइस निवडी मूलभूत भाषेत संपादित केल्या जातात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kandungan dan gaya teks, penggantian imej dan pelarasan kedudukan/saiz boleh berbeza mengikut bahasa. Sifat yang dikongsi seperti warna dan pilihan peranti diedit dalam bahasa asas."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstinhoud en stijl, vervanging van afbeeldingen en aanpassingen aan de positie/grootte kunnen per taal verschillen. Gedeelde eigenschappen zoals kleuren en apparaatkeuzes worden in de basistaal bewerkt."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstinnhold og stil, bildeerstatninger og posisjons-/størrelsesjusteringer kan variere etter språk. Delte egenskaper som farger og enhetsvalg redigeres i basisspråket."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treść i styl tekstu, zastępowanie obrazów oraz dostosowywanie położenia/rozmiaru mogą różnić się w zależności od języka. Wspólne właściwości, takie jak kolory i wybór urządzeń, są edytowane w języku podstawowym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O conteúdo e o estilo do texto, as substituições de imagens e os ajustes de posição/tamanho podem variar de acordo com o idioma. Propriedades compartilhadas, como cores e opções de dispositivos, são editadas no idioma base."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O conteúdo e o estilo do texto, as substituições de imagens e os definições de posição/tamanho podem variar de acordo com o idioma. Propriedades compartilhadas, como cores e opções de dispositivos, são editadas no idioma base."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conținutul textului și stilul, înlocuirile de imagini și ajustările de poziție/dimensiune pot diferi în funcție de limbă. Proprietățile partajate, cum ar fi culorile și opțiunile de dispozitiv, sunt editate în limba de bază."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текст и его стиль, замена изображений, а также положение и размер могут отличаться для разных языков. Общие свойства, такие как цвета и выбор устройства, редактируются в базовом языке."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textový obsah a štýl, nahradenie obrázkov a úpravy polohy/veľkosti sa môžu líšiť v závislosti od jazyka. Zdieľané vlastnosti, ako sú farby a voľby zariadenia, sa upravujú v základnom jazyku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besedilna vsebina in slog, zamenjave slik in prilagoditve položaja/velikosti se lahko razlikujejo glede na jezik. Lastnosti v skupni rabi, kot so barve in izbire naprav, se urejajo v osnovnem jeziku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textinnehåll och stil, bildersättningar och positions-/storleksjusteringar kan skilja sig åt beroende på språk. Delade egenskaper som färger och enhetsval redigeras i basspråket."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உரை உள்ளடக்கம் மற்றும் ஸ்டைலிங், பட மாற்றீடுகள் மற்றும் நிலை/அளவு சரிசெய்தல் ஆகியவை மொழியால் வேறுபடலாம். வண்ணங்கள் மற்றும் சாதனத் தேர்வுகள் போன்ற பகிரப்பட்ட பண்புகள் அடிப்படை மொழியில் திருத்தப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "టెక్స్ట్ కంటెంట్ మరియు స్టైలింగ్, ఇమేజ్ రీప్లేస్‌మెంట్‌లు మరియు పొజిషన్/సైజ్ సర్దుబాట్లు భాష ఆధారంగా మారవచ్చు. రంగులు మరియు పరికర ఎంపికల వంటి భాగస్వామ్య లక్షణాలు మూల భాషలో సవరించబడతాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เนื้อหาข้อความและการจัดรูปแบบ การเปลี่ยนรูปภาพ และการปรับตำแหน่ง/ขนาดอาจแตกต่างกันไปตามภาษา คุณสมบัติที่ใช้ร่วมกัน เช่น สีและตัวเลือกอุปกรณ์ได้รับการแก้ไขในภาษาพื้นฐาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metin içeriği ve stili, görüntü değişimleri ve konum/boyut ayarlamaları dile göre farklı olabilir. Renkler ve aygıt seçimleri gibi ortak özellikler temel dilde düzenlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текст і його стиль, заміна зображень і коригування положення / розміру можуть відрізнятися для кожної мови. Спільні властивості, як-от кольори та вибір пристроїв, редагуються в базовій мові."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متن کا مواد اور اسٹائل، تصویر کی تبدیلی، اور پوزیشن/سائز ایڈجسٹمنٹ زبان کے لحاظ سے مختلف ہو سکتے ہیں۔ مشترکہ خصوصیات جیسے رنگ اور ڈیوائس کے انتخاب کو بنیادی زبان میں ترمیم کیا جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nội dung và kiểu dáng văn bản, thay thế hình ảnh và điều chỉnh vị trí/kích thước có thể khác nhau tùy theo ngôn ngữ. Các thuộc tính chung như màu sắc và lựa chọn thiết bị được chỉnh sửa bằng ngôn ngữ cơ sở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文本内容和样式、图像替换以及位置/尺寸调整可以因语言而异。颜色和设备选择等共享属性需在基准语言中编辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字內容和樣式、影像替換，以及位置／大小調整可以因語言而異。顏色和裝置選擇等共用屬性則在基準語言中編輯。"
          }
        }
      }
    },

    "App Store Connect rejects this if the selected app version is iPhone-only." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect rebutja això si la versió de l'aplicació seleccionada només és iPhone."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect afviser dette, hvis den valgte appversion kun er iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect lehnt das ab, wenn die ausgewählte App-Version nur für iPhone ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect lo rechaza si la versión seleccionada es solo para iPhone."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر نسخه برنامه انتخابی فقط iPhone باشد، App Store Connect این را رد می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect hylkää tämän, jos valittu sovellusversio on vain iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect refuse ce type si la version sélectionnée de l'app est réservée à l'iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect lo rifiuta se la versione dell'app selezionata è solo per iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したアプリのバージョンが iPhone のみの場合、App Store Connect はこれを拒否します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 앱 버전이 iPhone 전용이면 App Store Connect에서 거부됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect wijst dit af als de geselecteerde app-versie alleen iPhone is."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect avviser dette hvis den valgte appversjonen er iPhone-bare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect rejeitará isso se a versão do aplicativo selecionada for somente iPhone."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect rejeitará isso se a versão do aplicativo selecionada for somente iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect отклонит это, если выбранная версия приложения только для iPhone."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

    "Version %@ is %@ — metadata can't be changed. Pick an editable version or create a new one in App Store Connect." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإصدار %1$@ هو %2$@ — لا يمكن تغيير البيانات التعريفية. اختر نسخة قابلة للتحرير أو أنشئ نسخة جديدة في App Store Connect."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versió %1$@ és %2$@: les metadades no es poden canviar. Trieu una versió editable o creeu-ne una de nova a App Store Connect."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verze %1$@ je %2$@ – metadata nelze změnit. Vyberte upravitelnou verzi nebo vytvořte novou v App Store Connect."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %1$@ er %2$@ — metadata kan ikke ændres. Vælg en redigerbar version, eller opret en ny i App Store Connect."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %1$@ ist %2$@ – Metadaten können nicht geändert werden. Wähle eine bearbeitbare Version oder erstelle eine neue in App Store Connect."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η έκδοση %1$@ είναι %2$@ — τα μεταδεδομένα δεν μπορούν να αλλάξουν. Επιλέξτε μια επεξεργάσιμη έκδοση ή δημιουργήστε μια νέα στο App Store Connect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versión %1$@ está en estado %2$@: los metadatos no se pueden cambiar. Elige una versión editable o crea una nueva en App Store Connect."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخهٔ %1$@ در وضعیت %2$@ است — فراداده قابل تغییر نیست. یک نسخهٔ قابل ویرایش انتخاب کنید یا در App Store Connect نسخهٔ جدیدی ایجاد کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versio %1$@ on %2$@ — metatietoja ei voi muuttaa. Valitse muokattava versio tai luo uusi kohdassa App Store Connect."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version %1$@ est à l'état « %2$@ » — ses métadonnées ne peuvent pas être modifiées. Choisissez une version modifiable ou créez-en une dans App Store Connect."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרסה %1$@ היא %2$@ - לא ניתן לשנות מטא נתונים. בחר גרסה הניתנת לעריכה או צור גרסה חדשה ב-App Store Connect."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzija %1$@ je %2$@ — metapodaci se ne mogu mijenjati. Odaberite verziju koju je moguće uređivati ​​ili izradite novu u App Store Connect."

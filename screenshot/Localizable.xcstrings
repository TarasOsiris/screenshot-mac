          "stringUnit" : {
            "state" : "translated",
            "value" : "নির্বাচিত অ্যাপ সংস্করণটি শুধুমাত্র iPhone হলে App Store Connect এটি প্রত্যাখ্যান করে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect rebutja això si la versió de l'aplicació seleccionada només és iPhone."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect to odmítne, pokud je vybraná verze aplikace pouze iPhone."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect afviser dette, hvis den valgte appversion kun er iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect lehnt das ab, wenn die ausgewählte App-Version nur für iPhone ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο App Store Connect το απορρίπτει εάν η επιλεγμένη έκδοση εφαρμογής είναι μόνο iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

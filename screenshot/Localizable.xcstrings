    "New shapes are placed at the center of the active template and immediately selected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Formen werden in der Mitte der aktiven Vorlage platziert und sofort ausgewählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las nuevas formas se colocan en el centro de la plantilla activa y se seleccionan inmediatamente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشکال جدید در مرکز الگوی فعال قرار می گیرند و بلافاصله انتخاب می شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles formes sont placées au centre du modèle actif et immédiatement sélectionnées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nuove forme vengono posizionate al centro del modello attivo e selezionate immediatamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい図形はアクティブなテンプレートの中心に配置され、すぐに選択されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 모양이 활성 템플릿의 중앙에 배치되고 즉시 선택됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novas formas são colocadas no centro do modelo ativo e selecionadas imediatamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые фигуры размещаются в центре активного шаблона и сразу выбираются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

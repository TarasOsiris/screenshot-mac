          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузка отменена. Черновик правки удален."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yükleme iptal edildi. Taslak düzenleme silindi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вивантаження скасовано. Чернетку редагування відкинуто."

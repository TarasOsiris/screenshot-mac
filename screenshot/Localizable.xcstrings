    "Drag a row's header to reorder. Use **⌘D** to duplicate a selected row, or use the row header/menu actions." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب رأس الصف لإعادة ترتيبه. استخدم **⌘D** لتكرار صف محدد، أو استخدم إجراءات رأس الصف/القائمة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrossegueu la capçalera d'una fila per reordenar. Utilitzeu **⌘D** per duplicar una fila seleccionada o utilitzeu les accions de la capçalera/menú de la fila."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přetažením záhlaví řádku změníte pořadí. Pomocí **⌘D** duplikujte vybraný řádek nebo použijte akce záhlaví řádku/nabídky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk en rækkes overskrift for at omarrangere. Brug **⌘D** til at duplikere en valgt række, eller brug rækkeoverskriften/menuhandlingerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen Sie die Kopfzeile einer Zeile, um sie neu anzuordnen. Verwenden Sie **⌘D**, um eine ausgewählte Zeile zu duplizieren, oder verwenden Sie die Zeilenkopf-/Menüaktionen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε την κεφαλίδα μιας σειράς για αναδιάταξη. Χρησιμοποιήστε το **⌘D** για να αντιγράψετε μια επιλεγμένη σειρά ή χρησιμοποιήστε τις ενέργειες κεφαλίδας/μενού γραμμής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastre el encabezado de una fila para reordenar. Utilice **⌘D** para duplicar una fila seleccionada, o utilice las acciones del menú/encabezado de fila."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای مرتب کردن مجدد سرصفحه یک ردیف را بکشید. از **⌘D** برای کپی کردن یک ردیف انتخابی استفاده کنید، یا از عملکردهای سرصفحه/منوی ردیف استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järjestä uudelleen vetämällä rivin otsikkoa. Käytä **⌘D** monistaaksesi valitun rivin tai käytä rivin otsikko-/valikkotoimintoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser l'en-tête d'une ligne pour la réorganiser. Utilisez **⌘D** pour dupliquer une ligne sélectionnée ou utilisez les actions d'en-tête de ligne/de menu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרור כותרת של שורה כדי לסדר מחדש. השתמש ב-**⌘D** כדי לשכפל שורה שנבחרה, או השתמש בפעולות כותרת/תפריט של השורה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povucite zaglavlje retka da promijenite redoslijed. Upotrijebite **⌘D** za dupliciranje odabranog retka ili upotrijebite radnje zaglavlja retka/izbornika."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az átrendezéshez húzza egy sor fejlécét. Használja a **⌘D** billentyűt egy kiválasztott sor megkettőzéséhez, vagy használja a sorfejléc/menüműveleteket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret header baris untuk menyusun ulang. Gunakan **⌘D** untuk menduplikasi baris yang dipilih, atau gunakan tindakan header/menu baris."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行のヘッダーをドラッグして並べ替えます。 **⌘D** を使用して選択した行を複製するか、行ヘッダー/メニュー アクションを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재정렬하려면 행 헤더를 드래그하세요. **⌘D**를 사용하여 선택한 행을 복제하거나 행 헤더/메뉴 작업을 사용하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret pengepala baris untuk menyusun semula. Gunakan **⌘D** untuk menduplikasi baris yang dipilih atau gunakan tindakan pengepala baris/menu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep de kop van een rij om de volgorde te wijzigen. Gebruik **⌘D** om een ​​geselecteerde rij te dupliceren, of gebruik de rijkop-/menuacties."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra overskriften på en rad for å omorganisere. Bruk **⌘D** for å duplisere en valgt rad, eller bruk radoverskriften/menyhandlingene."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij nagłówek wiersza, aby zmienić jego kolejność. Użyj **⌘D**, aby zduplikować wybrany wiersz lub użyj nagłówka/menu wiersza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste o cabeçalho de uma linha para reordenar. Use **⌘D** para duplicar uma linha selecionada ou use o cabeçalho da linha/ações do menu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste o cabeçalho de uma linha para reordenar. Use **⌘D** para duplicar uma linha selecionada ou use o cabeçalho da linha/ações do menu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trageți antetul unui rând pentru a reordona. Utilizați **⌘D** pentru a duplica un rând selectat sau utilizați antetul rândului/acțiunile din meniu."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presunutím hlavičky riadka zmeníte poradie. Pomocou **⌘D** duplikujte vybratý riadok alebo použite akcie hlavičky riadka/ponuky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če želite preurediti, povlecite glavo vrstice. Uporabite **⌘D** za podvojitev izbrane vrstice ali uporabite dejanja glave vrstice/menija."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra en rads rubrik för att ändra ordning. Använd **⌘D** för att duplicera en vald rad, eller använd radrubriken/menyåtgärderna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลากส่วนหัวของแถวเพื่อเรียงลำดับใหม่ ใช้ **⌘D** เพื่อทำซ้ำแถวที่เลือก หรือใช้การดำเนินการกับส่วนหัวของแถว/เมนู"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوبارہ ترتیب دینے کے لیے قطار کے ہیڈر کو گھسیٹیں۔ منتخب قطار کو ڈپلیکیٹ کرنے کے لیے **⌘D** کا استعمال کریں، یا قطار ہیڈر/مینو کی کارروائیوں کا استعمال کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo tiêu đề của hàng để sắp xếp lại. Sử dụng **⌘D** để sao chép một hàng đã chọn hoặc sử dụng các tác vụ trên tiêu đề/menu của hàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动行的标题以重新排序。使用 **⌘D** 复制选定的行，或使用行标题/菜单操作。"
          }
        }
      }
    },

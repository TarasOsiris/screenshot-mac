        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode démo est activé. L'assistant d'envoi utilise des données d'exemple intégrées et ne contacte jamais App Store Connect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità demo è attiva. L'assistente di caricamento usa dati di esempio integrati e non contatta mai App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デモモードがオンです。アップロードウィザードは内蔵のサンプルデータで動作し、App Store Connect には接続しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데모 모드가 켜져 있습니다. 업로드 마법사는 내장된 샘플 데이터에 대해 실행되며 App Store Connect에 연결하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De demomodus is ingeschakeld. De uploadwizard werkt op basis van ingebouwde voorbeeldgegevens en neemt nooit contact op met App Store Connect."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demomodus er på. Opplastingsveiviseren kjører mot innebygde eksempeldata og kontakter aldri App Store Connect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo de demonstração está ativado. O assistente de envio usa dados de exemplo integrados e nunca se conecta ao App Store Connect."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo de demonstração está ativado. O assistente de upload é executado em dados de amostra integrados e nunca entra em contacto com App Store Connect."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Демо-режим включен. Мастер загрузки работает со встроенными примерами данных и никогда не обращается к App Store Connect."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demoläget är på. Uppladdningsguiden körs mot inbyggd exempeldata och kontaktar aldrig App Store Connect."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demo modu açık. Yükleme sihirbazı yerleşik örnek verilerle çalışır ve App Store Connect ile hiçbir zaman iletişim kurmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Демо-режим увімкнено. Помічник вивантаження працює на вбудованих зразкових даних і ніколи не звертається до App Store Connect."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "演示模式已开启。上传向导使用内置示例数据运行，不会连接 App Store Connect。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "示範模式已開啟。上傳精靈會使用內建的範例資料執行，絕不會連線到 App Store Connect。"
          }
        }
      }
    },

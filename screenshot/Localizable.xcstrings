    "Drag a row's header to reorder. Use **⌘D** to duplicate a selected row, or use the row header/menu actions." : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrossegueu la capçalera d'una fila per reordenar. Utilitzeu **⌘D** per duplicar una fila seleccionada o utilitzeu les accions de la capçalera/menú de la fila."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk en rækkes overskrift for at omarrangere. Brug **⌘D** til at duplikere en valgt række, eller brug rækkeoverskriften/menuhandlingerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen Sie die Kopfzeile einer Zeile, um sie neu anzuordnen. Verwenden Sie **⌘D**, um eine ausgewählte Zeile zu duplizieren, oder verwenden Sie die Zeilenkopf-/Menüaktionen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastre el encabezado de una fila para reordenar. Utilice **⌘D** para duplicar una fila seleccionada, o utilice las acciones del menú/encabezado de fila."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای مرتب کردن مجدد سرصفحه یک ردیف را بکشید. از **⌘D** برای کپی کردن یک ردیف انتخابی استفاده کنید، یا از عملکردهای سرصفحه/منوی ردیف استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järjestä uudelleen vetämällä rivin otsikkoa. Käytä **⌘D** monistaaksesi valitun rivin tai käytä rivin otsikko-/valikkotoimintoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser l'en-tête d'une ligne pour la réorganiser. Utilisez **⌘D** pour dupliquer une ligne sélectionnée ou utilisez les actions d'en-tête de ligne/de menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行のヘッダーをドラッグして並べ替えます。 **⌘D** を使用して選択した行を複製するか、行ヘッダー/メニュー アクションを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재정렬하려면 행 헤더를 드래그하세요. **⌘D**를 사용하여 선택한 행을 복제하거나 행 헤더/메뉴 작업을 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep de kop van een rij om de volgorde te wijzigen. Gebruik **⌘D** om een ​​geselecteerde rij te dupliceren, of gebruik de rijkop-/menuacties."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra overskriften på en rad for å omorganisere. Bruk **⌘D** for å duplisere en valgt rad, eller bruk radoverskriften/menyhandlingene."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste o cabeçalho de uma linha para reordenar. Use **⌘D** para duplicar uma linha selecionada ou use o cabeçalho da linha/ações do menu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste o cabeçalho de uma linha para reordenar. Use **⌘D** para duplicar uma linha selecionada ou use o cabeçalho da linha/ações do menu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra en rads rubrik för att ändra ordning. Använd **⌘D** för att duplicera en vald rad, eller använd radrubriken/menyåtgärderna."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动行的标题以重新排序。使用 **⌘D** 复制选定的行，或使用行标题/菜单操作。"
          }
        }
      }
    },

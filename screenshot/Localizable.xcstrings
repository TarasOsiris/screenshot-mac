            "state" : "translated",
            "value" : "**زبان** — تغییر زبان رابط برنامه. نیاز به راه‌اندازی مجدد دارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Kieli** — ohita sovelluksen käyttöliittymän kieli. Vaatii uudelleenkäynnistyksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Langue** : remplace la langue de l'interface de l'app. Nécessite de relancer l'app."
          }
        },
        "it" : {

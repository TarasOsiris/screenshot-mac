        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta prevod uporablja oblikovanje po meri (barve, krepko, velikosti). Tabela ureja samo golo besedilo — uredite ga neposredno na platnu ali Ponastavi za uporabo osnovnega jezika."

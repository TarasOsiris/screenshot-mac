    "Every screenshot currently on the listing for the selected languages and image types is deleted and replaced." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم حذف واستبدال كل لقطة شاشة موجودة حاليًا في القائمة للغات وأنواع الصور المحددة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নির্বাচিত ভাষা এবং ছবির ধরনগুলির জন্য তালিকায় থাকা প্রতিটি স্ক্রিনশট মুছে ফেলা হয়েছে এবং প্রতিস্থাপিত হয়েছে৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se suprimeixen i se substitueixen totes les captures de pantalla de la llista dels idiomes i tipus d'imatge seleccionats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý snímek obrazovky, který je aktuálně v seznamu pro vybrané jazyky a typy obrázků, bude odstraněn a nahrazen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert skærmbillede i øjeblikket på listen for de valgte sprog og billedtyper slettes og erstattes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Screenshot, der derzeit für die ausgewählten Sprachen und Bildtypen im Eintrag liegt, wird gelöscht und ersetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε στιγμιότυπο οθόνης στη λίστα για τις επιλεγμένες γλώσσες και τύπους εικόνων διαγράφεται και αντικαθίσταται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las capturas que haya actualmente en la ficha para los idiomas y tipos de imagen seleccionados se eliminan y se reemplazan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر اسکرین‌شاتی که هم‌اکنون برای زبان‌ها و نوع‌های تصویر انتخاب‌شده در فهرست فروشگاه است حذف و جایگزین می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen luettelossa tällä hetkellä oleva kuvakaappaus valituista kielistä ja kuvatyypeistä poistetaan ja korvataan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les captures d'écran actuellement présentes sur la fiche pour les langues et les types d'image sélectionnés sont supprimées et remplacées."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પસંદ કરેલ ભાષાઓ અને છબી પ્રકારો માટેની સૂચિ પર હાલમાં દરેક સ્ક્રીનશૉટ કાઢી નાખવામાં આવે છે અને બદલવામાં આવે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל צילום מסך שנמצא כרגע ברשימה עבור השפות וסוגי התמונות שנבחרו נמחק ומוחלף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चयनित भाषाओं और छवि प्रकारों की सूची में वर्तमान में मौजूद प्रत्येक स्क्रीनशॉट को हटा दिया गया है और बदल दिया गया है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaka snimka zaslona trenutno na popisu za odabrane jezike i vrste slika briše se i zamjenjuje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiválasztott nyelvekhez és képtípusokhoz jelenleg a listán szereplő összes képernyőkép törlődik és lecserélődik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap tangkapan layar yang saat ini ada dalam daftar untuk bahasa dan jenis gambar yang dipilih akan dihapus dan diganti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti gli screenshot attualmente presenti nella scheda per le lingue e i tipi di immagine selezionati vengono eliminati e sostituiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した言語と画像タイプについて、現在掲載情報にあるスクリーンショットはすべて削除され、置き換えられます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಆಯ್ದ ಭಾಷೆಗಳು ಮತ್ತು ಚಿತ್ರದ ಪ್ರಕಾರಗಳಿಗಾಗಿ ಪ್ರಸ್ತುತ ಪಟ್ಟಿಯಲ್ಲಿರುವ ಪ್ರತಿಯೊಂದು ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ಅನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ಬದಲಾಯಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 언어와 이미지 유형에 대해 현재 스토어 등록정보에 있는 모든 스크린샷이 삭제되고 교체됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "തിരഞ്ഞെടുത്ത ഭാഷകൾക്കും ഇമേജ് തരങ്ങൾക്കുമായി നിലവിൽ ലിസ്‌റ്റിംഗിലുള്ള എല്ലാ സ്‌ക്രീൻഷോട്ടുകളും ഇല്ലാതാക്കുകയും പകരം വയ്ക്കുകയും ചെയ്യുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निवडलेल्या भाषा आणि प्रतिमा प्रकारांसाठी सध्या सूचीवर असलेला प्रत्येक स्क्रीनशॉट हटवला आणि बदलला आहे."

      }
    },
    "Click a shape to select it. **Shift-click** to add to or remove from the selection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie auf eine Form, um sie auszuwählen. **Umschalttaste-Klick**, um etwas zur Auswahl hinzuzufügen oder daraus zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haga clic en una forma para seleccionarla. **Mayús y clic** para agregar o eliminar de la selección."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای انتخاب یک شکل روی آن کلیک کنید. **برای افزودن یا حذف از انتخاب، روی Shift کلیک کنید**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur une forme pour la sélectionner. **Maj-clic** pour ajouter ou supprimer de la sélection."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su una forma per selezionarla. **Maiuscole-clic** per aggiungerla o rimuoverla dalla selezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "図形をクリックして選択します。 **Shift キーを押しながらクリック**して、選択に追加または選択から削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도형을 클릭하여 선택하세요. **Shift 키를 누른 채 클릭**하면 선택 항목에 추가하거나 제거할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em uma forma para selecioná-la. **Clique com a tecla Shift pressionada** para adicionar ou remover da seleção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите фигуру, чтобы выбрать ее. **Нажатие с Shift** добавляет ее к выделению или убирает из него."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir şekli seçmek için üzerine tıklayın. Seçime eklemek veya seçimden çıkarmak için **Shift ile tıklayın**."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацніть фігуру, щоб вибрати її. **Клацання з Shift** додає до вибору або вилучає з нього."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单击一个形状将其选中。 **按住 Shift 键并单击**可添加到所选内容或从所选内容中删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下形狀即可選取。**按住 Shift 並按一下**可將其加入選取範圍或從中移除。"
          }
        }
      }
    },

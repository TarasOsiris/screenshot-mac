        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O RevenueCat está configurado com uma chave de API da Test Store. Substitua-a pela sua chave pública de SDK da Apple antes de publicar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat настроен с ключом API Test Store. Перед выпуском замените его публичным ключом Apple SDK."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat bir Test Store API anahtarıyla yapılandırılmış. Yayımlamadan önce bunu Apple genel SDK anahtarınızla değiştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat налаштовано з ключем API тестового магазину. Перед випуском замініть його своїм публічним ключем SDK для Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

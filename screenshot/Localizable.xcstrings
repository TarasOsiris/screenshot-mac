        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Przycięcie** obrazu może różnić się także w zależności od języka, więc przetłumaczony zrzut ekranu można oprawić samodzielnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O **recorte** de uma imagem também pode variar por idioma, para enquadrar separadamente uma captura traduzida."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O **Corte** de uma imagem também pode diferir de acordo com o idioma, portanto, uma captura de ecrã traduzida pode ser enquadrada sozinha."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Decuparea** unei imagini poate diferi și în funcție de limbă, astfel încât o captură de ecran tradusă poate fi încadrată singură."

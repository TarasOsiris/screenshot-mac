        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বৈশিষ্ট্য বারটি ফন্ট, ওজন, আকার, রঙ, অনুভূমিক এবং উল্লম্ব প্রান্তিককরণ, লাইনের উচ্চতা এবং অক্ষর ব্যবধান দেখায়।"
          }
        },
        "ca" : {
          "stringUnit" : {

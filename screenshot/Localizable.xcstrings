    "File coordination (`NSFileCoordinator`) prevents corruption from concurrent reads/writes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Dateikoordination („NSFileCoordinator“) verhindert Beschädigungen durch gleichzeitige Lese-/Schreibvorgänge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coordinación de archivos (`NSFileCoordinator`) evita la corrupción por lecturas/escrituras simultáneas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هماهنگی فایل (\"NSFileCoordinator\") از خراب شدن خواندن/نوشتن همزمان جلوگیری می کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coordination des fichiers (`NSFileCoordinator`) empêche la corruption due aux lectures/écritures simultanées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coordinazione dei file (`NSFileCoordinator`) impedisce il danneggiamento dovuto a letture/scritture simultanee."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイル調整 (`NSFileCoordinator`) は、同時読み取り/書き込みによる破損を防ぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 조정(`NSFileCoordinator`)은 동시 읽기/쓰기로 인한 손상을 방지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A coordenação de arquivos (`NSFileCoordinator`) evita corrupção de leituras/gravações simultâneas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Координация файлов (`NSFileCoordinator`) предотвращает повреждение данных при одновременном чтении и записи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya koordinasyonu (`NSFileCoordinator`), eşzamanlı okuma/yazma işlemlerinden kaynaklanan bozulmaları önler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Координація файлів (`NSFileCoordinator`) запобігає пошкодженню через одночасне читання й запис."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件协调（`NSFileCoordinator`）可防止并发读/写造成的损坏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檔案協調（`NSFileCoordinator`）可防止同時讀寫造成的損毀。"
          }
        }
      }
    },
    "File names are zero-padded (`01_…`, `02_…`) so they sort correctly when uploaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateinamen werden mit Nullen aufgefüllt („01_…“, „02_…“), sodass sie beim Hochladen korrekt sortiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres de los archivos tienen relleno con ceros (`01_…`, `02_…`) para que se ordenen correctamente cuando se cargan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام فایل‌ها دارای لایه صفر هستند ('01_…', '02_…') بنابراین هنگام آپلود به درستی مرتب می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms de fichiers sont complétés par des zéros (`01_…`, `02_…`) afin qu'ils soient triés correctement lors du téléchargement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nomi dei file hanno zeri iniziali (`01_…`, `02_…`) così vengono ordinati correttamente al caricamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイル名にはゼロが埋め込まれている (`01_…`、`02_…`) ため、アップロード時に正しく並べ替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 이름은 0으로 채워져(`01_…`, `02_…`) 업로드 시 올바르게 정렬됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os nomes dos arquivos são preenchidos com zeros (`01_…`, `02_…`) para que sejam classificados corretamente quando carregados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имена файлов дополняются нулями (`01_…`, `02_…`), чтобы при загрузке они сортировались правильно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya adları sıfırla doldurulur (`01_…`, `02_…`); böylece yüklendiklerinde doğru sıralanırlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Імена файлів доповнюються нулями (`01_…`, `02_…`), тож після вивантаження вони сортуються правильно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件名以零填充（`01_...`、`02_...`），以便上传时正确排序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檔名會補零（`01_…`、`02_…`），以便上傳時能正確排序。"
          }
        }
      }
    },

    "Export finished, but %lld %@ could not be read, so those device frames are blank. Check the canvas before uploading." : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'ha acabat l'exportació, però no s'ha pogut llegir %1$lld %2$@, de manera que aquests marcs del dispositiu estan en blanc. Comproveu el llenç abans de pujar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksporten er afsluttet, men %1$lld %2$@ kunne ikke læses, så disse enhedsrammer er tomme. Tjek lærredet før upload."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Export ist abgeschlossen, aber %1$lld %2$@ konnte nicht gelesen werden, daher sind diese Geräterahmen leer. Überprüfen Sie die Leinwand vor dem Hochladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La exportación finalizó, pero %1$lld %2$@ no se pudo leer, por lo que los marcos de esos dispositivos están en blanco. Verifique el lienzo antes de cargarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صادرات تمام شد، اما %1$lld %2$@ خوانده نشد، بنابراین آن قاب‌های دستگاه خالی هستند. قبل از آپلود بوم را بررسی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vienti on valmis, mutta %1$lld %2$@ ei voitu lukea, joten laitekehykset ovat tyhjiä. Tarkista kangas ennen lataamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'exportation est terminée, mais %1$lld %2$@ n'a pas pu être lu, ces cadres de périphérique sont donc vides. Vérifiez le canevas avant de télécharger."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エクスポートは完了しましたが、%1$lld %2$@ を読み取れなかったため、これらのデバイス フレームは空白です。アップロードする前にキャンバスを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내보내기가 완료되었지만 %1$lld %2$@을 읽을 수 없어 해당 장치 프레임이 비어 있습니다. 업로드하기 전에 캔버스를 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het exporteren is voltooid, maar %1$lld %2$@ kan niet worden gelezen, dus deze apparaatframes zijn leeg. Controleer het canvas voordat u het uploadt."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksporten fullført, men %1$lld %2$@ kunne ikke leses, så disse enhetsrammene er tomme. Sjekk lerretet før du laster opp."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A exportação foi concluída, mas %1$lld %2$@ não pôde ser lido, portanto, esses quadros de dispositivo estão em branco. Verifique a tela antes de fazer upload."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A exportação foi concluída, mas %1$lld %2$@ não pôde ser lido, portanto, esses quadros de dispositivo estão em branco. Verifique a ecrã antes de carregar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporten slutförd, men %1$lld %2$@ kunde inte läsas, så de enhetsramarna är tomma. Kontrollera arbetsytan innan du laddar upp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出完成，但无法读取 %1$lld %2$@，因此这些设备帧为空白。上传前检查画布。"
          }
        }
      }
    },
    "Export finished, but %lld image files could not be read, so those device frames are blank. Check the canvas before uploading." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'ha acabat l'exportació, però no s'han pogut llegir %1$lld fitxers d'imatge, de manera que aquests marcs del dispositiu estan en blanc. Comproveu el llenç abans de pujar."

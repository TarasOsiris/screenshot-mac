          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur **Envoyer vers App Store Connect…** dans le menu d'exportation. Screenshot Bro génère les captures d'écran sélectionnées directement à partir du projet."

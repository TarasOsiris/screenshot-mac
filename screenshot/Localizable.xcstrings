    "App Store Connect rejects this if the selected app version is iPhone-only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect lehnt dies ab, wenn die ausgewählte App-Version nur iPhone ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect lo rechaza si la versión seleccionada es solo para iPhone."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر نسخه برنامه انتخابی فقط iPhone باشد، App Store Connect این را رد می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {

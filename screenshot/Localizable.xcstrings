    "Demo mode is active. Real API key fields above are ignored until you turn demo mode off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Demomodus ist aktiv. Die obigen echten API-Schlüsselfelder werden ignoriert, bis Sie den Demomodus deaktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo de demostración está activo. Los campos clave reales API anteriores se ignoran hasta que desactive el modo de demostración."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حالت نمایشی فعال است. تا زمانی که حالت نمایشی را خاموش نکنید، فیلدهای کلید واقعی API در بالا نادیده گرفته می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode démo est actif. Les véritables champs clés API ci-dessus sont ignorés jusqu'à ce que vous désactiviez le mode démo."
          }

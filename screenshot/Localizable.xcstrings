          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跨每种语言和设备构建精美的商品详情——没有上限，没有妥协。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

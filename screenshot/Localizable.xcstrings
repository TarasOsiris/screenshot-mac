        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 작업은 직접 할 때와 같은 동작을 거칩니다. 따라서 어시스턴트의 변경 사항도 **⌘Z**로 실행 취소할 수 있고, 다른 편집처럼 자동 저장됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semuanya melalui tindakan yang sama yang anda gunakan dengan tangan — jadi perubahan pembantu boleh dibuat asal dengan **⌘Z** dan disimpan secara automatik seperti mana-mana pengeditan lain."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles doorloopt dezelfde acties die u handmatig uitvoert, dus de wijzigingen van de assistent kunnen ongedaan worden gemaakt met **⌘Z** en worden automatisch opgeslagen, net als elke andere bewerking."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt går gjennom de samme handlingene du bruker for hånd — så assistentens endringer kan angres med **⌘Z** og automatisk lagres som alle andre redigeringer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko przechodzi przez te same czynności, które wykonujesz ręcznie — więc zmiany asystenta można cofnąć za pomocą **⌘Z** i zapisać automatycznie, jak każdą inną edycję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo passa pelas mesmas ações que você usa manualmente — portanto, as alterações do assistente podem ser desfeitas com **⌘Z** e salvas automaticamente como qualquer outra edição."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo passa pelas mesmas ações que você usa manualmente — portanto, as alterações do assistente podem ser desfeitas com **⌘Z** e guardadas automaticamente como qualquer outra edição."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totul trece prin aceleași acțiuni pe care le utilizați manual – astfel încât modificările asistentului pot fi anulate cu **⌘Z** și sunt salvate automat ca orice altă editare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все выполняется через те же действия, что и вручную, — поэтому изменения ассистента можно отменить с помощью **⌘Z**, и они сохраняются автоматически, как любые другие правки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetko prechádza tými istými akciami, aké používate ručne – takže zmeny asistenta sú nevratné pomocou **⌘Z** a automaticky sa ukladajú ako každá iná úprava."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vse poteka skozi ista dejanja, ki jih uporabljate ročno — tako da je pomočnikove spremembe mogoče razveljaviti z **⌘Z** in samodejno shraniti kot vsako drugo urejanje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allt går igenom samma åtgärder som du använder för hand — så assistentens ändringar går att ångra med **⌘Z** och automatiskt sparas som alla andra redigeringar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกอย่างจะต้องดำเนินการแบบเดียวกับที่คุณใช้ด้วยมือ ดังนั้นการเปลี่ยนแปลงของผู้ช่วยจึงยกเลิกได้ด้วย **⌘Z** และบันทึกอัตโนมัติเช่นเดียวกับการแก้ไขอื่นๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her şey elle kullandığınız işlemlerin aynısından geçer — bu yüzden asistanın değişiklikleri **⌘Z** ile geri alınabilir ve diğer tüm düzenlemeler gibi otomatik olarak kaydedilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе відбувається через ті самі дії, що й під час роботи вручну, — тож зміни помічника можна відмінити за допомогою **⌘Z**, і вони автоматично зберігаються, як і будь-яке інше редагування."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر چیز انہی کارروائیوں سے گزرتی ہے جو آپ ہاتھ سے استعمال کرتے ہیں — لہذا اسسٹنٹ کی تبدیلیاں **⌘Z** کے ساتھ ناقابل عمل ہیں اور کسی بھی دوسری ترمیم کی طرح خودکار طور پر محفوظ ہو جاتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi thao tác đều diễn ra giống như những thao tác bạn thực hiện thủ công — vì vậy, những thay đổi của trợ lý không thể hoàn tác được bằng **⌘Z** và được lưu tự động như mọi chỉnh sửa khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有操作都通过你手动使用的同一套操作完成——因此助手所做的更改可以用 **⌘Z** 撤销，并像其他编辑一样自动保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有操作都透過你手動使用的相同動作進行——因此助理所做的更改可以用 **⌘Z** 還原，並像其他編輯一樣自動儲存。"
          }
        }
      }
    },

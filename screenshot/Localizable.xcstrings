      }
    },
    "App Store Connect did not finish processing the uploaded screenshot in time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect hat die Verarbeitung des hochgeladenen Screenshots nicht rechtzeitig abgeschlossen."

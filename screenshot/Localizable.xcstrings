    "Exports use the row's exact pixel dimensions so App Store and Google Play sizes stay correct." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les exportacions utilitzen les dimensions exactes de píxels de la fila, de manera que les mides App Store i Google Play es mantenen correctes."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksporter bruger rækkens nøjagtige pixeldimensioner, så størrelserne App Store og Google Play forbliver korrekte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporte verwenden die exakten Pixelmaße der Zeile, damit die Größen für App Store und Google Play stimmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las exportaciones usan las dimensiones exactas en píxeles de la fila para que los tamaños del App Store y Google Play sean correctos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خروجی‌ها از ابعاد پیکسلی دقیق ردیف استفاده می‌کنند تا اندازه‌های App Store و Google Play درست بمانند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viedissä käytetään rivin tarkkoja pikselimittoja, joten App Store- ja Google Play-koot pysyvät oikeina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les exportations utilisent les dimensions exactes en pixels de la ligne afin que les tailles App Store et Google Play restent correctes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le esportazioni usano le dimensioni esatte in pixel della riga, così le dimensioni per App Store e Google Play restano corrette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き出しでは行の正確なピクセル寸法が使われるため、App Store や Google Play のサイズ要件を満たしたままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내보내기에서는 행의 정확한 픽셀 크기를 사용하므로 App Store 및 Google Play 크기가 올바르게 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij exporten worden de exacte pixelafmetingen van de rij gebruikt, zodat de afmetingen App Store en Google Play correct blijven."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksporter bruker radens eksakte pikseldimensjoner, slik at størrelsene App Store og Google Play forblir korrekte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As exportações usam as dimensões exatas em pixels da linha, para que os tamanhos da App Store e do Google Play fiquem corretos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As exportações usam as dimensões exatas em pixels da linha para que os tamanhos App Store e Google Play permaneçam corretos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При экспорте используются точные размеры строки в пикселях, поэтому размеры для App Store и Google Play остаются правильными."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporter använder radens exakta pixeldimensioner så att storlekarna App Store och Google Play förblir korrekta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dışa aktarmalar satırın tam piksel boyutlarını kullanır; böylece App Store ve Google Play boyutları doğru kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час експорту використовуються точні піксельні розміри рядка, тож розміри для App Store і Google Play залишаються правильними."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出时使用行的精确像素尺寸，确保 App Store 和 Google Play 的尺寸正确。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸出時會使用該列的精確像素尺寸，確保 App Store 和 Google Play 的大小正確無誤。"
          }
        }
      }
    },

        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habilite o servidor MCP local e copie o prompt do agente, o JSON de conexão ou o token de acesso. Consulte o tópico Automação e MCP."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите локальный MCP-сервер и скопируйте промпт для агента, JSON подключения или токен доступа. См. раздел «Автоматизация и MCP»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel MCP sunucusunu etkinleştirin ve ajan istemini, bağlantı JSON'unu veya erişim belirtecini kopyalayın. Otomasyon ve MCP konusuna bakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть локальний сервер MCP і скопіюйте запит для агента, JSON для підключення або токен доступу. Докладніше в темі «Автоматизація і MCP»."
          }

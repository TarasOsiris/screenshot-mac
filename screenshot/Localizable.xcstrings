        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento řádek zobrazuje své šablony jako samostatné dlaždice ve stylu App Store. Úpravy jsou zakázány, dokud neukončíte režim náhledu."

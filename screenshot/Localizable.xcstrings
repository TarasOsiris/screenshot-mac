    "%@ has another row of this screenshot size. A variant takes one row per size, so move or delete one before uploading." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ té una altra fila d'aquesta mida de captura de pantalla. Una variant ocupa una fila per mida, així que mou o suprimeix-ne una abans de penjar-la."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ har en anden række af denne skærmbilledestørrelse. En variant tager en række pr. størrelse, så flyt eller slet en før upload."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat eine weitere Zeile mit dieser Screenshot-Größe. Eine Variante nimmt eine Zeile pro Größe, verschiebe oder lösche daher eine vor dem Hochladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tiene otra fila con este tamaño de captura. Una variante admite una fila por tamaño, así que mueve o elimina una antes de subir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ردیف دیگری با این اندازه اسکرین‌شات دارد. هر نسخه برای هر اندازه یک ردیف می‌پذیرد، پس پیش از آپلود یکی را منتقل یا حذف کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sisältää toisen tämän kokoisen kuvakaappauksen rivin. Muunnelma vie yhden rivin kokoa kohden, joten siirrä tai poista yksi rivi ennen lataamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a une autre ligne de cette taille de capture. Une variante prend une ligne par taille : déplacez-en ou supprimez-en une avant l'envoi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha un'altra riga con questa dimensione di screenshot. Una variante accetta una riga per dimensione, quindi spostane o eliminane una prima del caricamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ には同じスクリーンショットサイズの行がもう 1 つあります。バリアントはサイズごとに 1 行のみなので、アップロード前にどちらかを移動または削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 같은 스크린샷 크기의 행이 하나 더 있습니다. 변형은 크기마다 한 행만 받으므로 업로드 전에 하나를 옮기거나 삭제하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ heeft nog een rij met deze schermgrootte. Een variant heeft één rij per maat nodig, dus verplaats of verwijder er één voordat u deze uploadt."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ har en annen rad med denne skjermbildestørrelsen. En variant tar én rad per størrelse, så flytt eller slett en før du laster opp."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tem outra linha com este tamanho de captura. Uma variante aceita uma linha por tamanho, então mova ou exclua uma antes de enviar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tem outra linha com este tamanho de captura de ecrã. Uma variante ocupa uma linha por tamanho, então mova ou exclua uma antes de carregar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В %@ есть еще одна строка с таким размером скриншота. Вариант принимает одну строку на размер, поэтому перед загрузкой переместите или удалите одну из них."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ har en annan rad med denna skärmdumpstorlek. En variant tar en rad per storlek, så flytta eller ta bort en innan du laddar upp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ içinde bu ekran görüntüsü boyutunda başka bir satır var. Bir varyant her boyut için bir satır alır; yüklemeden önce birini taşıyın veya silin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ має ще один рядок із цим розміром знімка екрана. Варіант приймає один рядок на розмір, тож перед вивантаженням перемістіть або видаліть один із них."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 还有另一行是此截图尺寸。每个变体每种尺寸只能有一行，请在上传前移动或删除其中一行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 有另一列使用相同的螢幕截圖大小。每個變體的每種大小只能有一列，因此請在上傳前移動或刪除其中一列。"
          }
        }
      }
    },

          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Esc** şekillerin seçimini kaldırır; satırın seçimini kaldırmak için yeniden basın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Esc** знімає вибір із фігур; натисніть ще раз, щоб зняти вибір із рядка."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Esc** شکلیں غیر منتخب کرتا ہے۔ قطار کو غیر منتخب کرنے کے لیے دوبارہ دبائیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Esc** bỏ chọn hình dạng; nhấn lại để bỏ chọn hàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Esc** 取消选择形状；再按一次可取消选择行。"

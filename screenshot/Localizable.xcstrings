          }
        }
      }
    },
    "**Confirm before deleting** — show a confirmation prompt for destructive actions on rows and screenshots." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Vor dem Löschen bestätigen** – Zeigt eine Bestätigungsaufforderung für destruktive Aktionen in Zeilen und Screenshots an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Confirmar antes de eliminar**: muestra un mensaje de confirmación para acciones destructivas en filas y capturas de pantalla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**قبل از حذف تأیید کنید** - یک درخواست تأیید برای اقدامات مخرب در ردیف ها و تصاویر صفحه نمایش دهید."
          }
        },
        "fr" : {
          "stringUnit" : {

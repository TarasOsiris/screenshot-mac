        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**내보낸 후 Finder에 표시** — Finder에 결과가 자동으로 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Revelar no Finder após exportação** — revelar automaticamente os resultados no Finder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Показывать в Finder после экспорта** — автоматически показывать результаты в Finder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Dışa aktardıktan sonra Finder'da göster** — sonuçları Finder'da otomatik olarak gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Показати у Finder після експорту** — автоматично показує результати у Finder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**导出后在 Finder 中显示** — 在 Finder 中自动显示结果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**輸出後在 Finder 中顯示**——自動在 Finder 中顯示結果。"
          }
        }
      }
    },
    "**Reverse gradient** flips the stop order in one click." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Verlauf umkehren** dreht die Stoppreihenfolge mit einem Klick um."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Gradiente inverso** invierte el orden de parada con un solo clic."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "** گرادیان معکوس ** ترتیب توقف را با یک کلیک تغییر می دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Dégradé inversé** inverse l'ordre stop en un seul clic."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Inverti sfumatura** inverte l'ordine dei punti colore con un clic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**逆勾配** は、ワンクリックでストップ注文を反転します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**역 그래디언트**는 한 번의 클릭으로 중지 순서를 뒤집습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Gradiente reverso** inverte a ordem de parada com um clique."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Инвертировать градиент** меняет порядок опорных точек на обратный одним нажатием."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Renk geçişini ters çevir**, durakların sırasını tek tıklamayla tersine çevirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Обернути градієнт** змінює порядок точок на протилежний одним клацанням."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**反向梯度** 一键翻转停止顺序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**反轉漸層**一鍵翻轉色標順序。"
          }
        }
      }
    },
    "**Revert to Base Language…** — drops all overrides for the current language, falling back to base text everywhere." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Auf Basissprache zurücksetzen…** – löscht alle Überschreibungen für die aktuelle Sprache und greift überall auf den Basistext zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Volver al idioma base…**: elimina todas las anulaciones del idioma actual y vuelve al texto base en todas partes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**بازگشت به زبان پایه…** - همه موارد لغو را برای زبان فعلی حذف می کند و همه جا به متن اصلی باز می گردد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Revenir à la langue de base…** — supprime tous les remplacements pour la langue actuelle et revient partout au texte de base."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Ripristina lingua di base…**: elimina tutte le personalizzazioni della lingua corrente, tornando ovunque al testo di base."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**基本言語に戻す…** — 現在の言語のすべてのオーバーライドを削除し、どこでも基本テキストに戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**기본 언어로 되돌리기…** — 현재 언어에 대한 모든 재정의를 삭제하고 모든 곳에서 기본 텍스트로 돌아갑니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Reverter para o idioma base…** — elimina todas as substituições do idioma atual, retornando ao texto base em todos os lugares."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Вернуть базовый язык…** — удаляет все переопределения для текущего языка, везде возвращаясь к базовому тексту."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Temel Dile Geri Dön…** — geçerli dil için tüm çevirileri kaldırır ve her yerde temel metne geri döner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Повернути до базової мови…** — відкидає всі перевизначення для поточної мови, і всюди використовується базовий текст."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**恢复到基本语言...** — 删除当前语言的所有覆盖，到处回退到基本文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**回復為基準語言…**——移除目前語言的所有覆寫內容，所有地方都改用基準文字。"
          }
        }
      }
    },
    "**Review Changes** lists, per locale and display type, exactly what will be added, what will be replaced, and what stays untouched. Nothing is sent to Apple until you confirm there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Änderungen überprüfen** listet pro Gebietsschema und Anzeigetyp genau auf, was hinzugefügt wird, was ersetzt wird und was unberührt bleibt. Es wird nichts an Apple gesendet, bis Sie es dort bestätigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Revisar cambios** enumera, por configuración regional y tipo de visualización, exactamente lo que se agregará, lo que se reemplazará y lo que permanecerá intacto. No se envía nada a Apple hasta que lo confirmes allí."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**تغییرات را بررسی کنید**، به ازای هر منطقه و نوع نمایش، دقیقاً چه چیزی اضافه می شود، چه چیزی جایگزین می شود و چه چیزی دست نخورده باقی می ماند. تا زمانی که شما آنجا را تایید نکنید، هیچ چیزی برای اپل ارسال نمی شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Review Changes** répertorie, par paramètres régionaux et types d'affichage, exactement ce qui sera ajouté, ce qui sera remplacé et ce qui restera intact. Rien n'est envoyé à Apple jusqu'à ce que vous le confirmiez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Rivedi modifiche** elenca, per lingua e tipo di display, esattamente cosa verrà aggiunto, cosa verrà sostituito e cosa resterà invariato. Non viene inviato nulla ad Apple finché non confermi lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**変更の確認** には、ロケールおよび表示タイプごとに、何が追加されるか、何が置き換えられるか、何が変更されないのかが正確にリストされます。 Apple で確認するまでは何も送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**변경사항 검토**에는 로케일 및 디스플레이 유형별로 추가될 항목, 교체될 항목, 그대로 유지되는 항목이 정확하게 나열되어 있습니다. 귀하가 확인할 때까지 Apple로 아무 것도 전송되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Analise as listas de alterações**, por localidade e tipo de exibição, exatamente o que será adicionado, o que será substituído e o que permanecerá intacto. Nada é enviado para a Apple até que você confirme lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Просмотреть изменения** показывает для каждого языка и типа дисплея, что именно будет добавлено, что заменено, а что останется без изменений. Ничего не отправляется в Apple, пока вы не подтвердите это там."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Değişiklikleri İncele**, her dil ve ekran türü için tam olarak neyin ekleneceğini, neyin değiştirileceğini ve neyin olduğu gibi kalacağını listeler. Siz orada onaylayana kadar Apple'a hiçbir şey gönderilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Переглянути зміни** показує для кожної мови й типу дисплея, що саме буде додано, що буде замінено, а що залишиться без змін. Нічого не надсилається в Apple, доки ви не підтвердите там."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**查看更改** 根据区域设置和显示类型列出了将添加的内容、将替换的内容以及保持不变的内容。在您确认之前，不会向 Apple 发送任何信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**檢查更改**會依語言和顯示類型，精確列出將被加入、取代以及保持不變的內容。在你於該處確認之前，不會傳送任何內容給 Apple。"
          }
        }
      }
    },
    "**Rich text**: while editing, select part of the text and use the format bar for bold, italic, underline, strikethrough, a different size, or a different color — per run, inside one shape. **Clear formatting** returns the selection to the shape's base style." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Rich-Text**: Wählen Sie beim Bearbeiten einen Teil des Textes aus und verwenden Sie die Formatierungsleiste für Fett, Kursiv, Unterstrichen, Durchgestrichen, eine andere Größe oder eine andere Farbe – pro Lauf, innerhalb einer Form. **Formatierung löschen** setzt die Auswahl auf den Basisstil der Form zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Texto enriquecido**: mientras editas, selecciona parte del texto y usa la barra de formato para negrita, cursiva, subrayado, tachado, un tamaño diferente o un color diferente, por ejecución, dentro de una forma. **Borrar formato** devuelve la selección al estilo base de la forma."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**متن غنی**: در حین ویرایش، بخشی از متن را انتخاب کنید و از نوار قالب برای پررنگ، مورب، زیرخط، خط خطی، اندازه های مختلف یا رنگ های متفاوت - در هر اجرا، در یک شکل استفاده کنید. **قالب بندی پاک کردن** انتخاب را به سبک پایه شکل برمی گرداند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Texte enrichi** : lors de l'édition, sélectionnez une partie du texte et utilisez la barre de format pour le gras, l'italique, le souligné, le barré, une taille différente ou une couleur différente, par passage, à l'intérieur d'une forme. **Mise en forme claire** renvoie la sélection au style de base de la forme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Testo formattato**: durante la modifica, seleziona parte del testo e usa la barra di formattazione per grassetto, corsivo, sottolineato, barrato, una dimensione diversa o un colore diverso, per singoli tratti all'interno di una forma. **Cancella formattazione** riporta la selezione allo stile di base della forma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**リッチ テキスト**: 編集中にテキストの一部を選択し、書式バーを使用して太字、斜体、下線、取り消し線、別のサイズ、別の色を 1 つの図形内で実行ごとに設定できます。 **書式設定をクリア**すると、選択範囲が図形の基本スタイルに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**서식 있는 텍스트**: 편집하는 동안 텍스트의 일부를 선택하고 형식 막대를 사용하여 굵게, 기울임꼴, 밑줄, 취소선, 다른 크기 또는 다른 색상을 실행별로, 하나의 도형 내에서 표시합니다. **서식 지우기**는 선택 항목을 도형의 기본 스타일로 되돌립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Rich text**: durante a edição, selecione parte do texto e use a barra de formatação para negrito, itálico, sublinhado, tachado, um tamanho diferente ou uma cor diferente — por execução, dentro de uma forma. **Limpar formatação** retorna a seleção ao estilo base da forma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Форматированный текст**: во время редактирования выделите часть текста и с помощью панели форматирования сделайте ее жирной, курсивной, подчеркнутой, зачеркнутой, другого размера или цвета — отдельно для фрагмента внутри одной фигуры. **Очистить форматирование** возвращает выделению базовый стиль фигуры."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Zengin metin**: düzenlerken metnin bir bölümünü seçin ve biçim çubuğunu kullanarak kalın, italik, altı çizili, üstü çizili, farklı boyut veya farklı renk uygulayın — tek bir şeklin içinde, parça bazında. **Biçimlendirmeyi temizle**, seçimi şeklin temel stiline döndürür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Форматований текст**: під час редагування виділіть частину тексту й скористайтеся панеллю форматування для жирного, курсиву, підкреслення, закреслення, іншого розміру чи іншого кольору — окремо для фрагмента всередині однієї фігури. **Очистити форматування** повертає виділенню базовий стиль фігури."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**富文本**：编辑时，选择部分文本，然后使用格式栏设置粗体、斜体、下划线、删除线、不同的大小或不同的颜色 - 每次运行，在一个形状内。 **清除格式**将选择返回到形状的基本样式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**格式化文字**：編輯時選取部分文字，並使用格式列套用粗體、斜體、底線、刪除線、不同大小或不同顏色——可在同一形狀內逐段設定。**清除格式**會將選取範圍恢復為形狀的基本樣式。"
          }
        }
      }
    },
    "**Row label** — names the folder this row exports into." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Zeilenbezeichnung** – benennt den Ordner, in den diese Zeile exportiert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Etiqueta de fila**: nombra la carpeta a la que se exporta esta fila."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**برچسب ردیف** - پوشه ای را که این ردیف به آن صادر می کند نام می برد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Étiquette de ligne** : nomme le dossier dans lequel cette ligne est exportée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**行ラベル** — この行がエクスポートされるフォルダーの名前を付けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**행 라벨** — 이 행을 내보내는 폴더의 이름을 지정합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Rótulo da linha** — nomeia a pasta para a qual esta linha é exportada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**行标签** — 命名该行导出到的文件夹。"
          }
        }
      }
    },
    "**Row label** — names the folder this row exports into. **Double-click the label in the row header** to rename it in place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Zeilenbezeichnung** – benennt den Ordner, in den diese Zeile exportiert wird. **Doppelklicken Sie auf die Beschriftung im Zeilenkopf**, um sie direkt umzubenennen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Etiqueta de fila**: nombra la carpeta a la que se exporta esta fila. **Haga doble clic en la etiqueta en el encabezado de la fila** para cambiarle el nombre."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**برچسب ردیف** - پوشه ای را که این ردیف به آن صادر می کند نام می برد. **بر روی برچسب در هدر ردیف** دوبار کلیک کنید تا در جای خود نام آن را تغییر دهید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Étiquette de ligne** : nomme le dossier dans lequel cette ligne est exportée. **Double-cliquez sur l'étiquette dans l'en-tête de ligne** pour la renommer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Etichetta riga**: dà il nome alla cartella in cui viene esportata la riga. **Fai doppio clic sull'etichetta nell'intestazione della riga** per rinominarla direttamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**行ラベル** — この行がエクスポートされるフォルダーの名前を付けます。 **行ヘッダーのラベルをダブルクリック**して、その場所の名前を変更します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**행 라벨** — 이 행을 내보내는 폴더의 이름을 지정합니다. **행 헤더에 있는 라벨을 두 번 클릭**하여 이름을 바꾸세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Rótulo da linha** — nomeia a pasta para a qual esta linha é exportada. **Clique duas vezes no rótulo no cabeçalho da linha** para renomeá-lo no lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Название строки** — задает имя папки, в которую экспортируется строка. **Дважды нажмите название в заголовке строки**, чтобы переименовать ее на месте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Satır etiketi** — bu satırın dışa aktarıldığı klasörün adını belirler. Yerinde yeniden adlandırmak için **satır başlığındaki etiketi çift tıklayın**."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Назва рядка** — задає назву папки, в яку експортується цей рядок. **Двічі клацніть назву в заголовку рядка**, щоб перейменувати її на місці."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**行标签** — 命名该行导出到的文件夹。 **双击行标题中的标签**将其重命名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**列標籤**——命名此列輸出時使用的資料夾。**按兩下列標題中的標籤**即可直接重新命名。"
          }
        }
      }
    },
    "**Rows** inside a project group screenshots by device type (iPhone, iPad, Android phone, etc.). Each device size gets its own row because the App Store requires different resolutions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Zeilen** innerhalb eines Projekts gruppieren Screenshots nach Gerätetyp (iPhone, iPad, Android-Telefon usw.). Jede Gerätegröße erhält eine eigene Zeile, da der App Store unterschiedliche Auflösungen erfordert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Filas** dentro de un grupo de proyecto capturas de pantalla por tipo de dispositivo (iPhone, iPad, teléfono Android, etc.). Cada tamaño de dispositivo tiene su propia fila porque App Store requiere diferentes resoluciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**ردیف‌ها** داخل پروژه عکس‌های صفحه‌نمایش را بر اساس نوع دستگاه (iPhone، iPad، تلفن Android، و غیره) گروه‌بندی می‌کنند. هر اندازه دستگاه ردیف خاص خود را دارد زیرا App Store به وضوح‌های متفاوتی نیاز دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Lignes** à l'intérieur d'un groupe de projets, captures d'écran par type d'appareil (iPhone, iPad, téléphone Android, etc.). Chaque taille d'appareil dispose de sa propre ligne, car App Store nécessite des résolutions différentes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le **righe** all'interno di un progetto raggruppano gli screenshot per tipo di dispositivo (iPhone, iPad, telefono Android e così via). Ogni dimensione di dispositivo ha la propria riga perché l'App Store richiede risoluzioni diverse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクト内の **行** は、デバイスの種類 (iPhone、iPad、Android スマートフォンなど) ごとにスクリーンショットをグループ化します。 App Store は異なる解像度を必要とするため、デバイス サイズごとに独自の行が取得されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트 그룹 내의 **행**은 기기 유형(iPhone, iPad, Android 휴대폰 등)별로 스크린샷을 보여줍니다. App Store에는 서로 다른 해상도가 필요하므로 각 장치 크기는 자체 행을 갖습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Linhas** dentro de um projeto agrupam capturas de tela por tipo de dispositivo (iPhone, iPad, telefone Android etc.). Cada tamanho de dispositivo obtém sua própria linha porque o App Store requer resoluções diferentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Строки** в проекте группируют скриншоты по типу устройства (iPhone, iPad, телефон Android и т. д.). Для каждого размера устройства — своя строка, потому что App Store требует разные разрешения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir projenin içindeki **satırlar**, ekran görüntülerini aygıt türüne göre gruplar (iPhone, iPad, Android telefon vb.). App Store farklı çözünürlükler istediği için her aygıt boyutunun kendi satırı olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Рядки** в проєкті групують знімки екрана за типом пристрою (iPhone, iPad, Android-телефон тощо). Кожен розмір пристрою має окремий рядок, бо App Store вимагає різних роздільностей."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目组屏幕截图内的 **行** 按设备类型（iPhone、iPad、Android 手机等）。每个设备尺寸都有自己的行，因为 App Store 需要不同的分辨率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "專案中的**列**會依裝置類型（iPhone、iPad、Android 手機等）將螢幕截圖分組。每種裝置尺寸都有自己的列，因為 App Store 要求不同的解析度。"
          }
        }
      }
    },
    "**Scale** — 1×, 2×, 3×." : {
      "extractionState" : "stale",

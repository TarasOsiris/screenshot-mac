    "Run a simulated upload — no service account required and no traffic is sent to Google Play." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führen Sie einen simulierten Upload durch – kein Dienstkonto erforderlich und es wird kein Datenverkehr an Google Play gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecute una carga simulada: no se requiere cuenta de servicio y no se envía tráfico a Google Play."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک بارگذاری شبیه سازی شده اجرا کنید — هیچ حساب سرویسی مورد نیاز نیست و هیچ ترافیکی به Google Play ارسال نمی شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécutez un téléchargement simulé : aucun compte de service n'est requis et aucun trafic n'est envoyé vers Google Play."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegui un caricamento simulato: non serve alcun account di servizio e nessun traffico viene inviato a Google Play."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シミュレートされたアップロードを実行します。サービス アカウントは必要なく、トラフィックは Google Play に送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시뮬레이션된 업로드를 실행합니다. 서비스 계정이 필요하지 않으며 트래픽이 Google Play로 전송되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Execute um upload simulado. Nenhuma conta de serviço é necessária e nenhum tráfego é enviado para Google Play."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имитация загрузки — сервисный аккаунт не нужен, и в Google Play ничего не отправляется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benzetimli bir yükleme çalıştırın — hizmet hesabı gerekmez ve Google Play'e hiçbir trafik gönderilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запустіть імітацію вивантаження — сервісний обліковий запис не потрібен, і жодних даних не надсилається в Google Play."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行模拟上传 — 不需要服务帐户，并且不会向 Google Play 发送流量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "執行模擬上傳——不需要服務帳號，也不會傳送任何流量到 Google Play。"
          }
        }
      }
    },
    "Run an export first, then click **Upload to App Store Connect** in the toolbar." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führen Sie zunächst einen Export durch und klicken Sie dann in der Symbolleiste auf **Upload to App Store Connect**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero ejecute una exportación y luego haga clic en **Subir a App Store Connect** en la barra de herramientas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابتدا یک صادرات را اجرا کنید، سپس روی **آپلود در App Store Connect** در نوار ابزار کلیک کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe uma chave JSON de conta de serviço, teste a conexão e alterne o modo de demonstração. Consulte o tópico Google Play."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импортируйте JSON-ключ сервисного аккаунта, проверьте подключение и включите или выключите демо-режим. См. раздел Google Play."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir hizmet hesabı JSON anahtarını içe aktarın, bağlantıyı test edin ve demo modunu açıp kapatın. Google Play konusuna bakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Імпортуйте ключ JSON сервісного облікового запису, перевірте з’єднання та ввімкніть або вимкніть демо-режим. Докладніше в темі Google Play."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

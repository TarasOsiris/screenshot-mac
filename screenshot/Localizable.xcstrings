    "Text doesn't fit in its box. Enlarge the box, shorten the text, or turn on Shrink to Fit." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El text no cap a la seva casella. Amplieu el quadre, escurceu el text o activeu Redueix per ajustar-lo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teksten passer ikke i dens boks. Forstør boksen, forkort teksten, eller slå Krymp til at passe til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Text passt nicht in sein Feld. Vergrößere das Feld, kürze den Text oder aktiviere „Passend verkleinern“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto no cabe en su cuadro. Agranda el cuadro, acorta el texto o activa Reducir para ajustar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متن در کادرش جا نمی‌شود. کادر را بزرگ‌تر کنید، متن را کوتاه کنید یا «کوچک‌سازی برای جا شدن» را روشن کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teksti ei mahdu laatikkoon. Suurenna laatikkoa, lyhennä tekstiä tai ota käyttöön Shrink to Fit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte ne tient pas dans son cadre. Agrandissez le cadre, raccourcissez le texte ou activez Réduire pour ajuster."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il testo non entra nel riquadro. Ingrandisci il riquadro, accorcia il testo o attiva Riduci per adattare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストが枠に収まりません。枠を広げるか、テキストを短くするか、「縮小して合わせる」をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트가 상자에 맞지 않습니다. 상자를 키우거나 텍스트를 줄이거나 '맞게 축소'를 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst past niet in het vak. Vergroot het vak, verkort de tekst of schakel Verkleinen in."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teksten passer ikke i boksen. Forstørre boksen, forkort teksten eller slå på Krymp for å passe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O texto não cabe na caixa. Aumente a caixa, encurte o texto ou ative Reduzir para caber."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O texto não cabe na caixa. Aumente a caixa, encurte o texto ou ative Reduzir para caber."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текст не помещается в рамку. Увеличьте рамку, сократите текст или включите «Уменьшать по размеру»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text får inte plats i rutan. Förstora rutan, förkorta texten eller aktivera Krymp för att passa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metin kutusuna sığmıyor. Kutuyu büyütün, metni kısaltın veya Sığdırmak İçin Küçült'ü açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текст не вміщається в рамку. Збільште рамку, скоротіть текст або ввімкніть «Зменшувати під розмір»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文本超出了文本框。请放大文本框、缩短文本，或打开“缩小以适合”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字超出了文字框。請放大文字框、縮短文字，或開啟「縮小以符合」。"
          }
        }
      }
    },

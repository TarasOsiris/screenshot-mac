    "Each variant becomes one treatment in a product page experiment. The Original rows stay on your product page as the control." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ويصبح كل متغير علاجًا واحدًا في تجربة صفحة المنتج. تظل الصفوف الأصلية على صفحة منتجك كعنصر تحكم."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada variant es converteix en un tractament en un experiment de pàgina de producte. Les files originals es mantenen a la pàgina del producte com a control."

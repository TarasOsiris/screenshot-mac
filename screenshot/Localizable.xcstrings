    "Import a service account JSON key, test the connection, and toggle demo mode. See the Google Play topic." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم باستيراد مفتاح JSON لحساب الخدمة، واختبر الاتصال، وقم بتبديل الوضع التجريبي. راجع موضوع Google Play."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি পরিষেবা অ্যাকাউন্ট JSON কী আমদানি করুন, সংযোগ পরীক্ষা করুন এবং ডেমো মোড টগল করুন৷ Google Play বিষয় দেখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importeu una clau JSON del compte de servei, proveu la connexió i canvieu el mode de demostració. Consulteu el tema Google Play."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importujte klíč JSON servisního účtu, otestujte připojení a přepněte ukázkový režim. Viz téma Google Play."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importer en servicekonto JSON-nøgle, test forbindelsen, og skift demotilstand. Se Google Play-emnet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON-Schlüssel eines Dienstkontos importieren, Verbindung testen und Demomodus ein- oder ausschalten. Siehe das Thema „Google Play“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εισαγάγετε ένα κλειδί JSON λογαριασμού υπηρεσίας, δοκιμάστε τη σύνδεση και αλλάξτε τη λειτουργία επίδειξης. Δείτε το θέμα Google Play."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa una clave JSON de cuenta de servicio, prueba la conexión y activa o desactiva el modo de demostración. Consulta el tema Google Play."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلید JSON حساب سرویس را وارد کنید، اتصال را آزمایش کنید و حالت نمایشی را روشن یا خاموش کنید. به مبحث Google Play مراجعه کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuo palvelutilin JSON-avain, testaa yhteys ja vaihda esittelytilaa. Katso aihe Google Play."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez une clé JSON de compte de service, testez la connexion et activez le mode démo. Consultez la rubrique Google Play."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સેવા એકાઉન્ટ JSON કી આયાત કરો, કનેક્શનનું પરીક્ષણ કરો અને ડેમો મોડને ટૉગલ કરો. Google Play વિષય જુઓ."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ייבא מפתח JSON של חשבון שירות, בדוק את החיבור והחלף מצב הדגמה. עיין בנושא Google Play."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेवा खाता JSON कुंजी आयात करें, कनेक्शन का परीक्षण करें और डेमो मोड टॉगल करें। Google Play विषय देखें."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvezite JSON ključ računa usluge, testirajte vezu i uključite demo način rada. Pogledajte temu Google Play."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importáljon szolgáltatásfiók JSON-kulcsát, tesztelje a kapcsolatot, és váltson demó módba. Lásd a Google Play témát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impor kunci JSON akun layanan, uji koneksi, dan alihkan mode demo. Lihat topik Google Play."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa una chiave JSON dell'account di servizio, verifica la connessione e attiva la modalità demo. Consulta l'argomento Google Play."

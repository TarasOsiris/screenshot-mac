            "value" : "**Duplicar fila**, **Añadir fila arriba / debajo**, **Mover fila arriba / abajo**."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**تکثیر ردیف**، **افزودن ردیف جدید در بالا / پایین**، **انتقال ردیف به بالا / پایین**."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Kopioi rivi**, **Lisää uusi rivi ylä-/alapuolelle**, **Siirrä rivi ylös/alas**."

    "Starred projects float to the top of the picker. The rest follow the order set in Settings ▸ General." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطفو المشاريع المميزة بنجمة إلى أعلى المنتقي. أما الباقي فيتبع الترتيب المحدد في الإعدادات ▸ عام."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els projectes destacats suren a la part superior del selector. La resta segueix l'ordre establert a Configuració ▸ General."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekty označené hvězdičkou se přesunou do horní části nástroje pro výběr. Zbytek se řídí pořadím nastaveným v Nastavení ▸ Obecné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stjernemarkerede projekter flyder til toppen af vælgeren. Resten følger rækkefølgen i Indstillinger ▸ Generelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Stern markierte Projekte stehen oben in der Auswahl. Der Rest folgt der Reihenfolge aus „Einstellungen ▸ Allgemein“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα έργα με αστέρι επιπλέουν στην κορυφή του επιλογέα. Τα υπόλοιπα ακολουθούν τη σειρά που ορίζεται στις Ρυθμίσεις ▸ Γενικά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los proyectos destacados aparecen arriba del todo en el selector. El resto sigue el orden definido en Ajustes ▸ General."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پروژه‌های ستاره‌دار بالای فهرست انتخاب قرار می‌گیرند. بقیه طبق ترتیب تعیین‌شده در تنظیمات ▸ عمومی می‌آیند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tähdellä merkityt projektit kelluvat poimijan yläosaan. Loput noudattavat kohdassa Asetukset ▸ Yleiset asetettua järjestystä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les projets favoris remontent en haut du sélecteur. Les autres suivent l'ordre défini dans Réglages ▸ Général."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פרויקטים מסומנים בכוכב צפים לראש הבוחר. השאר פועלים לפי הסדר שנקבע בהגדרות ▸ כללי."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekti sa zvjezdicom lebde na vrhu alata za odabir. Ostali slijede redoslijed postavljen u Postavke ▸ Općenito."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A csillagozott projektek a válogató tetején lebegnek. A többi a Beállítások ▸ Általános menüpontban beállított sorrend szerint történik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proyek yang berbintang akan muncul di urutan teratas pemilih. Selebihnya ikuti urutan yang diatur di Pengaturan ▸ Umum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I progetti preferiti salgono in cima al selettore. Gli altri seguono l'ordine impostato in Impostazioni ▸ Generali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スターを付けたプロジェクトはピッカーの一番上に表示されます。それ以外は 設定 ▸ 一般 で設定した順序で並びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "별표 표시된 프로젝트가 선택기 상단에 표시됩니다. 나머지는 설정 ▸ 일반에서 설정한 순서를 따릅니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projek berbintang terapung ke bahagian atas pemilih. Selebihnya mengikut susunan yang ditetapkan dalam Tetapan ▸ Umum."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projecten met een ster zweven naar de top van de kiezer. De rest volgt de volgorde die is ingesteld in Instellingen ▸ Algemeen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stjernemerkede prosjekter flyter til toppen av velgeren. Resten følger rekkefølgen satt i Innstillinger ▸ Generelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekty oznaczone gwiazdką unoszą się na górę selektora. Reszta jest zgodna z kolejnością ustawioną w Ustawieniach ▸ Ogólne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os projetos destacados sobem para o topo do seletor. Os demais seguem a ordem definida em Ajustes ▸ Geral."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os projetos marcados com estrela flutuam no topo do seletor. O restante segue a ordem definida em Configurações ▸ Geral."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proiectele marcate cu stea plutesc în partea de sus a selectorului. Restul urmează ordinea setată în Setări ▸ General."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмеченные проекты поднимаются в начало списка. Остальные следуют порядку, заданному в разделе «Настройки ▸ Основные»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekty označené hviezdičkou sa pohybujú v hornej časti výberu. Zvyšok sa riadi poradím nastaveným v Nastavenia ▸ Všeobecné."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekti z zvezdico se prikažejo na vrhu izbirnika. Ostali sledite vrstnemu redu, določenemu v Nastavitve ▸ Splošno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stjärnmärkta projekt flyter till toppen av väljaren. Resten följer ordningen i Inställningar ▸ Allmänt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โปรเจ็กต์ที่ติดดาวจะลอยไปที่ด้านบนของเครื่องมือเลือก ส่วนที่เหลือเป็นไปตามลำดับที่ตั้งไว้ในการตั้งค่า ▸ ทั่วไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yıldızlı projeler seçicinin en üstünde yer alır. Geri kalanlar Ayarlar ▸ Genel'de belirlenen sırayı izler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позначені зірочкою проєкти піднімаються на початок списку вибору. Решта йдуть у порядку, заданому в розділі «Параметри ▸ Загальні»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستارے والے پروجیکٹس چننے والے کے اوپری حصے پر تیرتے ہیں۔ باقی سیٹنگز ▸ جنرل میں ترتیب دی گئی ترتیب پر عمل کرتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các dự án được gắn dấu sao sẽ nổi lên đầu bộ chọn. Phần còn lại thực hiện theo thứ tự đã đặt trong Cài đặt ▸ Chung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加星标的项目会置顶显示在项目选择器中，其余项目按“设置 ▸ 通用”中设定的顺序排列。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加上星號的專案會置頂於選擇器中。其餘專案則依照「設定 ▸ 一般」中設定的順序排列。"
          }
        }
      }
    },

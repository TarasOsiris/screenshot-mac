    "Go unlimited and create as many screenshots as your apps need." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehen Sie unbegrenzt vor und erstellen Sie so viele Screenshots, wie Ihre Apps benötigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazte ilimitado y crea todas las capturas que tus apps necesiten."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نامحدود بروید و هر تعداد اسکرین شات به اندازه نیاز برنامه هایتان ایجاد کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allez-y en illimité et créez autant de captures d'écran que vos applications en ont besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa all'illimitato e crea tutti gli screenshot di cui le tue app hanno bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無制限に、アプリに必要なだけスクリーンショットを作成できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무제한으로 앱에 필요한 만큼 스크린샷을 생성하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vá ilimitado e crie quantas capturas de tela seus aplicativos precisarem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимите ограничения и создавайте столько скриншотов, сколько нужно вашим приложениям."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sınırsız kullanın ve uygulamalarınızın ihtiyaç duyduğu kadar ekran görüntüsü oluşturun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зніміть обмеження й створюйте стільки знімків екрана, скільки потрібно вашим програмам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不受限制，根据您的应用程序需要创建尽可能多的屏幕截图。"

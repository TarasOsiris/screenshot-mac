    "An App Store experiment holds at most 3 treatments. Delete a variant or merge two." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتوي تجربة App Store على 3 علاجات على الأكثر. حذف متغير أو دمج اثنين."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি App Store পরীক্ষা সর্বাধিক 3টি চিকিত্সা ধারণ করে৷ একটি বৈকল্পিক মুছুন বা দুটি মার্জ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un experiment App Store conté com a màxim 3 tractaments. Suprimeix una variant o fusiona-ne dues."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experiment App Store obsahuje maximálně 3 ošetření. Smazat variantu nebo dvě sloučit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et App Store eksperiment rummer højst 3 behandlinger. Slet en variant eller flet to."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein App Store-Experiment enthält höchstens 3 Treatments. Lösche eine Variante oder führe zwei zusammen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα πείραμα App Store περιέχει το πολύ 3 θεραπείες. Διαγράψτε μια παραλλαγή ή συγχωνεύστε δύο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un experimento del App Store admite como máximo 3 tratamientos. Elimina una variante o combina dos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر آزمایش App Store حداکثر ۳ نسخه آزمایشی دارد. یک نسخه را حذف کنید یا دو نسخه را ادغام کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kokeeseen App Store mahtuu enintään 3 hoitoa. Poista muunnelma tai yhdistä kaksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une expérience de l’App Store contient au maximum 3 traitements. Supprimez une variante ou fusionnez-en deux."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એક App Store પ્રયોગ વધુમાં વધુ 3 સારવાર ધરાવે છે. એક પ્રકાર કાઢી નાખો અથવા બે મર્જ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניסוי App Store מכיל לכל היותר 3 טיפולים. מחק וריאנט או מיזוג שניים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक App Store प्रयोग में अधिकतम 3 उपचार होते हैं। एक वैरिएंट हटाएं या दो को मर्ज करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksperiment App Store ima najviše 3 tretmana. Izbrišite varijantu ili spojite dvije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy App Store kísérlet legfeljebb 3 kezelést tartalmaz. Változat törlése vagy kettő egyesítése."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksperimen App Store menampung maksimal 3 perlakuan. Hapus varian atau gabungkan dua."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un esperimento App Store contiene al massimo 3 trattamenti. Elimina una variante o uniscine due."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store の実験に含められるトリートメントは最大 3 件です。バリアントを削除するか、2 つを統合してください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store ಪ್ರಯೋಗವು ಹೆಚ್ಚೆಂದರೆ 3 ಚಿಕಿತ್ಸೆಗಳನ್ನು ಹೊಂದಿದೆ. ರೂಪಾಂತರವನ್ನು ಅಳಿಸಿ ಅಥವಾ ಎರಡನ್ನು ವಿಲೀನಗೊಳಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 실험에는 트리트먼트를 최대 3개까지 넣을 수 있습니다. 변형을 삭제하거나 두 개를 합치세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരു App Store പരീക്ഷണത്തിന് പരമാവധി 3 ചികിത്സകൾ ഉണ്ട്. ഒരു വേരിയൻ്റ് ഇല്ലാതാക്കുക അല്ലെങ്കിൽ രണ്ടെണ്ണം ലയിപ്പിക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एका App Store प्रयोगात जास्तीत जास्त 3 उपचार असतात. एक प्रकार हटवा किंवा दोन विलीन करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percubaan App Store memegang paling banyak 3 rawatan. Padamkan varian atau gabungkan dua."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een experiment van App Store omvat maximaal drie behandelingen. Verwijder een variant of voeg er twee samen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et App Store eksperiment inneholder maksimalt 3 behandlinger. Slett en variant eller slå sammen to."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksperyment App Store obejmuje maksymalnie 3 zabiegi. Usuń wariant lub połącz dwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um experimento da App Store comporta no máximo 3 tratamentos. Exclua uma variante ou junte duas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",

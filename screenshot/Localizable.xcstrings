        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una volta registrati, i font compaiono nel selettore dei font delle forme di testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登録したフォントは、テキスト図形のフォントピッカーに表示されます。"

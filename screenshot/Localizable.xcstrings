        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaimportowano klucz prywatny. App Store Connect umożliwia pobranie klucza .p8 tylko raz, więc przechowuj oryginalny plik w bezpiecznym miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chave privada importada. O App Store Connect só permite baixar uma chave .p8 uma vez, então guarde o arquivo original em um lugar seguro."

    "Set backgrounds, colors, and gradients, and fine-tune every element to match your brand." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estableix fons, colors i degradats, i afina cada element perquè coincideixi amb la teva marca."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstil baggrunde, farver og gradienter, og finjuster hvert element, så det matcher dit brand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege Hintergründe, Farben und Verläufe fest und passe jedes Element an deine Marke an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta fondos, colores y degradados, y perfecciona cada elemento para reflejar tu marca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پس‌زمینه‌ها، رنگ‌ها و گرادیان‌ها را تنظیم کنید و هر عنصر را متناسب با برند خود دقیق تنظیم کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta taustat, värit ja liukuvärit ja hienosäädä jokainen elementti brändiäsi vastaaviksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez les arrière-plans, les couleurs et les dégradés, et affinez chaque élément en fonction de votre marque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta sfondi, colori e sfumature e perfeziona ogni elemento in base al tuo brand."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景、色、グラデーションを設定し、ブランドに合わせてすべての要素を微調整します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경, 색상, 그라디언트를 설정하고 브랜드에 맞게 모든 요소를 세밀하게 조정하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel achtergronden, kleuren en verlopen in en stem elk element af zodat het bij uw merk past."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angi bakgrunner, farger og gradienter, og finjuster hvert element for å matche merket ditt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina planos de fundo, cores e gradientes e ajuste cada elemento para combinar com sua marca."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina planos de fundo, cores e gradientes e ajuste cada elemento para combinar com sua marca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настраивайте фоны, цвета и градиенты и подгоняйте каждый элемент под свой бренд."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställ in bakgrunder, färger och övertoningar och finjustera varje element för att matcha ditt varumärke."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka planları, renkleri ve renk geçişlerini ayarlayın; her öğeyi markanıza uyacak şekilde ince ayarlayın."
          }

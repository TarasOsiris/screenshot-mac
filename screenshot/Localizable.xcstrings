    "Enlarge the text box, shorten the translation, or turn on Shrink to Fit." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتكبير مربع النص أو تقصير الترجمة أو تشغيل Shrink to Fit."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পাঠ্য বাক্সটি বড় করুন, অনুবাদটি ছোট করুন বা ফিট থেকে সঙ্কুচিত করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amplieu el quadre de text, reduïu la traducció o activeu Redueix per ajustar-lo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvětšete textové pole, zkraťte překlad nebo zapněte možnost Zmenšit na míru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forstør tekstfeltet, forkort oversættelsen, eller slå Krymp til at passe til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergrößere das Textfeld, kürze die Übersetzung oder aktiviere „Passend verkleinern“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεγεθύνετε το πλαίσιο κειμένου, συντομεύστε τη μετάφραση ή ενεργοποιήστε το Shrink to Fit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agranda el cuadro de texto, acorta la traducción o activa Reducir para ajustar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کادر متن را بزرگ‌تر کنید، ترجمه را کوتاه کنید یا «کوچک‌سازی برای جا شدن» را روشن کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suurenna tekstiruutua, lyhennä käännöstä tai ota käyttöön Shrink to Fit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrandissez le cadre de texte, raccourcissez la traduction ou activez Réduire pour ajuster."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ટેક્સ્ટ બૉક્સને મોટું કરો, અનુવાદને ટૂંકો કરો અથવા Fit માટે સંકોચો ચાલુ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדל את תיבת הטקסט, קצר את התרגום או הפעל את ה-Shrink to Fit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टेक्स्ट बॉक्स को बड़ा करें, अनुवाद को छोटा करें, या श्रिंक टू फिट को चालू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povećajte tekstualni okvir, skratite prijevod ili uključite Shrink to Fit."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagyítsa fel a szövegmezőt, rövidítse le a fordítást, vagy kapcsolja be a Shrink to Fit funkciót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perbesar kotak teks, perpendek terjemahan, atau aktifkan Kecilkan agar Sesuai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingrandisci il riquadro di testo, accorcia la traduzione o attiva Riduci per adattare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキスト枠を広げるか、翻訳を短くするか、「縮小して合わせる」をオンにしてください。"
          }

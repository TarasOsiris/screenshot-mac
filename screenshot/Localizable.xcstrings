    "All other languages will be re-anchored to it as translations." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tots els altres idiomes s'hi tornaran a ancorar com a traduccions."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle andre sprog vil blive genforankret til det som oversættelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle anderen Sprachen werden dann als Übersetzungen dieser Sprache geführt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los demás idiomas pasarán a ser traducciones de este."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همهٔ زبان‌های دیگر از این پس ترجمهٔ آن به شمار می‌آیند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki muut kielet ankkuroidaan siihen uudelleen käännöksinä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les autres langues y seront rattachées en tant que traductions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le altre lingue verranno riallineate su di essa come traduzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのすべての言語は、この言語の翻訳として設定し直されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 모든 언어는 이 언어를 기준으로 한 번역이 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle andere talen zullen er als vertalingen opnieuw aan worden verankerd."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle andre språk vil bli forankret til det som oversettelser."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os outros idiomas passarão a ser traduções dele."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os outros idiomas serão reancorados a ele como traduções."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все остальные языки будут привязаны к нему как переводы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla andra språk kommer att återförankras till den som översättningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diğer tüm diller çeviri olarak buna göre yeniden bağlanacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",

    "Keep the script's name (%@) and save it inside the Application Scripts folder." : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserveu el nom de l'script (%1$@) i deseu-lo a la carpeta Application Scripts."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behold scriptets navn (%1$@), og gem det i mappen Application Scripts."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalten Sie den Namen des Skripts (%1$@) bei und speichern Sie es im Ordner „Anwendungsskripte“."
          }
        },
        "es" : {
          "stringUnit" : {

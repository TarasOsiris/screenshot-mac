          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крапки замінюють ваш токен доступу — скопійований текст містить справжній."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

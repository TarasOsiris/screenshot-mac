    "Replaces ^[%lld screenshot](inflect: true) already in this row." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستبدل لقطة الشاشة ^[%1$lld] (inflect: true) الموجودة بالفعل في هذا الصف."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitueix la ^[%1$lld captura de pantalla](inflect: true) que ja hi ha en aquesta fila."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahrazuje ^[%1$lld snímek obrazovky](inflect: true) již v tomto řádku."

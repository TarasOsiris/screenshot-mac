    "They're part of the test until you remove them in App Store Connect." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie bleiben Teil des Tests, bis du sie in App Store Connect entfernst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguirán en la prueba hasta que las quites en App Store Connect."
          }
        },

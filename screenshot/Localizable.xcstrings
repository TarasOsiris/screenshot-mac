    "Hold **⇧** while resizing to lock aspect ratio." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مع الاستمرار على **⇧** أثناء تغيير الحجم لتأمين نسبة العرض إلى الارتفاع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আকার অনুপাত লক করার জন্য আকার পরিবর্তন করার সময় **⇧** ধরে রাখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manteniu premut **⇧** mentre canvieu la mida per bloquejar la relació d'aspecte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržením **⇧** při změně velikosti uzamknete poměr stran."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold **⇧** nede, mens du ændrer størrelse for at låse billedformat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie **⇧** gedrückt, während Sie die Größe ändern, um das Seitenverhältnis zu sperren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρατήστε πατημένο το **⇧** ενώ αλλάζετε το μέγεθος για να κλειδώσετε την αναλογία διαστάσεων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenga presionado **⇧** mientras cambia el tamaño para bloquear la relación de aspecto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام تغییر اندازه برای قفل کردن نسبت تصویر، **⇧** را نگه دارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä **⇧** painettuna, kun muutat kokoa lukitaksesi kuvasuhteen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez **⇧** pendant le redimensionnement pour verrouiller les proportions."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સાપેક્ષ ગુણોત્તરને લૉક કરવા માટે માપ બદલતી વખતે **⇧** પકડી રાખો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החזק **⇧** תוך כדי שינוי גודל כדי לנעול את יחס הגובה-רוחב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहलू अनुपात को लॉक करने के लिए आकार बदलते समय **⇧** दबाए रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držite **⇧** dok mijenjate veličinu kako biste zaključali omjer slike."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsa lenyomva a **⇧** gombot, miközben átméretez a képarány rögzítéséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan **⇧** sambil mengubah ukuran untuk mengunci rasio aspek."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイズ変更中に**⇧**を押したままにして、アスペクト比をロックします。"
          }
        },
        "kn" : {
          "stringUnit" : {

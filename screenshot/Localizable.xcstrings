        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس قطار کے نام پر رکھا گیا جس سے اسے کاپی کیا گیا تھا — دونوں کا نام تبدیل کرنے کے لیے اس قطار کا نام تبدیل کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",

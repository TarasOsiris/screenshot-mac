    },
    "It has run, so its screenshots are final. Choose New Experiment to test new ones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist bereits gelaufen, daher sind die Screenshots endgültig. Wähle „Neues Experiment“, um neue zu testen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya se ejecutó, así que sus capturas son definitivas. Elige Nuevo experimento para probar otras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجرا شده است، پس اسکرین‌شات‌های آن نهایی هستند. برای آزمایش موارد جدید «آزمایش جدید» را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle a déjà été lancée : ses captures sont définitives. Choisissez Nouvelle expérience pour en tester d’autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È già stato eseguito, quindi i suoi screenshot sono definitivi. Scegli Nuovo esperimento per testarne di nuovi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行済みのため、スクリーンショットは確定しています。新しいものをテストするには「新しい実験」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 실행되어 스크린샷이 확정되었습니다. 새 스크린샷을 테스트하려면 새 실험을 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já foi executado, então as capturas são definitivas. Escolha Novo experimento para testar outras."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он уже проводился, поэтому его скриншоты окончательные. Выберите «Новый эксперимент», чтобы протестировать новые."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu deney çalıştırıldı, bu yüzden ekran görüntüleri kesinleşti. Yenilerini test etmek için Yeni Deney'i seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Експеримент уже відбувся, тож його знімки екрана остаточні. Виберіть «Новий експеримент», щоб перевірити нові."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该实验已运行，截图已定稿。选择“新实验”以测试新的截图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此實驗已執行過，因此其螢幕截圖已定案。請選擇「新實驗」來測試新的螢幕截圖。"
          }
        }
      }
    },

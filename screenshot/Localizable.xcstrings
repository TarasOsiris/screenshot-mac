    "Version %@ is %@ — metadata can't be changed. Pick an editable version or create a new one in App Store Connect." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %1$@ ist %2$@ – Metadaten können nicht geändert werden. Wählen Sie eine bearbeitbare Version oder erstellen Sie eine neue in App Store Connect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versión %1$@ está %2$@: los metadatos no se pueden cambiar. Elige una versión editable o crea una nueva en App Store Connect."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخه %1$@ %2$@ است — ابرداده قابل تغییر نیست. یک نسخه قابل ویرایش انتخاب کنید یا در App Store Connect نسخه جدیدی ایجاد کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version %1$@ est %2$@ — les métadonnées ne peuvent pas être modifiées. Choisissez une version modifiable ou créez-en une nouvelle dans App Store Connect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versione %@ è nello stato %@: i metadati non possono essere modificati. Scegli una versione modificabile o creane una nuova in App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バージョン %1$@ は %2$@ です。メタデータは変更できません。編集可能なバージョンを選択するか、App Store Connect で新しいバージョンを作成してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버전 %1$@은(는) %2$@ 상태입니다 — 메타데이터를 변경할 수 없습니다. 편집 가능한 버전을 선택하거나 App Store Connect에서 새 버전을 만드세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A versão %1$@ está %2$@ — os metadados não podem ser alterados. Escolha uma versão editável ou crie uma nova em App Store Connect."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версия %@ в статусе «%@» — метаданные изменить нельзя. Выберите редактируемую версию или создайте новую в App Store Connect."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sürümünün durumu: %@ — meta veriler değiştirilemez. Düzenlenebilir bir sürüm seçin veya App Store Connect'te yeni bir sürüm oluşturun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версія %@ має стан «%@» — метадані не можна змінити. Виберіть версію, доступну для редагування, або створіть нову в App Store Connect."
          }
        },

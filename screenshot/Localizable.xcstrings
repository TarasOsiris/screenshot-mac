        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 행이 없으므로 이번 업로드로 %@ 스크린샷이 바뀌지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak mempunyai baris %1$@, jadi muat naik ini tidak mengubah tangkapan skrin %2$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heeft geen rij %1$@, dus deze upload verandert niets aan de %2$@ schermafbeeldingen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har ingen %1$@ rad, så denne opplastingen endrer ikke %2$@ skjermbilder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zawiera wiersza %1$@, więc przesyłanie nie powoduje zmiany zrzutów ekranu %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não tem linha de %@, então este envio não altera as capturas de %@."

          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er dette som gjør oppsett som en enkelt overskrift som flyter over to skjermbilder mulig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

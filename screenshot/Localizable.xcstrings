          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelin toimii `127.0.0.1`:llä (vain silmukka) – se ei ole tavoitettavissa muista tietokoneista tai Internetistä."

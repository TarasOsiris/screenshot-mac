        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點陣影像和 SVG 影像都可以作為背景。"
          }
        }
      }
    },
    "Both render identically in the editor preview and in the exported PNG." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide werden in der Editor-Vorschau und im exportierten PNG identisch gerendert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos se muestran de manera idéntica en la vista previa del editor y en el [[TERM_0] exportado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",

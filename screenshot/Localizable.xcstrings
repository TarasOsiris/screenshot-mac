    "When checkout is done, click **Open Screenshot Bro** and Pro unlocks on this Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الانتهاء من الدفع، انقر فوق **فتح Screenshot Bro** وسيتم فتح Pro في هذا Mac."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চেকআউট হয়ে গেলে, **ওপেন Screenshot Bro** এ ক্লিক করুন এবং এই Mac এ প্রো আনলক করে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",

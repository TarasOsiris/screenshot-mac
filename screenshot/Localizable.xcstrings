    "^[%lld A/B variant row](inflect: true) won't be uploaded to your product page." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%1$lld La fila de variant A/B](inflect: true) no es penjarà a la pàgina del producte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%1$lld A/B-variantrækken](inflect: true) vil ikke blive uploadet til din produktside."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%lld A/B-Variantenzeile](inflect: true) wird nicht auf deine Produktseite hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%lld fila de variante A/B](inflect: true) no se subirá a tu página de producto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld ردیف نسخه A/B در صفحه محصول شما آپلود نمی‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%1$lld A/B-version riviä](inflect: true) ei lähetetä tuotesivullesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%lld ligne de variante A/B](inflect: true) ne sera pas envoyée vers votre page produit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun caricamento nella pagina del prodotto per ^[%lld riga](inflect: true) di varianti A/B."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A/B バリアントの %lld 行はプロダクトページにアップロードされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A/B 변형 행 %lld개는 제품 페이지에 업로드되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%1$lld A/B-variantrij](inflect: true) wordt niet geüpload naar uw productpagina."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%1$lld A/B-variantrad](inflect: true) blir ikke lastet opp til produktsiden din."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%lld linha de variante A/B](inflect: true) não será enviada para a página do produto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%1$lld linha da variante A/B](inflect: true) não será enviada para a página do seu produto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[Строки A/B-вариантов](inflect: true), которые не будут загружены на страницу продукта: %lld."

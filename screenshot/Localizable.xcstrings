    "**⌘D** duplicates the selected row. **Duplicate Row** is in the row menu too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌘D** dupliziert die ausgewählte Zeile. **Zeile duplizieren** befindet sich auch im Zeilenmenü."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌘D** duplica la fila seleccionada. **Duplicar fila** también está en el menú de la fila."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌘D** ردیف انتخاب‌شده را تکثیر می‌کند. **تکثیر ردیف** در منوی ردیف هم هست."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌘D** duplique la ligne sélectionnée. **Dupliquer la ligne** se trouve également dans le menu des lignes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌘D** duplica la riga selezionata. **Duplica riga** si trova anche nel menu della riga."
          }
        },
        "ja" : {
          "stringUnit" : {

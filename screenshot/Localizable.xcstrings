      }
    },
    "This removes all translated text and language-specific image overrides for %@, so the project uses the base language text and images again." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això elimina tot el text traduït i les substitucions d'imatges específiques de l'idioma per a %1$@, de manera que el projecte torna a utilitzar el text i les imatges de l'idioma base."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette fjerner al oversat tekst og sprogspecifikke billedtilsidesættelser for %1$@, så projektet bruger grundsprogets tekst og billeder igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle übersetzten Texte und sprachspezifischen Bildüberschreibungen für %1$@ entfernt, sodass das Projekt wieder den Text und die Bilder in der Basissprache verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina todo el texto traducido y las anulaciones de imágenes específicas del idioma para %1$@, por lo que el proyecto vuelve a utilizar el texto y las imágenes del idioma base."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با این کار همهٔ متن‌های ترجمه‌شده و بازنویسی‌های تصویرِ مخصوص زبان برای %1$@ حذف می‌شوند و پروژه دوباره از متن و تصاویر زبان پایه استفاده می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä poistaa kaikki käännetyn tekstin ja kielikohtaisten kuvien ohitukset kohteelta %1$@, joten projekti käyttää uudelleen peruskielen tekstiä ja kuvia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime tout le texte traduit et les images propres à la langue pour %1$@ : le projet utilise à nouveau le texte et les images de la langue de base."
          }
        },
        "it" : {

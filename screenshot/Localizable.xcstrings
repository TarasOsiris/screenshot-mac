    "Hide apps with no editable App Store version. Apps in review or already live can't accept new screenshots until you create a new version." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إخفاء التطبيقات التي لا تحتوي على إصدار App Store قابل للتعديل. لا يمكن للتطبيقات قيد المراجعة أو الموجودة بالفعل قبول لقطات شاشة جديدة حتى تقوم بإنشاء إصدار جديد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সম্পাদনাযোগ্য App Store সংস্করণ ছাড়াই অ্যাপ্লিকেশানগুলি লুকান৷ আপনি একটি নতুন সংস্করণ তৈরি না করা পর্যন্ত পর্যালোচনা করা বা ইতিমধ্যে লাইভ থাকা অ্যাপগুলি নতুন স্ক্রিনশট গ্রহণ করতে পারে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amaga les aplicacions sense versió editable de App Store. Les aplicacions en revisió o que ja estan en funcionament no poden acceptar noves captures de pantalla fins que no creeu una versió nova."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrýt aplikace bez upravitelné verze App Store. Zkontrolované nebo již aktivní aplikace nemohou přijímat nové snímky obrazovky, dokud nevytvoříte novou verzi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul apps uden nogen redigerbar App Store version. Apps i gennemgang eller allerede live kan ikke acceptere nye skærmbilleder, før du opretter en ny version."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps ohne bearbeitbare App Store-Version ausblenden. Apps in Prüfung oder bereits live können erst neue Screenshots annehmen, wenn du eine neue Version erstellst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απόκρυψη εφαρμογών χωρίς επεξεργάσιμη έκδοση App Store. Οι εφαρμογές που εξετάζονται ή είναι ήδη ζωντανές δεν μπορούν να δεχτούν νέα στιγμιότυπα οθόνης μέχρι να δημιουργήσετε μια νέα έκδοση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar las apps sin una versión editable del App Store. Las apps en revisión o ya publicadas no pueden aceptar nuevas capturas hasta que crees una nueva versión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه‌هایی که نسخهٔ قابل ویرایش App Store ندارند پنهان می‌شوند. برنامه‌های در حال بازبینی یا منتشرشده تا وقتی نسخهٔ جدیدی ایجاد نکنید اسکرین‌شات جدید نمی‌پذیرند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piilota sovellukset, joissa ei ole muokattavaa App Store-versiota. Tarkistuksessa olevat tai jo julkaistut sovellukset eivät voi hyväksyä uusia kuvakaappauksia ennen kuin luot uuden version."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer les apps sans version App Store modifiable. Les apps en cours d'examen ou déjà en ligne ne peuvent pas recevoir de nouvelles captures d'écran tant que vous n'avez pas créé de nouvelle version."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સંપાદનયોગ્ય App Store સંસ્કરણ વિનાની એપ્લિકેશનો છુપાવો. જ્યાં સુધી તમે નવું વર્ઝન ન બનાવો ત્યાં સુધી રિવ્યૂમાં અથવા પહેલેથી લાઇવ ઍપ નવા સ્ક્રીનશૉટ્સ સ્વીકારી શકશે નહીં."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסתר אפליקציות ללא גרסת App Store ניתנת לעריכה. אפליקציות בבדיקה או שכבר פועלות לא יכולות לקבל צילומי מסך חדשים עד שתיצור גרסה חדשה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना संपादन योग्य App Store संस्करण वाले ऐप्स छुपाएं। जब तक आप नया संस्करण नहीं बनाते तब तक समीक्षाधीन या पहले से मौजूद ऐप्स नए स्क्रीनशॉट स्वीकार नहीं कर सकते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sakrij aplikacije bez verzije App Store koja se može uređivati. Aplikacije koje se pregledavaju ili su već aktivne ne mogu prihvatiti nove snimke zaslona dok ne izradite novu verziju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A App Store szerkeszthető verziójával nem rendelkező alkalmazások elrejtése. A felülvizsgálat alatt álló vagy már működő alkalmazások nem fogadhatnak el új képernyőképeket, amíg nem hoz létre új verziót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembunyikan aplikasi tanpa versi App Store yang dapat diedit. Aplikasi yang sedang ditinjau atau sudah ditayangkan tidak dapat menerima tangkapan layar baru sampai Anda membuat versi baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascondi le app senza una versione App Store modificabile. Le app in revisione o già pubblicate non possono ricevere nuovi screenshot finché non crei una nuova versione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集可能な App Store バージョンがないアプリを非表示にします。審査中または公開済みのアプリは、新しいバージョンを作成するまで新しいスクリーンショットを受け付けません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಯಾವುದೇ ಸಂಪಾದಿಸಬಹುದಾದ App Store ಆವೃತ್ತಿಯೊಂದಿಗೆ ಅಪ್ಲಿಕೇಶನ್‌ಗಳನ್ನು ಮರೆಮಾಡಿ. ನೀವು ಹೊಸ ಆವೃತ್ತಿಯನ್ನು ರಚಿಸುವವರೆಗೆ ಪರಿಶೀಲನೆಯಲ್ಲಿರುವ ಅಥವಾ ಈಗಾಗಲೇ ಲೈವ್ ಆಗಿರುವ ಅಪ್ಲಿಕೇಶನ್‌ಗಳು ಹೊಸ ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ಗಳನ್ನು ಸ್ವೀಕರಿಸುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집 가능한 App Store 버전이 없는 앱을 숨깁니다. 심사 중이거나 이미 출시된 앱은 새 버전을 만들기 전까지 새 스크린샷을 받을 수 없습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "എഡിറ്റുചെയ്യാനാകുന്ന App Store പതിപ്പ് ഇല്ലാതെ ആപ്പുകൾ മറയ്ക്കുക. നിങ്ങൾ ഒരു പുതിയ പതിപ്പ് സൃഷ്‌ടിക്കുന്നത് വരെ അവലോകനത്തിലോ ഇതിനകം തത്സമയത്തിലോ ഉള്ള ആപ്പുകൾക്ക് പുതിയ സ്‌ക്രീൻഷോട്ടുകൾ സ്വീകരിക്കാൻ കഴിയില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संपादन करण्यायोग्य App Store आवृत्ती नसलेले ॲप्स लपवा. तुम्ही नवीन आवृत्ती तयार करेपर्यंत पुनरावलोकनात असलेले किंवा आधीच लाइव्ह असलेले ॲप्स नवीन स्क्रीनशॉट स्वीकारू शकत नाहीत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembunyikan apl tanpa versi App Store yang boleh diedit. Apl dalam semakan atau sudah disiarkan tidak boleh menerima tangkapan skrin baharu sehingga anda membuat versi baharu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verberg apps zonder bewerkbare App Store-versie. Apps die worden beoordeeld of die al live zijn, kunnen pas nieuwe schermafbeeldingen accepteren nadat u een nieuwe versie heeft gemaakt."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul apper uten redigerbar App Store-versjon. Apper som er gjennomgått eller allerede er aktive, kan ikke godta nye skjermbilder før du oppretter en ny versjon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukryj aplikacje bez wersji App Store, którą można edytować. Aplikacje sprawdzane lub już aktywne nie mogą akceptować nowych zrzutów ekranu, dopóki nie utworzysz nowej wersji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta apps sem versão editável na App Store. Apps em revisão ou já publicados não aceitam novas capturas de tela até você criar uma nova versão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculte aplicativos sem versão editável App Store. Os aplicativos em revisão ou já ativos não podem aceitar novas capturas de ecrã até que você crie uma nova versão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascundeți aplicațiile fără o versiune editabilă a App Store. Aplicațiile aflate în reexaminare sau deja live nu pot accepta noi capturi de ecran până când nu creați o versiune nouă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрыть приложения без редактируемой версии в App Store. Приложения на проверке или уже опубликованные не принимают новые скриншоты, пока вы не создадите новую версию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skryť aplikácie bez upraviteľnej verzie App Store. Kontrolované alebo už aktívne aplikácie nemôžu prijímať nové snímky obrazovky, kým nevytvoríte novú verziu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrij aplikacije brez različice App Store, ki jo je mogoče urejati. Aplikacije v pregledu ali že objavljene ne morejo sprejeti novih posnetkov zaslona, ​​dokler ne ustvarite nove različice."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dölj appar utan redigerbar App Store version. Appar som granskas eller redan är aktiva kan inte acceptera nya skärmdumpar förrän du skapar en ny version."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "திருத்தக்கூடிய App Store பதிப்பு இல்லாத பயன்பாடுகளை மறைக்கவும். நீங்கள் புதிய பதிப்பை உருவாக்கும் வரை மதிப்பாய்வில் உள்ள அல்லது ஏற்கனவே நேரலையில் உள்ள ஆப்ஸ் புதிய ஸ்கிரீன் ஷாட்களை ஏற்காது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సవరించదగిన App Store సంస్కరణ లేకుండా అనువర్తనాలను దాచండి. మీరు కొత్త వెర్షన్‌ని సృష్టించే వరకు సమీక్షలో ఉన్న లేదా ఇప్పటికే లైవ్‌లో ఉన్న యాప్‌లు కొత్త స్క్రీన్‌షాట్‌లను అంగీకరించవు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซ่อนแอปที่ไม่มีเวอร์ชัน App Store ที่แก้ไขได้ แอปที่อยู่ระหว่างการตรวจสอบหรือเผยแพร่แล้วไม่สามารถยอมรับภาพหน้าจอใหม่ได้จนกว่าคุณจะสร้างเวอร์ชันใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenlenebilir App Store sürümü olmayan uygulamaları gizle. İncelemedeki veya zaten yayında olan uygulamalar, siz yeni bir sürüm oluşturana kadar yeni ekran görüntüsü kabul edemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сховати програми без версії App Store, яку можна редагувати. Програми на перевірці або вже опубліковані не можуть приймати нові знімки екрана, доки ви не створите нову версію."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قابل تدوین App Store ورژن کے بغیر ایپس کو چھپائیں۔ جائزہ میں یا پہلے سے لائیو ایپس اس وقت تک نئے اسکرین شاٹس قبول نہیں کر سکتیں جب تک آپ نیا ورژن نہیں بناتے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẩn ứng dụng không có phiên bản App Store có thể chỉnh sửa. Các ứng dụng đang được xem xét hoặc đã hoạt động không thể chấp nhận ảnh chụp màn hình mới cho đến khi bạn tạo phiên bản mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏没有可编辑 App Store 版本的 App。在你创建新版本之前，正在审核或已上线的 App 无法接受新截图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱藏沒有可編輯 App Store 版本的 App。審查中或已上架的 App 在你建立新版本之前無法接受新的螢幕截圖。"
          }
        }
      }
    },
    "Hide apps with no editable App Store version. Apps that are already live can't accept metadata changes until you create a new version." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إخفاء التطبيقات التي لا تحتوي على إصدار App Store قابل للتعديل. لا يمكن للتطبيقات الموجودة بالفعل قبول تغييرات البيانات التعريفية حتى تقوم بإنشاء إصدار جديد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সম্পাদনাযোগ্য App Store সংস্করণ ছাড়াই অ্যাপ্লিকেশানগুলি লুকান৷ আপনি একটি নতুন সংস্করণ তৈরি না করা পর্যন্ত যে অ্যাপগুলি ইতিমধ্যেই লাইভ রয়েছে সেগুলি মেটাডেটা পরিবর্তনগুলি গ্রহণ করতে পারে না৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amaga les aplicacions sense versió editable de App Store. Les aplicacions que ja estan en directe no poden acceptar canvis de metadades fins que no creeu una versió nova."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrýt aplikace bez upravitelné verze App Store. Aplikace, které jsou již aktivní, nemohou přijímat změny metadat, dokud nevytvoříte novou verzi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul apps uden nogen redigerbar App Store version. Apps, der allerede er live, kan ikke acceptere metadataændringer, før du opretter en ny version."

        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å hjelpe oss med å reprodusere, vennligst ta med:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para nos ajudar a reproduzir, inclua:"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para nos ajudar a reproduzir, inclua:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы мы могли воспроизвести проблему, укажите:"

    "It has run, so its screenshots are final. Choose New Experiment to test new ones." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'ha executat, de manera que les seves captures de pantalla són definitives. Trieu Experiment nou per provar-ne de nous."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den har kørt, så dens skærmbilleder er endelige. Vælg Nyt eksperiment for at teste nye."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist bereits gelaufen, daher sind die Screenshots endgültig. Wähle „Neues Experiment“, um neue zu testen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya se ejecutó, así que sus capturas son definitivas. Elige Nuevo experimento para probar otras."

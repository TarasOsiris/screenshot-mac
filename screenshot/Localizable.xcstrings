    "%@ · %@ uses %lld image file(s) that could not be read, so the screenshots would upload with missing content. Re-add the affected images, then try again." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · يستخدم %2$@ ملف (ملفات) صورة %3$lld لا يمكن قراءتها، لذلك سيتم تحميل لقطات الشاشة مع محتوى مفقود. أعد إضافة الصور المتأثرة، ثم حاول مرة أخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ utilitza %3$lld fitxers d'imatge que no s'han pogut llegir, de manera que les captures de pantalla es penjaran amb contingut que falta. Torneu a afegir les imatges afectades i torneu-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ používá soubory obrázků %3$lld, které nelze přečíst, takže by se snímky obrazovky nahrály s chybějícím obsahem. Znovu přidejte dotčené obrázky a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ bruger %3$lld billedfil(er), der ikke kunne læses, så skærmbillederne ville uploades med manglende indhold. Tilføj de berørte billeder igen, og prøv derefter igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ verwendet %3$lld Bilddateien, die nicht gelesen werden konnten, sodass die Screenshots mit fehlendem Inhalt hochgeladen wurden. Fügen Sie die betroffenen Bilder erneut hinzu und versuchen Sie es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · Το %2$@ χρησιμοποιεί %3$lld αρχεία εικόνας που δεν ήταν δυνατό να διαβαστούν, επομένως τα στιγμιότυπα οθόνης θα μεταφορτώνονται με περιεχόμενο που λείπει. Προσθέστε ξανά τις επηρεαζόμενες εικόνες και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@ uses %3$lld image file(s) that could not be read, so the screenshots would upload with missing content. Re-add the affected images, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ utiliza %3$lld archivo(s) de imagen que no se pueden leer, por lo que las capturas de pantalla se cargarían con contenido faltante. Vuelva a agregar las imágenes afectadas y vuelva a intentarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ از %3$lld فایل(های) تصویری استفاده می کند که قابل خواندن نیستند، بنابراین اسکرین شات ها با محتوای گم شده آپلود می شوند. تصاویر آسیب دیده را دوباره اضافه کنید، سپس دوباره امتحان کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ käyttää %3$lld kuvatiedostoja, joita ei voitu lukea, joten kuvakaappaukset ladataan ilman sisältöä. Lisää uudelleen vahingoittuneet kuvat ja yritä sitten uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ utilise %3$lld fichier(s) image qui n'ont pas pu être lus, de sorte que les captures d'écran seraient téléchargées avec le contenu manquant. Ajoutez à nouveau les images concernées, puis réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ משתמש ב-%3$lld קבצי תמונה שלא ניתן היה לקרוא, כך שצילומי המסך יועלו עם תוכן חסר. הוסף מחדש את התמונות המושפעות ולאחר מכן נסה שוב."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ koristi %3$lld slikovnu(e) datoteku(e) koje se ne mogu pročitati, pa bi se snimke zaslona učitale sa sadržajem koji nedostaje. Ponovno dodajte zahvaćene slike, a zatim pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · Az %2$@ %3$lld képfájlo(ka)t használ, amelyek nem olvashatók, így a képernyőképek hiányzó tartalommal töltenének fel. Adja hozzá újra az érintett képeket, majd próbálja újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ menggunakan %3$lld file gambar yang tidak dapat dibaca, sehingga tangkapan layar akan diunggah dengan konten yang hilang. Tambahkan kembali gambar yang terpengaruh, lalu coba lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ は読み取れなかった %3$lld 画像ファイルを使用しているため、スクリーンショットはコンテンツが欠落した状態でアップロードされます。影響を受けるイメージを再度追加して、再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@은(는) 읽을 수 없는 %3$lld 이미지 파일을 사용하므로 콘텐츠가 누락된 스크린샷이 업로드됩니다. 영향을 받은 이미지를 다시 추가한 후 다시 시도하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ menggunakan %3$lld fail imej yang tidak boleh dibaca, jadi tangkapan skrin akan dimuat naik dengan kandungan yang tiada. Tambahkan semula imej yang terjejas, kemudian cuba lagi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ gebruikt %3$lld afbeeldingsbestanden die niet konden worden gelezen, waardoor de schermafbeeldingen zouden worden geüpload met ontbrekende inhoud. Voeg de betreffende afbeeldingen opnieuw toe en probeer het opnieuw."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ bruker %3$lld bildefil(er) som ikke kunne leses, så skjermbildene vil lastes opp med manglende innhold. Legg til de berørte bildene på nytt, og prøv på nytt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ używa %3$lld plików obrazów, których nie można odczytać, więc zrzuty ekranu zostaną przesłane z brakującą zawartością. Dodaj ponownie obrazy, których to dotyczy, i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ usa %3$lld arquivo(s) de imagem que não puderam ser lidos, então as capturas de tela seriam carregadas com conteúdo ausente. Adicione novamente as imagens afetadas e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ usa %3$lld ficheiro(s) de imagem que não puderam ser lidos, então as capturas de ecrã seriam carregadas com conteúdo ausente. Adicione novamente as imagens afetadas e tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ utilizează %3$lld fișiere imagine care nu au putut fi citite, astfel încât capturile de ecran s-ar încărca cu conținut lipsă. Adăugați din nou imaginile afectate, apoi încercați din nou."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ používa %3$lld obrazové súbory, ktoré sa nedajú prečítať, takže snímky obrazovky by sa odovzdali s chýbajúcim obsahom. Znova pridajte dotknuté obrázky a skúste to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ uporablja slikovne datoteke %3$lld, ki jih ni bilo mogoče prebrati, zato bi se posnetki zaslona naložili z manjkajočo vsebino. Znova dodajte prizadete slike in poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ använder %3$lld bildfil(er) som inte kunde läsas, så skärmdumparna laddas upp med saknat innehåll. Lägg till de berörda bilderna igen och försök sedan igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ ใช้ไฟล์ภาพ %3$lld ที่ไม่สามารถอ่านได้ ดังนั้นภาพหน้าจอจึงอัปโหลดโดยมีเนื้อหาขาดหายไป เพิ่มรูปภาพที่ได้รับผลกระทบอีกครั้ง จากนั้นลองอีกครั้ง"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏ متاثرہ تصاویر کو دوبارہ شامل کریں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ sử dụng (các) tệp hình ảnh %3$lld không thể đọc được nên ảnh chụp màn hình sẽ tải lên với nội dung bị thiếu. Hãy thêm lại các hình ảnh bị ảnh hưởng rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ 使用无法读取的 %3$lld 图像文件，因此上传的屏幕截图会缺少内容。重新添加受影响的图像，然后重试。"
          }
        }
      }
    },

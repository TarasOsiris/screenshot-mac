    "Resize the row to one of: %@, or pick a matching display type." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvieu la mida de la fila a una de: %1$@, o trieu un tipus de visualització que coincideixi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilpas rækkens størrelse til en af: %1$@, eller vælg en matchende visningstype."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändere die Zeile auf eine dieser Größen: %@, oder wähle einen passenden Anzeigetyp."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia el tamaño de la fila a uno de estos: %@, o elige un tipo de pantalla compatible."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اندازه ردیف را به یکی از این موارد تغییر دهید: %@، یا نوع نمایش سازگار انتخاب کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuta rivin kokoa johonkin seuraavista: %1$@ tai valitse vastaava näyttötyyppi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redimensionnez la ligne vers l’une de ces tailles : %@, ou choisissez un type d’affichage correspondant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ridimensiona la riga a una di queste dimensioni: %@, oppure scegli un tipo di display corrispondente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行サイズを次のいずれかに変更するか、対応する表示タイプを選択してください: %@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "행 크기를 다음 중 하나로 조정하거나 일치하는 디스플레이 유형을 선택하세요: %@."
          }
        },
        "nl" : {
          "stringUnit" : {

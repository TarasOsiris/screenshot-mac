    "Color, gradient, or image — at row or template level." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللون أو التدرج أو الصورة — على مستوى الصف أو القالب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রঙ, গ্রেডিয়েন্ট বা চিত্র — সারি বা টেমপ্লেট স্তরে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color, degradat o imatge: a nivell de fila o plantilla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barva, přechod nebo obrázek — na úrovni řádku nebo šablony."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farve, gradient eller billede - på række- eller skabelonniveau."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farbe, Verlauf oder Bild – für die Zeile oder die einzelne Vorlage."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρώμα, διαβάθμιση ή εικόνα — σε επίπεδο γραμμής ή προτύπου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color, degradado o imagen, a nivel de fila o plantilla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رنگ، گرادیان یا تصویر — در سطح ردیف یا اسکرین‌شات."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väri, liukuväri tai kuva – rivi- tai mallitasolla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couleur, dégradé ou image – au niveau de la ligne ou du modèle."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "રંગ, ઢાળ અથવા છબી — પંક્તિ અથવા નમૂના સ્તર પર."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צבע, מעבר או תמונה - ברמת השורה או התבנית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रंग, ग्रेडिएंट, या छवि - पंक्ति या टेम्पलेट स्तर पर।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boja, gradijent ili slika — na razini retka ili predloška."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szín, színátmenet vagy kép – sor vagy sablon szinten."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warna, gradien, atau gambar — pada tingkat baris atau templat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colore, sfumatura o immagine, a livello di riga o di modello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色、グラデーション、画像 — 行単位またはテンプレート単位で設定できます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಬಣ್ಣ, ಗ್ರೇಡಿಯಂಟ್ ಅಥವಾ ಚಿತ್ರ - ಸಾಲು ಅಥವಾ ಟೆಂಪ್ಲೇಟ್ ಮಟ್ಟದಲ್ಲಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "색상, 그라디언트 또는 이미지 — 행 또는 템플릿 단위로."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിറം, ഗ്രേഡിയൻ്റ് അല്ലെങ്കിൽ ചിത്രം - വരി അല്ലെങ്കിൽ ടെംപ്ലേറ്റ് തലത്തിൽ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रंग, ग्रेडियंट किंवा प्रतिमा — पंक्ती किंवा टेम्पलेट स्तरावर."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warna, kecerunan atau imej — pada peringkat baris atau templat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleur, verloop of afbeelding — op rij- of sjabloonniveau."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farge, gradient eller bilde - på rad- eller malnivå."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolor, gradient lub obraz — na poziomie wiersza lub szablonu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor, gradiente ou imagem — no nível da linha ou do modelo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor, gradiente ou imagem — no nível da linha ou do modelo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Culoare, gradient sau imagine — la nivel de rând sau șablon."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цвет, градиент или изображение — для строки или отдельного шаблона."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farba, prechod alebo obrázok – na úrovni riadku alebo šablóny."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barva, preliv ali slika — na ravni vrstice ali predloge."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färg, övertoning eller bild — på rad- eller mallnivå."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நிறம், சாய்வு அல்லது படம் — வரிசை அல்லது டெம்ப்ளேட் மட்டத்தில்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "రంగు, గ్రేడియంట్ లేదా ఇమేజ్ — అడ్డు వరుస లేదా టెంప్లేట్ స్థాయిలో."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สี การไล่ระดับสี หรือรูปภาพ — ที่ระดับแถวหรือเทมเพลต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renk, renk geçişi veya görüntü — satır ya da şablon düzeyinde."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",

    "Play keeps one screenshot set per language — turn all but one of them off." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ Play بمجموعة لقطة شاشة واحدة لكل لغة - قم بإيقاف تشغيلها جميعًا باستثناء واحدة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play manté una captura de pantalla establerta per idioma; desactiveu-les totes menys una."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play uchovává jeden snímek obrazovky pro každý jazyk – všechny kromě jednoho vypněte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play beholder ét skærmbillede pr. sprog – slå alle undtagen ét af dem fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play speichert ein Screenshot-Set pro Sprache – schalte alle bis auf eine aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Play διατηρεί ένα σύνολο στιγμιότυπων οθόνης ανά γλώσσα — απενεργοποιήστε όλα εκτός από ένα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play guarda un único conjunto de capturas por idioma: desactívalos todos menos uno."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play برای هر زبان فقط یک مجموعه اسکرین‌شات نگه می‌دارد — همه را به‌جز یکی خاموش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play säilyttää yhden kuvakaappauksen kielelle asetettuna – poista kaikki paitsi yksi niistä käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play conserve un seul ensemble de captures d'écran par langue : désactivez-les toutes sauf une."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play שומרת צילום מסך אחד לכל שפה - כבה את כולם מלבד אחד."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play čuva jedan skup snimaka zaslona po jeziku — isključite sve osim jednog."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Play nyelvenként egy képernyőképet tart meg – egy kivételével mindegyiket kapcsolja ki."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play mengatur satu tangkapan layar per bahasa — nonaktifkan semuanya kecuali satu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play conserva un set di screenshot per lingua: disattivale tutte tranne una."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play で保持できるスクリーンショットセットは言語ごとに1つだけです。1つを残してほかはオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play는 언어당 스크린샷 세트를 하나만 유지합니다. 하나만 남기고 나머지는 끄세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play menyimpan satu set tangkapan skrin bagi setiap bahasa — matikan semua kecuali satu daripadanya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

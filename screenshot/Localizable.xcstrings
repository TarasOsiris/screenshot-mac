          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva almeno una riga da caricare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップロードする行を1つ以上有効にしてください。"

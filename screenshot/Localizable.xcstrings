        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Параметри ▸ Автоматизація ▸ Увімкнути сервер MCP.** Типово вимкнено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

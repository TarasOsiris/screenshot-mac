    "**Orientation** flips the row between portrait and landscape by swapping width and height." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**الاتجاه** يقلب الصف بين الوضع الرأسي والأفقي من خلال تبديل العرض والارتفاع."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Orientació** canvia la fila entre el retrat i el paisatge canviant l'amplada i l'alçada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Orientace** převrací řádek mezi na výšku a na šířku prohozením šířky a výšky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Orientering** vender rækken mellem stående og liggende ved at skifte bredde og højde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Ausrichtung** wechselt die Zeile zwischen Hoch- und Querformat, indem Breite und Höhe getauscht werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο **Προσανατολισμός** ανατρέπει τη σειρά μεταξύ κατακόρυφου και οριζόντιου προσανατολισμού εναλλάσσοντας το πλάτος και το ύψος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Orientación** cambia la fila entre vertical y horizontal intercambiando el ancho y el alto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**جهت** با جابه‌جا کردن عرض و ارتفاع، ردیف را بین عمودی و افقی تغییر می‌دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Suunta** kääntää rivin pysty- ja vaakakuvan välillä vaihtamalla leveyttä ja korkeutta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Orientation** inverse la ligne entre portrait et paysage en échangeant la largeur et la hauteur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**כיוון** הופך את השורה בין דיוקן לנוף על ידי החלפת רוחב וגובה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Orijentacija** prebacuje redak između okomitog i pejzažnog položaja zamjenom širine i visine."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az **Tájolás** a szélesség és a magasság felcserélésével átfordítja a sort az álló és fekvő kép között."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",

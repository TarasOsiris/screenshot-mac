        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌘]** / **⌘[** چرخه رو به جلو/عقب از طریق زبان ها."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

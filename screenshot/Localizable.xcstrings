    "**Fill** — scales to cover; crops anything that doesn't fit." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**ملء** — المقاييس المراد تغطيتها؛ المحاصيل أي شيء لا يصلح."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Omplir** — escates per cobrir; talla qualsevol cosa que no encaixi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Fill** — šupiny k zakrytí; ořezává vše, co se nehodí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Fyld** — skalaer til at dække; beskærer alt, der ikke passer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Füllen** – skaliert, bis die Fläche bedeckt ist, und schneidet ab, was nicht passt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Γέμισμα** — ζυγαριά για κάλυψη. καλλιεργεί οτιδήποτε δεν ταιριάζει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Rellenar**: escala hasta cubrir el área y recorta lo que no cabe."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**پرکردن** — تصویر را بزرگ می‌کند تا کل ناحیه را بپوشاند و هر چه بیرون بماند بریده می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Täytä** — asteikko peittyy; viljelee kaikkea, mikä ei sovi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Remplir** : met à l'échelle pour couvrir toute la zone et rogne ce qui dépasse."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**מילוי** - קשקשים לכיסוי; חותך כל דבר שלא מתאים."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Ispuna** — ljuske za pokrivanje; usjeva sve što ne odgovara."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Töltsd** — lefedő mérleg; mindent bevet, ami nem illik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Isi** — skala untuk menutupi; memotong apa pun yang tidak sesuai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Riempi**: ridimensiona per coprire tutto e ritaglia ciò che non entra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**カバー** — 全体を覆うように拡大/縮小し、はみ出た部分は切り取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**채우기** — 영역을 덮도록 크기를 조정하고, 넘치는 부분은 잘라냅니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Isi** — penimbang untuk menutup; tanam apa-apa yang tidak sesuai."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Vul** — schubben om te bedekken; snijdt alles af wat niet past."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Fyll** — skalaer for å dekke; beskjærer alt som ikke passer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Wypełnienie** — łuski do pokrycia; przycina wszystko, co nie pasuje."

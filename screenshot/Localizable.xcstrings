          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരേ വരി രണ്ടുതവണ എക്‌സ്‌പോർട്ടുചെയ്യുക - 9:16 പോസ്റ്റിനായി ഒരിക്കൽ **സ്റ്റോറി** ആയും ലിങ്ക് പ്രിവ്യൂവിനായി ഒരിക്കൽ **സോഷ്യൽ** ആയും. ലേഔട്ട് ക്രോപ്പ് ചെയ്യുന്നതിന് പകരം ഓരോ വീക്ഷണാനുപാതത്തിനും അനുയോജ്യമാണ്."

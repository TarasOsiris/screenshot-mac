    "Select the shape, then click the image well in the properties bar to pick a file, or drag and drop directly onto the shape." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد الشكل، ثم انقر فوق الصورة جيدًا في شريط الخصائص لاختيار ملف، أو قم بالسحب والإسقاط مباشرة على الشكل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আকৃতিটি নির্বাচন করুন, তারপরে একটি ফাইল বাছাই করতে বৈশিষ্ট্য বারে ছবিটিতে ভালভাবে ক্লিক করুন, বা টেনে আনুন এবং সরাসরি আকৃতিতে ড্রপ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleccioneu la forma i, a continuació, feu clic a la imatge a la barra de propietats per triar un fitxer o arrossegueu i deixeu anar directament a la forma."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte tvar a poté kliknutím na obraz v pruhu vlastností vyberte soubor nebo přetáhněte přímo na tvar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg formen, og klik derefter på billedet i egenskabslinjen for at vælge en fil, eller træk og slip direkte på figuren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle die Form aus und klicke in der Eigenschaftenleiste auf das Bildfeld, um eine Datei auszuwählen, oder zieh sie direkt auf die Form."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε το σχήμα και, στη συνέχεια, κάντε κλικ στην εικόνα καλά στη γραμμή ιδιοτήτων για να επιλέξετε ένα αρχείο ή σύρετε και αποθέστε απευθείας στο σχήμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona la forma y haz clic en el área de imagen de la barra de propiedades para elegir un archivo, o arrástralo directamente sobre la forma."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شکل را انتخاب کنید، سپس روی کادر تصویر در نوار ویژگی‌ها کلیک کنید تا فایلی برگزینید، یا فایل را مستقیماً روی شکل بکشید و رها کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse muoto ja napsauta sitten kuvaa ominaisuuspalkissa valitaksesi tiedoston tai vedä ja pudota suoraan muotoon."

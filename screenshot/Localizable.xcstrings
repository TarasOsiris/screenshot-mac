        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Xóa tất cả** xóa mọi hình dạng của một loại. **Đặt lại hàng** làm trống hàng; **Xóa hàng** xóa nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

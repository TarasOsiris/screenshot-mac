            "value" : "Esta acción no se puede deshacer."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این قابل واگرد نیست."
          }
        },
        "fr" : {
          "stringUnit" : {

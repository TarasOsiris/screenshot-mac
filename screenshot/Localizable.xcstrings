    "1. Create a new project from a template, or start blank." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. أنشئ مشروعًا جديدًا من قالب، أو ابدأ فارغًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. একটি টেমপ্লেট থেকে একটি নতুন প্রকল্প তৈরি করুন, বা ফাঁকা শুরু করুন৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Creeu un projecte nou a partir d'una plantilla o comenceu en blanc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Vytvořte nový projekt ze šablony nebo začněte naprázdno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Opret et nyt projekt fra en skabelon, eller start tom."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Erstelle ein neues Projekt aus einer Vorlage oder beginne mit einem leeren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Δημιουργήστε ένα νέο έργο από ένα πρότυπο ή ξεκινήστε το κενό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Crea un proyecto a partir de una plantilla o empieza en blanco."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. پروژهٔ جدیدی از یک قالب بسازید، یا با پروژهٔ خالی شروع کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Luo uusi projekti mallista tai aloita tyhjältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Créez un projet à partir d'un modèle, ou partez de zéro."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. નમૂનામાંથી નવો પ્રોજેક્ટ બનાવો અથવા ખાલી શરૂ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. צור פרויקט חדש מתבנית, או התחל ריק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. टेम्पलेट से एक नया प्रोजेक्ट बनाएं, या खाली प्रारंभ करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Napravite novi projekt iz predloška ili počnite isprazni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Hozzon létre egy új projektet sablonból, vagy kezdje üresen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Buat proyek baru dari template, atau mulai dari awal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Crea un nuovo progetto da un modello, oppure parti da zero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. テンプレートから新しいプロジェクトを作成するか、空の状態から始めます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. ಟೆಂಪ್ಲೇಟ್‌ನಿಂದ ಹೊಸ ಯೋಜನೆಯನ್ನು ರಚಿಸಿ ಅಥವಾ ಖಾಲಿಯಾಗಿ ಪ್ರಾರಂಭಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 템플릿으로 새 프로젝트를 만들거나 빈 프로젝트로 시작합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. ഒരു ടെംപ്ലേറ്റിൽ നിന്ന് ഒരു പുതിയ പ്രോജക്റ്റ് സൃഷ്ടിക്കുക, അല്ലെങ്കിൽ ശൂന്യമായി ആരംഭിക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. टेम्पलेटवरून नवीन प्रकल्प तयार करा किंवा रिक्त सुरू करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Buat projek baharu daripada templat, atau mulakan kosong."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Maak een nieuw project op basis van een sjabloon, of begin blanco."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Opprett et nytt prosjekt fra en mal, eller start tomt."
          }
        },
        "pl" : {

          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**ترتیبات ▸ آٹومیشن ▸ MCP سرور کو فعال کریں۔ ** یہ بطور ڈیفالٹ آف ہے۔"
          }
        },
        "vi" : {

    "Pick a different App Store locale for one of them, or turn one off." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trieu una App Store configuració regional diferent per a una d'elles o desactiveu-ne una."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en anden App Store landestandard for en af dem, eller slå en fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle für eine davon eine andere App Store-Sprache oder schalte eine aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige otro idioma de App Store para uno de ellos o desactiva uno."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای یکی از آن‌ها زبان App Store دیگری انتخاب کنید، یا یکی را خاموش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse yhdelle niistä toinen App Store-kieli tai poista se käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une autre localisation App Store pour l'une d'elles, ou désactivez-en une."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una lingua App Store diversa per una di esse, oppure disattivane una."

          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect はスクリーンショットのアップロードを拒否しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect 스크린샷 업로드를 거부했습니다."
          }
        },

    "%lld screenshots must be removed first to stay within Apple's 10-screenshot limit." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld يجب إزالة لقطات الشاشة أولاً لتظل ضمن الحد الأقصى لعدد لقطات الشاشة الذي حددته Apple وهو 10 لقطات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-এর 10-স্ক্রিনশট সীমার মধ্যে থাকার জন্য প্রথমে %1$lld স্ক্রিনশটগুলি সরাতে হবে৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",

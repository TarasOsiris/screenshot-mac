    "Drop in screenshots, add text and shapes, pick a device frame. Drag to arrange." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بإسقاط لقطات الشاشة وإضافة النصوص والأشكال واختيار إطار الجهاز. اسحب للترتيب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্ক্রিনশট ড্রপ করুন, পাঠ্য এবং আকার যোগ করুন, একটি ডিভাইস ফ্রেম চয়ন করুন। সাজানোর জন্য টেনে আনুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegiu captures de pantalla, afegiu text i formes, seleccioneu un marc de dispositiu. Arrossegueu per organitzar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vložte snímky obrazovky, přidejte text a tvary, vyberte rámeček zařízení. Uspořádejte přetažením."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drop skærmbilleder, tilføj tekst og former, vælg en enhedsramme. Træk for at arrangere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Screenshots ein, ergänze Text und Formen und wähle einen Geräterahmen. Zum Anordnen ziehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρίξτε στιγμιότυπα οθόνης, προσθέστε κείμενο και σχήματα, επιλέξτε ένα πλαίσιο συσκευής. Σύρετε για να τακτοποιήσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suelta capturas, añade texto y formas, y elige un marco de dispositivo. Arrastra para organizar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسکرین‌شات‌ها را رها کنید، متن و شکل اضافه کنید و قاب دستگاه را انتخاب کنید. برای چیدن، بکشید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pudota kuvakaappauksia, lisää tekstiä ja muotoja, valitse laitekehys. Järjestä vetämällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déposez des captures d'écran, ajoutez du texte et des formes, choisissez un cadre d'appareil. Faites glisser pour organiser."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સ્ક્રીનશૉટ્સ મૂકો, ટેક્સ્ટ અને આકારો ઉમેરો, ઉપકરણ ફ્રેમ પસંદ કરો. ગોઠવવા માટે ખેંચો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הכנס צילומי מסך, הוסף טקסט וצורות, בחר מסגרת של מכשיר. גרור לסידור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रीनशॉट डालें, टेक्स्ट और आकार जोड़ें, एक डिवाइस फ़्रेम चुनें। व्यवस्थित करने के लिए खींचें."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubacite snimke zaslona, dodajte tekst i oblike, odaberite okvir uređaja. Povucite za raspored."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helyezzen be képernyőképeket, adjon hozzá szöveget és alakzatokat, válasszon eszközkeretet. Húzza az elrendezéshez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan tangkapan layar, tambahkan teks dan bentuk, pilih bingkai perangkat. Seret untuk mengatur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci gli screenshot, aggiungi testo e forme, scegli una cornice del dispositivo. Trascina per disporre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットをドロップし、テキストや図形を追加して、デバイスフレームを選びます。ドラッグして配置できます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ಗಳನ್ನು ಬಿಡಿ, ಪಠ್ಯ ಮತ್ತು ಆಕಾರಗಳನ್ನು ಸೇರಿಸಿ, ಸಾಧನದ ಚೌಕಟ್ಟನ್ನು ಆರಿಸಿ. ವ್ಯವಸ್ಥೆ ಮಾಡಲು ಎಳೆಯಿರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크린샷을 넣고, 텍스트와 도형을 추가하고, 기기 프레임을 선택하세요. 드래그하여 배치하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സ്ക്രീൻഷോട്ടുകൾ ഇടുക, വാചകവും രൂപങ്ങളും ചേർക്കുക, ഒരു ഉപകരണ ഫ്രെയിം തിരഞ്ഞെടുക്കുക. ക്രമീകരിക്കാൻ വലിച്ചിടുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रीनशॉट टाका, मजकूर आणि आकार जोडा, डिव्हाइस फ्रेम निवडा. व्यवस्था करण्यासाठी ड्रॅग करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan tangkapan skrin, tambah teks dan bentuk, pilih bingkai peranti. Seret untuk mengatur."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg schermafbeeldingen toe, voeg tekst en vormen toe, kies een apparaatframe. Sleep om te ordenen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slipp inn skjermbilder, legg til tekst og former, velg en enhetsramme. Dra for å arrangere."
          }

          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To uporabi prevod iz osnovnega jezika za vsako plast besedila v %1$@ in nadomesti trenutno prevedeno besedilo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta tillämpar översättning från basspråket till varje textlager i %1$@ och ersätter den aktuella översatta texten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดำเนินการนี้จะนำการแปลจากภาษาพื้นฐานไปใช้กับทุกเลเยอร์ข้อความใน %1$@ และแทนที่ข้อความที่แปลในปัจจุบัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem, temel dilden çeviriyi %@ dilindeki her metin katmanına uygular ve geçerli çevrilmiş metnin yerine koyar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця дія застосує переклад із базової мови до кожного текстового шару мовою «%@» і замінить поточний перекладений текст."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ بنیادی زبان سے %1$@ میں ہر متنی پرت پر ترجمہ لاگو کرتا ہے اور موجودہ ترجمہ شدہ متن کو بدل دیتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều này áp dụng bản dịch từ ngôn ngữ cơ sở cho mọi lớp văn bản trong %1$@ và thay thế văn bản đã dịch hiện tại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会将基准语言的翻译应用到 %@ 中的每个文本图层，并替换当前已翻译的文本。"

        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect yüklenen bir ekran görüntüsünü hâlâ işliyor. Birkaç dakika bekleyip yeniden yükleyin — App Store Connect’e zaten ulaşmış ekran görüntüleri ikinci kez yüklenmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect ще обробляє завантажений знімок екрана. Зачекайте кілька хвилин і завантажте знову — знімки, які вже потрапили до App Store Connect, не буде завантажено вдруге."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

    "1 current screenshot has no App Store checksum, so it will be replaced instead of preserved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 لقطة شاشة حالية لا تحتوي على مجموع اختباري App Store، لذلك سيتم استبدالها بدلاً من الاحتفاظ بها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1টি বর্তমান স্ক্রিনশটের কোন App Store চেকসাম নেই, তাই এটি সংরক্ষণের পরিবর্তে প্রতিস্থাপন করা হবে৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 captura de pantalla actual no té App Store suma de comprovació, de manera que es substituirà en lloc de conservar-la."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 aktuální snímek obrazovky nemá kontrolní součet App Store, takže bude nahrazen namísto zachování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 nuværende skærmbillede har ingen App Store kontrolsum, så det vil blive erstattet i stedet for at blive bevaret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 aktueller Screenshot hat keine App Store-Prüfsumme und wird daher ersetzt statt beibehalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 τρέχον στιγμιότυπο οθόνης δεν έχει App Store άθροισμα ελέγχου, επομένως θα αντικατασταθεί αντί να διατηρηθεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 captura actual no tiene suma de verificación del App Store, así que se reemplazará en lugar de conservarse."
          }
        },
        "fa" : {
          "stringUnit" : {

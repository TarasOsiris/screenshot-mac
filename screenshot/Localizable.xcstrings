    "Return to the plan and review the screenshots again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارجع إلى الخطة وراجع لقطات الشاشة مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরিকল্পনায় ফিরে যান এবং স্ক্রিনশটগুলি আবার পর্যালোচনা করুন৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna al pla i revisa les captures de pantalla de nou."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraťte se k plánu a znovu si prohlédněte snímky obrazovky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vend tilbage til planen og gennemse skærmbillederne igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehre zum Plan zurück und prüfe die Screenshots erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιστρέψτε στο σχέδιο και ελέγξτε ξανά τα στιγμιότυπα οθόνης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve al plan y revisa las capturas de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به طرح برگردید و اسکرین‌شات‌ها را دوباره بازبینی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palaa suunnitelmaan ja tarkista kuvakaappaukset uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revenez au plan et examinez de nouveau les captures d'écran."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "યોજના પર પાછા ફરો અને ફરીથી સ્ક્રીનશોટની સમીક્ષા કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חזור לתוכנית ועיין שוב בצילומי המסך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "योजना पर वापस लौटें और स्क्रीनशॉट की दोबारा समीक्षा करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vratite se na plan i ponovno pregledajte snimke zaslona."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Térjen vissza a tervhez, és tekintse át újra a képernyőképeket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kembali ke rencana dan tinjau kembali tangkapan layar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna al piano e rivedi di nuovo gli screenshot."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プランに戻って、スクリーンショットをもう一度確認してください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಯೋಜನೆಗೆ ಹಿಂತಿರುಗಿ ಮತ್ತು ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ಗಳನ್ನು ಮತ್ತೊಮ್ಮೆ ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획으로 돌아가 스크린샷을 다시 검토하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പ്ലാനിലേക്ക് മടങ്ങി സ്ക്രീൻഷോട്ടുകൾ വീണ്ടും അവലോകനം ചെയ്യുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "योजनेवर परत या आणि स्क्रीनशॉटचे पुन्हा पुनरावलोकन करा."
          }
        },
        "ms" : {
          "stringUnit" : {

    "Drop in screenshots, add text and shapes, pick a device frame. Drag to arrange." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie Screenshots ein, fügen Sie Text und Formen hinzu und wählen Sie einen Geräterahmen aus. Zum Anordnen ziehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduzca capturas de pantalla, agregue texto y formas, elija un marco de dispositivo. Arrastra para organizar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسکرین شات ها را رها کنید، متن و اشکال اضافه کنید، فریم دستگاه را انتخاب کنید. برای مرتب کردن بکشید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déposez des captures d'écran, ajoutez du texte et des formes, choisissez un cadre d'appareil. Faites glisser pour organiser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci gli screenshot, aggiungi testo e forme, scegli una cornice del dispositivo. Trascina per disporre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットをドロップし、テキストや図形を追加し、デバイスのフレームを選択します。ドラッグして配置します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크린샷을 추가하고, 텍스트와 모양을 추가하고, 장치 프레임을 선택하세요. 드래그하여 정렬하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insira capturas de tela, adicione texto e formas, escolha uma moldura de dispositivo. Arraste para organizar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте скриншоты, текст и фигуры, выберите рамку устройства. Расставьте все перетаскиванием."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran görüntülerini bırakın, metin ve şekil ekleyin, bir aygıt çerçevesi seçin. Düzenlemek için sürükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте знімки екрана, текст і фігури, виберіть рамку пристрою. Перетягуйте, щоб розташувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放入屏幕截图，添加文本和形状，选择设备框架。拖动进行排列。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {

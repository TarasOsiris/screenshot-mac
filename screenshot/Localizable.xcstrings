    "Saved as a draft — not sent for review. Send for review from the Play Console when ready." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Entwurf gespeichert – nicht zur Überprüfung gesendet. Wenn Sie fertig sind, senden Sie es zur Überprüfung über die Play Console."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado como borrador, no enviado para revisión. Envíelo para revisión desde Play Console cuando esté listo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به عنوان پیش نویس ذخیره شد - برای بررسی ارسال نشد. پس از آماده شدن، از کنسول Play برای بررسی ارسال کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré en tant que brouillon – non envoyé pour examen. Envoyez-le pour examen depuis la Play Console lorsque vous êtes prêt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下書きとして保存されました - レビューのために送信されませんでした。準備ができたら、Play Console からレビューのために送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초안으로 저장되었으며 검토를 위해 전송되지 않았습니다. 준비가 되면 Play Console에서 검토를 위해 전송하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo como rascunho — não enviado para revisão. Envie para análise no Play Console quando estiver pronto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存为草稿 — 不发送供审核。准备好后从 Play 管理中心发送以供审核。"
          }
        }
      }
    },

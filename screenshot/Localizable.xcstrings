          "stringUnit" : {
            "state" : "translated",
            "value" : "デモモードがアクティブです。上記の実際の API キー フィールドは、デモ モードをオフにするまで無視されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데모 모드가 활성화되었습니다. 위의 실제 API 키 필드는 데모 모드를 끌 때까지 무시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

            "value" : "이렇게 하면 \"%@\"에서 모든 스크린샷과 도형이 제거되고 기본 설정이 복원됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden alle schermafbeeldingen en vormen van \"%1$@\" verwijderd en worden de standaardinstellingen hersteld."
          }
        },
        "no" : {

        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateikoordination (`NSFileCoordinator`) verhindert Beschädigungen durch gleichzeitige Lese- und Schreibzugriffe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο συντονισμός αρχείων («NSFileCoordinator») αποτρέπει την καταστροφή από ταυτόχρονες αναγνώσεις/εγγραφές."
          }
        },
        "es" : {
          "stringUnit" : {

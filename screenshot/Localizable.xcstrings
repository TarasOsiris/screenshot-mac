        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "જ્યારે આ સંપાદન ચાલુ હતું ત્યારે એપ્લિકેશનમાં %1$@ ખોલવામાં આવ્યું હતું. ફરી પ્રયાસ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",

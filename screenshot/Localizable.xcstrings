    "Render every row in every language as PNG or JPEG, organized into per-language folders — or upload them straight to App Store Connect from here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بعرض كل صف في كل لغة كـ PNG أو JPEG، منظمًا في مجلدات لكل لغة - أو قم بتحميلها مباشرة إلى App Store Connect من هنا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra cada fila en tots els idiomes com a PNG o JPEG, organitzades en carpetes per a cada idioma, o pengeu-les directament a App Store Connect des d'aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykreslete každý řádek v každém jazyce jako PNG nebo JPEG, uspořádané do složek pro jednotlivé jazyky – nebo je odtud rovnou nahrajte do App Store Connect."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gengiv hver række på hvert sprog som PNG eller JPEG, organiseret i mapper pr. sprog – eller upload dem direkte til App Store Connect herfra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendere jede Zeile in jeder Sprache als PNG oder JPEG, sortiert in Ordner pro Sprache – oder lade sie von hier direkt in App Store Connect hoch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποδώστε κάθε σειρά σε κάθε γλώσσα ως PNG ή JPEG, οργανωμένη σε φακέλους ανά γλώσσα — ή μεταφορτώστε τις απευθείας στο App Store Connect από εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderiza cada fila en cada idioma como PNG o JPEG, organizadas en carpetas por idioma, o súbelas directamente a App Store Connect desde aquí."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر ردیف را در هر زبان به‌صورت PNG یا JPEG رندر کنید، مرتب‌شده در پوشه‌های جداگانهٔ هر زبان — یا از همین‌جا مستقیماً در App Store Connect آپلود کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piirrä jokainen rivi kaikilla kielillä muodossa PNG tai JPEG, järjestettynä kielikohtaisiin kansioihin – tai lähetä ne suoraan App Store Connect:aan täältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Générez chaque ligne dans chaque langue au format PNG ou JPEG, rangées dans des dossiers par langue — ou envoyez-les directement vers App Store Connect d'ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עבד כל שורה בכל שפה כ-PNG או JPEG, מאורגנת בתיקיות לכל שפה - או העלה אותן ישירות אל App Store Connect מכאן."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikažite svaki redak na svakom jeziku kao PNG ili JPEG, organiziran u mape po jeziku — ili ih odavde prenesite izravno u App Store Connect."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendeljen meg minden sort minden nyelven PNG vagy JPEG néven, nyelvenkénti mappákba rendezve – vagy töltse fel közvetlenül a App Store Connect-ba innen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Render setiap baris dalam setiap bahasa sebagai PNG atau JPEG, disusun dalam folder per bahasa — atau unggah langsung ke App Store Connect dari sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera ogni riga in ogni lingua come PNG o JPEG, organizzate in cartelle per lingua, oppure caricale direttamente su App Store Connect da qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての言語のすべての行を PNG または JPEG でレンダリングして言語ごとのフォルダに整理するか、ここから App Store Connect に直接アップロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 언어의 모든 행을 언어별 폴더로 구성된 PNG 또는 JPEG로 렌더링하거나 여기에서 App Store Connect에 바로 업로드하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jadikan setiap baris dalam setiap bahasa sebagai PNG atau JPEG, disusun ke dalam folder setiap bahasa — atau muat naik terus ke App Store Connect dari sini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef elke rij in elke taal weer als PNG of JPEG, georganiseerd in mappen per taal, of upload ze vanaf hier rechtstreeks naar App Store Connect."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjengi hver rad på hvert språk som PNG eller JPEG, organisert i per-språk mapper – eller last dem opp rett til App Store Connect herfra."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderuj każdy wiersz w każdym języku jako PNG lub JPEG, zorganizowany w foldery według języków — lub prześlij je bezpośrednio do App Store Connect stąd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderize todas as linhas em todos os idiomas como PNG ou JPEG, organizadas em pastas por idioma — ou envie tudo direto para o App Store Connect daqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderize cada linha em cada idioma como PNG ou JPEG, organizada em pastas por idioma — ou carregue-as diretamente para App Store Connect daqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redați fiecare rând în fiecare limbă ca PNG sau JPEG, organizat în dosare pentru fiecare limbă - sau încărcați-le direct în App Store Connect de aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отрисуйте каждую строку на каждом языке в PNG или JPEG с разбивкой по папкам языков — или загрузите их прямо отсюда в App Store Connect."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykreslite každý riadok v každom jazyku ako PNG alebo JPEG, usporiadané do priečinkov pre jednotlivé jazyky – alebo ich odtiaľto odovzdajte priamo do App Store Connect."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upodobite vsako vrstico v vsakem jeziku kot PNG ali JPEG, organizirano v mape za vsak jezik — ali pa jih od tukaj naložite neposredno v App Store Connect."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återge varje rad på alla språk som PNG eller JPEG, organiserade i mappar per språk – eller ladda upp dem direkt till App Store Connect härifrån."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงผลทุกแถวในทุกภาษาเป็น PNG หรือ JPEG โดยจัดเป็นโฟลเดอร์ตามภาษา — หรืออัปโหลดโดยตรงไปยัง App Store Connect จากที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her satırı her dilde PNG veya JPEG olarak oluşturun ve dillere göre klasörlere düzenleyin — ya da buradan doğrudan App Store Connect'e yükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рендеріть кожен рядок кожною мовою у PNG або JPEG, упорядкованими в папки за мовами, — або вивантажуйте їх прямо звідси в App Store Connect."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر زبان میں ہر قطار کو PNG یا JPEG کے طور پر رینڈر کریں، فی زبان کے فولڈرز میں منظم کریں — یا انہیں یہاں سے سیدھے App Store Connect پر اپ لوڈ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị mọi hàng ở mọi ngôn ngữ dưới dạng PNG hoặc JPEG, được sắp xếp thành các thư mục theo ngôn ngữ — hoặc tải chúng thẳng lên App Store Connect từ đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将每种语言的每一行渲染为 PNG 或 JPEG，并按语言整理到各自的文件夹中——或直接从这里上传到 App Store Connect。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將每種語言的每一列轉譯為 PNG 或 JPEG，並依語言整理到各自的資料夾中——或直接從這裡上傳到 App Store Connect。"
          }
        }
      }
    },

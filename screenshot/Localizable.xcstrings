          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌥** 키를 누른 채 드래그하면 이동하면서 도형이 복제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

    "The toolbar shows an iCloud status icon when an upload or download is in progress." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Symbolleiste zeigt ein iCloud-Statussymbol an, wenn ein Upload oder Download ausgeführt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra de herramientas muestra un ícono de estado iCloud cuando hay una carga o descarga en curso."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نوار ابزار یک نماد وضعیت iCloud را هنگامی که آپلود یا دانلود در حال انجام است نشان می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barre d'outils affiche une icône d'état iCloud lorsqu'un chargement ou un téléchargement est en cours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

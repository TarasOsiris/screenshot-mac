    "In a non-base language, edits are saved as **per-language overrides** — they don't change the base language." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في لغة غير أساسية، يتم حفظ التعديلات باعتبارها **تجاوزات لكل لغة** — فهي لا تغير اللغة الأساسية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un idioma no bàsic, les edicions es guarden com a **substitucions per idioma**: no canvien l'idioma base."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V jiném než základním jazyce se úpravy ukládají jako **přepisy pro jednotlivé jazyky** – nemění základní jazyk."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I et ikke-basissprog gemmes redigeringer som **tilsidesættelser pr. sprog** – de ændrer ikke basissproget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In einer anderen Sprache als der Basissprache werden Änderungen als **sprachspezifische Überschreibungen** gespeichert – die Basissprache bleibt unverändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε μια μη βασική γλώσσα, οι τροποποιήσεις αποθηκεύονται ως **παρακάμψεις ανά γλώσσα** — δεν αλλάζουν τη βασική γλώσσα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un idioma no base, las ediciones se guardan como **anulaciones por idioma**; no cambian el idioma base."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در زبانی غیر از زبان پایه، ویرایش‌ها به‌صورت **بازنویسی‌های مخصوص آن زبان** ذخیره می‌شوند — زبان پایه را تغییر نمی‌دهند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muussa kuin peruskielessä muokkaukset tallennetaan **kielikohtaisina ohituksina** – ne eivät muuta peruskieltä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans une langue autre que la langue de base, les modifications sont enregistrées comme **valeurs propres à la langue** : elles ne modifient pas la langue de base."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בשפה שאינה בסיס, עריכות נשמרות כ**עקיפות לכל שפה** - הן אינן משנות את שפת הבסיס."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U neosnovnom jeziku, izmjene se spremaju kao **poništavanja po jeziku** — ne mijenjaju osnovni jezik."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem alapnyelven a szerkesztések **nyelvenkénti felülírásként** kerülnek mentésre – nem változtatják meg az alapnyelvet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalam bahasa non-dasar, hasil edit disimpan sebagai **penggantian per bahasa** — hasil edit tidak mengubah bahasa dasar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In una lingua diversa da quella di base, le modifiche vengono salvate come **personalizzazioni per lingua** e non cambiano la lingua di base."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本言語以外の言語での編集は **言語ごとの上書き** として保存され、基本言語は変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 언어가 아닌 경우 편집 내용은 **언어별 재정의**로 저장되며 기본 언어는 변경되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalam bahasa bukan asas, suntingan disimpan sebagai **penggantian setiap bahasa** — ia tidak menukar bahasa asas."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In een niet-basistaal worden bewerkingen opgeslagen als **overschrijvingen per taal**; ze veranderen de basistaal niet."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I et ikke-grunnspråk lagres redigeringer som **overstyringer per språk** – de endrer ikke grunnspråket."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W języku innym niż podstawowy zmiany są zapisywane jako **zastąpienia poszczególnych języków** — nie powodują zmiany języka podstawowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em um idioma não base, as edições são salvas como **substituições por idioma** — elas não alteram o idioma base."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em um idioma não base, as edições são guardadas como **substituições por idioma** — elas não alteram o idioma base."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Într-o limbă care nu este de bază, editările sunt salvate ca **inlocuiri pe limbă** - nu schimbă limba de bază."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В небазовом языке правки сохраняются как **переопределения для языка** — базовый язык они не меняют."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V inom ako základnom jazyku sa úpravy uložia ako **nahradenia pre jednotlivé jazyky** – nezmenia základný jazyk."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V neosnovnem jeziku se urejanja shranijo kot **preglasitve glede na jezik** – ne spremenijo osnovnega jezika."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Adicionar captura de tela** e **Adicionar elemento** — adicione uma coluna de modelo ou uma forma sem sair do cabeçalho."
          }
        },
        "ru" : {
          "stringUnit" : {

    },
    "This sidebar always edits the currently selected row — set its screenshot size, background, and device frame, and add text, images, and shapes from the Shapes section." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Seitenleiste bearbeitet immer die aktuell ausgewählte Zeile – legen Sie deren Screenshot-Größe, Hintergrund und Geräterahmen fest und fügen Sie Text, Bilder und Formen aus dem Abschnitt „Formen“ hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta barra lateral siempre edita la fila seleccionada actualmente: establece el tamaño de la captura de pantalla, el fondo y el marco del dispositivo, y agrega texto, imágenes y formas desde la sección Formas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این نوار کناری همیشه ردیف انتخاب شده فعلی را ویرایش می‌کند - اندازه عکس، پس‌زمینه و قاب دستگاه آن را تنظیم کنید و متن، تصاویر و اشکال را از بخش Shapes اضافه کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette barre latérale modifie toujours la ligne actuellement sélectionnée : définissez sa taille de capture d'écran, son arrière-plan et le cadre de son appareil, et ajoutez du texte, des images et des formes à partir de la section Formes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサイドバーは常に、現在選択されている行を編集します。スクリーンショットのサイズ、背景、デバイス フレームを設定し、[図形] セクションからテキスト、画像、図形を追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사이드바는 항상 현재 선택된 행을 편집합니다. 스크린샷 크기, 배경 및 장치 프레임을 설정하고 모양 섹션에서 텍스트, 이미지 및 모양을 추가합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta barra lateral sempre edita a linha atualmente selecionada – defina o tamanho da captura de tela, o plano de fundo e o quadro do dispositivo e adicione texto, imagens e formas da seção Formas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此侧边栏始终编辑当前选定的行 - 设置其屏幕截图大小、背景和设备框架，并从“形状”部分添加文本、图像和形状。"
          }
        }
      }
    },
    "This translation uses custom formatting (colors, bold, sizes). The table edits plain text only — edit it directly on the canvas, or Reset to use the base language." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Übersetzung verwendet benutzerdefinierte Formatierungen (Farben, Fettdruck, Größen). Die Tabelle bearbeitet nur einfachen Text – bearbeiten Sie ihn direkt auf der Leinwand oder setzen Sie ihn zurück, um die Basissprache zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta traducción utiliza formato personalizado (colores, negrita, tamaños). La tabla solo edita texto sin formato: edítelo directamente en el lienzo o restablezca para usar el idioma base."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این ترجمه از قالب بندی سفارشی (رنگ ها، پررنگ، اندازه ها) استفاده می کند. جدول فقط متن ساده را ویرایش می کند - آن را مستقیماً روی بوم ویرایش کنید، یا برای استفاده از زبان پایه، تنظیم مجدد کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette traduction utilise une mise en forme personnalisée (couleurs, gras, tailles). Le tableau modifie uniquement le texte brut : modifiez-le directement sur le canevas ou réinitialisez pour utiliser la langue de base."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この翻訳ではカスタム書式設定 (色、太字、サイズ) が使用されます。テーブルはプレーン テキストのみを編集します。キャンバス上で直接編集するか、リセットして基本言語を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 번역은 사용자 정의 형식(색상, 굵게, 크기)을 사용합니다. 테이블은 일반 텍스트만 편집합니다. 캔버스에서 직접 편집하거나 기본 언어를 사용하려면 재설정하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta tradução usa formatação personalizada (cores, negrito, tamanhos). A tabela edita apenas texto simples — edite-o diretamente na tela ou redefina para usar o idioma base."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此翻译使用自定义格式（颜色、粗体、大小）。该表仅编辑纯文本 - 直接在画布上编辑，或重置以使用基本语言。"
          }
        }
      }
    },

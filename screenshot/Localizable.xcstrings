        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロックされた形状を右クリックし、[**ロック解除**] を選択して形状を元に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠긴 도형을 마우스 오른쪽 버튼으로 클릭하고 **잠금 해제**를 선택하여 다시 가져옵니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito em uma forma bloqueada e escolha **Desbloquear** para recuperá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на заблокированную фигуру правой кнопкой и выберите **Разблокировать**, чтобы вернуть ее."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilitli bir şekli geri almak için ona sağ tıklayıp **Kilidi Aç**'ı seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб повернути замкнену фігуру, клацніть її правою кнопкою й виберіть **Відімкнути**."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右键单击锁定的形状并选择“**解锁**”将其恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對已鎖定的形狀按右鍵並選擇**解鎖**，即可恢復操作。"
          }
        }
      }
    },
    "Right-click a multi-shape selection ▸ **Align Selected** for left / center / right, top / middle / bottom, plus **Distribute Horizontally** and **Distribute Vertically**." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie mit der rechten Maustaste auf eine Auswahl mit mehreren Formen. ▸ **Auswahl ausrichten** für links/mitte/rechts, oben/mitte/unten sowie **Horizontal verteilen** und **Vertikal verteilen**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haga clic con el botón derecho en una selección de varias formas ▸ **Alinear seleccionados** para izquierda/centro/derecha, arriba/medio/abajo, además de **Distribuir horizontalmente** y **Distribuir verticalmente**."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روی یک انتخاب چند شکل کلیک راست کنید ▸ **تراز انتخاب شده** برای چپ / مرکز / راست، بالا / وسط / پایین، به علاوه **توزیع افقی** و **توزیع عمودی**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez avec le bouton droit sur une sélection multi-formes ▸ **Aligner la sélection** pour gauche/centre/droite, haut/milieu/bas, plus **Distribuer horizontalement** et **Distribuer verticalement**."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clic destro su una selezione di più forme ▸ **Allinea selezionate** per sinistra / centro / destra, alto / centro / basso, più **Distribuisci orizzontalmente** e **Distribuisci verticalmente**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数の形状の選択項目を右クリックし、**選択項目の整列**を左/中央/右、上/中央/下に設定し、さらに**水平方向に配置**および**垂直方向に配置**を選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 모양 선택 항목을 마우스 오른쪽 버튼으로 클릭합니다. ▸ 왼쪽/가운데/오른쪽, 위쪽/가운데/아래에 대한 **선택 항목 정렬**과 **수평 분포** 및 **수직 분포**."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito em uma seleção de múltiplas formas ▸ **Alinhar selecionado** para esquerda/centro/direita, superior/meio/inferior, além de **Distribuir horizontalmente** e **Distribuir verticalmente**."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правый клик по выделению из нескольких фигур ▸ **Выровнять выбранное** — по левому краю / центру / правому краю, по верхнему краю / середине / нижнему краю, а также **Распределить по горизонтали** и **Распределить по вертикали**."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birden çok şekil seçiliyken sağ tıklayıp ▸ **Seçilenleri Hizala** ile sola / ortaya / sağa, üste / ortaya / alta hizalayın; ayrıca **Yatay Dağıt** ve **Dikey Dağıt** da vardır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацніть правою кнопкою кілька вибраних фігур ▸ **Вирівняти вибране** — ліворуч / по центру / праворуч, вгору / посередині / вниз, а також **Розподілити по горизонталі** й **Розподілити по вертикалі**."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右键单击多形状选区 ▸ **左/中/右、上/中/下对齐选定对象**，加上**水平分布**和**垂直分布**。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對多重選取的形狀按右鍵 ▸ **對齊所選項目**，可靠左／水平置中／靠右、靠上／垂直置中／靠下對齊，另有**水平分佈**和**垂直分佈**。"
          }
        }
      }
    },
    "Right-click a project card on the Projects screen for **Rename…**, **Star Project**, **Duplicate…**, and **Delete…**." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie mit der rechten Maustaste auf eine Projektkarte auf dem Bildschirm „Projekte“, um **Umbenennen…**, **Star-Projekt**, **Duplizieren…** und **Löschen…** auszuwählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haga clic derecho en una tarjeta de proyecto en la pantalla Proyectos para **Cambiar nombre…**, **Proyecto estrella**, **Duplicar…** y **Eliminar…**."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روی کارت پروژه در صفحه پروژه ها برای **تغییر نام…**، **پروژه ستاره**، **تکراری…**، و **حذف…** کلیک راست کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez avec le bouton droit sur une fiche de projet sur l'écran Projets pour **Renommer…**, **Projet Star**, **Dupliquer…** et **Supprimer…**."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic destro su una scheda progetto nella schermata Progetti per **Rinomina…**, **Aggiungi progetto ai preferiti**, **Duplica…** ed **Elimina…**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[プロジェクト] 画面でプロジェクト カードを右クリックし、**名前の変更...**、**スター プロジェクト**、**複製...**、**削除...** を選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**이름 바꾸기...**, **프로젝트 시작**, **복제...** 및 **삭제...**에 대한 프로젝트 화면에서 프로젝트 카드를 마우스 오른쪽 버튼으로 클릭합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito em um cartão de projeto na tela Projetos para **Renomear…**, **Star Project**, **Duplicar…** e **Excluir…**."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правый клик по карточке проекта на экране «Проекты» — **Переименовать…**, **Отметить проект**, **Дублировать…** и **Удалить…**."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Yeniden Adlandır…**, **Projeyi Yıldızla**, **Çoğalt…** ve **Sil…** için Projeler ekranında bir proje kartına sağ tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацніть правою кнопкою картку проєкту на екрані «Проєкти», щоб побачити **Перейменувати…**, **Позначити проєкт зірочкою**, **Дублювати…** і **Видалити…**."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右键单击“项目”屏幕上的项目卡，可进行“**重命名...**”、“**为项目添加星号**”、“**复制...**”和“**删除...**”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「專案」畫面上對專案卡片按右鍵，即可使用**重新命名…**、**為專案加上星號**、**複製…** 和**刪除…**。"
          }
        }
      }
    },
    "Right-click a project in the picker for rename, duplicate, and delete actions." : {

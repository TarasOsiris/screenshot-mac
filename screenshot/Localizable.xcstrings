          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Släpp flera SVGs på en gång och de faller lite isär istället för att staplas på en plats."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปล่อย SVG หลายอันพร้อมกัน และพวกมันจะแยกออกจากกันเล็กน้อยแทนที่จะซ้อนกันที่จุดเดียว"

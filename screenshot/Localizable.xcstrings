        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối tài khoản dịch vụ Google Play một lần và Screenshot Bro có thể tải ảnh chụp màn hình đã xuất lên danh sách cửa hàng ứng dụng của bạn mà không cần rời khỏi ứng dụng."
          }

      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض شريط الخصائص الخط والوزن والحجم واللون والمحاذاة الأفقية والرأسية وارتفاع الخط وتباعد الأحرف."

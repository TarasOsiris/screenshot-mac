          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Měřítko**: 1×, 2× nebo 3×. App Store a Google Play vyžadují přesné rozměry v pixelech, takže pokud nepotřebujete konkrétně nadrozměrné podklady, ponechte tuto hodnotu 1×."
          }
        },
        "da" : {

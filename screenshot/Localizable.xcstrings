        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לאחר מכן, שלח אותו לבדיקה. אפל סוקרת ניסוי לפני שהוא יכול להתחיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके बाद, इसे समीक्षा के लिए सबमिट करें। Apple किसी प्रयोग को शुरू करने से पहले उसकी समीक्षा करता है."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatim ga pošaljite na pregled. Apple pregledava eksperiment prije nego što može započeti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",

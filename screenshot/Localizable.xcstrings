    "Apple allows at most 10 screenshots in a display-type set; this proposal has %lld." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسمح Apple بـ 10 لقطات شاشة على الأكثر في مجموعة نوع العرض؛ يحتوي هذا الاقتراح على %1$lld."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপল একটি ডিসপ্লে-টাইপ সেটে সর্বাধিক 10টি স্ক্রিনশটের অনুমতি দেয়; এই প্রস্তাবে %1$lld আছে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple permet com a màxim 10 captures de pantalla en un conjunt de tipus de pantalla; aquesta proposta té %1$lld."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple umožňuje maximálně 10 snímků obrazovky v sadě typu zobrazení; tento návrh má %1$lld."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple tillader højst 10 skærmbilleder i et sæt af skærmtype; dette forslag har %1$lld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple erlaubt höchstens 10 Screenshots pro Anzeigetyp-Set; dieser Vorschlag hat %1$lld."
          }
        },
        "el" : {

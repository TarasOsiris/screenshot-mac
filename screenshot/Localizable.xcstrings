    "More than one row is %@. A treatment takes one row per screenshot size — move one to another variant or exclude it from App Store Connect." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Més d'una fila és %1$@. Un tractament requereix una fila per mida de captura de pantalla: moveu-ne una a una altra variant o excloeu-la de App Store Connect."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mere end én række er %1$@. En behandling tager én række pr. skærmbilledestørrelse – flyt en til en anden variant, eller udelad den fra App Store Connect."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr als eine Zeile verwendet %@. Ein Treatment nimmt eine Zeile pro Screenshot-Größe – verschiebe eine in eine andere Variante oder schließe sie von App Store Connect aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay más de una fila %@. Un tratamiento admite una fila por tamaño de captura: mueve una a otra variante o exclúyela de App Store Connect."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بیش از یک ردیف %@ است. هر نسخه آزمایشی برای هر اندازه اسکرین‌شات یک ردیف می‌پذیرد — یکی را به نسخه دیگری منتقل کنید یا آن را از App Store Connect مستثنا کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Useampi kuin yksi rivi on %1$@. Hoito kestää yhden rivin kuvakaappauskokoa kohden – siirrä toinen variantti tai sulje se pois App Store Connect:sta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs lignes sont %@. Un traitement prend une ligne par taille de capture — déplacez-en une vers une autre variante ou excluez-la d’App Store Connect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più di una riga usa %@. Un trattamento accetta una riga per dimensione di screenshot: spostane una in un'altra variante o escludila da App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数の行が %@ です。トリートメントはスクリーンショットのサイズごとに 1 行のみです。1 行を別のバリアントに移動するか、App Store Connect から除外してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@인 행이 둘 이상입니다. 트리트먼트는 스크린샷 크기마다 한 행만 받습니다. 하나를 다른 변형으로 옮기거나 App Store Connect에서 제외하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meer dan één rij is %1$@. Een behandeling duurt één rij per schermgrootte. Verplaats er één naar een andere variant of sluit deze uit van App Store Connect."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mer enn én rad er %1$@. En behandling tar én rad per skjermbildestørrelse – flytt en til en annen variant eller ekskluder den fra App Store Connect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais de uma linha usa %@. Um tratamento aceita uma linha por tamanho de captura — mova uma para outra variante ou exclua-a do App Store Connect."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais de uma linha é %1$@. Um tratamento ocupa uma linha por tamanho de captura de ecrã. Mova uma para outra variante ou exclua-a de App Store Connect."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Несколько строк соответствуют %@. Тестовый вариант принимает одну строку на размер скриншота — переместите одну из них в другой вариант или исключите ее из App Store Connect."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mer än en rad är %1$@. En behandling tar en rad per skärmbildstorlek — flytta en till en annan variant eller exkludera den från App Store Connect."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birden fazla satırın türü %@. Bir alternatif sayfa her ekran görüntüsü boyutu için bir satır alır — birini başka bir varyanta taşıyın veya App Store Connect'ten hariç tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кілька рядків мають тип %@. Тестовий варіант приймає один рядок на розмір знімка екрана — перемістіть один в інший варіант або виключіть його з App Store Connect."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有多行为 %@。每个实验组的每种截图尺寸只能有一行——请将其中一行移到其他变体，或将其从 App Store Connect 中排除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有多列都是 %@。一個處理組每種螢幕截圖大小只能有一列——請將其中一列移到另一個變體，或將其從 App Store Connect 上傳中排除。"
          }
        }
      }
    },
    "More than one row targets %@ · %@ · %@. Choose one row for this set." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Més d'una fila s'orienta a %1$@ · %2$@ · %3$@. Trieu una fila per a aquest conjunt."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mere end én række er målrettet mod %1$@ · %2$@ · %3$@. Vælg en række til dette sæt."
          }
        },
        "de" : {
          "stringUnit" : {

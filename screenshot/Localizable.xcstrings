        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Linear**: escolha início/fim através da roda angular. Adicione quantas paradas desejar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Linear**: escolha início/fim através da roda angular. Adicione quantas paradas desejar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

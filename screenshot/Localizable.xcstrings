          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el menú desplegable **Formas** del inspector para añadir un rectángulo, un círculo o una estrella."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای افزودن مستطیل، دایره یا ستاره، از منوی کشویی **شکل‌ها** در بازرس استفاده کنید."

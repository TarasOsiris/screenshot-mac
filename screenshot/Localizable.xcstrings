            "value" : "Denna skärmdumps fil saknas. Lägg till bilden igen för att återställa den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ekran görüntüsünün dosyası eksik. Geri yüklemek için görüntüyü yeniden ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл цього знімка екрана відсутній. Додайте зображення знову, щоб відновити його."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此截图的文件缺失。重新添加图像即可恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此螢幕截圖的檔案遺失。重新加入影像即可恢復。"
          }
        }
      }
    },
    "This service account can't edit that app. Grant it access in the Play Console." : {
      "localizations" : {

    "Open a project to replay the tour — its steps point at the editor." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح مشروعًا لإعادة تشغيل الجولة - حيث تشير خطواته إلى المحرر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ট্যুরটি রিপ্লে করার জন্য একটি প্রজেক্ট খুলুন — এর ধাপগুলি সম্পাদকের দিকে নির্দেশ করে৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obriu un projecte per reproduir el recorregut: els seus passos apunten a l'editor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřete projekt a přehrajte si prohlídku – její kroky směřují do editoru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn et projekt for at afspille rundturen - dets trin peger på editoren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne ein Projekt, um die Tour erneut zu starten – ihre Schritte zeigen auf den Editor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίξτε ένα έργο για επανάληψη της περιήγησης — τα βήματά της δείχνουν προς τον επεξεργαστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre un proyecto para repetir el recorrido; sus pasos señalan partes del editor."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای پخش دوبارهٔ تور، یک پروژه باز کنید — مراحل آن به بخش‌های ویرایشگر اشاره می‌کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa projekti toistaaksesi kiertomatkan – sen vaiheet osoittavat editorissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez un projet pour revoir la visite : ses étapes désignent des éléments de l'éditeur."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ટૂરને રિપ્લે કરવા માટે એક પ્રોજેક્ટ ખોલો — તેના પગલાં સંપાદક પર નિર્દેશ કરે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתח פרויקט כדי להפעיל מחדש את הסיור - הצעדים שלו מצביעים על העורך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दौरे को दोबारा चलाने के लिए एक प्रोजेक्ट खोलें - इसके चरण संपादक की ओर इशारा करते हैं।"
          }
        },
        "hr" : {

        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekti muuttui esikatselun luomisen jälkeen. Päivitä arvostelu ennen synkronointia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

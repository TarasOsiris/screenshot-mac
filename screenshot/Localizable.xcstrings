            "value" : "**Зображення** — додайте будь-який PNG / JPEG / SVG. Виберіть режим заповнення та налаштуйте непрозорість."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**图像**——导入任意 PNG / JPEG / SVG。选择填充模式并调整不透明度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

    "All projects will be copied to iCloud. Initial sync may take time for large projects." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم نسخ كافة المشاريع إلى iCloud. قد تستغرق المزامنة الأولية وقتًا للمشاريع الكبيرة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সমস্ত প্রকল্প iCloud এ কপি করা হবে৷ বড় প্রকল্পের জন্য প্রাথমিক সিঙ্কে সময় লাগতে পারে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tots els projectes es copiaran a iCloud. La sincronització inicial pot trigar un temps per a projectes grans."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny projekty budou zkopírovány do iCloud. U velkých projektů může počáteční synchronizace chvíli trvat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle projekter vil blive kopieret til iCloud. Indledende synkronisering kan tage tid for store projekter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Projekte werden nach iCloud kopiert. Bei großen Projekten kann die erste Synchronisierung einige Zeit dauern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα τα έργα θα αντιγραφούν στο iCloud. Ο αρχικός συγχρονισμός μπορεί να πάρει χρόνο για μεγάλα έργα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los proyectos se copiarán a iCloud. La sincronización inicial puede tardar con proyectos grandes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همه پروژه‌ها در iCloud کپی می‌شوند. همگام‌سازی اولیه ممکن است برای پروژه‌های بزرگ زمان ببرد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki projektit kopioidaan kohteeseen iCloud. Alkuperäinen synkronointi voi viedä aikaa suurissa projekteissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les projets seront copiés dans iCloud. La synchronisation initiale peut prendre du temps pour les grands projets."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "બધા પ્રોજેક્ટ iCloud પર કૉપિ કરવામાં આવશે. મોટા પ્રોજેક્ટ માટે પ્રારંભિક સમન્વયનમાં સમય લાગી શકે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל הפרויקטים יועתקו אל iCloud. סנכרון ראשוני עשוי לקחת זמן עבור פרויקטים גדולים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी प्रोजेक्ट्स को iCloud में कॉपी किया जाएगा। बड़ी परियोजनाओं के लिए प्रारंभिक सिंक में समय लग सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svi projekti bit će kopirani u iCloud. Početna sinkronizacija može potrajati za velike projekte."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden projekt át lesz másolva ide: iCloud. A kezdeti szinkronizálás nagy projektek esetén időt vehet igénybe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua proyek akan disalin ke iCloud. Sinkronisasi awal mungkin memerlukan waktu untuk proyek besar."
          }
        },
        "it" : {
          "stringUnit" : {

    "Named after the row it was copied from — rename that row to rename both" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der Zeile benannt, aus der sie kopiert wurde – benenne diese Zeile um, um beide umzubenennen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva el nombre de la fila de la que se copió: cámbialo en esa fila para renombrar ambas"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به نام ردیفی که از آن کپی شده نام‌گذاری شده است — برای تغییر نام هر دو، آن ردیف را تغییر نام دهید"
          }

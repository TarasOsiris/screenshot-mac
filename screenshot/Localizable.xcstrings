    "Credits and licenses for fonts, icons, and bundled assets." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاعتمادات والتراخيص للخطوط والأيقونات والأصول المجمعة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফন্ট, আইকন এবং বান্ডিল সম্পদের জন্য ক্রেডিট এবং লাইসেন্স।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crèdits i llicències per a tipus de lletra, icones i actius agrupats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kredity a licence pro písma, ikony a přidružená aktiva."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreditering og licenser til skrifttyper, ikoner og medfølgende aktiver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quellenangaben und Lizenzen für Schriften, Symbole und mitgelieferte Assets."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πιστώσεις και άδειες για γραμματοσειρές, εικονίδια και ομαδοποιημένα στοιχεία."

          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌘]** / **⌘[**：向前/向后切换语言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌘]** / **⌘[**：向前／向後切換語言。"
          }

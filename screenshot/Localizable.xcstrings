    },
    "This applies translation from the base language to every text layer in %@ and replaces the current translated text." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird die Übersetzung aus der Basissprache auf jede Textebene in %@ angewendet und der aktuell übersetzte Text ersetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto traduce desde el idioma base cada forma de texto de %@ y reemplaza el texto traducido actual."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کار ترجمه از زبان پایه را به هر لایه متنی در %1$@ اعمال می‌کند و جایگزین متن ترجمه‌شده فعلی می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action traduit chaque calque de texte de la langue de base vers %@ et remplace le texte traduit actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione applica la traduzione dalla lingua di base a ogni livello di testo in %@ e sostituisce il testo tradotto attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本言語からの翻訳を %@ のすべてのテキストレイヤーに適用し、現在の翻訳済みテキストを置き換えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 언어 텍스트를 %@(으)로 번역하여 모든 텍스트 레이어에 적용하고, 현재 번역된 텍스트를 대체합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto aplica a tradução do idioma base a todas as camadas de texto em %@ e substitui o texto traduzido atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для каждого текстового слоя на языке «%@» будет применен перевод с базового языка, а текущий переведенный текст будет заменен."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem, temel dilden çeviriyi %@ dilindeki her metin katmanına uygular ve geçerli çevrilmiş metnin yerine koyar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця дія застосує переклад із базової мови до кожного текстового шару мовою «%@» і замінить поточний перекладений текст."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会将基准语言的翻译应用到 %@ 中的每个文本图层，并替换当前已翻译的文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會將基準語言的翻譯套用到 %@ 中的每個文字圖層，並取代目前已翻譯的文字。"
          }
        }
      }
    },
    "This cannot be undone." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies kann nicht rückgängig gemacht werden."
          }

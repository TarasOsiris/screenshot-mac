          }
        }
      }
    },
    "This set cannot be included because required App Store data is unavailable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Set kann nicht einbezogen werden, da erforderliche App Store-Daten nicht verfügbar sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este conjunto no se puede incluir porque no están disponibles los datos necesarios del App Store."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این مجموعه را نمی‌توان گنجاند، چون داده‌های لازم App Store در دسترس نیست."
          }
        },
        "fr" : {

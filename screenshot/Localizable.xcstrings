    "Sent to Google Play. Review and publish from the Play Console (changes won't go live until you publish)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An Google Play gesendet. Prüfe und veröffentliche die Änderungen in der Play Console (sie gehen erst live, wenn du sie veröffentlichst)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviado a Google Play. Revisa y publica desde Play Console (los cambios no se activarán hasta que los publiques)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به Google Play ارسال شد. از Play Console بازبینی و منتشر کنید (تا منتشر نکنید، تغییرات اعمال نمی‌شوند)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyé à Google Play. Examinez et publiez à partir de la Play Console (les modifications ne seront mises en ligne que lorsque vous les publierez)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviato a Google Play. Rivedi e pubblica dalla Play Console (le modifiche non saranno visibili finché non pubblichi)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play に送信しました。Play Console で確認して公開してください（公開するまで変更は反映されません）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play로 전송했습니다. Play Console에서 검토하고 게시하세요(게시하기 전까지는 변경 사항이 반영되지 않습니다)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviado ao Google Play. Revise e publique pelo Play Console (as alterações só entram no ar quando você publicar)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправлено в Google Play. Проверьте и опубликуйте в Play Console (изменения не вступят в силу, пока вы их не опубликуете)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play'e gönderildi. Play Console'dan inceleyip yayımlayın (siz yayımlayana kadar değişiklikler yayına girmez)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надіслано в Google Play. Перевірте й опублікуйте з Play Console (зміни не з’являться, доки ви їх не опублікуєте)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已发送至 Google Play。请在 Play 管理中心检查并发布（在你发布之前，更改不会生效）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已傳送至 Google Play。請從 Play Console 檢查並發佈（在你發佈之前，更改不會生效）。"
          }
        }
      }
    },

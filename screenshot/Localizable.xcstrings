        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format, storlek, layout och bakgrund kommer ihåg från din senaste showcase-export, inklusive en utvald bakgrundsbild."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปแบบ ขนาด เค้าโครง และพื้นหลังจะถูกจดจำจากการส่งออกการแสดงครั้งล่าสุดของคุณ รวมถึงภาพพื้นหลังที่เลือกด้วย"

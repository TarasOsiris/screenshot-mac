        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用形状工具栏中的 **SVG** 按钮打开粘贴对话框。"
          }
        }
      }
    },
    "Use the desktop Mac or iPad app for the best experience." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für das beste Erlebnis verwenden Sie die Desktop-App Mac oder iPad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice la aplicación de escritorio Mac o iPad para disfrutar de la mejor experiencia."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از برنامه دسکتاپ Mac یا iPad برای بهترین تجربه استفاده کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez l'application de bureau Mac ou iPad pour une expérience optimale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最適なエクスペリエンスを得るには、デスクトップ Mac または iPad アプリを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최상의 경험을 위해서는 데스크톱 Mac 또는 iPad 앱을 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o aplicativo Mac ou iPad para desktop para obter a melhor experiência."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用桌面 Mac 或 iPad 应用程序以获得最佳体验。"
          }
        }
      }
    },
    "Use the export menu for **Export All Screenshots to Folder…**, row exports, per-language exports, and direct upload to **App Store Connect** or **Google Play**." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie das Exportmenü für **Alle Screenshots in Ordner exportieren…**, Zeilenexporte, Exporte pro Sprache und direktes Hochladen nach **App Store Connect** oder **Google Play**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice el menú de exportación para **Exportar todas las capturas de pantalla a la carpeta…**, exportaciones de filas, exportaciones por idioma y carga directa a **App Store Connect** o **Google Play**."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از منوی صادرات برای **صادر کردن همه عکس‌های صفحه به پوشه…**، صادرات ردیف، صادرات به ازای هر زبان، و آپلود مستقیم به **App Store Connect** یا **Google Play** استفاده کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le menu d'exportation pour **Exporter toutes les captures d'écran vers un dossier…**, les exportations de lignes, les exportations par langue et le téléchargement direct vers **App Store Connect** ou **Google Play**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**すべてのスクリーンショットをフォルダーにエクスポート…**、行エクスポート、言語ごとのエクスポート、**App Store Connect** または **Google Play** への直接アップロードのエクスポート メニューを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**모든 스크린샷을 폴더로 내보내기…**, 행 내보내기, 언어별 내보내기 및 **App Store Connect** 또는 **Google Play**에 직접 업로드하려면 내보내기 메뉴를 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o menu de exportação para **Exportar todas as capturas de tela para a pasta…**, exportações de linha, exportações por idioma e upload direto para **App Store Connect** ou **Google Play**."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用导出菜单进行**将所有屏幕截图导出到文件夹…**、行导出、按语言导出以及直接上传到 **App Store Connect** 或 **Google Play**。"
          }
        }
      }
    },
    "Use the inspector on the right to set the background, default device frame, and screenshot size." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie den Inspektor auf der rechten Seite, um den Hintergrund, den Standard-Geräterahmen und die Screenshot-Größe festzulegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice el inspector de la derecha para configurar el fondo, el marco predeterminado del dispositivo y el tamaño de la captura de pantalla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از بازرس سمت راست برای تنظیم پس‌زمینه، قاب پیش‌فرض دستگاه و اندازه اسکرین شات استفاده کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez l'inspecteur sur la droite pour définir l'arrière-plan, le cadre par défaut de l'appareil et la taille de la capture d'écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右側のインスペクターを使用して、背景、デフォルトのデバイス フレーム、スクリーンショットのサイズを設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오른쪽에 있는 속성을 사용하여 배경, 기본 장치 프레임 및 스크린샷 크기를 설정합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o inspetor à direita para definir o plano de fundo, o quadro padrão do dispositivo e o tamanho da captura de tela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用右侧的检查器设置背景、默认设备框架和屏幕截图尺寸。"
          }
        }
      }
    },
    "Use the orientation control for supported frames, or the rotation control to rotate the entire shape including frame and screen content." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie die Ausrichtungssteuerung für unterstützte Rahmen oder die Rotationssteuerung, um die gesamte Form einschließlich Rahmen und Bildschirminhalt zu drehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice el control de orientación para los marcos admitidos o el control de rotación para rotar toda la forma, incluido el marco y el contenido de la pantalla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از کنترل جهت برای فریم های پشتیبانی شده یا از کنترل چرخش برای چرخاندن کل شکل از جمله محتوای فریم و صفحه استفاده کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le contrôle d'orientation pour les cadres pris en charge ou le contrôle de rotation pour faire pivoter la forme entière, y compris le contenu du cadre et de l'écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サポートされているフレームの向きコントロールを使用するか、フレームと画面コンテンツを含む形状全体を回転させる回転コントロールを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지원되는 프레임에는 방향 컨트롤을 사용하고, 프레임과 화면 콘텐츠를 포함한 전체 모양을 회전하려면 회전 컨트롤을 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o controle de orientação para quadros suportados ou o controle de rotação para girar a forma inteira, incluindo o quadro e o conteúdo da tela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用受支持框架的方向控件，或使用旋转控件来旋转整个形状，包括框架和屏幕内容。"
          }
        }
      }
    },
    "Use the project picker in the toolbar to jump between projects." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie die Projektauswahl in der Symbolleiste, um zwischen Projekten zu wechseln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice el selector de proyectos en la barra de herramientas para saltar entre proyectos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از انتخابگر پروژه در نوار ابزار برای پرش بین پروژه ها استفاده کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le sélecteur de projets dans la barre d'outils pour passer d'un projet à l'autre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツールバーのプロジェクト ピッカーを使用して、プロジェクト間を移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트 사이를 이동하려면 도구 모음의 프로젝트 선택기를 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o seletor de projetos na barra de ferramentas para alternar entre projetos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用工具栏中的项目选择器在项目之间跳转。"
          }
        }
      }
    },
    "Values are saved automatically on this Mac. The private key is stored in Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werte werden automatisch auf diesem Mac gespeichert. Der private Schlüssel wird im Schlüsselbund gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores se guardan automáticamente en este Mac. La clave privada se almacena en el Llavero."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقادیر به طور خودکار در این Mac ذخیره می شوند. کلید خصوصی در Keychain ذخیره می شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs sont enregistrées automatiquement sur ce Mac. La clé privée est stockée dans le trousseau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値はこの Mac に自動的に保存されます。秘密鍵はキーチェーンに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "값은 이 Mac에 자동으로 저장됩니다. 개인 키는 키체인에 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os valores são salvos automaticamente neste Mac. A chave privada é armazenada no Keychain."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "值自动保存在此 Mac 上。私钥存储在Keychain中。"
          }
        }
      }
    },

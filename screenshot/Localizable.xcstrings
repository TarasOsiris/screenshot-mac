    },
    "Once enabled it stays on and starts automatically the next time you launch. The app has to be running for a client to connect." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بمجرد تمكينه، يظل قيد التشغيل ويبدأ تلقائيًا في المرة التالية التي تقوم فيها بتشغيله. يجب أن يكون التطبيق قيد التشغيل حتى يتمكن العميل من الاتصال."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cop activat, es manté activat i s'inicia automàticament la propera vegada que l'inicieu. L'aplicació s'ha d'executar perquè un client es connecti."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po aktivaci zůstane zapnutá a automaticky se spustí při příštím spuštění. Aby se klient mohl připojit, musí být aplikace spuštěna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når den er aktiveret, forbliver den tændt og starter automatisk, næste gang du starter. Appen skal køre, for at en klient kan oprette forbindelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal aktiviert, bleibt der Server an und startet beim nächsten App-Start automatisch. Die App muss laufen, damit sich ein Client verbinden kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόλις ενεργοποιηθεί, παραμένει ενεργοποιημένο και ξεκινά αυτόματα την επόμενη φορά που θα εκκινήσετε. Η εφαρμογή πρέπει να εκτελείται για να συνδεθεί ένας πελάτης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez activado, sigue activado y se inicia automáticamente la próxima vez que abras la app. La app tiene que estar abierta para que un cliente se conecte."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پس از فعال شدن روشن می‌ماند و در اجرای بعدی برنامه خودکار شروع می‌شود. برای اتصال کلاینت، برنامه باید در حال اجرا باشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun se on otettu käyttöön, se pysyy päällä ja käynnistyy automaattisesti seuraavan käynnistyksen yhteydessä. Sovelluksen on oltava käynnissä, jotta asiakas voi muodostaa yhteyden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois activé, il reste actif et démarre automatiquement au prochain lancement. L'app doit être ouverte pour qu'un client puisse se connecter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לאחר הפעלתו הוא נשאר דולק ומתחיל אוטומטית בפעם הבאה שתפעילו. האפליקציה צריכה לפעול כדי שלקוח יוכל להתחבר."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakon što je omogućeno, ostaje uključeno i automatski se pokreće sljedeći put kada ga pokrenete. Aplikacija mora biti pokrenuta da bi se klijent mogao povezati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az engedélyezés után bekapcsolva marad, és a következő indításkor automatikusan elindul. Az alkalmazásnak futnia kell ahhoz, hogy az ügyfél csatlakozhasson."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah diaktifkan, itu tetap menyala dan dimulai secara otomatis saat Anda meluncurkannya lagi. Aplikasi harus berjalan agar klien dapat terhubung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una volta abilitato resta attivo e si avvia automaticamente al lancio successivo. L'app deve essere in esecuzione perché un client possa collegarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度有効にするとオンのままになり、次回の起動時にも自動的に開始されます。クライアントが接続するには、アプリが起動している必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화되면 계속 켜져 있으며 다음에 시작할 때 자동으로 시작됩니다. 클라이언트가 연결되려면 앱이 실행 중이어야 합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah didayakan, ia akan kekal dan bermula secara automatik pada kali seterusnya anda melancarkan. Apl itu perlu dijalankan untuk disambungkan oleh pelanggan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eenmaal ingeschakeld, blijft het ingeschakeld en wordt het automatisch gestart de volgende keer dat u het opstart. De app moet actief zijn voordat een client verbinding kan maken."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når den er aktivert, forblir den på og starter automatisk neste gang du starter. Appen må kjøres for at en klient skal koble seg til."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po włączeniu pozostaje włączony i uruchamia się automatycznie przy następnym uruchomieniu. Aby klient mógł się połączyć, aplikacja musi być uruchomiona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de ativado, ele continua ligado e inicia automaticamente na próxima vez que você abrir o app. O app precisa estar aberto para que um cliente se conecte."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma vez ativado, ele permanece ligado e inicia automaticamente na próxima vez que você iniciar. O aplicativo deve estar em execução para que um cliente se conecte."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odată activat, rămâne aprins și pornește automat data viitoare când lansați. Aplicația trebuie să ruleze pentru ca un client să se conecteze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После включения сервер остается включенным и автоматически запускается при следующем запуске приложения. Чтобы клиент мог подключиться, приложение должно быть запущено."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po aktivácii zostane zapnutá a automaticky sa spustí pri ďalšom spustení. Aplikácia musí byť spustená, aby sa klient mohol pripojiť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je omogočeno, ostane vključeno in se samodejno zažene ob naslednjem zagonu. Aplikacija mora delovati, da se lahko odjemalec poveže."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När den är aktiverad förblir den på och startar automatiskt nästa gång du startar. Appen måste vara igång för att en klient ska kunna ansluta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดใช้งานแล้ว ระบบจะยังคงเปิดอยู่และเริ่มโดยอัตโนมัติในครั้งถัดไปที่คุณเปิดตัว จะต้องทำงานแอปเพื่อให้ไคลเอนต์เชื่อมต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirildikten sonra açık kalır ve uygulamayı bir sonraki açışınızda otomatik olarak başlar. Bir istemcinin bağlanabilmesi için uygulamanın çalışıyor olması gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після ввімкнення сервер залишається ввімкненим і запускається автоматично під час наступного запуску. Щоб клієнт міг підключитися, програма має бути запущена."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک بار فعال ہونے کے بعد یہ جاری رہتا ہے اور اگلی بار آپ کے لانچ ہونے پر خود بخود شروع ہو جاتا ہے۔ کسی کلائنٹ کو مربوط کرنے کے لیے ایپ کو چلنا چاہیے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi được bật, nó vẫn bật và tự động khởi động vào lần tiếp theo bạn khởi chạy. Ứng dụng phải chạy để khách hàng kết nối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后会保持开启，并在你下次启动时自动运行。客户端要连接，本 App 必须正在运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後會保持開啟，並在你下次啟動時自動執行。App 必須在執行中，用戶端才能連線。"
          }
        }
      }
    },

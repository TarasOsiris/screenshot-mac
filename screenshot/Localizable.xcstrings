    "Open Settings → Google Play and import your service account JSON key, or turn on demo mode." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie Einstellungen → Google Play und importieren Sie den JSON-Schlüssel Ihres Dienstkontos oder aktivieren Sie den Demomodus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra Configuración → Google Play e importe la clave JSON de su cuenta de servicio, o active el modo de demostración."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنظیمات → Google Play را باز کنید و کلید JSON حساب سرویس خود را وارد کنید یا حالت نمایشی را روشن کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Paramètres → Google Play et importez la clé JSON de votre compte de service, ou activez le mode démo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[設定] → Google Play を開き、サービス アカウントの JSON キーをインポートするか、デモ モードをオンにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 → Google Play을 열고 서비스 계정 JSON 키를 가져오거나 데모 모드를 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

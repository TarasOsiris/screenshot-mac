        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ڈیمو موڈ فعال ہے۔ اصلی API اوپر والے کلیدی فیلڈز کو اس وقت تک نظر انداز کر دیا جاتا ہے جب تک کہ آپ ڈیمو موڈ کو آف نہیں کر دیتے۔"

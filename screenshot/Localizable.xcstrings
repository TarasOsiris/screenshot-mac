        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%2$@\" டெம்ப்ளேட்டைப் பயன்படுத்தி \"%1$@\" ஐ நிச்சயமாக மீட்டமைக்க விரும்புகிறீர்களா? தற்போதைய அனைத்து வரிசைகளும் வடிவங்களும் மாற்றப்படும். இதை செயல்தவிர்க்க முடியாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",

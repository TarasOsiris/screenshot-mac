        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**輸出資料夾**——選擇或清除 Screenshot Bro 在 **⌘E** 時重複使用的資料夾。"
          }
        }
      }
    },

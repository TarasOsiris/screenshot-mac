    "When editing a non-base language, a banner appears at the top of the canvas reminding you which language you're in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeitest du eine andere Sprache als die Basissprache, erinnert dich ein Banner oben auf der Leinwand daran, in welcher Sprache du bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al editar un idioma que no es el base, aparece un aviso arriba del lienzo que te recuerda en qué idioma estás."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام ویرایش زبانی غیر از زبان پایه، نواری بالای بوم ظاهر می‌شود و یادآوری می‌کند در کدام زبان هستید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

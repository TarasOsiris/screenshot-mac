          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per testarli, usa Esporta ▸ Carica test A/B su App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テストするには、「書き出す ▸ A/B テストを App Store Connect にアップロード」を使用します。"

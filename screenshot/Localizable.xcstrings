    "Use demo mode to walk through the App Store Connect upload feature without an API key — for example during App Review." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitzeu el mode de demostració per recórrer la funció de càrrega de App Store Connect sense una tecla API, per exemple durant la revisió d'aplicacions."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug demotilstand til at gå gennem App Store Connect upload-funktionen uden en API-tast – for eksempel under appgennemgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze den Demomodus, um die Upload-Funktion für App Store Connect ohne API-Schlüssel durchzuspielen – zum Beispiel während App Review."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el modo de demostración para probar la subida a App Store Connect sin una clave de API; por ejemplo, durante App Review."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با حالت نمایشی می‌توانید قابلیت آپلود App Store Connect را بدون کلید API مرور کنید — مثلاً هنگام App Review."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä esittelytilaa käydäksesi läpi App Store Connect-latausominaisuuden ilman API-näppäintä – esimerkiksi sovelluksen tarkistuksen aikana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le mode démo pour parcourir la fonction d'envoi vers App Store Connect sans clé API — par exemple pendant l'App Review."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la modalità demo per provare la funzione di caricamento su App Store Connect senza una chiave API, ad esempio durante l'App Review."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デモモードでは、API キーがなくても App Store Connect へのアップロード機能を一通り試せます（App Review の審査中など）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데모 모드를 사용하면 API 키 없이 App Store Connect 업로드 기능을 살펴볼 수 있습니다(예: 앱 심사 중)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik de demomodus om door de uploadfunctie App Store Connect te lopen zonder een API-sleutel, bijvoorbeeld tijdens App Review."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk demomodus for å gå gjennom App Store Connect-opplastingsfunksjonen uten en API-tast – for eksempel under appgjennomgang."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o modo de demonstração para conhecer o recurso de envio ao App Store Connect sem chave de API — por exemplo, durante o App Review."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o modo de demonstração para percorrer o recurso de upload de App Store Connect sem uma chave API, por exemplo, durante a revisão do aplicativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте демо-режим, чтобы опробовать загрузку в App Store Connect без ключа API — например, во время App Review."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd demoläget för att gå igenom App Store Connect uppladdningsfunktionen utan en API-knapp – till exempel under appgranskning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect yükleme özelliğini API anahtarı olmadan denemek için demo modunu kullanın — örneğin App Review sırasında."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скористайтеся демо-режимом, щоб пройти функцію вивантаження в App Store Connect без ключа API — наприклад, під час App Review."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

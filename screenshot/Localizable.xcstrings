          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте засіб вибору проєкту на панелі інструментів, щоб перемикатися між проєктами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

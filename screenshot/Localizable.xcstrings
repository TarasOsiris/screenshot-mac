    "Apple allows at most 10 screenshots in a display-type set; this proposal has %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple erlaubt höchstens 10 Screenshots in einem Displaytyp-Set; Dieser Vorschlag hat %1$lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple permite como máximo 10 capturas de pantalla en un conjunto de tipos de pantalla; esta propuesta tiene %1$lld."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپل حداکثر 10 عکس از صفحه نمایش را در یک مجموعه از نوع نمایشگر اجازه می دهد. این پیشنهاد %1$lld دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple autorise au maximum 10 captures d'écran dans un ensemble de types d'affichage ; cette proposition a %1$lld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple consente al massimo 10 screenshot in un set per tipo di display; questa proposta ne ha %lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple では、ディスプレイ タイプ セット内で最大 10 個のスクリーンショットを許可しています。このプロポーザルには %1$lld があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple은 디스플레이 유형 세트에서 최대 10개의 스크린샷을 허용합니다. 이 제안에는 %1$lld이 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Apple permite no máximo 10 capturas de tela em um conjunto de tipo de exibição; esta proposta tem %1$lld."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple допускает не более 10 скриншотов в наборе для типа дисплея; в этом предложении — %lld."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple, bir ekran türü setinde en fazla 10 ekran görüntüsüne izin verir; bu öneride %lld tane var."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple дозволяє щонайбільше 10 знімків екрана в наборі для типу дисплея; у цій пропозиції їх %lld."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 允许在一组显示类型中最多使用 10 张屏幕截图；该提案有 %1$lld。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 每個顯示類型組最多允許 10 張螢幕截圖；此提案有 %lld 張。"
          }
        }
      }
    },
    "Applies to all locales for this version." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {

    "RevenueCat API key is missing. Set REVENUECAT_API_KEY in the app environment or Info.plist." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta la clau RevenueCat API. Estableix REVENUECAT_API_KEY a l'entorn de l'aplicació o a Info.plist."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat API nøgle mangler. Indstil REVENUECAT_API_KEY i appmiljøet eller Info.plist."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der RevenueCat-API-Schlüssel fehlt. Lege REVENUECAT_API_KEY in der App-Umgebung oder der Info.plist fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta la clave de API de RevenueCat. Configura REVENUECAT_API_KEY en el entorno de la app o en Info.plist."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلید API برای RevenueCat وجود ندارد. REVENUECAT_API_KEY را در محیط برنامه یا Info.plist تنظیم کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",

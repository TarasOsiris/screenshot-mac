        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bấm đúp vào hình dạng **thiết bị** hoặc **hình ảnh** để mở bộ chọn và hoán đổi hình ảnh của nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连按两次 **设备** 或 **图像** 形状，即可打开选择器并更换其图片。"

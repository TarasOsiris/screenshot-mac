    "Text auto-grows vertically by default. Drag a side handle to fix the width and let it wrap." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينمو النص تلقائيًا عموديًا بشكل افتراضي. اسحب مقبضًا جانبيًا لتثبيت العرض واتركه يلتف."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পাঠ্য স্বয়ংক্রিয়ভাবে ডিফল্টভাবে উল্লম্বভাবে বৃদ্ধি পায়। প্রস্থ ঠিক করতে একটি পার্শ্ব হ্যান্ডেল টেনে আনুন এবং এটি মোড়ানো যাক।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El text creix automàticament verticalment per defecte. Arrossegueu una nansa lateral per fixar l'amplada i deixeu-la embolicar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text ve výchozím nastavení automaticky roste svisle. Přetažením boční rukojeti upravte šířku a nechte ji zabalit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst vokser automatisk lodret som standard. Træk i et sidehåndtag for at fiksere bredden, og lad det vikle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text wächst standardmäßig automatisch in die Höhe. Zieh an einem seitlichen Griff, um die Breite festzulegen und den Text umbrechen zu lassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κείμενο αναπτύσσεται αυτόματα κατακόρυφα από προεπιλογή. Σύρετε μια πλευρική λαβή για να διορθώσετε το πλάτος και αφήστε την να τυλιχτεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por omisión, el texto crece verticalmente de forma automática. Arrastra un tirador lateral para fijar el ancho y que el texto se ajuste en varias líneas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متن به‌طور پیش‌فرض خودکار در جهت عمودی بزرگ می‌شود. دستگیرهٔ کناری را بکشید تا عرض ثابت شود و متن به خط بعد برود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teksti kasvaa automaattisesti pystysuunnassa oletuksena. Kiinnitä leveys vetämällä sivukahvaa ja anna sen kietoutua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut, le texte s'agrandit verticalement. Faites glisser une poignée latérale pour fixer la largeur et laisser le texte passer à la ligne."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ટેક્સ્ટ ડિફૉલ્ટ રૂપે ઊભી રીતે સ્વતઃ વધે છે. પહોળાઈને ઠીક કરવા માટે બાજુના હેન્ડલને ખેંચો અને તેને લપેટી દો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טקסט גדל אוטומטית אנכית כברירת מחדל. גרור ידית צד כדי לתקן את הרוחב ולתת לה לעטוף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टेक्स्ट डिफ़ॉल्ट रूप से स्वचालित रूप से लंबवत बढ़ता है। चौड़ाई तय करने के लिए साइड हैंडल को खींचें और इसे लपेटने दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst prema zadanim postavkama automatski raste okomito. Povucite bočnu ručku da popravite širinu i pustite da se omota."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szöveg alapértelmezés szerint automatikusan függőlegesen növekszik. Húzza el az oldalsó fogantyút a szélesség rögzítéséhez, és hagyja beburkolni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks otomatis tumbuh secara vertikal secara default. Seret pegangan samping untuk memperbaiki lebarnya dan biarkan membungkusnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per impostazione predefinita il testo si espande in verticale automaticamente. Trascina una maniglia laterale per fissare la larghezza e mandarlo a capo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストはデフォルトで縦方向に自動的に広がります。左右のハンドルをドラッグすると幅が固定され、テキストが折り返されます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪಠ್ಯವು ಪೂರ್ವನಿಯೋಜಿತವಾಗಿ ಲಂಬವಾಗಿ ಸ್ವಯಂ-ಬೆಳೆಯುತ್ತದೆ. ಅಗಲವನ್ನು ಸರಿಪಡಿಸಲು ಸೈಡ್ ಹ್ಯಾಂಡಲ್ ಅನ್ನು ಎಳೆಯಿರಿ ಮತ್ತು ಅದನ್ನು ಕಟ್ಟಲು ಬಿಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트는 기본적으로 세로로 자동으로 늘어납니다. 측면 핸들을 드래그하면 너비가 고정되고 텍스트가 줄 바꿈됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സ്ഥിരസ്ഥിതിയായി ടെക്സ്റ്റ് സ്വയമേവ ലംബമായി വളരുന്നു. വീതി ശരിയാക്കാൻ ഒരു സൈഡ് ഹാൻഡിൽ വലിച്ചിടുക, അത് പൊതിയാൻ അനുവദിക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मजकूर डीफॉल्टनुसार अनुलंब स्वयं-वाढतो. रुंदी निश्चित करण्यासाठी बाजूचे हँडल ड्रॅग करा आणि ते गुंडाळा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks secara automatik tumbuh secara menegak secara lalai. Seret pemegang sisi untuk menetapkan lebar dan biarkan ia membalut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst groeit standaard automatisch verticaal. Sleep een zijhandgreep om de breedte vast te leggen en laat deze omlopen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst vokser automatisk vertikalt som standard. Dra et sidehåndtak for å fikse bredden og la det vikle."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domyślnie tekst automatycznie rośnie w pionie. Przeciągnij uchwyt boczny, aby ustalić szerokość i pozwól mu się zawijać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por padrão, o texto cresce na vertical automaticamente. Arraste uma alça lateral para fixar a largura e fazer o texto quebrar linha."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O texto cresce verticalmente automaticamente por padrão. Arraste uma alça lateral para fixar a largura e deixe-a envolver."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textul crește automat pe verticală în mod implicit. Trageți un mâner lateral pentru a fixa lățimea și lăsați-l să se înfășoare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию текст автоматически растет по вертикали. Перетащите боковую ручку, чтобы зафиксировать ширину и включить перенос строк."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text v predvolenom nastavení automaticky rastie vertikálne. Potiahnutím bočnej rukoväte upravte šírku a nechajte ju zabaliť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besedilo privzeto samodejno raste navpično. Povlecite stranski ročaj, da popravite širino, in pustite, da se zavije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text växer automatiskt vertikalt som standard. Dra ett sidohandtag för att fixera bredden och låt det lindas."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உரை இயல்பாக செங்குத்தாக தானாக வளரும். அகலத்தை சரிசெய்ய ஒரு பக்க கைப்பிடியை இழுத்து அதை மடிக்க விடவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "టెక్స్ట్ డిఫాల్ట్‌గా నిలువుగా స్వయంచాలకంగా పెరుగుతుంది. వెడల్పును పరిష్కరించడానికి ఒక వైపు హ్యాండిల్‌ను లాగి, దానిని చుట్టనివ్వండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อความจะขยายในแนวตั้งอัตโนมัติตามค่าเริ่มต้น ลากขอบจับด้านข้างเพื่อกำหนดความกว้างแล้วปล่อยให้พันไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metin varsayılan olarak dikey yönde otomatik büyür. Genişliği sabitlemek ve metnin kaydırılmasını sağlamak için bir yan tutamacı sürükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Типово текст автоматично росте по вертикалі. Потягніть бічний маркер, щоб зафіксувати ширину й увімкнути перенесення рядків."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متن خود بخود بذریعہ ڈیفالٹ عمودی طور پر بڑھتا ہے۔ چوڑائی ٹھیک کرنے کے لیے سائیڈ ہینڈل کو گھسیٹیں اور اسے لپیٹنے دیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Văn bản tự động phát triển theo chiều dọc theo mặc định. Kéo tay cầm bên để cố định chiều rộng và để nó quấn lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文本默认会纵向自动增高。拖动侧边控制点可固定宽度并让文本自动换行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字預設會垂直自動延伸。拖移側邊控制點即可固定寬度並讓文字自動換行。"
          }
        }
      }
    },

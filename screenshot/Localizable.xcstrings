          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le altre lingue verranno riallineate su di essa come traduzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のすべての言語は翻訳としてこの言語に再設定されます。"

          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies **Uploaden naar Google Play…** in het exportmenu. Screenshot Bro rendert de geselecteerde schermafbeeldingen rechtstreeks vanuit het project."
          }
        },
        "no" : {
          "stringUnit" : {

          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ కోసం App Store స్క్రీన్‌షాట్‌లు సమీక్ష తర్వాత మార్చబడ్డాయి. సమకాలీకరించే ముందు రిఫ్రెష్ చేయండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภาพหน้าจอ App Store สำหรับ %1$@ มีการเปลี่ยนแปลงหลังการตรวจสอบ รีเฟรชก่อนที่จะซิงค์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ için App Store ekran görüntüleri incelemeden sonra değişti. Eşzamanlamadan önce yenileyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знімки екрана App Store для %@ змінилися після перегляду. Оновіть перед синхронізацією."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جائزہ لینے کے بعد %1$@ کے لیے App Store اسکرین شاٹس تبدیل ہو گئے۔ مطابقت پذیری سے پہلے ریفریش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh chụp màn hình App Store của %1$@ đã thay đổi sau khi xem xét. Làm mới trước khi đồng bộ hóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的 App Store 截图在检查后已发生更改。请在同步前刷新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的 App Store 螢幕截圖在檢查後已更改。請在同步前重新整理。"
          }
        }
      }
    },

    "Set backgrounds, colors, and gradients, and fine-tune every element to match your brand." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتعيين الخلفيات والألوان والتدرجات، وقم بضبط كل عنصر ليتناسب مع علامتك التجارية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্যাকগ্রাউন্ড, রঙ এবং গ্রেডিয়েন্ট সেট করুন এবং আপনার ব্র্যান্ডের সাথে মেলে প্রতিটি উপাদানকে সূক্ষ্ম-টিউন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estableix fons, colors i degradats, i afina cada element perquè coincideixi amb la teva marca."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavte pozadí, barvy a přechody a dolaďte každý prvek tak, aby odpovídal vaší značce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstil baggrunde, farver og gradienter, og finjuster hvert element, så det matcher dit brand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege Hintergründe, Farben und Verläufe fest und passe jedes Element an deine Marke an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρυθμίστε φόντο, χρώματα και διαβαθμίσεις και ρυθμίστε κάθε στοιχείο ώστε να ταιριάζει με την επωνυμία σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta fondos, colores y degradados, y perfecciona cada elemento para reflejar tu marca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پس‌زمینه‌ها، رنگ‌ها و گرادیان‌ها را تنظیم کنید و هر عنصر را متناسب با برند خود دقیق تنظیم کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta taustat, värit ja liukuvärit ja hienosäädä jokainen elementti brändiäsi vastaaviksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez les arrière-plans, les couleurs et les dégradés, et affinez chaque élément en fonction de votre marque."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "બેકગ્રાઉન્ડ, રંગો અને ગ્રેડિએન્ટ્સ સેટ કરો અને તમારી બ્રાંડ સાથે મેળ ખાતી દરેક ઘટકને ફાઇન-ટ્યુન કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדר רקעים, צבעים ומדרגים, וכוונן כל אלמנט כך שיתאים למותג שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने ब्रांड से मेल खाने के लिए पृष्ठभूमि, रंग और ग्रेडिएंट सेट करें और प्रत्येक तत्व को फाइन-ट्यून करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavite pozadine, boje i gradijente te fino podesite svaki element kako bi odgovarao vašoj robnoj marki."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Állítson be háttereket, színeket és színátmeneteket, és finomhangoljon minden elemet a márkájához illően."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetapkan latar belakang, warna, dan gradien, dan sesuaikan setiap elemen agar sesuai dengan merek Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta sfondi, colori e sfumature e perfeziona ogni elemento in base al tuo brand."

        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur une zone vide du canevas d'une ligne pour sélectionner la ligne elle-même et afficher ses réglages dans l'inspecteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

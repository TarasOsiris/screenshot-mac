          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API anahtarı bağlandı ve ekran görüntüsü yüklemelerine hazır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ API підключено, і він готовий до вивантаження знімків екрана."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

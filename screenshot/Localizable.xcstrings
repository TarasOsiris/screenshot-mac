    "Keep the script's name (%@) and save it inside the Application Scripts folder." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ باسم البرنامج النصي (%1$@) واحفظه داخل مجلد البرامج النصية للتطبيقات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্ক্রিপ্টের নাম (%1$@) রাখুন এবং এটিকে অ্যাপ্লিকেশন স্ক্রিপ্ট ফোল্ডারে সংরক্ষণ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserveu el nom de l'script (%1$@) i deseu-lo a la carpeta Application Scripts."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",

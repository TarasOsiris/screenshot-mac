    "Create a **JSON key** for that service account and download it — this is the file Screenshot Bro imports." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ **مفتاح JSON** لحساب الخدمة هذا وقم بتنزيله — هذا هو الملف الذي يستورده Screenshot Bro."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সেই পরিষেবা অ্যাকাউন্টের জন্য একটি **JSON কী** তৈরি করুন এবং এটি ডাউনলোড করুন — এটি হল Screenshot Bro ফাইল আমদানি৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creeu una **clau JSON** per a aquest compte de servei i descarregueu-la: aquest és el fitxer que Screenshot Bro importa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte **klíč JSON** pro tento servisní účet a stáhněte si jej – toto je soubor, který Screenshot Bro importuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret en **JSON-nøgle** for den tjenestekonto, og download den – dette er filen Screenshot Bro importerer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle für dieses Dienstkonto einen **JSON-Schlüssel** und lade ihn herunter – das ist die Datei, die Screenshot Bro importiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργήστε ένα **κλειδί JSON** για αυτόν τον λογαριασμό υπηρεσίας και κάντε λήψη του — αυτό είναι το αρχείο Screenshot Bro που εισάγει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una **clave JSON** para esa cuenta de servicio y descárgala: es el archivo que importa Screenshot Bro."

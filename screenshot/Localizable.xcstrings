        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play permite no máximo %1$lld capturas de ecrã por tipo; esta linha tem %2$lld."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимум скриншотов одного типа в Google Play: %lld; в этой строке — %lld."

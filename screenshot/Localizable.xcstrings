        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanınan ekran görüntüsü boyutları, mümkün olduğunda uygun bir aygıt kategorisi veya çerçevesi seçmek için kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розпізнані розміри знімків екрана за можливості використовуються для вибору відповідної категорії пристрою чи рамки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسلیم شدہ اسکرین شاٹ کے طول و عرض کا استعمال ایک مناسب ڈیوائس زمرہ یا فریم منتخب کرنے کے لیے کیا جاتا ہے جب ممکن ہو۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kích thước ảnh chụp màn hình được nhận dạng được dùng để chọn danh mục hoặc khung thiết bị phù hợp khi có thể."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统会尽可能根据识别出的截图尺寸，选择合适的设备类别或边框。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

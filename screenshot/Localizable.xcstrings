    "RevenueCat API key is missing. Set REVENUECAT_API_KEY in the app environment or Info.plist." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاح RevenueCat API مفقود. قم بتعيين REVENUECAT_API_KEY في بيئة التطبيق أو Info.plist."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",

    "%lld screenshots must be removed first to stay within Apple's 10-screenshot limit." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures de pantalla %1$lld s'han d'eliminar primer per mantenir-se dins del límit de 10 captures de pantalla d'Apple."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld skærmbilleder skal fjernes først for at holde sig inden for Apples grænse på 10 skærmbilleder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

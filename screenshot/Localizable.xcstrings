            "value" : "“%@” ha ancora screenshot %@ di un caricamento precedente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」には以前のアップロードの %@ スクリーンショットが残っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”에 이전 업로드의 %@ 스크린샷이 아직 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” masih mempunyai %2$@ tangkapan skrin daripada muat naik terdahulu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” heeft nog steeds %2$@ screenshots van een eerdere upload."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» har fortsatt %2$@ skjermbilder fra en tidligere opplasting."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@” nadal zawiera %2$@ zrzuty ekranu z wcześniejszego przesłania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ainda tem capturas de %@ de um envio anterior."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” ainda tem %2$@ capturas de ecrã de um upload anterior."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@” are încă %2$@ capturi de ecran dintr-o încărcare anterioară."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В «%@» еще есть скриншоты %@ от предыдущей загрузки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ stále obsahuje %2$@ snímky obrazovky zo skoršieho nahrania."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%1$@« še vedno vsebuje %2$@ posnetkov zaslona iz prejšnjega nalaganja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" har fortfarande %2$@ skärmdumpar från en tidigare uppladdning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" ยังคงมีภาพหน้าจอ %2$@ จากการอัปโหลดครั้งก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” içinde önceki bir yüklemeden kalan %@ ekran görüntüleri hâlâ var."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ще має знімки екрана %@ з попереднього вивантаження."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" کے پاس اب بھی پہلے کے اپ لوڈ کے %2$@ اسکرین شاٹس ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” vẫn có %2$@ ảnh chụp màn hình từ lần tải lên trước đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

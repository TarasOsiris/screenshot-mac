        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα %1$@ του έχουν επίσης διαγραφεί. Μπορείτε να το αναιρέσετε."
          }
        },
        "es" : {
          "stringUnit" : {

    "No screenshots in this folder match this row's languages and its %@ size. Name subfolders by language — for example en-US and de-DE — or add the language code to each file name." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد لقطات شاشة في هذا المجلد تتطابق مع لغات هذا الصف وحجمه %1$@. قم بتسمية المجلدات الفرعية حسب اللغة — على سبيل المثال en-US وde-DE — أو أضف رمز اللغة إلى كل اسم ملف."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ফোল্ডারের কোনো স্ক্রিনশট এই সারির ভাষা এবং এর %1$@ আকারের সাথে মেলে না। ভাষা অনুসারে সাবফোল্ডার নাম দিন — উদাহরণস্বরূপ en-US এবং de-DE — অথবা প্রতিটি ফাইলের নামের সাথে ভাষার কোড যোগ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hi ha cap captura de pantalla d'aquesta carpeta que coincideixi amb els idiomes d'aquesta fila i la seva mida %1$@. Anomeneu les subcarpetes per idioma (per exemple, en-US i de-DE) o afegiu el codi d'idioma a cada nom de fitxer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádné snímky obrazovky v této složce neodpovídají jazykům tohoto řádku a jeho velikosti %1$@. Pojmenujte podsložky podle jazyka — například en-US a de-DE — nebo přidejte kód jazyka ke každému názvu souboru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen skærmbilleder i denne mappe matcher denne rækkes sprog og dens %1$@ størrelse. Navngiv undermapper efter sprog — for eksempel en-US og de-DE — eller tilføj sprogkoden til hvert filnavn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Screenshots in diesem Ordner passen zu den Sprachen dieser Zeile und ihrer Größe %@. Benenne Unterordner nach Sprachen – etwa en-US und de-DE – oder füge jedem Dateinamen den Sprachcode hinzu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κανένα στιγμιότυπο οθόνης σε αυτόν τον φάκελο δεν ταιριάζει με τις γλώσσες αυτής της σειράς και το μέγεθός της %1$@. Ονομάστε τους υποφακέλους ανά γλώσσα — για παράδειγμα en-US και de-DE — ή προσθέστε τον κωδικό γλώσσας σε κάθε όνομα αρχείου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna captura de esta carpeta coincide con los idiomas de esta fila y su tamaño de %@. Nombra las subcarpetas por idioma (por ejemplo, en-US y de-DE) o añade el código de idioma a cada nombre de archivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هیچ اسکرین‌شاتی در این پوشه با زبان‌های این ردیف و اندازه %@ آن مطابقت ندارد. زیرپوشه‌ها را به نام زبان‌ها نام‌گذاری کنید — مثلاً en-US و de-DE — یا کد زبان را به نام هر فایل اضافه کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikään tässä kansiossa oleva kuvakaappaus ei vastaa tämän rivin kieliä ja sen kokoa %1$@. Nimeä alikansiot kielen mukaan – esimerkiksi en-US ja de-DE – tai lisää kielikoodi jokaiseen tiedostonimeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune capture de ce dossier ne correspond aux langues de cette ligne et à sa taille de %@. Nommez les sous-dossiers par langue — par exemple en-US et de-DE — ou ajoutez le code de langue à chaque nom de fichier."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ ફોલ્ડરમાંના કોઈપણ સ્ક્રીનશૉટ્સ આ પંક્તિની ભાષાઓ અને તેના %1$@ કદ સાથે મેળ ખાતા નથી. ભાષા દ્વારા સબફોલ્ડર્સને નામ આપો — ઉદાહરણ તરીકે en-US અને de-DE — અથવા દરેક ફાઇલના નામમાં ભાષા કોડ ઉમેરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין צילומי מסך בתיקייה זו תואמים לשפות של שורה זו ולגודל ה-%1$@ שלה. תן שם לתיקיות משנה לפי שפה - למשל en-US ו-de-DE - או הוסף את קוד השפה לכל שם קובץ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस फ़ोल्डर में कोई भी स्क्रीनशॉट इस पंक्ति की भाषाओं और इसके %1$@ आकार से मेल नहीं खाता। सबफ़ोल्डर्स को भाषा के आधार पर नाम दें - उदाहरण के लिए एन-यूएस और डी-डीई - या प्रत्येक फ़ाइल नाम में भाषा कोड जोड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nijedna snimka zaslona u ovoj mapi ne odgovara jezicima ovog retka i njegovoj veličini %1$@. Imenujte podmape prema jeziku — na primjer en-US i de-DE — ili dodajte jezični kod svakom nazivu datoteke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebben a mappában egyetlen képernyőkép sem felel meg a sor nyelvének és %1$@ méretének. Nevezze el az almappákat nyelv szerint – például en-US és de-DE –, vagy adja hozzá a nyelvi kódot az egyes fájlnevekhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada tangkapan layar di folder ini yang cocok dengan bahasa baris ini dan ukurannya %1$@. Beri nama subfolder berdasarkan bahasa — misalnya en-US dan de-DE — atau tambahkan kode bahasa ke setiap nama file."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno screenshot in questa cartella corrisponde alle lingue di questa riga e alla sua dimensione %@. Dai alle sottocartelle il nome della lingua, ad esempio en-US e de-DE, oppure aggiungi il codice lingua a ogni nome di file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このフォルダには、この行の言語とサイズ（%@）に一致するスクリーンショットがありません。サブフォルダに言語名（en-US、de-DE など）を付けるか、各ファイル名に言語コードを追加してください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಫೋಲ್ಡರ್‌ನಲ್ಲಿ ಯಾವುದೇ ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ಗಳು ಈ ಸಾಲಿನ ಭಾಷೆಗಳು ಮತ್ತು ಅದರ %1$@ ಗಾತ್ರಕ್ಕೆ ಹೊಂದಿಕೆಯಾಗುವುದಿಲ್ಲ. ಭಾಷೆಯ ಮೂಲಕ ಉಪ ಫೋಲ್ಡರ್‌ಗಳನ್ನು ಹೆಸರಿಸಿ — ಉದಾಹರಣೆಗೆ en-US ಮತ್ತು de-DE — ಅಥವಾ ಪ್ರತಿ ಫೈಲ್ ಹೆಸರಿಗೆ ಭಾಷಾ ಕೋಡ್ ಸೇರಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 폴더에 이 행의 언어와 %@ 크기에 맞는 스크린샷이 없습니다. 하위 폴더 이름을 언어로 지정하거나(예: en-US, de-DE) 각 파일 이름에 언어 코드를 추가하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ ഫോൾഡറിലെ സ്‌ക്രീൻഷോട്ടുകളൊന്നും ഈ വരിയുടെ ഭാഷകളും അതിൻ്റെ %1$@ വലുപ്പവുമായി പൊരുത്തപ്പെടുന്നില്ല. സബ്ഫോൾഡറുകൾക്ക് ഭാഷ അനുസരിച്ച് പേര് നൽകുക - ഉദാഹരണത്തിന് en-US, de-DE - അല്ലെങ്കിൽ ഓരോ ഫയലിൻ്റെ പേരിലും ഭാഷാ കോഡ് ചേർക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या फोल्डरमधील कोणतेही स्क्रीनशॉट या पंक्तीच्या भाषा आणि %1$@ आकाराशी जुळत नाहीत. सबफोल्डर्सना भाषेनुसार नाव द्या — उदाहरणार्थ en-US आणि de-DE — किंवा प्रत्येक फाइलच्या नावात भाषा कोड जोडा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada tangkapan skrin dalam folder ini sepadan dengan bahasa baris ini dan saiz %1$@. Namakan subfolder mengikut bahasa — contohnya en-US dan de-DE — atau tambahkan kod bahasa pada setiap nama fail."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn geen schermafbeeldingen in deze map die overeenkomen met de talen van deze rij en de %1$@-grootte. Geef submappen een naam op taal (bijvoorbeeld en-US en de-DE) of voeg de taalcode toe aan elke bestandsnaam."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen skjermbilder i denne mappen samsvarer med denne radens språk og dens %1$@ størrelse. Navngi undermapper etter språk – for eksempel en-US og de-DE – eller legg til språkkoden til hvert filnavn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żadne zrzuty ekranu w tym folderze nie odpowiadają językom tego wiersza i jego rozmiarowi %1$@. Nazwij podfoldery według języka — na przykład en-US i de-DE — lub dodaj kod języka do nazwy każdego pliku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma captura de tela desta pasta corresponde aos idiomas desta linha e ao tamanho %@. Nomeie as subpastas pelo idioma — por exemplo, en-US e de-DE — ou adicione o código do idioma a cada nome de arquivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma captura de ecrã nesta pasta corresponde aos idiomas desta linha e ao seu tamanho %1$@. Nomeie as subpastas por idioma — por exemplo, en-US e de-DE — ou adicione o código do idioma a cada nome de ficheiro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicio captură de ecran din acest dosar nu se potrivește cu limbile acestui rând și cu dimensiunea lui %1$@. Denumiți subfolderele după limbă — de exemplu en-US și de-DE — sau adăugați codul de limbă la fiecare nume de fișier."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этой папке нет скриншотов, подходящих к языкам этой строки и её размеру %@. Назовите подпапки по языкам (например, en-US и de-DE) или добавьте код языка в имя каждого файла."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žiadne snímky obrazovky v tomto priečinku nezodpovedajú jazykom tohto riadka a jeho veľkosti %1$@. Pomenujte podpriečinky podľa jazyka — napríklad en-US a de-DE — alebo pridajte kód jazyka ku každému názvu súboru."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noben posnetek zaslona v tej mapi se ne ujema z jeziki te vrstice in njeno velikostjo %1$@. Poimenujte podmape po jeziku — na primer en-US in de-DE — ali dodajte kodo jezika vsakemu imenu datoteke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga skärmdumpar i den här mappen matchar den här radens språk och storleken %1$@. Namnge undermappar efter språk — till exempel en-US och de-DE — eller lägg till språkkoden till varje filnamn."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த கோப்புறையில் உள்ள ஸ்கிரீன்ஷாட்கள் இந்த வரிசையின் மொழிகளுக்கும் அதன் %1$@ அளவிற்கும் பொருந்தவில்லை. துணைக் கோப்புறைகளை மொழியின்படி பெயரிடுங்கள் — எடுத்துக்காட்டாக en-US மற்றும் de-DE — அல்லது ஒவ்வொரு கோப்பு பெயரிலும் மொழிக் குறியீட்டைச் சேர்க்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ ఫోల్డర్‌లోని స్క్రీన్‌షాట్‌లు ఈ అడ్డు వరుస భాషలకు మరియు దాని %1$@ పరిమాణానికి సరిపోలడం లేదు. సబ్‌ఫోల్డర్‌లను భాష ద్వారా పేరు పెట్టండి — ఉదాహరణకు en-US మరియు de-DE — లేదా ప్రతి ఫైల్ పేరుకు భాషా కోడ్‌ను జోడించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีภาพหน้าจอในโฟลเดอร์นี้ที่ตรงกับภาษาของแถวนี้และขนาด %1$@ ตั้งชื่อโฟลเดอร์ย่อยตามภาษา เช่น en-US และ de-DE หรือเพิ่มรหัสภาษาให้กับชื่อไฟล์แต่ละชื่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu klasördeki hiçbir ekran görüntüsü bu satırın dilleri ve %@ boyutuyla eşleşmiyor. Alt klasörleri dile göre adlandırın (ör. en-US ve de-DE) veya her dosya adına dil kodunu ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У цій папці немає знімків екрана, що відповідають мовам цього рядка та його розміру %@. Назвіть підпапки за мовами (наприклад, en-US і de-DE) або додайте код мови до назви кожного файлу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس فولڈر میں کوئی اسکرین شاٹ اس قطار کی زبانوں اور اس کے %1$@ سائز سے مماثل نہیں ہے۔ ذیلی فولڈرز کو زبان کے لحاظ سے نام دیں — مثال کے طور پر en-US اور de-DE — یا ہر فائل کے نام میں زبان کا کوڈ شامل کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có ảnh chụp màn hình nào trong thư mục này khớp với ngôn ngữ của hàng này và kích thước %1$@ của hàng này. Đặt tên cho các thư mục con theo ngôn ngữ — ví dụ en-US và de-DE — hoặc thêm mã ngôn ngữ vào từng tên tệp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件夹中没有与此行的语言及其 %@ 尺寸匹配的截图。请按语言命名子文件夹（例如 en-US 和 de-DE），或在每个文件名中加入语言代码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案夾中沒有與此列的語言及其 %@ 尺寸相符的螢幕截圖。請按語言命名子檔案夾（例如 en-US 和 de-DE），或在每個檔名中加入語言代碼。"
          }
        }
      }
    },

    "Add screenshots from Photos or Files, then drop in text, shapes, and a device frame." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegiu captures de pantalla de Fotos o Fitxers i, a continuació, introduïu text, formes i un marc del dispositiu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj skærmbilleder fra Fotos eller Filer, og indsæt derefter tekst, figurer og en enhedsramme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Screenshots aus Fotos oder Dateien hinzu und ergänze dann Text, Formen und einen Geräterahmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade capturas desde Fotos o Archivos y luego inserta texto, formas y un marco de dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسکرین‌شات‌ها را از Photos یا Files اضافه کنید، سپس متن، شکل و قاب دستگاه بگذارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää kuvakaappauksia Kuvat- tai Tiedostot-apista ja lisää sitten tekstiä, muotoja ja laitekehys."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des captures d'écran depuis Photos ou Fichiers, puis ajoutez du texte, des formes et un cadre d'appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi screenshot da Foto o File, poi inserisci testo, forme e una cornice del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真またはファイルからスクリーンショットを追加し、テキスト、図形、デバイスフレームを配置します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 또는 파일에서 스크린샷을 추가한 다음 텍스트, 도형, 기기 프레임을 넣으세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg schermafbeeldingen toe uit Foto's of Bestanden en voeg vervolgens tekst, vormen en een apparaatframe toe."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til skjermbilder fra Bilder eller filer, og slipp deretter inn tekst, former og en enhetsramme."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione capturas de tela de Fotos ou Arquivos e insira texto, formas e uma moldura do dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione capturas de ecrã de Fotos ou Ficheiros e insira texto, formas e uma moldura do dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте скриншоты из «Фото» или «Файлов», затем разместите текст, фигуры и рамку устройства."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till skärmdumpar från foton eller filer och släpp sedan in text, former och en enhetsram."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraflar'dan veya Dosyalar'dan ekran görüntüleri ekleyin, ardından metin, şekil ve bir aygıt çerçevesi yerleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте знімки екрана з Фото або Файлів, а потім розмістіть текст, фігури та рамку пристрою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从“照片”或“文件”添加截图，然后放入文本、形状和设备边框。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

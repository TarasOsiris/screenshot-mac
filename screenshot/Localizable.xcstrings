    "Disable this row, choose a display type that App Store Connect accepts for this app, or update the app's device support before retrying." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتعطيل هذا الصف، واختر نوع العرض الذي يقبله App Store Connect لهذا التطبيق، أو قم بتحديث دعم جهاز التطبيق قبل إعادة المحاولة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiveu aquesta fila, trieu un tipus de visualització que App Store Connect accepti per a aquesta aplicació o actualitzeu la compatibilitat amb el dispositiu de l'aplicació abans de tornar-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivujte tento řádek, vyberte typ zobrazení, který App Store Connect pro tuto aplikaci akceptuje, nebo před dalším pokusem aktualizujte podporu zařízení aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiver denne række, vælg en visningstype, som App Store Connect accepterer for denne app, eller opdater appens enhedssupport, før du prøver igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivieren Sie diese Zeile, wählen Sie einen Anzeigetyp aus, den App Store Connect für diese App akzeptiert, oder aktualisieren Sie die Geräteunterstützung der App, bevor Sie es erneut versuchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απενεργοποιήστε αυτήν τη σειρά, επιλέξτε έναν τύπο οθόνης που αποδέχεται ο App Store Connect για αυτήν την εφαρμογή ή ενημερώστε την υποστήριξη συσκευής της εφαρμογής πριν δοκιμάσετε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva esta fila, elige un tipo de pantalla que App Store Connect acepte para esta app o actualiza la compatibilidad de dispositivos antes de reintentar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این ردیف را غیرفعال کنید، نوع نمایشی را انتخاب کنید که App Store Connect برای این برنامه می‌پذیرد، یا قبل از تلاش مجدد، پشتیبانی دستگاه برنامه را به‌روزرسانی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista tämä rivi käytöstä, valitse näyttötyyppi, jonka App Store Connect hyväksyy tälle sovellukselle, tai päivitä sovelluksen laitetuki ennen kuin yrität uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez cette ligne, choisissez un type d'affichage accepté par App Store Connect pour cette application ou mettez à jour la prise en charge des appareils de l'application avant de réessayer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השבת את השורה הזו, בחר סוג תצוגה ש-App Store Connect מקבל עבור האפליקציה הזו, או עדכן את תמיכת המכשיר של האפליקציה לפני שתנסה שוב."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onemogućite ovaj redak, odaberite vrstu prikaza koju App Store Connect prihvaća za ovu aplikaciju ili ažurirajte podršku za uređaj aplikacije prije ponovnog pokušaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiltsa le ezt a sort, válasszon egy olyan megjelenítési típust, amelyet a App Store Connect elfogad ehhez az alkalmazáshoz, vagy frissítse az alkalmazás eszköztámogatását, mielőtt újra próbálkozna."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nonaktifkan baris ini, pilih jenis tampilan yang App Store Connect terima untuk aplikasi ini, atau perbarui dukungan perangkat aplikasi sebelum mencoba lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この行を無効にするか、App Store Connect がこのアプリに対して受け入れる表示タイプを選択するか、再試行する前にアプリのデバイス サポートを更新してください。"

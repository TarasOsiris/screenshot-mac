        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트가 디스크에 있는 위치"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde os projetos ficam no disco"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Где проекты хранятся на диске"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projelerin diskteki konumu"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Де проєкти зберігаються на диску"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目在磁盘上的位置"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "專案在磁碟上的位置"
          }
        }
      }
    },
    "While a non-base language is active, an amber border frames the whole editor so an override is never made by accident." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während eine Nicht-Basissprache aktiv ist, wird der gesamte Editor von einem gelben Rahmen umrahmt, sodass es nie versehentlich zu einer Überschreibung kommt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras un idioma no base está activo, un borde ámbar enmarca todo el editor para que nunca se realice una anulación por accidente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در حالی که یک زبان غیر پایه فعال است، یک حاشیه کهربایی کل ویرایشگر را قاب می‌کند، بنابراین هیچگاه به‌طور تصادفی لغو نمی‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu'une langue autre que la langue de base est active, une bordure orange encadre l'ensemble de l'éditeur afin qu'un remplacement ne soit jamais effectué par accident."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre è attiva una lingua diversa da quella di base, un bordo ambra incornicia l'intero editor, così una personalizzazione non viene mai creata per errore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非基本言語がアクティブな間は、エディタ全体がオレンジ色の境界線で囲まれるため、誤ってオーバーライドが行われることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 언어가 아닌 언어가 활성화되어 있는 동안에는 호박색 테두리가 전체 편집기를 프레임하므로 실수로 재정의되는 일이 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto um idioma não base estiver ativo, uma borda âmbar enquadra todo o editor para que uma substituição nunca seja feita por acidente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока активен небазовый язык, весь редактор обрамлен янтарной рамкой, чтобы переопределение никогда не создавалось случайно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temel olmayan bir dil etkinken, bir geçersiz kılmanın asla yanlışlıkla yapılmaması için düzenleyicinin tamamı turuncu bir kenarlıkla çerçevelenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки активна небазова мова, увесь редактор обрамлено бурштиновою рамкою, щоб перевизначення ніколи не створювалися випадково."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当非基本语言处于活动状态时，琥珀色边框会框住整个编辑器，因此绝不会意外进行覆盖。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非基準語言啟用時，琥珀色邊框會圍繞整個編輯器，以免不小心建立覆寫。"
          }
        }
      }
    },
    "While demo mode is on, the real API key above it is ignored." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während der Demo-Modus aktiviert ist, wird die echte API-Taste darüber ignoriert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras el modo de demostración está activado, la tecla real API que aparece encima se ignora."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی حالت نمایشی روشن است، کلید واقعی API بالای آن نادیده گرفته می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque le mode démo est activé, la vraie clé API au-dessus est ignorée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre la modalità demo è attiva, la chiave API reale qui sopra viene ignorata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デモ モードがオンの間、その上の実際の API キーは無視されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데모 모드가 켜져 있는 동안에는 그 위의 실제 API 키가 무시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto o modo de demonstração está ativado, a chave API real acima dele é ignorada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока демо-режим включен, настоящий ключ API выше игнорируется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demo modu açıkken, üstündeki gerçek API anahtarı yok sayılır."
          }
        },
        "uk" : {
          "stringUnit" : {

        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒரு வரிசையில் உள்ள ஒவ்வொரு நெடுவரிசையும் ஒரு டெம்ப்ளேட் ஆகும். டெம்ப்ளேட் என்பது இறுதி ஏற்றுமதி செய்யப்பட்ட படமாகும் - அதன் பரிமாணங்கள் வரிசையின் ஸ்கிரீன்ஷாட் அளவோடு பொருந்துகிறது. App Store ஒரு வரிசைக்கு 10 டெம்ப்ளேட்கள் வரை ஏற்கிறது; Google Play 8 வரை."
          }
        },
        "te" : {

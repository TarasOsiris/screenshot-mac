        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie uma chave com acesso ao **App Manager**. Baixe o ficheiro de chave privada `.p8` (você só pode baixá-lo uma vez)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creați o cheie cu acces **App Manager**. Descărcați fișierul cu cheia privată `.p8` ( îl puteți descărca o singură dată)."

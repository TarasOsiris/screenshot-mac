    "Replaces ^[%lld screenshot](inflect: true) already in this row." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستبدل لقطة الشاشة ^[%1$lld] (inflect: true) الموجودة بالفعل في هذا الصف."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%1$lld স্ক্রিনশট প্রতিস্থাপন করে(inflect: true) ইতিমধ্যেই এই সারিতে আছে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitueix la ^[%1$lld captura de pantalla](inflect: true) que ja hi ha en aquesta fila."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahrazuje ^[%1$lld snímek obrazovky](inflect: true) již v tomto řádku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstatter ^[%1$lld screenshot](inflect: true) allerede i denne række."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzt bereits vorhandene Screenshots in dieser Zeile: %lld."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αντικαθιστά το ^[%1$lld στιγμιότυπο οθόνης](inflect: true) που βρίσκεται ήδη σε αυτήν τη σειρά."
          }

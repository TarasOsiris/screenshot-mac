        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A **Barra de controle de modelo** abaixo de cada modelo permite substituir o plano de fundo da linha apenas para esse modelo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个模板下方的 **模板控制栏** 可让您覆盖仅适用于该模板的行背景。"
          }
        }
      }
    },
    "The API key is connected and ready for screenshot uploads." : {
      "localizations" : {

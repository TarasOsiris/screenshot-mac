    "Add the locales in App Store Connect, or disable them here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge die Sprachen in App Store Connect hinzu oder deaktiviere sie hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade los idiomas en App Store Connect o desactívalos aquí."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زبان‌ها را در App Store Connect اضافه کنید یا آن‌ها را اینجا غیرفعال کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez les langues dans App Store Connect, ou désactivez-les ici."
          }
        },
        "it" : {
          "stringUnit" : {

        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Обрезка** изображения тоже может отличаться для каждого языка, так что переведённый скриншот можно кадрировать отдельно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Orezanie** obrázka sa môže líšiť aj podľa jazyka, takže preložená snímka obrazovky môže byť zarámovaná samostatne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Obrez** slike se lahko razlikuje tudi glede na jezik, tako da je preveden posnetek zaslona mogoče uokviriti sam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

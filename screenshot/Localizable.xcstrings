          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回転ハンドル (図形の上) をドラッグして自由に回転します。正確に制御するには、回転フィールドに度の値を入力します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회전 핸들(모양 위)을 드래그하여 자유롭게 회전합니다. 정확한 제어를 위해 회전 필드에 각도 값을 입력합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste a alça de rotação (acima da forma) para girar livremente. Digite um valor de grau no campo de rotação para controle exato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动旋转手柄（形状上方）以自由旋转。在旋转字段中输入角度值以进行精确控制。"
          }
        }
      }
    },
    "Drag the shape body to move. Drag a corner or edge handle to resize." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh die Form, um sie zu verschieben. Zieh an einem Eck- oder Kantengriff, um die Größe zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra la forma para moverla. Arrastra un tirador de esquina o de borde para redimensionarla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای جابه‌جایی، بدنهٔ شکل را بکشید. برای تغییر اندازه، دستگیرهٔ گوشه یا لبه را بکشید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la forme pour la déplacer. Faites glisser une poignée d'angle ou de bord pour la redimensionner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina il corpo della forma per spostarla. Trascina una maniglia d'angolo o di bordo per ridimensionarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "図形の本体をドラッグすると移動します。角または辺のハンドルをドラッグするとサイズを変更します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도형 본체를 드래그하면 이동하고, 모서리나 가장자리 핸들을 드래그하면 크기가 조정됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste o corpo da forma para movê-la. Arraste uma alça de canto ou de borda para redimensionar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетаскивайте фигуру, чтобы переместить ее. Перетаскивайте угловую или боковую ручку, чтобы изменить размер."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taşımak için şeklin gövdesini sürükleyin. Yeniden boyutlandırmak için bir köşe veya kenar tutamacını sürükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потягніть фігуру, щоб перемістити її. Потягніть кутовий або бічний маркер, щоб змінити розмір."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动形状主体即可移动。拖动角或边缘的控制点即可调整大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移形狀本體即可移動。拖移角落或邊緣控制點即可調整大小。"
          }
        }
      }
    },
    "Drag, resize, rotate, snap." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen, Größe ändern, drehen, einrasten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastrar, redimensionar, girar, ajustar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کشیدن، تغییر اندازه، چرخش، چسبیدن."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacer, redimensionner, faire pivoter, aligner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina, ridimensiona, ruota, aggancia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグ、サイズ変更、回転、スナップ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그, 크기 조정, 회전, 스냅."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste, redimensione, gire, encaixe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетаскивание, размер, поворот, привязка."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürükleyin, yeniden boyutlandırın, döndürün, yaslayın."
          }
        },
        "uk" : {

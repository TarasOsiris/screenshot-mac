          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під версією — звідки ваша копія: **App Store** або **Пряме завантаження**."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ورژن کے نیچے، جہاں سے آپ کی کاپی آئی ہے: **App Store** یا **براہ راست ڈاؤن لوڈ**۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bên dưới phiên bản chứa bản sao của bạn: **App Store** hoặc **Tải xuống trực tiếp**."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "版本号下方显示你的副本来源：**App Store** 或 **直接下载**。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "版本下方顯示你的副本來源：**App Store** 或**直接下載**。"
          }
        }
      }
    },

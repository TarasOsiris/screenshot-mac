    "Another screenshot sync is already running. Wait for it to finish, or cancel it first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere Screenshot-Synchronisierung läuft bereits. Warte, bis sie abgeschlossen ist, oder brich sie zuerst ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay otra sincronización de capturas en curso. Espera a que termine o cancélala primero."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همگام‌سازی اسکرین‌شات دیگری از قبل در حال اجرا است. صبر کنید تا تمام شود یا ابتدا آن را لغو کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre synchronisation des captures d'écran est déjà en cours. Attendez qu'elle se termine ou annulez-la d'abord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È già in corso un'altra sincronizzazione degli screenshot. Attendi che termini oppure annullala prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のスクリーンショット同期がすでに実行中です。完了するまで待つか、先にキャンセルしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 스크린샷 동기화가 이미 실행 중입니다. 완료될 때까지 기다리거나 먼저 취소하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outra sincronização de capturas de tela já está em andamento. Aguarde terminar ou cancele-a primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже выполняется другая синхронизация скриншотов. Дождитесь ее завершения или сначала отмените ее."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir ekran görüntüsü eşzamanlaması zaten çalışıyor. Bitmesini bekleyin ya da önce iptal edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже триває інша синхронізація знімків екрана. Дочекайтеся її завершення або спершу скасуйте її."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个截图同步正在运行。请等待其完成，或先将其取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一個螢幕截圖同步正在執行。請等待它完成，或先將其取消。"
          }
        }
      }

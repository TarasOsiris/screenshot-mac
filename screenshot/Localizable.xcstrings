          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అడ్డు వరుస పేరు — ఇన్‌స్పెక్టర్ ఎగువన చూపబడింది — ఈ అడ్డు వరుస ఎగుమతి చేసే ఫోల్డర్‌కు పేరు పెడుతుంది. **వరుస హెడర్‌లో పేరును రెండుసార్లు క్లిక్ చేయండి** స్థానంలో పేరు మార్చండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",

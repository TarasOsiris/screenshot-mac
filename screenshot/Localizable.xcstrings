    "Export menu ▸ **Export Rows ▸ Showcase** for the whole project, or a row menu ▸ **Export Row ▸ Showcase** for one row." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قائمة التصدير ▸ **تصدير الصفوف ▸ الواجهة** للمشروع بأكمله، أو قائمة الصفوف ▸ **تصدير الصف ▸ الواجهة** لصف واحد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রপ্তানি মেনু ▸ **সারি রপ্তানি করুন ▸ শোকেস** পুরো প্রকল্পের জন্য, অথবা একটি সারি মেনু ▸ **এক সারির জন্য রপ্তানি সারি ▸ শোকেস**।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menú Exporta ▸ **Exporta files ▸ Aparador** per a tot el projecte, o un menú de fila ▸ **Exporta fila ▸ Aparador** per a una fila."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabídka Export ▸ **Exportovat řádky ▸ Výklad** pro celý projekt nebo nabídka řádků ▸ **Exportovat řádek ▸ Výklad** pro jeden řádek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksportmenu ▸ **Eksportér rækker ▸ Udstillingsvindue** for hele projektet, eller en rækkemenu ▸ **Eksporter række ▸ Udstillingsvindue** for en række."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportmenü ▸ **Zeilen exportieren ▸ Showcase** für das ganze Projekt oder Zeilenmenü ▸ **Zeile exportieren ▸ Showcase** für eine Zeile."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μενού εξαγωγής ▸ **Εξαγωγή σειρών ▸ Βιτρίνα** για ολόκληρο το έργο ή μενού σειράς ▸ **Εξαγωγή σειράς ▸ Βιτρίνα** για μία σειρά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menú de exportación ▸ **Exportar filas ▸ Escaparate** para todo el proyecto, o menú de la fila ▸ **Exportar fila ▸ Escaparate** para una sola fila."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منوی صدور ▸ **صدور ردیف‌ها ▸ ویترین** برای کل پروژه، یا منوی ردیف ▸ **صدور ردیف ▸ ویترین** برای یک ردیف."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vie-valikko ▸ **Vie rivit ▸ Showcase** koko projektille tai rivivalikko ▸ **Vie rivi ▸ Showcase** yhdelle riville."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menu Exporter ▸ **Exporter les lignes ▸ Vitrine** pour tout le projet, ou menu d'une ligne ▸ **Exporter la ligne ▸ Vitrine** pour une seule ligne."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "નિકાસ મેનૂ ▸ **આખા પ્રોજેક્ટ માટે પંક્તિઓ નિકાસ કરો ▸ શોકેસ** અથવા એક પંક્તિ મેનૂ ▸ **એક પંક્તિ માટે નિકાસ પંક્તિ ▸ શોકેસ**."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תפריט ייצוא ▸ **ייצוא שורות ▸ חלון ראווה** לכל הפרויקט, או תפריט שורות ▸ **ייצוא שורה ▸ חלון ראווה** לשורה אחת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निर्यात मेनू ▸ **पंक्तियाँ निर्यात करें ▸ शोकेस** पूरे प्रोजेक्ट के लिए, या एक पंक्ति मेनू ▸ **पंक्ति निर्यात करें ▸ शोकेस** एक पंक्ति के लिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbornik izvoza ▸ **Izvoz redaka ▸ Prikaz** za cijeli projekt ili izbornik reda ▸ **Izvoz reda ▸ Prikaz** za jedan red."

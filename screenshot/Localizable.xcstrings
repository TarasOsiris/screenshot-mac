    "Trackpad pinch and **⌘ + Scroll** also zoom on macOS." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf macOS zoomen auch Aufziehen/Zusammenziehen auf dem Trackpad und **⌘ + Scrollen**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En macOS, también puedes hacer zoom pellizcando el trackpad o con **⌘ + desplazamiento**."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در macOS، نیشگون روی ترک‌پد و **⌘ + پیمایش** هم بزرگ‌نمایی می‌کنند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur macOS, le pincement sur le trackpad et **⌘ + défilement** permettent aussi de zoomer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche il pizzico sul trackpad e **⌘ + Scorrimento** eseguono lo zoom su macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS では、トラックパッドのピンチや **⌘ + スクロール** でもズームできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS에서는 트랙패드 핀치와 **⌘ + 스크롤**로도 확대/축소할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No macOS, a pinça no trackpad e **⌘ + rolagem** também aplicam zoom."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В macOS масштаб также меняется щипком на трекпаде и **⌘ + прокрутка**."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS'te izleme dörtgeninde kıstırma ve **⌘ + Kaydırma** da yakınlaştırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зведення пальців на трекпеді та **⌘ + прокручування** також змінюють масштаб на macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 macOS 上，触控板双指捏合和 **⌘ + 滚动** 也可以缩放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 macOS 上，觸控式軌跡板的雙指開合和 **⌘ + 捲動**也可以縮放。"
          }
        }
      }
    },

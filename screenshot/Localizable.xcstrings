    "Double-click a **device** or **image** shape to open the picker and swap its picture." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelklicken Sie auf eine **Gerät**- oder **Bild**-Form, um die Auswahl zu öffnen und das Bild auszutauschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haga doble clic en una forma de **dispositivo** o **imagen** para abrir el selector e intercambiar su imagen."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روی یک شکل **دستگاه** یا **تصویر** دوبار کلیک کنید تا انتخابگر باز شود و تصویر آن عوض شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-cliquez sur une forme **appareil** ou **image** pour ouvrir le sélecteur et échanger son image."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai doppio clic su una forma **dispositivo** o **immagine** per aprire il selettore e sostituirne l'immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**デバイス** または **イメージ** 図形をダブルクリックしてピッカーを開き、その画像を交換します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**장치** 또는 **이미지** 모양을 두 번 클릭하여 선택기를 열고 그림을 바꿉니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique duas vezes em uma forma de **dispositivo** ou **imagem** para abrir o seletor e trocar sua imagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дважды нажмите фигуру **устройства** или **изображения**, чтобы открыть окно выбора и заменить картинку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçiciyi açıp resmini değiştirmek için bir **aygıt** veya **görüntü** şeklini çift tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двічі клацніть фігуру **пристрою** або **зображення**, щоб відкрити засіб вибору й замінити картинку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双击**设备**或**图像**形状以打开选择器并交换其图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按兩下**裝置**或**影像**形狀即可開啟選擇器並替換其圖片。"
          }
        }
      }
    },

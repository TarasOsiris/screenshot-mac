    "By default a row's background applies to every template in the row." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتراضيًا، تنطبق خلفية الصف على كل قالب في الصف."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De manera predeterminada, el fons d'una fila s'aplica a totes les plantilles de la fila."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve výchozím nastavení se pozadí řádku vztahuje na každou šablonu v řádku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som standard gælder en rækkes baggrund for hver skabelon i rækken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig gilt der Hintergrund einer Zeile für jede Vorlage in der Zeile."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Από προεπιλογή, το φόντο μιας σειράς ισχύει για κάθε πρότυπο στη σειρά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De forma predeterminada, el fondo de una fila se aplica a todas las plantillas de la fila."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به‌طور پیش‌فرض پس‌زمینهٔ ردیف روی همهٔ اسکرین‌شات‌های آن ردیف اعمال می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oletusarvoisesti rivin tausta koskee jokaista rivin mallia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut, l'arrière-plan d'une ligne s'applique à chaque modèle de la ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כברירת מחדל, הרקע של שורה חל על כל תבנית בשורה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prema zadanim postavkama pozadina retka primjenjuje se na svaki predložak u retku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alapértelmezés szerint egy sor háttere a sor minden sablonjára vonatkozik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secara default, latar belakang baris berlaku untuk setiap templat di baris tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per impostazione predefinita lo sfondo di una riga si applica a tutti i modelli della riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトでは、行の背景はその行内のすべてのテンプレートに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본적으로 행의 배경은 행의 모든 템플릿에 적용됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secara lalai, latar belakang baris digunakan pada setiap templat dalam baris."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standaard is de achtergrond van een rij van toepassing op elk sjabloon in de rij."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som standard gjelder bakgrunnen for en rad for hver mal i raden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domyślnie tło wiersza dotyczy każdego szablonu w wierszu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por padrão, o plano de fundo de uma linha se aplica a todos os modelos da linha."
          }

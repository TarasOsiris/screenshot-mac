    "Rename a variant to match it, or remove the treatment in App Store Connect." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد تسمية متغير لمطابقته، أو قم بإزالة المعالجة في App Store Connect."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvieu el nom d'una variant perquè coincideixi amb ella o suprimiu el tractament a App Store Connect."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejmenujte variantu, aby se s ní shodovala, nebo odeberte úpravu v App Store Connect."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omdøb en variant for at matche den, eller fjern behandlingen i App Store Connect."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benenne eine Variante passend um oder entferne das Treatment in App Store Connect."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετονομάστε μια παραλλαγή για να ταιριάζει με αυτήν ή καταργήστε τη θεραπεία στο App Store Connect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia el nombre de una variante para que coincida o quita el tratamiento en App Store Connect."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام یک نسخه را مطابق آن تغییر دهید، یا نسخه آزمایشی را در App Store Connect حذف کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimeä muunnelma uudelleen vastaamaan sitä tai poista käsittely termistä App Store Connect."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renommez une variante pour qu’elle corresponde, ou supprimez le traitement dans App Store Connect."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שנה שם גרסה כדי להתאים לה, או הסר את הטיפול ב-App Store Connect."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preimenujte varijantu da odgovara njoj ili uklonite tretman u App Store Connect."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nevezzen át egy változatot, hogy megfeleljen neki, vagy távolítsa el a kezelést a App Store Connect alatt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganti nama varian agar cocok, atau hapus perlakuan di App Store Connect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rinomina una variante in modo che corrisponda, oppure rimuovi il trattamento in App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一致するようにバリアント名を変更するか、App Store Connect でトリートメントを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일치하도록 변형 이름을 바꾸거나 App Store Connect에서 트리트먼트를 제거하세요."

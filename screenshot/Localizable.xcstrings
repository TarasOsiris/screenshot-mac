    "Checkout opens in your browser. When it's done, click **Open Screenshot Bro** to activate Pro on this Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم فتح الخروج في المتصفح الخاص بك. عند الانتهاء، انقر فوق **فتح Screenshot Bro** لتنشيط Pro على هذا Mac."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pagament s'obre al vostre navegador. Quan hagis acabat, fes clic a **Obre Screenshot Bro** per activar Pro en aquest Mac."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokladna se otevře ve vašem prohlížeči. Až budete hotovi, klikněte na **Otevřít Screenshot Bro** a aktivujte Pro na tomto Mac."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checkout åbner i din browser. Når det er færdigt, skal du klikke på **Åbn Screenshot Bro** for at aktivere Pro på denne Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bezahlvorgang öffnet sich in deinem Browser. Klicke danach auf **Open Screenshot Bro**, um Pro auf diesem Mac zu aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Checkout ανοίγει στο πρόγραμμα περιήγησής σας. Όταν τελειώσετε, κάντε κλικ στο **Άνοιγμα Screenshot Bro** για να ενεργοποιήσετε το Pro σε αυτό το Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pago se abre en tu navegador. Cuando termine, haz clic en **Open Screenshot Bro** para activar Pro en este Mac."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پرداخت در مرورگر شما باز می‌شود. پس از پایان، روی **Open Screenshot Bro** کلیک کنید تا Pro روی این Mac فعال شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checkout avautuu selaimessasi. Kun se on valmis, napsauta **Avaa Screenshot Bro** aktivoidaksesi Pro tälle Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

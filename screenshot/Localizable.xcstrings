        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಟೂಲ್‌ಬಾರ್‌ನಲ್ಲಿ **ರಫ್ತು** ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ ಅಥವಾ ಪ್ರಸ್ತುತ ಪ್ರಾಜೆಕ್ಟ್ ಅನ್ನು ನೆನಪಿಡುವ ರಫ್ತು ಫೋಲ್ಡರ್‌ಗೆ ಸಲ್ಲಿಸಲು **⌘E** ಒತ್ತಿರಿ. ಯಾವುದೇ ಫೋಲ್ಡರ್ ಹೊಂದಿಸದಿದ್ದರೆ, ಒಂದನ್ನು ಆಯ್ಕೆ ಮಾಡಲು Screenshot Bro ನಿಮ್ಮನ್ನು ಕೇಳುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {

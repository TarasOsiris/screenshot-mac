    "Behind the scenes, an `NSMetadataQuery` watches each project for upload/download progress." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Hintergrund überwacht eine `NSMetadataQuery` jedes Projekt auf Upload- und Download-Fortschritt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Internamente, un `NSMetadataQuery` vigila el progreso de subida y descarga de cada proyecto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در پشت صحنه، یک `NSMetadataQuery` پیشرفت آپلود و دانلود هر پروژه را زیر نظر دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En coulisses, une requête `NSMetadataQuery` surveille la progression de l'envoi et du téléchargement de chaque projet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dietro le quinte, una `NSMetadataQuery` monitora ogni progetto per verificare l'avanzamento di caricamento e download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内部では、`NSMetadataQuery` が各プロジェクトのアップロード/ダウンロードの進行状況を監視しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내부적으로 `NSMetadataQuery`가 각 프로젝트의 업로드/다운로드 진행 상황을 감시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos bastidores, um `NSMetadataQuery` acompanha o progresso de envio/download de cada projeto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За кулисами `NSMetadataQuery` отслеживает ход выгрузки и загрузки каждого проекта."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka planda bir `NSMetadataQuery`, her projenin yükleme/indirme ilerlemesini izler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За лаштунками `NSMetadataQuery` відстежує перебіг вивантаження й завантаження кожного проєкту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在后台，`NSMetadataQuery` 会监视每个项目的上传/下载进度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在幕後，`NSMetadataQuery` 會監看每個專案的上傳／下載進度。"
          }
        }
      }
    },

    "%lld %@ will be safely synced across %lld %@, %lld %@, and %lld %@. Exact checksum matches will be preserved." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld %2$@ wird sicher über %3$lld %4$@, %5$lld %6$@ und %7$lld %8$@ synchronisiert. Genaue Prüfsummenübereinstimmungen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld %2$@ se sincronizará de forma segura entre %3$lld %4$@, %5$lld %6$@ y %7$lld %8$@. Se conservarán las coincidencias exactas de la suma de comprobación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld %2$@ به طور ایمن در بین %3$lld %4$@، %5$lld %6$@ و %7$lld %8$@ همگام‌سازی می‌شود. تطابق دقیق جمع کنترلی حفظ خواهد شد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld %2$@ sera synchronisé en toute sécurité sur %3$lld %4$@, %5$lld %6$@ et %7$lld %8$@. Les correspondances exactes de la somme de contrôle seront conservées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld %2$@ は %3$lld %4$@、%5$lld %6$@、および %7$lld %8$@ 全体で安全に同期されます。チェックサムの正確な一致は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {

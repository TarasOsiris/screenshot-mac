    "Variants are alternative screenshots to A/B test on your App Store product page." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المتغيرات هي لقطات شاشة بديلة لاختبار A/B على صفحة المنتج App Store الخاصة بك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভেরিয়েন্ট হল আপনার App Store পণ্য পৃষ্ঠায় A/B পরীক্ষার বিকল্প স্ক্রিনশট।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les variants són captures de pantalla alternatives a la prova A/B a la pàgina del vostre producte App Store."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varianty jsou alternativní snímky obrazovky k A/B testu na vaší produktové stránce App Store."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",

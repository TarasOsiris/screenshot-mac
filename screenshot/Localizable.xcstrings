          "stringUnit" : {
            "state" : "translated",
            "value" : "غیر فعال کرنے سے آپ کا iCloud ڈیٹا **نہیں** حذف ہوتا ہے — آپ کے پروجیکٹس اس وقت تک iCloud کنٹینر میں رہتے ہیں جب تک آپ انہیں دستی طور پر حذف نہیں کر دیتے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc tắt sẽ **không** xóa dữ liệu iCloud của bạn — các dự án của bạn vẫn nằm trong vùng chứa iCloud cho đến khi bạn xóa chúng theo cách thủ công."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用 **不会** 删除你的 iCloud 数据——你的项目会保留在 iCloud 容器中，直到你手动删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用後**不會**刪除你的 iCloud 資料——在你手動刪除之前，專案會保留在 iCloud 容器中。"
          }
        }
      }
    },

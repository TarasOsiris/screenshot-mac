        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चित्राला फ्रेममध्ये पुनर्स्थित करण्यासाठी ड्रॅग करा (किंवा प्रतिमेवर डबल-क्लिक करा)"

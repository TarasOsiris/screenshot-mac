    "`~/Library/Application Support/screenshot/projects.json` — index of all projects." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„~/Library/Application Support/screenshot/projects.json“ – Index aller Projekte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`~/Library/Application Support/screenshot/projects.json` — índice de todos los proyectos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`~/Library/Application Support/screenshot/projects.json` — فهرست همه پروژه ها."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`~/Library/Application Support/screenshot/projects.json` — index de tous les projets."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`~/Library/Application Support/screenshot/projects.json` — すべてのプロジェクトのインデックス。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`~/Library/Application Support/screenshot/projects.json` — 모든 프로젝트의 색인입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`~/Library/Application Support/screenshot/projects.json` — índice de todos os projetos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`~/Library/Application Support/screenshot/projects.json` — 所有项目的索引。"
          }
        }
      }
    },

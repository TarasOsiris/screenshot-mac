    "Free covers one project. Upgrade here anytime to unlock unlimited projects, rows, and templates." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يغطي مجانا مشروع واحد. قم بالترقية هنا في أي وقت لفتح عدد غير محدود من المشاريع والصفوف والقوالب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuït cobreix un projecte. Actualitza aquí en qualsevol moment per desbloquejar projectes, files i plantilles il·limitats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdarma pokrývá jeden projekt. Upgradujte zde kdykoli a odemkněte neomezený počet projektů, řádků a šablon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis dækker ét projekt. Opgrader her når som helst for at låse op for ubegrænsede projekter, rækker og skabeloner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlos deckt ein Projekt ab. Upgraden Sie hier jederzeit, um eine unbegrenzte Anzahl an Projekten, Zeilen und Vorlagen freizuschalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δωρεάν καλύπτει ένα έργο. Κάντε αναβάθμιση εδώ ανά πάσα στιγμή για να ξεκλειδώσετε απεριόριστα έργα, σειρές και πρότυπα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis cubre un proyecto. Actualice aquí en cualquier momento para desbloquear proyectos, filas y plantillas ilimitados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رایگان یک پروژه را پوشش می دهد. برای باز کردن قفل پروژه‌ها، ردیف‌ها و قالب‌های نامحدود، در هر زمان اینجا را ارتقا دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmainen kattaa yhden projektin. Päivitä täällä milloin tahansa avataksesi rajoittamattoman määrän projekteja, rivejä ja malleja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuit couvre un projet. Mettez à niveau ici à tout moment pour débloquer un nombre illimité de projets, de lignes et de modèles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חינם מכסה פרויקט אחד. שדרג כאן בכל עת כדי לפתוח פרויקטים, שורות ותבניות ללא הגבלה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besplatno pokriva jedan projekt. Nadogradite ovdje bilo kada kako biste otključali neograničen broj projekata, redaka i predložaka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ingyenes egy projektet fed le. Frissítsen itt bármikor, hogy korlátlan számú projektet, sorokat és sablonokat oldjon fel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis mencakup satu proyek. Tingkatkan versi di sini kapan saja untuk membuka proyek, baris, dan templat tanpa batas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料で 1 つのプロジェクトがカバーされます。ここからいつでもアップグレードして、無制限のプロジェクト、行、テンプレートのロックを解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료에는 하나의 프로젝트가 포함됩니다. 무제한 프로젝트, 행 및 템플릿을 잠금 해제하려면 언제든지 여기에서 업그레이드하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percuma meliputi satu projek. Tingkatkan di sini pada bila-bila masa untuk membuka kunci projek, baris dan templat tanpa had."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis omvat één project. Upgrade hier op elk gewenst moment om een ​​onbeperkt aantal projecten, rijen en sjablonen te ontgrendelen."
          }
        },
        "no" : {

    "Google Play allows at most %lld screenshots per type; this row has %lld." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play permet com a màxim %1$lld captures de pantalla per tipus; aquesta fila té %2$lld."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play tillader højst %1$lld skærmbilleder pr. type; denne række har %2$lld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play erlaubt höchstens %lld Screenshots pro Typ; diese Zeile hat %lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play permite como máximo %lld capturas por tipo; esta fila tiene %lld."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play برای هر نوع حداکثر %1$lld اسکرین‌شات می‌پذیرد؛ این ردیف %2$lld اسکرین‌شات دارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play allows at most %1$lld screenshots per type; tällä rivillä on %2$lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play autorise au maximum %lld captures d'écran par type ; cette ligne en contient %lld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play consente al massimo %lld screenshot per tipo; questa riga ne ha %lld."

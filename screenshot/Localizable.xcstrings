        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проєкти зберігатимуться локально. Інші комп’ютери Mac більше не бачитимуть оновлень."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منصوبوں کو مقامی طور پر رکھا جائے گا۔ دیگر Mac کو مزید اپ ڈیٹس نظر نہیں آئیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các dự án sẽ được lưu giữ tại địa phương. Các Mac khác sẽ không còn thấy nội dung cập nhật nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目将保留在本地。其他 Mac 将不再看到更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "專案將保留在本機。其他 Mac 將不再看到更新。"
          }
        }
      }
    },

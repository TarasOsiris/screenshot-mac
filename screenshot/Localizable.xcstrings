    "File names are zero-padded (`01_…`, `02_…`) so they sort correctly when uploaded." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els noms dels fitxers s'emplenen amb zero (`01_…`, `02_…`) de manera que s'ordenen correctament quan es pengen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filnavne er nulpolstrede (`01_…`, `02_...`), så de sorterer korrekt, når de uploades."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateinamen haben führende Nullen (`01_…`, `02_…`), damit sie beim Hochladen richtig sortiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres de archivo llevan ceros a la izquierda (`01_…`, `02_…`) para que se ordenen correctamente al subirlos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام فایل‌ها با صفر آغازین شماره‌گذاری می‌شوند (`01_…`، `02_…`) تا هنگام آپلود درست مرتب شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedostojen nimet on täytetty nollalla (`01_…`, `02_…`), joten ne lajitellaan oikein lähetettäessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms de fichiers sont complétés par des zéros (`01_…`, `02_…`) afin d'être triés correctement lors de l'envoi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nomi dei file hanno zeri iniziali (`01_…`, `02_…`) così vengono ordinati correttamente al caricamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイル名はゼロ埋めされる (`01_…`、`02_…`) ため、アップロード時に正しい順序で並びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 이름은 0으로 채워져(`01_…`, `02_…`) 업로드 시 올바르게 정렬됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestandsnamen zijn voorzien van nulvulling (`01_…`, `02_…`), zodat ze correct worden gesorteerd wanneer ze worden geüpload."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filnavn er null-polstret (`01_…`, `02_...`), så de sorterer riktig når de lastes opp."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os nomes dos arquivos têm zeros à esquerda (`01_…`, `02_…`) para ficarem na ordem certa ao serem enviados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os nomes dos ficheiros são preenchidos com zeros (`01_…`, `02_…`) para que sejam classificados corretamente quando carregados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имена файлов дополняются нулями (`01_…`, `02_…`), чтобы при загрузке они сортировались правильно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filnamnen är nollutfyllda (`01_…`, `02_...`) så de sorteras korrekt när de laddas upp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya adları sıfırla doldurulur (`01_…`, `02_…`); böylece yüklendiklerinde doğru sıralanırlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Імена файлів доповнюються нулями (`01_…`, `02_…`), тож після вивантаження вони сортуються правильно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件名会以零补齐（`01_…`、`02_…`），以便上传时正确排序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檔名會補零（`01_…`、`02_…`），以便上傳時能正確排序。"
          }
        }
      }
    },

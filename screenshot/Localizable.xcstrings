        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسکرین شات ها را از Photos یا Files روی بوم بکشید یا چند تا را به طور همزمان رها کنید تا ردیف پر شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser des captures d'écran de Photos ou de Fichiers sur un canevas, ou déposez-en plusieurs à la fois pour remplir la ligne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真またはファイルからスクリーンショットをキャンバスにドラッグするか、複数のスクリーンショットを一度にドロップして行を埋めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 또는 파일의 스크린샷을 캔버스로 드래그하거나 한 번에 여러 개를 드롭하여 행을 채웁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste capturas de tela de Fotos ou Arquivos para uma tela ou solte várias de uma vez para preencher a linha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将照片或文件中的屏幕截图拖到画布上，或一次放置多个屏幕截图以填充该行。"
          }
        }
      }
    },
    "Drag templates left/right to reorder. Reordering also reorders the exported file numbering." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen Sie die Vorlagen nach links/rechts, um sie neu anzuordnen. Durch die Neuordnung wird auch die Nummerierung der exportierten Dateien neu angeordnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastre las plantillas hacia la izquierda o hacia la derecha para reordenarlas. Reordenar también reordena la numeración del archivo exportado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای مرتب کردن مجدد الگوها را به چپ/راست بکشید. ترتیب مجدد، شماره گذاری فایل صادر شده را نیز تغییر می دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les modèles vers la gauche/droite pour les réorganiser. La réorganisation réorganise également la numérotation des fichiers exportés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テンプレートを左右にドラッグして順序を変更します。並べ替えると、エクスポートされたファイルの番号付けも並べ替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "템플릿을 왼쪽/오른쪽으로 드래그하여 재정렬하세요. 재정렬하면 내보낸 파일 번호도 재정렬됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste os modelos para a esquerda/direita para reordená-los. A reordenação também reordena a numeração do arquivo exportado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向左/向右拖动模板以重新排序。重新排序还会对导出的文件编号进行重新排序。"
          }
        }
      }
    },
    "Drag the rotation handle (above the shape) to rotate freely, or hold **⇧** while dragging it to snap to 15° steps. Type a degree value into the rotation field for exact control." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen Sie den Drehgriff (über der Form), um ihn frei zu drehen, oder halten Sie **⇧** gedrückt, während Sie ihn ziehen, um ihn in 15°-Schritten einzurasten. Geben Sie zur genauen Steuerung einen Gradwert in das Rotationsfeld ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastre el controlador de rotación (encima de la forma) para rotar libremente, o mantenga presionado **⇧** mientras lo arrastra para ajustar en pasos de 15°. Escriba un valor de grado en el campo de rotación para obtener un control exacto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دستگیره چرخش (بالای شکل) را بکشید تا آزادانه بچرخد، یا **⇧** را نگه دارید و در حین کشیدن آن تا 15 درجه گام بردارید. برای کنترل دقیق، مقدار درجه را در قسمت چرخش تایپ کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la poignée de rotation (au-dessus de la forme) pour la faire pivoter librement, ou maintenez **⇧** tout en la faisant glisser pour l'aligner par pas de 15°. Tapez une valeur de degré dans le champ de rotation pour un contrôle exact."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina la maniglia di rotazione (sopra la forma) per ruotare liberamente, oppure tieni premuto **⇧** mentre la trascini per procedere a scatti di 15°. Inserisci un valore in gradi nel campo della rotazione per un controllo preciso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回転ハンドル (図形の上) をドラッグして自由に回転させるか、**⇧** を押したままドラッグして 15 度ずつスナップします。正確に制御するには、回転フィールドに度の値を入力します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모양 위의 회전 핸들을 드래그하여 자유롭게 회전하거나 **⇧**를 누른 상태에서 드래그하여 15° 단위로 스냅합니다. 정확한 제어를 위해 회전 필드에 각도 값을 입력합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste a alça de rotação (acima da forma) para girar livremente ou segure **⇧** enquanto arrasta para ajustar em etapas de 15°. Digite um valor de grau no campo de rotação para controle exato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетаскивайте ручку поворота (над фигурой) для свободного поворота или удерживайте **⇧** во время перетаскивания для шага 15°. Для точного значения введите угол в поле поворота."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serbestçe döndürmek için döndürme tutamacını (şeklin üstünde) sürükleyin veya 15°'lik adımlara yaslamak için sürüklerken **⇧** tuşunu basılı tutun. Tam denetim için döndürme alanına bir derece değeri yazın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потягніть маркер повороту (над фігурою), щоб вільно обертати її, або утримуйте **⇧** під час перетягування, щоб обертати з кроком 15°. Для точного керування введіть значення в градусах у поле повороту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动旋转手柄（形状上方）以自由旋转，或按住 **⇧** 并拖动它以捕捉到 15° 步长。在旋转字段中输入角度值以进行精确控制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移旋轉控制點（位於形狀上方）即可自由旋轉，拖移時按住 **⇧** 則以 15° 為單位對齊。在旋轉欄位中輸入角度值即可精確控制。"
          }
        }
      }
    },

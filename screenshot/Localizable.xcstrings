          }
        }
      }
    },
    "This row uploads %lld screenshots. App Store Connect accepts %lld–%lld, but most apps show at least %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Zeile lädt %lld Screenshots hoch. App Store Connect akzeptiert %lld–%lld, aber die meisten Apps zeigen mindestens %lld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This row uploads %1$lld screenshots. App Store Connect accepts %2$lld–%3$lld, but most apps show at least %4$lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta fila sube %lld capturas. App Store Connect acepta %lld–%lld, pero la mayoría de apps muestra al menos %lld."

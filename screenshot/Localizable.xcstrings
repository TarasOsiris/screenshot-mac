    "Use the orientation control for supported frames, or the rotation control to rotate the entire shape including frame and screen content." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitzeu el control d'orientació per als marcs compatibles o el control de rotació per girar tota la forma, inclòs el marc i el contingut de la pantalla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug orienteringskontrollen til understøttede rammer eller rotationskontrollen til at rotere hele figuren inklusive ramme- og skærmindhold."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze die Ausrichtung für unterstützte Rahmen oder die Drehung, um die ganze Form samt Rahmen und Bildschirminhalt zu drehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el control de orientación en los marcos compatibles, o el de rotación para girar toda la forma, incluidos el marco y el contenido de la pantalla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای قاب‌های پشتیبانی‌شده از کنترل جهت استفاده کنید، یا با کنترل چرخش کل شکل را همراه با قاب و محتوای صفحه بچرخانید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä suuntasäädintä tuetuille kehyksille tai kiertosäädintä kääntääksesi koko muotoa, mukaan lukien kehyksen ja näytön sisällön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez la commande d'orientation pour les cadres compatibles, ou la commande de rotation pour faire pivoter toute la forme, cadre et contenu de l'écran compris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il controllo dell'orientamento per le cornici supportate, oppure il controllo della rotazione per ruotare l'intera forma, cornice e contenuto dello schermo compresi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対応しているフレームでは向きの設定を使うか、回転の設定でフレームと画面の内容を含む図形全体を回転させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지원되는 프레임에서는 방향 컨트롤을, 프레임과 화면 내용을 포함한 도형 전체를 돌리려면 회전 컨트롤을 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik de oriëntatiebediening voor ondersteunde frames, of de rotatiebediening om de hele vorm, inclusief frame- en scherminhoud, te roteren."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk orienteringskontrollen for støttede rammer, eller rotasjonskontrollen for å rotere hele formen inkludert ramme- og skjerminnhold."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o controle de orientação nas molduras compatíveis ou o controle de rotação para girar a forma inteira, incluindo a moldura e o conteúdo da tela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o controle de orientação para quadros suportados ou o controle de rotação para girar a forma inteira, incluindo o quadro e o conteúdo da ecrã."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте переключатель ориентации для поддерживаемых рамок или элемент поворота, чтобы повернуть всю фигуру вместе с рамкой и содержимым экрана."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd orienteringskontrollen för ramar som stöds, eller rotationskontrollen för att rotera hela formen inklusive ram- och skärminnehåll."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desteklenen çerçeveler için yön denetimini, çerçeve ve ekran içeriği dahil şeklin tamamını döndürmek için ise döndürme denetimini kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте елемент орієнтації для рамок, що її підтримують, або елемент повороту, щоб повернути всю фігуру разом із рамкою та вмістом екрана."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于支持的边框，可使用方向控件；也可使用旋转控件旋转整个形状，包括边框和屏幕内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對支援的外框使用方向控制項目，或使用旋轉控制項目旋轉整個形狀，包括外框和螢幕內容。"
          }
        }
      }
    },
    "Use the project picker in the toolbar to jump between projects." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitzeu el selector de projectes de la barra d'eines per saltar entre els projectes."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug projektvælgeren på værktøjslinjen til at springe mellem projekter."
          }
        },
        "de" : {

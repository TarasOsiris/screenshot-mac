        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il progetto è cambiato dopo la creazione dell'anteprima. Aggiorna la revisione prima di sincronizzare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレビューの作成後にプロジェクトが変更されました。同期する前にレビューを更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리보기가 생성된 후 프로젝트가 변경되었습니다. 동기화하기 전에 리뷰를 새로 고치세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

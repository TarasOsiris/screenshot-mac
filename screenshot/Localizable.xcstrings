        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปแบบต่างๆ เป็นภาพหน้าจอทางเลือกสำหรับการทดสอบ A/B บนหน้าผลิตภัณฑ์ App Store ของคุณ"

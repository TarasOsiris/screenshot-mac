    "Use Edit Translations for a side-by-side view" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie „Übersetzungen bearbeiten“ für eine Parallelansicht"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Editar traducciones para una vista en paralelo"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از ویرایش ترجمه ها برای نمای کنار هم استفاده کنید"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Modifier les traductions pour une vue côte à côte"
          }
        },
        "ja" : {
          "stringUnit" : {

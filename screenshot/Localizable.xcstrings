            "value" : "Adicione uma linha em um tamanho iPhone Duo — 2007×2853 para a ecrã interna ou 1398×2034 para a ecrã externa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте строку размера iPhone Duo — 2007×2853 для внутреннего дисплея или 1398×2034 для внешнего."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till en rad med en iPhone Duo-storlek — 2007×2853 för den inre displayen eller 1398×2034 för den yttre displayen."
          }
        },
        "tr" : {
          "stringUnit" : {

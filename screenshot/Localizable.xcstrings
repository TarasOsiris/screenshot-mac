        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçe aktarılan fontlar projeyle birlikte paketlenir; böylece iCloud eşzamanlamasında ve proje aktarımında korunurlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Імпортовані шрифти вкладаються в проєкт, тож не губляться під час синхронізації iCloud і передавання проєкту."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امپورٹڈ فونٹس پروجیکٹ کے ساتھ بنڈل ہوتے ہیں تاکہ وہ iCloud مطابقت پذیری اور پروجیکٹ کی منتقلی سے بچ جائیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các phông chữ đã nhập được đi kèm với dự án để chúng tồn tại trong quá trình đồng bộ hóa và chuyển dự án iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入的字体会与项目打包在一起，因此在 iCloud 同步和项目迁移后依然保留。"

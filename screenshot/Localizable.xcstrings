    "Disable one of these rows or choose a different display type before uploading." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتعطيل أحد هذه الصفوف أو اختر نوع عرض مختلف قبل التحميل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiveu una d'aquestes files o trieu un tipus de visualització diferent abans de penjar-la."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před nahráním deaktivujte jeden z těchto řádků nebo zvolte jiný typ zobrazení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiver en af disse rækker, eller vælg en anden visningstype før upload."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiviere vor dem Hochladen eine dieser Zeilen oder wähle einen anderen Anzeigetyp."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απενεργοποιήστε μία από αυτές τις σειρές ή επιλέξτε διαφορετικό τύπο εμφάνισης πριν από τη μεταφόρτωση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva una de estas filas o elige otro tipo de pantalla antes de subir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش از آپلود، یکی از این ردیف‌ها را غیرفعال کنید یا نوع نمایش دیگری انتخاب کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista jokin näistä riveistä käytöstä tai valitse toinen näyttötyyppi ennen lataamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez l’une de ces lignes ou choisissez un autre type d’affichage avant l’envoi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השבת אחת מהשורות האלה או בחר סוג תצוגה אחר לפני ההעלאה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onemogućite jedan od ovih redaka ili odaberite drugu vrstu prikaza prije učitavanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feltöltés előtt tiltsa le e sorok egyikét, vagy válasszon másik megjelenítési típust."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nonaktifkan salah satu baris ini atau pilih jenis tampilan lain sebelum mengunggah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva una di queste righe o scegli un tipo di display diverso prima del caricamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップロード前に、これらの行のいずれかを無効にするか、別の表示タイプを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업로드하기 전에 이 행 중 하나를 비활성화하거나 다른 디스플레이 유형을 선택하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumpuhkan salah satu daripada baris ini atau pilih jenis paparan lain sebelum memuat naik."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel een van deze rijen uit of kies een ander weergavetype voordat u uploadt."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiver en av disse radene eller velg en annen visningstype før du laster opp."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed przesłaniem wyłącz jeden z tych wierszy lub wybierz inny typ wyświetlania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative uma dessas linhas ou escolha outro tipo de exibição antes de enviar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative uma dessas linhas ou escolha um tipo de exibição diferente antes de carregar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezactivați unul dintre aceste rânduri sau alegeți un alt tip de afișare înainte de a încărca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",

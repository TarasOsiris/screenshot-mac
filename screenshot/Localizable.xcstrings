    "The dots stand in for your access token — the copied text carries the real one." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els punts representen el vostre testimoni d'accés: el text copiat porta el real."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikkerne står for dit adgangstoken - den kopierede tekst bærer den rigtige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Punkte stehen für dein Zugriffstoken – der kopierte Text enthält das echte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los puntos sustituyen a tu token de acceso: el texto copiado lleva el real."

    "Version %@ is %@ — screenshots can't be changed. Pick an editable version or create a new one in App Store Connect." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %1$@ ist %2$@ – Screenshots können nicht geändert werden. Wählen Sie eine bearbeitbare Version aus oder erstellen Sie eine neue in App Store Connect."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Version %1$@ is %2$@ — screenshots can't be changed. Pick an editable version or create a new one in App Store Connect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versión %1$@ es %2$@; las capturas de pantalla no se pueden cambiar. Elija una versión editable o cree una nueva en App Store Connect."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخه %1$@ %2$@ است — تصاویر صفحه را نمی توان تغییر داد. یک نسخه قابل ویرایش انتخاب کنید یا در App Store Connect نسخه جدیدی ایجاد کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version %1$@ est %2$@ — les captures d'écran ne peuvent pas être modifiées. Choisissez une version modifiable ou créez-en une nouvelle dans App Store Connect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versione %@ è nello stato %@: gli screenshot non possono essere modificati. Scegli una versione modificabile o creane una nuova in App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バージョン %1$@ は %2$@ です — スクリーンショットは変更できません。編集可能なバージョンを選択するか、App Store Connect で新しいバージョンを作成します。"

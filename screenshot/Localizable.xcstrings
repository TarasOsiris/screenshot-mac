    "**Center** places a shape vertically, horizontally, or at the exact center of its screenshot." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**الوسط** يضع الشكل رأسيًا أو أفقيًا أو في منتصف لقطة الشاشة بالضبط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Centre** col·loca una forma verticalment, horitzontalment o al centre exacte de la seva captura de pantalla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Střed** umístí tvar svisle, vodorovně nebo přesně do středu snímku obrazovky."

    "Project order can be set to **By creation date** or **Alphabetically** in Settings ▸ General." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ordre del projecte es pot configurar a **Per data de creació** o **Alfabèticament** a Configuració ▸ General."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projektrækkefølgen kan indstilles til **Efter oprettelsesdato** eller **Alfabetisk** i Indstillinger ▸ Generelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Projektreihenfolge lässt sich unter „Einstellungen ▸ Allgemein“ auf **Nach Erstellungsdatum** oder **Alphabetisch** stellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El orden de los proyectos puede ser **Por fecha de creación** o **Alfabéticamente** en Ajustes ▸ General."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتیب پروژه‌ها را می‌توان در تنظیمات ▸ عمومی روی **بر اساس تاریخ ایجاد** یا **بر اساس حروف الفبا** گذاشت."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projektin järjestyksen voi asettaa **Luomispäivämäärän mukaan** tai **Aakkosjärjestyksessä** kohdassa Asetukset ▸ Yleiset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ordre des projets peut être défini sur **Par date de création** ou **Par ordre alphabétique** dans Réglages ▸ Général."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ordine dei progetti può essere impostato su **Per data di creazione** o **Alfabetico** in Impostazioni ▸ Generali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトの順序は、設定 ▸ 一般 で **作成日順** または **アルファベット順** に設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트 순서는 설정 ▸ 일반에서 **생성 날짜별** 또는 **알파벳순**으로 설정할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De projectvolgorde kan worden ingesteld op **Op aanmaakdatum** of **Alfabetisch** in Instellingen ▸ Algemeen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosjektrekkefølge kan settes til **Etter opprettelsesdato** eller **Alfabetisk** i Innstillinger ▸ Generelt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ordem dos projetos pode ser definida como **Por data de criação** ou **Em ordem alfabética** em Ajustes ▸ Geral."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ordem do projeto pode ser definida como **Por data de criação** ou **Em ordem alfabética** em Configurações ▸ Geral."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порядок проектов можно задать — **По дате создания** или **По алфавиту** — в разделе «Настройки ▸ Основные»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projektordning kan ställas in på **Efter skapandedatum** eller **Alfabetiskt** i Inställningar ▸ Allmänt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proje sırası Ayarlar ▸ Genel bölümünde **Oluşturma tarihine göre** veya **Alfabetik** olarak ayarlanabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порядок проєктів можна задати як **За датою створення** або **За алфавітом** у розділі «Параметри ▸ Загальні»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可在“设置 ▸ 通用”中将项目顺序设为 **按创建日期** 或 **按字母顺序**。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {

    "PNG or JPEG, 320–3840 px per edge, aspect ratio up to 2:1, 2–8 images." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG o JPEG, 320–3840 px per vora, relació d'aspecte de fins a 2:1, 2–8 imatges."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG eller JPEG, 320–3840 px pr. kant, billedformat op til 2:1, 2–8 billeder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG oder JPEG, 320–3840 Pixel pro Kante, Seitenverhältnis bis zu 2:1, 2–8 Bilder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG o JPEG, 320–3840 px por borde, relación de aspecto de hasta 2:1, 2–8 imágenes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG یا JPEG، ۳۲۰–۳۸۴۰ پیکسل در هر لبه، نسبت تصویر تا ۲:۱، ۲ تا ۸ عکس."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG tai JPEG, 320–3840 px per reuna, kuvasuhde jopa 2:1, 2–8 kuvaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG ou JPEG, 320 à 3 840 px par bord, format d'image jusqu'à 2:1, 2 à 8 images."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG o JPEG, da 320 a 3840 px per lato, proporzioni fino a 2:1, da 2 a 8 immagini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG または JPEG、各辺 320～3840 px、アスペクト比 2:1 まで、画像 2～8 枚。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG 또는 JPEG, 한 변당 320~3840px, 가로세로 비율 최대 2:1, 이미지 2~8개."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG of JPEG, 320–3840 px per rand, beeldverhouding maximaal 2:1, 2–8 afbeeldingen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG eller JPEG, 320–3840 px per kant, sideforhold opptil 2:1, 2–8 bilder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG ou JPEG, 320–3840 px por lado, proporção de até 2:1, 2–8 imagens."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG ou JPEG, 320–3840 px por borda, proporção de até 2:1, 2–8 imagens."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG или JPEG, 320–3840 пикс. по каждой стороне, соотношение сторон до 2:1, от 2 до 8 изображений."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG eller JPEG, 320–3840 px per kant, bildförhållande upp till 2:1, 2–8 bilder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG veya JPEG, kenar başına 320–3840 px, en fazla 2:1 en boy oranı, 2–8 görüntü."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG або JPEG, 320–3840 px за кожною стороною, пропорції до 2:1, 2–8 зображень."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG 或 JPEG，每边 320–3840 像素，宽高比最大 2:1，2–8 张图像。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

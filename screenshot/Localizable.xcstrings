            "state" : "translated",
            "value" : "جانچ اکاؤنٹ سے ایک ایپ کی فہرست دیتی ہے۔ اگر یہ گزر جاتا ہے لیکن اپ لوڈز ناکام ہو جاتے ہیں، تو چیک کریں کہ API کلید مخصوص ایپ اور ورژن میں ترمیم کر سکتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra liệt kê một ứng dụng từ tài khoản. Nếu điều này thành công nhưng tải lên không thành công, hãy kiểm tra xem khóa API có thể chỉnh sửa ứng dụng và phiên bản cụ thể hay không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测试时会列出账户中的一个 App。如果测试通过但上传失败，请检查 API 密钥是否可以编辑该 App 和版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "測試時會列出帳號中的一個 App。如果測試通過但上傳失敗，請確認 API 密鑰可以編輯特定的 App 和版本。"
          }
        }
      }
    },

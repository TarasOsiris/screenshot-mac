    "Z-order: **⌘⇧]** brings forward, **⌘⇧[** sends back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-Reihenfolge: **⌘⇧]** bringt vorwärts, **⌘⇧[** sendet zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orden Z: **⌘⇧]** adelanta, **⌘⇧[** devuelve."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-order: **⌘⇧]** به جلو می آورد، **⌘⇧[** پس می فرستد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordre Z : **⌘⇧]** avance, **⌘⇧[** renvoie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z オーダー: **⌘⇧]** は前進し、**⌘⇧[** は後退します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z 순서: **⌘⇧]** 앞으로 가져오고, **⌘⇧[** 뒤로 보냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordem Z: **⌘⇧]** antecipa, **⌘⇧[** envia de volta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z 顺序：**⌘⇧]** 向前推进，**⌘⇧[** 向后传送。"
          }
        }
      }
    },

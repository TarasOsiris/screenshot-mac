        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ mempunyai satu lagi baris saiz tangkapan skrin ini. Varian mengambil satu baris setiap saiz, jadi alihkan atau padamkan satu sebelum memuat naik."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ heeft nog een rij met deze schermgrootte. Een variant heeft één rij per maat nodig, dus verplaats of verwijder er één voordat u deze uploadt."

          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte klíč s oprávněním upravovat metadata aplikace. Role Držitel účtu, Správce nebo Správce aplikací jsou typické pro nahrávání snímků obrazovky. Stáhněte si soubor soukromého klíče `.p8` (můžete jej stáhnout pouze jednou)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret en nøgle med tilladelse til at redigere app-metadata. Roller som kontoindehaver, administrator eller appadministrator er typiske for uploads af skærmbilleder. Download den private nøglefil \".p8\" (du kan kun downloade den én gang)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle einen Schlüssel mit der Berechtigung, App-Metadaten zu bearbeiten. Für Screenshot-Uploads sind die Rollen „Kontoinhaber“, „Administrator“ oder „App-Manager“ üblich. Lade die private Schlüsseldatei `.p8` herunter (das geht nur einmal)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργήστε ένα κλειδί με άδεια επεξεργασίας μεταδεδομένων εφαρμογής. Οι ρόλοι του κατόχου λογαριασμού, του διαχειριστή ή του διαχειριστή εφαρμογών είναι τυπικοί για μεταφορτώσεις στιγμιότυπων οθόνης. Κάντε λήψη του αρχείου ιδιωτικού κλειδιού «.p8» (μπορείτε να το κατεβάσετε μόνο μία φορά)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una clave con permiso para editar los metadatos de la app. Los roles Account Holder, Admin o App Manager son los habituales para subir capturas. Descarga el archivo de clave privada `.p8` (solo se puede descargar una vez)."
          }
        },
        "fa" : {
          "stringUnit" : {

        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei voitu lukea %1$lld kuvaa/kuvia, joita %2$@ käyttää %3$@:ssa. Tuo puuttuvat kuvakaappaukset uudelleen ennen lataamista, tai lataus julkaisee ne tyhjinä alueina."
          }

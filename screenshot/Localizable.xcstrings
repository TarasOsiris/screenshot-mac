          "stringUnit" : {
            "state" : "translated",
            "value" : "필수 App Store 데이터를 사용할 수 없으므로 이 세트를 포함할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

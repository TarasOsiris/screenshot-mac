        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خلاصہ Android فریمز پر، ایک **کیمرہ** ٹوگل کیمرے کا کٹ آؤٹ دکھاتا یا چھپاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trên các khung Android trừu tượng, nút bật tắt **Camera** hiển thị hoặc ẩn phần cắt camera."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

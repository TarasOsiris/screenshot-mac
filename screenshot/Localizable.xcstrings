        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇಲ್ಲಿಂದ ಪಠ್ಯ, ಚಿತ್ರಗಳು, ಸಾಧನಗಳು ಮತ್ತು ಆಕಾರಗಳನ್ನು ಸೇರಿಸಿ. ಅವರು ಆಯ್ಕೆಮಾಡಿದ ಸಾಲಿನಲ್ಲಿ ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತಾರೆ."

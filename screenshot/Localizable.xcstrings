            "value" : "PNG ಅಥವಾ JPEG, ಪ್ರತಿ ಅಂಚಿಗೆ 320–3840 px, ಆಕಾರ ಅನುಪಾತ 2:1, 2–8 ಚಿತ್ರಗಳು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG 또는 JPEG, 한 변당 320~3840px, 가로세로 비율 최대 2:1, 이미지 2~8개."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG അല്ലെങ്കിൽ JPEG, ഓരോ അരികിലും 320–3840 px, വീക്ഷണാനുപാതം 2:1, 2–8 ചിത്രങ്ങൾ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG किंवा JPEG, 320–3840 px प्रति धार, 2:1 पर्यंत गुणोत्तर, 2–8 प्रतिमा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG atau JPEG, 320–3840 px setiap tepi, nisbah bidang sehingga 2:1, 2–8 imej."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG of JPEG, 320–3840 px per rand, beeldverhouding maximaal 2:1, 2–8 afbeeldingen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG eller JPEG, 320–3840 px per kant, sideforhold opptil 2:1, 2–8 bilder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG lub JPEG, 320–3840 px na krawędź, proporcje do 2:1, 2–8 obrazów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG ou JPEG, 320–3840 px por lado, proporção de até 2:1, 2–8 imagens."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG ou JPEG, 320–3840 px por borda, proporção de até 2:1, 2–8 imagens."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG sau JPEG, 320–3840 px per margine, raport de aspect de până la 2:1, 2–8 imagini."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG или JPEG, 320–3840 пикс. по каждой стороне, соотношение сторон до 2:1, от 2 до 8 изображений."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG alebo JPEG, 320–3840 pixelov na okraj, pomer strán až 2:1, 2–8 obrázkov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG ali JPEG, 320–3840 slikovnih pik na rob, razmerje stranic do 2:1, 2–8 slik."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG eller JPEG, 320–3840 px per kant, bildförhållande upp till 2:1, 2–8 bilder."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG அல்லது JPEG, ஒரு விளிம்பிற்கு 320–3840 px, 2:1 வரை, 2–8 படங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG లేదా JPEG, ఒక్కో అంచుకు 320–3840 px, 2:1, 2–8 చిత్రాలు వరకు కారక నిష్పత్తి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG หรือ JPEG 320–3840 พิกเซลต่อขอบ อัตราส่วนภาพสูงสุด 2:1, 2–8 รูปภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG veya JPEG, kenar başına 320–3840 px, en fazla 2:1 en boy oranı, 2–8 görüntü."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG або JPEG, 320–3840 px за кожною стороною, пропорції до 2:1, 2–8 зображень."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG یا JPEG، 320–3840 px فی کنارے، پہلو کا تناسب 2:1 تک، 2–8 تصاویر۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG hoặc JPEG, 320–3840 px mỗi cạnh, tỷ lệ khung hình lên tới 2:1, 2–8 hình ảnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG 或 JPEG，每边 320–3840 像素，宽高比最大 2:1，2–8 张图像。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG 或 JPEG，每邊 320–3840 px，長寬比最高 2:1，2–8 張影像。"
          }
        }
      }

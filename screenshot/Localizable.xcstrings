    "**Ask before deleting rows and screenshots** — show a confirmation prompt for destructive row and screenshot actions." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Pregunteu abans de suprimir files i captures de pantalla**: mostra un missatge de confirmació per a accions destructives de fila i captura de pantalla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Spørg før du sletter rækker og skærmbilleder** — vis en bekræftelsesprompt for destruktive række- og skærmbilledehandlinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Vor dem Löschen von Zeilen und Screenshots nachfragen** – zeigt vor destruktiven Aktionen an Zeilen und Screenshots eine Bestätigung an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Preguntar antes de eliminar filas y capturas**: muestra una confirmación antes de las acciones destructivas en filas y capturas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**پرسیدن پیش از حذف ردیف‌ها و اسکرین‌شات‌ها** — پیش از کارهای مخرب روی ردیف و اسکرین‌شات، پیام تأیید نشان می‌دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Kysy ennen rivien ja kuvakaappausten poistamista** — näytä vahvistuskehote tuhoaville rivi- ja kuvakaappaustoiminnoille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Demander avant de supprimer des lignes et des captures d'écran** : affiche une invite de confirmation pour les actions destructrices sur les lignes et les captures d'écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Chiedi prima di eliminare righe e screenshot**: mostra una richiesta di conferma per le azioni distruttive su righe e screenshot."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**行とスクリーンショットを削除する前に確認** — 行やスクリーンショットを削除する操作の前に確認メッセージを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**행 및 스크린샷을 삭제하기 전에 확인** — 행과 스크린샷을 삭제하는 작업 전에 확인 메시지를 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Vraag voordat u rijen en schermafbeeldingen verwijdert**: toon een bevestigingsvraag voor destructieve rij- en schermafbeeldingsacties."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Spør før du sletter rader og skjermbilder** — vis en bekreftelsesmelding for destruktive rad- og skjermdumphandlinger."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Perguntar antes de excluir linhas e capturas de tela** — mostra uma confirmação antes de ações destrutivas em linhas e capturas de tela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Pergunte antes de excluir linhas e capturas de ecrã** — mostre um prompt de confirmação para ações destrutivas de linhas e capturas de ecrã."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Спрашивать перед удалением строк и скриншотов** — показывать запрос подтверждения перед необратимыми действиями со строками и скриншотами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Fråga innan du tar bort rader och skärmdumpar** — visa en bekräftelseprompt för destruktiva rad- och skärmdumpåtgärder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Satırları ve ekran görüntülerini silmeden önce sor** — yıkıcı satır ve ekran görüntüsü işlemleri için bir onay istemi gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Питати перед видаленням рядків і знімків екрана** — показує запит на підтвердження перед незворотними діями з рядками та знімками екрана."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**删除行和截图之前询问**——对行和截图执行破坏性操作前显示确认提示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**刪除列和螢幕截圖前先詢問**——執行破壞性的列和螢幕截圖操作前顯示確認提示。"
          }
        }
      }
    },
    "**Auto-Translate Missing Text** — fills in text shapes that don't yet have an override for the current language." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Traducció automàtica del text que falta**: omple formes de text que encara no tenen cap substitució per a l'idioma actual."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Auto-oversæt manglende tekst** — udfylder tekstformer, der endnu ikke har en tilsidesættelse af det aktuelle sprog."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Fehlenden Text automatisch übersetzen** – übersetzt alle Textformen, die für die aktuelle Sprache noch keine eigene Fassung haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Traducir automáticamente texto faltante**: rellena las formas de texto que aún no tienen una traducción para el idioma actual."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**ترجمهٔ خودکار متن‌های ترجمه‌نشده** — شکل‌های متنی‌ای را که هنوز برای زبان فعلی بازنویسی ندارند پر می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Käännä puuttuva teksti automaattisesti** — täyttää tekstimuodot, joilla ei vielä ole ohitusta nykyiselle kielelle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Traduire automatiquement le texte manquant** : remplit les formes de texte qui n'ont pas encore de traduction dans la langue actuelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Traduci automaticamente testo mancante**: compila le forme di testo che non hanno ancora una personalizzazione per la lingua corrente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**未翻訳のテキストを自動翻訳** — 現在の言語でまだ上書きがないテキスト図形を、翻訳で埋めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**누락된 텍스트 자동 번역** — 현재 언어에 아직 재정의가 없는 텍스트 도형을 채웁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Ontbrekende tekst automatisch vertalen** — vult tekstvormen in die nog geen overschrijving hebben voor de huidige taal."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Auto-oversett manglende tekst** — fyller ut tekstformer som ennå ikke har en overstyring for gjeldende språk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Traduzir automaticamente texto ausente** — preenche as formas de texto que ainda não têm uma substituição no idioma atual."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Tradução automática de texto ausente** — preenche formas de texto que ainda não possuem uma substituição para o idioma atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Автоперевод недостающего текста** — заполняет текстовые фигуры, у которых еще нет переопределения для текущего языка."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Översätt saknad text automatiskt** — fyller i textformer som ännu inte har en åsidosättning för det aktuella språket."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Eksik Metni Otomatik Çevir** — geçerli dil için henüz çevirisi olmayan metin şekillerini doldurur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Автоматично перекласти відсутній текст** — заповнює текстові фігури, які ще не мають перевизначення для поточної мови."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**自动翻译缺失的文本**——为当前语言中尚无覆盖内容的文本形状填入翻译。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**自動翻譯缺少的文字**——填入目前語言尚無覆寫內容的文字形狀。"
          }
        }
      }
    },
    "**Back up projects** — write a one-off zip of your project library to a folder you choose." : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Feu una còpia de seguretat dels projectes**: escriviu un zip únic de la vostra biblioteca de projectes a una carpeta que trieu."
          }
        },
        "da" : {

        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Ajustar** — redimensiona para que a imagem inteira fique visível; deixa faixas transparentes nas bordas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Ajustar** — dimensiona para que toda a imagem fique visível; deixa barras transparentes na caixa de correio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Fit** — se scalează astfel încât întreaga imagine să fie vizibilă; lasă bare transparente pentru cutia poștală."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",

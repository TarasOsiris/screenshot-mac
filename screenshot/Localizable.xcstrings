          }
        }
      }
    },
    "**iCloud Sync** — **Sync with iCloud** on or off, and the current sync status." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**iCloud-Synchronisierung** – **Mit iCloud synchronisieren** ein- oder ausschalten sowie der aktuelle Synchronisierungsstatus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Sincronización con iCloud**: la opción **Sincronizar con iCloud**, activada o desactivada, y el estado actual de la sincronización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Synchronisation iCloud** : activation ou désactivation de **Synchroniser avec iCloud**, et état actuel de la synchronisation."
          }
        },
        "it" : {

    "**Esc** deselects shapes; press again to deselect the row." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Esc** يلغي تحديد الأشكال؛ اضغط مرة أخرى لإلغاء تحديد الصف."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Esc** আকারগুলি অনির্বাচিত করে; সারিটি অনির্বাচন করতে আবার টিপুন।"

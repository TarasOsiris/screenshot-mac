        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 張目前的螢幕截圖沒有 App Store 總和檢查碼，因此會被取代而非保留。"
          }
        }
      }
    },
    "%lld field%@ saved across %lld locale%@ and %lld version%@." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {

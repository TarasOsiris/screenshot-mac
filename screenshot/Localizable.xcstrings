            "value" : "Wijzig het formaat van de rij naar een van: %1$@, of kies een overeenkomend weergavetype."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endre størrelsen på raden til en av: %1$@, eller velg en samsvarende visningstype."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

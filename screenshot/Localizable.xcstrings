    "%@ was partially uploaded before the last sync stopped. Refresh the review to re-diff this set — the sets that finished will not be uploaded again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تحميل %1$@ جزئيًا قبل توقف المزامنة الأخيرة. قم بتحديث المراجعة لإعادة توزيع هذه المجموعة — لن يتم تحميل المجموعات التي انتهت مرة أخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ s'ha penjat parcialment abans que s'aturi l'última sincronització. Actualitza la revisió per tornar a diferenciar aquest conjunt; els conjunts que hagin acabat no es tornaran a carregar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bylo částečně nahráno před zastavením poslední synchronizace. Obnovte recenzi, chcete-li tuto sadu znovu porovnat – sady, které byly dokončeny, nebudou znovu nahrány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ blev delvist uploadet, før den sidste synkronisering stoppede. Opdater anmeldelsen for at ændre dette sæt - de sæt, der blev færdige, vil ikke blive uploadet igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde teilweise hochgeladen, bevor die letzte Synchronisierung abbrach. Aktualisiere die Änderungsübersicht, um dieses Set neu zu vergleichen – bereits abgeschlossene Sets werden nicht erneut hochgeladen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %1$@ μεταφορτώθηκε μερικώς πριν διακοπεί ο τελευταίος συγχρονισμός. Ανανεώστε την κριτική για να διαφοροποιήσετε ξανά αυτό το σύνολο — τα σύνολα που ολοκληρώθηκαν δεν θα μεταφορτωθούν ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El conjunto %@ se subió parcialmente antes de que se detuviera la última sincronización. Actualiza la revisión para volver a comparar este conjunto; los que terminaron no se volverán a subir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ پیش از توقف آخرین همگام‌سازی تا حدی آپلود شد. بازبینی را بازخوانی کنید تا تغییرات این مجموعه دوباره محاسبه شود — مجموعه‌هایی که کامل شده‌اند دوباره آپلود نمی‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ladattiin osittain ennen kuin viimeisin synkronointi lopetettiin. Päivitä arvostelu erotellaksesi tätä sarjaa uudelleen – valmiita sarjoja ei ladata uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a été partiellement envoyé avant l'arrêt de la dernière synchronisation. Actualisez l'examen pour recomparer cet ensemble — les ensembles terminés ne seront pas renvoyés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ הועלה חלקית לפני שהסנכרון האחרון הופסק. רענן את הסקירה כדי לשנות מחדש את הסט הזה - הסטים שהסתיימו לא יועלו שוב."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ je djelomično prenesen prije nego što je posljednja sinkronizacija zaustavljena. Osvježite recenziju za ponovno razlikovanje ovog skupa — kompleti koji su završili neće se ponovno učitati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$@ részben fel lett töltve az utolsó szinkronizálás leállítása előtt. Frissítse az áttekintést a készlet újbóli megkülönböztetéséhez – a kész készletek nem kerülnek újra feltöltésre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ diunggah sebagian sebelum sinkronisasi terakhir dihentikan. Segarkan ulasan untuk mendiff ulang kumpulan ini — kumpulan yang sudah selesai tidak akan diunggah lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è stato caricato parzialmente prima dell'interruzione dell'ultima sincronizzazione. Aggiorna la revisione per ricalcolare le differenze di questo set: i set completati non verranno caricati di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は前回の同期が停止する前に一部だけアップロードされました。レビューを更新してこのセットを再比較してください。完了したセットは再アップロードされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은 마지막 동기화가 중지되기 전에 부분적으로 업로드되었습니다. 이 세트를 다시 비교하려면 리뷰를 새로 고치세요. 완료된 세트는 다시 업로드되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ telah dimuat naik sebahagiannya sebelum penyegerakan terakhir dihentikan. Muat semula ulasan untuk membezakan semula set ini — set yang telah selesai tidak akan dimuat naik lagi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is gedeeltelijk geüpload voordat de laatste synchronisatie stopte. Vernieuw de beoordeling om deze set opnieuw te differentiëren. De voltooide sets worden niet opnieuw geüpload."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ble delvis lastet opp før den siste synkroniseringen stoppet. Oppdater anmeldelsen for å endre dette settet – settene som ble ferdige, vil ikke bli lastet opp igjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ został częściowo przesłany przed zatrzymaniem ostatniej synchronizacji. Odśwież recenzję, aby ponownie porównać ten zestaw — ukończone zestawy nie zostaną przesłane ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ foi enviado parcialmente antes de a última sincronização parar. Atualize a revisão para comparar este conjunto de novo — os conjuntos concluídos não serão enviados outra vez."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ foi parcialmente carregado antes da última sincronização ser interrompida. Atualize a revisão para diferenciar novamente este conjunto - os conjuntos concluídos não serão carregados novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a fost încărcat parțial înainte ca ultima sincronizare să se oprească. Actualizează recenzia pentru a rediferenția acest set — seturile care s-au terminat nu vor fi încărcate din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Набор %@ был загружен частично до остановки последней синхронизации. Обновите проверку, чтобы заново сравнить этот набор, — завершенные наборы повторно загружаться не будут."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bolo čiastočne odovzdané pred zastavením poslednej synchronizácie. Obnovte recenziu, aby ste mohli znova porovnať túto súpravu – súpravy, ktoré boli dokončené, sa znova nenahrajú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ je bil delno naložen pred zadnjo sinhronizacijo. Osvežite pregled, da znova razlikujete ta nabor — nabori, ki so končani, ne bodo ponovno naloženi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ laddades upp delvis innan den senaste synkroniseringen stoppades. Uppdatera recensionen för att ändra uppsättningen – de uppsättningar som är klara kommer inte att laddas upp igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ถูกอัปโหลดบางส่วนก่อนที่การซิงค์ครั้งล่าสุดจะหยุดลง รีเฟรชบทวิจารณ์เพื่อแยกชุดนี้ออกใหม่ ชุดที่เสร็จแล้วจะไม่ถูกอัปโหลดอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, son eşzamanlama durmadan önce kısmen yüklendi. Bu seti yeniden karşılaştırmak için incelemeyi yenileyin — tamamlanan setler yeniden yüklenmeyecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ було частково вивантажено до того, як зупинилася остання синхронізація. Оновіть перегляд, щоб знову порівняти цей набір, — завершені набори не вивантажуватимуться повторно."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آخری مطابقت پذیری بند ہونے سے پہلے %1$@ کو جزوی طور پر اپ لوڈ کیا گیا تھا۔ اس سیٹ کو دوبارہ مختلف کرنے کے لیے جائزے کو ریفریش کریں — ختم ہونے والے سیٹ دوبارہ اپ لوڈ نہیں کیے جائیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ đã được tải lên một phần trước khi ngừng đồng bộ hóa lần cuối. Làm mới bài đánh giá để phân biệt lại bộ này — những bộ đã hoàn thành sẽ không được tải lên lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在上次同步停止前已部分上传。请刷新检查页面以重新比对此组——已完成的组不会再次上传。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在上次同步停止前已部分上傳。請重新整理檢查畫面以重新比對此組——已完成的組不會再次上傳。"
          }
        }
      }
    },

    "Double-click a **device** or **image** shape to open the picker and swap its picture." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر نقرًا مزدوجًا فوق شكل **جهاز** أو **صورة** لفتح المنتقي وتبديل صورته."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feu doble clic en una forma de **dispositiu** o **imatge** per obrir el selector i intercanviar-ne la imatge."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvojitým kliknutím na tvar **zařízení** nebo **obrázek** otevřete nástroj pro výběr a vyměňte jeho obrázek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobbeltklik på en **enhed**- eller **billede**-form for at åbne vælgeren og skifte dens billede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelklicke auf eine **Geräte**- oder **Bild**form, um die Auswahl zu öffnen und das Bild auszutauschen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε διπλό κλικ σε ένα σχήμα **συσκευής** ή **εικόνας** για να ανοίξετε το εργαλείο επιλογής και να αλλάξετε την εικόνα του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz doble clic en una forma de **dispositivo** o de **imagen** para abrir el selector y cambiar su imagen."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روی یک شکل **دستگاه** یا **تصویر** دوبار کلیک کنید تا انتخابگر باز شود و تصویر آن عوض شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaksoisnapsauta **laitteen** tai **kuvan** muotoa avataksesi valitsimen ja vaihtaaksesi sen kuvaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-cliquez sur une forme **appareil** ou **image** pour ouvrir le sélecteur et échanger son image."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחץ פעמיים על צורת **מכשיר** או **תמונה** כדי לפתוח את הבורר ולהחליף את התמונה שלו."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvaput kliknite oblik **uređaja** ili **slike** da biste otvorili alat za odabir i zamijenili njegovu sliku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kattintson duplán egy **eszköz** vagy **kép** alakzatra a kiválasztó megnyitásához és a kép felcseréléséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik dua kali bentuk **perangkat** atau **gambar** untuk membuka pemilih dan menukar gambarnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai doppio clic su una forma **dispositivo** o **immagine** per aprire il selettore e sostituirne l'immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**デバイス** または **画像** の図形をダブルクリックするとピッカーが開き、画像を差し替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**기기** 또는 **이미지** 도형을 두 번 클릭하면 선택기가 열려 이미지를 바꿀 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik dua kali bentuk **peranti** atau **imej** untuk membuka pemilih dan menukar gambarnya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbelklik op een **apparaat**- of **afbeelding**-vorm om de kiezer te openen en de bijbehorende afbeelding te verwisselen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobbeltklikk på en **enhet** eller **bilde**-form for å åpne velgeren og bytte bildet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij dwukrotnie kształt **urządzenie** lub **obraz**, aby otworzyć selektor i zamienić jego obraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique duas vezes em uma forma de **dispositivo** ou **imagem** para abrir o seletor e trocar sua imagem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique duas vezes em uma forma de **dispositivo** ou **imagem** para abrir o seletor e trocar sua imagem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faceți dublu clic pe o formă de **dispozitiv** sau **imagine** pentru a deschide selectorul și a schimba imaginea acestuia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дважды нажмите фигуру **устройства** или **изображения**, чтобы открыть окно выбора и заменить картинку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvojitým kliknutím na tvar **zariadenia** alebo **obrázka** otvorte nástroj na výber a vymeňte jeho obrázok."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvokliknite obliko **naprave** ali **slike**, da odprete izbirnik in zamenjate njegovo sliko."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbelklicka på en **enhet** eller **bild** form för att öppna väljaren och byta bild."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คลิกสองครั้งที่รูปร่าง **อุปกรณ์** หรือ **รูปภาพ** เพื่อเปิดเครื่องมือเลือกและสลับรูปภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçiciyi açıp resmini değiştirmek için bir **aygıt** veya **görüntü** şeklini çift tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двічі клацніть фігуру **пристрою** або **зображення**, щоб відкрити засіб вибору й замінити картинку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چننے والے کو کھولنے اور اس کی تصویر کو تبدیل کرنے کے لیے **آلہ** یا **تصویری** شکل پر ڈبل کلک کریں۔"

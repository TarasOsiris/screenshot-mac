            "value" : "**روی مقدار فاصلهٔ حروف دوبار کلیک کنید** تا به مقدار پیش‌فرض برگردد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Kaksoisnapsauta kirjainvälin arvoa** palauttaaksesi sen oletusarvoon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Double-cliquez sur la valeur de l'espacement des lettres** pour rétablir la valeur par défaut."
          }
        },
        "he" : {
          "stringUnit" : {

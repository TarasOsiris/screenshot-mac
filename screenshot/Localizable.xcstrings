        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manteniu premut el **botó central del ratolí** i arrossegueu per panoràmica."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte **prostřední tlačítko myši** a přetažením se posunete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold **midterste museknap** nede, og træk for at panorere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die **mittlere Maustaste** gedrückt und zieh, um die Ansicht zu verschieben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρατήστε πατημένο το **μεσαίο κουμπί του ποντικιού** και σύρετε για μετατόπιση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el **botón central del ratón** y arrastra para desplazarte."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**دکمهٔ وسط ماوس** را نگه دارید و بکشید تا نما جابه‌جا شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä **hiiren keskipainiketta** painettuna ja panoroi vetämällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le **bouton central de la souris** et faites glisser pour effectuer un panoramique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החזק את **לחצן העכבר האמצעי** וגרור כדי להזיז."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držite **srednju tipku miša** i povucite za pomicanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsa lenyomva a **középső egérgombot**, és húzza a pásztázáshoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan **tombol tengah mouse** dan seret untuk menggeser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto il **pulsante centrale del mouse** e trascina per spostare la vista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**マウスの中ボタン** を押しながらドラッグするとパンできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**마우스 가운데 버튼**을 누른 채 드래그하여 이동하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",

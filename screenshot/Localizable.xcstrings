        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**הוסף צילום מסך** ו**הוסף אלמנט** - הוסף עמודת תבנית או צורה מבלי לעזוב את הכותרת."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Dodaj snimak zaslona** i **Dodaj element** — dodajte stupac predloška ili oblik bez napuštanja zaglavlja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Képernyőkép hozzáadása** és **Elem hozzáadása** – sablonoszlop vagy alakzat hozzáadása a fejléc elhagyása nélkül."
          }
        },
        "id" : {
          "stringUnit" : {

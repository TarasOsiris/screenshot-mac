    "Imported fonts are bundled with the project so they survive iCloud sync and project transfer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importierte Schriftarten werden mit dem Projekt gebündelt, sodass sie die iCloud Synchronisierung und Projektübertragung überstehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fuentes importadas se incluyen con el proyecto para que sobrevivan a la iCloud sincronización y transferencia del proyecto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فونت های وارد شده با پروژه همراه می شوند تا از همگام سازی iCloud و انتقال پروژه جان سالم به در ببرند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les polices importées sont regroupées avec le projet afin qu'elles survivent à la synchronisation iCloud et au transfert de projet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I font importati vengono inclusi nel progetto, così sopravvivono alla sincronizzazione iCloud e al trasferimento del progetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インポートされたフォントはプロジェクトにバンドルされているため、iCloud の同期やプロジェクトの転送後も存続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져온 글꼴은 프로젝트와 함께 번들로 제공되므로 iCloud 동기화 및 프로젝트 전송이 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fontes importadas são incluídas no projeto para que sobrevivam à sincronização iCloud e à transferência do projeto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импортированные шрифты хранятся вместе с проектом, поэтому сохраняются при синхронизации iCloud и переносе проекта."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçe aktarılan fontlar projeyle birlikte paketlenir; böylece iCloud eşzamanlamasında ve proje aktarımında korunurlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Імпортовані шрифти вкладаються в проєкт, тож не губляться під час синхронізації iCloud і передавання проєкту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入的字体与项目捆绑在一起，因此它们可以在 iCloud 同步和项目传输中保留下来。"

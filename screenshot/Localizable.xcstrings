          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povlecite sliko, da jo prestavite v okvir (ali dvokliknite sliko)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra bilden för att flytta den inuti ramen (eller dubbelklicka på bilden)"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "படத்தை சட்டகத்தின் உள்ளே மாற்றுவதற்கு இழுக்கவும் (அல்லது படத்தை இருமுறை கிளிக் செய்யவும்)"

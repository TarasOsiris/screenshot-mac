        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โครงการจะถูกเก็บไว้ภายในเครื่อง อุปกรณ์อื่นๆ จะไม่เห็นการอัปเดตอีกต่อไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projeler yerel olarak tutulacak. Diğer aygıtlar artık güncellemeleri görmeyecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проєкти зберігатимуться локально. Інші пристрої більше не бачитимуть оновлень."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منصوبوں کو مقامی طور پر رکھا جائے گا۔ دیگر آلات اب اپ ڈیٹس نہیں دیکھیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các dự án sẽ được lưu giữ tại địa phương. Các thiết bị khác sẽ không còn thấy bản cập nhật nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目将保留在本地。其他设备将不再看到更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "專案將保留在本機。其他裝置將不再看到更新。"
          }
        }
      }
    },

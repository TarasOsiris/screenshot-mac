    "Run a simulated upload — no service account required and no traffic is sent to Google Play." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتشغيل محاكاة تحميل - لا يلزم وجود حساب خدمة ولا يتم إرسال أي حركة مرور إلى Google Play."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executeu una càrrega simulada: no cal cap compte de servei i no s'envia trànsit a Google Play."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spusťte simulované nahrávání – není potřeba žádný servisní účet a na Google Play se neodesílá žádný provoz."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kør en simuleret upload — der kræves ingen servicekonto, og der sendes ingen trafik til Google Play."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe einen simulierten Upload durch – ohne Dienstkonto, und es wird nichts an Google Play gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτελέστε μια προσομοίωση μεταφόρτωσης — δεν απαιτείται λογαριασμός υπηρεσίας και δεν αποστέλλεται κίνηση στο Google Play."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta una subida simulada: no se necesita cuenta de servicio y no se envía tráfico a Google Play."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک آپلود شبیه‌سازی‌شده اجرا کنید — به حساب سرویس نیازی نیست و هیچ ترافیکی به Google Play ارسال نمی‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suorita simuloitu lataus – palvelutiliä ei vaadita, eikä liikennettä lähetetä kohteeseen Google Play."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez un envoi simulé — aucun compte de service requis, et rien n'est envoyé à Google Play."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפעל העלאה מדומה - לא נדרש חשבון שירות ולא נשלחת תנועה אל Google Play."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokrenite simulirani prijenos — nije potreban račun usluge i nema prometa na Google Play."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Futtasson szimulált feltöltést – nincs szükség szolgáltatásfiókra, és a rendszer nem küld forgalmat a Google Play címre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalankan simulasi upload — tidak diperlukan akun layanan dan tidak ada lalu lintas yang dikirim ke Google Play."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegui un caricamento simulato: non serve alcun account di servizio e nessun traffico viene inviato a Google Play."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップロードをシミュレーションします。サービスアカウントは不要で、Google Play には何も送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업로드를 시뮬레이션합니다. 서비스 계정이 필요 없으며 Google Play로는 아무 요청도 전송되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalankan muat naik simulasi — tiada akaun perkhidmatan diperlukan dan tiada trafik dihantar ke Google Play."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer een gesimuleerde upload uit: er is geen serviceaccount vereist en er wordt geen verkeer verzonden naar Google Play."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjør en simulert opplasting – ingen tjenestekonto kreves og ingen trafikk sendes til Google Play."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchom symulowane przesyłanie — nie jest wymagane konto usługi i żaden ruch nie jest wysyłany do Google Play."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa um envio simulado — sem conta de serviço e sem nenhum tráfego para o Google Play."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Execute um upload simulado. Nenhuma conta de serviço é necessária e nenhum tráfego é enviado para Google Play."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rulați o încărcare simulată — nu este necesar un cont de serviciu și nu se trimite trafic la Google Play."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имитация загрузки — сервисный аккаунт не нужен, и в Google Play ничего не отправляется."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustite simulované nahrávanie – nevyžaduje sa žiadny servisný účet a na Google Play sa neodosiela žiadna prevádzka."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaženite simulirano nalaganje — storitveni račun ni potreben in promet ni poslan na Google Play."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kör en simulerad uppladdning — inget tjänstkonto krävs och ingen trafik skickas till Google Play."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เรียกใช้การอัปโหลดจำลอง — ไม่ต้องใช้บัญชีบริการและไม่มีการส่งการรับส่งข้อมูลไปยัง Google Play"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benzetimli bir yükleme çalıştırın — hizmet hesabı gerekmez ve Google Play'e hiçbir trafik gönderilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запустіть імітацію вивантаження — сервісний обліковий запис не потрібен, і жодних даних не надсилається в Google Play."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقلی اپ لوڈ چلائیں — کسی سروس اکاؤنٹ کی ضرورت نہیں ہے اور Google Play کو کوئی ٹریفک نہیں بھیجا جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạy tải lên mô phỏng — không cần tài khoản dịch vụ và không có lưu lượng truy cập nào được gửi tới Google Play."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行模拟上传——无需服务账号，也不会向 Google Play 发送任何请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "執行模擬上傳——不需要服務帳號，也不會傳送任何流量到 Google Play。"
          }
        }
      }
    },
    "Run an export first, then click **Upload to App Store Connect** in the toolbar." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بإجراء عملية تصدير أولاً، ثم انقر فوق **تحميل إلى App Store Connect** في شريط الأدوات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primer executeu una exportació i, a continuació, feu clic a **Penja a App Store Connect** a la barra d'eines."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejprve spusťte export a poté na panelu nástrojů klikněte na **Nahrát do App Store Connect**."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kør først en eksport, og klik derefter på **Upload til App Store Connect** på værktøjslinjen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führen Sie zunächst einen Export durch und klicken Sie dann in der Symbolleiste auf **Upload to App Store Connect**."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτελέστε πρώτα μια εξαγωγή και, στη συνέχεια, κάντε κλικ στην **Μεταφόρτωση στο App Store Connect** στη γραμμή εργαλείων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero ejecute una exportación y luego haga clic en **Subir a App Store Connect** en la barra de herramientas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابتدا یک صادرات را اجرا کنید، سپس روی **آپلود در App Store Connect** در نوار ابزار کلیک کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suorita ensin vienti ja napsauta sitten työkalupalkissa **Lähetä kohteeseen App Store Connect**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécutez d'abord une exportation, puis cliquez sur **Télécharger vers App Store Connect** dans la barre d'outils."
          }
        },
        "he" : {
          "stringUnit" : {

    "%@ · %@ uses %lld image file(s) that could not be read, so the screenshots would upload with missing content. Re-add the affected images, then try again." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ verwendet %3$lld Bilddateien, die nicht gelesen werden konnten, sodass die Screenshots mit fehlendem Inhalt hochgeladen wurden. Fügen Sie die betroffenen Bilder erneut hinzu und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@ uses %3$lld image file(s) that could not be read, so the screenshots would upload with missing content. Re-add the affected images, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ utiliza %3$lld archivo(s) de imagen que no se pueden leer, por lo que las capturas de pantalla se cargarían con contenido faltante. Vuelva a agregar las imágenes afectadas y vuelva a intentarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ از %3$lld فایل(های) تصویری استفاده می کند که قابل خواندن نیستند، بنابراین اسکرین شات ها با محتوای گم شده آپلود می شوند. تصاویر آسیب دیده را دوباره اضافه کنید، سپس دوباره امتحان کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ utilise %3$lld fichier(s) image qui n'ont pas pu être lus, de sorte que les captures d'écran seraient téléchargées avec le contenu manquant. Ajoutez à nouveau les images concernées, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ は読み取れなかった %3$lld 画像ファイルを使用しているため、スクリーンショットはコンテンツが欠落した状態でアップロードされます。影響を受けるイメージを再度追加して、再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@은(는) 읽을 수 없는 %3$lld 이미지 파일을 사용하므로 콘텐츠가 누락된 스크린샷이 업로드됩니다. 영향을 받은 이미지를 다시 추가한 후 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ usa %3$lld arquivo(s) de imagem que não puderam ser lidos, então as capturas de tela seriam carregadas com conteúdo ausente. Adicione novamente as imagens afetadas e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ 使用无法读取的 %3$lld 图像文件，因此上传的屏幕截图会缺少内容。重新添加受影响的图像，然后重试。"
          }
        }
      }
    },
    "%@ · %@ uses %lld image files that could not be read, so the screenshots would upload with missing content. Re-add the affected images, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ verwendet %lld Bilddateien, die nicht gelesen werden konnten; die Screenshots würden daher mit fehlendem Inhalt hochgeladen. Füge die betroffenen Bilder erneut hinzu und versuche es noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@ uses %3$lld image files that could not be read, so the screenshots would upload with missing content. Re-add the affected images, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ usa %lld archivos de imagen que no se pudieron leer, así que las capturas se subirían con contenido faltante. Vuelve a añadir las imágenes afectadas e inténtalo otra vez."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ از %lld فایل تصویر استفاده می‌کند که خوانده نشدند؛ بنابراین اسکرین‌شات‌ها با محتوای ناقص آپلود می‌شوند. تصاویر مربوطه را دوباره اضافه کنید و دوباره تلاش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ utilise %lld fichiers image qui n’ont pas pu être lus ; les captures seraient donc envoyées avec du contenu manquant. Réajoutez les images concernées, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ usa %lld file immagine che non è stato possibile leggere, quindi gli screenshot verrebbero caricati con contenuti mancanti. Aggiungi di nuovo le immagini interessate, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ は読み込めない画像ファイルを%lld個使用しているため、スクリーンショットは内容が欠けた状態でアップロードされます。該当する画像を追加し直してから再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@에서 읽을 수 없는 이미지 파일 %3$lld개를 사용하고 있어, 업로드하면 스크린샷 콘텐츠가 누락됩니다. 해당 이미지를 다시 추가한 후 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ usa %lld arquivos de imagem que não puderam ser lidos, então as capturas seriam enviadas com conteúdo ausente. Adicione as imagens afetadas novamente e tente outra vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@: не удалось прочитать файлы изображений (%lld), поэтому скриншоты загрузились бы без части содержимого. Добавьте затронутые изображения заново и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@, okunamayan %lld görüntü dosyası kullanıyor; bu nedenle ekran görüntüleri eksik içerikle yüklenir. Etkilenen görüntüleri yeniden ekleyip tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ використовує файли зображень, які не вдалося прочитати (%lld), тож знімки екрана було б вивантажено з неповним вмістом. Додайте ці зображення знову й повторіть спробу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ 使用了 %lld 个无法读取的图像文件，因此截图上传后会缺少内容。请重新添加受影响的图像，然后重试。"

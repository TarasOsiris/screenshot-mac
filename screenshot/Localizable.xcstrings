    "Runs a local server on 127.0.0.1 so AI agents and MCP clients (like Claude Code) can create and edit projects, translate text, and export screenshots on your behalf." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم بتشغيل خادم محلي على 127.0.0.1 حتى يتمكن وكلاء الذكاء الاصطناعي وعملاء MCP (مثل Claude Code) من إنشاء المشاريع وتحريرها وترجمة النص وتصدير لقطات الشاشة نيابةً عنك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa un servidor local a 127.0.0.1 perquè els agents d'IA i els clients MCP (com Claude Code) puguin crear i editar projectes, traduir text i exportar captures de pantalla en nom vostre."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provozuje místní server na 127.0.0.1, takže agenti AI a klienti MCP (jako Claude Code) mohou vaším jménem vytvářet a upravovat projekty, překládat text a exportovat snímky obrazovky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kører en lokal server på 127.0.0.1, så AI-agenter og MCP-klienter (som Claude Code) kan oprette og redigere projekter, oversætte tekst og eksportere skærmbilleder på dine vegne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt einen lokalen Server unter 127.0.0.1 aus, damit KI-Agenten und MCP-Clients (wie Claude Code) in deinem Namen Projekte erstellen und bearbeiten, Texte übersetzen und Screenshots exportieren können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτελεί έναν τοπικό διακομιστή στην 127.0.0.1, ώστε οι πράκτορες AI και οι πελάτες MCP (όπως ο Claude Code) να μπορούν να δημιουργούν και να επεξεργάζονται έργα, να μεταφράζουν κείμενο και να εξάγουν στιγμιότυπα οθόνης για λογαριασμό σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta un servidor local en 127.0.0.1 para que los agentes de IA y los clientes MCP (como Claude Code) puedan crear y editar proyectos, traducir texto y exportar capturas en tu nombre."
          }
        },
        "fa" : {
          "stringUnit" : {

        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to zastosowanie tłumaczenia z języka podstawowego do każdej warstwy tekstowej w %1$@ i zastąpienie aktualnie przetłumaczonego tekstu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto aplica a tradução do idioma base a todas as camadas de texto em %@ e substitui o texto traduzido atual."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto aplica a tradução do idioma base a cada camada de texto em %1$@ e substitui o texto traduzido atual."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",

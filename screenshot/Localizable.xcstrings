    "Keep the script's name (%@) and save it inside the Application Scripts folder." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ باسم البرنامج النصي (%1$@) واحفظه داخل مجلد البرامج النصية للتطبيقات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserveu el nom de l'script (%1$@) i deseu-lo a la carpeta Application Scripts."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponechte název skriptu (%1$@) a uložte jej do složky Application Scripts."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behold scriptets navn (%1$@), og gem det i mappen Application Scripts."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalten Sie den Namen des Skripts (%1$@) bei und speichern Sie es im Ordner „Anwendungsskripte“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διατηρήστε το όνομα του σεναρίου (%1$@) και αποθηκεύστε το μέσα στο φάκελο Application Scripts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenga el nombre del script (%1$@) y guárdelo dentro de la carpeta Application Scripts."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام اسکریپت (%1$@) را نگه دارید و آن را در پوشه Application Scripts ذخیره کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilytä komentosarjan nimi (%1$@) ja tallenna se Application Scripts -kansioon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

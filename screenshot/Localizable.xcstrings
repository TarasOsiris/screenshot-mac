          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduci il testo una volta, impaginalo una volta, pubblica in ogni lingua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻訳もレイアウトも一度だけ。すべての言語でリリースできます。"

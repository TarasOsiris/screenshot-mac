            "value" : "나란히 보기를 위해 번역 편집을 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Editar traduções para uma visualização lado a lado"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

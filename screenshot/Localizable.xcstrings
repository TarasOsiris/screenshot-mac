          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshot Bro recuerda la última carpeta a la que exportaste (marcador de seguridad)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshot Bro آخرین پوشه ای را که به آن صادر کرده اید (نشانک با محدوده امنیتی) را به خاطر می آورد."

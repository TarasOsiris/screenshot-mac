        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、1つの見出しを2枚のスクリーンショットにまたがって配置するようなレイアウトが可能になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 스크린샷에 걸쳐 이어지는 헤드라인 같은 레이아웃이 가능한 이유가 바로 이것입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso é o que torna possíveis layouts como um único título que flui por duas capturas de tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Именно это позволяет создавать макеты, например, с одним заголовком, перетекающим через два скриншота."
          }
        },
        "tr" : {
          "stringUnit" : {

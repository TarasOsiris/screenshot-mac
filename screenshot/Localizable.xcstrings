        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为 %@ 设置的现有 %@ 屏幕截图可能已被删除。解决问题后，重新运行上传以重新填充该集。"
          }
        }
      }
    },
    "The first language is the base. Drag to reorder." : {

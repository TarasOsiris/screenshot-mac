          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduïu el **nom del paquet** de la vostra aplicació (per exemple, `com.example.myapp`) i reviseu quines captures de pantalla van a quin idioma abans de confirmar-les."

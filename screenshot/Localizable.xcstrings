    "%@ was partially uploaded before the last sync stopped. Refresh the review to re-diff this set — the sets that finished will not be uploaded again." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ s'ha penjat parcialment abans que s'aturi l'última sincronització. Actualitza la revisió per tornar a diferenciar aquest conjunt; els conjunts que hagin acabat no es tornaran a carregar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ blev delvist uploadet, før den sidste synkronisering stoppede. Opdater anmeldelsen for at ændre dette sæt - de sæt, der blev færdige, vil ikke blive uploadet igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde teilweise hochgeladen, bevor die letzte Synchronisierung abbrach. Aktualisiere die Änderungsübersicht, um dieses Set neu zu vergleichen – bereits abgeschlossene Sets werden nicht erneut hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El conjunto %@ se subió parcialmente antes de que se detuviera la última sincronización. Actualiza la revisión para volver a comparar este conjunto; los que terminaron no se volverán a subir."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ پیش از توقف آخرین همگام‌سازی تا حدی آپلود شد. بازبینی را بازخوانی کنید تا تغییرات این مجموعه دوباره محاسبه شود — مجموعه‌هایی که کامل شده‌اند دوباره آپلود نمی‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ladattiin osittain ennen kuin viimeisin synkronointi lopetettiin. Päivitä arvostelu erotellaksesi tätä sarjaa uudelleen – valmiita sarjoja ei ladata uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a été partiellement envoyé avant l'arrêt de la dernière synchronisation. Actualisez l'examen pour recomparer cet ensemble — les ensembles terminés ne seront pas renvoyés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è stato caricato parzialmente prima dell'interruzione dell'ultima sincronizzazione. Aggiorna la revisione per ricalcolare le differenze di questo set: i set completati non verranno caricati di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は前回の同期が停止する前に一部だけアップロードされました。レビューを更新してこのセットを再比較してください。完了したセットは再アップロードされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은 마지막 동기화가 중지되기 전에 부분적으로 업로드되었습니다. 이 세트를 다시 비교하려면 리뷰를 새로 고치세요. 완료된 세트는 다시 업로드되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is gedeeltelijk geüpload voordat de laatste synchronisatie stopte. Vernieuw de beoordeling om deze set opnieuw te differentiëren. De voltooide sets worden niet opnieuw geüpload."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ble delvis lastet opp før den siste synkroniseringen stoppet. Oppdater anmeldelsen for å endre dette settet – settene som ble ferdige, vil ikke bli lastet opp igjen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ foi enviado parcialmente antes de a última sincronização parar. Atualize a revisão para comparar este conjunto de novo — os conjuntos concluídos não serão enviados outra vez."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ foi parcialmente carregado antes da última sincronização ser interrompida. Atualize a revisão para diferenciar novamente este conjunto - os conjuntos concluídos não serão carregados novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Набор %@ был загружен частично до остановки последней синхронизации. Обновите проверку, чтобы заново сравнить этот набор, — завершенные наборы повторно загружаться не будут."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ laddades upp delvis innan den senaste synkroniseringen stoppades. Uppdatera recensionen för att ändra uppsättningen – de uppsättningar som är klara kommer inte att laddas upp igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, son eşzamanlama durmadan önce kısmen yüklendi. Bu seti yeniden karşılaştırmak için incelemeyi yenileyin — tamamlanan setler yeniden yüklenmeyecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ було частково вивантажено до того, як зупинилася остання синхронізація. Оновіть перегляд, щоб знову порівняти цей набір, — завершені набори не вивантажуватимуться повторно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在上次同步停止前已部分上传。请刷新检查页面以重新比对此组——已完成的组不会再次上传。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在上次同步停止前已部分上傳。請重新整理檢查畫面以重新比對此組——已完成的組不會再次上傳。"
          }
        }
      }
    },

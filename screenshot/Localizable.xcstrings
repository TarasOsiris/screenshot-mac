    "Models are grouped by category. Each shows available colors as small swatches." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تجميع النماذج حسب الفئة. يعرض كل منها الألوان المتاحة كعينات صغيرة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মডেল বিভাগ দ্বারা গোষ্ঠীভুক্ত করা হয়. প্রতিটি ছোট সোয়াচ হিসাবে উপলব্ধ রং দেখায়."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els models s'agrupen per categories. Cadascun mostra els colors disponibles com a petites mostres."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modely jsou seskupeny podle kategorií. Každá zobrazuje dostupné barvy jako malé vzorky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modeller er grupperet efter kategori. Hver viser tilgængelige farver som små farveprøver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelle sind nach Kategorie gruppiert. Jedes zeigt die verfügbaren Farben als kleine Farbfelder."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα μοντέλα ομαδοποιούνται ανά κατηγορία. Κάθε ένα δείχνει τα διαθέσιμα χρώματα ως μικρά δείγματα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modelos están agrupados por categoría. Cada uno muestra los colores disponibles como pequeñas muestras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدل‌ها بر اساس دسته گروه‌بندی شده‌اند. هر کدام رنگ‌های موجود را به‌صورت نمونه‌رنگ‌های کوچک نشان می‌دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mallit on ryhmitelty luokkien mukaan. Jokainen näyttää käytettävissä olevat värit pieninä tilkkuina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles sont regroupés par catégorie. Chacun affiche les couleurs disponibles sous forme de petits échantillons."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મોડેલો શ્રેણી દ્વારા જૂથ થયેલ છે. દરેક ઉપલબ્ધ રંગોને નાના સ્વેચ તરીકે બતાવે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הדגמים מקובצים לפי קטגוריות. כל אחד מציג צבעים זמינים כדוגמיות קטנות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मॉडलों को श्रेणी के आधार पर समूहीकृत किया गया है। प्रत्येक उपलब्ध रंगों को छोटे नमूनों के रूप में दिखाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modeli su grupirani po kategorijama. Svaki prikazuje dostupne boje kao male uzorke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A modellek kategóriák szerint vannak csoportosítva. Mindegyik kis mintaként mutatja az elérhető színeket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model dikelompokkan berdasarkan kategori. Masing-masing menunjukkan warna yang tersedia sebagai contoh kecil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I modelli sono raggruppati per categoria. Ognuno mostra i colori disponibili come piccoli campioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルはカテゴリごとにまとめられ、それぞれ選択できる色が小さなスウォッチで表示されます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮಾದರಿಗಳನ್ನು ವರ್ಗದಿಂದ ವರ್ಗೀಕರಿಸಲಾಗಿದೆ. ಪ್ರತಿಯೊಂದೂ ಲಭ್ಯವಿರುವ ಬಣ್ಣಗಳನ್ನು ಸಣ್ಣ ಸ್ವ್ಯಾಚ್‌ಗಳಾಗಿ ತೋರಿಸುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델은 카테고리별로 그룹화됩니다. 각각은 사용 가능한 색상을 작은 견본으로 표시합니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "മോഡലുകൾ വിഭാഗമനുസരിച്ച് തരം തിരിച്ചിരിക്കുന്നു. ഓരോന്നും ലഭ്യമായ നിറങ്ങൾ ചെറിയ സ്വിച്ചുകളായി കാണിക്കുന്നു."
          }
        },
        "mr" : {

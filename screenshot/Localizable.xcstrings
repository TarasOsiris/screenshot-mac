    "App Store Connect rejects this if the selected app version is iPhone-only." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرفض App Store Connect هذا إذا كان إصدار التطبيق المحدد هو iPhone فقط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect rebutja això si la versió de l'aplicació seleccionada només és iPhone."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect to odmítne, pokud je vybraná verze aplikace pouze iPhone."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect afviser dette, hvis den valgte appversion kun er iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect lehnt das ab, wenn die ausgewählte App-Version nur für iPhone ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",

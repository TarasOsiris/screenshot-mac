            "value" : "Belles captures de pantalla de App Store i Google Play fetes al teu Mac."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smukke App Store og Google Play skærmbilleder, lavet på din Mac."
          }
        },
        "de" : {
          "stringUnit" : {

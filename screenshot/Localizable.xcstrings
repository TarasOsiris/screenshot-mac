            "state" : "translated",
            "value" : "Os projetos serão mantidos localmente. Outros dispositivos não verão mais atualizações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проекты будут храниться локально. Другие устройства больше не будут получать обновления."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

    "%lld current screenshots have no App Store checksum, so they will be replaced instead of preserved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld لقطات الشاشة الحالية لا تحتوي على المجموع الاختباري App Store، لذلك سيتم استبدالها بدلاً من الاحتفاظ بها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld বর্তমান স্ক্রিনশটগুলির কোনও App Store চেকসাম নেই, তাই সেগুলি সংরক্ষণের পরিবর্তে প্রতিস্থাপন করা হবে৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures de pantalla actuals de %1$lld no tenen App Store suma de comprovació, de manera que es substituiran en lloc de conservar-se."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld aktuální snímky obrazovky nemají kontrolní součet App Store, takže budou nahrazeny namísto zachování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld nuværende skærmbilleder har ingen App Store kontrolsum, så de vil blive erstattet i stedet for at blive bevaret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld aktuelle Screenshots haben keine App Store-Prüfsumme und werden daher ersetzt statt beibehalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld τρέχοντα στιγμιότυπα οθόνης δεν έχουν App Store άθροισμα ελέγχου, επομένως θα αντικατασταθούν αντί να διατηρηθούν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld capturas actuales no tienen suma de verificación de App Store, por lo que se reemplazarán en lugar de conservarse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld اسکرین‌شات فعلی چک‌سام App Store ندارند، بنابراین به‌جای حفظ‌شدن، جایگزین می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld nykyisillä kuvakaappauksilla ei ole App Store tarkistussummaa, joten ne korvataan säilyttämisen sijaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld captures d'écran actuelles n'ont pas de somme de contrôle App Store : elles seront donc remplacées au lieu d'être conservées."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld વર્તમાન સ્ક્રીનશૉટ્સમાં કોઈ App Store ચેકસમ નથી, તેથી તેને સાચવવાને બદલે બદલવામાં આવશે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld לצילומי מסך נוכחיים אין App Store סכום בדיקה, ולכן הם יוחלפו במקום שיישמרו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld वर्तमान स्क्रीनशॉट में कोई App Store चेकसम नहीं है, इसलिए उन्हें संरक्षित करने के बजाय प्रतिस्थापित किया जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenutačne snimke zaslona %1$lld nemaju kontrolni zbroj App Store, pa će biti zamijenjene umjesto sačuvane."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az %1$lld jelenlegi képernyőképeinek nincs App Store ellenőrző összege, ezért megőrzés helyett lecserélik őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld tangkapan layar saat ini tidak memiliki checksum App Store, jadi tangkapan layar tersebut akan diganti dan bukan disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld screenshot attuali non hanno un checksum App Store, quindi verranno sostituiti anziché mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のスクリーンショットのうち%1$lld枚には App Store のチェックサムがないため、保持されずに置き換えられます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld ಪ್ರಸ್ತುತ ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ಗಳು ಯಾವುದೇ App Store ಚೆಕ್‌ಸಮ್ ಅನ್ನು ಹೊಂದಿಲ್ಲ, ಆದ್ದರಿಂದ ಅವುಗಳನ್ನು ಸಂರಕ್ಷಿಸುವ ಬದಲು ಬದಲಾಯಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 스크린샷 %lld개에 App Store 체크섬이 없어 보존되지 않고 교체됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld നിലവിലെ സ്‌ക്രീൻഷോട്ടുകൾക്ക് App Store ചെക്ക്‌സം ഇല്ല, അതിനാൽ അവ സംരക്ഷിക്കുന്നതിന് പകരം മാറ്റിസ്ഥാപിക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld वर्तमान स्क्रीनशॉटमध्ये App Store चेकसम नाही, त्यामुळे ते संरक्षित करण्याऐवजी बदलले जातील."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld tangkapan skrin semasa tidak mempunyai jumlah semak App Store, jadi ia akan diganti dan bukannya dipelihara."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld huidige schermafbeeldingen hebben geen App Store controlesom, dus worden ze vervangen in plaats van bewaard."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld gjeldende skjermbilder har ingen App Store kontrollsum, så de vil bli erstattet i stedet for å bli bevart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld bieżące zrzuty ekranu nie mają sumy kontrolnej App Store, więc zostaną zastąpione, a nie zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld capturas de tela atuais não têm soma de verificação da App Store, portanto serão substituídas em vez de preservadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld capturas de ecrã atuais não têm soma de verificação App Store, portanto serão substituídas em vez de preservadas."

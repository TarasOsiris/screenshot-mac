    "Screenshot sync was cancelled before anything was changed in App Store Connect." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Screenshot-Synchronisierung wurde abgebrochen, bevor in App Store Connect etwas geändert wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización de capturas se canceló antes de cambiar nada en App Store Connect."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",

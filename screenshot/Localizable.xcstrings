          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Billede** — indsæt alle PNG / JPEG / SVG. Vælg en udfyldningstilstand, og juster opaciteten."
          }
        },
        "de" : {
          "stringUnit" : {

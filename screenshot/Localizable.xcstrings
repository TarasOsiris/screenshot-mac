    "Delete rows from the row header or row menu. Settings ▸ General has a confirmation toggle." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösche Zeilen über die Kopfzeile oder das Menü der Zeile. Unter „Einstellungen ▸ Allgemein“ gibt es einen Schalter für eine Bestätigung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina filas desde el encabezado o el menú de la fila. Ajustes ▸ General tiene una opción de confirmación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ردیف‌ها را از سرِ ردیف یا منوی ردیف حذف کنید. در تنظیمات ▸ عمومی گزینه‌ای برای تأیید پیش از حذف هست."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimez des lignes depuis l'en-tête de ligne ou le menu de la ligne. Réglages ▸ Général propose une option de confirmation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina le righe dall'intestazione o dal menu della riga. Impostazioni ▸ Generali contiene un'opzione di conferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行は行ヘッダーまたは行メニューから削除します。設定 ▸ 一般 に確認の有無を切り替える設定があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "행 헤더 또는 행 메뉴에서 행을 삭제합니다. 설정 ▸ 일반에는 확인 토글이 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclua linhas pelo cabeçalho ou pelo menu da linha. Em Ajustes ▸ Geral há uma opção de confirmação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляйте строки из заголовка строки или меню строки. В разделе «Настройки ▸ Основные» есть переключатель подтверждения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satırları satır başlığından veya satır menüsünden silin. Ayarlar ▸ Genel'de bir onay anahtarı bulunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляйте рядки із заголовка рядка або меню рядка. У розділі «Параметри ▸ Загальні» є перемикач підтвердження."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可从行标题或行菜单中删除行。“设置 ▸ 通用”中有确认开关。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從列標題或列選單刪除列。「設定 ▸ 一般」中有確認切換開關。"
          }
        }
      }
    },

    "Each variant becomes one treatment in a product page experiment. The Original rows stay on your product page as the control." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ويصبح كل متغير علاجًا واحدًا في تجربة صفحة المنتج. تظل الصفوف الأصلية على صفحة منتجك كعنصر تحكم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি বৈকল্পিক একটি পণ্য পৃষ্ঠা পরীক্ষায় একটি চিকিত্সা হয়ে ওঠে। মূল সারিগুলি নিয়ন্ত্রণ হিসাবে আপনার পণ্য পৃষ্ঠায় থাকে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada variant es converteix en un tractament en un experiment de pàgina de producte. Les files originals es mantenen a la pàgina del producte com a control."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá varianta se stane jedním ošetřením v experimentu na stránce produktu. Řádky Original zůstanou na stránce vašeho produktu jako ovládací prvek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",

    "Demo mode is active. Real API key fields above are ignored until you turn demo mode off." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوضع التجريبي نشط. يتم تجاهل الحقول الرئيسية API الحقيقية أعلاه حتى تقوم بإيقاف تشغيل الوضع التجريبي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডেমো মোড সক্রিয়। আপনি ডেমো মোড বন্ধ না করা পর্যন্ত প্রকৃত API উপরের মূল ক্ষেত্রগুলি উপেক্ষা করা হবে৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mode de demostració està actiu. Els camps clau reals API anteriors s'ignoren fins que desactiveu el mode de demostració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demo režim je aktivní. Skutečná klíčová pole API výše jsou ignorována, dokud demo režim nevypnete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demotilstand er aktiv. Ægte API nøglefelter ovenfor ignoreres, indtil du slår demotilstand fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Demomodus ist aktiv. Die echten API-Schlüsselfelder oben werden ignoriert, bis du den Demomodus ausschaltest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η λειτουργία επίδειξης είναι ενεργή. Τα πεδία των πραγματικών κλειδιών API παραπάνω αγνοούνται μέχρι να απενεργοποιήσετε τη λειτουργία επίδειξης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo de demostración está activo. Los campos de la clave de API real de arriba se ignoran hasta que desactives el modo de demostración."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حالت نمایشی فعال است. تا زمانی که حالت نمایشی را خاموش نکنید، فیلدهای کلید واقعی API در بالا نادیده گرفته می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demotila on aktiivinen. Yllä olevat oikeat API-avainkentät ohitetaan, kunnes poistat esittelytilan käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode démo est actif. Les champs de clé API ci-dessus sont ignorés tant que vous n'avez pas désactivé le mode démo."

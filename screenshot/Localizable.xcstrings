    "Keep the token private — anyone who has it can control the app while the server is running." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حافظ على خصوصية الرمز المميز، حيث يمكن لأي شخص لديه هذا الرمز التحكم في التطبيق أثناء تشغيل الخادم."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantingueu el testimoni privat: qualsevol persona que el tingui pot controlar l'aplicació mentre el servidor s'executa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udržujte token v soukromí – každý, kdo jej má, může ovládat aplikaci, když je server spuštěný."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold tokenet privat - alle, der har det, kan styre appen, mens serveren kører."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte das Token geheim – wer es hat, kann die App steuern, solange der Server läuft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διατηρήστε το διακριτικό απόρρητο — οποιοσδήποτε το έχει μπορεί να ελέγξει την εφαρμογή ενώ λειτουργεί ο διακομιστής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No compartas el token: cualquiera que lo tenga puede controlar la app mientras el servidor esté en ejecución."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توکن را محرمانه نگه دارید — هر کسی آن را داشته باشد، تا وقتی سرور در حال اجراست می‌تواند برنامه را کنترل کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä tunnus yksityisenä – kuka tahansa, jolla on se, voi hallita sovellusta palvelimen ollessa käynnissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez le jeton privé : toute personne qui le possède peut contrôler l'application pendant que le serveur est en cours d'exécution."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השאר את האסימון פרטי - כל מי שיש לו יכול לשלוט באפליקציה בזמן שהשרת פועל."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držite token privatnim — svatko tko ga ima može kontrolirati aplikaciju dok poslužitelj radi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsa a tokent privátban – bárki, aki rendelkezik vele, vezérelheti az alkalmazást, miközben a szerver fut."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaga kerahasiaan token — siapa pun yang memilikinya dapat mengontrol aplikasi saat server sedang berjalan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni privato il token: chiunque lo possieda può controllare l'app mentre il server è in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トークンは他人に教えないでください。トークンを知っている人は誰でも、サーバの実行中にこのアプリを操作できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "토큰을 비공개로 유지하세요. 토큰을 가진 사람은 누구나 서버가 실행되는 동안 앱을 제어할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastikan token itu tertutup — sesiapa sahaja yang memilikinya boleh mengawal apl semasa pelayan sedang berjalan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd het token privé: iedereen die het heeft, kan de app besturen terwijl de server actief is."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold tokenet privat - alle som har det kan kontrollere appen mens serveren kjører."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowaj token jako prywatny — każdy, kto go posiada, może kontrolować aplikację, gdy serwer jest uruchomiony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o token privado – qualquer pessoa que o possua pode controlar o aplicativo enquanto o servidor estiver em execução."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o token privado – qualquer pessoa que o possua pode controlar o aplicativo enquanto o servidor estiver em execução."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Păstrați tokenul privat - oricine îl deține poate controla aplicația în timp ce serverul rulează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храните токен в секрете — любой, у кого он есть, может управлять приложением, пока работает сервер."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udržujte token súkromný – každý, kto ho má, môže ovládať aplikáciu, kým je server spustený."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žeton naj bo zaseben – vsak, ki ga ima, lahko nadzira aplikacijo, medtem ko strežnik deluje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll token privat – alla som har den kan styra appen medan servern är igång."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รักษาโทเค็นให้เป็นส่วนตัว — ใครก็ตามที่มีโทเค็นจะสามารถควบคุมแอปได้ในขณะที่เซิร์ฟเวอร์กำลังทำงานอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belirteci gizli tutun — sunucu çalışırken belirtece sahip olan herkes uygulamayı denetleyebilir."

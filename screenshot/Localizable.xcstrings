        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ uploader alle til Plays %2$@-liste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ werden alle in den Play-Eintrag %2$@ hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ se suben todos a la ficha %2$@ de Play."

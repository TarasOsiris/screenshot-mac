        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도구 모음의 확대/축소 슬라이더 범위는 50%1$ to 200%(25%2$ s테프)입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O controle deslizante de zoom na barra de ferramentas varia de 50%1$ to 200% em 25%2$ spassos."

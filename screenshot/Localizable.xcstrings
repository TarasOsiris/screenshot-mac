    "%@ · %@ uses %lld image file(s) that could not be read, so the screenshots would upload with missing content. Re-add the affected images, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ verwendet %3$lld Bilddateien, die nicht gelesen werden konnten, sodass die Screenshots mit fehlendem Inhalt hochgeladen wurden. Fügen Sie die betroffenen Bilder erneut hinzu und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@ uses %3$lld image file(s) that could not be read, so the screenshots would upload with missing content. Re-add the affected images, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ utiliza %3$lld archivo(s) de imagen que no se pueden leer, por lo que las capturas de pantalla se cargarían con contenido faltante. Vuelva a agregar las imágenes afectadas y vuelva a intentarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ از %3$lld فایل(های) تصویری استفاده می کند که قابل خواندن نیستند، بنابراین اسکرین شات ها با محتوای گم شده آپلود می شوند. تصاویر آسیب دیده را دوباره اضافه کنید، سپس دوباره امتحان کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ utilise %3$lld fichier(s) image qui n'ont pas pu être lus, de sorte que les captures d'écran seraient téléchargées avec le contenu manquant. Ajoutez à nouveau les images concernées, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ は読み取れなかった %3$lld 画像ファイルを使用しているため、スクリーンショットはコンテンツが欠落した状態でアップロードされます。影響を受けるイメージを再度追加して、再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@은(는) 읽을 수 없는 %3$lld 이미지 파일을 사용하므로 콘텐츠가 누락된 스크린샷이 업로드됩니다. 영향을 받은 이미지를 다시 추가한 후 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ usa %3$lld arquivo(s) de imagem que não puderam ser lidos, então as capturas de tela seriam carregadas com conteúdo ausente. Adicione novamente as imagens afetadas e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ 使用无法读取的 %3$lld 图像文件，因此上传的屏幕截图会缺少内容。重新添加受影响的图像，然后重试。"
          }
        }
      }
    },

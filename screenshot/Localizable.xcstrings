        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器在“127.0.0.1”上运行（仅环回）——无法从其他计算机或互联网访问它。"
          }
        }
      }
    },
    "The service account is connected and ready for screenshot uploads." : {
      "localizations" : {

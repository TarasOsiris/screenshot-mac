    "Saved as a draft — not sent for review. Send for review from the Play Console when ready." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'ha desat com a esborrany; no s'ha enviat a revisió. Quan estiguis a punt, envia'l per revisar-lo des de Play Console."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemt som en kladde – ikke sendt til gennemgang. Send til gennemgang fra Play Console, når du er klar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Entwurf gespeichert – nicht zur Prüfung gesendet. Sende ihn in der Play Console zur Prüfung, wenn du so weit bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado como borrador, sin enviar a revisión. Envíalo a revisión desde Play Console cuando quieras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به‌صورت پیش‌نویس ذخیره شد — برای بازبینی ارسال نشد. هر وقت آماده بودید، از Play Console برای بازبینی ارسال کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennettu luonnoksena – ei lähetetty tarkistettavaksi. Lähetä tarkastettavaksi Play Consolesta, kun olet valmis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré en tant que brouillon – non envoyé pour examen. Envoyez-le pour examen depuis la Play Console lorsque vous êtes prêt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvato come bozza, non inviato per la revisione. Invialo per la revisione dalla Play Console quando sei pronto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下書きとして保存しました（審査には送信されていません）。準備ができたら Play Console から審査に送信してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초안으로 저장되었으며 검토를 위해 전송되지 않았습니다. 준비가 되면 Play Console에서 검토를 위해 전송하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opgeslagen als concept, niet ter beoordeling verzonden. Verzend ter beoordeling vanuit de Play Console wanneer u klaar bent."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagret som et utkast – ikke sendt til vurdering. Send til vurdering fra Play-konsollen når du er klar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo como rascunho — não enviado para revisão. Envie para revisão pelo Play Console quando quiser."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado como rascunho — não enviado para revisão. Envie para análise no Play Console quando estiver pronto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",

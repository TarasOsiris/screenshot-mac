    "This version is %@ — screenshots can't be changed. Pick an editable version or create a new one in App Store Connect." : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta versió és %1$@: les captures de pantalla no es poden canviar. Trieu una versió editable o creeu-ne una de nova a App Store Connect."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne version er %1$@ — skærmbilleder kan ikke ændres. Vælg en redigerbar version, eller opret en ny i App Store Connect."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Version ist %@ – Screenshots können nicht geändert werden. Wählen Sie eine bearbeitbare Version aus oder erstellen Sie eine neue in App Store Connect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión está en %@ — las capturas no se pueden cambiar. Elige una versión editable o crea una nueva en App Store Connect."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این نسخه %1$@ است — تصاویر صفحه را نمی توان تغییر داد. یک نسخه قابل ویرایش انتخاب کنید یا یک نسخه جدید در App Store Connect ایجاد کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä versio on %1$@ — kuvakaappauksia ei voi muuttaa. Valitse muokattava versio tai luo uusi App Store Connect."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version est %@ — les captures d'écran ne peuvent pas être modifiées. Choisissez une version modifiable ou créez-en une nouvelle dans App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバージョンは %@ です。スクリーンショットは変更できません。編集可能なバージョンを選択するか、App Store Connect で新しいバージョンを作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버전은 %@입니다. 스크린샷을 변경할 수 없습니다. 편집 가능한 버전을 선택하거나 App Store Connect에서 새 버전을 만드세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze versie is %1$@ — schermafbeeldingen kunnen niet worden gewijzigd. Kies een bewerkbare versie of maak een nieuwe in App Store Connect."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne versjonen er %1$@ — skjermbilder kan ikke endres. Velg en redigerbar versjon eller lag en ny i App Store Connect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versão é %@ — as capturas de tela não podem ser alteradas. Escolha uma versão editável ou crie uma nova em App Store Connect."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versão é %1$@ — as capturas de ecrã não podem ser alteradas. Escolha uma versão editável ou crie uma nova em App Store Connect."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här versionen är %1$@ — skärmdumpar kan inte ändras. Välj en redigerbar version eller skapa en ny i App Store Connect."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本是 %@ — 屏幕截图无法更改。选择一个可编辑版本或在 App Store Connect 中创建一个新版本。"
          }
        }
      }
    },
    "This will remove all screenshots and shapes from \"%@\" and restore default settings." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això eliminarà totes les captures de pantalla i les formes de \"%1$@\" i restaurarà la configuració predeterminada."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil fjerne alle skærmbilleder og former fra \"%1$@\" og gendanner standardindstillingerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle Screenshots und Formen aus „%@“ entfernt und die Standardeinstellungen wiederhergestellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará todas las capturas y formas de «%@» y restaurará los ajustes predeterminados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با این کار همهٔ اسکرین‌شات‌ها و شکل‌های «%1$@» حذف و تنظیمات پیش‌فرض بازیابی می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä poistaa kaikki kuvakaappaukset ja muodot kohteesta %1$@ ja palauttaa oletusasetukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprimera toutes les captures d'écran et formes de « %@ » et rétablira les réglages par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno rimossi tutti gli screenshot e le forme da \"%@\" e verranno ripristinate le impostazioni predefinite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」からすべてのスクリーンショットと図形が削除され、デフォルト設定に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {

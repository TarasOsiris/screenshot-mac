        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play publiserer én oppføring per språk den støtter; alle andre språk laster opp normalt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play publikuje po jednym wpisie na każdy obsługiwany język. w każdym innym języku przesyłane są normalnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Play publica uma ficha da loja por idioma compatível; todos os outros idiomas são enviados normalmente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Play publica uma listagem por idioma compatível; todos os outros idiomas são carregados normalmente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play publică o înregistrare pentru fiecare limbă pe care o acceptă; orice altă limbă se încarcă în mod normal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play публикует одну страницу для каждого поддерживаемого языка; остальные языки загружаются как обычно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play publikuje jeden záznam pre každý jazyk, ktorý podporuje; každý iný jazyk sa nahráva normálne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play objavi en seznam za vsak jezik, ki ga podpira; vsi drugi jeziki se nalagajo normalno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play publicerar en lista per språk som det stöder; alla andra språk laddas upp normalt."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play அது ஆதரிக்கும் மொழிக்கு ஒரு பட்டியலை வெளியிடுகிறது; மற்ற எல்லா மொழிகளும் சாதாரணமாக பதிவேற்றுகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play అది మద్దతిచ్చే భాషకు ఒక జాబితాను ప్రచురిస్తుంది; ప్రతి ఇతర భాష సాధారణంగా అప్‌లోడ్ చేస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play เผยแพร่หนึ่งรายการต่อภาษาที่รองรับ ทุกภาษาอื่น ๆ จะอัปโหลดตามปกติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play desteklediği her dil için bir mağaza sayfası yayımlar; diğer tüm diller normal şekilde yüklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play публікує одну сторінку для кожної підтримуваної мови; решта мов вивантажується як зазвичай."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پلے ہر زبان میں ایک فہرست شائع کرتا ہے جس کی وہ حمایت کرتی ہے۔ ہر دوسری زبان عام طور پر اپ لوڈ ہوتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play xuất bản một danh sách cho mỗi ngôn ngữ mà nó hỗ trợ; mọi ngôn ngữ khác tải lên bình thường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play 会为其支持的每种语言发布一份商品详情；其他语言都会正常上传。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play 會為其支援的每種語言各發佈一份商店資訊；其他語言都會正常上傳。"
          }
        }
      }
    },

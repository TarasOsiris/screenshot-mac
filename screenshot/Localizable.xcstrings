    },
    "This sidebar always edits the currently selected row — set its screenshot size, background, and device frame, and add text, images, and shapes from the Shapes section." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta barra lateral sempre edita la fila seleccionada actualment: defineix la mida de la captura de pantalla, el fons i el marc del dispositiu, i afegeix text, imatges i formes des de la secció Formes."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne sidebjælke redigerer altid den aktuelt valgte række - indstil dens skærmbilledestørrelse, baggrund og enhedsramme, og tilføj tekst, billeder og figurer fra sektionen Former."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Seitenleiste bearbeitet immer die ausgewählte Zeile – lege ihre Screenshot-Größe, den Hintergrund und den Geräterahmen fest und füge Text, Bilder und Formen aus dem Abschnitt „Formen“ hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta barra lateral siempre edita la fila seleccionada: define el tamaño de captura, el fondo y el marco del dispositivo, y añade texto, imágenes y formas desde la sección Formas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این نوار کناری همیشه ردیف انتخاب‌شدهٔ فعلی را ویرایش می‌کند — اندازهٔ اسکرین‌شات، پس‌زمینه و قاب دستگاه آن را تنظیم کنید و از بخش «شکل‌ها» متن، تصویر و شکل اضافه کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä sivupalkki muokkaa aina valittua riviä – määritä sen kuvakaappauksen koko, tausta ja laitekehys ja lisää tekstiä, kuvia ja muotoja Muodot-osiosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette barre latérale modifie toujours la ligne sélectionnée : définissez sa taille de capture d'écran, son arrière-plan et son cadre d'appareil, et ajoutez du texte, des images et des formes depuis la section Formes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa barra laterale modifica sempre la riga selezionata: impostane la dimensione degli screenshot, lo sfondo e la cornice del dispositivo, e aggiungi testo, immagini e forme dalla sezione Forme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサイドバーでは常に選択中の行を編集します。スクリーンショットのサイズ、背景、デバイスフレームを設定し、「図形」セクションからテキスト、画像、図形を追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사이드바는 항상 현재 선택된 행을 편집합니다. 스크린샷 크기, 배경, 기기 프레임을 설정하고 도형 섹션에서 텍스트, 이미지, 도형을 추가하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze zijbalk bewerkt altijd de momenteel geselecteerde rij: stel de schermgrootte, achtergrond en apparaatframe in en voeg tekst, afbeeldingen en vormen toe vanuit de sectie Vormen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne sidelinjen redigerer alltid den valgte raden – angi skjermbildestørrelse, bakgrunn og enhetsramme, og legg til tekst, bilder og former fra Shapes-delen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta barra lateral sempre edita a linha selecionada — defina o tamanho da captura de tela, o plano de fundo e a moldura do dispositivo, e adicione texto, imagens e formas na seção Formas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta barra lateral sempre edita a linha atualmente selecionada – defina o tamanho da captura de ecrã, o plano de fundo e o quadro do dispositivo e adicione texto, imagens e formas da secção Formas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта боковая панель всегда редактирует выбранную строку: задайте размер скриншота, фон и рамку устройства, а также добавляйте текст, изображения и фигуры в разделе «Фигуры»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här sidofältet redigerar alltid den markerade raden – ställ in dess skärmbildsstorlek, bakgrund och enhetsram och lägg till text, bilder och former från avsnittet Former."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kenar çubuğu her zaman seçili satırı düzenler — ekran görüntüsü boyutunu, arka planını ve aygıt çerçevesini ayarlayın; Şekiller bölümünden metin, görüntü ve şekil ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця бічна панель завжди редагує поточний вибраний рядок — задайте розмір знімка екрана, тло й рамку пристрою та додайте текст, зображення й фігури з розділу «Фігури»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此侧边栏始终编辑当前所选的行——设置其截图尺寸、背景和设备边框，并从“形状”部分添加文本、图像和形状。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此側邊欄一律編輯目前所選的列——設定其螢幕截圖大小、背景和裝置外框，並從「形狀」區段加入文字、影像和形狀。"
          }
        }
      }
    },
    "This submits the screenshots already in App Store Connect. If you changed rows since the last upload, upload first. Its screenshots can't change while it's in review." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això envia les captures de pantalla ja a App Store Connect. Si heu canviat les files des de l'última càrrega, penja primer. Les seves captures de pantalla no poden canviar mentre s'està revisant."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette indsender skærmbillederne allerede i App Store Connect. Hvis du har ændret rækker siden sidste upload, skal du uploade først. Dens skærmbilleder kan ikke ændres, mens den er under gennemgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit werden die Screenshots eingereicht, die bereits in App Store Connect sind. Wenn du seit dem letzten Upload Zeilen geändert hast, lade zuerst hoch. Während der Prüfung können die Screenshots nicht geändert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto envía las capturas que ya están en App Store Connect. Si cambiaste filas desde la última subida, súbelas primero. Mientras esté en revisión, sus capturas no pueden cambiar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کار اسکرین‌شات‌هایی را که از قبل در App Store Connect هستند ارسال می‌کند. اگر از آخرین آپلود ردیف‌ها را تغییر داده‌اید، ابتدا آپلود کنید. در طول بررسی، اسکرین‌شات‌های آن قابل تغییر نیستند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä lähettää kuvakaappaukset jo termissä App Store Connect. Jos olet vaihtanut rivejä edellisen latauksen jälkeen, lataa ensin. Sen kuvakaappaukset eivät voi muuttua tarkistuksen aikana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela soumet les captures déjà présentes dans App Store Connect. Si vous avez modifié des lignes depuis le dernier envoi, envoyez-les d'abord. Ses captures ne peuvent pas changer pendant l'examen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione invia gli screenshot già presenti in App Store Connect. Se hai modificato righe dall'ultimo caricamento, carica prima. I suoi screenshot non possono cambiare mentre è in revisione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect にすでにあるスクリーンショットを提出します。前回のアップロード以降に行を変更した場合は、先にアップロードしてください。審査中はスクリーンショットを変更できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect에 이미 있는 스크린샷을 제출합니다. 마지막 업로드 이후 행을 변경했다면 먼저 업로드하세요. 심사 중에는 스크린샷을 변경할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden de schermafbeeldingen al in App Store Connect verzonden. Als je rijen hebt gewijzigd sinds de laatste upload, upload dan eerst. De schermafbeeldingen kunnen niet worden gewijzigd terwijl deze wordt beoordeeld."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sender inn skjermbildene allerede i App Store Connect. Hvis du endret rader siden forrige opplasting, last opp først. Skjermbildene kan ikke endres mens den er under vurdering."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso envia as capturas que já estão no App Store Connect. Se você alterou linhas desde o último envio, envie primeiro. As capturas não podem mudar durante a revisão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso envia as capturas de ecrã já em App Store Connect. Se você alterou as linhas desde o último upload, faça upload primeiro. Suas capturas de ecrã não podem ser alteradas enquanto estiver em revisão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будут отправлены скриншоты, которые уже есть в App Store Connect. Если вы изменили строки после последней загрузки, сначала загрузите их. Пока эксперимент на проверке, его скриншоты изменить нельзя."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta skickar skärmdumparna redan i App Store Connect. Om du ändrade rader sedan den senaste uppladdningen, ladda upp först. Dess skärmdumpar kan inte ändras medan den granskas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem App Store Connect'te zaten bulunan ekran görüntülerini gönderir. Son yüklemeden bu yana satırları değiştirdiyseniz önce yükleyin. İncelemedeyken ekran görüntüleri değiştirilemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Буде надіслано знімки екрана, які вже є в App Store Connect. Якщо ви змінили рядки після останнього вивантаження, спершу вивантажте їх. Поки експеримент на перевірці, його знімки екрана не можна змінити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将提交 App Store Connect 中已有的截图。如果自上次上传后更改过行，请先上传。审核期间无法更改截图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會提交已在 App Store Connect 中的螢幕截圖。如果你在上次上傳後更改過列，請先上傳。審查期間無法更改其螢幕截圖。"
          }
        }
      }
    },
    "This text is too long for its box in this language. Enlarge the box, shorten the text, or turn on Shrink to Fit." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest text és massa llarg per al seu quadre en aquest idioma. Amplieu el quadre, escurceu el text o activeu Redueix per ajustar-lo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne tekst er for lang til sin boks på dette sprog. Forstør boksen, forkort teksten, eller slå Krymp til at passe til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Text ist in dieser Sprache zu lang für sein Feld. Vergrößere das Feld, kürze den Text oder aktiviere „Passend verkleinern“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este texto es demasiado largo para su cuadro en este idioma. Agranda el cuadro, acorta el texto o activa Reducir para ajustar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این متن در این زبان برای کادرش بیش از حد طولانی است. کادر را بزرگ‌تر کنید، متن را کوتاه کنید یا «کوچک‌سازی برای جا شدن» را روشن کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä teksti on liian pitkä laatikkoonsa tällä kielellä. Suurenna laatikkoa, lyhennä tekstiä tai ota käyttöön Shrink to Fit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce texte est trop long pour son cadre dans cette langue. Agrandissez le cadre, raccourcissez le texte ou activez Réduire pour ajuster."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo testo è troppo lungo per il suo riquadro in questa lingua. Ingrandisci il riquadro, accorcia il testo o attiva Riduci per adattare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この言語ではテキストが枠に収まりません。枠を広げるか、テキストを短くするか、「縮小して合わせる」をオンにしてください。"

        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഫോട്ടോകളിൽ നിന്നോ ഫയലുകളിൽ നിന്നോ സ്ക്രീൻഷോട്ടുകൾ ക്യാൻവാസിലേക്ക് വലിച്ചിടുക, അല്ലെങ്കിൽ വരി നിറയ്ക്കാൻ ഒരേസമയം പലതും ഇടുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फोटो किंवा फाइल्समधील स्क्रीनशॉट कॅनव्हासवर ड्रॅग करा किंवा पंक्ती भरण्यासाठी एकाच वेळी अनेक ड्रॉप करा."

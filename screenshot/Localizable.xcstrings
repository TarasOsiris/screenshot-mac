    "Translate text once, lay it out once, ship every language." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tradueix el text una vegada, distribueix-lo una vegada, envia tots els idiomes."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oversæt tekst én gang, læg den én gang, send hvert sprog."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text einmal übersetzen, einmal gestalten, jede Sprache veröffentlichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduce el texto una vez, maquétalo una vez y publica en todos los idiomas."

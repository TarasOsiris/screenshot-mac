    "Other shape properties (position, size, color, image) are shared across all languages. Edit them once and every language picks up the change." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم مشاركة خصائص الشكل الأخرى (الموضع والحجم واللون والصورة) عبر جميع اللغات. قم بتحريرها مرة واحدة وستلتقط كل لغة التغيير."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অন্যান্য আকৃতি বৈশিষ্ট্য (অবস্থান, আকার, রঙ, ছবি) সমস্ত ভাষা জুড়ে ভাগ করা হয়। এগুলি একবার সম্পাদনা করুন এবং প্রতিটি ভাষা পরিবর্তনটি গ্রহণ করে৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altres propietats de forma (posició, mida, color, imatge) es comparteixen en tots els idiomes. Editeu-los una vegada i cada idioma recull el canvi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostatní vlastnosti tvaru (pozice, velikost, barva, obrázek) jsou sdíleny napříč všemi jazyky. Upravte je jednou a každý jazyk převezme změnu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andre formegenskaber (position, størrelse, farve, billede) deles på tværs af alle sprog. Rediger dem én gang, og hvert sprog opfanger ændringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Formeigenschaften (Position, Größe, Farbe, Bild) werden in allen Sprachen gemeinsam genutzt. Bearbeiten Sie sie einmal und jede Sprache übernimmt die Änderung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άλλες ιδιότητες σχήματος (θέση, μέγεθος, χρώμα, εικόνα) είναι κοινές σε όλες τις γλώσσες. Επεξεργαστείτε τα μία φορά και κάθε γλώσσα αντιλαμβάνεται την αλλαγή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otras propiedades de forma (posición, tamaño, color, imagen) se comparten en todos los idiomas. Edítelos una vez y cada idioma recogerá el cambio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سایر ویژگی های شکل (موقعیت، اندازه، رنگ، تصویر) در همه زبان ها به اشتراک گذاشته شده است. آنها را یک بار ویرایش کنید و هر زبان تغییر را دریافت می کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muut muotoominaisuudet (sijainti, koko, väri, kuva) jaetaan kaikilla kielillä. Muokkaa niitä kerran, ja jokainen kieli havaitsee muutoksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autres propriétés de forme (position, taille, couleur, image) sont partagées dans toutes les langues. Modifiez-les une fois et chaque langue reprend le changement."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અન્ય આકાર ગુણધર્મો (સ્થિતિ, કદ, રંગ, છબી) બધી ભાષાઓમાં વહેંચાયેલ છે. તેમને એકવાર સંપાદિત કરો અને દરેક ભાષા ફેરફારને પસંદ કરે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאפייני צורה אחרים (מיקום, גודל, צבע, תמונה) משותפים לכל השפות. ערוך אותם פעם אחת וכל שפה קולטת את השינוי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अन्य आकार गुण (स्थिति, आकार, रंग, छवि) सभी भाषाओं में साझा किए जाते हैं। उन्हें एक बार संपादित करें और हर भाषा में बदलाव आ जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostala svojstva oblika (položaj, veličina, boja, slika) dijele se na svim jezicima. Uredite ih jednom i svaki će jezik prihvatiti promjenu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az egyéb alaktulajdonságok (pozíció, méret, szín, kép) minden nyelven megosztva vannak. Szerkessze őket egyszer, és minden nyelv átveszi a változást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Properti bentuk lainnya (posisi, ukuran, warna, gambar) digunakan di semua bahasa. Edit sekali dan setiap bahasa akan menerima perubahannya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他の形状プロパティ (位置、サイズ、色、画像) はすべての言語で共有されます。一度編集すると、すべての言語に変更が反映されます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇತರ ಆಕಾರ ಗುಣಲಕ್ಷಣಗಳನ್ನು (ಸ್ಥಾನ, ಗಾತ್ರ, ಬಣ್ಣ, ಚಿತ್ರ) ಎಲ್ಲಾ ಭಾಷೆಗಳಲ್ಲಿ ಹಂಚಿಕೊಳ್ಳಲಾಗಿದೆ. ಅವುಗಳನ್ನು ಒಮ್ಮೆ ಸಂಪಾದಿಸಿ ಮತ್ತು ಪ್ರತಿ ಭಾಷೆಯು ಬದಲಾವಣೆಯನ್ನು ಎತ್ತಿಕೊಳ್ಳುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 모양 속성(위치, 크기, 색상, 이미지)은 모든 언어에서 공유됩니다. 한 번 편집하면 모든 언어에 변경 사항이 적용됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "മറ്റ് ആകൃതി പ്രോപ്പർട്ടികൾ (സ്ഥാനം, വലിപ്പം, നിറം, ചിത്രം) എല്ലാ ഭാഷകളിലും പങ്കിടുന്നു. അവ ഒരു പ്രാവശ്യം എഡിറ്റ് ചെയ്‌താൽ ഓരോ ഭാഷയും മാറ്റം എടുക്കുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इतर आकार गुणधर्म (स्थिती, आकार, रंग, प्रतिमा) सर्व भाषांमध्ये सामायिक केले जातात. त्यांना एकदा संपादित करा आणि प्रत्येक भाषा बदल उचलेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sifat bentuk lain (kedudukan, saiz, warna, imej) dikongsi merentas semua bahasa. Editnya sekali dan setiap bahasa menerima perubahan itu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere vormeigenschappen (positie, grootte, kleur, afbeelding) worden door alle talen gedeeld. Bewerk ze één keer en elke taal pikt de verandering op."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andre formegenskaper (posisjon, størrelse, farge, bilde) deles på tvers av alle språk. Rediger dem én gang, og hvert språk fanger opp endringen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inne właściwości kształtu (położenie, rozmiar, kolor, obraz) są wspólne dla wszystkich języków. Edytuj je raz, a każdy język zauważy zmianę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outras propriedades de forma (posição, tamanho, cor, imagem) são compartilhadas em todos os idiomas. Edite-os uma vez e cada idioma receberá a alteração."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outras propriedades de forma (posição, tamanho, cor, imagem) são compartilhadas em todos os idiomas. Edite-os uma vez e cada idioma receberá a alteração."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alte proprietăți de formă (poziție, dimensiune, culoare, imagine) sunt partajate în toate limbile. Editați-le o dată și fiecare limbă preia schimbarea."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostatné vlastnosti tvaru (pozícia, veľkosť, farba, obrázok) sú zdieľané vo všetkých jazykoch. Upravte ich raz a každý jazyk prevezme zmenu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druge lastnosti oblike (položaj, velikost, barva, slika) so v skupni rabi v vseh jezikih. Uredite jih enkrat in vsak jezik pobere spremembo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andra formegenskaper (position, storlek, färg, bild) delas på alla språk. Redigera dem en gång och varje språk tar upp ändringen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பிற வடிவ பண்புகள் (நிலை, அளவு, நிறம், படம்) எல்லா மொழிகளிலும் பகிரப்படுகின்றன. அவற்றை ஒருமுறை திருத்தவும், ஒவ்வொரு மொழியும் மாற்றத்தை எடுக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇతర ఆకార లక్షణాలు (స్థానం, పరిమాణం, రంగు, చిత్రం) అన్ని భాషలలో భాగస్వామ్యం చేయబడతాయి. వాటిని ఒకసారి సవరించండి మరియు ప్రతి భాష మార్పును ఎంచుకుంటుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณสมบัติรูปร่างอื่นๆ (ตำแหน่ง ขนาด สี รูปภาพ) จะถูกแชร์ในทุกภาษา แก้ไขครั้งเดียวและทุกภาษาจะรับการเปลี่ยนแปลง"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دیگر شکل کی خصوصیات (پوزیشن، سائز، رنگ، تصویر) تمام زبانوں میں مشترکہ ہیں۔ ان میں ایک بار ترمیم کریں اور ہر زبان تبدیلی کو اٹھا لے گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các thuộc tính hình dạng khác (vị trí, kích thước, màu sắc, hình ảnh) được chia sẻ trên tất cả các ngôn ngữ. Chỉnh sửa chúng một lần và mọi ngôn ngữ đều nhận thấy sự thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他形状属性（位置、大小、颜色、图像）在所有语言中共享。编辑一次，每种语言都会接受更改。"
          }
        }
      }

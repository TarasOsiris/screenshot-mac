    "Enlarge the text box, shorten the translation, or turn on Shrink to Fit." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amplieu el quadre de text, reduïu la traducció o activeu Redueix per ajustar-lo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forstør tekstfeltet, forkort oversættelsen, eller slå Krymp til at passe til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergrößere das Textfeld, kürze die Übersetzung oder aktiviere „Passend verkleinern“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agranda el cuadro de texto, acorta la traducción o activa Reducir para ajustar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کادر متن را بزرگ‌تر کنید، ترجمه را کوتاه کنید یا «کوچک‌سازی برای جا شدن» را روشن کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suurenna tekstiruutua, lyhennä käännöstä tai ota käyttöön Shrink to Fit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrandissez le cadre de texte, raccourcissez la traduction ou activez Réduire pour ajuster."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingrandisci il riquadro di testo, accorcia la traduzione o attiva Riduci per adattare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキスト枠を広げるか、翻訳を短くするか、「縮小して合わせる」をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 상자를 키우거나 번역을 줄이거나 '맞게 축소'를 켜세요."
          }
        },
        "nl" : {

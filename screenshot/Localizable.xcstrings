    "Render every row in every language as PNG or JPEG, organized into per-language folders — or upload them straight to App Store Connect from here." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra cada fila en tots els idiomes com a PNG o JPEG, organitzades en carpetes per a cada idioma, o pengeu-les directament a App Store Connect des d'aquí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gengiv hver række på hvert sprog som PNG eller JPEG, organiseret i mapper pr. sprog – eller upload dem direkte til App Store Connect herfra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendere jede Zeile in jeder Sprache als PNG oder JPEG, sortiert in Ordner pro Sprache – oder lade sie von hier direkt in App Store Connect hoch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este conjunto no se puede incluir porque los datos App Store requeridos no están disponibles."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این مجموعه نمی تواند گنجانده شود زیرا داده های مورد نیاز App Store در دسترس نیست."
          }
        },
        "fr" : {

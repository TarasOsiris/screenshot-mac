        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Изображение** — добавьте любой файл PNG / JPEG / SVG. Выберите режим заливки и настройте непрозрачность."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

    "Dropping a folder or a group of image files onto a row is the fastest way to fill a screenshot set in order." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ablegen eines Ordners oder einer Gruppe von Bilddateien in einer Zeile ist die schnellste Möglichkeit, einen Screenshot-Satz der Reihe nach aufzufüllen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colocar una carpeta o un grupo de archivos de imagen en una fila es la forma más rápida de completar un conjunto de capturas de pantalla en orden."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انداختن یک پوشه یا گروهی از فایل‌های تصویری در یک ردیف سریع‌ترین راه برای پر کردن یک اسکرین شات به ترتیب است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déposer un dossier ou un groupe de fichiers image sur une ligne est le moyen le plus rapide de remplir un ensemble de captures d'écran dans l'ordre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダーまたは画像ファイルのグループを行にドロップすることは、スクリーンショット セットを順番に埋める最も速い方法です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더나 이미지 파일 그룹을 행에 놓는 것이 스크린샷 세트를 순서대로 채우는 가장 빠른 방법입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soltar uma pasta ou grupo de arquivos de imagem em uma linha é a maneira mais rápida de preencher uma captura de tela em ordem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将一个文件夹或一组图像文件拖放到一行中是按顺序填充屏幕截图集的最快方法。"
          }
        }
      }
    },

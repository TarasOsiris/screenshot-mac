    "Connect a Google Play service account once and Screenshot Bro can upload exported screenshots to your app's store listing without leaving the app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتوصيل حساب خدمة Google Play مرة واحدة وسيتمكن Screenshot Bro من تحميل لقطات الشاشة المُصدَّرة إلى قائمة متجر تطبيقك دون مغادرة التطبيق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একবার একটি Google Play পরিষেবা অ্যাকাউন্ট সংযুক্ত করুন এবং Screenshot Bro অ্যাপটি না রেখেই আপনার অ্যাপের স্টোর তালিকায় রপ্তানি করা স্ক্রিনশট আপলোড করতে পারে৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecteu un compte de servei Google Play una vegada i Screenshot Bro podrà penjar captures de pantalla exportades a la fitxa de la botiga de la vostra aplicació sense sortir de l'aplicació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojte jednou servisní účet Google Play a Screenshot Bro bude moci nahrávat exportované snímky obrazovky do záznamu vaší aplikace v obchodě, aniž byste aplikaci opustili."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilslut en Google Play tjenestekonto én gang, og Screenshot Bro kan uploade eksporterede skærmbilleder til din apps butiksfortegnelse uden at forlade appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde einmalig ein Google Play-Dienstkonto, dann kann Screenshot Bro exportierte Screenshots in den Store-Eintrag deiner App hochladen, ohne dass du die App verlässt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδέστε έναν λογαριασμό υπηρεσίας Google Play μία φορά και ο Screenshot Bro μπορεί να ανεβάσει εξαγόμενα στιγμιότυπα οθόνης στην καταχώριση καταστήματος της εφαρμογής σας χωρίς να αποχωρήσει από την εφαρμογή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta una cuenta de servicio de Google Play una vez y Screenshot Bro podrá subir las capturas exportadas a la ficha de tu app sin salir de ella."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک بار حساب سرویس Google Play را وصل کنید تا Screenshot Bro بتواند بدون خروج از برنامه، اسکرین‌شات‌های صادرشده را در صفحهٔ فروشگاه برنامهٔ شما آپلود کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistä Google Play-palvelutili kerran, niin Screenshot Bro voi ladata vietyjä kuvakaappauksia sovelluksesi tietosivulle poistumatta sovelluksesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez une fois un compte de service Google Play, et Screenshot Bro pourra envoyer les captures d'écran exportées vers la fiche Play Store de votre app sans quitter l'application."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એકવાર એક Google Play સેવા એકાઉન્ટને કનેક્ટ કરો અને Screenshot Bro એપ્લિકેશન છોડ્યા વિના તમારી એપ્લિકેશનના સ્ટોર સૂચિમાં નિકાસ કરેલા સ્ક્રીનશૉટ્સ અપલોડ કરી શકે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חבר חשבון שירות Google Play פעם אחת ו-Screenshot Bro יוכל להעלות צילומי מסך מיוצאים לרשימת האפליקציה שלך בחנות מבלי לצאת מהאפליקציה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play सेवा खाते को एक बार कनेक्ट करें और Screenshot Bro ऐप छोड़े बिना निर्यात किए गए स्क्रीनशॉट को आपके ऐप की स्टोर सूची में अपलोड कर सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povežite Google Play račun usluge jednom i Screenshot Bro može prenijeti izvezene snimke zaslona u unos vaše aplikacije u trgovini bez napuštanja aplikacije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csatlakoztasson egyszer egy Google Play szolgáltatásfiókot, és a Screenshot Bro az alkalmazás elhagyása nélkül tölthet fel exportált képernyőképeket az alkalmazás áruházi adatlapjára."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungkan akun layanan Google Play satu kali dan Screenshot Bro dapat mengunggah tangkapan layar yang diekspor ke cantuman toko aplikasi Anda tanpa keluar dari aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega una volta un account di servizio Google Play e Screenshot Bro potrà caricare gli screenshot esportati nella scheda dello store della tua app senza uscire dall'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play のサービスアカウントを一度接続すれば、Screenshot Bro からアプリを離れずに、書き出したスクリーンショットをアプリのストア掲載情報にアップロードできます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಒಮ್ಮೆ Google Play ಸೇವಾ ಖಾತೆಯನ್ನು ಸಂಪರ್ಕಿಸಿ ಮತ್ತು Screenshot Bro ರಫ್ತು ಮಾಡಿದ ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ಗಳನ್ನು ಅಪ್ಲಿಕೇಶನ್‌ನಿಂದ ಹೊರಹೋಗದೆಯೇ ನಿಮ್ಮ ಅಪ್ಲಿಕೇಶನ್‌ನ ಸ್ಟೋರ್ ಪಟ್ಟಿಗೆ ಅಪ್‌ಲೋಡ್ ಮಾಡಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play 서비스 계정을 한 번 연결해 두면 Screenshot Bro가 앱을 벗어나지 않고 내보낸 스크린샷을 앱의 스토어 등록정보에 업로드할 수 있습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരിക്കൽ ഒരു Google Play സേവന അക്കൗണ്ട് കണക്റ്റുചെയ്യുക, ആപ്പിൽ നിന്ന് പുറത്തുപോകാതെ തന്നെ നിങ്ങളുടെ ആപ്പിൻ്റെ സ്‌റ്റോർ ലിസ്റ്റിംഗിലേക്ക് എക്‌സ്‌പോർട്ട് ചെയ്‌ത സ്‌ക്രീൻഷോട്ടുകൾ അപ്‌ലോഡ് ചെയ്യാൻ Screenshot Bro കഴിയും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एकदा Google Play सेवा खाते कनेक्ट करा आणि Screenshot Bro ॲप न सोडता आपल्या ॲपच्या स्टोअर सूचीमध्ये निर्यात केलेले स्क्रीनशॉट अपलोड करू शकतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambungkan akaun perkhidmatan Google Play sekali dan Screenshot Bro boleh memuat naik tangkapan skrin yang dieksport ke penyenaraian gedung apl anda tanpa meninggalkan apl."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppel één keer een Google Play-serviceaccount en Screenshot Bro kan geëxporteerde schermafbeeldingen uploaden naar de winkelvermelding van uw app zonder de app te verlaten."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koble til en Google Play tjenestekonto én gang, så kan Screenshot Bro laste opp eksporterte skjermbilder til appens butikkoppføring uten å forlate appen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połącz raz konto usługi Google Play, a Screenshot Bro będzie mógł przesyłać wyeksportowane zrzuty ekranu do informacji o Twojej aplikacji bez opuszczania aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte uma conta de serviço do Google Play uma vez e o Screenshot Bro poderá enviar as capturas de tela exportadas para a página do seu app na loja sem sair do aplicativo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte uma conta de serviço Google Play uma vez e Screenshot Bro poderá carregar de capturas de ecrã exportadas para a listagem da loja do seu aplicativo sem sair do aplicativo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectați un cont de serviciu Google Play o dată și Screenshot Bro poate încărca capturi de ecran exportate în înregistrarea din magazin a aplicației dvs. fără a părăsi aplicația."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите сервисный аккаунт Google Play один раз, и Screenshot Bro сможет загружать экспортированные скриншоты на страницу вашего приложения в магазине, не выходя из приложения."
          }
        },
        "sk" : {
          "stringUnit" : {

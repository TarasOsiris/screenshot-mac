        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos quadros abstratos do Android, um botão **Câmera** mostra ou oculta o recorte da câmera."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pe cadrele Android abstracte, un comutator **Cameră** arată sau ascunde decupajul camerei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На абстрактных рамках Android переключатель **Камера** показывает или скрывает вырез камеры."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",

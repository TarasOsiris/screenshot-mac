        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat이 테스트 스토어 API 키로 구성되어 있습니다. 출시하기 전에 Apple 공개 SDK 키로 교체하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat ഒരു ടെസ്റ്റ് സ്റ്റോർ API കീ ഉപയോഗിച്ച് കോൺഫിഗർ ചെയ്‌തിരിക്കുന്നു. ഷിപ്പിംഗിന് മുമ്പ് നിങ്ങളുടെ Apple പബ്ലിക് SDK കീ ഉപയോഗിച്ച് അത് മാറ്റിസ്ഥാപിക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {

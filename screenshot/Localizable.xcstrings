    "The Projects screen shows sync progress while iCloud is uploading or downloading." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla Projectes mostra el progrés de la sincronització mentre iCloud s'està carregant o baixant."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projektskærmen viser synkroniseringsfremskridt, mens iCloud uploader eller downloader."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bildschirm „Projekte“ zeigt den Synchronisierungsfortschritt an, während iCloud hoch- oder herunterlädt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla Proyectos muestra el progreso de la sincronización mientras iCloud sube o descarga archivos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی iCloud در حال آپلود یا دانلود است، صفحهٔ پروژه‌ها پیشرفت همگام‌سازی را نشان می‌دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projektit-näyttö näyttää synkronoinnin edistymisen, kun iCloud lataa tai lataa."

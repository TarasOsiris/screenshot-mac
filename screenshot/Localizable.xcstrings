    "SVGs are sanitized — script and event handlers are stripped before rendering." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تحسين SVG — تتم إزالة معالجات البرامج النصية والأحداث قبل العرض."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs estan desinfectats: els gestors d'scripts i d'esdeveniments s'eliminen abans de representar-los."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs jsou dezinfikovány – skripty a obslužné rutiny událostí jsou před vykreslením odstraněny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs er renset – script- og hændelseshandlere fjernes før gengivelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs werden bereinigt – Skripte und Event-Handler werden vor dem Rendern entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα SVGαπολυμαίνονται — οι χειριστές σεναρίων και συμβάντων απογυμνώνονται πριν από την απόδοση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los SVG se limpian: los scripts y los controladores de eventos se eliminan antes de renderizarlos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGها پاکسازی می‌شوند - اسکریپت‌ها و کنترل‌کننده‌های رویداد قبل از رندر کردن حذف می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs on puhdistettu – komentosarjat ja tapahtumakäsittelijät poistetaan ennen renderöimistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les SVG sont nettoyés : les scripts et gestionnaires d'événements sont supprimés avant le rendu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGים עוברים חיטוי - מטפלים בסקריפט ואירועים מופשטים לפני העיבוד."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs su sanirani — skripta i rukovatelji događajima uklanjaju se prije iscrtavanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A SVGek megtisztításra kerülnek – a szkript- és eseménykezelők törlődnek a megjelenítés előtt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG telah dibersihkan — skrip dan pengendali kejadian dihapus sebelum dirender."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli SVG vengono ripuliti: script e gestori di eventi vengono rimossi prima del rendering."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG は無害化されます。スクリプトやイベントハンドラはレンダリング前に取り除かれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG는 안전하게 정리됩니다. 렌더링 전에 스크립트와 이벤트 핸들러가 제거됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs telah dibersihkan — skrip dan pengendali acara dilucutkan sebelum dipaparkan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs worden opgeschoond: script- en gebeurtenishandlers worden verwijderd voordat ze worden weergegeven."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs er renset – skript- og hendelsesbehandlere fjernes før gjengivelse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs są czyszczone — skrypty i procedury obsługi zdarzeń są usuwane przed renderowaniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs são higienizados – scripts e manipuladores de eventos são removidos antes da renderização."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs são higienizados – scripts e manipuladores de eventos são removidos antes da renderização."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG-urile sunt dezinfectate — scripturile și gestionarea evenimentelor sunt eliminate înainte de randare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG очищаются — скрипты и обработчики событий удаляются перед отрисовкой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGsú dezinfikované – skripty a obslužné nástroje udalostí sú pred vykreslením odstránené."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG so razčiščeni — skript in obdelovalci dogodkov so odstranjeni pred upodabljanjem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs är sanerade – skript- och händelsehanterare tas bort innan de renderas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG ถูกสุขอนามัย — สคริปต์และตัวจัดการเหตุการณ์จะถูกถอดออกก่อนที่จะเรนเดอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG'ler temizlenir — oluşturmadan önce betikler ve olay işleyicileri kaldırılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG очищуються — скрипти й обробники подій вилучаються перед рендерингом."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG کو صاف کیا جاتا ہے — رینڈرنگ سے پہلے اسکرپٹ اور ایونٹ ہینڈلرز کو ہٹا دیا جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG đã được dọn dẹp — các trình xử lý tập lệnh và sự kiện sẽ bị loại bỏ trước khi hiển thị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG 会经过清理——渲染前会移除脚本和事件处理程序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG 會經過清理——轉譯前會移除指令碼和事件處理常式。"
          }
        }
      }
    },
    "SVGs render with a configurable color override and scale crisply at any export resolution." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم عرض SVG مع تجاوز اللون القابل للتكوين والقياس بشكل واضح بأي دقة تصدير."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs renderitza amb una substitució de color configurable i una escala nítida amb qualsevol resolució d'exportació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG se vykresluje s konfigurovatelným přepsáním barev a ostře měřítko při jakémkoli rozlišení exportu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs gengives med en konfigurerbar farvetilsidesættelse og skalerer skarpt ved enhver eksportopløsning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs lassen sich mit einer eigenen Farbe darstellen und bleiben bei jeder Exportauflösung scharf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η απόδοση του SVG με παράκαμψη χρώματος με δυνατότητα διαμόρφωσης και ευκρινή κλίμακα σε οποιαδήποτε ανάλυση εξαγωγής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los SVG se renderizan con un color personalizado opcional y escalan con nitidez a cualquier resolución de exportación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGها با امکان تعیین رنگ دلخواه رندر می‌شوند و در هر وضوح خروجی واضح می‌مانند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG renderöi konfiguroitavan värin ohituksen ja skaalaa terävästi millä tahansa vientitarkkuudella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les SVG sont rendus avec une couleur de remplacement configurable et restent nets à toutes les résolutions d'exportation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עיבוד SVG עם שינוי צבע שניתן להגדרה וקנה מידה חד בכל רזולוציית ייצוא."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs renderiranje s podesivim nadjačavanjem boja i oštrim skaliranjem u bilo kojoj razlučivosti izvoza."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A SVG konfigurálható színfelülbírálással és élesen skálázható rendereléssel bármilyen exportálási felbontás mellett."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG dirender dengan penggantian warna yang dapat dikonfigurasi dan diskalakan dengan tajam pada resolusi ekspor apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli SVG vengono resi con un colore sostitutivo configurabile e restano nitidi a qualsiasi risoluzione di esportazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG は色を上書き設定してレンダリングでき、どの書き出し解像度でも鮮明に拡大/縮小されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG는 색상 재정의를 설정해 렌더링할 수 있으며, 어떤 내보내기 해상도에서도 선명하게 확대됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paparan SVG dengan penggantian warna yang boleh dikonfigurasikan dan skala dengan jelas pada sebarang resolusi eksport."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs worden weergegeven met een configureerbare kleuroverschrijving en scherp geschaald bij elke exportresolutie."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs gjengis med en konfigurerbar fargeoverstyring og skaleres skarpt til enhver eksportoppløsning."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGrenderuje z konfigurowalnym nadpisywaniem kolorów i wyraźnym skalowaniem w dowolnej rozdzielczości eksportu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs são renderizados com uma substituição de cores configurável e dimensionados de forma nítida em qualquer resolução de exportação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs são renderizados com uma substituição de cores configurável e dimensionados de forma nítida em qualquer resolução de exportação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG-urile se redau cu o modificare configurabilă a culorilor și o scalare clară la orice rezoluție de export."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG отрисовываются с настраиваемой заменой цвета и остаются четкими при любом разрешении экспорта."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG sa vykresľuje s konfigurovateľným prepísaním farieb a ostrou mierkou pri akomkoľvek rozlíšení exportu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs upodablja z nastavljivo barvno preglasitvijo in jasnim merilom pri kateri koli izvozni ločljivosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs återges med en konfigurerbar färgöverstyrning och skala skarpt vid vilken exportupplösning som helst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGแสดงผลด้วยการแทนที่สีที่กำหนดค่าได้และปรับขนาดได้คมชัดตามความละเอียดในการส่งออก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG'ler yapılandırılabilir bir renk geçersiz kılmasıyla oluşturulur ve her dışa aktarma çözünürlüğünde keskin şekilde ölçeklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG рендеряться з налаштовуваним перевизначенням кольору й чітко масштабуються до будь-якої роздільності експорту."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG کسی بھی برآمدی ریزولوشن پر قابل ترتیب رنگ اوور رائیڈ کے ساتھ رینڈر اور کرکرا پیمانے پر۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG kết xuất với tính năng ghi đè màu có thể định cấu hình và chia tỷ lệ rõ ràng ở bất kỳ độ phân giải xuất nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG 渲染时可设置颜色覆盖，并在任何导出分辨率下都能清晰缩放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG 會以可設定的覆寫顏色轉譯，並在任何輸出解析度下都能清晰縮放。"
          }
        }
      }
    },

    "Use an App Store Connect API key with access to edit app metadata. Account Holder, Admin, or App Manager roles are typical for screenshot uploads." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitzeu una clau App Store Connect API amb accés per editar les metadades de l'aplicació. Les funcions de titular del compte, d'administrador o de gestor d'aplicacions són habituals per a les càrregues de captures de pantalla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug en App Store Connect API-nøgle med adgang til at redigere app-metadata. Roller som kontoindehaver, administrator eller appadministrator er typiske for uploads af skærmbilleder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende einen App Store Connect-API-Schlüssel mit Berechtigung zum Bearbeiten von App-Metadaten. Für Screenshot-Uploads sind die Rollen „Kontoinhaber“, „Administrator“ oder „App-Manager“ üblich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa una clave de API de App Store Connect con permisos para editar los metadatos de la app. Los roles Account Holder, Admin o App Manager suelen ser suficientes para subir capturas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از کلید API در App Store Connect استفاده کنید که اجازهٔ ویرایش فرادادهٔ برنامه را دارد. نقش‌های Account Holder، Admin یا App Manager معمولاً برای آپلود اسکرین‌شات مناسب‌اند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä App Store Connect API-näppäintä, jotta voit muokata sovelluksen metatietoja. Tilinhaltijan, järjestelmänvalvojan tai sovelluspäällikön roolit ovat tyypillisiä kuvakaappausten latauksille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez une clé API App Store Connect autorisée à modifier les métadonnées de l'app. Les rôles Titulaire du compte, Admin ou Gestionnaire d'apps sont habituels pour l'envoi de captures d'écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa una chiave API di App Store Connect con accesso alla modifica dei metadati dell'app. Per il caricamento degli screenshot si usano di solito i ruoli Titolare dell'account, Amministratore o Gestore app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのメタデータを編集する権限がある App Store Connect API キーを使用してください。スクリーンショットのアップロードには通常、「アカウント保持者」「管理」「App マネージャ」のいずれかの役割を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 메타데이터를 편집할 수 있는 권한이 있는 App Store Connect API 키를 사용하세요. 스크린샷 업로드에는 보통 계정 소유자, 관리자 또는 앱 관리자 역할을 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik een App Store Connect API-sleutel met toegang om app-metadata te bewerken. De rollen Accounthouder, Beheerder of App-manager zijn typisch voor screenshot-uploads."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk en App Store Connect API-nøkkel med tilgang til å redigere app-metadata. Kontoinnehaver, administrator eller appadministratorroller er typiske for opplasting av skjermbilder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use uma chave de API do App Store Connect com acesso para editar os metadados do app. As funções Titular da Conta, Administrador ou Gerente de Apps são as mais comuns para enviar capturas de tela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use uma chave App Store Connect API com acesso para editar metadados do aplicativo. As funções de titular de conta, administrador ou gerente de aplicativos são típicas para uploads de capturas de ecrã."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте ключ App Store Connect API с доступом к редактированию метаданных приложения. Для загрузки скриншотов обычно подходят роли Account Holder, Admin или App Manager."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd en App Store Connect API-nyckel med åtkomst för att redigera appmetadata. Roller som kontoinnehavare, administratör eller apphanterare är typiska för uppladdningar av skärmdumpar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama meta verilerini düzenleme erişimine sahip bir App Store Connect API anahtarı kullanın. Ekran görüntüsü yüklemeleri için genellikle Hesap Sahibi, Yönetici veya Uygulama Yöneticisi rolleri kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте ключ API App Store Connect із доступом до редагування метаданих програми. Для вивантаження знімків екрана зазвичай підходять ролі Account Holder, Admin або App Manager."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用有权编辑 App 元数据的 App Store Connect API 密钥。上传截图通常使用“账户持有人”、“管理”或“App 管理”角色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請使用具有編輯 App 後設資料權限的 App Store Connect API 密鑰。上傳螢幕截圖通常使用「帳號持有人」、「管理」或「App 管理」角色。"
          }
        }
      }
    },
    "Use Copy Row to Variant on the Original's row to test it too." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitzeu Copia fila a variant a la fila de l'original per provar-ho també."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug Kopier række til variant på originalens række for også at teste den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende „Zeile in Variante kopieren“ für die Zeile des Originals, um sie ebenfalls zu testen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Copiar fila en variante en la fila del Original para probarla también."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای آزمایش آن هم، از «کپی ردیف به نسخه» روی ردیف اصلی استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä myös alkuperäisen rivin Kopioi rivi vaihtoehtoon -toimintoa testataksesi sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Copier la ligne dans une variante sur la ligne de l’Original pour la tester aussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Copia riga nella variante sulla riga dell'Originale per testare anche quella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それもテストするには、オリジナルの行で「行をバリアントにコピー」を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그것도 테스트하려면 원본 행에서 변형으로 행 복사를 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik Rij naar variant kopiëren op de rij van het origineel om dit ook te testen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk Kopier rad til variant på originalens rad for å teste den også."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Copiar linha para variante na linha do Original para testá-la também."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Copiar linha para variante na linha do original para testá-la também."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте «Скопировать строку в вариант» для строки оригинала, чтобы протестировать и ее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd Kopiera rad till variant på originalets rad för att testa det också."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onu da test etmek için Orijinal'in satırında Satırı Varyanta Kopyala'yı kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скористайтеся «Скопіювати рядок у варіант» для рядка оригіналу, щоб протестувати й його."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要一并测试，请对原始版本的行使用“将行复制到变体”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「原始版本」的列上使用「將列拷貝到變體」，即可一併測試。"
          }

          "stringUnit" : {
            "state" : "translated",
            "value" : "Napsauta kuvaa ominaisuuspalkissa valitaksesi tiedoston tai vedä ja pudota suoraan muotoon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur le cadre d'image dans la barre de propriétés pour sélectionner un fichier, ou faites un glisser-déposer directement sur la forme."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחץ על התמונה היטב בסרגל המאפיינים כדי לבחור קובץ, או גרור ושחרר ישירות על הצורה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobro kliknite sliku na traci svojstava da biste odabrali datoteku ili je povucite i ispustite izravno na oblik."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kattintson a képre a tulajdonságsávban egy fájl kiválasztásához, vagy húzza közvetlenül az alakzatra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik gambar di bilah properti untuk memilih file, atau seret dan lepas langsung ke bentuk."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロパティ バーのイメージ ウェルをクリックしてファイルを選択するか、図形に直接ドラッグ アンド ドロップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "속성 표시줄에서 이미지 영역을 클릭하여 파일을 선택하거나 모양에 직접 끌어서 놓습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik imej dengan baik dalam bar sifat untuk memilih fail, atau seret dan lepas terus ke bentuk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik op het afbeeldingsvak in de eigenschappenbalk om een bestand te kiezen, of sleep het rechtstreeks naar de vorm."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikk på bildet i egenskapslinjen for å velge en fil, eller dra og slipp direkte på figuren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij obraz na pasku właściwości, aby wybrać plik, lub przeciągnij i upuść bezpośrednio na kształt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique na imagem na barra de propriedades para escolher um arquivo ou arraste e solte diretamente na forma."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique na imagem na barra de propriedades para escolher um ficheiro ou arraste e solte diretamente na forma."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faceți clic bine pe imagine din bara de proprietăți pentru a alege un fișier sau trageți și plasați direct pe formă."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknutím na obrázok na paneli vlastností vyberte súbor alebo presuňte myšou priamo na tvar."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobro kliknite sliko v vrstici z lastnostmi, da izberete datoteko, ali pa jo povlecite in spustite neposredno na obliko."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicka på bildens brunn i egenskapsfältet för att välja en fil, eller dra och släpp direkt på formen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คลิกที่รูปภาพในแถบคุณสมบัติเพื่อเลือกไฟล์ หรือลากและวางลงบนรูปร่างโดยตรง"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فائل لینے کے لیے پراپرٹیز بار میں امیج پر اچھی طرح کلک کریں، یا گھسیٹ کر براہ راست شکل پر چھوڑیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bấm vào ô hình ảnh trong thanh thuộc tính để chọn tệp hoặc kéo và thả trực tiếp vào hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单击属性栏中的图像以选择文件，或直接拖放到形状上。"
          }
        }
      }

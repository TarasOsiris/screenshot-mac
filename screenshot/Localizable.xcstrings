        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک بار رجسٹر ہونے کے بعد فونٹس ٹیکسٹ شیپ فونٹ چننے والے میں ظاہر ہوتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phông chữ xuất hiện trong bộ chọn phông chữ hình dạng văn bản sau khi đăng ký."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

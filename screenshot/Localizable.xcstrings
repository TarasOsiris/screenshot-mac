          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Sincronização do iCloud** — a opção **Sincronizar com o iCloud**, ativada ou desativada, e o status atual da sincronização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Синхронизация iCloud** — переключатель **Синхронизировать с iCloud** и текущее состояние синхронизации."

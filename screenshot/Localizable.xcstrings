        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این برنامه دیگر با پروژه مطابقت ندارد: ردیف‌ها یا زبان‌های آن حذف شده‌اند. به برنامه برگردید و دوباره تلاش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä suunnitelma ei enää vastaa projektia: sen rivit tai kielet poistettiin. Palaa suunnitelmaan ja yritä uudelleen."

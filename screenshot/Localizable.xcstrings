          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌘]** / **⌘[** で言語を順方向 / 逆方向に切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",

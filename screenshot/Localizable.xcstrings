    "%lld current screenshots have no App Store checksum, so they will be replaced instead of preserved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld لقطات الشاشة الحالية لا تحتوي على المجموع الاختباري App Store، لذلك سيتم استبدالها بدلاً من الاحتفاظ بها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures de pantalla actuals de %1$lld no tenen App Store suma de comprovació, de manera que es substituiran en lloc de conservar-se."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld aktuální snímky obrazovky nemají kontrolní součet App Store, takže budou nahrazeny namísto zachování."

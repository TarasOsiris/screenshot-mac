    "Export all screenshots at once as PNG or JPEG, ready to upload to App Store Connect or Google Play." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتصدير جميع لقطات الشاشة مرة واحدة كـ PNG أو JPEG، جاهزة للتحميل إلى App Store Connect أو Google Play."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সমস্ত স্ক্রিনশট একবারে PNG বা JPEG হিসাবে রপ্তানি করুন, App Store Connect বা Google Play এ আপলোড করার জন্য প্রস্তুত৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta totes les captures de pantalla alhora com a PNG o JPEG, a punt per penjar-les a App Store Connect o Google Play."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",

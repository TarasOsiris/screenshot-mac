    "During resize, rendering is debounced for performance — release the mouse to see the final crisp output." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أثناء تغيير الحجم، يتم إلغاء العرض مقابل الأداء — حرر الماوس لرؤية الإخراج النهائي الواضح."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durant el canvi de mida, la renderització es rebota per al rendiment; deixeu anar el ratolí per veure la sortida nítida final."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Během změny velikosti se vykreslování snižuje kvůli výkonu – uvolněte myš a uvidíte konečný ostrý výstup."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under ændring af størrelse afvises gengivelsen for ydeevne - slip musen for at se det endelige skarpe output."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während der Größenänderung wird das Rendern aus Leistungsgründen verzögert – lass die Maustaste los, um das endgültige, scharfe Ergebnis zu sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατά τη διάρκεια της αλλαγής μεγέθους, η απόδοση απενεργοποιείται για απόδοση — αφήστε το ποντίκι για να δείτε την τελική ευκρινή έξοδο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras redimensionas, el renderizado se pausa para mejorar el rendimiento: suelta el ratón para ver el resultado final nítido."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام تغییر اندازه، برای کارایی بهتر رندر با تأخیر انجام می‌شود — دکمهٔ ماوس را رها کنید تا نتیجهٔ نهایی و واضح را ببینید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kokoa muutettaessa renderöinti heikkenee suorituskyvyn vuoksi – vapauta hiiri nähdäksesi lopullisen terävän tulosteen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant le redimensionnement, le rendu est différé pour préserver les performances : relâchez la souris pour voir le résultat final net."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "במהלך שינוי הגודל, הרינדור מופחת לצורך ביצועים - שחרר את העכבר כדי לראות את הפלט החד הסופי."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijekom promjene veličine, renderiranje se odbija zbog performansi — otpustite miš kako biste vidjeli konačni jasan rezultat."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az átméretezés során a renderelés visszaáll a teljesítmény érdekében – engedje el az egeret, hogy lássa a végső éles kimenetet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selama pengubahan ukuran, rendering dihilangkan demi performa — lepaskan mouse untuk melihat hasil akhir yang tajam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante il ridimensionamento, il rendering viene differito per migliorare le prestazioni: rilascia il mouse per vedere il risultato finale nitido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイズ変更中はパフォーマンスのためにレンダリングが間引かれます。マウスボタンを放すと、最終的な鮮明な表示になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크기를 조정하는 동안에는 성능을 위해 렌더링을 잠시 미룹니다. 마우스를 놓으면 최종 선명한 결과가 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semasa mengubah saiz, pemaparan dinyahpantulkan untuk prestasi — lepaskan tetikus untuk melihat keluaran tajam terakhir."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdens het wijzigen van het formaat wordt de weergave gedebounced vanwege de prestaties. Laat de muis los om de uiteindelijke scherpe uitvoer te zien."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under endring av størrelse reduseres gjengivelsen for ytelse – slipp musen for å se den endelige skarpe utgangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas zmiany rozmiaru renderowanie jest zakłócane ze względu na wydajność — zwolnij przycisk myszy, aby zobaczyć ostateczny, ostry obraz wyjściowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante o redimensionamento, a renderização é adiada por desempenho — solte o mouse para ver o resultado final nítido."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante o redimensionamento, a renderização é prejudicada pelo desempenho – solte o rato para ver a saída final nítida."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În timpul redimensionării, redarea este anulată pentru performanță - eliberați mouse-ul pentru a vedea rezultatul final clar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При изменении размера отрисовка откладывается ради производительности — отпустите кнопку мыши, чтобы увидеть итоговый четкий результат."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počas zmeny veľkosti sa vykresľovanie znižuje kvôli výkonu – uvoľnite myš, aby ste videli konečný ostrý výstup."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med spreminjanjem velikosti se upodabljanje zmanjša zaradi učinkovitosti – spustite miško, da vidite končni jasen izpis."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under storleksändring avvisas renderingen för prestanda – släpp musen för att se den slutliga skarpa utmatningen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในระหว่างการปรับขนาด การเรนเดอร์จะถูกลดประสิทธิภาพลง — ปล่อยเมาส์เพื่อดูผลลัพธ์ที่คมชัดในขั้นสุดท้าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden boyutlandırma sırasında performans için oluşturma geciktirilir — son keskin çıktıyı görmek için fareyi bırakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час зміни розміру рендеринг відкладається заради швидкодії — відпустіть кнопку миші, щоб побачити остаточний чіткий результат."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سائز تبدیل کرنے کے دوران، کارکردگی کے لیے رینڈرنگ کو ڈیباؤنس کیا جاتا ہے - حتمی کرکرا آؤٹ پٹ دیکھنے کے لیے ماؤس کو چھوڑیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong quá trình thay đổi kích thước, kết xuất bị loại bỏ để đạt được hiệu suất - hãy thả chuột để xem kết quả đầu ra sắc nét cuối cùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整大小时，为了性能会延迟渲染——松开鼠标即可看到最终的清晰效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調整大小時，為了效能會延遲轉譯——放開滑鼠即可看到最終的清晰結果。"
          }
        }
      }
    },

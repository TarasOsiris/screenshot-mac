          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold **⌥** mens du drar for å duplisere formen mens du beveger deg."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha **⌥** pressionada ao arrastar para duplicar a forma enquanto a move."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure **⌥** enquanto arrasta para duplicar a forma conforme você se move."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте **⌥** при перетаскивании, чтобы дублировать фигуру во время перемещения."
          }
        },
        "sv" : {
          "stringUnit" : {

    "**Ask before deleting rows and screenshots** — show a confirmation prompt for destructive row and screenshot actions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Fragen Sie nach, bevor Sie Zeilen und Screenshots löschen** – zeigt eine Bestätigungsaufforderung für destruktive Zeilen- und Screenshot-Aktionen an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Pregunte antes de eliminar filas y capturas de pantalla**: muestra un mensaje de confirmación para acciones destructivas de filas y capturas de pantalla."

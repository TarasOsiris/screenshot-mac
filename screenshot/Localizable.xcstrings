    "App Store visitors in the test start seeing the treatments now. A running experiment can only be stopped in App Store Connect." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store يبدأ زوار الاختبار في رؤية العلاجات الآن. لا يمكن إيقاف التجربة الجارية إلا في App Store Connect."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store visitants de la prova comencen a veure els tractaments ara. Un experiment en curs només es pot aturar d'aquí a App Store Connect."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store návštěvníkům v testu se léčba začíná zobrazovat hned. Probíhající experiment lze zastavit pouze v App Store Connect."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store besøgende i testen begynder at se behandlingerne nu. Et kørende eksperiment kan kun stoppes i App Store Connect."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besucher des App Store im Test sehen die Treatments ab sofort. Ein laufendes Experiment kann nur in App Store Connect beendet werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store επισκέπτες στη δοκιμή αρχίζουν να βλέπουν τις θεραπείες τώρα. Ένα πείραμα που εκτελείται μπορεί να διακοπεί μόνο σε App Store Connect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los visitantes del App Store incluidos en la prueba empezarán a ver los tratamientos ahora. Un experimento en curso solo se puede detener en App Store Connect."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بازدیدکنندگان App Store که در آزمایش هستند از همین حالا نسخه‌های آزمایشی را می‌بینند. آزمایش در حال اجرا فقط در App Store Connect متوقف می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store testin kävijää alkavat nähdä hoidot nyt. Käynnissä oleva kokeilu voidaan pysäyttää vain App Store Connect."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les visiteurs de l’App Store inclus dans le test voient désormais les traitements. Une expérience en cours ne peut être arrêtée que dans App Store Connect."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store מבקרים בבדיקה מתחילים לראות את הטיפולים עכשיו. ניתן לעצור ניסוי פועל רק ב-App Store Connect."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store posjetitelji u testu sada počinju vidjeti tretmane. Eksperiment koji je u tijeku može se zaustaviti samo u App Store Connect."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store a tesztben részt vevő látogatók most kezdik látni a kezeléseket. Egy futó kísérlet csak a következőben állítható le: App Store Connect."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store pengunjung yang mengikuti tes mulai melihat perawatannya sekarang. Eksperimen yang berjalan hanya dapat dihentikan dalam App Store Connect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I visitatori dell'App Store inclusi nel test iniziano a vedere i trattamenti da ora. Un esperimento in corso può essere interrotto solo in App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テスト対象の App Store 訪問者に、今からトリートメントが表示されます。実行中の実験は App Store Connect でのみ停止できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "테스트에 포함된 App Store 방문자에게 지금부터 트리트먼트가 표시됩니다. 실행 중인 실험은 App Store Connect에서만 중지할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store pelawat dalam ujian mula melihat rawatan sekarang. Percubaan yang sedang berjalan hanya boleh dihentikan dalam App Store Connect."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store bezoekers in de test zien nu de behandelingen. Een lopend experiment kan alleen worden gestopt over App Store Connect."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store besøkende i testen begynner å se behandlingene nå. Et løpende eksperiment kan bare stoppes i App Store Connect."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store odwiedzający biorący udział w teście zaczynają już widzieć zabiegi. Trwający eksperyment można zatrzymać dopiero w App Store Connect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os visitantes da App Store no teste começam a ver os tratamentos agora. Um experimento em andamento só pode ser interrompido no App Store Connect."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store visitantes do teste começam a ver os tratamentos agora. Uma experiência em execução só pode ser interrompida em App Store Connect."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store vizitatori din test încep să vadă tratamentele acum. Un experiment care rulează poate fi oprit numai în App Store Connect."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посетители App Store, участвующие в тесте, начинают видеть тестовые варианты прямо сейчас. Запущенный эксперимент можно остановить только в App Store Connect."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store návštevníkom v teste sa liečba začína zobrazovať hneď. Spustený experiment možno zastaviť iba v App Store Connect."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store obiskovalci v preizkusu začnejo zdaj videti zdravljenja. Preizkus v teku je mogoče ustaviti samo v App Store Connect."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store besökare i testet börjar se behandlingarna nu. Ett pågående experiment kan bara stoppas om App Store Connect."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผู้เข้าชม App Store ในการทดสอบเริ่มเห็นการรักษาแล้ว การทดสอบที่ทำงานอยู่สามารถหยุดได้ใน App Store Connect เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testteki App Store ziyaretçileri alternatif sayfaları artık görmeye başlar. Çalışan bir deney yalnızca App Store Connect'te durdurulabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відвідувачі App Store, які беруть участь у тесті, відтепер бачать тестові варіанти. Зупинити запущений експеримент можна лише в App Store Connect."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ٹیسٹ میں آنے والے App Store اب علاج دیکھنا شروع کر دیتے ہیں۔ چلنے والے تجربے کو صرف App Store Connect میں روکا جا سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store khách truy cập thử nghiệm bắt đầu xem các phương pháp điều trị ngay bây giờ. Chỉ có thể dừng thử nghiệm đang chạy trong App Store Connect."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "参与测试的 App Store 访客现在将开始看到实验组。正在运行的实验只能在 App Store Connect 中停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "參與測試的 App Store 訪客現在會開始看到處理組。正在執行的實驗只能在 App Store Connect 中停止。"
          }
        }
      }
    },

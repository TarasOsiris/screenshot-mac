        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angi bakgrunner, farger og gradienter, og finjuster hvert element for å matche merket ditt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw tła, kolory i gradienty oraz dostosuj każdy element, aby pasował do Twojej marki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina planos de fundo, cores e gradientes e ajuste cada elemento para combinar com sua marca."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina planos de fundo, cores e gradientes e ajuste cada elemento para combinar com sua marca."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setați fundaluri, culori și degrade și ajustați fiecare element pentru a se potrivi cu marca dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настраивайте фоны, цвета и градиенты и подгоняйте каждый элемент под свой бренд."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavte pozadie, farby a prechody a dolaďte každý prvok tak, aby zodpovedal vašej značke."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavite ozadja, barve in prelive ter natančno prilagodite vsak element, da bo ustrezal vaši blagovni znamki."

        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα ονόματα αρχείων έχουν μηδενική συμπλήρωση (`01_…`, `02_…`), ώστε να ταξινομούνται σωστά κατά τη μεταφόρτωση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

    "Go unlimited and create as many screenshots as your apps need." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتقل إلى عدد غير محدود وقم بإنشاء العديد من لقطات الشاشة التي تحتاجها تطبيقاتك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aneu sense límits i creeu tantes captures de pantalla com necessitin les vostres aplicacions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jděte neomezeně a vytvořte tolik snímků obrazovky, kolik vaše aplikace potřebují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå ubegrænset og lav så mange skærmbilleder, som dine apps har brug for."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Limits: Erstelle so viele Screenshots, wie deine Apps brauchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πηγαίνετε απεριόριστα και δημιουργήστε όσα στιγμιότυπα οθόνης χρειάζονται οι εφαρμογές σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin límites: crea todas las capturas que necesiten tus apps."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نامحدود شوید و هر تعداد اسکرین‌شات که برنامه‌هایتان لازم دارند بسازید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä rajattomasti ja luo niin monta kuvakaappausta kuin sovelluksesi tarvitsevat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez à l'illimité et créez autant de captures d'écran que vos apps en ont besoin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עבור ללא הגבלה וצור צילומי מסך רבים ככל שהאפליקציות שלך זקוקות."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idite neograničeno i izradite onoliko snimaka zaslona koliko je vašim aplikacijama potrebno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lépjen korlátlanul, és készítsen annyi képernyőképet, amennyire az alkalmazásoknak szüksége van."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lakukan tanpa batas dan buat tangkapan layar sebanyak yang dibutuhkan aplikasi Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa all'illimitato e crea tutti gli screenshot di cui le tue app hanno bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無制限プランで、アプリに必要なだけスクリーンショットを作成しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무제한으로 앱에 필요한 만큼 스크린샷을 생성하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergi tanpa had dan buat seberapa banyak tangkapan skrin yang diperlukan oleh apl anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga onbeperkt en maak zoveel screenshots als je apps nodig hebben."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå ubegrenset og lag så mange skjermbilder som appene dine trenger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korzystaj z nieograniczonej liczby i twórz tyle zrzutów ekranu, ile potrzebują Twoje aplikacje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libere tudo e crie quantas capturas de tela seus apps precisarem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vá ilimitado e crie quantas capturas de ecrã seus aplicativos precisarem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesați nelimitat și creați câte capturi de ecran au nevoie de aplicații."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимите ограничения и создавайте столько скриншотов, сколько нужно вашим приложениям."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choďte neobmedzene a vytvorte toľko snímok obrazovky, koľko vaše aplikácie potrebujú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pojdite neomejeno in ustvarite toliko posnetkov zaslona, kot jih potrebujejo vaše aplikacije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå obegränsat och skapa så många skärmdumpar som dina appar behöver."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้งานได้ไม่จำกัดและสร้างภาพหน้าจอได้มากเท่าที่แอปของคุณต้องการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sınırsız kullanın ve uygulamalarınızın ihtiyaç duyduğu kadar ekran görüntüsü oluşturun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зніміть обмеження й створюйте стільки знімків екрана, скільки потрібно вашим програмам."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لامحدود رہیں اور جتنے اسکرین شاٹس آپ کی ایپس کو درکار ہوں بنائیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sử dụng không giới hạn và tạo bao nhiêu ảnh chụp màn hình tùy theo nhu cầu của ứng dụng của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "升级为无限制版本，为你的 App 创建所需的全部截图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "升級為無限制，為你的 App 建立所需的所有螢幕截圖。"
          }
        }
      }
    },

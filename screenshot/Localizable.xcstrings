    },
    "%@ Changes already made in App Store Connect were not reverted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ لم يتم التراجع عن التغييرات التي تم إجراؤها بالفعل في App Store Connect."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ App Store Connect এ ইতিমধ্যে করা পরিবর্তনগুলি প্রত্যাবর্তন করা হয়নি৷"

    "Add screenshots from Photos or Files, then drop in text, shapes, and a device frame." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بإضافة لقطات شاشة من الصور أو الملفات، ثم قم بإسقاط النص والأشكال وإطار الجهاز."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegiu captures de pantalla de Fotos o Fitxers i, a continuació, introduïu text, formes i un marc del dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte snímky obrazovky z fotografií nebo souborů a poté vložte text, tvary a rámeček zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj skærmbilleder fra Fotos eller Filer, og indsæt derefter tekst, figurer og en enhedsramme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Screenshots aus Fotos oder Dateien hinzu und ergänze dann Text, Formen und einen Geräterahmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε στιγμιότυπα οθόνης από Φωτογραφίες ή Αρχεία και, στη συνέχεια, προσθέστε κείμενο, σχήματα και ένα πλαίσιο συσκευής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade capturas desde Fotos o Archivos y luego inserta texto, formas y un marco de dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسکرین‌شات‌ها را از Photos یا Files اضافه کنید، سپس متن، شکل و قاب دستگاه بگذارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää kuvakaappauksia Kuvat- tai Tiedostot-apista ja lisää sitten tekstiä, muotoja ja laitekehys."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des captures d'écran depuis Photos ou Fichiers, puis ajoutez du texte, des formes et un cadre d'appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסף צילומי מסך מתמונות או מקבצים, ולאחר מכן הוסף טקסט, צורות ומסגרת של מכשיר."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte snimke zaslona iz fotografija ili datoteka, zatim ubacite tekst, oblike i okvir uređaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjon hozzá képernyőképeket a Fényképek vagy Fájlok alkalmazásból, majd dobjon be szöveget, alakzatokat és egy eszközkeretet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",

    "**Linear**: choose start/end via the angle wheel. Add as many stops as you want." : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Lineal**: trieu inici/final mitjançant la roda angular. Afegiu tantes parades com vulgueu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Lineær**: vælg start/slut via vinkelhjulet. Tilføj så mange stop, som du vil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Linear**: Wählen Sie Start/Ende über das Winkelrad. Fügen Sie so viele Stopps hinzu, wie Sie möchten."
          }
        },
        "es" : {
          "stringUnit" : {

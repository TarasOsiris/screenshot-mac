        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте безупречную страницу в магазине на всех языках и для всех устройств — без ограничений и компромиссов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her dilde ve her aygıtta özenli bir mağaza sayfası oluşturun — sınır yok, taviz yok."

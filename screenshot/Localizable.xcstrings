            "value" : "**Google Cloud コンソール** でサービスアカウントを作成し、**Google Play Android Developer API** を有効にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Google Cloud 콘솔**에서 서비스 계정을 만들고 **Google Play Android Developer API**를 활성화하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No **console do Google Cloud**, crie uma conta de serviço e ative a **Google Play Android Developer API**."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В **консоли Google Cloud** создайте сервисный аккаунт и включите **Google Play Android Developer API**."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Google Cloud konsolunda** bir hizmet hesabı oluşturun ve **Google Play Android Developer API**'yi etkinleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У **консолі Google Cloud** створіть сервісний обліковий запис і ввімкніть **Google Play Android Developer API**."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 **Google Cloud 控制台** 中创建服务账号，并启用 **Google Play Android Developer API**。"

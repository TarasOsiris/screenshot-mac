            "value" : "**לחץ לחיצה כפולה על ערך ריווח האותיות** כדי להחזיר אותו לברירת המחדל."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Dvaput kliknite vrijednost razmaka između slova** da je vratite na zadanu vrijednost."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Kattintson duplán a betűköz értékére**, hogy visszaállítsa az alapértelmezett értékre."
          }
        },
        "id" : {
          "stringUnit" : {

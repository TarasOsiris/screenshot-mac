    "SVGs are sanitized — script and event handlers are stripped before rendering." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs estan desinfectats: els gestors d'scripts i d'esdeveniments s'eliminen abans de representar-los."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs er renset – script- og hændelseshandlere fjernes før gengivelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs werden bereinigt – Skripte und Event-Handler werden vor dem Rendern entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los SVG se limpian: los scripts y los controladores de eventos se eliminan antes de renderizarlos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGها پاکسازی می‌شوند - اسکریپت‌ها و کنترل‌کننده‌های رویداد قبل از رندر کردن حذف می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs on puhdistettu – komentosarjat ja tapahtumakäsittelijät poistetaan ennen renderöimistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les SVG sont nettoyés : les scripts et gestionnaires d'événements sont supprimés avant le rendu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli SVG vengono ripuliti: script e gestori di eventi vengono rimossi prima del rendering."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG は無害化されます。スクリプトやイベントハンドラはレンダリング前に取り除かれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG는 안전하게 정리됩니다. 렌더링 전에 스크립트와 이벤트 핸들러가 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs worden opgeschoond: script- en gebeurtenishandlers worden verwijderd voordat ze worden weergegeven."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs er renset – skript- og hendelsesbehandlere fjernes før gjengivelse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs são higienizados – scripts e manipuladores de eventos são removidos antes da renderização."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs são higienizados – scripts e manipuladores de eventos são removidos antes da renderização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG очищаются — скрипты и обработчики событий удаляются перед отрисовкой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs är sanerade – skript- och händelsehanterare tas bort innan de renderas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG'ler temizlenir — oluşturmadan önce betikler ve olay işleyicileri kaldırılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG очищуються — скрипти й обробники подій вилучаються перед рендерингом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG 会经过清理——渲染前会移除脚本和事件处理程序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG 會經過清理——轉譯前會移除指令碼和事件處理常式。"
          }
        }
      }
    },
    "SVGs render with a configurable color override and scale crisply at any export resolution." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs renderitza amb una substitució de color configurable i una escala nítida amb qualsevol resolució d'exportació."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs gengives med en konfigurerbar farvetilsidesættelse og skalerer skarpt ved enhver eksportopløsning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs lassen sich mit einer eigenen Farbe darstellen und bleiben bei jeder Exportauflösung scharf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los SVG se renderizan con un color personalizado opcional y escalan con nitidez a cualquier resolución de exportación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGها با امکان تعیین رنگ دلخواه رندر می‌شوند و در هر وضوح خروجی واضح می‌مانند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG renderöi konfiguroitavan värin ohituksen ja skaalaa terävästi millä tahansa vientitarkkuudella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les SVG sont rendus avec une couleur de remplacement configurable et restent nets à toutes les résolutions d'exportation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli SVG vengono resi con un colore sostitutivo configurabile e restano nitidi a qualsiasi risoluzione di esportazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG は色を上書き設定してレンダリングでき、どの書き出し解像度でも鮮明に拡大/縮小されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG는 색상 재정의를 설정해 렌더링할 수 있으며, 어떤 내보내기 해상도에서도 선명하게 확대됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs worden weergegeven met een configureerbare kleuroverschrijving en scherp geschaald bij elke exportresolutie."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs gjengis med en konfigurerbar fargeoverstyring og skaleres skarpt til enhver eksportoppløsning."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs são renderizados com uma substituição de cores configurável e dimensionados de forma nítida em qualquer resolução de exportação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs são renderizados com uma substituição de cores configurável e dimensionados de forma nítida em qualquer resolução de exportação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG отрисовываются с настраиваемой заменой цвета и остаются четкими при любом разрешении экспорта."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVGs återges med en konfigurerbar färgöverstyrning och skala skarpt vid vilken exportupplösning som helst."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG'ler yapılandırılabilir bir renk geçersiz kılmasıyla oluşturulur ve her dışa aktarma çözünürlüğünde keskin şekilde ölçeklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG рендеряться з налаштовуваним перевизначенням кольору й чітко масштабуються до будь-якої роздільності експорту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG 渲染时可设置颜色覆盖，并在任何导出分辨率下都能清晰缩放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG 會以可設定的覆寫顏色轉譯，並在任何輸出解析度下都能清晰縮放。"
          }
        }
      }
    },

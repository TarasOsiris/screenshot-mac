    "Nothing goes live until the experiment is approved and you start it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يتم تنفيذ أي شيء حتى تتم الموافقة على التجربة وبدء تشغيلها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরীক্ষাটি অনুমোদিত না হওয়া পর্যন্ত কিছুই লাইভ হয় না এবং আপনি এটি শুরু করেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Res es posarà en funcionament fins que s'aprova l'experiment i l'inicieu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic nebude aktivní, dokud nebude experiment schválen a vy jej nespustíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet går live, før eksperimentet er godkendt, og du starter det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts geht live, bevor das Experiment genehmigt ist und du es startest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τίποτα δεν λειτουργεί μέχρι να εγκριθεί το πείραμα και να το ξεκινήσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada se publica hasta que el experimento se apruebe y lo inicies."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تا زمانی که آزمایش تأیید نشود و آن را شروع نکنید، چیزی منتشر نمی‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikään ei käynnisty ennen kuin kokeilu on hyväksytty ja aloitat sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’est publié tant que l’expérience n’est pas approuvée et que vous ne l’avez pas lancée."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "જ્યાં સુધી પ્રયોગ મંજૂર ન થાય અને તમે તેને શરૂ કરો ત્યાં સુધી કંઈપણ લાઇવ થતું નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שום דבר לא יעלה לאוויר עד שהניסוי יאושר ואתה מתחיל אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब तक प्रयोग स्वीकृत नहीं हो जाता और आप इसे शुरू नहीं कर देते, तब तक कुछ भी लाइव नहीं होता।"
          }
        },
        "hr" : {
          "stringUnit" : {

    "It has run, so its screenshots are final. Choose New Experiment to test new ones." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد تم تشغيله، لذا أصبحت لقطات الشاشة الخاصة به نهائية. اختر تجربة جديدة لاختبار تجارب جديدة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'ha executat, de manera que les seves captures de pantalla són definitives. Trieu Experiment nou per provar-ne de nous."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustil se, takže jeho snímky obrazovky jsou konečné. Chcete-li otestovat nové, vyberte Nový experiment."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den har kørt, så dens skærmbilleder er endelige. Vælg Nyt eksperiment for at teste nye."

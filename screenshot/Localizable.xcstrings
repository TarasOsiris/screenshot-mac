    "Go unlimited and create as many screenshots as your apps need." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتقل إلى عدد غير محدود وقم بإنشاء العديد من لقطات الشاشة التي تحتاجها تطبيقاتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সীমাহীন যান এবং আপনার অ্যাপ্লিকেশানগুলির যতগুলি প্রয়োজন ততগুলি স্ক্রিনশট তৈরি করুন৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aneu sense límits i creeu tantes captures de pantalla com necessitin les vostres aplicacions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jděte neomezeně a vytvořte tolik snímků obrazovky, kolik vaše aplikace potřebují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå ubegrænset og lav så mange skærmbilleder, som dine apps har brug for."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Limits: Erstelle so viele Screenshots, wie deine Apps brauchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πηγαίνετε απεριόριστα και δημιουργήστε όσα στιγμιότυπα οθόνης χρειάζονται οι εφαρμογές σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin límites: crea todas las capturas que necesiten tus apps."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نامحدود شوید و هر تعداد اسکرین‌شات که برنامه‌هایتان لازم دارند بسازید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä rajattomasti ja luo niin monta kuvakaappausta kuin sovelluksesi tarvitsevat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez à l'illimité et créez autant de captures d'écran que vos apps en ont besoin."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અમર્યાદિત જાઓ અને તમારી એપ્લિકેશનોને જરૂર હોય તેટલા સ્ક્રીનશોટ બનાવો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עבור ללא הגבלה וצור צילומי מסך רבים ככל שהאפליקציות שלך זקוקות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "असीमित उपयोग करें और उतने स्क्रीनशॉट बनाएं जितनी आपके ऐप्स को चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idite neograničeno i izradite onoliko snimaka zaslona koliko je vašim aplikacijama potrebno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lépjen korlátlanul, és készítsen annyi képernyőképet, amennyire az alkalmazásoknak szüksége van."

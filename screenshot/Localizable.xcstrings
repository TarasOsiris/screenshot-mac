          "stringUnit" : {
            "state" : "translated",
            "value" : "ટેક્સ્ટનો આકાર પસંદ કરેલ હોય, ગુણધર્મો બાર ફોન્ટ, વજન, કદ, રંગ, આડી અને ઊભી ગોઠવણી, રેખાની ઊંચાઈ અને અક્ષર અંતર દર્શાવે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כאשר צורת טקסט נבחרה, סרגל המאפיינים מציג גופן, משקל, גודל, צבע, יישור אופקי ואנכי, גובה שורות ומרווח אותיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चयनित टेक्स्ट आकार के साथ, गुण बार फ़ॉन्ट, वजन, आकार, रंग, क्षैतिज और ऊर्ध्वाधर संरेखण, पंक्ति ऊंचाई और अक्षर रिक्ति दिखाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad je odabran oblik teksta, traka svojstava prikazuje font, težinu, veličinu, boju, vodoravno i okomito poravnanje, visinu retka i razmak između slova."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiválasztott szövegforma esetén a tulajdonságsáv a betűtípust, a súlyt, a méretet, a színt, a vízszintes és függőleges igazítást, a sormagasságot és a betűközt mutatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan bentuk teks yang dipilih, bilah properti memperlihatkan font, berat, ukuran, warna, perataan horizontal dan vertikal, tinggi garis, dan spasi huruf."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストの形状を選択すると、プロパティ バーにフォント、太さ、サイズ、色、水平方向と垂直方向の配置、行の高さ、文字間隔が表示されます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪಠ್ಯದ ಆಕಾರವನ್ನು ಆಯ್ಕೆ ಮಾಡುವುದರೊಂದಿಗೆ, ಗುಣಲಕ್ಷಣಗಳ ಪಟ್ಟಿಯು ಫಾಂಟ್, ತೂಕ, ಗಾತ್ರ, ಬಣ್ಣ, ಅಡ್ಡ ಮತ್ತು ಲಂಬ ಜೋಡಣೆ, ಸಾಲಿನ ಎತ್ತರ ಮತ್ತು ಅಕ್ಷರದ ಅಂತರವನ್ನು ತೋರಿಸುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 모양을 선택하면 속성 표시줄에 글꼴, 두께, 크기, 색상, 가로 및 세로 정렬, 줄 높이, 문자 간격이 표시됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "തിരഞ്ഞെടുത്ത ഒരു ടെക്സ്റ്റ് ആകൃതി ഉപയോഗിച്ച്, പ്രോപ്പർട്ടികൾ ബാർ ഫോണ്ട്, ഭാരം, വലിപ്പം, നിറം, തിരശ്ചീനവും ലംബവുമായ വിന്യാസം, ലൈൻ ഉയരം, അക്ഷരങ്ങളുടെ സ്പെയ്സിംഗ് എന്നിവ കാണിക്കുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मजकूर आकार निवडल्यास, गुणधर्म बार फॉन्ट, वजन, आकार, रंग, क्षैतिज आणि अनुलंब संरेखन, रेषेची उंची आणि अक्षरांमधील अंतर दर्शवितो."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan bentuk teks yang dipilih, bar sifat menunjukkan fon, berat, saiz, warna, penjajaran mendatar dan menegak, ketinggian baris dan jarak huruf."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als een tekstvorm is geselecteerd, toont de eigenschappenbalk het lettertype, de dikte, de grootte, de kleur, de horizontale en verticale uitlijning, de lijnhoogte en de letterafstand."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med en tekstform valgt, viser egenskapslinjen font, vekt, størrelse, farge, horisontal og vertikal justering, linjehøyde og bokstavavstand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po wybraniu kształtu tekstu pasek właściwości pokazuje czcionkę, grubość, rozmiar, kolor, wyrównanie w poziomie i pionie, wysokość linii i odstępy między literami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com uma forma de texto selecionada, a barra de propriedades mostra fonte, espessura, tamanho, cor, alinhamento horizontal e vertical, altura da linha e espaçamento entre letras."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com uma forma de texto selecionada, a barra de propriedades mostra fonte, espessura, tamanho, cor, alinhamento horizontal e vertical, altura da linha e espaçamento entre letras."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cu o formă de text selectată, bara de proprietăți arată fontul, greutatea, dimensiunea, culoarea, alinierea orizontală și verticală, înălțimea liniei și spațierea dintre litere."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je vybratý tvar textu, panel vlastností zobrazuje písmo, hmotnosť, veľkosť, farbu, vodorovné a zvislé zarovnanie, výšku riadku a medzery medzi písmenami."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je izbrana oblika besedila, vrstica z lastnostmi prikazuje pisavo, težo, velikost, barvo, vodoravno in navpično poravnavo, višino vrstice in razmik med črkami."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med en textform vald visar egenskapsfältet teckensnitt, vikt, storlek, färg, horisontell och vertikal justering, linjehöjd och bokstavsavstånd."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தேர்ந்தெடுக்கப்பட்ட உரை வடிவத்துடன், பண்புகள் பட்டி எழுத்துரு, எடை, அளவு, நிறம், கிடைமட்ட மற்றும் செங்குத்து சீரமைப்பு, வரி உயரம் மற்றும் எழுத்து இடைவெளி ஆகியவற்றைக் காட்டுகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఎంచుకున్న టెక్స్ట్ ఆకృతితో, ప్రాపర్టీస్ బార్ ఫాంట్, బరువు, పరిమాణం, రంగు, క్షితిజ సమాంతర మరియు నిలువు అమరిక, పంక్తి ఎత్తు మరియు అక్షరాల అంతరాన్ని చూపుతుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเลือกรูปร่างข้อความ แถบคุณสมบัติจะแสดงแบบอักษร น้ำหนัก ขนาด สี การจัดตำแหน่งแนวนอนและแนวตั้ง ความสูงของบรรทัด และระยะห่างระหว่างตัวอักษร"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متن کی شکل کے منتخب ہونے کے ساتھ، پراپرٹیز بار فونٹ، وزن، سائز، رنگ، افقی اور عمودی سیدھ، لائن کی اونچائی، اور خط کی جگہ کو دکھاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với hình dạng văn bản được chọn, thanh thuộc tính sẽ hiển thị phông chữ, độ dày, kích thước, màu sắc, căn chỉnh ngang và dọc, chiều cao dòng và khoảng cách giữa các chữ cái."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择文本形状后，属性栏会显示字体、粗细、大小、颜色、水平和垂直对齐方式、行高和字母间距。"
          }
        }
      }
    },

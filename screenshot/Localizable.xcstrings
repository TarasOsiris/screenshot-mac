        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina el Issuer ID, el Key ID y la clave privada importada de este Mac."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با این کار Issuer ID، Key ID و کلید خصوصی وارد شده از این Mac حذف می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {

          "stringUnit" : {
            "state" : "translated",
            "value" : "**App-Informationen** (versionsübergreifend): **App-Name**, **Untertitel**, **Datenschutzerklärungs-URL**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Información de la aplicación** (compartida entre versiones): **Nombre de la aplicación**, **Subtítulo**, **URL de la política de privacidad**."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**اطلاعات برنامه** (به اشتراک گذاشته شده در بین نسخه ها): **نام برنامه**، **زیرنویس**، **نشانی اینترنتی خط مشی رازداری**."

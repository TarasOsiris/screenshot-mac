    "Pick a different App Store locale for one of them, or turn one off." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر لغة App Store مختلفة لأحدها، أو قم بإيقاف تشغيلها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তাদের মধ্যে একটির জন্য একটি ভিন্ন App Store লোকেল বেছে নিন, অথবা একটি বন্ধ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trieu una App Store configuració regional diferent per a una d'elles o desactiveu-ne una."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte pro jednu z nich jiné App Store národní prostředí nebo některé vypněte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en anden App Store landestandard for en af dem, eller slå en fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle für eine davon eine andere App Store-Sprache oder schalte eine aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε μια διαφορετική γλώσσα App Store για μία από αυτές ή απενεργοποιήστε μία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige otro idioma de App Store para uno de ellos o desactiva uno."
          }
        },
        "fa" : {
          "stringUnit" : {

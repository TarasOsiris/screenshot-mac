    "The App Store screenshots for %@ changed after review. Refresh before syncing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تغيير لقطات شاشة App Store لـ %1$@ بعد المراجعة. قم بالتحديث قبل المزامنة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@-এর জন্য App Store স্ক্রিনশটগুলি পর্যালোচনার পরে পরিবর্তিত হয়েছে৷ সিঙ্ক করার আগে রিফ্রেশ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures de pantalla de App Store per a %1$@ han canviat després de la revisió. Actualitza abans de sincronitzar."

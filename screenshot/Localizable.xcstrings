    "Loved the app? An App Store review helps tremendously and keeps Screenshot Bro independent." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحب التطبيق؟ تساعد مراجعة App Store بشكل كبير وتحافظ على استقلالية Screenshot Bro."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T'ha agradat l'aplicació? Una revisió de App Store ajuda moltíssim i manté Screenshot Bro independent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Líbila se vám aplikace? Recenze App Store nesmírně pomáhá a udržuje Screenshot Bro nezávislost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elskede appen? En App Store anmeldelse hjælper enormt og holder Screenshot Bro uafhængig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gefällt dir die App? Eine Bewertung im App Store hilft enorm und hält Screenshot Bro unabhängig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σας άρεσε η εφαρμογή; Μια κριτική App Store βοηθάει πάρα πολύ και διατηρεί τον Screenshot Bro ανεξάρτητο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te encanta la app? Una reseña en el App Store ayuda muchísimo y mantiene independiente a Screenshot Bro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه را دوست دارید؟ نوشتن نظر در App Store خیلی کمک می‌کند و Screenshot Bro را مستقل نگه می‌دارد."

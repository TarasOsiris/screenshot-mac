        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**اسکرین‌شات را روی دستگاه رها کنید** تا در آن قرار گیرد. تصویر خودکار به اندازهٔ ناحیهٔ صفحه‌نمایش بریده می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",

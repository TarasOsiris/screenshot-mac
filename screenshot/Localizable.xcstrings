    "Import a service account JSON key, test the connection, and toggle demo mode. See the Google Play topic." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON-Schlüssel eines Dienstkontos importieren, Verbindung testen und Demomodus ein- oder ausschalten. Siehe das Thema „Google Play“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa una clave JSON de cuenta de servicio, prueba la conexión y activa o desactiva el modo de demostración. Consulta el tema Google Play."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلید JSON حساب سرویس را وارد کنید، اتصال را آزمایش کنید و حالت نمایشی را روشن یا خاموش کنید. به مبحث Google Play مراجعه کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez une clé JSON de compte de service, testez la connexion et activez le mode démo. Consultez la rubrique Google Play."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa una chiave JSON dell'account di servizio, verifica la connessione e attiva la modalità demo. Consulta l'argomento Google Play."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サービスアカウントの JSON キーを読み込み、接続をテストし、デモモードを切り替えます。Google Play のトピックを参照してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서비스 계정 JSON 키를 가져오고, 연결을 테스트하고, 데모 모드를 전환합니다. Google Play 항목을 참조하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe uma chave JSON de conta de serviço, teste a conexão e ative ou desative o modo de demonstração. Consulte o tópico Google Play."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импортируйте JSON-ключ сервисного аккаунта, проверьте подключение и включите или выключите демо-режим. См. раздел Google Play."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir hizmet hesabı JSON anahtarını içe aktarın, bağlantıyı test edin ve demo modunu açıp kapatın. Google Play konusuna bakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Імпортуйте ключ JSON сервісного облікового запису, перевірте з’єднання та ввімкніть або вимкніть демо-режим. Докладніше в темі Google Play."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入服务账号 JSON 密钥、测试连接并开关演示模式。请参阅“Google Play”主题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入服務帳號 JSON 密鑰、測試連線，以及切換示範模式。請參閱 Google Play 主題。"
          }
        }
      }
    },
    "Import screenshots into device frames, add and translate languages, and set per-language text." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshots in Geräterahmen importieren, Sprachen hinzufügen und übersetzen und Text pro Sprache festlegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

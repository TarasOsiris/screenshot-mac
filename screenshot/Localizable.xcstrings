      }
    },
    "App Store Connect already has an unsubmitted %@ review submission. Submit or remove it there first — this app won't add to it, so nothing else goes to review by accident." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect لديه بالفعل إرسال مراجعة %1$@ لم يتم إرساله. قم بإرساله أو إزالته هناك أولاً — لن تتم إضافة هذا التطبيق إليه، لذا لن تتم مراجعة أي شيء آخر عن طريق الصدفة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect ja té una revisió de %1$@ no enviada. Envieu-lo o suprimiu-lo primer; aquesta aplicació no s'hi afegirà, de manera que res més es revisarà per accident."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect již má neodeslaný %1$@ příspěvek ke kontrole. Nejprve ji tam odešlete nebo odeberte – tato aplikace do ní nebude přidávat, takže nic jiného ke kontrole nejde náhodou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect har allerede en ikke-indsendt %1$@ anmeldelsesindsendelse. Indsend eller fjern den der først – denne app tilføjer den ikke, så intet andet bliver gennemgået ved et uheld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect hat bereits eine nicht eingereichte %@-Prüfungseinreichung. Reiche sie dort zuerst ein oder entferne sie – diese App fügt nichts hinzu, damit nichts versehentlich zur Prüfung geht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο App Store Connect έχει ήδη μια μη υποβληθείσα %1$@ υποβολή κριτικής. Υποβάλετέ το ή αφαιρέστε το πρώτα εκεί — αυτή η εφαρμογή δεν θα προσθέσει σε αυτήν, επομένως τίποτα άλλο δεν θα υποβληθεί σε έλεγχο κατά λάθος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect ya tiene un envío a revisión de %@ sin enviar. Envíalo o elimínalo allí primero: esta app no le añadirá nada, para que nada más vaya a revisión por error."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect از قبل یک درخواست بررسی ارسال‌نشده برای %@ دارد. ابتدا آن را آنجا ارسال یا حذف کنید — این برنامه چیزی به آن اضافه نمی‌کند تا چیز دیگری به‌اشتباه برای بررسی نرود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect on jo lähettänyt %1$@ arvostelun, jota ei ole lähetetty. Lähetä tai poista se ensin siellä – tämä sovellus ei lisää sitä, joten mikään muu ei mene vahingossa tarkistettavaksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect contient déjà une soumission %@ non envoyée. Soumettez-la ou supprimez-la d’abord — cette app n’y ajoute rien, pour que rien d’autre ne parte en examen par erreur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ל-App Store Connect כבר יש הגשת ביקורת של %1$@ שלא נשלחה. שלח או הסר אותו שם תחילה - האפליקציה הזו לא תתווסף לה, אז שום דבר אחר לא יעבור לבדיקה במקרה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect već ima neposlan %1$@ podnesak recenzije. Prvo ga tamo pošaljite ili uklonite — ova ga aplikacija neće dodavati, tako da ništa drugo slučajno ne ide na pregled."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect már be nem nyújtott %1$@ felülvizsgálati beadványt kapott. Először küldje be vagy távolítsa el – ez az alkalmazás nem fog hozzáadni, így semmi más nem kerül véletlenül felülvizsgálatra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect sudah memiliki kiriman ulasan %1$@ yang belum dikirim. Kirimkan atau hapus dulu di sana — aplikasi ini tidak akan menambahkannya, jadi tidak ada lagi yang akan ditinjau secara tidak sengaja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect ha già un invio per la revisione %@ non ancora inoltrato. Inoltralo o rimuovilo prima lì: questa app non vi aggiungerà nulla, così nient'altro finisce in revisione per errore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect に未提出の %@ の審査提出がすでにあります。先にそちらで提出または削除してください。誤って別のものが審査に回らないよう、このアプリはそれに追加しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect에 제출되지 않은 %@ 심사 제출이 이미 있습니다. 먼저 그곳에서 제출하거나 제거하세요. 다른 항목이 실수로 심사에 들어가지 않도록 이 앱은 여기에 추가하지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect sudah mempunyai penyerahan ulasan %1$@ yang belum diserahkan. Serahkan atau alih keluarnya di sana dahulu — apl ini tidak akan menambahnya, jadi tiada apa-apa lagi yang disemak secara tidak sengaja."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect heeft al een niet-ingezonden %1$@ recensie-inzending. Dien het daar eerst in of verwijder het. Deze app voegt er niets aan toe, dus niets anders wordt per ongeluk beoordeeld."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect har allerede en ikke-innsendt %1$@ anmeldelse. Send inn eller fjern den der først - denne appen vil ikke legge til den, så ingenting annet går til vurdering ved et uhell."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect ma już nieprzesłaną %1$@ przesłaną recenzję. Najpierw prześlij go lub usuń tam — ta aplikacja nie doda do niego żadnych innych elementów, więc nic innego nie trafi do przypadkowej recenzji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O App Store Connect já tem um envio para revisão de %@ pendente. Envie ou remova esse envio lá primeiro — este app não adiciona nada a ele, para que nada mais vá para revisão por engano."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect já tem um envio de revisão %1$@ não enviado. Envie ou remova-o primeiro - este aplicativo não adicionará nada a ele, então nada mais será revisado por acidente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect are deja o recenzie netrimisă pentru %1$@. Trimiteți-o sau eliminați-o mai întâi acolo - această aplicație nu se va adăuga la ea, așa că nimic altceva nu va fi examinat accidental."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В App Store Connect уже есть неотправленная заявка на проверку для %@. Сначала отправьте или удалите ее там — это приложение не будет в нее ничего добавлять, чтобы на проверку случайно не ушло что-то лишнее."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect už má neodoslaný %1$@ príspevok na kontrolu. Najprv ho tam odošlite alebo odstráňte – táto aplikácia sa doň nepridá, takže nič iné nejde na kontrolu náhodne."
          }
        },
        "sl" : {
          "stringUnit" : {

          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Njegovi prevodi bodo odstranjeni iz vsakega posnetka zaslona."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las versiones de esta aplicación ya están disponibles. Cree una nueva versión en App Store Connect y luego actualice este asistente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر نسخه در این برنامه در حال حاضر فعال است. یک نسخه جدید در App Store Connect ایجاد کنید، سپس این جادوگر را بازخوانی کنید."

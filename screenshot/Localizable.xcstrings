          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagens raster e SVG são suportadas como plano de fundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В качестве фона поддерживаются как растровые изображения, так и SVG."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka plan olarak hem raster hem de SVG görüntüler desteklenir."

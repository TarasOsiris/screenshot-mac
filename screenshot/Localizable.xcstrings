        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام فایل‌ها با صفر آغازین شماره‌گذاری می‌شوند (`01_…`، `02_…`) تا هنگام آپلود درست مرتب شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedostojen nimet on täytetty nollalla (`01_…`, `02_…`), joten ne lajitellaan oikein lähetettäessä."

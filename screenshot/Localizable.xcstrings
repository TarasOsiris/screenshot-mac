    "Current plan, restore purchases, manage subscription, and a copyable purchase ID to quote if you ever need help with a transaction." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktueller Tarif, Käufe wiederherstellen, Abonnement verwalten und eine kopierbare Kauf-ID, die du angeben kannst, falls du einmal Hilfe bei einer Transaktion brauchst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan actual, restaurar compra, administrar suscripción y un ID de compra que puedes copiar por si necesitas ayuda con una transacción."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طرح فعلی، بازیابی خرید، مدیریت اشتراک و شناسهٔ خرید قابل کپی برای وقتی که دربارهٔ یک تراکنش به کمک نیاز دارید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formule actuelle, restauration des achats, gestion de l'abonnement et un identifiant d'achat à copier, à communiquer si vous avez besoin d'aide pour une transaction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piano attuale, ripristino degli acquisti, gestione dell'abbonamento e un ID acquisto copiabile da indicare se avessi bisogno di aiuto con una transazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のプラン、購入の復元、サブスクリプションの管理、および取引についてサポートが必要なときに伝えられる、コピー可能な購入 ID。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 요금제, 구매 복원, 구독 관리, 그리고 결제 관련 문의 시 알려 주실 수 있는 복사 가능한 구매 ID."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plano atual, restauração de compras, gerenciamento da assinatura e um ID de compra copiável para informar se você precisar de ajuda com uma transação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущий план, восстановление покупок, управление подпиской и ID покупки, который можно скопировать, если понадобится помощь с транзакцией."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli plan, satın alımları geri yükleme, aboneliği yönetme ve bir işlemle ilgili yardım gerekirse belirtebileceğiniz kopyalanabilir bir satın alma kimliği."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поточний план, відновлення покупок, керування підпискою та ідентифікатор покупки, який можна скопіювати, якщо вам знадобиться допомога з транзакцією."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前方案、恢复购买、管理订阅，以及可拷贝的购买 ID——如需交易方面的帮助，可提供此 ID。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前方案、回復購買項目、管理訂閱，以及可拷貝的購買 ID，方便你在交易需要協助時提供。"
          }
        }
      }
    },

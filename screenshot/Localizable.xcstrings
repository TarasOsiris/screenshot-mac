    "Text doesn't fit in its box. Enlarge the box, shorten the text, or turn on Shrink to Fit." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النص لا يتناسب مع المربع الخاص به. قم بتكبير المربع أو تقصير النص أو تشغيل Shrink to Fit."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El text no cap a la seva casella. Amplieu el quadre, escurceu el text o activeu Redueix per ajustar-lo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text se nevejde do rámečku. Zvětšete rámeček, zkraťte text nebo zapněte možnost Zmenšit na míru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teksten passer ikke i dens boks. Forstør boksen, forkort teksten, eller slå Krymp til at passe til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Text passt nicht in sein Feld. Vergrößere das Feld, kürze den Text oder aktiviere „Passend verkleinern“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κείμενο δεν χωράει στο κουτί του. Μεγεθύνετε το πλαίσιο, συντομεύστε το κείμενο ή ενεργοποιήστε το Shrink to Fit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto no cabe en su cuadro. Agranda el cuadro, acorta el texto o activa Reducir para ajustar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متن در کادرش جا نمی‌شود. کادر را بزرگ‌تر کنید، متن را کوتاه کنید یا «کوچک‌سازی برای جا شدن» را روشن کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teksti ei mahdu laatikkoon. Suurenna laatikkoa, lyhennä tekstiä tai ota käyttöön Shrink to Fit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte ne tient pas dans son cadre. Agrandissez le cadre, raccourcissez le texte ou activez Réduire pour ajuster."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טקסט לא מתאים לתיבה שלו. הגדל את התיבה, קצר את הטקסט או הפעל את ה-Shrink to Fit."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst ne stane u okvir. Povećajte okvir, skratite tekst ili uključite Shrink to Fit."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szöveg nem fér be a dobozába. Nagyítsa fel a keretet, rövidítse le a szöveget, vagy kapcsolja be a Shrink to Fit (Részletes méretre) funkciót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks tidak muat di kotaknya. Perbesar kotak, perpendek teks, atau aktifkan Kecilkan agar Sesuai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il testo non entra nel riquadro. Ingrandisci il riquadro, accorcia il testo o attiva Riduci per adattare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストが枠に収まりません。枠を広げるか、テキストを短くするか、「縮小して合わせる」をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트가 상자에 맞지 않습니다. 상자를 키우거나 텍스트를 줄이거나 '맞게 축소'를 켜세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks tidak muat dalam kotaknya. Besarkan kotak, pendekkan teks atau hidupkan Kecilkan untuk Muat."
          }
        },
        "nl" : {
          "stringUnit" : {

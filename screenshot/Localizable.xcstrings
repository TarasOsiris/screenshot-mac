    "PNG or JPEG, 320–3840 px per edge, aspect ratio up to 2:1, 2–8 images." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG أو JPEG، 320–3840 بكسل لكل حافة، نسبة عرض إلى ارتفاع تصل إلى 2:1، 2–8 صور."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG বা JPEG, প্রতি প্রান্তে 320–3840 px, 2:1 পর্যন্ত আকৃতির অনুপাত, 2-8 চিত্র।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG o JPEG, 320–3840 px per vora, relació d'aspecte de fins a 2:1, 2–8 imatges."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG nebo JPEG, 320–3840 px na okraj, poměr stran až 2:1, 2–8 obrázků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG eller JPEG, 320–3840 px pr. kant, billedformat op til 2:1, 2–8 billeder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG oder JPEG, 320–3840 Pixel pro Kante, Seitenverhältnis bis zu 2:1, 2–8 Bilder."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG ή JPEG, 320–3840 px ανά άκρη, αναλογία διαστάσεων έως 2:1, 2–8 εικόνες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG o JPEG, 320–3840 px por borde, relación de aspecto de hasta 2:1, 2–8 imágenes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG یا JPEG، ۳۲۰–۳۸۴۰ پیکسل در هر لبه، نسبت تصویر تا ۲:۱، ۲ تا ۸ عکس."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG tai JPEG, 320–3840 px per reuna, kuvasuhde jopa 2:1, 2–8 kuvaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG ou JPEG, 320 à 3 840 px par bord, format d'image jusqu'à 2:1, 2 à 8 images."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG અથવા JPEG, 320–3840 px પ્રતિ ધાર, 2:1, 2–8 છબીઓ સુધીનો સાપેક્ષ ગુણોત્તર."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG או JPEG, 320–3840 פיקסלים לכל קצה, יחס רוחב-גובה של עד 2:1, 2–8 תמונות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG या JPEG, 320-3840 px प्रति किनारा, पहलू अनुपात 2:1 तक, 2-8 छवियां।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG ili JPEG, 320–3840 px po rubu, omjer slike do 2:1, 2–8 slika."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG vagy JPEG, 320–3840 képpont élenként, képarány akár 2:1, 2–8 kép."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG atau JPEG, 320–3840 piksel per tepi, rasio aspek hingga 2:1, 2–8 gambar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG o JPEG, da 320 a 3840 px per lato, proporzioni fino a 2:1, da 2 a 8 immagini."
          }
        },
        "ja" : {
          "stringUnit" : {

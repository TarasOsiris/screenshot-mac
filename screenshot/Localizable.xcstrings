        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**অ্যাক্সেস টোকেন পুনরায় তৈরি করুন** একটি নতুন টোকেন ইস্যু করে এবং সার্ভার পুনরায় চালু করে; পুরানো টোকেন ব্যবহার করে যেকোনো ক্লায়েন্টকে অবশ্যই আপডেট করতে হবে।"

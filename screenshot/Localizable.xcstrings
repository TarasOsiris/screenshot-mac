          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play 上のアプリのアプリケーション ID。例: com.example.myapp。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play에 있는 앱의 애플리케이션 ID입니다. 예: com.example.myapp."
          }
        },
        "pt-BR" : {
          "stringUnit" : {

          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se rulează. Rezultatele sunt în App Store Connect; alege Experiment nou pentru a testa alte capturi de ecran."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он запущен. Результаты — в App Store Connect; выберите «Новый эксперимент», чтобы протестировать другие скриншоты."

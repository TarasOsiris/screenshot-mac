        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat versi baharu dalam App Store Connect atau tunggu versi ini kembali kepada keadaan boleh diedit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak een nieuwe versie in App Store Connect, of wacht tot deze terugkeert naar een bewerkbare staat."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",

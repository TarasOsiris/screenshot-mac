          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با این کار تمام متن ترجمه شده و نادیده گرفتن تصویر مربوط به منطقه برای زبان فعلی حذف می شود، بنابراین پروژه دوباره از متن و تصاویر زبان پایه استفاده می کند."

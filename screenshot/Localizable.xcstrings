    "Z-order, duplicate, and delete act on the whole selection." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتيب Z وتكراره وحذفه يؤثر على التحديد بأكمله."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ordre Z, la duplicació i la supressió actuen sobre tota la selecció."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-pořadí, duplikace a odstranění působí na celý výběr."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-ordre, dupliker og slet handling på hele udvalget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebenenreihenfolge, Duplizieren und Löschen wirken auf die gesamte Auswahl."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σειρά Z, αντιγραφή και διαγραφή πράξης σε ολόκληρη την επιλογή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordenar en Z, duplicar y eliminar actúan sobre toda la selección."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتیب لایه‌ها، تکثیر و حذف روی همهٔ موارد انتخاب‌شده اعمال می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-järjestä, monista ja poista toimi koko valinnassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ordre Z, la duplication et la suppression agissent sur toute la sélection."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעל לפי סדר Z, שכפול ומחק בכל הבחירה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-redoslijed, dupliciranje i brisanje djeluju na cijeli odabir."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-sorrend, másolás és törlés a teljes kijelölésen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan Z-order, duplikat, dan hapus pada seluruh pilihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordine di sovrapposizione, duplicazione ed eliminazione agiscono sull'intera selezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重なり順の変更、複製、削除は、選択したすべての図形に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z 순서, 복제 및 삭제는 전체 선택 항목에 적용됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perintah Z, pendua dan padam bertindak pada keseluruhan pilihan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-volgorde, dupliceer en verwijder actie op de hele selectie."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-ordre, duplisere og slette handle på hele utvalget."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porządkowanie w Z, powielanie i usuwanie działają na całą selekcję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordem Z, duplicação e exclusão atuam em toda a seleção."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordem Z, duplicação e exclusão atuam em toda a seleção."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordonați în Z, duplicați și ștergeți acționează pe întreaga selecție."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порядок наложения, дублирование и удаление применяются ко всему выделению."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-poradie, duplikovanie a odstránenie pôsobia na celý výber."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-vrstni red, podvajanje in brisanje delujejo na celotno izbiro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z-ordna, duplicera och ta bort agerar på hela urvalet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลำดับ Z ทำซ้ำ และลบการกระทำกับการเลือกทั้งหมด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z sırası, çoğaltma ve silme işlemleri seçimin tamamına uygulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порядок шарів, дублювання й видалення застосовуються до всього вибраного."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پورے انتخاب پر Z- آرڈر، ڈپلیکیٹ، اور ڈیلیٹ ایکٹ۔"

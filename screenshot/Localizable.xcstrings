    "Rename a variant to match it, or remove the treatment in App Store Connect." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvieu el nom d'una variant perquè coincideixi amb ella o suprimiu el tractament a App Store Connect."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omdøb en variant for at matche den, eller fjern behandlingen i App Store Connect."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benenne eine Variante passend um oder entferne das Treatment in App Store Connect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia el nombre de una variante para que coincida o quita el tratamiento en App Store Connect."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام یک نسخه را مطابق آن تغییر دهید، یا نسخه آزمایشی را در App Store Connect حذف کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimeä muunnelma uudelleen vastaamaan sitä tai poista käsittely termistä App Store Connect."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renommez une variante pour qu’elle corresponde, ou supprimez le traitement dans App Store Connect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rinomina una variante in modo che corrisponda, oppure rimuovi il trattamento in App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一致するようにバリアント名を変更するか、App Store Connect でトリートメントを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일치하도록 변형 이름을 바꾸거나 App Store Connect에서 트리트먼트를 제거하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hernoem een variant zodat deze overeenkomt, of verwijder de behandeling in App Store Connect."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi nytt navn til en variant for å matche den, eller fjern behandlingen i App Store Connect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renomeie uma variante para corresponder ou remova o tratamento no App Store Connect."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renomeie uma variante para que corresponda a ela ou remova o tratamento em App Store Connect."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переименуйте вариант, чтобы он совпадал, или удалите тестовый вариант в App Store Connect."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byt namn på en variant för att matcha den, eller ta bort behandlingen i App Store Connect."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir varyantı ona uyacak şekilde yeniden adlandırın veya alternatif sayfayı App Store Connect'te kaldırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",

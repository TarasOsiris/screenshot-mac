          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Plantillas predeterminadas por fila**: número de plantillas vacías con las que comienza una nueva fila."
          }
        },
        "fa" : {
          "stringUnit" : {

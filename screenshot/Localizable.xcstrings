          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаблоны этой строки показаны отдельными плитками, как в App Store. Редактирование недоступно, пока вы не выйдете из режима просмотра."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

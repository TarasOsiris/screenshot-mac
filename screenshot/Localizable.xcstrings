          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um gradiente substitui as cores aplicadas a partes do texto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um gradiente substitui as cores definidas em partes do texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Градиент заменяет цвета, заданные для отдельных частей текста."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En övertoning ersätter färgerna på delar av texten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renk geçişi, metnin bölümlerine atanan renklerin yerini alır."

          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle tre er i eksportmenyen (for hver rad) og i en rads **Eksporter rad**-meny (for den raden alene)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {

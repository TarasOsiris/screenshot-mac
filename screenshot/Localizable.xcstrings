        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agregue texto, imágenes, dispositivos y formas desde aquí. Aparecerán en la fila seleccionada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متن، تصاویر، دستگاه‌ها و اشکال را از اینجا اضافه کنید. آنها در ردیف انتخاب شده ظاهر می شوند."

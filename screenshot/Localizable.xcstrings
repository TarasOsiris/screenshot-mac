    "Existing screenshots in each matching display type set will be deleted and replaced. " : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف لقطات الشاشة الموجودة في كل مجموعة من أنواع العرض المطابقة واستبدالها. "
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি ম্যাচিং ডিসপ্লে টাইপ সেটে বিদ্যমান স্ক্রিনশটগুলি মুছে ফেলা হবে এবং প্রতিস্থাপন করা হবে। "
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures de pantalla existents a cada conjunt de tipus de visualització coincident se suprimiran i se substituiran. "
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stávající snímky obrazovky v každé sadě odpovídajících typů zobrazení budou odstraněny a nahrazeny. "
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksisterende skærmbilleder i hvert matchende skærmtypesæt vil blive slettet og erstattet. "
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorhandene Screenshots in jedem passenden Anzeigetypsatz werden gelöscht und ersetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα υπάρχοντα στιγμιότυπα οθόνης σε κάθε αντίστοιχο σύνολο τύπων οθόνης θα διαγραφούν και θα αντικατασταθούν. "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capturas existentes de cada tipo de pantalla coincidente se eliminarán y reemplazarán. "
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسکرین شات های موجود در هر مجموعه از نوع نمایشگر منطبق حذف و جایگزین خواهند شد. "
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokaisen vastaavan näyttötyyppisarjan nykyiset kuvakaappaukset poistetaan ja korvataan. "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures d'écran existantes dans chaque ensemble de types d'affichage correspondant seront supprimées et remplacées."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "દરેક મેચિંગ ડિસ્પ્લે પ્રકાર સેટમાંના હાલના સ્ક્રીનશૉટ્સ કાઢી નાખવામાં આવશે અને બદલવામાં આવશે. "
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צילומי מסך קיימים בכל סט סוג תצוגה תואם יימחקו ויוחלף. "
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक मिलान डिस्प्ले प्रकार सेट में मौजूदा स्क्रीनशॉट हटा दिए जाएंगे और बदल दिए जाएंगे। "
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postojeće snimke zaslona u svakom odgovarajućem skupu vrste prikaza bit će izbrisane i zamijenjene. "
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az egyes megfelelő megjelenítési típusok meglévő képernyőképei törlődnek és lecserélődnek. "
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tangkapan layar yang ada di setiap kumpulan jenis tampilan yang cocok akan dihapus dan diganti. "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一致する各表示タイプ セット内の既存のスクリーンショットは削除され、置き換えられます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರತಿ ಹೊಂದಾಣಿಕೆಯ ಪ್ರದರ್ಶನ ಪ್ರಕಾರದ ಸೆಟ್‌ನಲ್ಲಿ ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ಗಳನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ಬದಲಾಯಿಸಲಾಗುತ್ತದೆ. "
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일치하는 각 디스플레이 유형 세트의 기존 스크린샷은 삭제되고 교체됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പൊരുത്തപ്പെടുന്ന ഓരോ ഡിസ്പ്ലേ തരം സെറ്റിലും നിലവിലുള്ള സ്ക്രീൻഷോട്ടുകൾ ഇല്ലാതാക്കുകയും പകരം വയ്ക്കുകയും ചെയ്യും. "
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक जुळणाऱ्या डिस्प्ले प्रकार संचामधील विद्यमान स्क्रीनशॉट हटवले जातील आणि बदलले जातील. "
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tangkapan skrin sedia ada dalam setiap set jenis paparan yang sepadan akan dipadamkan dan diganti. "
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

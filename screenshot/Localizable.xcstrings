    "This is what makes layouts like a single headline that flows across two screenshots possible." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وهذا ما يجعل التخطيطات مثل عنوان واحد يتدفق عبر لقطتي شاشة ممكنًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això és el que fa possibles dissenys com un únic títol que flueix a través de dues captures de pantalla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To je to, co umožňuje rozložení jako jeden nadpis, který prochází dvěma snímky obrazovky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er det, der gør layouts som en enkelt overskrift, der flyder på tværs af to skærmbilleder muligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch sind Layouts wie eine einzelne Überschrift möglich, die sich über zwei Screenshots erstreckt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό είναι που κάνει δυνατές τις διατάξεις σαν μια ενιαία επικεφαλίδα που ρέει σε δύο στιγμιότυπα οθόνης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto es lo que permite diseños como un único titular que se extiende por dos capturas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همین قابلیت است که چیدمان‌هایی مثل یک تیتر واحد که روی دو اسکرین‌شات امتداد دارد را ممکن می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä tekee mahdolliseksi asettelut kuin yksi otsikko, joka virtaa kahdessa kuvakaappauksessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est ce qui rend possible des mises en page comme un seul titre qui s’étend sur deux captures d’écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה מה שמאפשר פריסות כמו כותרת אחת שזורמת על פני שני צילומי מסך."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",

        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Перекласти вибране всіма мовами** — з’являється на панелі мов, коли ви редагуєте базову мову й вибрано текстові фігури. Перекладає вибране всіма іншими мовами одразу."
          }
        },
        "ur" : {
          "stringUnit" : {

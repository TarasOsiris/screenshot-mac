        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Справді скинути «%@» за шаблоном «%@»? Усі поточні рядки й фігури буде замінено. Цю дію не можна відмінити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你确定要使用“%2$@”模板重置“%1$@”吗？当前的所有行和形状都将被替换。此操作无法撤销。"

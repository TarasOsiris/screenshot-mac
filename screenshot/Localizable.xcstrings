          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varianten sind alternative Screenshots für A/B-Tests auf deiner App Store-Produktseite."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι παραλλαγές είναι εναλλακτικά στιγμιότυπα οθόνης για τη δοκιμή A/B στη σελίδα προϊόντος App Store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las variantes son capturas alternativas para hacer pruebas A/B en la página de producto del App Store."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخه‌ها اسکرین‌شات‌های جایگزین برای آزمایش A/B در صفحه محصول App Store شما هستند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihtoehdot ovat vaihtoehtoisia kuvakaappauksia A/B-testille App Store tuotesivullasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les variantes sont des captures d’écran alternatives à tester en A/B sur votre page produit de l’App Store."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વેરિએન્ટ એ તમારા App Store ઉત્પાદન પૃષ્ઠ પર A/B પરીક્ષણના વૈકલ્પિક સ્ક્રીનશૉટ્સ છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרסאות הן צילומי מסך חלופיים לבדיקת A/B בדף המוצר שלך ב-App Store."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वेरिएंट आपके App Store उत्पाद पृष्ठ पर ए/बी परीक्षण के वैकल्पिक स्क्रीनशॉट हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varijante su alternativne snimke zaslona za A/B testiranje na vašoj stranici proizvoda App Store."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A változatok a App Store termékoldalán található A/B teszt alternatív képernyőképei."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varian adalah tangkapan layar alternatif untuk pengujian A/B di halaman produk App Store Anda."

    "Import screenshots into device frames, add and translate languages, and set per-language text." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم باستيراد لقطات الشاشة إلى إطارات الجهاز، وإضافة اللغات وترجمتها، وتعيين النص لكل لغة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importeu captures de pantalla als marcs del dispositiu, afegiu i traduïu idiomes i configureu el text per idioma."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importujte snímky obrazovky do rámečků zařízení, přidávejte a překládejte jazyky a nastavte text pro jednotlivé jazyky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importer skærmbilleder til enhedens rammer, tilføj og oversæt sprog, og indstil tekst pr. sprog."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshots in Geräterahmen importieren, Sprachen hinzufügen und übersetzen und Text pro Sprache festlegen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εισαγάγετε στιγμιότυπα οθόνης σε καρέ συσκευής, προσθέστε και μεταφράστε γλώσσες και ορίστε κείμενο ανά γλώσσα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importar capturas en marcos de dispositivo, añadir y traducir idiomas y definir el texto de cada idioma."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسکرین‌شات‌ها را در قاب‌های دستگاه وارد کند، زبان اضافه و ترجمه کند و متن هر زبان را تنظیم کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuo kuvakaappauksia laitteen kehyksiin, lisää ja käännä kieliä ja aseta kielikohtaista tekstiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importer des captures d'écran dans les cadres d'appareil, ajouter et traduire des langues, et définir le texte propre à chaque langue."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ייבא צילומי מסך למסגרות של מכשיר, הוסף ותרגם שפות והגדר טקסט לכל שפה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvezite snimke zaslona u okvire uređaja, dodajte i prevedite jezike i postavite tekst za svaki jezik."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Képernyőképeket importálhat eszközkeretekbe, nyelveket adhat hozzá és fordíthat, valamint nyelvenkénti szöveget állíthat be."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",

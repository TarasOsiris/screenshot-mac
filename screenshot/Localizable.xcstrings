      }
    },
    "**App Store ▸ Update Metadata…** opens the App Store Connect wizard in metadata-only mode, so you can edit a version's store text without uploading a single screenshot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**App Store ▸ Metadaten aktualisieren…** öffnet den App Store Connect-Assistenten im reinen Metadatenmodus, sodass du den Store-Text einer Version bearbeiten kannst, ohne einen einzigen Screenshot hochzuladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**App Store ▸ Actualizar metadatos…** abre el asistente de App Store Connect en modo solo metadatos, para que puedas editar el texto de tienda de una versión sin subir ni una captura."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**App Store ▸ به‌روزرسانی فراداده…** دستیار App Store Connect را در حالت «فقط فراداده» باز می‌کند تا بتوانید متن فروشگاهِ یک نسخه را بدون آپلود حتی یک اسکرین‌شات ویرایش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**App Store ▸ Mettre à jour les métadonnées…** ouvre l'assistant App Store Connect en mode métadonnées seules : vous pouvez modifier les textes de la fiche d'une version sans envoyer la moindre capture d'écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**App Store ▸ Aggiorna metadati…** apre l'assistente di App Store Connect in modalità solo metadati, così puoi modificare i testi dello store di una versione senza caricare nemmeno uno screenshot."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**App Store ▸ メタデータを更新…** を選ぶと、App Store Connect のウィザードがメタデータ専用モードで開き、スクリーンショットを1枚もアップロードせずにバージョンのストアテキストを編集できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**App Store ▸ 메타데이터 업데이트…** 메뉴는 App Store Connect 마법사를 메타데이터 전용 모드로 열어, 스크린샷을 하나도 업로드하지 않고 버전의 스토어 텍스트를 편집할 수 있게 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**App Store ▸ Atualizar metadados…** abre o assistente do App Store Connect no modo somente metadados, para que você possa editar os textos da loja de uma versão sem enviar nenhuma captura de tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**App Store ▸ Обновить метаданные…** открывает мастер App Store Connect в режиме только метаданных, чтобы вы могли изменить текст версии в магазине, не загружая ни одного скриншота."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**App Store ▸ Meta Verileri Güncelle…**, App Store Connect sihirbazını yalnızca meta veri modunda açar; böylece tek bir ekran görüntüsü yüklemeden bir sürümün mağaza metnini düzenleyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**App Store ▸ Оновити метадані…** відкриває помічник App Store Connect у режимі лише метаданих, тож ви можете редагувати текст версії в магазині, не вивантажуючи жодного знімка екрана."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**App Store ▸ 更新元数据…** 会以“仅元数据”模式打开 App Store Connect 向导，让你无需上传任何截图即可编辑某个版本的商店文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**App Store ▸ 更新後設資料…** 會以僅限後設資料模式開啟 App Store Connect 精靈，讓你不必上傳任何螢幕截圖即可編輯某個版本的商店文字。"
          }
        }
      }
    },

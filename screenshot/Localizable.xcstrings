        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**삭제 전 확인** — 행 및 스크린샷에 파괴적인 작업에 대한 확인 메시지를 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Confirme antes de excluir** — mostra um prompt de confirmação para ações destrutivas em linhas e capturas de tela."

    "%@ Check that the Issuer ID, Key ID, private key, and API key permissions match the App Store Connect key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Überprüfen Sie, ob die Berechtigungen für Issuer ID, Key ID, den privaten Schlüssel und den Schlüssel API mit dem Schlüssel App Store Connect übereinstimmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Comprueba que el Issuer ID, el Key ID, la clave privada y los permisos de la clave de API coinciden con la clave de App Store Connect."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ بررسی کنید که مجوزهای Issuer ID، Key ID، کلید خصوصی و API کلید با کلید App Store Connect مطابقت داشته باشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Vérifiez que les autorisations Issuer ID, Key ID, la clé privée et la clé API correspondent à la clé App Store Connect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Verifica che Issuer ID, Key ID, chiave privata e autorizzazioni della chiave API corrispondano alla chiave di App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Issuer ID、Key ID、秘密キー、および API キーの権限が App Store Connect キーと一致することを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Issuer ID, Key ID, 개인 키, API 키 권한이 App Store Connect 키와 일치하는지 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Verifique se as permissões de Issuer ID, Key ID, chave privada e API correspondem à chave App Store Connect."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Убедитесь, что Issuer ID, Key ID, закрытый ключ и права ключа API соответствуют ключу App Store Connect."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Issuer ID, Key ID, özel anahtar ve API anahtarı izinlerinin App Store Connect anahtarıyla eşleştiğini denetleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Перевірте, чи Issuer ID, Key ID, приватний ключ і дозволи ключа API відповідають ключу App Store Connect."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 检查 Issuer ID、Key ID、私钥和 API 密钥权限是否与 App Store Connect 密钥匹配。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 請確認 Issuer ID、Key ID、私密密鑰和 API 密鑰權限與 App Store Connect 密鑰相符。"
          }
        }
      }

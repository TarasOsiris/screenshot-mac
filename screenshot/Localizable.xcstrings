        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos são renderizados de forma idêntica na visualização do editor e no PNG exportado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оба варианта выглядят одинаково в превью редактора и в экспортированном PNG."

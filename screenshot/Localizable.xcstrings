        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teste katılan App Store ziyaretçilerinin oranı; Orijinal ve her alternatif sayfa arasında eşit olarak bölünür. Geri kalanlar her zaman Orijinal'i görür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Частка відвідувачів App Store, які беруть участь, порівну розподілена між оригіналом і кожним тестовим варіантом. Решта завжди бачать оригінал."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "参与测试的 App Store 访客比例，在原始版本和各实验组之间平均分配。其余访客始终看到原始版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "參與測試的 App Store 訪客比例，會平均分配給「原始版本」和每個處理組。其餘訪客一律看到「原始版本」。"
          }
        }
      }
    },

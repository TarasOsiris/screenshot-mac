        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Переопределить фон** на панели управления шаблоном задает отдельный фон, который заменяет фон строки только для этого шаблона."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Åsidosätt bakgrund** i mallkontrollfältet ställer in en unik bakgrund som ersätter radens standard bara för den mallen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şablon denetim çubuğundaki **Arka planı geçersiz kıl**, satırın varsayılanının yerine yalnızca o şablona özgü bir arka plan ayarlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Перевизначити тло** на панелі керування шаблоном задає окреме тло, яке замінює стандартне тло рядка лише для цього шаблону."

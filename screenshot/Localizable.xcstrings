            "value" : "'%1$@' wordt geüpload als uw Google Play-vermelding"
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laster opp «%1$@» som din Google Play oppføring"
          }
        },
        "pt-BR" : {

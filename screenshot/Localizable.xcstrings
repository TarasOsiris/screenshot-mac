    "%@ Changes already made in App Store Connect were not reverted." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Els canvis ja fets a App Store Connect no s'han revertit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Ændringer, der allerede er foretaget i App Store Connect blev ikke tilbageført."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Bereits in App Store Connect vorgenommene Änderungen wurden nicht rückgängig gemacht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Los cambios ya realizados en App Store Connect no se revirtieron."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ تغییراتی که قبلاً در App Store Connect ایجاد شده بود، برگردانده نشدند."

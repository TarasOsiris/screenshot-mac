    "Keep the token private — anyone who has it can control the app while the server is running." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantingueu el testimoni privat: qualsevol persona que el tingui pot controlar l'aplicació mentre el servidor s'executa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold tokenet privat - alle, der har det, kan styre appen, mens serveren kører."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte das Token geheim – wer es hat, kann die App steuern, solange der Server läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No compartas el token: cualquiera que lo tenga puede controlar la app mientras el servidor esté en ejecución."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توکن را محرمانه نگه دارید — هر کسی آن را داشته باشد، تا وقتی سرور در حال اجراست می‌تواند برنامه را کنترل کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä tunnus yksityisenä – kuka tahansa, jolla on se, voi hallita sovellusta palvelimen ollessa käynnissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez le jeton privé : toute personne qui le possède peut contrôler l'application pendant que le serveur est en cours d'exécution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni privato il token: chiunque lo possieda può controllare l'app mentre il server è in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トークンは他人に教えないでください。トークンを知っている人は誰でも、サーバの実行中にこのアプリを操作できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "토큰을 비공개로 유지하세요. 토큰을 가진 사람은 누구나 서버가 실행되는 동안 앱을 제어할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd het token privé: iedereen die het heeft, kan de app besturen terwijl de server actief is."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold tokenet privat - alle som har det kan kontrollere appen mens serveren kjører."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o token privado – qualquer pessoa que o possua pode controlar o aplicativo enquanto o servidor estiver em execução."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o token privado – qualquer pessoa que o possua pode controlar o aplicativo enquanto o servidor estiver em execução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храните токен в секрете — любой, у кого он есть, может управлять приложением, пока работает сервер."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll token privat – alla som har den kan styra appen medan servern är igång."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belirteci gizli tutun — sunucu çalışırken belirtece sahip olan herkes uygulamayı denetleyebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тримайте токен у таємниці — будь-хто, хто його має, може керувати програмою, поки сервер працює."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请妥善保管令牌——服务器运行期间，任何拥有令牌的人都能控制本 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請妥善保管權杖——在伺服器執行期間，任何擁有權杖的人都能控制 App。"
          }
        }
      }
    },

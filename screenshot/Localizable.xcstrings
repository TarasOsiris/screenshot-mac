          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импортировать скриншоты в рамки устройств, добавлять и переводить языки, задавать текст для каждого языка."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran görüntülerini aygıt çerçevelerine aktarın, dil ekleyip çevirin ve dile özgü metin belirleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Імпортуйте знімки екрана в рамки пристроїв, додавайте й перекладайте мови та задавайте текст для кожної мови."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将屏幕截图导入设备框架，添加和翻译语言，并设置每种语言的文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {

          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のスクリーンショットのうち%1$lld枚には App Store のチェックサムがないため、保持されずに置き換えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 스크린샷 %lld개에 App Store 체크섬이 없어 보존되지 않고 교체됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld capturas de tela atuais não têm soma de verificação da App Store, portanto serão substituídas em vez de preservadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У текущих скриншотов (%lld) нет контрольной суммы App Store, поэтому они будут заменены, а не сохранены."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

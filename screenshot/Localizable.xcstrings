        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sử dụng điều khiển hướng cho các khung được hỗ trợ hoặc điều khiển xoay để xoay toàn bộ hình dạng bao gồm nội dung khung và màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

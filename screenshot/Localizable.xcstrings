        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バリアントは、App Store のプロダクトページで A/B テストするための別のスクリーンショットです。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ರೂಪಾಂತರಗಳು ನಿಮ್ಮ App Store ಉತ್ಪನ್ನ ಪುಟದಲ್ಲಿ A/B ಪರೀಕ್ಷೆಗೆ ಪರ್ಯಾಯ ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ಗಳಾಗಿವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변형은 App Store 제품 페이지에서 A/B 테스트할 대체 스크린샷입니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ App Store ഉൽപ്പന്ന പേജിലെ A/B ടെസ്റ്റിനുള്ള ഇതര സ്‌ക്രീൻഷോട്ടുകളാണ് വേരിയൻ്റുകൾ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रूपे हे तुमच्या App Store उत्पादन पृष्ठावरील A/B चाचणीचे पर्यायी स्क्रीनशॉट आहेत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varian ialah tangkapan skrin alternatif kepada ujian A/B pada halaman produk App Store anda."
          }
        },
        "nl" : {
          "stringUnit" : {

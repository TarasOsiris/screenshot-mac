        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie uma conta de serviço no console do Google Cloud, ative o Google Play desenvolvedor Android API e faça download da chave JSON. No Play Console, convide a conta de serviço em Utilizadores e permissões e conceda-lhe acesso para editar detalhes do app."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creați un cont de serviciu în consola Google Cloud, activați Google Play Android Developer API și descărcați cheia JSON a acestuia. În Play Console, invitați contul de serviciu sub Utilizatori și permisiuni și acordați-i acces pentru a edita înregistrările din magazin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",

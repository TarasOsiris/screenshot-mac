    "1 current screenshot has no App Store checksum, so it will be replaced instead of preserved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 aktueller Screenshot hat keine App Store Prüfsumme, daher wird er ersetzt statt beibehalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 captura de pantalla actual no tiene suma de verificación App Store, por lo que se reemplazará en lugar de conservarse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 نماگرفت فعلی فاقد App Store جمع کنترلی است، بنابراین به جای حفظ، جایگزین می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 capture d'écran actuelle n'a pas de somme de contrôle App Store, elle sera donc remplacée au lieu d'être conservée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 screenshot attuale non ha un checksum App Store, quindi verrà sostituito anziché mantenuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 つの現在のスクリーンショットには App Store チェックサムがないため、保存されずに置き換えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 스크린샷 1개에는 App Store 체크섬이 없으므로 보존되지 않고 교체됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 captura de tela atual não possui soma de verificação App Store, portanto, será substituída em vez de preservada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У 1 текущего скриншота нет контрольной суммы App Store, поэтому он будет заменен, а не сохранен."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli 1 ekran görüntüsünün App Store sağlama toplamı yok; bu yüzden korunmak yerine değiştirilecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 поточний знімок екрана не має контрольної суми App Store, тож його буде замінено, а не збережено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 当前屏幕截图没有 App Store 校验和，因此它将被替换而不是保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 張目前的螢幕截圖沒有 App Store 總和檢查碼，因此會被取代而非保留。"
          }
        }
      }
    },

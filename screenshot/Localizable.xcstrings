          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh die Form, um sie zu verschieben. Zieh an einem Eck- oder Kantengriff, um die Größe zu ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε το σώμα του σχήματος για να μετακινηθείτε. Σύρετε μια γωνία ή ακραία λαβή για αλλαγή μεγέθους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra la forma para moverla. Arrastra un tirador de esquina o de borde para redimensionarla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای جابه‌جایی، بدنهٔ شکل را بکشید. برای تغییر اندازه، دستگیرهٔ گوشه یا لبه را بکشید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirrä muodon runkoa vetämällä. Muuta kokoa vetämällä kulma- tai reunakahvaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la forme pour la déplacer. Faites glisser une poignée d'angle ou de bord pour la redimensionner."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આકારના શરીરને ખસેડવા માટે ખેંચો. માપ બદલવા માટે ખૂણા અથવા ધારના હેન્ડલને ખેંચો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרור את גוף הצורה כדי לזוז. גרור פינה או ידית קצה כדי לשנות את הגודל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्थानांतरित करने के लिए आकृति निकाय को खींचें. आकार बदलने के लिए कोने या किनारे के हैंडल को खींचें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povucite tijelo oblika za pomicanje. Povucite kutnu ili rubnu ručicu za promjenu veličine."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mozgatáshoz húzza az alakzat testét. Az átméretezéshez húzzon egy sarok- vagy élfogantyút."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret badan bentuk untuk bergerak. Seret pegangan sudut atau tepi untuk mengubah ukuran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina il corpo della forma per spostarla. Trascina una maniglia d'angolo o di bordo per ridimensionarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "図形の本体をドラッグすると移動します。角または辺のハンドルをドラッグするとサイズを変更します。"

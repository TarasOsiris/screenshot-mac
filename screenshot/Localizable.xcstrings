        }
      }
    },
    "This service account can't edit that app. Grant it access in the Play Console." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Dienstkonto kann diese App nicht bearbeiten. Gib ihm in der Play Console Zugriff."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cuenta de servicio no puede editar esa aplicación. Concédele acceso en Play Console."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این حساب سرویس نمی‌تواند آن برنامه را ویرایش کند. در Play Console به آن دسترسی بدهید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

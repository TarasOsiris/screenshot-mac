        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಚಿತ್ರವನ್ನು ಕ್ರಾಪ್ ಮಾಡುವಾಗ, ಬಾಣದ ಕೀಲಿಗಳು ಚಿತ್ರವನ್ನು ಅದರ ಚೌಕಟ್ಟಿನೊಳಗೆ ಚಲಿಸುತ್ತವೆ."

        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld nuværende skærmbilleder har ingen App Store kontrolsum, så de vil blive erstattet i stedet for at blive bevaret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

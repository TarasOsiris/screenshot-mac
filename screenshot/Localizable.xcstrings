    "1 screenshot must be removed first to stay within Apple's 10-screenshot limit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 Screenshot muss zuerst entfernt werden, um Apples Limit von 10 Screenshots einzuhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero se debe eliminar 1 captura para respetar el límite de 10 capturas de Apple."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای رعایت محدودیت ۱۰ اسکرین‌شات اپل، ابتدا باید ۱ اسکرین‌شات حذف شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 capture doit d’abord être supprimée pour respecter la limite de 10 captures d’Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Occorre prima rimuovere 1 screenshot per rispettare il limite di 10 screenshot di Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple の10枚制限内に収めるには、先に1枚のスクリーンショットを削除する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple의 스크린샷 10개 제한을 지키려면 먼저 스크린샷 1개를 제거해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 captura precisa ser removida primeiro para ficar dentro do limite de 10 capturas da Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала нужно удалить 1 скриншот, чтобы уложиться в лимит Apple в 10 скриншотов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple'ın 10 ekran görüntüsü sınırında kalmak için önce 1 ekran görüntüsünün kaldırılması gerekiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб не перевищити ліміт Apple у 10 знімків екрана, спершу потрібно вилучити 1 знімок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必须先移除 1 张截图，才能符合 Apple 的 10 张截图上限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必須先移除 1 張螢幕截圖，才能符合 Apple 的 10 張螢幕截圖上限。"
          }
        }
      }
    },

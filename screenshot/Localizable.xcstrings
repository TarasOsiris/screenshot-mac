    },
    "An index that exists but can't be read is moved aside to `projects.json.corrupt` rather than deleted, so nothing is lost." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم نقل الفهرس الموجود ولكن لا يمكن قراءته جانبًا إلى \"projects.json.corrupt\" بدلاً من حذفه، لذلك لا يتم فقدان أي شيء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি সূচী যা বিদ্যমান কিন্তু পড়া যায় না মুছে ফেলার পরিবর্তে `projects.json.corrupt`-এ সরানো হয়, তাই কিছুই হারিয়ে যায় না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un índex que existeix però que no es pot llegir es trasllada a \"projects.json.corrupt\" en lloc de suprimir-se, de manera que no es perd res."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Index, který existuje, ale nelze jej přečíst, se místo smazání přesune stranou do `projects.json.corrupt`, takže se nic neztratí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et indeks, der eksisterer, men som ikke kan læses, flyttes til side til `projects.json.corrupt` i stedet for at blive slettet, så intet går tabt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Index, der existiert, aber nicht lesbar ist, wird nach `projects.json.corrupt` verschoben statt gelöscht, sodass nichts verloren geht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα ευρετήριο που υπάρχει αλλά δεν μπορεί να διαβαστεί μετακινείται στην άκρη στο \"projects.json.corrupt\" αντί να διαγραφεί, οπότε τίποτα δεν χάνεται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un índice que existe pero no se puede leer se aparta como `projects.json.corrupt` en lugar de eliminarse, así que no se pierde nada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فهرستی که وجود دارد اما خوانده نمی‌شود، به‌جای حذف به `projects.json.corrupt` منتقل می‌شود تا چیزی از بین نرود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indeksi, joka on olemassa, mutta jota ei voida lukea, siirretään sivuun \"projects.json.corrupt\" sen sijaan, että se poistetaan, joten mitään ei menetetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un index présent mais illisible est mis de côté sous `projects.json.corrupt` au lieu d'être supprimé : rien n'est perdu."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એક અનુક્રમણિકા કે જે અસ્તિત્વમાં છે પરંતુ વાંચી શકાતી નથી તે કાઢી નાખવાને બદલે `projects.json.corrupt` પર ખસેડવામાં આવે છે, તેથી કંઈપણ ગુમાવ્યું નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אינדקס שקיים אך לא ניתן לקריאה מועבר הצידה אל `projects.json.corrupt` במקום נמחק, כך ששום דבר לא הולך לאיבוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक सूचकांक जो मौजूद है लेकिन पढ़ा नहीं जा सकता उसे हटाने के बजाय `projects.json.corrupt` पर ले जाया जाता है, इसलिए कुछ भी खो नहीं जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indeks koji postoji, ali se ne može pročitati pomiče se u stranu u `projects.json.corrupt` umjesto da se briše, tako da se ništa ne gubi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy létező, de nem olvasható index törlése helyett a \"projects.json.corrupt\" mappába kerül, így semmi sem vész el."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indeks yang ada tetapi tidak dapat dibaca akan dipindahkan ke `projects.json.corrupt` daripada dihapus, sehingga tidak ada yang hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un indice esistente ma illeggibile viene spostato in `projects.json.corrupt` anziché eliminato, quindi non si perde nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存在するが読み取れないインデックスは、削除されずに `projects.json.corrupt` に移動されるため、何も失われません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ಆದರೆ ಓದಲು ಸಾಧ್ಯವಾಗದ ಸೂಚಿಯನ್ನು ಅಳಿಸುವ ಬದಲು `projects.json.corrupt` ಗೆ ಸರಿಸಲಾಗುತ್ತದೆ, ಆದ್ದರಿಂದ ಏನೂ ಕಳೆದುಹೋಗುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "존재하지만 읽을 수 없는 인덱스는 삭제되지 않고 `projects.json.corrupt`로 이동되므로 아무것도 손실되지 않습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിലവിലുള്ളതും എന്നാൽ വായിക്കാൻ കഴിയാത്തതുമായ ഒരു സൂചിക ഇല്ലാതാക്കുന്നതിന് പകരം `projects.json.corrupt` എന്നതിലേക്ക് നീക്കുന്നു, അതിനാൽ ഒന്നും നഷ്‌ടപ്പെടില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अस्तित्वात असलेली पण वाचता येत नाही अशी अनुक्रमणिका हटवण्याऐवजी बाजूला हलवली जाते `projects.json.corrupt`, त्यामुळे काहीही गमावले जात नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indeks yang wujud tetapi tidak boleh dibaca dialihkan ke `projects.json.corrupt` dan bukannya dipadamkan, jadi tiada apa-apa yang hilang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een index die bestaat maar niet kan worden gelezen, wordt opzij verplaatst naar `projects.json.corrupt` in plaats van verwijderd, zodat er niets verloren gaat."
          }
        },
        "no" : {
          "stringUnit" : {

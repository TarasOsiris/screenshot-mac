          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Editar traducciones...**: abre un editor en paralelo que muestra cada forma de texto con su contenido base y anulaciones por idioma."
          }
        },
        "fa" : {

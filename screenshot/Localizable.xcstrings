    "Add text, images, devices, and shapes from here. They'll appear on the selected row." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف النص والصور والأجهزة والأشكال من هنا. وسوف تظهر في الصف المحدد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix text, imatges, dispositius i formes des d'aquí. Apareixeran a la fila seleccionada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zde přidávejte text, obrázky, zařízení a tvary. Zobrazí se na vybraném řádku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj tekst, billeder, enheder og figurer herfra. De vises på den valgte række."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie hier Text, Bilder, Geräte und Formen hinzu. Sie werden in der ausgewählten Zeile angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε κείμενο, εικόνες, συσκευές και σχήματα από εδώ. Θα εμφανιστούν στην επιλεγμένη σειρά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agregue texto, imágenes, dispositivos y formas desde aquí. Aparecerán en la fila seleccionada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متن، تصاویر، دستگاه‌ها و اشکال را از اینجا اضافه کنید. آنها در ردیف انتخاب شده ظاهر می شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää tekstiä, kuvia, laitteita ja muotoja täältä. Ne näkyvät valitulla rivillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez du texte, des images, des appareils et des formes à partir d'ici. Ils apparaîtront sur la ligne sélectionnée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסף טקסט, תמונות, מכשירים וצורות מכאן. הם יופיעו בשורה שנבחרה."
          }

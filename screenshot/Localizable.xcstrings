    "%lld unchanged screenshots will keep their App Store asset IDs." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستحتفظ لقطات الشاشة غير المتغيرة %1$lld بمعرفات الأصول الخاصة بها App Store."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les %1$lld captures de pantalla sense canvis conservaran els seus App Store identificadors de recursos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld nezměněné snímky obrazovky si zachovají svá App Store ID díla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld uændrede skærmbilleder beholder deres App Store aktiv-id'er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld unveränderte Screenshots behalten ihre App Store-Asset-IDs."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα %1$lld αμετάβλητα στιγμιότυπα οθόνης θα διατηρήσουν τα App Store αναγνωριστικά στοιχείων τους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld capturas sin cambios conservarán sus ID de recurso de App Store."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld اسکرین‌شات بدون تغییر، شناسهٔ دارایی App Store خود را حفظ می‌کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld muuttamattomat kuvakaappaukset säilyttävät App Store sisältötunnuksensa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld captures d'écran inchangées conserveront leur identifiant de ressource App Store."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld צילומי מסך ללא שינוי ישמרו על מזהי הנכסים שלהם App Store."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld nepromijenjene snimke zaslona zadržat će svoje App Store ID-ove sredstava."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$lld változatlan képernyőképek megtartják App Store elemazonosítójukat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld tangkapan layar yang tidak diubah akan mempertahankan App Store ID asetnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld screenshot invariati manterranno i propri ID asset App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更のない%1$lld枚のスクリーンショットは App Store のアセット ID を保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경되지 않은 스크린샷 %lld개는 App Store 에셋 ID를 유지합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld tangkapan skrin yang tidak berubah akan menyimpan ID aset App Store mereka."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld ongewijzigde screenshots behouden hun App Store item-ID's."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld uendrede skjermdumper beholder sine App Store ressurs-ID-er."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld niezmienione zrzuty ekranu zachowają identyfikatory zasobów App Store."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld capturas de tela inalteradas manterão seus IDs de recurso da App Store."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld capturas de ecrã inalteradas manterão seus App Store IDs de recursos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld capturi de ecran neschimbate își vor păstra App Store ID-urile de material."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неизмененные скриншоты (%lld) сохранят свои ID ресурсов App Store."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld nezmenené snímky obrazovky si zachovajú svoje App Store ID diel."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld nespremenjeni posnetki zaslona bodo obdržali svoje ID-je sredstev App Store."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld oförändrade skärmdumpar kommer att behålla sina App Store tillgångs-ID:n."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภาพหน้าจอ %1$lld ที่ไม่เปลี่ยนแปลงจะเก็บรหัสเนื้อหา App Store ไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değişmeyen %lld ekran görüntüsü App Store varlık kimliklerini koruyacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Незмінені знімки екрана (%lld) збережуть свої ідентифікатори ресурсів App Store."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld غیر تبدیل شدہ اسکرین شاٹس ان کی App Store اثاثہ IDs کو برقرار رکھیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld ảnh chụp màn hình không thay đổi sẽ giữ ID nội dung App Store của chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 张未更改的截图将保留其 App Store 资源 ID。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 張未更改的螢幕截圖會保留其 App Store 素材 ID。"
          }
        }

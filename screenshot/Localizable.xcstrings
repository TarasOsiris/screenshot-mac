    "Behind the scenes, an `NSMetadataQuery` watches each project for upload/download progress." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خلف الكواليس، يقوم NSMetadataQuery بمراقبة كل مشروع لمعرفة تقدم التحميل/التنزيل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darrere de les escenes, un \"NSMetadataQuery\" mira cada projecte per veure el progrés de càrrega/descàrrega."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V zákulisí sleduje `NSMetadataQuery` každý projekt z hlediska postupu nahrávání/stahování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bag kulisserne overvåger en `NSMetadataQuery` hvert projekt for upload/download fremskridt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Hintergrund überwacht eine `NSMetadataQuery` jedes Projekt auf Upload- und Download-Fortschritt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πίσω από τις σκηνές, ένα 'NSMetadataQuery' παρακολουθεί κάθε έργο για πρόοδο μεταφόρτωσης/λήψης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Internamente, un `NSMetadataQuery` vigila el progreso de subida y descarga de cada proyecto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در پشت صحنه، یک `NSMetadataQuery` پیشرفت آپلود و دانلود هر پروژه را زیر نظر دارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulissien takana `NSMetadataQuery` tarkkailee jokaista projektia lähetyksen/latauksen edistymistä varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En coulisses, une requête `NSMetadataQuery` surveille la progression de l'envoi et du téléchargement de chaque projet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאחורי הקלעים, `NSMetadataQuery` צופה בכל פרויקט לצורך התקדמות העלאה/הורדה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iza kulisa, `NSMetadataQuery` prati napredak svakog projekta u pogledu učitavanja/preuzimanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A színfalak mögött egy `NSMetadataQuery` figyeli az egyes projekteket a feltöltés/letöltés előrehaladását illetően."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di balik layar, `NSMetadataQuery` memantau setiap proyek untuk mengetahui kemajuan pengunggahan/pengunduhan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dietro le quinte, una `NSMetadataQuery` monitora ogni progetto per verificare l'avanzamento di caricamento e download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内部では、`NSMetadataQuery` が各プロジェクトのアップロード/ダウンロードの進行状況を監視しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내부적으로 `NSMetadataQuery`가 각 프로젝트의 업로드/다운로드 진행 상황을 감시합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di sebalik tabir, `NSMetadataQuery` menonton setiap projek untuk kemajuan muat naik/muat turun."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achter de schermen bekijkt een `NSMetadataQuery` elk project op de voortgang van het uploaden/downloaden."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bak kulissene overvåker en `NSMetadataQuery` hvert prosjekt for opplasting/nedlasting."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za kulisami funkcja `NSMetadataQuery` obserwuje każdy projekt pod kątem postępu przesyłania/pobierania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos bastidores, um `NSMetadataQuery` acompanha o progresso de envio/download de cada projeto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos bastidores, um `NSMetadataQuery` monitora cada projeto para verificar o progresso de upload/download."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În culise, un „NSMetadataQuery” urmărește fiecare proiect pentru progresul de încărcare/descărcare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За кулисами `NSMetadataQuery` отслеживает ход выгрузки и загрузки каждого проекта."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V zákulisí sleduje `NSMetadataQuery` každý projekt z hľadiska priebehu nahrávania/sťahovania."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V zakulisju `NSMetadataQuery` opazuje vsak projekt glede napredka nalaganja/prenosa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakom kulisserna tittar en `NSMetadataQuery` på varje projekt för uppladdning/nedladdning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เบื้องหลัง `NSMetadataQuery` จะเฝ้าดูแต่ละโปรเจ็กต์เพื่อดูความคืบหน้าในการอัปโหลด/ดาวน์โหลด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka planda bir `NSMetadataQuery`, her projenin yükleme/indirme ilerlemesini izler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За лаштунками `NSMetadataQuery` відстежує перебіг вивантаження й завантаження кожного проєкту."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پردے کے پیچھے، ایک `NSMetadataQuery` اپ لوڈ/ڈاؤن لوڈ کی پیشرفت کے لیے ہر پروجیکٹ کو دیکھتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phía sau hậu trường, `NSMetadataQuery` theo dõi từng dự án để biết tiến trình tải lên/tải xuống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在后台，`NSMetadataQuery` 会监视每个项目的上传/下载进度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在幕後，`NSMetadataQuery` 會監看每個專案的上傳／下載進度。"
          }
        }
      }
    },
    "Below the version, where your copy came from: **App Store** or **Direct download**." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسفل الإصدار الذي جاءت منه نسختك: **App Store** أو **تنزيل مباشر**."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sota de la versió, d'on prové la còpia: **App Store** o **Descàrrega directa**."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pod verzí, ze které vaše kopie pochází: **App Store** nebo **Přímé stažení**."
          }
        },
        "da" : {
          "stringUnit" : {

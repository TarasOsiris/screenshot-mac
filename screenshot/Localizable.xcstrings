    "No row or screenshot-column limits when building larger launch sets." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد حدود للصفوف أو أعمدة لقطة الشاشة عند إنشاء مجموعات إطلاق أكبر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hi ha límits de fila ni de columnes de captures de pantalla quan es creen conjunts de llançament més grans."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádné limity pro řádky nebo snímky obrazovky při vytváření větších spouštěcích sad."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen række- eller skærmbillede-kolonne begrænsninger, når du bygger større lanceringssæt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Begrenzung für Zeilen oder Screenshot-Spalten bei größeren Launch-Sets."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχουν όρια γραμμής ή στιγμιότυπου οθόνης-στήλης κατά τη δημιουργία μεγαλύτερων συνόλων εκκίνησης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin límites de filas ni de columnas de capturas al crear conjuntos de lanzamiento más grandes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون محدودیت در تعداد ردیف یا ستون اسکرین‌شات برای ساخت مجموعه‌های بزرگ‌تر."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei rivi- tai kuvakaappaussarakerajoja, kun rakennetaan suurempia laukaisusarjoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune limite de lignes ou de colonnes de capture d'écran lors de la création d'ensembles de lancement plus grands."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין מגבלות שורות או צילום מסך-עמודות בעת בניית מערכי השקה גדולים יותר."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema ograničenja redova ili snimaka zaslona-stupaca pri izradi većih skupova za pokretanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincsenek sorok vagy képernyőkép-oszlopok korlátozások, ha nagyobb indítókészleteket készítenek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada batasan baris atau kolom tangkapan layar saat membuat set peluncuran yang lebih besar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun limite di righe o di colonne di screenshot quando crei serie di lancio più ampie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大規模なリリース用のセットを作るときも、行やスクリーンショット列の数に上限はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 큰 출시 세트를 구축할 때 행 또는 스크린샷 열 제한이 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada had baris atau lajur tangkapan skrin apabila membina set pelancaran yang lebih besar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen rij- of screenshot-kolomlimieten bij het bouwen van grotere lanceersets."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen rad- eller skjermbilde-kolonnegrenser når du bygger større lanseringssett."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak ograniczeń w zakresie wierszy i kolumn zrzutów ekranu podczas tworzenia większych zestawów startowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há limites de linha ou coluna de captura de tela ao criar conjuntos de lançamento maiores."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há limites de linha ou coluna de captura de ecrã ao criar conjuntos de lançamento maiores."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fără limite de rânduri sau capturi de ecran pentru coloane atunci când construiești seturi de lansare mai mari."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без ограничений на строки и столбцы скриншотов при создании больших наборов к запуску."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žiadne obmedzenia riadkov alebo stĺpcov obrazovky pri vytváraní väčších spúšťacích súprav."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri gradnji večjih zagonskih nizov ni omejitev vrstic ali posnetkov zaslona-stolpcev."
          }
        },
        "sv" : {
          "stringUnit" : {

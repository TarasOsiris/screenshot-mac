    "Shapes snap to other shapes' edges and centers, and to template boundaries, within a 4px threshold." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنجذب الأشكال إلى حواف ومراكز الأشكال الأخرى، وإلى حدود القالب، ضمن حد 4 بكسل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les formes s'ajusten a les vores i centres d'altres formes, i als límits de la plantilla, dins d'un llindar de 4 píxels."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvary se přichytí k okrajům a středům jiných tvarů ak hranicím šablony v mezích 4 pixelů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Figurer fastgøres til andre formers kanter og centre og til skabelongrænser inden for en tærskel på 4 px."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formen rasten im Abstand von 4 px an Kanten und Mittelpunkten anderer Formen sowie an Vorlagengrenzen ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα σχήματα κουμπώνουν στις άκρες και τα κέντρα άλλων σχημάτων και στα όρια προτύπων, εντός ενός ορίου 4 εικονοστοιχείων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las formas se ajustan a los bordes y centros de otras formas y a los límites de las plantillas, con un margen de 4 px."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شکل‌ها در فاصلهٔ ۴ پیکسلی به لبه‌ها و مرکز شکل‌های دیگر و به مرز اسکرین‌شات‌ها می‌چسبند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muodot kiinnittyvät muiden muotojen reunoihin ja keskikohtiin sekä mallin rajoihin 4 kuvapisteen kynnyksen sisällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les formes s'aimantent aux bords et aux centres des autres formes, ainsi qu'aux limites des modèles, avec un seuil de 4 px."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צורות נצמדות לקצוות ולמרכזים של צורות אחרות, ולגבולות התבנית, בתוך סף של 4 פיקסלים."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oblici se spajaju s rubovima i središtima drugih oblika te s granicama predloška unutar praga od 4 px."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alakzatok más alakzatok éleihez és középpontjaihoz, valamint a sablonhatárokhoz illeszkednek, 4 képpontos küszöbön belül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bentuk menempel pada tepi dan tengah bentuk lain, dan ke batas templat, dalam ambang batas 4 piksel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le forme si agganciano ai bordi e ai centri delle altre forme e ai limiti dei modelli, entro una soglia di 4 px."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "図形は、4 px 以内に近づくと、ほかの図形の端や中心、テンプレートの境界にスナップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도형은 4px 이내에서 다른 도형의 가장자리와 중심, 템플릿 경계에 스냅됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bentuk tersentak ke tepi dan tengah bentuk lain, dan ke sempadan templat, dalam ambang 4px."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vormen worden uitgelijnd op de randen en middelpunten van andere vormen, en op sjabloongrenzen, binnen een drempel van 4px."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Former festes til andre formers kanter og sentre, og til malgrenser, innenfor en terskel på 4 px."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kształty przyciągają się do krawędzi i środków innych kształtów oraz do granic szablonu w granicach progu 4 pikseli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As formas se encaixam nas bordas e nos centros de outras formas e nos limites do modelo, a até 4 px de distância."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As formas se ajustam às bordas e centros de outras formas e aos limites do modelo, dentro de um limite de 4px."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formele se fixează la marginile și centrele altor forme și la limitele șablonului, într-un prag de 4px."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фигуры привязываются к краям и центрам других фигур, а также к границам шаблонов в пределах 4 пикселей."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvary sa prichytávajú k okrajom a stredom iných tvarov a k hraniciam šablón v rámci prahu 4 pixelov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oblike se pripnejo na robove in središča drugih oblik ter na meje predloge znotraj praga 4 slikovnih pik."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Former fäster till andra formers kanter och mittpunkter, och till mallgränser, inom en tröskel på 4px."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปร่างจัดชิดกับขอบและกึ่งกลางของรูปร่างอื่นๆ และจัดชิดกับขอบเขตเทมเพลตภายในเกณฑ์ 4px"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şekiller, 4 px eşik içinde diğer şekillerin kenarlarına ve merkezlerine ve şablon sınırlarına yaslanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фігури прив’язуються до країв і центрів інших фігур, а також до меж шаблонів у межах 4 px."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شکلیں 4px کی حد کے اندر، دوسری شکلوں کے کناروں اور مراکز، اور ٹیمپلیٹ کی حدود تک پہنچ جاتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các hình dạng bám vào các cạnh và tâm của các hình dạng khác cũng như vào các ranh giới của mẫu, trong ngưỡng 4px."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "形状会在 4 像素范围内对齐其他形状的边缘和中心，以及模板边界。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "形狀會在 4 px 的範圍內對齊其他形狀的邊緣和中心點，以及範本邊界。"
          }
        }
      }
    },

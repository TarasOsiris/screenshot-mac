    "Screenshot Bro remembers the last folder you exported to (security-scoped bookmark)." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshot Bro merkt sich den letzten Ordner, in den Sie exportiert haben (sicherheitsbezogenes Lesezeichen)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshot Bro recuerda la última carpeta a la que exportaste (marcador de seguridad)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshot Bro آخرین پوشه ای را که به آن صادر کرده اید (نشانک با محدوده امنیتی) را به خاطر می آورد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshot Bro mémorise le dernier dossier vers lequel vous avez exporté (signet de sécurité)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshot Bro は、最後にエクスポートしたフォルダー (セキュリティ スコープのブックマーク) を記憶します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshot Bro은 마지막으로 내보낸 폴더(보안 범위 책갈피)를 기억합니다."
          }
        },
        "pt-BR" : {

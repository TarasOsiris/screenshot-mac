    "Drag the shape body to move. Drag a corner or edge handle to resize." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen Sie den Formkörper, um ihn zu verschieben. Ziehen Sie einen Eck- oder Kantengriff, um die Größe zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra el cuerpo de la forma para moverlo. Arrastre un controlador de esquina o borde para cambiar su tamaño."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای حرکت بدنه شکل را بکشید. یک گوشه یا دستگیره لبه را برای تغییر اندازه بکشید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

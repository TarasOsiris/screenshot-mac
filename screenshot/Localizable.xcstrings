    "Dropping a folder or a group of image files onto a row is the fastest way to fill a screenshot set in order." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعد إسقاط مجلد أو مجموعة من ملفات الصور في صف واحد أسرع طريقة لملء لقطة الشاشة المحددة بالترتيب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lliscar una carpeta o un grup de fitxers d'imatge en una fila és la manera més ràpida d'omplir una captura de pantalla en ordre."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přetažením složky nebo skupiny obrazových souborů na řádek je nejrychlejší způsob, jak vyplnit sadu snímků obrazovky v pořadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At slippe en mappe eller en gruppe billedfiler på en række er den hurtigste måde at udfylde et skærmbillede i rækkefølge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Ordner oder mehrere Bilddateien auf einer Zeile abzulegen ist der schnellste Weg, ein Screenshot-Set der Reihe nach zu füllen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η απόθεση ενός φακέλου ή μιας ομάδας αρχείων εικόνας σε μια σειρά είναι ο πιο γρήγορος τρόπος για να συμπληρώσετε μια σειρά στιγμιότυπων οθόνης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soltar una carpeta o un grupo de archivos de imagen en una fila es la forma más rápida de completar un conjunto de capturas en orden."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رها کردن یک پوشه یا گروهی از فایل‌های تصویر روی ردیف، سریع‌ترین راه برای پر کردن مجموعهٔ اسکرین‌شات‌ها به ترتیب است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kansion tai kuvatiedostoryhmän pudottaminen riville on nopein tapa täyttää kuvakaappaus järjestyksessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déposer un dossier ou un groupe de fichiers image sur une ligne est le moyen le plus rapide de remplir un ensemble de captures d'écran dans l'ordre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שחרור תיקיה או קבוצת קבצי תמונה לשורה היא הדרך המהירה ביותר למלא צילום מסך לפי הסדר."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ispuštanje mape ili grupe slikovnih datoteka u red najbrži je način za popunjavanje skupa snimaka zaslona redom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy mappa vagy képfájlok csoportjának sorba helyezése a leggyorsabb módja a képernyőképek sorrendben történő kitöltésének."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjatuhkan folder atau sekelompok file gambar ke dalam satu baris adalah cara tercepat untuk mengisi kumpulan tangkapan layar secara berurutan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilasciare una cartella o un gruppo di file immagine su una riga è il modo più rapido per riempire in ordine una serie di screenshot."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダや複数の画像ファイルを行にドロップするのが、スクリーンショットのセットを順番に埋める最速の方法です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더나 이미지 파일 그룹을 행에 놓는 것이 스크린샷 세트를 순서대로 채우는 가장 빠른 방법입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggugurkan folder atau sekumpulan fail imej ke satu baris ialah cara terpantas untuk mengisi set tangkapan skrin mengikut urutan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het neerzetten van een map of een groep afbeeldingsbestanden op een rij is de snelste manier om een screenshotset op volgorde te vullen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å slippe en mappe eller en gruppe bildefiler på en rad er den raskeste måten å fylle et skjermbildesett i rekkefølge."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upuszczenie folderu lub grupy plików obrazów do wiersza to najszybszy sposób na uporządkowanie zestawu zrzutów ekranu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soltar uma pasta ou um grupo de arquivos de imagem em uma linha é a maneira mais rápida de preencher, em ordem, um conjunto de capturas de tela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",

        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potom ho odošlite na kontrolu. Apple kontroluje experiment skôr, ako sa môže začať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",

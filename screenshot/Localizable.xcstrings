        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트는 한 번 번역하고, 레이아웃은 한 번 배치하고, 모든 언어로 출시하세요."
          }
        },
        "nl" : {
          "stringUnit" : {

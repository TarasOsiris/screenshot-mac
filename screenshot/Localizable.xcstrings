    "Only included, changed sets will be synced. Exact checksum matches are preserved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تضمينه فقط، وستتم مزامنة المجموعات التي تم تغييرها. يتم الاحتفاظ بالمطابقات الاختبارية الدقيقة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধুমাত্র অন্তর্ভুক্ত, পরিবর্তিত সেটগুলি সিঙ্ক করা হবে৷ সঠিক চেকসাম মিল সংরক্ষণ করা হয়."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només es sincronitzaran els conjunts modificats i inclosos. Es conserven les coincidències exactes de la suma de control."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouze zahrnuty, změněné sady budou synchronizovány. Přesné shody kontrolního součtu jsou zachovány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun inkluderet, ændrede sæt vil blive synkroniseret. Præcise kontrolsum-matches bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur enthaltene, geänderte Sets werden synchronisiert. Exakte Prüfsummenübereinstimmungen bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο που περιλαμβάνονται, τα αλλαγμένα σύνολα θα συγχρονιστούν. Οι ακριβείς αντιστοιχίσεις αθροίσματος ελέγχου διατηρούνται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se sincronizarán los conjuntos incluidos y modificados. Se conservan las coincidencias exactas de suma de comprobación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط مجموعه‌های گنجانده‌شده و تغییرکرده همگام‌سازی می‌شوند. موارد با چک‌سام کاملاً یکسان حفظ می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain mukana, muutetut sarjat synkronoidaan. Tarkat tarkistussummat säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les ensembles inclus et modifiés seront synchronisés. Les captures identiques (même somme de contrôle) sont conservées."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ફક્ત સમાવિષ્ટ, બદલાયેલ સેટ સમન્વયિત કરવામાં આવશે. ચોક્કસ ચેકસમ મેચો સાચવેલ છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק סטים שנכללו והשתנו יסונכרנו. התאמות סכום בדיקה מדויקות נשמרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल शामिल, परिवर्तित सेट समन्वयित किए जाएंगे। सटीक चेकसम मिलान संरक्षित हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkronizirat će se samo uključeni, promijenjeni skupovi. Sačuvana su točna podudaranja kontrolnog zbroja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak a mellékelt, módosított készletek szinkronizálásra kerülnek. A pontos ellenőrzőösszeg egyezések megmaradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya disertakan, set yang diubah akan disinkronkan. Kecocokan checksum yang tepat dipertahankan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno sincronizzati solo i set inclusi e modificati. Le corrispondenze esatte di checksum vengono mantenute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "含める対象で変更のあるセットのみが同期されます。チェックサムが完全に一致するものは保持されます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕೇವಲ ಒಳಗೊಂಡಿತ್ತು, ಬದಲಾದ ಸೆಟ್‌ಗಳನ್ನು ಸಿಂಕ್ ಮಾಡಲಾಗುತ್ತದೆ. ನಿಖರವಾದ ಚೆಕ್ಸಮ್ ಹೊಂದಾಣಿಕೆಗಳನ್ನು ಸಂರಕ್ಷಿಸಲಾಗಿದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포함되고 변경된 세트만 동기화됩니다. 체크섬이 정확히 일치하는 스크린샷은 유지됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഉൾപ്പെടുത്തിയിട്ടുള്ള, മാറ്റിയ സെറ്റുകൾ മാത്രം സമന്വയിപ്പിക്കും. കൃത്യമായ ചെക്ക്സം പൊരുത്തങ്ങൾ സംരക്ഷിക്കപ്പെട്ടിരിക്കുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवळ समाविष्ट केलेले, बदललेले संच समक्रमित केले जातील. अचूक चेकसम जुळण्या जतन केल्या जातात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya disertakan, set yang diubah akan disegerakkan. Padanan checksum yang tepat dipelihara."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen inbegrepen, gewijzigde sets worden gesynchroniseerd. Exacte checksum-matches blijven behouden."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare inkluderte, endrede sett vil bli synkronisert. Nøyaktige sjekksum-treff er bevart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko uwzględnione, zmienione zestawy zostaną zsynchronizowane. Zachowane są dokładne dopasowania sum kontrolnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente os conjuntos incluídos e alterados serão sincronizados. Correspondências exatas de soma de verificação são preservadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas os conjuntos alterados incluídos serão sincronizados. As correspondências exatas da soma de verificação são preservadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numai seturile incluse și modificate vor fi sincronizate. Potrivirile exacte ale sumei de control sunt păstrate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будут синхронизированы только включенные измененные наборы. Точные совпадения по контрольной сумме сохраняются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizujú sa iba zahrnuté, zmenené súpravy. Presné zhody kontrolného súčtu sú zachované."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinhronizirani bodo samo vključeni, spremenjeni nizi. Natančna ujemanja kontrolne vsote so ohranjena."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast inkluderade, ändrade uppsättningar synkroniseras. Exakta kontrollsummamatchningar bevaras."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சேர்க்கப்பட்ட, மாற்றப்பட்ட தொகுப்புகள் மட்டுமே ஒத்திசைக்கப்படும். சரியான செக்சம் பொருத்தங்கள் பாதுகாக்கப்படுகின்றன."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "చేర్చబడిన, మార్చబడిన సెట్‌లు మాత్రమే సమకాలీకరించబడతాయి. ఖచ్చితమైన చెక్‌సమ్ సరిపోలికలు భద్రపరచబడ్డాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รวมเฉพาะชุดที่เปลี่ยนแปลงเท่านั้นที่จะถูกซิงค์ การจับคู่เช็คซัมที่ตรงกันทั้งหมดจะยังคงอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca dahil edilen, değişen setler eşzamanlanır. Sağlama toplamı birebir eşleşenler korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронізуються лише включені змінені набори. Точні збіги контрольних сум зберігаються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صرف شامل، تبدیل شدہ سیٹ مطابقت پذیر ہوں گے۔ عین مطابق چیکسم میچز محفوظ ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ bao gồm, các bộ đã thay đổi sẽ được đồng bộ hóa. Các kết quả tổng kiểm tra chính xác được bảo tồn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只会同步已包含且有更改的组。校验和完全一致的截图将保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會同步已納入且已更改的組。總和檢查碼完全相符的項目會被保留。"
          }
        }
      }
    },
    "Only what you see. Shape types switched off in the inspector's **Visibility** section are left out of the exported image too." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط ما تراه. يتم إيقاف تشغيل أنواع الأشكال في قسم **الرؤية** الخاص بالمفتش خارج الصورة المصدرة أيضًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু আপনি কি দেখতে. ইন্সপেক্টরের **ভিজিবিলিটি** বিভাগে সুইচ অফ করা আকৃতির ধরনগুলিও এক্সপোর্ট করা ইমেজ থেকে বাদ পড়ে গেছে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només el que veus. Els tipus de formes desactivats a la secció **Visibilitat** de l'inspector també es deixen fora de la imatge exportada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jen to, co vidíte. Typy tvarů vypnuté v inspektorově sekci **Viditelnost** jsou v exportovaném obrázku také vynechány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun hvad du ser. Formtyper, der er slået fra i inspektørens **Synlighed**-sektion, udelades også af det eksporterede billede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur das, was du siehst. Formtypen, die im Abschnitt **Sichtbarkeit** des Inspektors ausgeschaltet sind, fehlen auch im exportierten Bild."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο αυτό που βλέπετε. Οι τύποι σχήματος που είναι απενεργοποιημένοι στην ενότητα **Ορατότητα** του επιθεωρητή δεν περιλαμβάνονται επίσης στην εξαγόμενη εικόνα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo lo que ves. Los tipos de formas desactivados en la sección **Visibilidad** del inspector también quedan fuera de la imagen exportada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط آنچه می‌بینید. نوع‌های شکلی که در بخش **نمایش** بازرس خاموش شده‌اند، در تصویر صادرشده هم حذف می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain mitä näet. Tarkastajan **Näkyvyys**-osiossa pois päältä kytketyt muototyypit jätetään myös pois viedystä kuvasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement ce que vous voyez. Les types de formes désactivés dans la section **Visibilité** de l'inspecteur sont également exclus de l'image exportée."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ફક્ત તમે જે જુઓ છો. નિરીક્ષકના **દૃશ્યતા** વિભાગમાં બંધ કરેલ આકારના પ્રકારો પણ નિકાસ કરેલી છબીમાંથી બાકાત છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק מה שאתה רואה. סוגי צורות שהושבתו בקטע **נראות** של המפקח נותרים מחוץ לתמונה המיוצאת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल वही जो आप देखते हैं. इंस्पेक्टर के **दृश्यता** अनुभाग में बंद किए गए आकार प्रकार को निर्यात की गई छवि से भी बाहर रखा गया है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo ono što vidite. Vrste oblika isključene u odjeljku **Vidljivost** inspektora također su izostavljene iz izvezene slike."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak amit látsz. Az ellenőr **Láthatóság** részében kikapcsolt alakzattípusok szintén kimaradnak az exportált képből."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya apa yang Anda lihat. Jenis bentuk yang dinonaktifkan di bagian **Visibilitas** inspektur juga tidak disertakan dalam gambar yang diekspor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo ciò che vedi. I tipi di forma disattivati nella sezione **Visibilità** dell'inspector vengono esclusi anche dall'immagine esportata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示されているものだけです。インスペクタの **表示** セクションでオフにした種類の図形は、書き出す画像からも除外されます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ನೋಡುವುದು ಮಾತ್ರ. ಇನ್‌ಸ್ಪೆಕ್ಟರ್‌ನ **ಗೋಚರತೆ** ವಿಭಾಗದಲ್ಲಿ ಸ್ವಿಚ್ ಆಫ್ ಆಗಿರುವ ಆಕಾರ ಪ್ರಕಾರಗಳನ್ನು ರಫ್ತು ಮಾಡಿದ ಚಿತ್ರದಿಂದ ಹೊರಗಿಡಲಾಗಿದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보이는 것만 내보냅니다. 인스펙터의 **표시 여부** 섹션에서 끈 도형 유형은 내보낸 이미지에서도 제외됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾ കാണുന്നത് മാത്രം. ഇൻസ്പെക്ടറുടെ ** ദൃശ്യപരത** വിഭാഗത്തിൽ സ്വിച്ച് ഓഫ് ചെയ്ത ആകാര തരങ്ങൾ എക്‌സ്‌പോർട്ട് ചെയ്‌ത ചിത്രത്തിലും അവശേഷിക്കുന്നില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फक्त तुम्ही जे पाहता. इंस्पेक्टरच्या **दृश्यता** विभागामध्ये बंद केलेले आकार प्रकार देखील निर्यात केलेल्या प्रतिमेतून सोडले जातात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya apa yang anda lihat. Jenis bentuk yang dimatikan dalam bahagian **Keterlihatan** pemeriksa juga ditinggalkan daripada imej yang dieksport."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen wat je ziet. Vormtypen die zijn uitgeschakeld in de sectie **Zichtbaarheid** van de inspecteur, worden ook weggelaten uit de geëxporteerde afbeelding."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare det du ser. Formtyper som er slått av i inspektørens **Synlighet**-seksjon, er også utelatt fra det eksporterte bildet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko to, co widzisz. Typy kształtów wyłączone w sekcji **Widoczność** inspektora również nie są uwzględniane w eksportowanym obrazie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente o que você vê. Os tipos de formas desativados na seção **Visibilidade** do inspetor também são deixados de fora da imagem exportada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente o que você vê. Os tipos de formas desativados na secção **Visibilidade** do inspetor também são deixados de fora da imagem exportada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doar ceea ce vezi. Tipurile de forme dezactivate în secțiunea **Vizibilitate** a inspectorului sunt și ele excluse din imaginea exportată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только то, что вы видите. Типы фигур, выключенные в разделе **Видимость** инспектора, не попадают и в экспортированное изображение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iba to, čo vidíte. Typy tvarov, ktoré sú vypnuté v sekcii **Viditeľnosť** kontrolóra, sú tiež vynechané z exportovaného obrázka."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo tisto, kar vidite. Vrste oblik, izklopljene v inšpektorjevem razdelku **Vidnost**, so prav tako izpuščene iz izvožene slike."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara vad du ser. Formtyper som är avstängda i inspektörens **Synlighet**-sektion utelämnas också i den exporterade bilden."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் பார்ப்பது மட்டுமே. இன்ஸ்பெக்டரின் **தெரிவுத்தன்மை** பிரிவில் அணைக்கப்பட்ட வடிவ வகைகள் ஏற்றுமதி செய்யப்பட்ட படத்திலிருந்தும் வெளியேறும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు చూసేది మాత్రమే. ఇన్‌స్పెక్టర్ యొక్క **విజిబిలిటీ** విభాగంలో స్విచ్ ఆఫ్ చేయబడిన ఆకార రకాలు ఎగుమతి చేయబడిన ఇమేజ్ నుండి కూడా వదిలివేయబడతాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เฉพาะสิ่งที่คุณเห็น ประเภทรูปร่างที่ปิดในส่วน **การมองเห็น** ของผู้ตรวจสอบจะไม่รวมอยู่ในรูปภาพที่ส่งออกเช่นกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca gördüğünüz. Denetçinin **Görünürlük** bölümünde kapatılan şekil türleri dışa aktarılan görüntüye de dahil edilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лише те, що ви бачите. Типи фігур, вимкнені в розділі **Видимість** інспектора, не потрапляють і в експортоване зображення."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صرف وہی جو آپ دیکھتے ہیں۔ انسپکٹر کے **مرئیت** سیکشن میں شکل کی قسمیں بھی برآمد شدہ تصویر سے باہر رہ گئی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ những gì bạn nhìn thấy. Các loại hình dạng bị tắt trong phần **Hiển thị** của thanh tra cũng bị loại khỏi hình ảnh được xuất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所见即所得。在检查器 **可见性** 部分中关闭的形状类型，也不会出现在导出的图像中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所見即所得。在檢閱器的**可見性**區段中關閉的形狀類型，也不會出現在輸出的影像中。"
          }
        }
      }
    },

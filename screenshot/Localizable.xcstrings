        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[%1$lld A/B-variantrad](inflect: true) kommer inte att laddas upp till din produktsida."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

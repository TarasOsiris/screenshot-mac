    "Changes here affect only %@. The base language text is shared across all languages — edits to other languages are stored as overrides." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تؤثر التغييرات هنا على %1$@ فقط. تتم مشاركة نص اللغة الأساسية عبر جميع اللغات، ويتم تخزين التعديلات التي يتم إجراؤها على اللغات الأخرى كتجاوزات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখানে পরিবর্তনগুলি শুধুমাত্র %1$@ কে প্রভাবিত করে৷ বেস ল্যাঙ্গুয়েজ টেক্সট সমস্ত ভাষা জুড়ে শেয়ার করা হয় — অন্যান্য ভাষার সম্পাদনা ওভাররাইড হিসাবে সংরক্ষণ করা হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els canvis aquí només afecten %1$@. El text de l'idioma base es comparteix entre tots els idiomes; les edicions d'altres idiomes s'emmagatzemen com a substitucions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změny zde ovlivní pouze %1$@. Text základního jazyka je sdílen ve všech jazycích – úpravy v jiných jazycích jsou uloženy jako přepsání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ændringer her påvirker kun %1$@. Grundsprogets tekst deles på tværs af alle sprog - redigeringer til andre sprog gemmes som tilsidesættelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen hier betreffen nur %1$@. Der Text in der Basissprache wird von allen Sprachen gemeinsam genutzt – Änderungen an anderen Sprachen werden als Überschreibungen gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αλλαγές εδώ επηρεάζουν μόνο το %1$@. Το κείμενο της βασικής γλώσσας είναι κοινόχρηστο σε όλες τις γλώσσες — οι τροποποιήσεις σε άλλες γλώσσες αποθηκεύονται ως παρακάμψεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios aquí solo afectan a %1$@. El texto del idioma base se comparte en todos los idiomas; las ediciones en otros idiomas se guardan como anulaciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغییرات در اینجا فقط بر %1$@ اثر می‌گذارد. متن زبان پایه بین همهٔ زبان‌ها مشترک است — ویرایش‌های زبان‌های دیگر به‌صورت بازنویسی ذخیره می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muutokset koskevat vain %1$@. Peruskielen teksti on jaettu kaikille kielille – muiden kielten muokkaukset tallennetaan ohituksina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications effectuées ici ne concernent que %1$@. Le texte de la langue de base est commun à toutes les langues : les modifications dans les autres langues sont enregistrées comme des valeurs propres à chaque langue."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અહીં ફેરફારો માત્ર %1$@ ને અસર કરે છે. બેઝ લેંગ્વેજ ટેક્સ્ટ બધી ભાષાઓમાં શેર કરવામાં આવે છે — અન્ય ભાષાઓમાં સંપાદનો ઓવરરાઇડ તરીકે સંગ્રહિત થાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שינויים כאן משפיעים רק על %1$@. טקסט שפת הבסיס משותף לכל השפות - עריכות לשפות אחרות מאוחסנות כעקיפות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहां परिवर्तन केवल %1$@ को प्रभावित करते हैं। मूल भाषा का पाठ सभी भाषाओं में साझा किया जाता है - अन्य भाषाओं के संपादन ओवरराइड के रूप में संग्रहीत किए जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promjene ovdje utječu samo na %1$@. Tekst osnovnog jezika dijeli se na sve jezike — izmjene drugih jezika pohranjuju se kao nadjačavanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az itt végrehajtott változtatások csak az %1$@-ra vonatkoznak. Az alapnyelvi szöveg minden nyelven meg van osztva – a más nyelvekre vonatkozó szerkesztések felülírásként tárolódnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan di sini hanya mempengaruhi %1$@. Teks bahasa dasar dibagikan ke semua bahasa — pengeditan pada bahasa lain disimpan sebagai penggantian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modifiche qui riguardano solo %@. Il testo della lingua di base è condiviso tra tutte le lingue: le modifiche alle altre lingue vengono salvate come personalizzazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここでの変更は %1$@ にのみ適用されます。基本言語のテキストはすべての言語で共有され、ほかの言語での編集は上書きとして保存されます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇಲ್ಲಿ ಬದಲಾವಣೆಗಳು ಕೇವಲ %1$@ ಮೇಲೆ ಪರಿಣಾಮ ಬೀರುತ್ತವೆ. ಮೂಲ ಭಾಷೆಯ ಪಠ್ಯವನ್ನು ಎಲ್ಲಾ ಭಾಷೆಗಳಲ್ಲಿ ಹಂಚಿಕೊಳ್ಳಲಾಗಿದೆ - ಇತರ ಭಾಷೆಗಳಿಗೆ ಸಂಪಾದನೆಗಳನ್ನು ಅತಿಕ್ರಮಣಗಳಾಗಿ ಸಂಗ್ರಹಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기에서 변경한 사항은 %1$@에만 영향을 미칩니다. 기본 언어 텍스트는 모든 언어에서 공유됩니다. 다른 언어에 대한 편집 내용은 재정의로 저장됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇവിടെയുള്ള മാറ്റങ്ങൾ %1$@ മാത്രമേ ബാധിക്കുകയുള്ളൂ. അടിസ്ഥാന ഭാഷാ വാചകം എല്ലാ ഭാഷകളിലും പങ്കിടുന്നു - മറ്റ് ഭാഷകളിലേക്കുള്ള എഡിറ്റുകൾ ഓവർറൈഡുകളായി സംഭരിക്കുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "येथील बदल केवळ %1$@ वर परिणाम करतात. मूळ भाषा मजकूर सर्व भाषांमध्ये सामायिक केला जातो — इतर भाषांमधील संपादने ओव्हरराइड म्हणून संग्रहित केली जातात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan di sini hanya mempengaruhi %1$@. Teks bahasa asas dikongsi merentas semua bahasa — suntingan kepada bahasa lain disimpan sebagai penggantian."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzigingen hier zijn alleen van invloed op %1$@. De tekst in de basistaal wordt door alle talen gedeeld; bewerkingen in andere talen worden als overschrijvingen opgeslagen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endringer her påvirker kun %1$@. Grunnspråkteksten deles på tvers av alle språk – redigeringer til andre språk lagres som overstyringer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiany tutaj dotyczą tylko %1$@. Tekst w języku podstawowym jest wspólny dla wszystkich języków — zmiany w innych językach są przechowywane jako zastąpienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As alterações aqui afetam apenas %1$@. O texto do idioma base é compartilhado entre todos os idiomas — as edições em outros idiomas são armazenadas como substituições."

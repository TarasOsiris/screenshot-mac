    "Quit and reopen Screenshot Bro to switch the interface language." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بإنهاء Screenshot Bro وإعادة فتحه لتبديل لغة الواجهة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইন্টারফেসের ভাষা পরিবর্তন করতে Screenshot Bro প্রস্থান করুন এবং পুনরায় খুলুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surt i torna a obrir Screenshot Bro per canviar l'idioma de la interfície."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukončete a znovu otevřete Screenshot Bro a přepněte jazyk rozhraní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afslut og genåbn Screenshot Bro for at skifte grænsefladesprog."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende Screenshot Bro und öffne die App erneut, um die Sprache der Benutzeroberfläche zu wechseln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κλείστε και ανοίξτε ξανά το Screenshot Bro για να αλλάξετε τη γλώσσα διεπαφής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sal de Screenshot Bro y vuelve a abrirlo para cambiar el idioma de la interfaz."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای تغییر زبان رابط، Screenshot Bro را ببندید و دوباره باز کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lopeta ja avaa Screenshot Bro uudelleen vaihtaaksesi käyttöliittymän kieltä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quittez et rouvrez Screenshot Bro pour changer la langue de l'interface."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "બહાર નીકળો અને ઇન્ટરફેસ ભાષાને સ્વિચ કરવા માટે Screenshot Bro ફરીથી ખોલો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צא ופתח מחדש את Screenshot Bro כדי להחליף את שפת הממשק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरफ़ेस भाषा बदलने के लिए Screenshot Bro को छोड़ें और पुनः खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatvorite i ponovno otvorite Screenshot Bro za promjenu jezika sučelja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lépjen ki, és nyissa meg újra a Screenshot Bro alkalmazást a felület nyelvének váltásához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluar dan buka kembali Screenshot Bro untuk mengganti bahasa antarmuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudi e riapri Screenshot Bro per cambiare la lingua dell'interfaccia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターフェイスの言語を切り替えるには、Screenshot Bro を終了してもう一度開いてください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇಂಟರ್ಫೇಸ್ ಭಾಷೆಯನ್ನು ಬದಲಾಯಿಸಲು Screenshot Bro ತ್ಯಜಿಸಿ ಮತ್ತು ಪುನಃ ತೆರೆಯಿರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터페이스 언어를 변경하려면 Screenshot Bro를 종료했다가 다시 여세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇൻ്റർഫേസ് ഭാഷ മാറാൻ Screenshot Bro പുറത്തുകടന്ന് വീണ്ടും തുറക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरफेस भाषा स्विच करण्यासाठी Screenshot Bro सोडा आणि पुन्हा उघडा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",

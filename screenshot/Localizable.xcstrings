    "%@ was opened in the app while this edit was in progress. Retry it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم فتح %1$@ في التطبيق بينما كان هذا التعديل قيد التقدم. أعد المحاولة."

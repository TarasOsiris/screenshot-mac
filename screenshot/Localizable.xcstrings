    "**Fill** — scales to cover; crops anything that doesn't fit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Füllen** – skaliert, bis die Fläche bedeckt ist, und schneidet ab, was nicht passt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Rellenar**: escala hasta cubrir el área y recorta lo que no cabe."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**پرکردن** — تصویر را بزرگ می‌کند تا کل ناحیه را بپوشاند و هر چه بیرون بماند بریده می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Remplir** : met à l'échelle pour couvrir toute la zone et rogne ce qui dépasse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Riempi**: ridimensiona per coprire tutto e ritaglia ciò che non entra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**カバー** — 全体を覆うように拡大/縮小し、はみ出た部分は切り取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**채우기** — 영역을 덮도록 크기를 조정하고, 넘치는 부분은 잘라냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Preencher** — redimensiona para cobrir tudo; corta o que não couber."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Заполнить** — масштабирует с полным покрытием; все, что не помещается, обрезается."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Doldur** — alanı kaplayacak şekilde ölçekler; sığmayan kısımları kırpar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Заповнити** — масштабує, щоб покрити всю площу; обрізає все, що не вміщається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**填充**——缩放至完全覆盖；超出的部分会被裁剪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**填滿**——縮放以完全覆蓋；超出的部分會被裁切。"
          }
        }
      }
    },
    "**Fit** — scales so the whole image is visible; leaves transparent letterbox bars." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Anpassen** – skaliert so, dass das ganze Bild sichtbar ist; lässt transparente Ränder frei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Ajustar**: escala para que se vea toda la imagen y deja bandas transparentes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**متناسب** — اندازه را طوری تنظیم می‌کند که کل تصویر دیده شود و نوارهای شفاف در کناره‌ها باقی می‌ماند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Ajuster** : met à l'échelle pour que toute l'image soit visible, en laissant des bandes transparentes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Adatta**: ridimensiona in modo che l'immagine sia interamente visibile, lasciando bande trasparenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**フィット** — 画像全体が見えるように拡大/縮小します。余白部分は透明になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**맞춤** — 이미지 전체가 보이도록 크기를 조정하며, 남는 부분은 투명한 레터박스로 둡니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Ajustar** — redimensiona para que a imagem inteira fique visível; deixa faixas transparentes nas bordas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Вписать** — масштабирует так, чтобы изображение было видно целиком; оставляет прозрачные поля."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Sığdır** — görüntünün tamamı görünecek şekilde ölçekler; saydam boşluklar bırakır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Вмістити** — масштабує так, щоб було видно все зображення; залишає прозорі смуги по краях."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**适合**——缩放至完整显示图像；多出的区域保持透明。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**符合**——縮放以顯示整張影像；多出的空間會保持透明。"
          }
        }
      }
    },

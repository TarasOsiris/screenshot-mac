    "Variants are alternative screenshots to A/B test on your App Store product page." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les variants són captures de pantalla alternatives a la prova A/B a la pàgina del vostre producte App Store."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varianter er alternative skærmbilleder til A/B-test på din App Store produktside."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varianten sind alternative Screenshots für A/B-Tests auf deiner App Store-Produktseite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las variantes son capturas alternativas para hacer pruebas A/B en la página de producto del App Store."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخه‌ها اسکرین‌شات‌های جایگزین برای آزمایش A/B در صفحه محصول App Store شما هستند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihtoehdot ovat vaihtoehtoisia kuvakaappauksia A/B-testille App Store tuotesivullasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les variantes sont des captures d’écran alternatives à tester en A/B sur votre page produit de l’App Store."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le varianti sono screenshot alternativi da sottoporre a test A/B nella pagina del prodotto sull'App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バリアントは、App Store のプロダクトページで A/B テストするための別のスクリーンショットです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변형은 App Store 제품 페이지에서 A/B 테스트할 대체 스크린샷입니다."
          }
        },
        "nl" : {

        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "템플릿 제어 막대의 **배경 재정의**는 해당 템플릿에만 행의 기본 배경 대신 적용되는 고유한 배경을 설정합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Achtergrond overschrijven** in de sjabloonbedieningsbalk stelt een unieke achtergrond in die de standaard van de rij vervangt, alleen voor die sjabloon."
          }
        },
        "no" : {
          "stringUnit" : {

    "The properties bar shows font, weight, size, color, horizontal and vertical alignment, line height, and letter spacing." : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra de propietats mostra el tipus de lletra, el pes, la mida, el color, l'alineació horitzontal i vertical, l'alçada de la línia i l'espaiat entre lletres."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egenskabslinjen viser skrifttype, vægt, størrelse, farve, vandret og lodret justering, linjehøjde og bogstavafstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Eigenschaftenleiste werden Schriftart, Stärke, Größe, Farbe, horizontale und vertikale Ausrichtung, Zeilenhöhe und Buchstabenabstand angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra de propiedades muestra la fuente, el peso, el tamaño, el color, la alineación horizontal y vertical, la altura de la línea y el espaciado entre letras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نوار خواص فونت، وزن، اندازه، رنگ، تراز افقی و عمودی، ارتفاع خطوط و فاصله حروف را نشان می دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ominaisuuspalkissa näkyy fontti, paino, koko, väri, vaaka- ja pystytasaus, rivin korkeus ja kirjainten väli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barre de propriétés affiche la police, l'épaisseur, la taille, la couleur, l'alignement horizontal et vertical, la hauteur des lignes et l'espacement des lettres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロパティ バーには、フォント、太さ、サイズ、色、水平方向と垂直方向の配置、行の高さ、文字間隔が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "속성 표시줄에는 글꼴, 두께, 크기, 색상, 가로 및 세로 정렬, 줄 높이, 문자 간격이 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De eigenschappenbalk toont het lettertype, de dikte, de grootte, de kleur, de horizontale en verticale uitlijning, de lijnhoogte en de letterafstand."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egenskapslinjen viser skrifttype, vekt, størrelse, farge, horisontal og vertikal justering, linjehøyde og bokstavavstand."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A barra de propriedades mostra fonte, espessura, tamanho, cor, alinhamento horizontal e vertical, altura da linha e espaçamento entre letras."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A barra de propriedades mostra fonte, espessura, tamanho, cor, alinhamento horizontal e vertical, altura da linha e espaçamento entre letras."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egenskapsfältet visar teckensnitt, vikt, storlek, färg, horisontell och vertikal justering, linjehöjd och bokstavsavstånd."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "属性栏显示字体、粗细、大小、颜色、水平和垂直对齐方式、行高和字母间距。"
          }
        }
      }
    },
    "The purchase was redeemed, but it didn't unlock Pro. Please contact support." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compra es va bescanviar, però no va desbloquejar Pro. Poseu-vos en contacte amb l'assistència."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Købet blev indløst, men det låste ikke Pro op. Kontakt venligst support."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kauf wurde eingelöst, hat Pro aber nicht freigeschaltet. Bitte wende dich an den Support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

    "**Android Phone** and **Android Tablet** — generic frames that flex to match the aspect ratio of any dropped screenshot." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Android Phone** و**Android Tablet** — إطارات عامة مرنة لتتناسب مع نسبة العرض إلى الارتفاع لأي لقطة شاشة تم إسقاطها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Telèfon Android** i **Tauleta Android**: marcs genèrics que es flexionen perquè coincideixin amb la relació d'aspecte de qualsevol captura de pantalla caiguda."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Telefon s Androidem** a **tablet s Androidem** – obecné rámečky, které se ohýbají tak, aby odpovídaly poměru stran jakéhokoli vypadlého snímku obrazovky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Android-telefon** og **Android-tablet** — generiske rammer, der bøjes for at matche billedformatet for ethvert tabt skærmbillede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Android Phone** und **Android Tablet** – generische Rahmen, die sich an das Seitenverhältnis jedes abgelegten Screenshots anpassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Τηλέφωνο Android** και **Tablet Android** — γενικά καρέ που λυγίζουν ώστε να ταιριάζουν με την αναλογία διαστάσεων οποιουδήποτε στιγμιότυπου οθόνης που έχει πέσει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Teléfono Android** y **Tableta Android**: marcos genéricos que se flexionan para igualar la relación de aspecto de cualquier captura de pantalla caída."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**تلفن اندروید** و **تبلت اندروید** - فریم‌های عمومی که منعطف می‌شوند تا با نسبت ابعاد هر عکسی که از صفحه حذف شده مطابقت داشته باشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Android-puhelin** ja **Android-tabletti** – yleiset kehykset, jotka taipuvat vastaamaan minkä tahansa pudonneen kuvakaappauksen kuvasuhdetta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Téléphone Android** et **Tablette Android** : cadres génériques qui s'adaptent au format de toute capture d'écran déposée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Android Phone** ו-**Android Tablet** - מסגרות גנריות שמתגמשות כך שיתאימו ליחס הגובה-רוחב של כל צילום מסך שנשמט."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Android telefon** i **Android tablet** — generički okviri koji se savijaju kako bi odgovarali omjeru slike bilo koje ispuštene snimke zaslona."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Android telefon** és **Android Tablet** – általános keretek, amelyek rugalmasan illeszkednek bármely elejtett képernyőkép képarányához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Ponsel Android** dan **Tablet Android** — bingkai umum yang fleksibel agar sesuai dengan rasio aspek dari setiap tangkapan layar yang diambil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Android Phone** および **Android Tablet** — ドロップされたスクリーンショットのアスペクト比に合わせて柔軟になる汎用フレーム。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Android 휴대폰** 및 **Android 태블릿** — 드롭된 스크린샷의 가로세로 비율에 맞게 조정되는 일반 프레임입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Telefon Android** dan **Tablet Android** — bingkai generik yang melentur untuk memadankan nisbah bidang mana-mana tangkapan skrin yang digugurkan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Android-telefoon** en **Android-tablet**: algemene frames die zich aanpassen aan de beeldverhouding van elk neergezet screenshot."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Android-telefon** og **Android-nettbrett** – generiske rammer som bøyer seg for å matche sideforholdet til et skjermbilde som er tapt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Telefon z Androidem** i **Tablet z Androidem** — ogólne ramki, które wyginają się, aby dopasować się do proporcji każdego upuszczonego zrzutu ekranu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Telefone Android** e **Tablet Android** — quadros genéricos que são flexíveis para corresponder à proporção de qualquer captura de tela perdida."
          }

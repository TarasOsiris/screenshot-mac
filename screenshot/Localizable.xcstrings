          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അപ്‌ലോഡ് ഓരോ സ്‌ക്രീൻഷോട്ടും സ്‌റ്റോറുമായി താരതമ്യപ്പെടുത്തുകയും കൃത്യമായ പൊരുത്തങ്ങളുടെ App Store അസറ്റ് ഐഡികൾ നിലനിർത്തി വ്യത്യാസമുള്ളവ മാത്രം മാറ്റുകയും ചെയ്യുന്നു."
          }

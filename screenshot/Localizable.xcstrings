    "Start from a ready-made layout or a blank project. Templates come pre-sized for each store." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comenceu des d'un disseny ja fet o un projecte en blanc. Les plantilles vénen de mida prèvia per a cada botiga."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start fra et færdigt layout eller et tomt projekt. Skabeloner leveres i præ-størrelse til hver butik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte mit einem fertigen Layout oder einem leeren Projekt. Vorlagen haben bereits die passende Größe für jeden Store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza con un diseño listo para usar o un proyecto en blanco. Las plantillas ya vienen con el tamaño de cada tienda."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از یک چیدمان آماده یا یک پروژهٔ خالی شروع کنید. قالب‌ها از قبل برای هر فروشگاه اندازه‌بندی شده‌اند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aloita valmiista ulkoasusta tai tyhjästä projektista. Mallit ovat valmiiksi mitoitettuja jokaiselle myymälälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partez d'une mise en page prête à l'emploi ou d'un projet vierge. Les modèles sont prédimensionnés pour chaque boutique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parti da un layout già pronto o da un progetto vuoto. I modelli hanno già le dimensioni giuste per ogni store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用意されたレイアウトか空のプロジェクトから始めましょう。テンプレートは各ストアに合わせたサイズになっています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리 만들어진 레이아웃이나 빈 프로젝트에서 시작하세요. 템플릿은 각 스토어에 맞는 크기로 준비되어 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin vanuit een kant-en-klare lay-out of een leeg project. Sjablonen worden voor elke winkel op maat geleverd."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start fra en ferdig layout eller et tomt prosjekt. Maler kommer i forhåndsstørrelse for hver butikk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece com um layout pronto ou um projeto em branco. Os modelos vêm pré-dimensionados para cada loja."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",

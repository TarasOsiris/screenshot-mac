        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılana geri döndürmek için **harf aralığı değerini çift tıklayın**."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Двічі клацніть значення міжлітерного інтервалу**, щоб повернути його до стандартного."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**لیٹر اسپیسنگ ویلیو پر ڈبل کلک کریں** اسے ڈیفالٹ پر واپس لینے کے لیے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Nhấp đúp vào giá trị khoảng cách giữa các chữ cái** để đưa nó về mặc định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**连按两次字符间距数值** 即可将其恢复为默认值。"

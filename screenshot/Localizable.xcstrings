        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Duplica riga**, **Aggiungi nuova riga sopra / sotto**, **Sposta riga su / giù**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**行を複製**、**上/下に新しい行を追加**、**行を上/下に移動**。"
          }
        },
        "ko" : {

    "Delete rows from the row header or row menu. Settings ▸ General has a confirmation toggle." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف صفوف من رأس الصف أو قائمة الصفوف. الإعدادات ▸ عام لديه مفتاح تبديل للتأكيد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সারি হেডার বা সারি মেনু থেকে সারি মুছুন। সেটিংস ▸ সাধারণ একটি নিশ্চিতকরণ টগল আছে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimeix files de la capçalera o del menú de files. Configuració ▸ General té un commutador de confirmació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstraňte řádky ze záhlaví řádku nebo nabídky řádků. Nastavení ▸ Obecné má přepínač pro potvrzení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slet rækker fra rækkeoverskriften eller rækkemenuen. Indstillinger ▸ Generelt har en bekræftelseskontakt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösche Zeilen über die Kopfzeile oder das Menü der Zeile. Unter „Einstellungen ▸ Allgemein“ gibt es einen Schalter für eine Bestätigung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγράψτε σειρές από την κεφαλίδα ή το μενού σειράς. Ρυθμίσεις ▸ Γενικά έχει εναλλαγή επιβεβαίωσης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina filas desde el encabezado o el menú de la fila. Ajustes ▸ General tiene una opción de confirmación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ردیف‌ها را از سرِ ردیف یا منوی ردیف حذف کنید. در تنظیمات ▸ عمومی گزینه‌ای برای تأیید پیش از حذف هست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista rivit riviotsikosta tai rivivalikosta. Asetukset ▸ Yleiset -kohdassa on vahvistuskytkin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimez des lignes depuis l'en-tête de ligne ou le menu de la ligne. Réglages ▸ Général propose une option de confirmation."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "પંક્તિ હેડર અથવા પંક્તિ મેનૂમાંથી પંક્તિઓ કાઢી નાખો. સેટિંગ્સ ▸ સામાન્યમાં પુષ્ટિકરણ ટૉગલ છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחק שורות מכותרת השורה או מתפריט השורה. הגדרות ▸ כללי יש בורר אישור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पंक्ति शीर्षलेख या पंक्ति मेनू से पंक्तियाँ हटाएँ। सेटिंग्स ▸ सामान्य में एक पुष्टिकरण टॉगल है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbrišite retke iz zaglavlja retka ili izbornika retka. Postavke ▸ Općenito ima prekidač za potvrdu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorok törlése a sorfejlécből vagy a sormenüből. Beállítások ▸ Az Általános menüben van egy megerősítő kapcsoló."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus baris dari header baris atau menu baris. Pengaturan ▸ Umum memiliki tombol konfirmasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina le righe dall'intestazione o dal menu della riga. Impostazioni ▸ Generali contiene un'opzione di conferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行は行ヘッダーまたは行メニューから削除します。設定 ▸ 一般 に確認の有無を切り替える設定があります。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಾಲು ಹೆಡರ್ ಅಥವಾ ಸಾಲು ಮೆನುವಿನಿಂದ ಸಾಲುಗಳನ್ನು ಅಳಿಸಿ. ಸೆಟ್ಟಿಂಗ್‌ಗಳು ▸ ಸಾಮಾನ್ಯವು ದೃಢೀಕರಣ ಟಾಗಲ್ ಅನ್ನು ಹೊಂದಿದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "행 헤더 또는 행 메뉴에서 행을 삭제합니다. 설정 ▸ 일반에는 확인 토글이 있습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വരി തലക്കെട്ടിൽ നിന്നോ വരി മെനുവിൽ നിന്നോ വരികൾ ഇല്ലാതാക്കുക. ക്രമീകരണങ്ങൾ ▸ പൊതുവായ ഒരു സ്ഥിരീകരണ ടോഗിൾ ഉണ്ട്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पंक्ती शीर्षलेख किंवा पंक्ती मेनूमधून पंक्ती हटवा. सेटिंग्ज ▸ सामान्यमध्ये पुष्टीकरण टॉगल आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padamkan baris daripada pengepala baris atau menu baris. Tetapan ▸ Umum mempunyai togol pengesahan."

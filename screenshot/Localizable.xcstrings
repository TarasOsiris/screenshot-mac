    "Private key imported. App Store Connect lets you download a .p8 key only once, so keep the original file somewhere safe." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'ha importat la clau privada. App Store Connect et permet baixar una clau .p8 només una vegada, així que guarda el fitxer original en algun lloc segur."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privat nøgle importeret. App Store Connect lader dig kun downloade en .p8 nøgle én gang, så opbevar den originale fil et sikkert sted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privater Schlüssel importiert. App Store Connect lässt dich einen .p8-Schlüssel nur einmal herunterladen – bewahre die Originaldatei also sicher auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clave privada importada. App Store Connect solo permite descargar un archivo .p8 una vez, así que guarda el original en un lugar seguro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلید خصوصی وارد شد. App Store Connect به شما امکان می‌دهد کلید .p8 را فقط یک بار دانلود کنید، بنابراین فایل اصلی را در جایی امن نگه دارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksityinen avain tuotu. App Store Connect antaa sinun ladata .p8-avaimen vain kerran, joten säilytä alkuperäinen tiedosto turvallisessa paikassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clé privée importée. App Store Connect vous permet de télécharger une clé .p8 une seule fois. Conservez donc le fichier d'origine dans un endroit sûr."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiave privata importata. App Store Connect consente di scaricare una chiave .p8 una sola volta, quindi conserva il file originale in un luogo sicuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "秘密キーを読み込みました。App Store Connect では .p8 キーを1回しかダウンロードできないため、元のファイルは安全な場所に保管してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인 키를 가져왔습니다. App Store Connect에서는 .p8 키를 한 번만 다운로드할 수 있으므로 원본 파일을 안전한 곳에 보관하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privésleutel geïmporteerd. Met App Store Connect kunt u een .p8-sleutel slechts één keer downloaden, dus bewaar het originele bestand op een veilige plek."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privat nøkkel importert. App Store Connect lar deg laste ned en .p8-nøkkel bare én gang, så oppbevar originalfilen et trygt sted."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chave privada importada. O App Store Connect só permite baixar uma chave .p8 uma vez, então guarde o arquivo original em um lugar seguro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chave privada importada. App Store Connect permite que você baixe uma chave .p8 apenas uma vez, então mantenha o ficheiro original em um lugar seguro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрытый ключ импортирован. App Store Connect позволяет скачать ключ .p8 только один раз, поэтому храните исходный файл в надежном месте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privat nyckel importerad. App Store Connect låter dig ladda ner en .p8-nyckel endast en gång, så förvara originalfilen någonstans säkert."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel anahtar içe aktarıldı. App Store Connect bir .p8 anahtarını yalnızca bir kez indirmenize izin verir; bu yüzden orijinal dosyayı güvenli bir yerde saklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приватний ключ імпортовано. App Store Connect дозволяє завантажити ключ .p8 лише один раз, тож збережіть оригінальний файл у надійному місці."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已导入私钥。App Store Connect 只允许下载一次 .p8 密钥，因此请将原始文件保存在安全的地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已輸入私密密鑰。App Store Connect 只允許下載一次 .p8 密鑰，因此請將原始檔案存放在安全的地方。"
          }
        }
      }
    },

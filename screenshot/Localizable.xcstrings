          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højreklik på et projekt i vælgeren for at omdøbe, duplikere og slette handlinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie in der Auswahl mit der rechten Maustaste auf ein Projekt, um Aktionen zum Umbenennen, Duplizieren und Löschen durchzuführen."
          }
        },
        "es" : {
          "stringUnit" : {

    "App Store Connect can't take ^[%lld screenshot set](inflect: true) yet. Open Details to see why." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect لا يمكن التقاط ^[%1$lld مجموعة لقطة الشاشة(inflect: true) حتى الآن. افتح التفاصيل لمعرفة السبب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect encara no pot fer la captura de pantalla del ^[%1$lld conjunt](inflect: true). Obriu Detalls per veure per què."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect zatím nemůže pořídit ^[%1$lld sadu snímků obrazovky](inflect: true). Otevřete Podrobnosti a zjistěte proč."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect kan ikke tage ^[%1$lld skærmbilledesæt](inflect: true) endnu. Åbn Detaljer for at se hvorfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect kann ^[%lld Screenshot-Set](inflect: true) noch nicht annehmen. Öffne „Details“, um den Grund zu sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο App Store Connect δεν μπορεί να τραβήξει ακόμα ^[%1$lld σύνολο στιγμιότυπων οθόνης](inflect: true). Ανοίξτε το Details για να δείτε γιατί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect aún no puede aceptar ^[%lld conjunto de capturas](inflect: true). Abre Detalles para ver por qué."
          }
        },
        "fa" : {
          "stringUnit" : {

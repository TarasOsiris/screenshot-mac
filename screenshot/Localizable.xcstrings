        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அவை அனைத்தும் ஒரே மாதிரியாக இருக்கும்போது, அது அந்த வகையான கட்டுப்பாடுகளையும் வழங்குகிறது, மேலும் ஒவ்வொரு வடிவத்திலும் ஒவ்வொரு மாற்றத்தையும் பயன்படுத்துகிறது: **சாதனத்தை மாற்று"

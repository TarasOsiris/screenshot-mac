    "More than one row is %@. A treatment takes one row per screenshot size — move one to another variant or exclude it from App Store Connect." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أكثر من صف واحد هو %1$@. تستغرق المعالجة صفًا واحدًا لكل حجم لقطة شاشة — انقل واحدًا إلى متغير آخر أو استبعده من App Store Connect."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Més d'una fila és %1$@. Un tractament requereix una fila per mida de captura de pantalla: moveu-ne una a una altra variant o excloeu-la de App Store Connect."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Více než jeden řádek je %1$@. Ošetření zabere jeden řádek na velikost snímku obrazovky – přesuňte jeden do jiné varianty nebo jej vylučte z App Store Connect."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mere end én række er %1$@. En behandling tager én række pr. skærmbilledestørrelse – flyt en til en anden variant, eller udelad den fra App Store Connect."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr als eine Zeile verwendet %@. Ein Treatment nimmt eine Zeile pro Screenshot-Größe – verschiebe eine in eine andere Variante oder schließe sie von App Store Connect aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περισσότερες από μία σειρές είναι %1$@. Μια θεραπεία χρειάζεται μία σειρά ανά μέγεθος στιγμιότυπου οθόνης — μετακινήστε τη μία σε άλλη παραλλαγή ή εξαιρέστε την από App Store Connect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay más de una fila %@. Un tratamiento admite una fila por tamaño de captura: mueve una a otra variante o exclúyela de App Store Connect."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بیش از یک ردیف %@ است. هر نسخه آزمایشی برای هر اندازه اسکرین‌شات یک ردیف می‌پذیرد — یکی را به نسخه دیگری منتقل کنید یا آن را از App Store Connect مستثنا کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Useampi kuin yksi rivi on %1$@. Hoito kestää yhden rivin kuvakaappauskokoa kohden – siirrä toinen variantti tai sulje se pois App Store Connect:sta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs lignes sont %@. Un traitement prend une ligne par taille de capture — déplacez-en une vers une autre variante ou excluez-la d’App Store Connect."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יותר משורה אחת היא %1$@. טיפול לוקח שורה אחת בכל גודל צילום מסך - העבר אחד לגרסה אחרת או אל תכלול אותו מ-App Store Connect."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Više od jednog reda je %1$@. Obrada zauzima jedan redak po veličini snimke zaslona — premjestite jedan u drugu varijantu ili ga isključite iz App Store Connect."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egynél több sor: %1$@. Egy kezelés képernyőképméretenként egy sort vesz igénybe – vigye át az egyiket egy másik változatba, vagy zárja ki a App Store Connect közül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebih dari satu baris adalah %1$@. Perlakuan memerlukan satu baris per ukuran tangkapan layar — pindahkan satu baris ke varian lain atau kecualikan dari App Store Connect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più di una riga usa %@. Un trattamento accetta una riga per dimensione di screenshot: spostane una in un'altra variante o escludila da App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数の行が %@ です。トリートメントはスクリーンショットのサイズごとに 1 行のみです。1 行を別のバリアントに移動するか、App Store Connect から除外してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@인 행이 둘 이상입니다. 트리트먼트는 스크린샷 크기마다 한 행만 받습니다. 하나를 다른 변형으로 옮기거나 App Store Connect에서 제외하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebih daripada satu baris ialah %1$@. Rawatan mengambil satu baris setiap saiz tangkapan skrin — alihkan satu ke varian lain atau kecualikannya daripada App Store Connect."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meer dan één rij is %1$@. Een behandeling duurt één rij per schermgrootte. Verplaats er één naar een andere variant of sluit deze uit van App Store Connect."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mer enn én rad er %1$@. En behandling tar én rad per skjermbildestørrelse – flytt en til en annen variant eller ekskluder den fra App Store Connect."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Więcej niż jeden wiersz to %1$@. Leczenie zajmuje jeden wiersz na każdy rozmiar zrzutu ekranu — przenieś go do innego wariantu lub wyklucz go z App Store Connect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais de uma linha usa %@. Um tratamento aceita uma linha por tamanho de captura — mova uma para outra variante ou exclua-a do App Store Connect."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais de uma linha é %1$@. Um tratamento ocupa uma linha por tamanho de captura de ecrã. Mova uma para outra variante ou exclua-a de App Store Connect."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai mult de un rând este %1$@. Un tratament durează un rând pe dimensiunea capturii de ecran — mutați unul în altă variantă sau excludeți-l din App Store Connect."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Несколько строк соответствуют %@. Тестовый вариант принимает одну строку на размер скриншота — переместите одну из них в другой вариант или исключите ее из App Store Connect."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viac ako jeden riadok je %1$@. Spracovanie trvá jeden riadok na veľkosť snímky obrazovky – jeden presuňte na iný variant alebo ho vylúčte z App Store Connect."
          }

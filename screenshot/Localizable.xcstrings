    "Has no %@ row, so this upload doesn't change its %@ screenshots." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No té cap fila %1$@, així que aquesta càrrega no canvia les seves captures de pantalla %2$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har ingen %1$@ række, så denne upload ændrer ikke sine %2$@ skærmbilleder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hat keine %@-Zeile, daher ändert dieser Upload die %@-Screenshots nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tiene fila de %@, así que esta subida no cambia sus capturas de %@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ردیف %@ ندارد، پس این آپلود اسکرین‌شات‌های %@ آن را تغییر نمی‌دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei sisällä %1$@ riviä, joten tämä lataus ei muuta sen %2$@ kuvakaappauksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'a pas de ligne %@ : cet envoi ne modifie pas ses captures %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ha una riga %@, quindi questo caricamento non modifica i suoi screenshot %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の行がないため、このアップロードでは %@ のスクリーンショットは変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 행이 없으므로 이번 업로드로 %@ 스크린샷이 바뀌지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heeft geen rij %1$@, dus deze upload verandert niets aan de %2$@ schermafbeeldingen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har ingen %1$@ rad, så denne opplastingen endrer ikke %2$@ skjermbilder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não tem linha de %@, então este envio não altera as capturas de %@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não tem linha %1$@, então este upload não altera suas capturas de ecrã %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет строки %@, поэтому эта загрузка не изменит его скриншоты %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har ingen %1$@ rad, så den här uppladdningen ändrar inte dess %2$@ skärmdumpar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ satırı yok; bu yüzden bu yükleme %@ ekran görüntülerini değiştirmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не має рядка %@, тож це вивантаження не змінить його знімки екрана %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有 %@ 行，因此本次上传不会更改其 %@ 截图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有 %@ 列，因此此次上傳不會更改其 %@ 螢幕截圖。"
          }
        }
      }
    },

          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บชื่อของสคริปต์ (%1$@) และบันทึกไว้ในโฟลเดอร์ Application Scripts"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",

    "Example: en-US/01_Onboarding%@.%@ — ready for fastlane deliver. One folder per App Store language, numbered across rows." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beispiel: en-US/01_Onboarding%@.%@ – bereit für fastlane deliver. Ein Ordner pro App-Store-Sprache, zeilenübergreifend nummeriert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejemplo: en-US/01_Onboarding%@.%@ — listo para fastlane deliver. Una carpeta por idioma de App Store, con numeración continua entre filas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نمونه: en-US/01_Onboarding%@.%@ — آماده برای fastlane deliver. یک پوشه برای هر زبان App Store، با شماره‌گذاری پیوسته در همه ردیف‌ها."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌘D**는 선택한 행을 복제합니다. **행 복제**도 행 메뉴에 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌘D** duplica a linha selecionada. **Duplicar linha** também está no menu da linha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",

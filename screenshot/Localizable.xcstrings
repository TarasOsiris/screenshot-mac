    "Add screenshots from Photos or Files, then drop in text, shapes, and a device frame." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie Screenshots aus Fotos oder Dateien hinzu und fügen Sie dann Text, Formen und einen Geräterahmen ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade capturas desde Fotos o Archivos y luego inserta texto, formas y un marco de dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عکس‌های صفحه‌نمایش را از Photos یا Files اضافه کنید، سپس متن، شکل‌ها و فریم دستگاه را درج کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des captures d'écran à partir de photos ou de fichiers, puis déposez du texte, des formes et un cadre d'appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi screenshot da Foto o File, poi inserisci testo, forme e una cornice del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真またはファイルからスクリーンショットを追加し、テキスト、図形、デバイス フレームをドロップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 또는 파일에서 스크린샷을 추가한 다음 텍스트, 모양 및 장치 프레임을 추가하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione capturas de tela de Fotos ou Arquivos e insira texto, formas e uma moldura do dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте скриншоты из «Фото» или «Файлов», затем разместите текст, фигуры и рамку устройства."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraflar'dan veya Dosyalar'dan ekran görüntüleri ekleyin, ardından metin, şekil ve bir aygıt çerçevesi yerleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте знімки екрана з Фото або Файлів, а потім розмістіть текст, фігури та рамку пристрою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加照片或文件中的屏幕截图，然后放入文本、形状和设备框架。"

        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încărcarea este organizată ca o **editare** de redare și este confirmată când confirmați. Google Play acceptă cel mult 8 capturi de ecran per tip."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузка готовится как **правка** в Play и фиксируется после вашего подтверждения. Google Play принимает не более 8 скриншотов каждого типа."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odovzdanie sa uskutoční ako **úprava** Play a potvrdí sa. Google Play prijíma maximálne 8 snímok obrazovky na typ."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nalaganje je uprizorjeno kot **urejanje** predvajanja in potrjeno, ko potrdite. Google Play sprejme največ 8 posnetkov zaslona na vrsto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppladdningen arrangeras som en Play **redigering** och genomförs när du bekräftar. Google Play accepterar högst 8 skärmdumpar per typ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การอัปโหลดจะจัดเป็น Play **แก้ไข** และคอมมิตเมื่อคุณยืนยัน Google Play ยอมรับภาพหน้าจอได้สูงสุด 8 ภาพต่อประเภท"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yükleme bir Play **düzenlemesi** olarak hazırlanır ve siz onayladığınızda kaydedilir. Google Play tür başına en fazla 8 ekran görüntüsü kabul eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вивантаження готується як **редагування** в Play і фіксується, коли ви підтверджуєте. Google Play приймає щонайбільше 8 знімків екрана кожного типу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپ لوڈ کو پلے **ترمیم** کے طور پر اسٹیج کیا جاتا ہے اور جب آپ تصدیق کرتے ہیں تو اس کا ارتکاب کیا جاتا ہے۔ Google Play فی قسم زیادہ سے زیادہ 8 اسکرین شاٹس قبول کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá trình tải lên được thực hiện dưới dạng Play **chỉnh sửa** và được cam kết khi bạn xác nhận. Google Play chấp nhận tối đa 8 ảnh chụp màn hình cho mỗi loại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上传会先作为 Play **修改** 暂存，并在你确认后提交。Google Play 每种类型最多接受 8 张截图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上傳會暫存為 Play **編輯**，並在你確認時提交。Google Play 每種類型最多接受 8 張螢幕截圖。"
          }
        }
      }
    },

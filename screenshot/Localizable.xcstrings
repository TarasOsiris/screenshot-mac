    "Both raster and SVG images are supported as backgrounds." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم دعم كل من الصور النقطية وSVG كخلفيات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant les imatges ràster com les SVG s'admeten com a fons."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jako pozadí jsou podporovány rastrové i SVG obrázky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både raster- og SVG-billeder understøttes som baggrunde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Hintergründe werden sowohl Raster- als auch SVG-Bilder unterstützt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τόσο οι εικόνες ράστερ όσο και οι SVG εικόνες υποστηρίζονται ως φόντο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se admiten como fondos tanto imágenes rasterizadas como SVG."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هم تصاویر پیکسلی و هم SVG به‌عنوان پس‌زمینه پشتیبانی می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekä rasteri- että SVG-kuvia tuetaan taustana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images raster et SVG sont prises en charge comme arrière-plans."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גם תמונות רסטר וגם תמונות SVG נתמכות כרקע."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I rasterske i SVG slike podržane su kao pozadine."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A raszteres és a SVG képek egyaránt támogatottak háttérként."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gambar raster dan SVG didukung sebagai latar belakang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come sfondi sono supportate sia immagini raster sia SVG."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景にはラスター画像と SVG 画像のどちらも使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "래스터 이미지와 SVG 이미지가 모두 배경으로 지원됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imej raster dan SVG disokong sebagai latar belakang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zowel raster- als SVG-afbeeldingen worden ondersteund als achtergrond."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både raster- og SVG-bilder støttes som bakgrunn."
          }
        },
        "pl" : {

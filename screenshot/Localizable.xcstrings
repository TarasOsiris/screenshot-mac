    "Recognized screenshot dimensions are used to pick an appropriate device category or frame when possible." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم استخدام أبعاد لقطة الشاشة التي تم التعرف عليها لاختيار فئة الجهاز أو الإطار المناسب عندما يكون ذلك ممكنًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dimensions de la captura de pantalla reconegudes s'utilitzen per triar una categoria de dispositiu o un marc adequats quan és possible."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznané rozměry snímku obrazovky se používají k výběru vhodné kategorie zařízení nebo rámečku, pokud je to možné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anerkendte skærmbillededimensioner bruges til at vælge en passende enhedskategori eller ramme, når det er muligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkannte Screenshot-Abmessungen werden verwendet, um nach Möglichkeit eine geeignete Gerätekategorie oder einen geeigneten Rahmen auszuwählen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αναγνωρισμένες διαστάσεις στιγμιότυπου οθόνης χρησιμοποιούνται για την επιλογή της κατάλληλης κατηγορίας συσκευής ή πλαισίου όταν είναι δυνατόν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando es posible, las dimensiones reconocidas de las capturas sirven para elegir una categoría de dispositivo o un marco adecuados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در صورت امکان، از ابعاد شناخته‌شدهٔ اسکرین‌شات برای انتخاب دسته یا قاب مناسب دستگاه استفاده می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnistettuja kuvakaappausmittoja käytetään sopivan laiteluokan tai kehyksen valitsemiseen, mikäli mahdollista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dimensions de capture d'écran reconnues sont utilisées pour choisir une catégorie d'appareil ou un cadre approprié lorsque cela est possible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מימדים מזוהים של צילום מסך משמשים לבחירת קטגוריית מכשיר או מסגרת מתאימה במידת האפשר."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepoznate dimenzije snimke zaslona koriste se za odabir odgovarajuće kategorije uređaja ili okvira kada je to moguće."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A felismert képernyőkép-méreteket a rendszer a megfelelő eszközkategória vagy keret kiválasztásához használja, ha lehetséges."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimensi tangkapan layar yang dikenali digunakan untuk memilih kategori atau bingkai perangkat yang sesuai jika memungkinkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando possibile, le dimensioni riconosciute degli screenshot vengono usate per scegliere una categoria o una cornice del dispositivo appropriata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットの寸法を認識できた場合は、それをもとに適切なデバイスカテゴリやフレームが選ばれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인식된 스크린샷 크기로 가능한 경우 알맞은 기기 카테고리나 프레임을 선택합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimensi tangkapan skrin yang diiktiraf digunakan untuk memilih kategori peranti atau bingkai yang sesuai apabila boleh."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herkende schermafmetingen worden gebruikt om indien mogelijk een geschikte apparaatcategorie of frame te kiezen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjenkjente skjermbildedimensjoner brukes til å velge en passende enhetskategori eller ramme når det er mulig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznane wymiary zrzutów ekranu służą do wybierania odpowiedniej kategorii urządzenia lub ramki, jeśli to możliwe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando possível, as dimensões reconhecidas da captura de tela são usadas para escolher uma categoria de dispositivo ou moldura adequada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As dimensões de captura de ecrã reconhecidas são usadas para escolher uma categoria de dispositivo ou quadro apropriado, quando possível."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimensiunile recunoscute ale capturii de ecran sunt folosite pentru a alege o categorie de dispozitiv sau un cadru adecvat, atunci când este posibil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По распознанным размерам скриншотов по возможности выбирается подходящая категория или рамка устройства."

    "Project order can be set to **By creation date** or **Alphabetically** in Settings ▸ General." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Projektreihenfolge kann unter Einstellungen ▸ Allgemein auf **Nach Erstellungsdatum** oder **Alphabetisch** eingestellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El orden del proyecto se puede establecer en **Por fecha de creación** o **Alfabéticamente** en Configuración ▸ General."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتیب پروژه را می توان روی **براساس تاریخ ایجاد** یا **بر اساس حروف الفبا** در تنظیمات ▸ عمومی تنظیم کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ordre du projet peut être défini sur **Par date de création** ou **Alphabétiquement** dans Paramètres ▸ Général."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ordine dei progetti può essere impostato su **Per data di creazione** o **Alfabetico** in Impostazioni ▸ Generali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトの順序は、[設定] ▸ [一般] で **作成日順** または **アルファベット順** に設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트 순서는 설정 ▸ 일반에서 **생성 날짜별** 또는 **알파벳순**으로 설정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ordem do projeto pode ser definida como **Por data de criação** ou **Em ordem alfabética** em Configurações ▸ Geral."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порядок проектов можно задать — **По дате создания** или **По алфавиту** — в разделе «Настройки ▸ Основные»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proje sırası Ayarlar ▸ Genel bölümünde **Oluşturma tarihine göre** veya **Alfabetik** olarak ayarlanabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порядок проєктів можна задати як **За датою створення** або **За алфавітом** у розділі «Параметри ▸ Загальні»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目顺序可以在设置 ▸ 常规中设置为 **按创建日期** 或 **按字母顺序**。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "專案順序可在「設定 ▸ 一般」中設為**依建立日期**或**依字母順序**。"
          }
        }
      }
    },

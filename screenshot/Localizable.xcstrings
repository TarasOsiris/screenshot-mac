          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Dışa aktarma klasörü** — Screenshot Bro'nun **⌘E** için yeniden kullandığı klasörü seçin veya temizleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Папка експорту** — вибір або очищення папки, яку Screenshot Bro повторно використовує для **⌘E**."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**导出文件夹**——选择或清除 Screenshot Bro 在按 **⌘E** 时重复使用的文件夹。"

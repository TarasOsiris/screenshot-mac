          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на пустое место холста внутри строки, чтобы выбрать саму строку и открыть настройки строки в инспекторе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satırın kendisini seçmek ve satır düzeyindeki denetçi denetimlerini göstermek için bir satırın içindeki boş tuvale tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацніть порожнє місце полотна в рядку, щоб вибрати сам рядок і показати його параметри в інспекторі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

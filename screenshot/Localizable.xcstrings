          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به Google Play ارسال شد. مرور کنید و از کنسول Play منتشر کنید (تا زمانی که منتشر نکنید، تغییرات فعال نمی‌شوند)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyé à Google Play. Examinez et publiez à partir de la Play Console (les modifications ne seront mises en ligne que lorsque vous les publierez)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

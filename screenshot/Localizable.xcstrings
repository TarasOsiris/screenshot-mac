    "Editor and export must always match exactly. If they don't, please report it as a bug." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يتطابق المحرر والتصدير دائمًا تمامًا. إذا لم يفعلوا ذلك، يرجى الإبلاغ عن ذلك باعتباره خطأ."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'editor i l'exportació sempre han de coincidir exactament. Si no ho fan, si us plau, informeu-ho com a error."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor a export se musí vždy přesně shodovat. Pokud ne, nahlaste to jako chybu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor og eksport skal altid matche nøjagtigt. Hvis de ikke gør det, bedes du rapportere det som en fejl."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor und Export müssen immer exakt übereinstimmen. Ist das nicht der Fall, melde es bitte als Fehler."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το πρόγραμμα επεξεργασίας και η εξαγωγή πρέπει πάντα να ταιριάζουν ακριβώς. Εάν δεν το κάνουν, αναφέρετε το ως σφάλμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El editor y la exportación siempre deben coincidir exactamente. Si no es así, infórmanos del error."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ویرایشگر و خروجی باید همیشه دقیقاً یکسان باشند. اگر نبودند، لطفاً آن را به‌عنوان اشکال گزارش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editorin ja viennin on aina vastattava täsmälleen. Jos he eivät, ilmoita siitä virheenä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'éditeur et l'exportation doivent toujours correspondre exactement. Si ce n'est pas le cas, signalez-le comme un bogue."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "העורך והיצוא חייבים תמיד להתאים בדיוק. אם הם לא עושים זאת, אנא דווח על כך כבאג."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uređivač i izvoz moraju uvijek točno odgovarati. Ako ne, prijavite to kao bug."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerkesztőnek és az exportálásnak mindig pontosan egyeznie kell. Ha nem egyeznek, kérjük, jelentse hibaként."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor dan ekspor harus selalu sama persis. Jika tidak, harap laporkan sebagai bug."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor ed esportazione devono sempre corrispondere esattamente. In caso contrario, segnalalo come bug."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エディタと書き出し結果は常に完全に一致します。一致しない場合はバグとしてご報告ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집기와 내보내기는 항상 정확하게 일치해야 합니다. 그렇지 않은 경우 버그로 신고해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor dan eksport mesti sentiasa sepadan dengan tepat. Jika tidak, sila laporkan ia sebagai pepijat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor en export moeten altijd exact overeenkomen. Als dit niet het geval is, rapporteer dit dan als een bug."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor og eksport må alltid samsvare nøyaktig. Hvis de ikke gjør det, vennligst rapporter det som en feil."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edytor i eksport muszą zawsze dokładnie pasować. Jeśli tak nie jest, zgłoś to jako błąd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O editor e a exportação devem sempre corresponder exatamente. Caso contrário, relate-o como um bug."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O editor e a exportação devem sempre corresponder exatamente. Caso contrário, relate-o como um bug."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editorul și exportul trebuie întotdeauna să se potrivească exact. Dacă nu, vă rugăm să o raportați ca o eroare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Редактор и экспорт всегда должны совпадать в точности. Если это не так, сообщите об ошибке."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor a export sa musia vždy presne zhodovať. Ak nie, nahláste to ako chybu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urejevalnik in izvoz se morata vedno natančno ujemati. Če ne, prosimo, da to prijavite kot napako."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor och export måste alltid matcha exakt. Om de inte gör det, rapportera det som ett fel."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวแก้ไขและการส่งออกจะต้องตรงกันทุกประการเสมอ หากไม่เป็นเช่นนั้น โปรดรายงานว่าเป็นข้อบกพร่อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenleyici ve dışa aktarılan çıktı her zaman birebir aynı olmalıdır. Değilse lütfen bunu bir hata olarak bildirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Редактор і експорт завжди мають точно збігатися. Якщо це не так, повідомте про це як про помилку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایڈیٹر اور ایکسپورٹ ہمیشہ بالکل مماثل ہونا چاہیے۔ اگر وہ ایسا نہیں کرتے ہیں تو براہ کرم اسے بگ کے طور پر رپورٹ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình chỉnh sửa và xuất phải luôn khớp chính xác. Nếu không, vui lòng báo cáo đó là lỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编辑器和导出结果必须始终完全一致。如果不一致，请将其作为错误报告给我们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編輯器和輸出的結果必須始終完全一致。如果不一致，請回報錯誤。"
          }
        }
      }
    },

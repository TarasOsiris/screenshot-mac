    "%lld screenshots must be removed first to stay within Apple's 10-screenshot limit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Screenshots müssen zuerst entfernt werden, um innerhalb der 10-Screenshot-Grenze von Apple zu bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld las capturas de pantalla deben eliminarse primero para permanecer dentro del límite de 10 capturas de pantalla de Apple."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld اسکرین شات ها باید ابتدا حذف شوند تا در محدوده 10 عکس صفحه اپل باقی بمانند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures d'écran %1$lld doivent d'abord être supprimées pour rester dans la limite de 10 captures d'écran d'Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Occorre prima rimuovere %lld screenshot per rispettare il limite di 10 screenshot di Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple の 10 スクリーンショット制限内に収めるためには、%1$lld スクリーンショットを最初に削除する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld 스크린샷은 Apple의 10개 스크린샷 제한을 유지하려면 먼저 제거되어야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As capturas de tela %1$lld devem ser removidas primeiro para permanecer dentro do limite de 10 capturas de tela da Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала нужно удалить скриншоты (%lld), чтобы уложиться в лимит Apple в 10 скриншотов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple'ın 10 ekran görüntüsü sınırında kalmak için önce %lld ekran görüntüsünün kaldırılması gerekiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб не перевищити ліміт Apple у 10 знімків екрана, спершу потрібно вилучити зайві знімки (%lld)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld 屏幕截图必须先删除，才能保持在 Apple 的 10 个屏幕截图限制之内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

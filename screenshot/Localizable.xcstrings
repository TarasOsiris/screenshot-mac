        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 언어에서는 텍스트가 상자에 비해 너무 깁니다. 상자를 키우거나 텍스트를 줄이거나 '맞게 축소'를 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze tekst is te lang voor het vak in deze taal. Vergroot het vak, verkort de tekst of schakel Verkleinen in."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne teksten er for lang for boksen på dette språket. Forstørre boksen, forkort teksten eller slå på Krymp for å passe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este texto é longo demais para a caixa neste idioma. Aumente a caixa, encurte o texto ou ative Reduzir para caber."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este texto é muito longo para sua caixa neste idioma. Aumente a caixa, encurte o texto ou ative Reduzir para caber."

        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌘]** / **⌘[** diller arasında ileri / geri geçiş yapar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",

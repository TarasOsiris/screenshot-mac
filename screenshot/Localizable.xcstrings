          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I puntini sostituiscono il tuo token di accesso: il testo copiato contiene quello reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドットはアクセストークンの代わりに表示されています。コピーされるテキストには実際のトークンが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "점은 액세스 토큰을 가린 것입니다. 복사한 텍스트에는 실제 토큰이 포함됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {

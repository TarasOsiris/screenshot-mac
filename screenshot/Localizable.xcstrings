    "Delete rows from the row header or row menu. Settings ▸ General has a confirmation toggle." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löschen Sie Zeilen aus der Zeilenüberschrift oder dem Zeilenmenü. Einstellungen ▸ Allgemein verfügt über einen Bestätigungsschalter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimine filas del encabezado de fila o del menú de filas. Configuración ▸ General tiene un botón de confirmación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سطرها را از هدر ردیف یا منوی ردیف حذف کنید. تنظیمات ▸ عمومی دارای کلید تأیید است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimez des lignes de l’en-tête de ligne ou du menu de lignes. Paramètres ▸ Général a une bascule de confirmation."
          }
        },
        "ja" : {
          "stringUnit" : {

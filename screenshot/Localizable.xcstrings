    "This app can't save an un-reviewed draft via the API — nothing was uploaded." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta aplicació no pot desar un esborrany sense revisar mitjançant el API; no s'ha penjat res."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne app kan ikke gemme en ikke-gennemgået kladde via API – intet blev uploadet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App kann keinen ungeprüften Entwurf über die API speichern – es wurde nichts hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app no puede guardar un borrador sin revisar mediante la API; no se subió nada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این برنامه نمی‌تواند پیش نویس بازبینی نشده را از طریق API ذخیره کند — چیزی آپلود نشده است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä sovellus ei voi tallentaa tarkistamatonta luonnosta API kautta – mitään ei ladattu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette app ne peut pas enregistrer de brouillon non examiné via l'API : rien n'a été envoyé."
          }
        },

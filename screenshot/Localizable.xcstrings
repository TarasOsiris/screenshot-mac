        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例：en-US/01_Onboarding%@.%@ — fastlane deliver でそのまま使えます。App Store の言語ごとに 1 フォルダ、番号は行をまたいで連番です。"
          }
        },
        "ko" : {
          "stringUnit" : {

    "Imported fonts are bundled with the project so they survive iCloud sync and project transfer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تجميع الخطوط المستوردة مع المشروع حتى تظل قادرة على الصمود في مزامنة iCloud ونقل المشروع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমদানি করা ফন্টগুলি প্রকল্পের সাথে একত্রিত হয় যাতে তারা iCloud সিঙ্ক এবং প্রকল্প স্থানান্তর থেকে বেঁচে থাকে৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els tipus de lletra importats s'agrupen amb el projecte de manera que sobreviuen a la sincronització iCloud i a la transferència del projecte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importovaná písma jsou součástí projektu, takže vydrží synchronizaci iCloud a přenos projektu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importerede skrifttyper er bundtet med projektet, så de overlever iCloud synkronisering og projektoverførsel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importierte Schriften werden im Projekt mitgespeichert und bleiben so bei iCloud-Synchronisierung und Projektweitergabe erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι εισαγόμενες γραμματοσειρές ομαδοποιούνται με το έργο, ώστε να επιβιώνουν από τον συγχρονισμό iCloud και τη μεταφορά του έργου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fuentes importadas se guardan con el proyecto, así que se conservan al sincronizar con iCloud y al transferir el proyecto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فونت‌های واردشده درون پروژه نگه داشته می‌شوند تا در همگام‌سازی iCloud و انتقال پروژه از دست نروند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",

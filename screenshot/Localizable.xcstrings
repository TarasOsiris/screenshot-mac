    "Drag templates left/right to reorder. Reordering also reorders the exported file numbering." : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrossegueu les plantilles cap a l'esquerra/dreta per reordenar. La reordenació també reordena la numeració dels fitxers exportats."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk skabeloner til venstre/højre for at omarrangere. Genarrangering ændrer også den eksporterede filnummerering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen Sie die Vorlagen nach links/rechts, um sie neu anzuordnen. Durch die Neuordnung wird auch die Nummerierung der exportierten Dateien neu angeordnet."

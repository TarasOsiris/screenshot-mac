          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solte vários SVGs de uma vez e eles se separarão ligeiramente em cascata em vez de se empilharem em um só lugar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solte vários SVGs de uma vez e eles se separarão ligeiramente em cascata em vez de se empilharem em um só lugar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aruncă mai multe SVG-uri deodată și se depărtează ușor în cascadă în loc să se stivuească într-un singur loc."

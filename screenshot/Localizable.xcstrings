          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o seletor de projetos na barra de ferramentas para alternar entre projetos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для перехода между проектами используйте меню проектов на панели инструментов."
          }
        },
        "sv" : {
          "stringUnit" : {

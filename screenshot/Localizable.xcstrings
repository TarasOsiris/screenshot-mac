    "Use demo mode to walk through the App Store Connect upload feature without an API key — for example during App Review." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze den Demomodus, um die Upload-Funktion für App Store Connect ohne API-Schlüssel durchzuspielen – zum Beispiel während App Review."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el modo de demostración para probar la subida a App Store Connect sin una clave de API; por ejemplo, durante App Review."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با حالت نمایشی می‌توانید قابلیت آپلود App Store Connect را بدون کلید API مرور کنید — مثلاً هنگام App Review."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le mode démo pour parcourir la fonction d'envoi vers App Store Connect sans clé API — par exemple pendant l'App Review."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la modalità demo per provare la funzione di caricamento su App Store Connect senza una chiave API, ad esempio durante l'App Review."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デモモードでは、API キーがなくても App Store Connect へのアップロード機能を一通り試せます（App Review の審査中など）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데모 모드를 사용하면 API 키 없이 App Store Connect 업로드 기능을 살펴볼 수 있습니다(예: 앱 심사 중)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o modo de demonstração para conhecer o recurso de envio ao App Store Connect sem chave de API — por exemplo, durante o App Review."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте демо-режим, чтобы опробовать загрузку в App Store Connect без ключа API — например, во время App Review."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect yükleme özelliğini API anahtarı olmadan denemek için demo modunu kullanın — örneğin App Review sırasında."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скористайтеся демо-режимом, щоб пройти функцію вивантаження в App Store Connect без ключа API — наприклад, під час App Review."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用演示模式，即可在没有 API 密钥的情况下体验 App Store Connect 上传功能——例如在 App 审核期间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用示範模式，即可在沒有 API 密鑰的情況下體驗 App Store Connect 上傳功能——例如在 App 審查期間。"
          }
        }
      }
    },
    "Use demo mode to walk through the Google Play upload feature without a service account." : {
      "localizations" : {

          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als de app niet is geopend of als u deze opnieuw hebt geïnstalleerd, gebruikt u **Webaankoop activeren…** en plakt u de activeringslink uit uw ontvangst-e-mail."

        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام کشیدن **⌥** را نگه دارید تا شکل در حین جابه‌جایی تکثیر شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä **⌥** painettuna vetäessäsi monistaaksesi muodon liikkuessasi."
          }

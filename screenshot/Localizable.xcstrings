    "Double-click a **device** or **image** shape to open the picker and swap its picture." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelklicke auf eine **Geräte**- oder **Bild**form, um die Auswahl zu öffnen und das Bild auszutauschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz doble clic en una forma de **dispositivo** o de **imagen** para abrir el selector y cambiar su imagen."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روی یک شکل **دستگاه** یا **تصویر** دوبار کلیک کنید تا انتخابگر باز شود و تصویر آن عوض شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-cliquez sur une forme **appareil** ou **image** pour ouvrir le sélecteur et échanger son image."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai doppio clic su una forma **dispositivo** o **immagine** per aprire il selettore e sostituirne l'immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**デバイス** または **画像** の図形をダブルクリックするとピッカーが開き、画像を差し替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**기기** 또는 **이미지** 도형을 두 번 클릭하면 선택기가 열려 이미지를 바꿀 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique duas vezes em uma forma de **dispositivo** ou **imagem** para abrir o seletor e trocar sua imagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дважды нажмите фигуру **устройства** или **изображения**, чтобы открыть окно выбора и заменить картинку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçiciyi açıp resmini değiştirmek için bir **aygıt** veya **görüntü** şeklini çift tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двічі клацніть фігуру **пристрою** або **зображення**, щоб відкрити засіб вибору й замінити картинку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连按两次 **设备** 或 **图像** 形状，即可打开选择器并更换其图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

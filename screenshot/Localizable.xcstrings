    "The properties bar shows font, weight, size, color, horizontal and vertical alignment, line height, and letter spacing." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض شريط الخصائص الخط والوزن والحجم واللون والمحاذاة الأفقية والرأسية وارتفاع الخط وتباعد الأحرف."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra de propietats mostra el tipus de lletra, el pes, la mida, el color, l'alineació horitzontal i vertical, l'alçada de la línia i l'espaiat entre lletres."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panel vlastností zobrazuje písmo, tloušťku, velikost, barvu, vodorovné a svislé zarovnání, výšku řádku a mezery mezi písmeny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egenskabslinjen viser skrifttype, vægt, størrelse, farve, vandret og lodret justering, linjehøjde og bogstavafstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Eigenschaftenleiste werden Schriftart, Stärke, Größe, Farbe, horizontale und vertikale Ausrichtung, Zeilenhöhe und Buchstabenabstand angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η γραμμή ιδιοτήτων εμφανίζει γραμματοσειρά, βάρος, μέγεθος, χρώμα, οριζόντια και κατακόρυφη στοίχιση, ύψος γραμμής και απόσταση γραμμάτων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra de propiedades muestra la fuente, el peso, el tamaño, el color, la alineación horizontal y vertical, la altura de la línea y el espaciado entre letras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نوار خواص فونت، وزن، اندازه، رنگ، تراز افقی و عمودی، ارتفاع خطوط و فاصله حروف را نشان می دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ominaisuuspalkissa näkyy fontti, paino, koko, väri, vaaka- ja pystytasaus, rivin korkeus ja kirjainten väli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barre de propriétés affiche la police, l'épaisseur, la taille, la couleur, l'alignement horizontal et vertical, la hauteur des lignes et l'espacement des lettres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סרגל המאפיינים מציג גופן, משקל, גודל, צבע, יישור אופקי ואנכי, גובה שורות ומרווח אותיות."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traka svojstava prikazuje font, težinu, veličinu, boju, vodoravno i okomito poravnanje, visinu retka i razmak između slova."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tulajdonságsáv a betűtípust, a súlyt, a méretet, a színt, a vízszintes és függőleges igazítást, a sormagasságot és a betűközt mutatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilah properti menunjukkan font, berat, ukuran, warna, perataan horizontal dan vertikal, tinggi garis, dan spasi huruf."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロパティ バーには、フォント、太さ、サイズ、色、水平方向と垂直方向の配置、行の高さ、文字間隔が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "속성 표시줄에는 글꼴, 두께, 크기, 색상, 가로 및 세로 정렬, 줄 높이, 문자 간격이 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",

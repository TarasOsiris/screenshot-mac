    "Saved as a draft — not sent for review. Send for review from the Play Console when ready." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الحفظ كمسودة — ولم يتم إرسالها للمراجعة. أرسل للمراجعة من Play Console عندما تكون جاهزًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "খসড়া হিসাবে সংরক্ষিত — পর্যালোচনার জন্য পাঠানো হয়নি। প্রস্তুত হলে Play Console থেকে পর্যালোচনার জন্য পাঠান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'ha desat com a esborrany; no s'ha enviat a revisió. Quan estiguis a punt, envia'l per revisar-lo des de Play Console."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uloženo jako koncept – neodesláno k recenzi. Až budete připraveni, odešlete ke kontrole z Play Console."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemt som en kladde – ikke sendt til gennemgang. Send til gennemgang fra Play Console, når du er klar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Entwurf gespeichert – nicht zur Prüfung gesendet. Sende ihn in der Play Console zur Prüfung, wenn du so weit bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύτηκε ως πρόχειρο — δεν στάλθηκε για έλεγχο. Αποστολή για έλεγχο από το Play Console όταν είναι έτοιμο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado como borrador, sin enviar a revisión. Envíalo a revisión desde Play Console cuando quieras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به‌صورت پیش‌نویس ذخیره شد — برای بازبینی ارسال نشد. هر وقت آماده بودید، از Play Console برای بازبینی ارسال کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennettu luonnoksena – ei lähetetty tarkistettavaksi. Lähetä tarkastettavaksi Play Consolesta, kun olet valmis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré en tant que brouillon – non envoyé pour examen. Envoyez-le pour examen depuis la Play Console lorsque vous êtes prêt."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ડ્રાફ્ટ તરીકે સાચવેલ — સમીક્ષા માટે મોકલેલ નથી. જ્યારે તૈયાર હોય ત્યારે Play કન્સોલમાંથી સમીક્ષા માટે મોકલો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נשמר כטיוטה - לא נשלח לבדיקה. שלח לבדיקה מ-Play Console כשתהיה מוכן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ड्राफ्ट के रूप में सहेजा गया - समीक्षा के लिए नहीं भेजा गया। तैयार होने पर प्ले कंसोल से समीक्षा के लिए भेजें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremljeno kao nacrt — nije poslano na pregled. Pošaljite na pregled s Play konzole kada budete spremni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piszkozatként mentve – nem küldték el felülvizsgálatra. Ha készen áll, küldje el felülvizsgálatra a Play Console-ból."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disimpan sebagai draf — tidak dikirim untuk ditinjau. Kirim untuk ditinjau dari Konsol Play jika sudah siap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvato come bozza, non inviato per la revisione. Invialo per la revisione dalla Play Console quando sei pronto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下書きとして保存しました（審査には送信されていません）。準備ができたら Play Console から審査に送信してください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಡ್ರಾಫ್ಟ್ ಆಗಿ ಉಳಿಸಲಾಗಿದೆ - ಪರಿಶೀಲನೆಗೆ ಕಳುಹಿಸಲಾಗಿಲ್ಲ. ಸಿದ್ಧವಾದಾಗ Play ಕನ್ಸೋಲ್‌ನಿಂದ ವಿಮರ್ಶೆಗಾಗಿ ಕಳುಹಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초안으로 저장되었으며 검토를 위해 전송되지 않았습니다. 준비가 되면 Play Console에서 검토를 위해 전송하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരു ഡ്രാഫ്റ്റായി സംരക്ഷിച്ചു - അവലോകനത്തിനായി അയച്ചിട്ടില്ല. തയ്യാറാകുമ്പോൾ Play കൺസോളിൽ നിന്ന് അവലോകനത്തിനായി അയയ്ക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मसुदा म्हणून जतन केले — पुनरावलोकनासाठी पाठवले नाही. तयार झाल्यावर Play Console वरून पुनरावलोकनासाठी पाठवा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disimpan sebagai draf — tidak dihantar untuk semakan. Hantar untuk semakan daripada Play Console apabila sedia."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opgeslagen als concept, niet ter beoordeling verzonden. Verzend ter beoordeling vanuit de Play Console wanneer u klaar bent."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagret som et utkast – ikke sendt til vurdering. Send til vurdering fra Play-konsollen når du er klar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisano jako wersję roboczą — nie wysłano do recenzji. Gdy wszystko będzie gotowe, wyślij do sprawdzenia w Konsoli Play."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo como rascunho — não enviado para revisão. Envie para revisão pelo Play Console quando quiser."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado como rascunho — não enviado para revisão. Envie para análise no Play Console quando estiver pronto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvat ca schiță — nu a fost trimis pentru examinare. Trimiteți pentru examinare din Play Console când sunteți gata."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранено как черновик — не отправлено на проверку. Отправьте на проверку из Play Console, когда будете готовы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložené ako koncept – neodoslané na kontrolu. Po dokončení odošlite na kontrolu zo služby Play Console."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shranjeno kot osnutek — ni poslano v pregled. Pošljite v pregled iz Play Console, ko ste pripravljeni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparad som ett utkast – skickas inte för granskning. Skicka för granskning från Play Console när du är klar."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வரைவாக சேமிக்கப்பட்டது - மதிப்பாய்வுக்கு அனுப்பப்படவில்லை. தயாரானதும் Play Console இலிருந்து மதிப்பாய்வுக்கு அனுப்பவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "డ్రాఫ్ట్‌గా సేవ్ చేయబడింది — సమీక్ష కోసం పంపబడలేదు. సిద్ధంగా ఉన్నప్పుడు Play కన్సోల్ నుండి సమీక్ష కోసం పంపండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกเป็นฉบับร่าง — ไม่ได้ส่งเพื่อตรวจสอบ ส่งเข้ารับการตรวจสอบจาก Play Console เมื่อพร้อม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taslak olarak kaydedildi — incelemeye gönderilmedi. Hazır olduğunuzda Play Console'dan incelemeye gönderin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережено як чернетку — на перевірку не надіслано. Надішліть на перевірку з Play Console, коли будете готові."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسودہ کے طور پر محفوظ کیا گیا — جائزہ کے لیے نہیں بھیجا گیا۔ تیار ہونے پر Play Console سے جائزہ کے لیے بھیجیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã lưu dưới dạng bản nháp — chưa được gửi để xem xét. Gửi để Play Console xem xét khi sẵn sàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存为草稿——未送交审核。准备就绪后，请从 Play 管理中心送交审核。"

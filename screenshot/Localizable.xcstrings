    "“%@” can't take new screenshots now." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع \"%1$@\" التقاط لقطات شاشة جديدة الآن."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" no pot fer captures de pantalla noves ara."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ nyní nemůže pořizovat nové snímky obrazovky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" kan ikke tage nye skærmbilleder nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann gerade keine neuen Screenshots aufnehmen."
          }
        },
        "el" : {

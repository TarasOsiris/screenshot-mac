    "**Revert to Base Language…** — drops all overrides for the current language, falling back to base text everywhere." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**الرجوع إلى اللغة الأساسية...** — يُسقط جميع التجاوزات للغة الحالية، ويعود إلى النص الأساسي في كل مكان."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Retorn a l'idioma base...**: elimina totes les substitucions de l'idioma actual i torna al text base a tot arreu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Vrátit se na základní jazyk…** – zruší všechna přepsání aktuálního jazyka a všude se vrátí k základnímu textu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Vend tilbage til basissprog...** — fjerner alle tilsidesættelser for det aktuelle sprog og falder tilbage til basistekst overalt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

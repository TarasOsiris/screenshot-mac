        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outra sincronização de captura de ecrã já está em execução. Espere que termine ou cancele primeiro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O altă sincronizare a capturii de ecran rulează deja. Așteptați să se termine sau anulați-l mai întâi."

    "Subscriptions are managed through your Apple ID; cancellations happen via System Settings ▸ Apple ID ▸ Subscriptions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnements werden über Ihre Apple-ID verwaltet; Stornierungen erfolgen über System Settings ▸ Apple ID ▸ Abonnements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones se gestionan a través de su ID de Apple; las cancelaciones se realizan a través de System Settings ▸ ID de Apple ▸ Suscripciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشتراک ها از طریق Apple ID شما مدیریت می شوند. لغوها از طریق System Settings ▸ Apple ID ▸ اشتراک ها انجام می شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements sont gérés via votre identifiant Apple ; les annulations se produisent via System Settings ▸ Identifiant Apple ▸ Abonnements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli abbonamenti sono gestiti tramite il tuo Apple ID; per annullarli vai in Impostazioni di Sistema ▸ Apple ID ▸ Abbonamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションは Apple ID を通じて管理されます。キャンセルは System Settings ▸ Apple ID ▸ サブスクリプション経由で行われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독은 Apple ID를 통해 관리됩니다. 취소는 System Settings ▸ Apple ID ▸ 구독을 통해 발생합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As assinaturas são gerenciadas através do seu ID Apple; os cancelamentos acontecem via System Settings ▸ Apple ID ▸ Assinaturas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписки управляются через ваш Аккаунт Apple; отменить подписку можно в разделе «Системные настройки ▸ Аккаунт Apple ▸ Подписки»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonelikler Apple Hesabınız üzerinden yönetilir; iptaller Sistem Ayarları ▸ Apple Hesabı ▸ Abonelikler bölümünden yapılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підписками керують через ваш Apple ID; скасувати підписку можна в розділі «Системні параметри ▸ Apple ID ▸ Підписки»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅通过您的 Apple ID 进行管理；通过 System Settings ▸ Apple ID ▸ 订阅取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訂閱透過你的 Apple 帳號管理；可在「系統設定」▸ Apple 帳號 ▸ 訂閱項目中取消。"
          }
        }
      }
    },

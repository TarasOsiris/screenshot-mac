          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menu Exporter ▸ **Exporter les lignes ▸ Afficher** pour l'ensemble du projet, ou un menu de ligne ▸ **Exporter la ligne ▸ Afficher** pour une ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menu di esportazione ▸ **Esporta righe ▸ Vetrina** per l'intero progetto, oppure menu di una riga ▸ **Esporta riga ▸ Vetrina** per una sola riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクト全体の場合は [エクスポート] メニュー ▸ **[行のエクスポート] ▸ [ショーケース]**、1 行の場合は行メニュー ▸ **[行のエクスポート] ▸ [ショーケース]**。"

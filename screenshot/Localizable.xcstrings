    "Export all screenshots at once as PNG or JPEG, ready to upload to App Store Connect or Google Play." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportiere alle Screenshots auf einmal als PNG oder JPEG, bereit zum Hochladen in App Store Connect oder Google Play."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta todas las capturas a la vez en PNG o JPEG, listas para subir a App Store Connect o Google Play."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همه اسکرین‌شات‌ها را یک‌باره به‌عنوان PNG یا JPEG صادر کنید، آماده آپلود در App Store Connect یا Google Play."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportez toutes les captures d'écran en une fois au format PNG ou JPEG, prêtes à être envoyées vers App Store Connect ou Google Play."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esporta tutti gli screenshot insieme come PNG o JPEG, pronti per il caricamento su App Store Connect o Google Play."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのスクリーンショットを PNG または JPEG で一度に書き出し、そのまま App Store Connect や Google Play にアップロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 스크린샷을 PNG 또는 JPEG로 한 번에 내보내고 App Store Connect 또는 Google Play에 업로드할 준비를 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporte todas as capturas de tela de uma vez em PNG ou JPEG, prontas para enviar ao App Store Connect ou ao Google Play."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспортируйте все скриншоты сразу в PNG или JPEG — они готовы к загрузке в App Store Connect или Google Play."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm ekran görüntülerini PNG veya JPEG olarak tek seferde dışa aktarın; App Store Connect'e veya Google Play'e yüklemeye hazır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Експортуйте всі знімки екрана одразу у форматі PNG або JPEG, готові до вивантаження в App Store Connect чи Google Play."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次性将所有截图导出为 PNG 或 JPEG，可直接上传到 App Store Connect 或 Google Play。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次將所有螢幕截圖輸出為 PNG 或 JPEG，隨時可上傳至 App Store Connect 或 Google Play。"
          }

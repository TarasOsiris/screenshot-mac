    "Concrete frames with portrait and landscape variants switch to the matching orientation when Screenshot Bro can infer it from a dropped screenshot." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتحول الإطارات الملموسة ذات المتغيرات الرأسية والأفقية إلى الاتجاه المطابق عندما يتمكن Screenshot Bro من استنتاجه من لقطة الشاشة المسقطة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els marcs concrets amb variants vertical i horitzontal canvien a l'orientació coincident quan Screenshot Bro pot inferir-ho a partir d'una captura de pantalla deixada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betonové rámy s variantami na výšku a na šířku se přepnou na odpovídající orientaci, když to Screenshot Bro dokáže odvodit z vypuštěného snímku obrazovky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betonrammer med stående og liggende varianter skifter til den matchende orientering, når Screenshot Bro kan udlede det fra et tabt skærmbillede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkrete Gerätemodelle mit Hoch- und Querformatvarianten wechseln in die passende Ausrichtung, wenn Screenshot Bro sie aus einem abgelegten Screenshot ableiten kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα συγκεκριμένα πλαίσια με παραλλαγές κατακόρυφου και οριζόντιου προσανατολισμού αλλάζουν στον αντίστοιχο προσανατολισμό όταν ο Screenshot Bro μπορεί να το συμπεράνει από ένα στιγμιότυπο οθόνης που έχει πέσει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los marcos reales con variantes vertical y horizontal cambian a la orientación adecuada cuando Screenshot Bro puede deducirla de una captura soltada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قاب‌های واقعی که گونهٔ عمودی و افقی دارند، وقتی Screenshot Bro بتواند جهت را از اسکرین‌شات رهاشده تشخیص دهد، به جهت متناظر تغییر می‌کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konkreettiset kehykset pysty- ja vaakaversioilla siirtyvät vastaavaan suuntaan, kun Screenshot Bro voi päätellä sen pudonneesta kuvakaappauksesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cadres réels disposant de variantes portrait et paysage passent à l'orientation correspondante lorsque Screenshot Bro peut la déduire d'une capture d'écran déposée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסגרות בטון עם גרסאות לאורך ולרוחב עוברות לכיוון התואם כאשר Screenshot Bro יכול להסיק זאת מצילום מסך שנשמט."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betonski okviri s varijantama portreta i pejzaža prebacuju se na odgovarajuću orijentaciju kada Screenshot Bro to može zaključiti iz ispuštene snimke zaslona."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az álló és fekvő változatokkal rendelkező betonkeretek átváltanak a megfelelő tájolásra, amikor a Screenshot Bro erre következtet egy eldobott képernyőképből."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bingkai konkret dengan varian potret dan lanskap beralih ke orientasi yang cocok ketika Screenshot Bro dapat menyimpulkannya dari tangkapan layar yang dilepas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cornici reali con varianti verticale e orizzontale passano all'orientamento corrispondente quando Screenshot Bro riesce a dedurlo da uno screenshot rilasciato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "縦向きと横向きのバリエーションがある実機フレームは、ドロップしたスクリーンショットから Screenshot Bro が向きを推測できる場合、その向きに自動で切り替わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세로/가로 변형이 있는 실제 기기 프레임은 Screenshot Bro가 드롭한 스크린샷에서 방향을 추론할 수 있으면 그 방향으로 전환됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bingkai konkrit dengan varian potret dan landskap bertukar kepada orientasi padanan apabila Screenshot Bro boleh membuat kesimpulan daripada tangkapan skrin yang digugurkan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betonnen frames met staande en liggende varianten schakelen over naar de overeenkomende richting wanneer Screenshot Bro dit kan afleiden uit een neergezette schermafbeelding."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betongrammer med stående og liggende varianter bytter til den samsvarende retningen når Screenshot Bro kan utlede det fra et skjermbilde som er slettet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ramy betonowe w wariantach pionowych i poziomych przełączają się na pasującą orientację, gdy Screenshot Bro może wywnioskować to z upuszczonego zrzutu ekranu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molduras reais com variantes de retrato e paisagem mudam para a orientação correspondente quando o Screenshot Bro consegue deduzi-la de uma captura de tela solta nelas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molduras de concreto com variantes de retrato e paisagem mudam para a orientação correspondente quando Screenshot Bro pode inferir isso a partir de uma captura de ecrã descartada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadrele concrete cu variante portret și peisaj trec la orientarea potrivită atunci când Screenshot Bro o poate deduce dintr-o captură de ecran aruncată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конкретные рамки с книжным и альбомным вариантами переключаются на подходящую ориентацию, если Screenshot Bro может определить ее по перетащенному скриншоту."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betónové rámy s variantmi na výšku a na šírku sa prepnú na zodpovedajúcu orientáciu, keď to Screenshot Bro dokáže odvodiť zo spustenej snímky obrazovky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betonski okvirji s pokončnimi in ležečimi različicami se preklopijo na ustrezno usmerjenost, ko lahko Screenshot Bro to sklepa iz izpuščenega posnetka zaslona."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betongramar med stående och liggande varianter växlar till matchande orientering när Screenshot Bro kan sluta sig till det från en tappad skärmdump."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กรอบคอนกรีตที่มีรูปแบบแนวตั้งและแนวนอนจะเปลี่ยนไปใช้การวางแนวที่ตรงกันเมื่อ Screenshot Bro สามารถอนุมานได้จากภาพหน้าจอที่ตกหล่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikey ve yatay çeşitleri olan somut çerçeveler, Screenshot Bro bırakılan ekran görüntüsünden yönü çıkarabildiğinde uygun yöne geçer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конкретні рамки з книжковим і альбомним варіантами перемикаються на відповідну орієнтацію, коли Screenshot Bro може визначити її з перетягнутого знімка екрана."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پورٹریٹ اور زمین کی تزئین کی مختلف حالتوں کے ساتھ کنکریٹ کے فریم مماثل واقفیت پر سوئچ کرتے ہیں جب Screenshot Bro اسے گرائے گئے اسکرین شاٹ سے اندازہ لگا سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khung cụ thể với các biến thể dọc và ngang chuyển sang hướng phù hợp khi Screenshot Bro có thể suy ra hướng đó từ ảnh chụp màn hình bị rơi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于同时有纵向和横向款式的具体边框，如果 Screenshot Bro 能从拖入的截图推断出方向，就会切换到相应的方向。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有直式和橫式款式的實體外框，在 Screenshot Bro 能從拖放的螢幕截圖推斷方向時，會切換為相符的方向。"
          }
        }
      }
    },

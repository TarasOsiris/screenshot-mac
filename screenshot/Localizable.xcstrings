        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez du texte, des images, des appareils et des formes à partir d'ici. Ils apparaîtront sur la ligne sélectionnée."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અહીંથી ટેક્સ્ટ, છબીઓ, ઉપકરણો અને આકારો ઉમેરો. તેઓ પસંદ કરેલ પંક્તિ પર દેખાશે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסף טקסט, תמונות, מכשירים וצורות מכאן. הם יופיעו בשורה שנבחרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहां से टेक्स्ट, चित्र, डिवाइस और आकार जोड़ें। वे चयनित पंक्ति पर दिखाई देंगे."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odavde dodajte tekst, slike, uređaje i oblike. Oni će se pojaviti u odabranom retku."

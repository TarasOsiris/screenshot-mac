    "%@ was opened in the app while this edit was in progress. Retry it." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ es va obrir a l'aplicació mentre aquesta edició estava en curs. Torna-ho a provar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ blev åbnet i appen, mens denne redigering var i gang. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde in der App geöffnet, während diese Bearbeitung lief. Versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proyecto «%@» se abrió en la app mientras se realizaba esta edición. Vuelve a intentarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در حالی که این ویرایش در حال انجام بود، %1$@ در برنامه باز شد. دوباره آن را امتحان کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",

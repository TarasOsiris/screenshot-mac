          "stringUnit" : {
            "state" : "translated",
            "value" : "Play 每种语言只保留一组截图——请只保留其中一种，关闭其余语言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play 每種語言只保留一組螢幕截圖——請只保留其中一種，關閉其餘語言。"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play برای هر زبان فقط یک مجموعه اسکرین‌شات نگه می‌دارد — همه را به‌جز یکی خاموش کنید."
          }
        }
      }
    },
    "This row uploads to the same Play listing slot as %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {

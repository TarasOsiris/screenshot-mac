    "Version %@ is %@ — metadata can't be changed. Pick an editable version or create a new one in App Store Connect." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإصدار %1$@ هو %2$@ — لا يمكن تغيير البيانات التعريفية. اختر نسخة قابلة للتحرير أو أنشئ نسخة جديدة في App Store Connect."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংস্করণ %1$@ হল %2$@ — মেটাডেটা পরিবর্তন করা যাবে না। একটি সম্পাদনাযোগ্য সংস্করণ চয়ন করুন বা App Store Connect এ একটি নতুন তৈরি করুন৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versió %1$@ és %2$@: les metadades no es poden canviar. Trieu una versió editable o creeu-ne una de nova a App Store Connect."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verze %1$@ je %2$@ – metadata nelze změnit. Vyberte upravitelnou verzi nebo vytvořte novou v App Store Connect."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %1$@ er %2$@ — metadata kan ikke ændres. Vælg en redigerbar version, eller opret en ny i App Store Connect."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %1$@ ist %2$@ – Metadaten können nicht geändert werden. Wähle eine bearbeitbare Version oder erstelle eine neue in App Store Connect."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η έκδοση %1$@ είναι %2$@ — τα μεταδεδομένα δεν μπορούν να αλλάξουν. Επιλέξτε μια επεξεργάσιμη έκδοση ή δημιουργήστε μια νέα στο App Store Connect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versión %1$@ está en estado %2$@: los metadatos no se pueden cambiar. Elige una versión editable o crea una nueva en App Store Connect."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخهٔ %1$@ در وضعیت %2$@ است — فراداده قابل تغییر نیست. یک نسخهٔ قابل ویرایش انتخاب کنید یا در App Store Connect نسخهٔ جدیدی ایجاد کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versio %1$@ on %2$@ — metatietoja ei voi muuttaa. Valitse muokattava versio tai luo uusi kohdassa App Store Connect."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version %1$@ est à l'état « %2$@ » — ses métadonnées ne peuvent pas être modifiées. Choisissez une version modifiable ou créez-en une dans App Store Connect."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સંસ્કરણ %1$@ %2$@ છે — મેટાડેટા બદલી શકાતા નથી. સંપાદનયોગ્ય સંસ્કરણ પસંદ કરો અથવા App Store Connect માં નવું બનાવો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרסה %1$@ היא %2$@ - לא ניתן לשנות מטא נתונים. בחר גרסה הניתנת לעריכה או צור גרסה חדשה ב-App Store Connect."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संस्करण %1$@ %2$@ है — मेटाडेटा बदला नहीं जा सकता। एक संपादन योग्य संस्करण चुनें या App Store Connect में एक नया बनाएं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzija %1$@ je %2$@ — metapodaci se ne mogu mijenjati. Odaberite verziju koju je moguće uređivati ​​ili izradite novu u App Store Connect."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az %1$@ verzió %2$@ – a metaadatok nem módosíthatók. Válasszon egy szerkeszthető verziót, vagy hozzon létre egy újat a App Store Connect alatt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versi %1$@ adalah %2$@ — metadata tidak dapat diubah. Pilih versi yang dapat diedit atau buat versi baru di App Store Connect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versione %@ è nello stato %@: i metadati non possono essere modificati. Scegli una versione modificabile o creane una nuova in App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バージョン %1$@ は %2$@ です。メタデータは変更できません。編集可能なバージョンを選択するか、App Store Connect で新しいバージョンを作成してください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ಆವೃತ್ತಿಯು %2$@ ಆಗಿದೆ — ಮೆಟಾಡೇಟಾವನ್ನು ಬದಲಾಯಿಸಲಾಗುವುದಿಲ್ಲ. ಸಂಪಾದಿಸಬಹುದಾದ ಆವೃತ್ತಿಯನ್ನು ಆರಿಸಿ ಅಥವಾ App Store Connect ನಲ್ಲಿ ಹೊಸದನ್ನು ರಚಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버전 %1$@은(는) %2$@ 상태이므로 메타데이터를 변경할 수 없습니다. 편집 가능한 버전을 선택하거나 App Store Connect에서 새 버전을 만드세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പതിപ്പ് %1$@ %2$@ ആണ് — മെറ്റാഡാറ്റ മാറ്റാൻ കഴിയില്ല. എഡിറ്റ് ചെയ്യാവുന്ന ഒരു പതിപ്പ് തിരഞ്ഞെടുക്കുക അല്ലെങ്കിൽ App Store Connect എന്നതിൽ പുതിയൊരെണ്ണം സൃഷ്‌ടിക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आवृत्ती %1$@ %2$@ आहे — मेटाडेटा बदलला जाऊ शकत नाही. संपादन करण्यायोग्य आवृत्ती निवडा किंवा App Store Connect मध्ये नवीन तयार करा."

        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não tem linha %1$@, então este upload não altera suas capturas de ecrã %2$@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu are niciun rând %1$@, așa că această încărcare nu modifică capturile de ecran %2$@ ale acesteia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",

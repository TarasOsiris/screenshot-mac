    "Drop several SVGs at once and they cascade slightly apart instead of stacking on one spot." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بإسقاط عدة SVG مرة واحدة وستتباعد قليلاً بدلاً من تكديسها في مكان واحد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একযোগে বেশ কয়েকটি SVG সেকেন্ড ড্রপ করুন এবং তারা একটি জায়গায় স্ট্যাক করার পরিবর্তে কিছুটা আলাদা হয়ে যায়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixeu caure diversos SVGs alhora i es separen lleugerament en cascada en lloc d'apilar-se en un sol lloc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypusťte několik SVGs najednou a oni se místo toho, aby se skládali na jednom místě, mírně od sebe oddělí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slip flere SVGs på én gang, og de falder lidt fra hinanden i stedet for at stables på ét sted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legst du mehrere SVGs gleichzeitig ab, werden sie leicht versetzt angeordnet statt übereinander gestapelt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρίξτε πολλά SVGs ταυτόχρονα και διαχωρίζονται ελαφρώς αντί να στοιβάζονται σε ένα σημείο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sueltas varios SVG a la vez, se colocan en cascada ligeramente separados en lugar de apilarse en el mismo punto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر چند SVG را هم‌زمان رها کنید، به‌جای روی هم افتادن در یک نقطه، کمی با فاصله از هم قرار می‌گیرند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pudota useita SVGs kerralla, niin ne putoavat hieman toisistaan sen sijaan, että pinoutuisivat yhteen paikkaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déposez plusieurs SVG à la fois : ils se disposent en cascade, légèrement décalés, au lieu de s'empiler au même endroit."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એકસાથે અનેક SVGસેકંડ છોડો અને તેઓ એક સ્થાન પર સ્ટેક કરવાને બદલે સહેજ અલગ પડે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זרוק כמה SVGים בבת אחת והן מתפרקות מעט במקום להיערם במקום אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक साथ कई SVG गिराएं और वे एक ही स्थान पर ढेर होने के बजाय थोड़ा अलग हो जाएं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ispustite nekoliko SVGs odjednom i oni će se malo razdvojiti umjesto naslagati na jednom mjestu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hagyj le egyszerre több SVG-ot, és ahelyett, hogy egy helyen halmozódnának fel, kissé eltávolodnak egymástól."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatuhkan beberapa SVG sekaligus dan mereka mengalir sedikit terpisah, bukannya menumpuk di satu tempat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se rilasci più SVG contemporaneamente, vengono disposti a cascata leggermente distanziati invece di sovrapporsi nello stesso punto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数の SVG をまとめてドロップすると、1か所に重ならず、少しずつずらして配置されます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಹಲವಾರು SVGಗಳನ್ನು ಏಕಕಾಲದಲ್ಲಿ ಡ್ರಾಪ್ ಮಾಡಿ ಮತ್ತು ಅವು ಒಂದೇ ಸ್ಥಳದಲ್ಲಿ ಪೇರಿಸುವ ಬದಲು ಸ್ವಲ್ಪ ದೂರದಲ್ಲಿ ಬೀಳುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SVG 여러 개를 한 번에 드롭하면 한 지점에 겹치지 않고 약간씩 떨어져 계단식으로 배치됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരേസമയം നിരവധി SVG ഡ്രോപ്പ് ചെയ്യുക, അവ ഒരിടത്ത് അടുക്കുന്നതിന് പകരം ചെറുതായി അകലുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एकाच वेळी अनेक SVG ड्रॉप करा आणि ते एका जागेवर स्टॅक करण्याऐवजी थोडेसे वेगळे होतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatuhkan beberapa SVGs sekali gus dan ia melata sedikit daripada bertindan di satu tempat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat meerdere SVGs tegelijk vallen en ze lopen iets uit elkaar in plaats van op één plek te stapelen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slipp flere SVGer på en gang, og de faller litt fra hverandre i stedet for å stables på ett sted."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",

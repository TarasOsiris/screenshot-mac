        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De cachade granskade byten för %1$@ har ändrats eller är otillgängliga. Uppdatera innan synkronisering."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@க்கான தேக்கக மதிப்பாய்வு செய்யப்பட்ட பைட்டுகள் மாற்றப்பட்டன அல்லது கிடைக்கவில்லை. ஒத்திசைக்கும் முன் புதுப்பிக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ కోసం కాష్ చేయబడిన సమీక్షించబడిన బైట్‌లు మార్చబడ్డాయి లేదా అందుబాటులో లేవు. సమకాలీకరించే ముందు రిఫ్రెష్ చేయండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไบต์ที่ตรวจสอบที่แคชไว้สำหรับ %1$@ มีการเปลี่ยนแปลงหรือไม่พร้อมใช้งาน รีเฟรชก่อนที่จะซิงค์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ için önbelleğe alınmış incelenmiş veriler değişti veya kullanılamıyor. Eşzamanlamadan önce yenileyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кешовані перевірені дані для %@ змінилися або недоступні. Оновіть перед синхронізацією."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ کے لیے کیش شدہ نظرثانی شدہ بائٹس کو تبدیل کر دیا گیا ہے یا وہ دستیاب نہیں ہیں۔ مطابقت پذیری سے پہلے ریفریش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các byte được đánh giá được lưu trong bộ nhớ đệm cho %1$@ đã thay đổi hoặc không khả dụng. Làm mới trước khi đồng bộ hóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已检查的缓存数据已更改或不可用。请在同步前刷新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已檢查的快取資料已更改或無法使用。請在同步前重新整理。"
          }
        }
      }
    },

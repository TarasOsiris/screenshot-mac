    },
    "App Store Connect does not allow %@ (%@) for this app version/localization. This usually means the selected app version does not support that device family, such as uploading iPad screenshots for an iPhone-only app, or App Store Connect does not accept this display type for the selected platform." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect erlaubt %@ (%@) für diese App-Version/Lokalisierung nicht. Dies bedeutet normalerweise, dass die ausgewählte App-Version diese Gerätefamilie nicht unterstützt, z. B. das Hochladen von iPad-Screenshots für eine nur iPhone-App, oder dass App Store Connect diesen Anzeigetyp für die ausgewählte Plattform nicht akzeptiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect no permite %1$@ (%2$@) para esta versión/idioma. Normalmente significa que la versión seleccionada no admite esa familia de dispositivos, por ejemplo subir capturas de iPad a una app solo para iPhone, o que App Store Connect no acepta este tipo de pantalla para la plataforma elegida."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect %1$@ ([FMT_1]]) را برای این نسخه/محلی‌سازی برنامه اجازه نمی‌دهد. این معمولاً به این معنی است که نسخه برنامه انتخاب‌شده آن خانواده دستگاه را پشتیبانی نمی‌کند، مانند آپلود عکس‌های صفحه iPad برای یک برنامه فقط iPhone، یا App Store Connect این نوع نمایش را برای پلتفرم انتخاب‌شده قبول نمی‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect n'autorise pas %@ (%@) pour cette version/localisation de cette application. Cela signifie généralement que la version de l'application sélectionnée ne prend pas en charge cette famille d'appareils, par exemple en téléchargeant des captures d'écran de iPad pour une application réservée à iPhone, ou que App Store Connect n'accepte pas ce type d'affichage pour la plate-forme sélectionnée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect では、このアプリのバージョン/ローカリゼーションに対して %@ (%@) が許可されていません。これは通常、選択したアプリのバージョンがそのデバイス ファミリをサポートしていないこと (iPhone 専用アプリの iPad スクリーンショットのアップロードなど)、または App Store Connect が選択したプラットフォームでこの表示タイプを受け入れないことを意味します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect는 이 앱 버전/현지화에 대해 %@(%@)을 허용하지 않습니다. 이는 일반적으로 선택한 앱 버전이 해당 기기 제품군을 지원하지 않음을 의미합니다. 예를 들어 iPhone 전용 앱에 대한 iPad 스크린샷을 업로드하거나 App Store Connect이(가) 선택한 플랫폼에 대해 이 표시 유형을 허용하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect não permite %@ (%@) para esta versão/localização do aplicativo. Isso geralmente significa que a versão do aplicativo selecionada não é compatível com essa família de dispositivos, como o upload de capturas de tela de iPad para um aplicativo somente iPhone ou App Store Connect não aceita esse tipo de exibição para a plataforma selecionada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect 不允许 %@ (%@) 用于此应用版本/本地化。这通常意味着所选应用版本不支持该设备系列，例如上传仅 iPhone 应用的 iPad 屏幕截图，或者 App Store Connect 不接受所选平台的此显示类型。"
          }
        }
      }
    },
    "App Store Connect does not allow %@ for %@. This usually means the app version doesn't support that device family. Exclude this row, choose a display type the app accepts, or update the app's device support, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect erlaubt %1$@ nicht für %2$@. Meist unterstützt die App-Version diese Gerätefamilie nicht. Schließe diese Zeile aus, wähle einen Anzeigetyp, den die App akzeptiert, oder erweitere die Geräteunterstützung der App und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App Store Connect does not allow %1$@ for %2$@. This usually means the app version doesn't support that device family. Exclude this row, choose a display type the app accepts, or update the app's device support, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect no permite %1$@ para %2$@. Normalmente significa que la versión de la app no es compatible con esa familia de dispositivos. Excluye esta fila, elige un tipo de pantalla que la app acepte o actualiza los dispositivos compatibles de la app y vuelve a intentarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect %1$@ را برای %2$@ مجاز نمی‌داند. این معمولاً به این معنی است که نسخه برنامه از آن خانواده دستگاه پشتیبانی نمی‌کند. این ردیف را حذف کنید، نوع نمایشی را انتخاب کنید که برنامه می‌پذیرد، یا پشتیبانی دستگاه برنامه را به‌روزرسانی کنید، سپس دوباره امتحان کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect n'autorise pas %1$@ pour %2$@. Cela signifie généralement que la version de l'application ne prend pas en charge cette famille d'appareils. Excluez cette ligne, choisissez un type d'affichage accepté par l'application ou mettez à jour la prise en charge des appareils de l'application, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect non consente %@ per %@. Di solito significa che la versione dell'app non supporta quella famiglia di dispositivi. Escludi questa riga, scegli un tipo di display accettato dall'app o aggiorna i dispositivi supportati dall'app, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect では %2$@ に対して %1$@ を許可していません。これは通常、アプリのバージョンがそのデバイス ファミリをサポートしていないことを意味します。この行を除外し、アプリが受け入れる表示タイプを選択するか、アプリのデバイス サポートを更新してから、再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect는 %2$@에 대해 %1$@을(를) 허용하지 않습니다. 이는 일반적으로 앱 버전이 해당 기기 제품군을 지원하지 않는다는 뜻입니다. 이 행을 제외하거나, 앱에서 허용하는 디스플레이 유형을 선택하거나, 앱의 기기 지원을 업데이트한 후 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O App Store Connect não permite %1$@ para %2$@. Isso geralmente significa que a versão do aplicativo não é compatível com essa família de dispositivos. Exclua esta linha, escolha um tipo de exibição que o aplicativo aceite ou atualize os dispositivos compatíveis do aplicativo e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect не допускает %@ для %@. Обычно это значит, что версия приложения не поддерживает это семейство устройств. Исключите эту строку, выберите тип дисплея, который принимает приложение, или обновите список поддерживаемых устройств, затем повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect, %2$@ için %1$@ ekran türüne izin vermiyor. Bu genellikle uygulama sürümünün o aygıt ailesini desteklemediği anlamına gelir. Bu satırı hariç tutun, uygulamanın kabul ettiği bir ekran türü seçin ya da uygulamanın aygıt desteğini güncelleyin ve tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect не дозволяє %@ для %@. Зазвичай це означає, що версія програми не підтримує цю родину пристроїв. Виключіть цей рядок, виберіть тип дисплея, який приймає програма, або оновіть підтримку пристроїв програми, а потім повторіть спробу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect 不允许在 %2$@ 中使用 %1$@。这通常表示该 App 版本不支持此设备系列。请排除此行、选择 App 接受的显示类型，或更新 App 的设备支持，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect 不允許在 %2$@ 使用 %1$@。這通常表示該 App 版本不支援此裝置類型。請排除此列、選擇 App 接受的顯示類型，或更新 App 的裝置支援，然後再試一次。"
          }
        }
      }
    },
    "App Store Connect is rate limiting this account. Wait a few minutes, then run the sync again — screenshot sets that already finished will be skipped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect drosselt gerade die Anfragen dieses Kontos. Warte ein paar Minuten und starte die Synchronisierung dann erneut – bereits abgeschlossene Screenshot-Sets werden übersprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect está limitando la frecuencia de solicitudes de esta cuenta. Espera unos minutos y vuelve a ejecutar la sincronización; se omitirán los conjuntos de capturas que ya hayan terminado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect تعداد درخواست‌های این حساب را محدود کرده است. چند دقیقه صبر کنید، سپس همگام‌سازی را دوباره اجرا کنید — مجموعه‌های اسکرین‌شاتی که قبلاً کامل شده‌اند رد می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect limite le nombre de requêtes de ce compte. Attendez quelques minutes, puis relancez la synchronisation : les ensembles de captures d'écran déjà terminés seront ignorés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect sta limitando le richieste di questo account. Attendi qualche minuto, poi esegui di nuovo la sincronizzazione: i set di screenshot già completati verranno saltati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect がこのアカウントのリクエストを制限しています。数分待ってから、もう一度同期を実行してください。完了済みのスクリーンショットセットはスキップされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect가 이 계정의 요청 속도를 제한하고 있습니다. 몇 분 정도 기다린 후 동기화를 다시 실행하세요. 이미 완료된 스크린샷 세트는 건너뜁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O App Store Connect está limitando as solicitações desta conta. Aguarde alguns minutos e execute a sincronização de novo — os conjuntos de capturas de tela já concluídos serão ignorados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect ограничивает частоту запросов для этой учетной записи. Подождите несколько минут и запустите синхронизацию снова — уже завершенные наборы скриншотов будут пропущены."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect bu hesabın isteklerini sınırlıyor. Birkaç dakika bekleyip eşzamanlamayı yeniden çalıştırın — tamamlanmış ekran görüntüsü setleri atlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect обмежує частоту запитів для цього облікового запису. Зачекайте кілька хвилин і запустіть синхронізацію знову — уже завершені набори знімків екрана буде пропущено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect 正在限制此账户的请求频率。请等待几分钟，然后再次运行同步——已完成的截图组将被跳过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect 正在限制此帳號的請求頻率。請等待幾分鐘後再次執行同步——已完成的螢幕截圖組會被略過。"
          }
        }
      }
    },
    "App Store Connect rejected the request because the API key is not authorized for this app or action. Check that the key has access to this app and enough App Store Connect permissions to edit app metadata." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect hat die Anfrage abgelehnt, da der Schlüssel API für diese App oder Aktion nicht autorisiert ist. Überprüfen Sie, ob der Schlüssel Zugriff auf diese App und über ausreichende App Store Connect-Berechtigungen zum Bearbeiten von App-Metadaten verfügt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect rechazó la solicitud porque la clave de API no está autorizada para esta app o acción. Comprueba que la clave tenga acceso a esta app y permisos suficientes en App Store Connect para editar los metadatos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect درخواست را رد کرد زیرا کلید API برای این برنامه یا عملکرد مجاز نیست. بررسی کنید که کلید به این برنامه دسترسی داشته باشد و به اندازه کافی App Store Connect مجوز برای ویرایش فراداده برنامه داشته باشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect a rejeté la demande, car la clé API n'est pas autorisée pour cette application ou cette action. Vérifiez que la clé a accès à cette application et dispose de suffisamment d'autorisations App Store Connect pour modifier les métadonnées de l'application."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API キーがこのアプリまたはアクションに対して承認されていないため、App Store Connect はリクエストを拒否しました。キーにこのアプリへのアクセス権と、アプリのメタデータを編集するための十分な App Store Connect 権限があることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect은(는) API 키가 이 앱 또는 작업에 대해 승인되지 않았기 때문에 요청을 거부했습니다. 키에 이 앱에 대한 액세스 권한이 있고 앱 메타데이터를 편집할 수 있는 충분한 App Store Connect 권한이 있는지 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect rejeitou a solicitação porque a chave API não está autorizada para este aplicativo ou ação. Verifique se a chave tem acesso a este aplicativo e permissões App Store Connect suficientes para editar os metadados do aplicativo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect 拒绝了请求，因为 API 密钥未获得此应用或操作的授权。检查该密钥是否有权访问此应用程序以及是否有足够的 App Store Connect 权限来编辑应用程序元数据。"
          }
        }
      }
    },

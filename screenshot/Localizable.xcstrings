    "Add screenshots from Photos or Files, then drop in text, shapes, and a device frame." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بإضافة لقطات شاشة من الصور أو الملفات، ثم قم بإسقاط النص والأشكال وإطار الجهاز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফটো বা ফাইল থেকে স্ক্রিনশট যোগ করুন, তারপরে পাঠ্য, আকার এবং একটি ডিভাইস ফ্রেমে ড্রপ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegiu captures de pantalla de Fotos o Fitxers i, a continuació, introduïu text, formes i un marc del dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte snímky obrazovky z fotografií nebo souborů a poté vložte text, tvary a rámeček zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj skærmbilleder fra Fotos eller Filer, og indsæt derefter tekst, figurer og en enhedsramme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Screenshots aus Fotos oder Dateien hinzu und ergänze dann Text, Formen und einen Geräterahmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε στιγμιότυπα οθόνης από Φωτογραφίες ή Αρχεία και, στη συνέχεια, προσθέστε κείμενο, σχήματα και ένα πλαίσιο συσκευής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade capturas desde Fotos o Archivos y luego inserta texto, formas y un marco de dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسکرین‌شات‌ها را از Photos یا Files اضافه کنید، سپس متن، شکل و قاب دستگاه بگذارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää kuvakaappauksia Kuvat- tai Tiedostot-apista ja lisää sitten tekstiä, muotoja ja laitekehys."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des captures d'écran depuis Photos ou Fichiers, puis ajoutez du texte, des formes et un cadre d'appareil."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ફોટા અથવા ફાઇલોમાંથી સ્ક્રીનશૉટ્સ ઉમેરો, પછી ટેક્સ્ટ, આકારો અને ઉપકરણ ફ્રેમમાં મૂકો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסף צילומי מסך מתמונות או מקבצים, ולאחר מכן הוסף טקסט, צורות ומסגרת של מכשיר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोटो या फ़ाइलों से स्क्रीनशॉट जोड़ें, फिर टेक्स्ट, आकार और एक डिवाइस फ़्रेम डालें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte snimke zaslona iz fotografija ili datoteka, zatim ubacite tekst, oblike i okvir uređaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjon hozzá képernyőképeket a Fényképek vagy Fájlok alkalmazásból, majd dobjon be szöveget, alakzatokat és egy eszközkeretet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan tangkapan layar dari Foto atau File, lalu masukkan teks, bentuk, dan bingkai perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi screenshot da Foto o File, poi inserisci testo, forme e una cornice del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真またはファイルからスクリーンショットを追加し、テキスト、図形、デバイスフレームを配置します。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಫೋಟೋಗಳು ಅಥವಾ ಫೈಲ್‌ಗಳಿಂದ ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ಗಳನ್ನು ಸೇರಿಸಿ, ನಂತರ ಪಠ್ಯ, ಆಕಾರಗಳು ಮತ್ತು ಸಾಧನ ಫ್ರೇಮ್‌ನಲ್ಲಿ ಬಿಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 또는 파일에서 스크린샷을 추가한 다음 텍스트, 도형, 기기 프레임을 넣으세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഫോട്ടോകളിൽ നിന്നോ ഫയലുകളിൽ നിന്നോ സ്‌ക്രീൻഷോട്ടുകൾ ചേർക്കുക, തുടർന്ന് ടെക്‌സ്‌റ്റ്, ആകാരങ്ങൾ, ഉപകരണ ഫ്രെയിം എന്നിവയിൽ ഇടുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फोटो किंवा फाइल्समधून स्क्रीनशॉट जोडा, नंतर मजकूर, आकार आणि डिव्हाइस फ्रेममध्ये ड्रॉप करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan tangkapan skrin daripada Foto atau Fail, kemudian masukkan teks, bentuk dan bingkai peranti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg schermafbeeldingen toe uit Foto's of Bestanden en voeg vervolgens tekst, vormen en een apparaatframe toe."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til skjermbilder fra Bilder eller filer, og slipp deretter inn tekst, former og en enhetsramme."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj zrzuty ekranu ze Zdjęć lub Plików, a następnie upuść tekst, kształty i ramkę urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione capturas de tela de Fotos ou Arquivos e insira texto, formas e uma moldura do dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione capturas de ecrã de Fotos ou Ficheiros e insira texto, formas e uma moldura do dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adăugați capturi de ecran din Fotografii sau Fișiere, apoi introduceți text, forme și un cadru pentru dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте скриншоты из «Фото» или «Файлов», затем разместите текст, фигуры и рамку устройства."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridajte snímky obrazovky z fotografií alebo súborov a potom vložte text, tvary a rám zariadenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte posnetke zaslona iz fotografij ali datotek, nato spustite besedilo, oblike in okvir naprave."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till skärmdumpar från foton eller filer och släpp sedan in text, former och en enhetsram."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "புகைப்படங்கள் அல்லது கோப்புகளில் இருந்து ஸ்கிரீன் ஷாட்களைச் சேர்க்கவும், பின்னர் உரை, வடிவங்கள் மற்றும் சாதன சட்டத்தில் கைவிடவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఫోటోలు లేదా ఫైల్‌ల నుండి స్క్రీన్‌షాట్‌లను జోడించి, ఆపై వచనం, ఆకారాలు మరియు పరికర ఫ్రేమ్‌లో వదలండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มภาพหน้าจอจากรูปภาพหรือไฟล์ จากนั้นวางข้อความ รูปร่าง และกรอบอุปกรณ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraflar'dan veya Dosyalar'dan ekran görüntüleri ekleyin, ardından metin, şekil ve bir aygıt çerçevesi yerleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте знімки екрана з Фото або Файлів, а потім розмістіть текст, фігури та рамку пристрою."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصاویر یا فائلوں سے اسکرین شاٹس شامل کریں، پھر متن، شکلیں، اور ڈیوائس کے فریم میں ڈراپ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm ảnh chụp màn hình từ Ảnh hoặc Tệp, sau đó thả văn bản, hình dạng và khung thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从“照片”或“文件”添加截图，然后放入文本、形状和设备边框。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從「照片」或「檔案」加入螢幕截圖，然後放入文字、形狀和裝置外框。"
          }
        }
      }

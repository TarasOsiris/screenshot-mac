    "Click empty canvas inside a row to select the row itself and reveal row-level inspector controls." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf eine leere Stelle der Leinwand in einer Zeile, um die Zeile selbst auszuwählen und ihre Einstellungen im Inspektor zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en una zona vacía del lienzo de una fila para seleccionar la propia fila y ver los controles de fila en el inspector."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روی قسمت خالی بوم داخل یک ردیف کلیک کنید تا خود ردیف انتخاب شود و کنترل‌های سطح ردیف در بازرس نمایش داده شوند."

    "Full access to all device frames, shapes, languages, and export resolutions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوصول الكامل إلى جميع إطارات الجهاز والأشكال واللغات ودقة التصدير."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সমস্ত ডিভাইস ফ্রেম, আকার, ভাষা এবং এক্সপোর্ট রেজোলিউশনে সম্পূর্ণ অ্যাক্সেস।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accés complet a tots els marcs, formes, idiomes i resolucions d'exportació del dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úplný přístup ke všem rámečkům zařízení, tvarům, jazykům a rozlišením exportu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuld adgang til alle enhedens rammer, former, sprog og eksportopløsninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voller Zugriff auf alle Geräterahmen, Formen, Sprachen und Exportauflösungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πλήρης πρόσβαση σε όλα τα πλαίσια, τα σχήματα, τις γλώσσες και τις αναλύσεις εξαγωγής συσκευών."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceso completo a todos los marcos de dispositivo, formas, idiomas y resoluciones de exportación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دسترسی کامل به همهٔ قاب‌های دستگاه، شکل‌ها، زبان‌ها و وضوح‌های خروجی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täysi pääsy kaikkiin laitekehyksiin, muotoihin, kieliin ja vientitarkkuuksiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accès complet à tous les cadres d'appareil, formes, langues et résolutions d'exportation."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમામ ઉપકરણ ફ્રેમ્સ, આકારો, ભાષાઓ અને નિકાસ રીઝોલ્યુશનની સંપૂર્ણ ઍક્સેસ."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גישה מלאה לכל מסגרות המכשיר, הצורות, השפות ורזולוציות הייצוא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी डिवाइस फ़्रेमों, आकृतियों, भाषाओं और निर्यात रिज़ॉल्यूशन तक पूर्ण पहुंच।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potpuni pristup svim okvirima uređaja, oblicima, jezicima i rezolucijama izvoza."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teljes hozzáférés az összes eszközkerethez, alakzathoz, nyelvhez és exportálási felbontáshoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses penuh ke semua bingkai perangkat, bentuk, bahasa, dan resolusi ekspor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesso completo a tutte le cornici del dispositivo, forme, lingue e risoluzioni di esportazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのデバイスフレーム、図形、言語、書き出し解像度を利用できます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಎಲ್ಲಾ ಸಾಧನ ಫ್ರೇಮ್‌ಗಳು, ಆಕಾರಗಳು, ಭಾಷೆಗಳು ಮತ್ತು ರಫ್ತು ರೆಸಲ್ಯೂಶನ್‌ಗಳಿಗೆ ಪೂರ್ಣ ಪ್ರವೇಶ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 기기 프레임, 도형, 언어, 내보내기 해상도를 제한 없이 사용할 수 있습니다."
          }
        },
        "ml" : {

    "Template borders, alignment guides, and selection handles are editor-only and never exported." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorlagenränder, Ausrichtungshilfen und Auswahlpunkte sind nur für den Editor verfügbar und werden nie exportiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los bordes de las plantillas, las guías de alineación y los controladores de selección son solo del editor y nunca se exportan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حاشیه‌های الگو، راهنمای تراز، و دسته‌های انتخاب فقط برای ویرایشگر هستند و هرگز صادر نمی‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les bordures de modèle, les guides d'alignement et les poignées de sélection sont réservés à l'éditeur et ne sont jamais exportés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I bordi dei modelli, le guide di allineamento e le maniglie di selezione sono visibili solo nell'editor e non vengono mai esportati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テンプレートの境界線、配置ガイド、および選択ハンドルは編集専用であり、エクスポートされることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "템플릿 테두리, 정렬 안내선 및 선택 핸들은 편집기 전용이며 내보내지지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As bordas do modelo, as guias de alinhamento e as alças de seleção são apenas para editor e nunca são exportadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Границы шаблонов, направляющие выравнивания и ручки выделения видны только в редакторе и никогда не экспортируются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şablon kenarlıkları, hizalama kılavuzları ve seçim tutamaçları yalnızca düzenleyicide görünür ve asla dışa aktarılmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Межі шаблонів, напрямні вирівнювання та маркери вибору видимі лише в редакторі й ніколи не експортуються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模板边框、对齐参考线和选择手柄仅供编辑器使用，从不导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "範本邊框、對齊參考線和選取控制點僅在編輯器中顯示，絕不會被輸出。"
          }
        }
      }
    },

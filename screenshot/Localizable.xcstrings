        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покупка активується на одному Mac. Щоб перенести її на інший Mac, зверніться до підтримки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次购买只能在一台 Mac 上激活。如需转移到另一台 Mac，请联系技术支持。"

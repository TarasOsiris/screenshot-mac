        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не можна вивантажити у версію %@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ کو %2$@ ورژن پر اپ لوڈ نہیں کیا جا سکتا۔"
          }

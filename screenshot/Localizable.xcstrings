    "1. Create a new project from a template, or start blank." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Creeu un projecte nou a partir d'una plantilla o comenceu en blanc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Opret et nyt projekt fra en skabelon, eller start tom."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Erstelle ein neues Projekt aus einer Vorlage oder beginne mit einem leeren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Crea un proyecto a partir de una plantilla o empieza en blanco."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. پروژهٔ جدیدی از یک قالب بسازید، یا با پروژهٔ خالی شروع کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Luo uusi projekti mallista tai aloita tyhjältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Créez un projet à partir d'un modèle, ou partez de zéro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Crea un nuovo progetto da un modello, oppure parti da zero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. テンプレートから新しいプロジェクトを作成するか、空の状態から始めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 템플릿으로 새 프로젝트를 만들거나 빈 프로젝트로 시작합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Maak een nieuw project op basis van een sjabloon, of begin blanco."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Opprett et nytt prosjekt fra en mal, eller start tomt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Crie um novo projeto a partir de um modelo ou comece em branco."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Crie um novo projeto a partir de um modelo ou comece em branco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Создайте новый проект из шаблона или начните с пустого."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Skapa ett nytt projekt från en mall, eller börja tomt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Bir şablondan yeni bir proje oluşturun ya da boş başlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Створіть новий проєкт із шаблону або почніть з нуля."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 从模板创建新项目，或从空白项目开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 從範本建立新專案，或從空白開始。"
          }
        }

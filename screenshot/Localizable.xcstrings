        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "రంగు, అస్పష్టత, భ్రమణం (డిగ్రీలలో, టెక్స్ట్‌గా సవరించదగినది), సరిహద్దు వ్యాసార్థం, అవుట్‌లైన్ (రంగు + వెడల్పు), మరియు **ఫ్రేమ్‌కు క్లిప్ చేయండి** (టెంప్లేట్‌ను ఓవర్‌ఫ్లో చేసే ఏదైనా క్లిప్ చేస్తుంది)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สี ความทึบ การหมุน (เป็นองศา แก้ไขเป็นข้อความได้) รัศมีเส้นขอบ โครงร่าง (สี + ความกว้าง) และ **คลิปต่อเฟรม** (คลิปอะไรก็ได้ที่ล้นเทมเพลต)"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رنگ، دھندلاپن، گردش (ڈگریوں میں، متن کے طور پر قابل تدوین)، سرحدی رداس، آؤٹ لائن (رنگ + چوڑائی)، اور **کلپ ٹو فریم** (کسی بھی چیز کو کلپ کرتا ہے جو ٹیمپلیٹ کو اوور فلو کرتا ہے)۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màu sắc, độ mờ, xoay (tính theo độ, có thể chỉnh sửa dưới dạng văn bản), bán kính đường viền, đường viền (màu + chiều rộng) và **Clip to Frame** (cắt bất cứ thứ gì vượt quá mẫu)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

    "File names are zero-padded (`01_…`, `02_…`) so they sort correctly when uploaded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسماء الملفات مبطنة بصفر (`01_...`، `02_...`) لذا يتم فرزها بشكل صحيح عند تحميلها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফাইলের নামগুলি শূন্য-প্যাডেড (`01_…`, `02_…`) তাই আপলোড করার সময় তারা সঠিকভাবে সাজায়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els noms dels fitxers s'emplenen amb zero (`01_…`, `02_…`) de manera que s'ordenen correctament quan es pengen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Názvy souborů jsou odsazeny nulami (`01_…`, `02_…`), takže se při nahrávání správně seřadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filnavne er nulpolstrede (`01_…`, `02_...`), så de sorterer korrekt, når de uploades."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateinamen haben führende Nullen (`01_…`, `02_…`), damit sie beim Hochladen richtig sortiert werden."

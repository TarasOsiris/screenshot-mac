        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Centro** coloca una forma vertical, horizontal o en el centro exacto de su captura de pantalla."
          }
        },
        "fa" : {
          "stringUnit" : {

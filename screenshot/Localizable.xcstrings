    "Go unlimited and create as many screenshots as your apps need." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aneu sense límits i creeu tantes captures de pantalla com necessitin les vostres aplicacions."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå ubegrænset og lav så mange skærmbilleder, som dine apps har brug for."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Limits: Erstelle so viele Screenshots, wie deine Apps brauchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin límites: crea todas las capturas que necesiten tus apps."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نامحدود شوید و هر تعداد اسکرین‌شات که برنامه‌هایتان لازم دارند بسازید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä rajattomasti ja luo niin monta kuvakaappausta kuin sovelluksesi tarvitsevat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez à l'illimité et créez autant de captures d'écran que vos apps en ont besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa all'illimitato e crea tutti gli screenshot di cui le tue app hanno bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無制限プランで、アプリに必要なだけスクリーンショットを作成しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무제한으로 앱에 필요한 만큼 스크린샷을 생성하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga onbeperkt en maak zoveel screenshots als je apps nodig hebben."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå ubegrenset og lag så mange skjermbilder som appene dine trenger."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libere tudo e crie quantas capturas de tela seus apps precisarem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vá ilimitado e crie quantas capturas de ecrã seus aplicativos precisarem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимите ограничения и создавайте столько скриншотов, сколько нужно вашим приложениям."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå obegränsat och skapa så många skärmdumpar som dina appar behöver."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sınırsız kullanın ve uygulamalarınızın ihtiyaç duyduğu kadar ekran görüntüsü oluşturun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зніміть обмеження й створюйте стільки знімків екрана, скільки потрібно вашим програмам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "升级为无限制版本，为你的 App 创建所需的全部截图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "升級為無限制，為你的 App 建立所需的所有螢幕截圖。"
          }
        }
      }
    },

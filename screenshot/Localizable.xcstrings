    "Add languages from this menu and translate every text layer — by hand or automatically. Layouts stay identical in every language, and Cmd+] cycles between them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie über dieses Menü Sprachen hinzu und übersetzen Sie jede Textebene – manuell oder automatisch. Die Layouts bleiben in jeder Sprache identisch und mit Cmd+] wechseln Sie zwischen ihnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

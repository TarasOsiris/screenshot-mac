        }
      }
    },
    "**Image** — bring in any PNG / JPEG / SVG. Pick a fill mode and tweak opacity." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Bild** – füge ein beliebiges PNG / JPEG / SVG ein. Wähle einen Füllmodus und passe die Deckkraft an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Imagen**: usa cualquier PNG / JPEG / SVG. Elige un modo de relleno y ajusta la opacidad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**تصویر** — هر فایل PNG / JPEG / SVG را وارد کنید. حالت پرکردن را انتخاب و کدورت را تنظیم کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Image** : importez un fichier PNG / JPEG / SVG. Choisissez un mode de remplissage et ajustez l'opacité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

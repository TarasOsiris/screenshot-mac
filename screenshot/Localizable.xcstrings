    "Exports use the row's exact pixel dimensions so App Store and Google Play sizes stay correct." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Exporten werden die exakten Pixelabmessungen der Zeile verwendet, sodass die Größen App Store und Google Play korrekt bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las exportaciones utilizan las dimensiones exactas en píxeles de la fila para que los tamaños App Store y Google Play permanezcan correctos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صادرات از ابعاد پیکسل دقیق ردیف استفاده می‌کند، بنابراین اندازه‌های App Store و Google Play درست باقی می‌مانند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les exportations utilisent les dimensions exactes en pixels de la ligne afin que les tailles App Store et Google Play restent correctes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le esportazioni usano le dimensioni esatte in pixel della riga, così le dimensioni per App Store e Google Play restano corrette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エクスポートでは行の正確なピクセル寸法が使用されるため、App Store と Google Play のサイズは正しいままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내보내기에서는 행의 정확한 픽셀 크기를 사용하므로 App Store 및 Google Play 크기가 올바르게 유지됩니다."
          }
        },

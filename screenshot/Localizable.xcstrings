    "Models are grouped by category. Each shows available colors as small swatches." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelle sind nach Kategorie gruppiert. Jedes zeigt die verfügbaren Farben als kleine Farbfelder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modelos están agrupados por categoría. Cada uno muestra los colores disponibles como pequeñas muestras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدل‌ها بر اساس دسته گروه‌بندی شده‌اند. هر کدام رنگ‌های موجود را به‌صورت نمونه‌رنگ‌های کوچک نشان می‌دهد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles sont regroupés par catégorie. Chacun affiche les couleurs disponibles sous forme de petits échantillons."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I modelli sono raggruppati per categoria. Ognuno mostra i colori disponibili come piccoli campioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルはカテゴリごとにまとめられ、それぞれ選択できる色が小さなスウォッチで表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델은 카테고리별로 그룹화됩니다. 각각은 사용 가능한 색상을 작은 견본으로 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os modelos são agrupados por categoria. Cada um mostra as cores disponíveis como pequenas amostras."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модели сгруппированы по категориям. Для каждой доступные цвета показаны небольшими образцами."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modeller kategoriye göre gruplandırılmıştır. Her biri mevcut renkleri küçük renk örnekleri olarak gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моделі згруповано за категоріями. Для кожної доступні кольори показано маленькими зразками."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "型号按类别分组，每个型号都以小色块显示可用颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "型號依類別分組。每個型號都會以小色塊顯示可用的顏色。"
          }
        }
      }
    },
    "Models marked **(3D)** — iPhone 17 and iPhone 17 Pro Max — are rendered from real geometry rather than a flat bezel image." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit **(3D)** gekennzeichnete Modelle – iPhone 17 und iPhone 17 Pro Max – werden aus echter Geometrie und nicht aus einem Bild mit flachem Rahmen gerendert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modelos marcados como **(3D)** (iPhone 17 y iPhone 17 Pro Max) se renderizan a partir de geometría real en lugar de una imagen plana del bisel."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدل‌هایی که با **(3D)** مشخص شده‌اند — iPhone 17 و iPhone 17 Pro Max — به‌جای تصویر تخت قاب، از هندسهٔ واقعی رندر می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles marqués **(3D)** — iPhone 17 et iPhone 17 Pro Max — sont rendus à partir d'une vraie géométrie 3D plutôt que d'une image de cadre plate."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I modelli contrassegnati con **(3D)**, iPhone 17 e iPhone 17 Pro Max, vengono resi da una geometria reale anziché da un'immagine piatta della cornice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**(3D)** の付いたモデル (iPhone 17 と iPhone 17 Pro Max) は、平面のベゼル画像ではなく実際の立体形状からレンダリングされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**(3D)** 표시가 있는 모델(iPhone 17, iPhone 17 Pro Max)은 평면 베젤 이미지가 아니라 실제 3D 형상으로 렌더링됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os modelos marcados como **(3D)** — iPhone 17 e iPhone 17 Pro Max — são renderizados a partir de geometria real em vez de uma imagem de moldura plana."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модели с пометкой **(3D)** — iPhone 17 и iPhone 17 Pro Max — отрисовываются по реальной геометрии, а не плоским изображением корпуса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**(3B)** olarak işaretlenmiş modeller — iPhone 17 ve iPhone 17 Pro Max — düz bir çerçeve görüntüsü yerine gerçek geometriden oluşturulur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моделі з позначкою **(3D)** — iPhone 17 і iPhone 17 Pro Max — рендеряться зі справжньої геометрії, а не з пласкої картинки корпусу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标记为 **(3D)** 的型号——iPhone 17 和 iPhone 17 Pro Max——根据真实几何模型渲染，而不是平面的边框图像。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標示 **(3D)** 的型號——iPhone 17 和 iPhone 17 Pro Max——是以真實幾何模型轉譯，而非平面的邊框影像。"
          }
        }
      }
    },

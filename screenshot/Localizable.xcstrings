    "Behind the scenes, an `NSMetadataQuery` watches each project for upload/download progress." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinter den Kulissen überwacht eine „NSMetadataQuery“ jedes Projekt auf den Upload-/Download-Fortschritt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detrás de escena, un `NSMetadataQuery` observa el progreso de carga/descarga de cada proyecto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در پشت صحنه، «NSMetadataQuery» هر پروژه را برای پیشرفت آپلود/دانلود تماشا می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les coulisses, un « NSMetadataQuery » surveille chaque projet pour connaître la progression du téléchargement/téléchargement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dietro le quinte, una `NSMetadataQuery` monitora ogni progetto per verificare l'avanzamento di caricamento e download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舞台裏では、`NSMetadataQuery` が各プロジェクトのアップロード/ダウンロードの進行状況を監視します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "뒤에서 'NSMetadataQuery'는 각 프로젝트의 업로드/다운로드 진행 상황을 감시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos bastidores, um `NSMetadataQuery` monitora cada projeto para verificar o progresso de upload/download."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За кулисами `NSMetadataQuery` отслеживает ход выгрузки и загрузки каждого проекта."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka planda bir `NSMetadataQuery`, her projenin yükleme/indirme ilerlemesini izler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За лаштунками `NSMetadataQuery` відстежує перебіг вивантаження й завантаження кожного проєкту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在幕后，“NSMetadataQuery”监视每个项目的上传/下载进度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在幕後，`NSMetadataQuery` 會監看每個專案的上傳／下載進度。"
          }
        }
      }
    },

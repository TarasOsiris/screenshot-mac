    "This text is too long for its box in this language. Enlarge the box, shorten the text, or turn on Shrink to Fit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Text ist in dieser Sprache zu lang für sein Feld. Vergrößere das Feld, kürze den Text oder aktiviere „Passend verkleinern“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este texto es demasiado largo para su cuadro en este idioma. Agranda el cuadro, acorta el texto o activa Reducir para ajustar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این متن در این زبان برای کادرش بیش از حد طولانی است. کادر را بزرگ‌تر کنید، متن را کوتاه کنید یا «کوچک‌سازی برای جا شدن» را روشن کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce texte est trop long pour son cadre dans cette langue. Agrandissez le cadre, raccourcissez le texte ou activez Réduire pour ajuster."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo testo è troppo lungo per il suo riquadro in questa lingua. Ingrandisci il riquadro, accorcia il testo o attiva Riduci per adattare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この言語ではテキストが枠に収まりません。枠を広げるか、テキストを短くするか、「縮小して合わせる」をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 언어에서는 텍스트가 상자에 비해 너무 깁니다. 상자를 키우거나 텍스트를 줄이거나 '맞게 축소'를 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este texto é longo demais para a caixa neste idioma. Aumente a caixa, encurte o texto ou ative Reduzir para caber."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом языке текст не помещается в рамку. Увеличьте рамку, сократите текст или включите «Уменьшать по размеру»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu metin bu dilde kutusu için çok uzun. Kutuyu büyütün, metni kısaltın veya Sığdırmak İçin Küçült'ü açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У цій мові текст не вміщається в рамку. Збільште рамку, скоротіть текст або ввімкніть «Зменшувати під розмір»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此语言中，文本超出了文本框。请放大文本框、缩短文本，或打开“缩小以适合”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此語言中，文字超出了文字框。請放大文字框、縮短文字，或開啟「縮小以符合」。"
          }
        }
      }
    },

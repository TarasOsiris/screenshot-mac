    "File coordination (`NSFileCoordinator`) prevents corruption from concurrent reads/writes." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coordinació de fitxers (`NSFileCoordinator`) evita la corrupció de les lectures/escriptures concurrents."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filkoordinering (`NSFileCoordinator`) forhindrer korruption fra samtidige læsninger/skrivninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateikoordination (`NSFileCoordinator`) verhindert Beschädigungen durch gleichzeitige Lese- und Schreibzugriffe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coordinación de archivos (`NSFileCoordinator`) evita la corrupción por lecturas/escrituras simultáneas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هماهنگی فایل (`NSFileCoordinator`) از خرابی ناشی از خواندن و نوشتن هم‌زمان جلوگیری می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedostojen koordinointi (`NSFileCoordinator`) estää korruption samanaikaisista luku-/kirjoitustöistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coordination des fichiers (`NSFileCoordinator`) empêche la corruption due aux lectures/écritures simultanées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coordinazione dei file (`NSFileCoordinator`) impedisce il danneggiamento dovuto a letture/scritture simultanee."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイル協調 (`NSFileCoordinator`) により、同時の読み書きによるファイルの破損を防ぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 조정(`NSFileCoordinator`)은 동시 읽기/쓰기로 인한 손상을 방지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestandscoördinatie (`NSFileCoordinator`) voorkomt corruptie door gelijktijdige lees-/schrijfbewerkingen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filkoordinering (`NSFileCoordinator`) forhindrer korrupsjon fra samtidig lesing/skriving."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A coordenação de arquivos (`NSFileCoordinator`) evita corrupção de leituras/gravações simultâneas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A coordenação de ficheiros (`NSFileCoordinator`) evita corrupção de leituras/gravações simultâneas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Координация файлов (`NSFileCoordinator`) предотвращает повреждение данных при одновременном чтении и записи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filkoordinering (`NSFileCoordinator`) förhindrar korruption från samtidiga läsningar/skrivningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya koordinasyonu (`NSFileCoordinator`), eşzamanlı okuma/yazma işlemlerinden kaynaklanan bozulmaları önler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Координація файлів (`NSFileCoordinator`) запобігає пошкодженню через одночасне читання й запис."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件协调（`NSFileCoordinator`）可防止并发读/写造成的损坏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檔案協調（`NSFileCoordinator`）可防止同時讀寫造成的損毀。"
          }
        }
      }
    },

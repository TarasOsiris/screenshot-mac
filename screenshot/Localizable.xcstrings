    "Format, background, layout, and excluded screenshots will return to defaults. Row selection is preserved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيعود التنسيق والخلفية والتخطيط ولقطات الشاشة المستبعدة إلى الإعدادات الافتراضية. يتم الحفاظ على اختيار الصف."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El format, el fons, la disposició i les captures de pantalla excloses tornaran als valors predeterminats. Es conserva la selecció de files."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formát, pozadí, rozvržení a vyloučené snímky obrazovky se vrátí na výchozí hodnoty. Výběr řádků je zachován."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format, baggrund, layout og ekskluderede skærmbilleder vender tilbage til standardindstillingerne. Rækkevalg bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format, Hintergrund, Layout und ausgeschlossene Screenshots werden auf die Standardeinstellungen zurückgesetzt. Die Zeilenauswahl bleibt erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μορφή, το φόντο, η διάταξη και τα εξαιρούμενα στιγμιότυπα οθόνης θα επιστρέψουν στις προεπιλογές. Η επιλογή σειράς διατηρείται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El formato, el fondo, el diseño y las capturas de pantalla excluidas volverán a sus valores predeterminados. Se conserva la selección de filas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قالب، پس‌زمینه، چیدمان و اسکرین‌شات‌های کنارگذاشته به حالت پیش‌فرض برمی‌گردند. انتخاب ردیف‌ها حفظ می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muoto, tausta, asettelu ja poissuljetut kuvakaappaukset palautetaan oletusasetuksiin. Row selection is preserved."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le format, l'arrière-plan, la mise en page et les captures d'écran exclues reviendront aux valeurs par défaut. La sélection de lignes est conservée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פורמט, רקע, פריסה וצילומי מסך שלא ייכללו יחזרו לברירות המחדל. בחירת השורה נשמרת."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format, pozadina, izgled i izuzete snimke zaslona vratit će se na zadane postavke. Odabir redaka je sačuvan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A formátum, a háttér, az elrendezés és a kizárt képernyőképek visszaállnak az alapértelmezett értékekre. A sorkijelölés megmarad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format, latar belakang, tata letak, dan tangkapan layar yang dikecualikan akan kembali ke default. Pemilihan baris dipertahankan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formato, sfondo, layout e screenshot esclusi torneranno ai valori predefiniti. La selezione delle righe viene mantenuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "形式、背景、レイアウト、除外されたスクリーンショットはデフォルトに戻ります。行の選択は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "형식, 배경, 레이아웃, 제외된 스크린샷이 기본값으로 돌아갑니다. 행 선택은 유지됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format, latar belakang, reka letak dan tangkapan skrin yang dikecualikan akan kembali kepada lalai. Pemilihan baris dikekalkan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formaat, achtergrond, lay-out en uitgesloten schermafbeeldingen keren terug naar de standaardwaarden. Rijselectie blijft behouden."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format, bakgrunn, layout og ekskluderte skjermbilder vil gå tilbake til standardinnstillingene. Radvalg er bevart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format, tło, układ i wykluczone zrzuty ekranu powrócą do wartości domyślnych. Wybór wierszy zostaje zachowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formato, plano de fundo, layout e capturas de tela excluídas retornarão aos padrões. A seleção de linha é preservada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formato, plano de fundo, layout e capturas de ecrã excluídas retornarão aos padrões. A seleção de linha é preservada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formatul, fundalul, aspectul și capturile de ecran excluse vor reveni la valorile implicite. Selecția rândurilor este păstrată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Формат, фон, макет и исключенные скриншоты вернутся к значениям по умолчанию. Выбранные строки сохранятся."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formát, pozadie, rozloženie a vylúčené snímky obrazovky sa vrátia na predvolené hodnoty. Výber riadkov je zachovaný."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oblika, ozadje, postavitev in izključeni posnetki zaslona se bodo vrnili na privzete vrednosti. Izbira vrstic se ohrani."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format, bakgrund, layout och uteslutna skärmdumpar återgår till standardinställningarna. Radval bevaras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปแบบ พื้นหลัง เค้าโครง และภาพหน้าจอที่ยกเว้นจะกลับคืนสู่ค่าเริ่มต้น การเลือกแถวจะถูกเก็บรักษาไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biçim, arka plan, düzen ve hariç tutulan ekran görüntüleri varsayılanlara dönecek. Satır seçimi korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Формат, тло, макет і виключені знімки екрана буде повернено до стандартних. Вибрані рядки збережуться."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فارمیٹ، بیک گراؤنڈ، لے آؤٹ، اور خارج کیے گئے اسکرین شاٹس ڈیفالٹس پر واپس آجائیں گے۔ قطار کا انتخاب محفوظ ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Định dạng, nền, bố cục và ảnh chụp màn hình bị loại trừ sẽ trở về mặc định. Lựa chọn hàng được bảo tồn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "格式、背景、布局和已排除的截图将恢复为默认值。行的选择将保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "格式、背景、版面和已排除的螢幕截圖都會恢復為預設值。列的選擇會保留。"
          }
        }
      }
    },

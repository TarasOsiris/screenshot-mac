    "This purchase link isn't valid. Check that you copied the whole link from your receipt email." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest enllaç de compra no és vàlid. Comproveu que heu copiat tot l'enllaç del correu electrònic del rebut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette købslink er ikke gyldigt. Tjek, at du har kopieret hele linket fra din kvitteringsmail."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Kauflink ist ungültig. Prüfe, ob du den vollständigen Link aus deiner Quittungs-E-Mail kopiert hast."

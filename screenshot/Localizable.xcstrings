            "value" : "窓"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "창"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janela"
          }
        },
        "zh-Hans" : {

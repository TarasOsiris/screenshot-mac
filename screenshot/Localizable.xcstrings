    "`~/Library/Application Support/screenshot/projects/<uuid>/resources/` — imported images, screenshots, and SVGs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„~/Library/Application Support/screenshot/projects/<uuid>/resources/“ – importierte Bilder, Screenshots und SVGs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`~/Library/Application Support/screenshot/projects/<uuid>/resources/`: imágenes importadas, capturas de pantalla y SVG."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`~/Library/Application Support/screenshot/projects/<uuid>/resources/` — تصاویر، اسکرین شات ها و SVGهای وارد شده."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`~/Bibliothèque/Application Support/screenshot/projects/<uuid>/resources/` — images, captures d'écran et SVG importés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`~/Library/Application Support/screenshot/projects/<uuid>/resources/` — インポートされたイメージ、スクリーンショット、および SVG。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`~/Library/Application Support/screenshot/projects/<uuid>/resources/` — 가져온 이미지, 스크린샷 및 SVG."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`~/Library/Application Support/screenshot/projects/<uuid>/resources/` — imagens importadas, capturas de tela e SVG."
          }
        },
        "zh-Hans" : {

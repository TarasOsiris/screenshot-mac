    "Copy a row into a variant, or turn off “Exclude when uploading to App Store Connect” on one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انسخ صفًا إلى متغير، أو قم بإيقاف تشغيل \"الاستبعاد عند التحميل إلى App Store Connect\" في أحد المتغيرات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি ভেরিয়েন্টে একটি সারি অনুলিপি করুন বা একটিতে \"App Store Connect-এ আপলোড করার সময় বাদ দিন\" বন্ধ করুন৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copieu una fila en una variant o desactiveu l'opció \"Exclou en penjar a App Store Connect\" en una."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkopírujte řádek do varianty nebo u jedné vypněte možnost „Vyloučit při nahrávání do App Store Connect“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopier en række til en variant, eller deaktiver \"Ekskluder ved upload til App Store Connect\" på en."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiere eine Zeile in eine Variante oder deaktiviere bei einer Zeile „Beim Hochladen in App Store Connect ausschließen“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αντιγράψτε μια σειρά σε μια παραλλαγή ή απενεργοποιήστε την επιλογή \"Εξαίρεση κατά τη μεταφόρτωση στο App Store Connect\" σε μία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia una fila en una variante o desactiva «Excluir al subir a App Store Connect» en alguna."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک ردیف را به یک نسخه کپی کنید، یا گزینهٔ «هنگام آپلود در App Store Connect کنار گذاشته شود» را برای یکی خاموش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopioi rivi muunnelmaan tai poista \"Sulje pois lähetettäessä kohteeseen App Store Connect\" käytöstä jossakin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiez une ligne dans une variante, ou désactivez « Exclure lors de l'envoi vers App Store Connect » sur l'une d'elles."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એક પંક્તિને વેરિઅન્ટમાં કૉપિ કરો અથવા એક પર \"App Store Connect પર અપલોડ કરતી વખતે બાકાત રાખો\" બંધ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "העתק שורה לגרסה, או כבה את \"אי הכללה בעת העלאה ל-App Store Connect\" באחת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक पंक्ति को एक प्रकार में कॉपी करें, या एक पर \"App Store Connect पर अपलोड करते समय बहिष्कृत करें\" को बंद करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopirajte redak u varijantu ili isključite \"Isključi prilikom prijenosa u App Store Connect\" na jednoj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Másoljon egy sort egy változatba, vagy kapcsolja ki az egyiken a „Kizárás a App Store Connect-re való feltöltéskor” beállítást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salin baris ke dalam varian, atau nonaktifkan “Kecualikan saat mengunggah ke App Store Connect” pada salah satu varian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia una riga in una variante, oppure disattiva “Escludi dal caricamento su App Store Connect” su una riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行をバリアントにコピーするか、いずれかの行で「App Store Connect へのアップロード時に除外」をオフにしてください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ವೇರಿಯಂಟ್‌ಗೆ ಸಾಲನ್ನು ನಕಲಿಸಿ ಅಥವಾ ಒಂದರಲ್ಲಿ \"App Store Connect ಗೆ ಅಪ್‌ಲೋಡ್ ಮಾಡುವಾಗ ಹೊರತುಪಡಿಸಿ\" ಅನ್ನು ಆಫ್ ಮಾಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "행을 변형으로 복사하거나, 한 행에서 ‘App Store Connect에 업로드할 때 제외’를 끄세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരു വേരിയൻ്റിലേക്ക് ഒരു വരി പകർത്തുക, അല്ലെങ്കിൽ ഒന്നിൽ \"App Store Connect അപ്‌ലോഡ് ചെയ്യുമ്പോൾ ഒഴിവാക്കുക\" ഓഫാക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एका प्रकारात पंक्ती कॉपी करा किंवा एकावर “App Store Connect वर अपलोड करताना वगळा” बंद करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salin baris ke dalam varian atau matikan \"Kecualikan semasa memuat naik ke App Store Connect\" pada satu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieer een rij naar een variant of schakel 'Uitsluiten bij uploaden naar App Store Connect' uit voor één rij."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopier en rad til en variant, eller slå av «Ekskluder ved opplasting til App Store Connect» på en."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skopiuj wiersz do wariantu lub wyłącz w jednym z nich opcję „Wyklucz podczas przesyłania do App Store Connect”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie uma linha para uma variante ou desative “Excluir ao enviar para o App Store Connect” em uma delas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie uma linha em uma variante ou desative “Excluir ao carregar para App Store Connect” em uma delas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiați un rând într-o variantă sau dezactivați „Excludeți când încărcați în App Store Connect” pe unul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопируйте строку в вариант или выключите для одной из строк «Исключить при загрузке в App Store Connect»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skopírujte riadok do variantu alebo pri jednom vypnite možnosť Vylúčiť pri nahrávaní do App Store Connect."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopirajte vrstico v različico ali na eni izklopite »Izključi pri nalaganju v App Store Connect«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiera en rad till en variant eller inaktivera \"Uteslut vid uppladdning till App Store Connect\" på en."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒரு வரிசையை ஒரு மாறுபாட்டிற்கு நகலெடுக்கவும் அல்லது ஒன்றில் \"App Store Connect இல் பதிவேற்றும்போது விலக்கு\" என்பதை முடக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అడ్డు వరుసను వేరియంట్‌లోకి కాపీ చేయండి లేదా ఒకదానిలో “App Store Connectకి అప్‌లోడ్ చేస్తున్నప్పుడు మినహాయించండి”ని ఆఫ్ చేయండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คัดลอกแถวลงในรูปแบบหนึ่ง หรือปิด \"ยกเว้นเมื่ออัปโหลดไปยัง App Store Connect\" ในแถวเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir satırı bir varyanta kopyalayın ya da birinde “App Store Connect'e yüklerken hariç tut” seçeneğini kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопіюйте рядок у варіант або вимкніть для одного з рядків «Виключити під час вивантаження в App Store Connect»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک قطار کو مختلف میں کاپی کریں، یا ایک پر \"App Store Connect پر اپ لوڈ کرتے وقت خارج کریں\" کو آف کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sao chép một hàng thành một biến thể hoặc tắt “Loại trừ khi tải lên App Store Connect” trên một biến thể."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将一行复制到变体中，或在某一行上关闭“上传到 App Store Connect 时排除”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將一列拷貝到變體中，或對其中一列關閉「上傳至 App Store Connect 時排除」。"
          }
        }
      }
    },

        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αλλάξτε το μέγεθος της σειράς σε ένα από τα: %1$@ ή επιλέξτε έναν αντίστοιχο τύπο οθόνης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

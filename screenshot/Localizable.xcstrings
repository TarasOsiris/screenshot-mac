        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vormeigenschappen verplaatsen zich van de balk onder het canvas naar de zijbalk. Klik op de rijnaam of druk op Esc om terug te keren naar de rij-instellingen."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formegenskaper flyttes fra linjen under lerretet til sidefeltet. Klikk på radnavnet eller trykk Esc for å gå tilbake til radinnstillinger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Właściwości kształtu przenoszą się z paska pod płótnem na pasek boczny. Kliknij nazwę wiersza lub naciśnij klawisz Esc, aby powrócić do ustawień wiersza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As propriedades da forma saem da barra abaixo da tela e vão para a barra lateral. Clique no nome da linha ou pressione Esc para voltar aos ajustes da linha."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As propriedades da forma passam da barra abaixo da ecrã para a barra lateral. Clique no nome da linha ou pressione Esc para retornar às configurações da linha."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proprietățile formei se mută din bara de sub pânză în bara laterală. Faceți clic pe numele rândului sau apăsați Esc pentru a reveni la setările rândului."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastnosti tvaru sa presunú z panela pod plátnom na bočný panel. Kliknutím na názov riadka alebo stlačením klávesu Esc sa vrátite k nastaveniam riadka."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lastnosti oblike se premaknejo iz vrstice pod platnom v stransko vrstico. Kliknite ime vrstice ali pritisnite Esc, da se vrnete na nastavitve vrstice."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formegenskaper flyttas från fältet under arbetsytan till sidofältet. Klicka på radnamnet eller tryck på Esc för att återgå till radinställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณสมบัติรูปร่างจะย้ายจากแถบด้านล่างแคนวาสไปยังแถบด้านข้าง คลิกชื่อแถวหรือกด Esc เพื่อกลับไปยังการตั้งค่าแถว"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شکل کی خصوصیات کینوس کے نیچے بار سے سائڈبار میں منتقل ہوتی ہیں۔ قطار کے نام پر کلک کریں یا قطار کی ترتیبات پر واپس جانے کے لیے Esc دبائیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thuộc tính hình dạng di chuyển từ thanh bên dưới khung vẽ vào thanh bên. Nhấp vào tên hàng hoặc nhấn Esc để quay lại cài đặt hàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "形状属性会从画布下方的栏移到侧边栏。点按行名称或按 Esc 返回行设置。"
          }
        }
      }
    },

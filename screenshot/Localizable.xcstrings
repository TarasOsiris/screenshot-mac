        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुनरावलोकनासाठी किंवा थेट लॉक केलेल्या आवृत्त्या दर्शवा. स्क्रीनशॉट फक्त संपादन करण्यायोग्य आवृत्त्यांवर अपलोड केले जाऊ शकतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan versi yang dikunci untuk semakan atau langsung. Tangkapan skrin hanya boleh dimuat naik ke versi boleh diedit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon versies die zijn vergrendeld voor beoordeling of live. Schermafbeeldingen kunnen alleen worden geüpload naar bewerkbare versies."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis versjoner som er låst for gjennomgang eller live. Skjermbilder kan bare lastes opp til redigerbare versjoner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaż wersje zablokowane do sprawdzenia lub opublikowane. Zrzuty ekranu można przesyłać wyłącznie do wersji edytowalnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra versões bloqueadas para revisão ou já publicadas. As capturas de tela só podem ser enviadas para versões editáveis."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar versões que estão bloqueadas para revisão ou ativas. As capturas de ecrã só podem ser carregadas em versões editáveis."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișați versiunile care sunt blocate pentru revizuire sau live. Capturile de ecran pot fi încărcate numai în versiuni editabile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать версии, заблокированные на время проверки или опубликованные. Скриншоты можно загружать только в редактируемые версии."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobraziť verzie, ktoré sú uzamknuté na kontrolu alebo zverejnenie. Snímky obrazovky je možné nahrať iba do upraviteľných verzií."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaži različice, ki so zaklenjene za pregled ali v živo. Posnetke zaslona je mogoče naložiti samo v različice, ki jih je mogoče urejati."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa versioner som är låsta för granskning eller live. Skärmdumpar kan endast laddas upp till redigerbara versioner."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மதிப்பாய்வு அல்லது நேரலைக்காக பூட்டப்பட்ட பதிப்புகளைக் காட்டு. திருத்தக்கூடிய பதிப்புகளில் மட்டுமே ஸ்கிரீன் ஷாட்களைப் பதிவேற்ற முடியும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సమీక్ష లేదా ప్రత్యక్ష ప్రసారం కోసం లాక్ చేయబడిన సంస్కరణలను చూపండి. స్క్రీన్‌షాట్‌లు సవరించగలిగే సంస్కరణలకు మాత్రమే అప్‌లోడ్ చేయబడతాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงเวอร์ชันที่ถูกล็อคสำหรับการตรวจทานหรือใช้งานจริง ภาพหน้าจอสามารถอัปโหลดไปยังเวอร์ชันที่แก้ไขได้เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnceleme için kilitli veya yayında olan sürümleri göster. Ekran görüntüleri yalnızca düzenlenebilir sürümlere yüklenebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показати версії, заблоковані на перевірку або вже опубліковані. Знімки екрана можна вивантажувати лише у версії, доступні для редагування."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ ورژن دکھائیں جو نظرثانی یا لائیو کے لیے مقفل ہیں۔ اسکرین شاٹس کو صرف قابل تدوین ورژن پر اپ لوڈ کیا جا سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị các phiên bản bị khóa để xem xét hoặc trực tiếp. Ảnh chụp màn hình chỉ có thể được tải lên các phiên bản có thể chỉnh sửa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示已锁定（正在审核或已上线）的版本。截图只能上传到可编辑的版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示已鎖定審查中或已上架的版本。只有可編輯的版本才能上傳螢幕截圖。"
          }
        }
      }
    },

    "Another screenshot sync is already running. Wait for it to finish, or cancel it first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هناك مزامنة أخرى للشاشة قيد التشغيل بالفعل. انتظر حتى ينتهي، أو قم بإلغائه أولاً."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una altra sincronització de captures de pantalla ja s'està executant. Espereu que acabi o cancel·leu-lo primer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Další synchronizace snímku obrazovky již běží. Počkejte, až skončí, nebo jej nejprve zrušte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En anden synkronisering af skærmbilleder kører allerede. Vent til det er færdigt, eller annuller det først."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere Screenshot-Synchronisierung läuft bereits. Warte, bis sie abgeschlossen ist, oder brich sie zuerst ab."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας άλλος συγχρονισμός στιγμιότυπου οθόνης εκτελείται ήδη. Περιμένετε να τελειώσει ή ακυρώστε το πρώτα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay otra sincronización de capturas en curso. Espera a que termine o cancélala primero."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همگام‌سازی اسکرین‌شات دیگری از قبل در حال اجرا است. صبر کنید تا تمام شود یا ابتدا آن را لغو کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toinen kuvakaappauksen synkronointi on jo käynnissä. Odota sen päättymistä tai peruuta se ensin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre synchronisation des captures d'écran est déjà en cours. Attendez qu'elle se termine ou annulez-la d'abord."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סנכרון נוסף של צילום מסך כבר פועל. המתן עד שהוא יסתיים, או בטל אותו קודם."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druga sinkronizacija snimke zaslona već je pokrenuta. Pričekajte da završi ili ga prvo otkažite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy másik képernyőkép-szinkronizálás már fut. Várja meg, amíg befejeződik, vagy először törölje."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkronisasi tangkapan layar lainnya sudah berjalan. Tunggu hingga selesai, atau batalkan terlebih dahulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È già in corso un'altra sincronizzazione degli screenshot. Attendi che termini oppure annullala prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のスクリーンショット同期がすでに実行中です。完了するまで待つか、先にキャンセルしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 스크린샷 동기화가 이미 실행 중입니다. 완료될 때까지 기다리거나 먼저 취소하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyegerakan tangkapan skrin lain sudah berjalan. Tunggu sehingga selesai, atau batalkan dahulu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is al een andere screenshot-synchronisatie actief. Wacht tot het klaar is, of annuleer het eerst."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annen synkronisering av skjermbilder kjører allerede. Vent til den er ferdig, eller avbryt den først."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inna synchronizacja zrzutów ekranu jest już uruchomiona. Poczekaj, aż się zakończy, lub najpierw anuluj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outra sincronização de capturas de tela já está em andamento. Aguarde terminar ou cancele-a primeiro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outra sincronização de captura de ecrã já está em execução. Espere que termine ou cancele primeiro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O altă sincronizare a capturii de ecran rulează deja. Așteptați să se termine sau anulați-l mai întâi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже выполняется другая синхронизация скриншотов. Дождитесь ее завершения или сначала отмените ее."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ďalšia synchronizácia snímky obrazovky už prebieha. Počkajte, kým sa dokončí, alebo ho najskôr zrušte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druga sinhronizacija posnetkov zaslona se že izvaja. Počakajte, da se konča, ali pa ga najprej prekličite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annan synkronisering av skärmdumpar körs redan. Vänta tills det är klart, eller avbryt det först."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การซิงค์ภาพหน้าจออื่นกำลังทำงานอยู่แล้ว รอให้เสร็จสิ้นหรือยกเลิกก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir ekran görüntüsü eşzamanlaması zaten çalışıyor. Bitmesini bekleyin ya da önce iptal edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже триває інша синхронізація знімків екрана. Дочекайтеся її завершення або спершу скасуйте її."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک اور اسکرین شاٹ کی مطابقت پذیری پہلے سے چل رہی ہے۔ اس کے ختم ہونے کا انتظار کریں، یا پہلے اسے منسوخ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một đồng bộ ảnh chụp màn hình khác đang chạy. Đợi nó kết thúc hoặc hủy nó trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个截图同步正在运行。请等待其完成，或先将其取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一個螢幕截圖同步正在執行。請等待它完成，或先將其取消。"
          }
        }
      }
    },
    "Anything that would block the upload is listed in a banner above the plan, one line per row — every language still missing an App Store locale is named on that one line, not repeated. Where a single change would settle it, the line carries a **Fix** button that makes it: ticking the App Store locales the row already matches, or switching the row to the detected display type." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم إدراج أي شيء من شأنه أن يمنع التحميل في لافتة أعلى الخطة، سطرًا واحدًا في كل صف - يتم تسمية كل لغة لا تزال تفتقد لغة App Store على هذا السطر الواحد، ولا يتم تكرارها. عندما يؤدي تغيير واحد إلى تسوية الأمر، يحمل السطر زر **إصلاح** الذي يجعل من: وضع علامة على App Store يحدد الصف المطابق بالفعل، أو تبديل الصف إلى نوع العرض المكتشف."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualsevol cosa que pugui bloquejar la càrrega s'indica en un bàner a sobre del pla, una línia per fila; cada idioma que encara falti una configuració regional App Store s'anomena en aquesta línia, no es repeteix. Quan un sol canvi ho resoldria, la línia porta un botó **Arregla** que ho fa: marcar les App Store localitzacions amb la que la fila ja coincideix, o canviar la fila al tipus de visualització detectat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše, co by blokovalo nahrávání, je uvedeno v banneru nad plánem, jeden řádek na řádek – každý jazyk, kterému ještě chybí národní prostředí App Store, je pojmenován na tomto řádku, neopakuje se. Tam, kde by to vyřešila jediná změna, řádek nese tlačítko **Opravit**, které to udělá: zaškrtnutím App Store lokalit, se kterými řádek již odpovídá, nebo přepnutím řádku na detekovaný typ zobrazení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt, hvad der ville blokere uploaden, er angivet i et banner over planen, én linje pr. række – hvert sprog, der stadig mangler en App Store-lokalitet, er navngivet på den ene linje, ikke gentaget. Hvor en enkelt ændring ville afgøre det, har linjen en **Ret**-knap, der gør det: ved at markere App Store lokaliteterne, som rækken allerede matcher, eller skifte rækken til den detekterede visningstype."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was den Upload blockieren würde, steht in einem Banner über dem Plan – eine Meldung pro Zeile; jede Sprache, der noch eine App Store-Sprache fehlt, wird in dieser Meldung genannt statt wiederholt. Wo eine einzige Änderung genügt, hat die Meldung eine Taste **Beheben**, die das erledigt: die passenden App Store-Sprachen der Zeile ankreuzen oder die Zeile auf den erkannten Anzeigetyp umstellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οτιδήποτε θα εμπόδιζε τη μεταφόρτωση παρατίθεται σε ένα banner πάνω από το σχέδιο, μία γραμμή ανά σειρά — κάθε γλώσσα που εξακολουθεί να λείπει App Store τοπικές ρυθμίσεις ονομάζεται σε αυτήν τη γραμμή, δεν επαναλαμβάνεται. Όπου μια μεμονωμένη αλλαγή θα το διευθετούσε, η γραμμή φέρει ένα κουμπί **Διόρθωση** που το κάνει: επιλέγοντας τις τοπικές ρυθμίσεις App Store που αντιστοιχεί ήδη στη σειρά ή αλλάζοντας τη σειρά στον τύπο εμφάνισης που εντοπίστηκε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que impediría la subida aparece en un aviso encima del plan, una línea por fila: cada idioma del proyecto que todavía no tiene un idioma del App Store se nombra en esa misma línea, sin repetirse. Cuando un solo cambio lo resolvería, la línea incluye un botón **Corregir** que lo aplica: marcar los idiomas del App Store con los que la fila ya coincide, o cambiar la fila al tipo de pantalla detectado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر چیزی که جلوی آپلود را بگیرد، در نواری بالای طرح فهرست می‌شود، برای هر ردیف یک خط — همهٔ زبان‌هایی که هنوز زبان App Store ندارند در همان یک خط نام برده می‌شوند و تکرار نمی‌شوند. هر جا یک تغییر کافی باشد، آن خط دکمهٔ **اصلاح** دارد که همان تغییر را اعمال می‌کند: علامت زدن زبان‌های App Store که ردیف از قبل با آن‌ها مطابقت دارد، یا تغییر ردیف به نوع نمایش تشخیص‌داده‌شده."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki, mikä estäisi latauksen, on lueteltu suunnitelman yläpuolella olevassa bannerissa, yksi rivi riviä kohden – jokainen kieli, josta vielä puuttuu App Store-kieli, on nimetty tällä yhdellä rivillä, eikä sitä toisteta. Jos yksittäinen muutos ratkaisisi sen, rivillä on **Korjaa**-painike, joka tekee sen: rastittamalla App Store-alueet, jotka jo vastaavat riviä, tai vaihtamalla rivin havaittuun näyttötyyppiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qui empêcherait l'envoi est listé dans un bandeau au-dessus du plan, un message par ligne : chaque langue à laquelle il manque encore une langue App Store y est nommée, sans être répétée. Lorsqu'une seule modification suffit, le message comporte un bouton **Corriger** qui l'applique : cocher les langues App Store correspondant déjà à la ligne, ou basculer la ligne sur le type d'affichage détecté."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל דבר שיחסום את ההעלאה רשום בבאנר מעל התוכנית, שורה אחת בכל שורה - כל שפה שעדיין חסר לו מיקום App Store נקראת בשורה אחת, לא חוזרת על עצמה. היכן ששינוי בודד יקבע את זה, השורה נושאת כפתור **תיקון** שגורם לכך: סימון של App Store המקומות שהשורה כבר תואמת, או החלפת השורה לסוג התצוגה שזוהה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sve što bi blokiralo učitavanje navedeno je u banneru iznad plana, jedan redak po retku — svaki jezik kojem još nedostaje App Store jezik naveden je u tom jednom retku, ne ponavlja se. Tamo gdje bi to riješila jedna promjena, redak sadrži gumb **Popravi** koji to čini: označavanjem App Store lokaliteta s kojim se red već podudara ili prebacivanjem retka na otkrivenu vrstu prikaza."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden, ami blokkolná a feltöltést, a terv feletti szalaghirdetésen szerepel, soronként egy sorral – minden olyan nyelv, amelyből még hiányzik a App Store területi beállítás, az adott sorban meg van nevezve, nem ismétlődik. Ahol egyetlen változtatás megoldaná, ott a sor egy **Javítás** gombot tartalmaz, amely ezt teszi: a App Store területi beállítások kipipálásával a sor már megegyezik, vagy a sor átváltása az észlelt megjelenítési típusra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa pun yang dapat memblokir unggahan dicantumkan dalam spanduk di atas rencana, satu baris per baris — setiap bahasa yang masih belum memiliki lokal App Store akan diberi nama pada satu baris tersebut, tidak diulang. Jika satu perubahan akan menyelesaikan masalah tersebut, baris tersebut akan dilengkapi dengan tombol **Perbaiki** yang membuatnya: mencentang App Store akan menentukan lokasi baris yang sudah cocok, atau mengalihkan baris ke jenis tampilan yang terdeteksi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che bloccherebbe il caricamento è elencato in un banner sopra il piano, una voce per ogni riga: ogni lingua ancora senza una lingua App Store viene nominata in quell'unica voce, senza ripetizioni. Quando basta una sola modifica per risolvere, la voce include un pulsante **Correggi** che la applica: seleziona le lingue App Store già corrispondenti alla riga oppure passa la riga al tipo di display rilevato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップロードを妨げる問題は、プランの上のバナーに行ごとに1件ずつ表示されます。App Store のロケールがまだ決まっていない言語は、その1行にまとめて示され、繰り返されません。1つの変更で解決できる場合は、その行に **修正** ボタンが付きます。押すと、その行に一致する App Store のロケールにチェックを入れるか、行を検出された表示タイプに切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업로드를 막는 문제는 계획 위의 배너에 행마다 한 줄씩 표시됩니다. App Store 로케일이 아직 없는 언어는 모두 그 한 줄에 나열되며 반복되지 않습니다. 한 번의 변경으로 해결되는 경우 그 줄에 **수정** 버튼이 나타나, 행이 이미 일치하는 App Store 로케일을 선택하거나 감지된 디스플레이 유형으로 행을 전환합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa-apa sahaja yang akan menyekat muat naik disenaraikan dalam sepanduk di atas pelan, satu baris setiap baris — setiap bahasa yang masih tiada tempat App Store dinamakan pada satu baris itu, bukan diulang. Apabila satu perubahan akan menyelesaikannya, baris tersebut membawa butang **Betulkan** yang menjadikannya: menandakan App Store menempatkan baris yang sudah sepadan atau menukar baris kepada jenis paparan yang dikesan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles wat de upload zou blokkeren, wordt vermeld in een banner boven het plan, één regel per rij. Elke taal die nog steeds een App Store-landinstelling mist, wordt op die ene regel genoemd en niet herhaald. Waar een enkele wijziging het probleem zou oplossen, heeft de regel een **Fix**-knop die ervoor zorgt dat: het aanvinken van de App Store-localisatie de rij al overeenkomt, of de rij overschakelt naar het gedetecteerde weergavetype."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt som vil blokkere opplastingen er oppført i et banner over planen, én linje per rad – hvert språk som fortsatt mangler en App Store-lokale er navngitt på den ene linjen, ikke gjentatt. Der en enkelt endring vil avgjøre det, har linjen en **Fix**-knapp som gjør det: å krysse av for App Store-lokalitetene raden allerede samsvarer med, eller bytte raden til den oppdagede visningstypen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko, co mogłoby blokować przesyłanie, jest wymienione na banerze nad planem, po jednym wierszu w każdym wierszu — nazwa każdego języka, w którym nadal brakuje ustawień regionalnych App Store, jest wymieniona w tym jednym wierszu, a nie powtarzana. Tam, gdzie pojedyncza zmiana rozwiązałaby problem, w wierszu znajduje się przycisk **Napraw**, który umożliwia: zaznaczenie App Store lokalizuje wiersz, który już pasuje, lub przełączenie wiersza na wykryty typ wyświetlania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que impediria o envio é listado em um aviso acima do plano, um item por linha: cada idioma que ainda está sem uma localidade da App Store é citado nesse mesmo item, sem repetições. Quando uma única mudança resolve, o item traz um botão **Corrigir** que a aplica: marcar as localidades da App Store às quais a linha já corresponde, ou mudar a linha para o tipo de exibição detectado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer coisa que possa bloquear o upload é listada em um banner acima do plano, uma linha por linha — cada idioma que ainda falta uma localidade App Store é nomeado nessa linha, não repetido. Onde uma única alteração resolveria o problema, a linha carrega um botão **Fix** que permite: marcar os locais App Store aos quais a linha já corresponde ou mudar a linha para o tipo de exibição detectado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orice lucru care ar bloca încărcarea este listat într-un banner deasupra planului, câte o linie pe rând — fiecărei limbi care încă lipsește o localitate App Store este numită pe acea linie, nu se repetă. Acolo unde o singură modificare ar rezolva problema, linia poartă un buton **Remediare** care face: bifând App Store localizările cu care rândul se potrivește deja sau comutarea rândului la tipul de afișare detectat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все, что помешает загрузке, перечисляется в баннере над планом — по одной строке на строку проекта: все языки, которым еще не хватает языка App Store, названы в этой одной строке, а не повторяются. Если проблему решает одно изменение, в строке есть кнопка **Исправить**, которая его вносит: отмечает языки App Store, которым строка уже соответствует, или переключает строку на найденный тип дисплея."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetko, čo by blokovalo nahrávanie, je uvedené v banneri nad plánom, jeden riadok na riadok – každý jazyk, ktorému ešte chýba App Store miestne nastavenie, je pomenovaný v tomto riadku, neopakuje sa. Tam, kde by to vyriešila jedna zmena, riadok obsahuje tlačidlo **Opraviť**, ktoré to urobí: zaškrtnutím App Store miest, ktorým sa riadok už zhoduje, alebo prepnutím riadka na zistený typ zobrazenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vse, kar bi blokiralo nalaganje, je navedeno v pasici nad načrtom, ena vrstica na vrstico - vsak jezik, ki še vedno nima področne nastavitve App Store, je poimenovan v tej eni vrstici in se ne ponavlja. Če bi to rešila ena sama sprememba, je v vrstici gumb **Popravi**, ki to omogoča: označitev jezikov App Store, s katerimi se vrstica že ujema, ali preklop vrstice na zaznano vrsto prikaza."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allt som skulle blockera uppladdningen listas i en banner ovanför planen, en rad per rad - varje språk som fortfarande saknar en App Store språk anges på den raden, inte upprepas. Där en enskild ändring skulle lösa det, har raden en **Fix**-knapp som gör det: genom att markera App Store språkinställningarna som raden redan matchar, eller växla raden till den upptäckta visningstypen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิ่งใดก็ตามที่จะบล็อกการอัปโหลดจะแสดงอยู่ในแบนเนอร์เหนือแผน หนึ่งบรรทัดต่อแถว — ทุกภาษาที่ยังไม่มีภาษา App Store จะถูกตั้งชื่อในหนึ่งบรรทัดนั้น โดยไม่มีการซ้ำกัน เมื่อการเปลี่ยนแปลงเพียงครั้งเดียวสามารถจัดการได้ บรรทัดจะมีปุ่ม **แก้ไข** ที่ทำให้: ทำเครื่องหมายที่ภาษา App Store ที่แถวตรงกันอยู่แล้ว หรือสลับแถวเป็นประเภทการแสดงผลที่ตรวจพบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüklemeyi engelleyecek her şey, planın üstündeki bir başlıkta satır başına bir satır olarak listelenir — hâlâ App Store dili eksik olan her dil o tek satırda adlandırılır, tekrarlanmaz. Tek bir değişikliğin sorunu çözeceği durumlarda satırda bunu yapan bir **Düzelt** düğmesi bulunur: satırın zaten eşleştiği App Store dillerini işaretler ya da satırı algılanan ekran türüne geçirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе, що заблокувало б вивантаження, перелічено в банері над планом — по одному повідомленню на рядок; кожну мову, якій ще бракує мови App Store, названо в цьому одному повідомленні, а не повторено окремо. Якщо все вирішує одна зміна, повідомлення має кнопку **Виправити**, яка її вносить: позначає мови App Store, яким рядок уже відповідає, або перемикає рядок на визначений тип дисплея."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کوئی بھی چیز جو اپ لوڈ کو مسدود کرے گی وہ پلان کے اوپر ایک بینر میں درج ہے، فی قطار ایک لائن — ہر زبان کا نام ابھی تک App Store جگہ موجود نہیں ہے، اس ایک لائن پر دہرایا نہیں جاتا ہے۔ جہاں ایک ہی تبدیلی اسے حل کر دے گی، لائن میں ایک **فکس** بٹن ہوتا ہے جو اسے بناتا ہے: App Store کی جگہوں پر ٹک لگا کر جو قطار پہلے سے مماثل ہے، یا قطار کو پتہ چلنے والی ڈسپلے کی قسم میں تبدیل کرنا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bất kỳ điều gì có thể chặn quá trình tải lên đều được liệt kê trong biểu ngữ phía trên kế hoạch, mỗi dòng một hàng — mọi ngôn ngữ vẫn thiếu ngôn ngữ App Store sẽ được đặt tên trên một dòng đó, không lặp lại. Trong trường hợp một thay đổi duy nhất sẽ giải quyết được vấn đề đó thì dòng này sẽ có nút **Khắc phục** để thực hiện điều đó: đánh dấu vào App Store ngôn ngữ mà hàng đã khớp hoặc chuyển hàng sang loại hiển thị được phát hiện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会阻止上传的问题都列在方案上方的横幅中，每行一条——尚未匹配 App Store 语言的所有语言都写在同一条中，不会重复。如果一次更改就能解决，该条会带有 **修复** 按钮：勾选该行已匹配的 App Store 语言，或将该行切换为检测到的显示类型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何會阻礙上傳的問題都會列在計畫上方的橫幅中，每列一行——每種仍缺少 App Store 語言的語言都會在同一行中列出，不會重複。如果只需一項更改就能解決，該行會附上**修正**按鈕來執行：勾選該列已相符的 App Store 語言，或將該列切換為偵測到的顯示類型。"
          }
        }
      }
    },

        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жодної мови з цієї папки ще немає в проєкті. Увімкніть нижче ті, які треба додати, — їхні знімки екрана імпортуються разом із ними."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

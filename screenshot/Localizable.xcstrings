        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Kiểm tra xem các quyền của khóa Issuer ID, Key ID, khóa riêng tư và API có khớp với khóa App Store Connect hay không."
          }

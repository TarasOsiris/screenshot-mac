    },
    "With multiple rows: a sub-folder per row label (e.g. `iPhone 6.9\"`, `iPad 13\"`)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei mehreren Zeilen: ein Unterordner pro Zeilenbezeichnung (z. B. „iPhone 6,9““, „iPad 13““."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con varias filas: una subcarpeta por etiqueta de fila (por ejemplo, `iPhone 6.9\"`, `iPad 13\"`)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با چندین ردیف: یک پوشه فرعی در هر ردیف (به عنوان مثال «iPhone 6.9\"`، \"iPad 13\"\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

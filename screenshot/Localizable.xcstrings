          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varianter er alternative skjermbilder til A/B-testen på din App Store produktside."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

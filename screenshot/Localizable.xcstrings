        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Esc** prekliče izbor oblik; znova pritisnite, da prekličete izbor vrstice."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

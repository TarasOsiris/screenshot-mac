    "%lld screenshots must be removed first to stay within Apple's 10-screenshot limit." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld يجب إزالة لقطات الشاشة أولاً لتظل ضمن الحد الأقصى لعدد لقطات الشاشة الذي حددته Apple وهو 10 لقطات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures de pantalla %1$lld s'han d'eliminar primer per mantenir-se dins del límit de 10 captures de pantalla d'Apple."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby Apple nepřekročil limit 10 snímků obrazovky, musíte nejprve odstranit %1$lld snímky obrazovky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld skærmbilleder skal fjernes først for at holde sig inden for Apples grænse på 10 skærmbilleder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Screenshots müssen zuerst entfernt werden, um Apples Limit von 10 Screenshots einzuhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld στιγμιότυπα οθόνης πρέπει πρώτα να αφαιρεθούν για να παραμείνουν εντός του ορίου των 10 στιγμιότυπων οθόνης της Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero se deben eliminar %lld capturas para respetar el límite de 10 capturas de Apple."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای ماندن در سقف ۱۰ اسکرین‌شات اپل، ابتدا باید %1$lld اسکرین‌شات حذف شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld kuvakaappaukset on ensin poistettava, jotta ne pysyisivät Applen 10 kuvakaappausrajan sisällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld captures d'écran doivent d'abord être supprimées pour respecter la limite de 10 captures d'écran d'Apple."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להסיר תחילה %1$lld צילומי מסך כדי להישאר בתוך מגבלת 10 צילומי המסך של אפל."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld snimke zaslona moraju se najprije ukloniti kako bi ostale unutar Appleovog ograničenja od 10 snimaka zaslona."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$lld képernyőképeket először el kell távolítani, hogy az Apple által engedélyezett 10 képernyőkép korláton belül maradjanak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld tangkapan layar harus dihapus terlebih dahulu agar tetap berada dalam batas 10 tangkapan layar Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Occorre prima rimuovere %lld screenshot per rispettare il limite di 10 screenshot di Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple の10枚制限内に収めるには、先に%1$lld枚のスクリーンショットを削除する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple의 스크린샷 10개 제한을 지키려면 먼저 스크린샷 %lld개를 제거해야 합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld tangkapan skrin mesti dialih keluar terlebih dahulu untuk kekal dalam had 10 tangkapan skrin Apple."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld schermafbeeldingen moeten eerst worden verwijderd om binnen de limiet van 10 schermafbeeldingen van Apple te blijven."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld skjermbilder må fjernes først for å holde seg innenfor Apples grense på 10 skjermbilder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby zmieścić się w limicie Apple wynoszącym 10 zrzutów ekranu, należy najpierw usunąć %1$lld zrzutów ekranu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld capturas de tela precisam ser removidas primeiro para ficar dentro do limite de 10 capturas de tela da Apple."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As capturas de ecrã %1$lld devem ser removidas primeiro para permanecer dentro do limite de 10 capturas de ecrã da Apple."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capturile de ecran %1$lld trebuie mai întâi eliminate pentru a rămâne în limita Apple de 10 capturi de ecran."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала нужно удалить скриншоты (%lld), чтобы уложиться в лимит Apple в 10 скриншотов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby ste neprekročili limit 10 snímok obrazovky spoločnosti Apple, musíte najskôr odstrániť %1$lld snímky obrazovky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld posnetke zaslona je treba najprej odstraniti, da ostanejo znotraj Applove omejitve 10 posnetkov zaslona."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld skärmdumpar måste tas bort först för att hålla sig inom Apples gräns på 10 skärmdumpar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องลบภาพหน้าจอ %1$lld ก่อนจึงจะอยู่ภายในขีดจำกัด 10 ภาพหน้าจอของ Apple"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple'ın 10 ekran görüntüsü sınırında kalmak için önce %lld ekran görüntüsünün kaldırılması gerekiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб не перевищити ліміт Apple у 10 знімків екрана, спершу потрібно вилучити зайві знімки (%lld)."
          }
        },
        "ur" : {

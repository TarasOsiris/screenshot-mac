    "**⌘D** duplicates the selected row. **Duplicate Row** is in the row menu too." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌘D** duplica la fila seleccionada. **Duplicar fila** també es troba al menú de files."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",

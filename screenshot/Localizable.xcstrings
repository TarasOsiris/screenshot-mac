    "RevenueCat API key is missing. Set REVENUECAT_API_KEY in the app environment or Info.plist." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüssel RevenueCat API fehlt. Legen Sie REVENUECAT_API_KEY in der App-Umgebung oder Info.plist fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta la clave de API de RevenueCat. Configura REVENUECAT_API_KEY en el entorno de la app o en Info.plist."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat کلید API موجود نیست. REVENUECAT_API_KEY را در محیط برنامه یا Info.plist تنظیم کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé RevenueCat API est manquante. Définissez REVENUECAT_API_KEY dans l'environnement de l'application ou Info.plist."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manca la chiave API di RevenueCat. Imposta REVENUECAT_API_KEY nell'ambiente dell'app o in Info.plist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat API キーがありません。アプリ環境または Info.plist で REVENUECAT_API_KEY を設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat API 키가 없습니다. 앱 환경이나 Info.plist에서 REVENUECAT_API_KEY를 설정하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave RevenueCat API está faltando. Defina REVENUECAT_API_KEY no ambiente do aplicativo ou Info.plist."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсутствует ключ RevenueCat API. Задайте REVENUECAT_API_KEY в окружении приложения или в Info.plist."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat API anahtarı eksik. Uygulama ortamında veya Info.plist'te REVENUECAT_API_KEY değerini ayarlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відсутній ключ API RevenueCat. Задайте REVENUECAT_API_KEY у середовищі програми або в Info.plist."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat API 键丢失。在应用程序环境或 Info.plist 中设置 REVENUECAT_API_KEY。"

          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5. エクスポートします。言語とデバイスごとに整理されたフォルダーが表示され、アップロードできるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {

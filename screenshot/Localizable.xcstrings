        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik kanan pilihan berbilang bentuk ▸ **Jajar Dipilih** untuk kiri / tengah / kanan, atas / tengah / bawah, ditambah **Agihkan Secara Mendatar** dan **Agihkan Secara Menegak**."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik met de rechtermuisknop op een selectie met meerdere vormen ▸ **Geselecteerd uitlijnen** voor links/midden/rechts, boven/midden/onder, plus **Horizontaal verdelen** en **Verticaal verdelen**."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyreklikk på et utvalg med flere former ▸ **Juster valgt** for venstre/senter/høyre, topp/midt/bunn, pluss **Distribuer horisontalt** og **Distribuer vertikalt**."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij prawym przyciskiem myszy zaznaczenie wielu kształtów ▸ **Wyrównaj wybrane** do lewej/środka/prawej, góry/środka/dół oraz opcje **Rozłóż w poziomie** i **Rozłóż w pionie**."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito em uma seleção de várias formas ▸ **Alinhar seleção** para alinhar à esquerda / ao centro / à direita, em cima / ao meio / embaixo, além de **Distribuir horizontalmente** e **Distribuir verticalmente**."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito em uma seleção de múltiplas formas ▸ **Alinhar selecionado** para esquerda/centro/direita, superior/meio/inferior, além de **Distribuir horizontalmente** e **Distribuir verticalmente**."
          }

    "Import screenshots into device frames, add and translate languages, and set per-language text." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importieren Sie Screenshots in Geräterahmen, fügen Sie Sprachen hinzu und übersetzen Sie sie und legen Sie Text pro Sprache fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe capturas de pantalla en marcos de dispositivos, agregue y traduzca idiomas y configure texto por idioma."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسکرین‌شات‌ها را در فریم‌های دستگاه وارد کنید، زبان‌ها را اضافه و ترجمه کنید، و متن هر زبان را تنظیم کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez des captures d'écran dans les cadres de l'appareil, ajoutez et traduisez des langues et définissez le texte par langue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importare screenshot nelle cornici dei dispositivi, aggiungere e tradurre lingue e impostare il testo per ogni lingua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットをデバイス フレームにインポートし、言語を追加して翻訳し、言語ごとのテキストを設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크린샷을 기기 프레임으로 가져오고, 언어를 추가 및 번역하고, 언어별 텍스트를 설정하세요."

        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ ഗാലറിയിൽ സംരക്ഷിക്കാൻ ക്രമീകരണങ്ങളിൽ ഫോട്ടോ ആക്‌സസ് അനുവദിക്കുക."

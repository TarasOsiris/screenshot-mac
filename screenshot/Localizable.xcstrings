    "Format, size, layout and background are remembered from your last showcase export, including a picked background image." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تذكر التنسيق والحجم والتخطيط والخلفية من آخر تصدير لواجهة العرض، بما في ذلك صورة الخلفية المختارة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El format, la mida, la disposició i el fons es recorden de la darrera exportació d'aparador, inclosa una imatge de fons escollida."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formát, velikost, rozvržení a pozadí jsou zapamatovány z vašeho posledního exportu prezentace, včetně vybraného obrázku na pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format, størrelse, layout og baggrund huskes fra din sidste showcase-eksport, inklusive et valgt baggrundsbillede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format, Größe, Layout und Hintergrund werden von deinem letzten Showcase-Export übernommen – auch ein gewähltes Hintergrundbild."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μορφή, το μέγεθος, η διάταξη και το φόντο απομνημονεύονται από την τελευταία εξαγωγή της βιτρίνας σας, συμπεριλαμβανομένης μιας επιλεγμένης εικόνας φόντου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El formato, el tamaño, el diseño y el fondo se recuerdan de tu última exportación de escaparate, incluida una imagen de fondo elegida."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قالب، اندازه، چیدمان و پس‌زمینه از آخرین خروجی ویترین شما به خاطر سپرده می‌شوند، از جمله تصویر پس‌زمینه‌ای که انتخاب کرده‌اید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muoto, koko, asettelu ja tausta muistetaan viimeisestä näyteikkunan viennistä, mukaan lukien poimittu taustakuva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le format, la taille, la mise en page et l’arrière-plan de votre dernier export vitrine sont mémorisés, y compris une image d’arrière-plan choisie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פורמט, גודל, פריסה ורקע נזכרים מיצוא הראווה האחרון שלך, כולל תמונת רקע שנבחרה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format, veličina, izgled i pozadina pamte se iz vašeg posljednjeg izvoza izloga, uključujući odabranu pozadinsku sliku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A formátum, a méret, az elrendezés és a háttér a legutóbbi kirakatexportálásból emlékeznek meg, beleértve a kiválasztott háttérképet is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format, ukuran, tata letak, dan latar belakang diingat dari ekspor etalase terakhir Anda, termasuk gambar latar belakang yang dipilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formato, dimensione, layout e sfondo vengono ricordati dall’ultima esportazione vetrina, compresa un’immagine di sfondo scelta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーマット、サイズ、レイアウト、背景は、選択した背景画像も含め、前回のショーケース書き出しの設定が記憶されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "형식, 크기, 레이아웃, 배경은 선택한 배경 이미지를 포함해 마지막 쇼케이스 내보내기 설정이 기억됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format, saiz, reka letak dan latar belakang diingati daripada eksport pameran terakhir anda, termasuk imej latar belakang yang dipilih."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formaat, grootte, lay-out en achtergrond worden onthouden van uw laatste showcase-export, inclusief een gekozen achtergrondafbeelding."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format, størrelse, layout og bakgrunn huskes fra din siste utstillingseksport, inkludert et valgt bakgrunnsbilde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",

    "Start from a ready-made layout or a blank project. Templates come pre-sized for each store." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ من تخطيط جاهز أو مشروع فارغ. تأتي القوالب بحجم مسبق لكل متجر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি রেডিমেড লেআউট বা একটি ফাঁকা প্রকল্প থেকে শুরু করুন। টেমপ্লেটগুলি প্রতিটি দোকানের জন্য প্রাক-আকারে আসে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comenceu des d'un disseny ja fet o un projecte en blanc. Les plantilles vénen de mida prèvia per a cada botiga."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začněte od hotového rozvržení nebo prázdného projektu. Šablony jsou dodávány s přednastavenou velikostí pro každý obchod."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start fra et færdigt layout eller et tomt projekt. Skabeloner leveres i præ-størrelse til hver butik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte mit einem fertigen Layout oder einem leeren Projekt. Vorlagen haben bereits die passende Größe für jeden Store."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκινήστε από μια έτοιμη διάταξη ή ένα κενό έργο. Τα πρότυπα διατίθενται σε προμεγέθη για κάθε κατάστημα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza con un diseño listo para usar o un proyecto en blanco. Las plantillas ya vienen con el tamaño de cada tienda."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از یک چیدمان آماده یا یک پروژهٔ خالی شروع کنید. قالب‌ها از قبل برای هر فروشگاه اندازه‌بندی شده‌اند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aloita valmiista ulkoasusta tai tyhjästä projektista. Mallit ovat valmiiksi mitoitettuja jokaiselle myymälälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partez d'une mise en page prête à l'emploi ou d'un projet vierge. Les modèles sont prédimensionnés pour chaque boutique."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તૈયાર લેઆઉટ અથવા ખાલી પ્રોજેક્ટથી પ્રારંભ કરો. નમૂનાઓ દરેક સ્ટોર માટે પૂર્વ-કદના આવે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התחל מפריסה מוכנה או מפרויקט ריק. תבניות מגיעות בגודל מראש לכל חנות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तैयार लेआउट या खाली प्रोजेक्ट से शुरुआत करें। प्रत्येक स्टोर के लिए टेम्पलेट पहले से आकार में आते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počnite od gotovog izgleda ili praznog projekta. Predlošci dolaze unaprijed određene veličine za svaku trgovinu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kezdje egy kész elrendezéssel vagy egy üres projekttel. A sablonok előre méretezettek minden üzlethez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai dari tata letak yang sudah jadi atau proyek kosong. Templat sudah berukuran sebelumnya untuk setiap toko."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parti da un layout già pronto o da un progetto vuoto. I modelli hanno già le dimensioni giuste per ogni store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用意されたレイアウトか空のプロジェクトから始めましょう。テンプレートは各ストアに合わせたサイズになっています。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ರೆಡಿಮೇಡ್ ಲೇಔಟ್ ಅಥವಾ ಖಾಲಿ ಯೋಜನೆಯಿಂದ ಪ್ರಾರಂಭಿಸಿ. ಪ್ರತಿ ಅಂಗಡಿಗೆ ಟೆಂಪ್ಲೇಟ್‌ಗಳು ಪೂರ್ವ ಗಾತ್ರದಲ್ಲಿ ಬರುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",

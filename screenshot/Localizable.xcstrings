        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**ভাষা** — অ্যাপ ইন্টারফেসের ভাষা ওভাররাইড করুন। একটি পুনরায় লঞ্চ প্রয়োজন."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Idioma**: anul·la l'idioma de la interfície de l'aplicació. Requereix un rellançament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Jazyk** – přepíše jazyk rozhraní aplikace. Vyžaduje opětovné spuštění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Sprog** — tilsidesæt appens grænsefladesprog. Kræver en relancering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Sprache** – legt die Sprache der App-Oberfläche abweichend vom System fest. Erfordert einen Neustart."

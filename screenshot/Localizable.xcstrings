          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action traduit chaque calque de texte de la langue de base vers %@ et remplace le texte traduit actuel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה מחיל תרגום משפת הבסיס על כל שכבת טקסט ב-%1$@ ומחליף את הטקסט המתורגם הנוכחי."

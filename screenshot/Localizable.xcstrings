    "Variants are alternative screenshots to A/B test on your App Store product page." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varianten sind alternative Screenshots für A/B-Tests auf deiner App Store-Produktseite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las variantes son capturas alternativas para hacer pruebas A/B en la página de producto del App Store."
          }
        },
        "fa" : {
          "stringUnit" : {

        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಟೇಬಲ್ ಟೆನ್ನಿಸ್ ಅಭ್ಯಾಸವನ್ನು ಲಾಗ್ ಮಾಡಿ ಮತ್ತು ಟ್ರ್ಯಾಕ್ ಮಾಡಿ."

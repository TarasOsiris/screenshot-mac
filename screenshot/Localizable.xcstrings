    "**Tile** — repeats the image with adjustable spacing, offset, and scale per axis." : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Tela**: repeteix la imatge amb espai, desplaçament i escala ajustables per eix."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Til** — gentager billedet med justerbar afstand, offset og skalering pr. akse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Kacheln** – wiederholt das Bild mit einstellbarem Abstand, Versatz und Skalierung pro Achse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

      }
    },
    "To test them, use Export ▸ Upload A/B Test to App Store Connect." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per provar-los, utilitzeu Exporta ▸ Carrega la prova A/B a App Store Connect."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at teste dem, brug Export ▸ Upload A/B Test til App Store Connect."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Testen wähle „Export ▸ A/B-Test in App Store Connect hochladen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para probarlas, usa Exportar ▸ Subir prueba A/B a App Store Connect."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای آزمایش آن‌ها، از «صدور ▸ آپلود آزمایش A/B در App Store Connect» استفاده کنید."

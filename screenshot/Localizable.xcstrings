    "Projects will be kept locally. Other devices will no longer see updates." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els projectes es mantindran localment. Altres dispositius ja no veuran actualitzacions."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekter vil blive holdt lokalt. Andre enheder vil ikke længere se opdateringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekte bleiben lokal gespeichert. Andere Geräte erhalten keine Aktualisierungen mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los proyectos se mantendrán localmente. Otros dispositivos ya no verán actualizaciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پروژه‌ها به صورت محلی نگهداری خواهند شد. دستگاه‌های دیگر دیگر به‌روزرسانی‌ها را نخواهند دید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projektit säilytetään paikallisesti. Muut laitteet eivät enää näe päivityksiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les projets seront conservés localement. Les autres appareils ne verront plus les mises à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I progetti verranno conservati in locale. Gli altri dispositivi non vedranno più gli aggiornamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトはローカルに保存されます。ほかのデバイスには更新が反映されなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트는 로컬에 보관됩니다. 다른 기기에는 더 이상 업데이트가 표시되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projecten worden lokaal gehouden. Andere apparaten zullen geen updates meer zien."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosjekter vil bli holdt lokalt. Andre enheter vil ikke lenger se oppdateringer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os projetos serão mantidos localmente. Outros dispositivos não verão mais atualizações."
          }
        },
        "pt-PT" : {

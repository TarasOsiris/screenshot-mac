    "Shapes snap to other shapes' edges and centers, and to template boundaries, within a 4px threshold." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formen rasten innerhalb eines 4-Pixel-Schwellenwerts an den Kanten und Mittelpunkten anderer Formen sowie an Vorlagengrenzen ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las formas se ajustan a los bordes y centros de otras formas y a los límites de la plantilla, dentro de un umbral de 4 píxeles."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شکل‌ها به لبه‌ها و مرکز شکل‌های دیگر و به مرزهای قالب، در یک آستانه 4 پیکسلی می‌چسبند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les formes s'alignent sur les bords et les centres des autres formes, ainsi que sur les limites du modèle, dans un seuil de 4 px."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le forme si agganciano ai bordi e ai centri delle altre forme e ai limiti dei modelli, entro una soglia di 4 px."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェイプは、4 ピクセルのしきい値以内で、他のシェイプのエッジと中心、およびテンプレートの境界にスナップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모양은 4px 임계값 내에서 다른 모양의 가장자리와 중심, 템플릿 경계에 맞춰집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As formas se ajustam às bordas e centros de outras formas e aos limites do modelo, dentro de um limite de 4px."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фигуры привязываются к краям и центрам других фигур, а также к границам шаблонов в пределах 4 пикселей."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şekiller, 4 px eşik içinde diğer şekillerin kenarlarına ve merkezlerine ve şablon sınırlarına yaslanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фігури прив’язуються до країв і центрів інших фігур, а також до меж шаблонів у межах 4 px."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "形状在 4 像素阈值内与其他形状的边缘和中心以及模板边界对齐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "形狀會在 4 px 的範圍內對齊其他形狀的邊緣和中心點，以及範本邊界。"
          }
        }
      }
    },

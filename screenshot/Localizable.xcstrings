    "Set backgrounds, colors, and gradients, and fine-tune every element to match your brand." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege Hintergründe, Farben und Verläufe fest und passe jedes Element an deine Marke an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta fondos, colores y degradados, y perfecciona cada elemento para reflejar tu marca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پس‌زمینه‌ها، رنگ‌ها و گرادیان‌ها را تنظیم کنید و هر عنصر را متناسب با برند خود دقیق تنظیم کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez les arrière-plans, les couleurs et les dégradés, et affinez chaque élément en fonction de votre marque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta sfondi, colori e sfumature e perfeziona ogni elemento in base al tuo brand."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景、色、グラデーションを設定し、ブランドに合わせてすべての要素を微調整します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경, 색상, 그라디언트를 설정하고 브랜드에 맞게 모든 요소를 세밀하게 조정하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina planos de fundo, cores e gradientes e ajuste cada elemento para combinar com sua marca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настраивайте фоны, цвета и градиенты и подгоняйте каждый элемент под свой бренд."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka planları, renkleri ve renk geçişlerini ayarlayın; her öğeyi markanıza uyacak şekilde ince ayarlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштуйте тло, кольори й градієнти та доведіть кожен елемент до вигляду вашого бренду."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置背景、颜色和渐变，并微调每个元素以匹配你的品牌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定背景、顏色和漸層，並微調每個元素以符合你的品牌。"
          }
        }
      }
    },
    "Set backgrounds, colors, and gradients. Use the inspector on the right and properties bar at the bottom." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege Hintergründe, Farben und Verläufe fest. Nutze den Inspektor rechts und die Eigenschaftenleiste unten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establece fondos, colores y degradados. Usa el inspector de la derecha y la barra de propiedades de abajo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پس‌زمینه‌ها، رنگ‌ها و گرادیان‌ها را تنظیم کنید. از بازرس در سمت راست و نوار ویژگی‌ها در پایین استفاده کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez les arrière-plans, les couleurs et les dégradés. Utilisez l'inspecteur à droite et la barre des propriétés en bas."

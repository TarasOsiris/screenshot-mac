    "Nothing was uploaded — the edit was discarded, so your listing is untouched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde nichts hochgeladen – die Bearbeitung wurde verworfen, dein Eintrag bleibt also unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se subió nada: la edición se descartó, así que tu ficha no se ha modificado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هیچ چیزی آپلود نشد — ویرایش کنار گذاشته شد، پس صفحهٔ فروشگاه شما دست‌نخورده است."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n'a été envoyé : la modification a été abandonnée, votre fiche est donc intacte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato caricato nulla: la modifica è stata scartata, quindi la tua scheda è intatta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何もアップロードされていません。編集は破棄されたため、掲載情報は変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무것도 업로드되지 않았습니다. 편집 내용이 취소되어 스토어 등록정보는 변경되지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada foi enviado — a edição foi descartada, então sua página na loja continua intacta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не загружено — изменения отменены, так что ваша страница не затронута."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiçbir şey yüklenmedi — düzenleme iptal edildi, bu yüzden mağaza sayfanıza dokunulmadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нічого не вивантажено — редагування скасовано, тож ваша сторінка не змінилася."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未上传任何内容——此次编辑已被丢弃，因此你的商品详情保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未上傳任何內容——編輯已被捨棄，因此你的商店資訊保持不變。"

    "Apply background across the entire row instead of repeating per screenshot" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenden Sie den Hintergrund auf die gesamte Zeile an, anstatt ihn pro Screenshot zu wiederholen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplique el fondo en toda la fila en lugar de repetirlo por captura de pantalla"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به جای تکرار در هر اسکرین شات، پس زمینه را در کل ردیف اعمال کنید"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquer l'arrière-plan sur toute la ligne au lieu de répéter par capture d'écran"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applica lo sfondo all'intera riga invece di ripeterlo per ogni screenshot"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットごとに繰り返すのではなく、行全体に背景を適用します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크린샷별로 반복하는 대신 전체 행에 배경을 적용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplique o plano de fundo em toda a linha em vez de repetir por captura de tela"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применить фон ко всей строке, а не повторять для каждого скриншота"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka planı her ekran görüntüsünde tekrarlamak yerine satırın tamamına uygula"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосувати тло до всього рядка замість повторення для кожного знімка екрана"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在整行应用背景，而不是在每个屏幕截图上重复"
          }
        },
        "zh-Hant" : {

    },
    "In the **Google Cloud console**, create a service account and enable the **Google Play Android Developer API**." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A la **consola de Google Cloud**, creeu un compte de servei i activeu el **Google Play Desenvolupador d'Android API**."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I **Google Cloud-konsollen** skal du oprette en tjenestekonto og aktivere **Google Play Android-udvikleren API**."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle in der **Google Cloud Console** ein Dienstkonto und aktiviere die **Google Play Android Developer API**."
          }
        },
        "es" : {
          "stringUnit" : {

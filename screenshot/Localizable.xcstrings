          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعتبارها و مجوزهای فونت‌ها، آیکون‌ها و منابع همراه برنامه."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjasimien, kuvakkeiden ja niputettujen resurssien hyvitykset ja lisenssit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crédits et licences des polices, des icônes et des ressources intégrées."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ફૉન્ટ્સ, ચિહ્નો અને બંડલ કરેલ અસ્કયામતો માટે ક્રેડિટ અને લાઇસન્સ."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זיכויים ורישיונות עבור גופנים, אייקונים ונכסים מצורפים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ॉन्ट, आइकन और बंडल संपत्तियों के लिए क्रेडिट और लाइसेंस।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",

          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Zeilen** gruppieren die Screenshots eines Projekts nach Gerätetyp (iPhone, iPad, Android-Smartphone usw.). Jede Gerätegröße bekommt eine eigene Zeile, weil der App Store unterschiedliche Auflösungen verlangt."
          }

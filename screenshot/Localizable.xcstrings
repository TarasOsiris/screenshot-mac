        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destekle iletişime geçme, web sitesini ziyaret etme veya X, Threads ve Discord'da takip etme bağlantıları — ayrıca aynı geliştiricinin **Diğer Uygulamalar**'ı."
          }
        },
        "uk" : {
          "stringUnit" : {

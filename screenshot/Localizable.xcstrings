    "**⌘]** / **⌘[** cycle forward / backward through languages." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌘]** / **⌘[** wechseln vorwärts/rückwärts durch die Sprachen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌘]** / **⌘[** recorren los idiomas hacia delante o hacia atrás."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌘]** / **⌘[** بین زبان‌ها به جلو / عقب می‌روند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**⌘]** / **⌘[** avance/recule dans les langues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

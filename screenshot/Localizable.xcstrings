          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija la aplicación y la versión. Screenshot Bro asigna automáticamente cada fila a la familia de dispositivos correcta."
          }
        },
        "fa" : {
          "stringUnit" : {

        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain mitä näet. Tarkastajan **Näkyvyys**-osiossa pois päältä kytketyt muototyypit jätetään myös pois viedystä kuvasta."

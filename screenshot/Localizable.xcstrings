        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevirileri tüm ekran görüntülerinden kaldırılacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Її переклади буде вилучено з усіх знімків екрана."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس کے تراجم کو ہر اسکرین شاٹ سے ہٹا دیا جائے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản dịch của nó sẽ bị xóa khỏi mọi ảnh chụp màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的翻译将从所有截图中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其翻譯將從每張螢幕截圖中移除。"
          }
        }
      }
    },

          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando modifichi una lingua diversa da quella di base, in cima alla tela compare un banner che ti ricorda in quale lingua ti trovi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

    "Finished %lld of %lld steps. Check each set's state — some did not complete." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'han acabat %1$lld de %2$lld passos. Comproveu l'estat de cada conjunt; alguns no s'han completat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuldførte %1$lld af %2$lld trin. Kontroller hvert sæts tilstand - nogle fuldførte ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld von %2$lld Schritten abgeschlossen. Prüfe den Status jedes Sets – einige wurden nicht abgeschlossen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Finished %1$lld of %2$lld steps. Check each set's state — some did not complete."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se completaron %1$lld de %2$lld pasos. Comprueba el estado de cada conjunto; algunos no terminaron."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld از %2$lld مرحله به پایان رسید. وضعیت هر مجموعه را بررسی کنید - برخی کامل نشدند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld / %2$lld on valmis. Tarkista jokaisen sarjan tila – jotkut eivät valmistuneet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld étapes sur %2$lld terminées. Vérifiez l'état de chaque ensemble : certains n'ont pas abouti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

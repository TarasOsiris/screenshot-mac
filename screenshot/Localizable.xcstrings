    "Saved as a draft — not sent for review. Send for review from the Play Console when ready." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Entwurf gespeichert – nicht zur Prüfung gesendet. Sende ihn in der Play Console zur Prüfung, wenn du so weit bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado como borrador, sin enviar a revisión. Envíalo a revisión desde Play Console cuando quieras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به‌صورت پیش‌نویس ذخیره شد — برای بازبینی ارسال نشد. هر وقت آماده بودید، از Play Console برای بازبینی ارسال کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré en tant que brouillon – non envoyé pour examen. Envoyez-le pour examen depuis la Play Console lorsque vous êtes prêt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvato come bozza, non inviato per la revisione. Invialo per la revisione dalla Play Console quando sei pronto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下書きとして保存しました（審査には送信されていません）。準備ができたら Play Console から審査に送信してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초안으로 저장되었으며 검토를 위해 전송되지 않았습니다. 준비가 되면 Play Console에서 검토를 위해 전송하세요."

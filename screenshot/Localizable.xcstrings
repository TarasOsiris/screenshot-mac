    "Variants are alternative screenshots to A/B test on your App Store product page." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المتغيرات هي لقطات شاشة بديلة لاختبار A/B على صفحة المنتج App Store الخاصة بك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les variants són captures de pantalla alternatives a la prova A/B a la pàgina del vostre producte App Store."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varianty jsou alternativní snímky obrazovky k A/B testu na vaší produktové stránce App Store."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varianter er alternative skærmbilleder til A/B-test på din App Store produktside."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varianten sind alternative Screenshots für A/B-Tests auf deiner App Store-Produktseite."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι παραλλαγές είναι εναλλακτικά στιγμιότυπα οθόνης για τη δοκιμή A/B στη σελίδα προϊόντος App Store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las variantes son capturas alternativas para hacer pruebas A/B en la página de producto del App Store."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخه‌ها اسکرین‌شات‌های جایگزین برای آزمایش A/B در صفحه محصول App Store شما هستند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihtoehdot ovat vaihtoehtoisia kuvakaappauksia A/B-testille App Store tuotesivullasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les variantes sont des captures d’écran alternatives à tester en A/B sur votre page produit de l’App Store."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרסאות הן צילומי מסך חלופיים לבדיקת A/B בדף המוצר שלך ב-App Store."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varijante su alternativne snimke zaslona za A/B testiranje na vašoj stranici proizvoda App Store."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A változatok a App Store termékoldalán található A/B teszt alternatív képernyőképei."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varian adalah tangkapan layar alternatif untuk pengujian A/B di halaman produk App Store Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le varianti sono screenshot alternativi da sottoporre a test A/B nella pagina del prodotto sull'App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バリアントは、App Store のプロダクトページで A/B テストするための別のスクリーンショットです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변형은 App Store 제품 페이지에서 A/B 테스트할 대체 스크린샷입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varian ialah tangkapan skrin alternatif kepada ujian A/B pada halaman produk App Store anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

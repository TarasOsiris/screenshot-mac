    "Apple allows at most 10 screenshots in a display-type set; this proposal has %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple erlaubt höchstens 10 Screenshots pro Anzeigetyp-Set; dieser Vorschlag hat %1$lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple permite como máximo 10 capturas por conjunto de tipo de pantalla; esta propuesta tiene %1$lld."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپل در هر مجموعهٔ نوع نمایش حداکثر ۱۰ اسکرین‌شات را می‌پذیرد؛ این پیشنهاد %1$lld مورد دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple autorise au maximum 10 captures d'écran par ensemble de type d'affichage ; cette proposition en contient %1$lld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple consente al massimo 10 screenshot in un set per tipo di display; questa proposta ne ha %lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple では、1つの表示タイプのセットに含められるスクリーンショットは最大10枚です。この提案には%1$lld枚あります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple은 디스플레이 유형 세트당 스크린샷을 최대 10개까지 허용하는데, 이 제안에는 %1$lld개가 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Apple permite no máximo 10 capturas de tela em um conjunto de tipo de exibição; esta proposta tem %1$lld."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple допускает не более 10 скриншотов в наборе для типа дисплея; в этом предложении — %lld."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple, bir ekran türü setinde en fazla 10 ekran görüntüsüne izin verir; bu öneride %lld tane var."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple дозволяє щонайбільше 10 знімків екрана в наборі для типу дисплея; у цій пропозиції їх %lld."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 规定每个显示类型组最多 10 张截图；此方案有 %lld 张。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 每個顯示類型組最多允許 10 張螢幕截圖；此提案有 %lld 張。"
          }
        }
      }
    },
    "Applies to all locales for this version." : {
      "localizations" : {
        "de" : {

        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখান থেকে পাঠ্য, ছবি, ডিভাইস এবং আকার যোগ করুন। তারা নির্বাচিত সারি প্রদর্শিত হবে."

    "Demo mode is active. Real API key fields above are ignored until you turn demo mode off." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mode de demostració està actiu. Els camps clau reals API anteriors s'ignoren fins que desactiveu el mode de demostració."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demotilstand er aktiv. Ægte API nøglefelter ovenfor ignoreres, indtil du slår demotilstand fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Demomodus ist aktiv. Die echten API-Schlüsselfelder oben werden ignoriert, bis du den Demomodus ausschaltest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo de demostración está activo. Los campos de la clave de API real de arriba se ignoran hasta que desactives el modo de demostración."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حالت نمایشی فعال است. تا زمانی که حالت نمایشی را خاموش نکنید، فیلدهای کلید واقعی API در بالا نادیده گرفته می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demotila on aktiivinen. Yllä olevat oikeat API-avainkentät ohitetaan, kunnes poistat esittelytilan käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode démo est actif. Les champs de clé API ci-dessus sont ignorés tant que vous n'avez pas désactivé le mode démo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità demo è attiva. I campi della chiave API reale qui sopra vengono ignorati finché non disattivi la modalità demo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デモモードがオンです。上の実際の API キーの入力内容は、デモモードをオフにするまで無視されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데모 모드가 활성화되었습니다. 위의 실제 API 키 필드는 데모 모드를 끌 때까지 무시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demomodus is actief. De echte API-toetsvelden hierboven worden genegeerd totdat u de demomodus uitschakelt."
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demomodus er aktiv. Ekte API nøkkelfelt ovenfor ignoreres til du slår av demomodus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo de demonstração está ativo. Os campos da chave de API real acima são ignorados até você desativar o modo de demonstração."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo de demonstração está ativo. Os campos-chave reais API acima serão ignorados até que você desative o modo de demonstração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Демо-режим включен. Поля настоящего ключа API выше игнорируются, пока вы не выключите демо-режим."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demoläget är aktivt. Verkliga API nyckelfält ovan ignoreras tills du stänger av demoläget."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demo modu etkin. Yukarıdaki gerçek API anahtarı alanları, demo modunu kapatana kadar yok sayılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Демо-режим активний. Справжні поля ключа API вище ігноруються, доки ви не вимкнете демо-режим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "演示模式已启用。在你关闭演示模式之前，上方的实际 API 密钥字段将被忽略。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "示範模式已啟用。在你關閉示範模式之前，上方的實際 API 密鑰欄位會被忽略。"
          }
        }
      }
    },

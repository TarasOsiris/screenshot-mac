        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對多重選取的形狀按右鍵 ▸ **對齊所選項目**，可靠左／水平置中／靠右、靠上／垂直置中／靠下對齊，另有**水平分佈**和**垂直分佈**。"
          }
        }
      }
    },
    "Right-click a project card on the Projects screen for **Rename…**, **Star Project**, **Duplicate…**, and **Delete…**." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر بزر الماوس الأيمن فوق بطاقة مشروع على شاشة المشاريع لـ **إعادة التسمية...**، **المشروع المميز**، **التكرار...**، و**الحذف...**."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feu clic amb el botó dret a una targeta de projecte a la pantalla Projectes per a **Canvia el nom...**, **Star Project**, **Duplica...** i **Suprimeix...**."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte pravým tlačítkem myši na kartu projektu na obrazovce Projekty pro **Přejmenovat…**, **Hvězdička projektu**, **Duplikovat…** a **Odstranit…**."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højreklik på et projektkort på projektskærmen for **Omdøb...**, **Stjerneprojekt**, **Duplicate...** og **Slet...**."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke in der Projektübersicht mit der rechten Maustaste auf eine Projektkarte für **Umbenennen…**, **Projekt mit Stern markieren**, **Duplizieren…** und **Löschen…**."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",

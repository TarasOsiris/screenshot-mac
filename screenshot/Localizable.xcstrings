        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預覽建立後專案已更改。請在同步前重新整理檢查畫面。"
          }
        }
      }
    },
    "The Projects screen shows sync progress while iCloud is uploading or downloading." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bildschirm „Projekte“ zeigt den Synchronisierungsfortschritt an, während iCloud hoch- oder herunterlädt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla Proyectos muestra el progreso de la sincronización mientras iCloud se carga o descarga."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صفحه پروژه‌ها پیشرفت همگام‌سازی را در حین آپلود یا بارگیری iCloud نشان می‌دهد."

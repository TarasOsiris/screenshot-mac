          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržením **⇧** při změně velikosti uzamknete poměr stran. Rámečky zařízení jiné než **Neviditelné** si vždy zachovávají své proporce, s **⇧** nebo bez **."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold **⇧** nede, mens du ændrer størrelse for at låse billedformat. Andre enhedsrammer end **Usynlig** beholder altid deres proportioner, med eller uden **⇧**."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

          }
        }
      }
    },
    "Projects will be kept locally. Other devices will no longer see updates." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم الاحتفاظ بالمشاريع محليًا. لن تتمكن الأجهزة الأخرى من رؤية التحديثات بعد الآن."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els projectes es mantindran localment. Altres dispositius ja no veuran actualitzacions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekty budou uloženy lokálně. Ostatní zařízení již neuvidí aktualizace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekter vil blive holdt lokalt. Andre enheder vil ikke længere se opdateringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekte bleiben lokal gespeichert. Andere Geräte erhalten keine Aktualisierungen mehr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα έργα θα διατηρούνται τοπικά. Οι άλλες συσκευές δεν θα βλέπουν πλέον ενημερώσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los proyectos se mantendrán localmente. Otros dispositivos ya no verán actualizaciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پروژه‌ها به صورت محلی نگهداری خواهند شد. دستگاه‌های دیگر دیگر به‌روزرسانی‌ها را نخواهند دید."
          }
        },
        "fi" : {

        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemá žiadny riadok %1$@, takže toto nahranie nemení jeho %2$@ snímky obrazovky."
          }
        },
        "sl" : {
          "stringUnit" : {

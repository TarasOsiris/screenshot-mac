        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Satırları ve ekran görüntülerini silmeden önce sor** — yıkıcı satır ve ekran görüntüsü işlemleri için bir onay istemi gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",

        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'écran Projets affiche la progression de la synchronisation pendant qu'iCloud envoie ou télécharge des fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La schermata Progetti mostra l'avanzamento della sincronizzazione mentre iCloud carica o scarica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

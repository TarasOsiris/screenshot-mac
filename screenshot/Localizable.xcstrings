    "Set **Settings ▸ Export ▸ Export folder** to make **⌘E** export directly without prompting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellen Sie **Einstellungen ▸ Exportieren ▸ Ordner exportieren** ein, um **⌘E** direkt und ohne Aufforderung zu exportieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establezca **Configuración ▸ Exportar ▸ Carpeta de exportación** para realizar la exportación **⌘E** directamente sin que se le solicite."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**تنظیمات ▸ صادرات ▸ صادرات پوشه** را تنظیم کنید تا **⌘E** مستقیماً بدون درخواست صادر شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez **Paramètres ▸ Exporter ▸ Exporter le dossier** pour effectuer l'exportation **⌘E** directement sans invite."
          }

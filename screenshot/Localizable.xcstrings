    "RevenueCat is configured with a Test Store API key. Replace it with your Apple public SDK key before shipping." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تكوين RevenueCat باستخدام مفتاح المتجر التجريبي API. استبدله بمفتاح Apple SDK العام قبل الشحن."
          }
        },
        "ca" : {
          "stringUnit" : {

    "Scale the text down so every line fits the box, in every language" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redueix el text perquè cada línia s'ajusti al quadre, en tots els idiomes"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skaler teksten ned, så hver linje passer til boksen, på alle sprog"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text verkleinern, bis jede Zeile ins Feld passt – in jeder Sprache"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce el texto para que cada línea quepa en el cuadro, en todos los idiomas"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متن را کوچک می‌کند تا همه سطرها در هر زبانی در کادر جا شوند"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pienennä tekstiä niin, että jokainen rivi sopii laatikkoon kaikilla kielillä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduit le texte pour que chaque ligne tienne dans le cadre, dans toutes les langues"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riduce il testo in modo che ogni riga entri nel riquadro, in ogni lingua"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての言語で、各行が枠に収まるようにテキストを縮小します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 언어에서 모든 줄이 상자에 맞도록 텍스트를 축소합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verklein de tekst zodat elke regel in het kader past, in elke taal"
          }
        },
        "no" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skaler teksten ned slik at hver linje passer til boksen, på alle språk"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduz o texto para que cada linha caiba na caixa, em todos os idiomas"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduza o tamanho do texto para que cada linha caiba na caixa, em todos os idiomas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уменьшает текст, чтобы каждая строка помещалась в рамку, на любом языке"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skala ner texten så att varje rad passar rutan, på alla språk"
          }
        },
        "tr" : {
          "stringUnit" : {

    "RevenueCat is configured with a Test Store API key. Replace it with your Apple public SDK key before shipping." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat està configurat amb una clau de Test Store API. Substituïu-lo per la vostra clau pública d'SDK d'Apple abans de l'enviament."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat er konfigureret med en Test Store API-tast. Udskift den med din offentlige Apple SDK-nøgle inden forsendelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat ist mit einem API-Schlüssel für den Test Store konfiguriert. Ersetze ihn vor der Veröffentlichung durch deinen öffentlichen Apple-SDK-Schlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat está configurado con una clave de API de Test Store. Sustitúyela por tu clave pública SDK de Apple antes de publicar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat با کلید API مربوط به Test Store پیکربندی شده است. پیش از انتشار، آن را با کلید عمومی SDK اپل خود جایگزین کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat on määritetty Test Store API -avaimella. Vaihda se Applen julkiseen SDK-avaimeen ennen toimitusta."
          }
        },
        "fr" : {

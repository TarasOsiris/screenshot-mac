    "%@ was partially uploaded before the last sync stopped. Refresh the review to re-diff this set — the sets that finished will not be uploaded again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde teilweise hochgeladen, bevor die letzte Synchronisierung gestoppt wurde. Aktualisieren Sie die Rezension, um diesen Satz erneut zu unterscheiden. Die abgeschlossenen Sätze werden nicht erneut hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ se cargó parcialmente antes de que se detuviera la última sincronización. Actualice la revisión para volver a diferenciar este conjunto; los conjuntos que finalizaron no se cargarán nuevamente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ قبل از توقف آخرین همگام‌سازی تا حدی آپلود شد. مرور را بازخوانی کنید تا دوباره این مجموعه را متفاوت کنید - مجموعه‌هایی که به پایان رسید دوباره آپلود نمی‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a été partiellement téléchargé avant l'arrêt de la dernière synchronisation. Actualisez la révision pour re-différer cet ensemble — les ensembles terminés ne seront pas téléchargés à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è stato caricato parzialmente prima dell'interruzione dell'ultima sincronizzazione. Aggiorna la revisione per ricalcolare le differenze di questo set: i set completati non verranno caricati di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は、最後の同期が停止する前に部分的にアップロードされました。レビューを更新してこのセットを再比較します。完了したセットは再度アップロードされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은 마지막 동기화가 중지되기 전에 부분적으로 업로드되었습니다. 이 세트를 다시 비교하려면 리뷰를 새로 고치세요. 완료된 세트는 다시 업로드되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ foi parcialmente carregado antes da última sincronização ser interrompida. Atualize a revisão para diferenciar novamente este conjunto – os conjuntos concluídos não serão carregados novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Набор %@ был загружен частично до остановки последней синхронизации. Обновите проверку, чтобы заново сравнить этот набор, — завершенные наборы повторно загружаться не будут."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, son eşzamanlama durmadan önce kısmen yüklendi. Bu seti yeniden karşılaştırmak için incelemeyi yenileyin — tamamlanan setler yeniden yüklenmeyecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ було частково вивантажено до того, як зупинилася остання синхронізація. Оновіть перегляд, щоб знову порівняти цей набір, — завершені набори не вивантажуватимуться повторно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在上次同步停止之前，%1$@ 已部分上传。刷新评论以重新比较此集合 - 已完成的集合将不会再次上传。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在上次同步停止前已部分上傳。請重新整理檢查畫面以重新比對此組——已完成的組不會再次上傳。"
          }
